{
  "id": "%e6%96%b0%e5%bc%80%e9%80%9a%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e8%88%aa%e7%8f%ad%ef%bc%9a%e8%b4%b5%e9%98%b3%e2%87%8b%e5%90%89%e9%9a%86%e5%9d%a1-%e4%b8%8a%e6%b5%b7%e2%87%8b%e6%a7%9f%e5%9f%8e",
  "slug": "%e6%96%b0%e5%bc%80%e9%80%9a%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e8%88%aa%e7%8f%ad%ef%bc%9a%e8%b4%b5%e9%98%b3%e2%87%8b%e5%90%89%e9%9a%86%e5%9d%a1-%e4%b8%8a%e6%b5%b7%e2%87%8b%e6%a7%9f%e5%9f%8e",
  "canonicalUrlKey": "%e6%96%b0%e5%bc%80%e9%80%9a%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e8%88%aa%e7%8f%ad%ef%bc%9a%e8%b4%b5%e9%98%b3%e2%87%8b%e5%90%89%e9%9a%86%e5%9d%a1-%e4%b8%8a%e6%b5%b7%e2%87%8b%e6%a7%9f%e5%9f%8e",
  "route": "/4539/",
  "title": "\u65B0\u5F00\u901A\u9A6C\u6765\u897F\u4E9A\u822A\u73ED\uFF1A\u8D35\u9633\u21CB\u5409\u9686\u5761 \u4E0A\u6D77\u21CB\u69DF\u57CE",
  "summary": "\u8D35\u9633\u21CB\u5409\u9686\u5761\u822A\u7EBF\u590D\u822A\uFF01162\u540D\u9A6C\u6765\u897F\u4E9A\u65C5\u5BA2\u5C06\u8D74\u8D35\u5B89\u8D4F\u6A31\u82B1 3\u670812\u65E522\u70B905\u5206\uFF0C\u8F7D\u6709162\u540D\u65C5\u5BA2\u7684\u5409\u9686\u5761-\u8D35\u9633-\u5409\u9686\u5761OD608\u822A\u73ED\u964D\u843D\u5728\u8D35\u9633\u9F99\u6D1E\u5821\u56FD\u9645\u673A\u573A\u3002\u8BE5\u65C5\u884C\u56E2\u662F\u4E2D\u9A6C\u4E24\u56FD\u4E92\u514D\u7B7E\u8BC1\u540E\u9996\u4E2A\u6765\u9ED4\u65C5\u6E38\u7684\u9A6C\u6765\u897F\u4E9A\u5305\u673A\u56E2\u3002 \u636E\u6089\uFF0C\u53D7\u75AB\u60C5\u5F71\u54CD\uFF0C\u8D35\u9633\u21CB\u5409\u9686\u5761\u822A\u7EBF\u4E8E2020\u5E74\u505C\u822A\u3002\u65F6\u9694\u56DB\u5E74\uFF0C3\u670812\u65E5\u8D77\uFF0C\u8D35\u9633\u21CB\u5409\u9686\u5761\u822A\u7EBF\u6BCF\u5468\u4E8C\u6267\u98DE\u4E00\u73ED\u3002 \u6B64\u6B21\u65C5\u6E38\u56E2\u884C\u7A0B\u4E3A\u671F7\u665A8\u5929\uFF0C\u6E38\u5BA2\u5C06\u524D\u5F80\u8D35\u9633\u7684\u8D35\u5B89\u6A31\u82B1\u56ED\u3001\u5929\u6CB3\u6F6D\u3001\u9752\u5CA9\u53E4\u9547\u3001\u9752\u4E91\u5E02\u96C6\uFF0C\u5B89\u987A\u7684\u9EC4\u679C\u6811\u7011\u5E03\uFF0C\u9ED4\u5357\u7684\u8354\u6CE2\u5C0F\u4E03\u5B54\u4EE5\u53CA\u9ED4\u897F\u5357\u7684\u4E07\u2026",
  "body": "\u003Cp\u003E\u8D35\u9633\u21CB\u5409\u9686\u5761\u822A\u7EBF\u590D\u822A\uFF01162\u540D\u9A6C\u6765\u897F\u4E9A\u65C5\u5BA2\u5C06\u8D74\u8D35\u5B89\u8D4F\u6A31\u82B1\u003C/p\u003E\n\u003Cp\u003E3\u670812\u65E522\u70B905\u5206\uFF0C\u8F7D\u6709162\u540D\u65C5\u5BA2\u7684\u5409\u9686\u5761-\u8D35\u9633-\u5409\u9686\u5761OD608\u822A\u73ED\u964D\u843D\u5728\u8D35\u9633\u9F99\u6D1E\u5821\u56FD\u9645\u673A\u573A\u3002\u8BE5\u65C5\u884C\u56E2\u662F\u4E2D\u9A6C\u4E24\u56FD\u4E92\u514D\u7B7E\u8BC1\u540E\u9996\u4E2A\u6765\u9ED4\u65C5\u6E38\u7684\u9A6C\u6765\u897F\u4E9A\u5305\u673A\u56E2\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/03/frc-51c09c2ecd8c72a239864968fb7c3a48.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u636E\u6089\uFF0C\u53D7\u75AB\u60C5\u5F71\u54CD\uFF0C\u8D35\u9633\u21CB\u5409\u9686\u5761\u822A\u7EBF\u4E8E2020\u5E74\u505C\u822A\u3002\u65F6\u9694\u56DB\u5E74\uFF0C3\u670812\u65E5\u8D77\uFF0C\u8D35\u9633\u21CB\u5409\u9686\u5761\u822A\u7EBF\u6BCF\u5468\u4E8C\u6267\u98DE\u4E00\u73ED\u3002\u003C/p\u003E\n\u003Cp\u003E\u6B64\u6B21\u65C5\u6E38\u56E2\u884C\u7A0B\u4E3A\u671F7\u665A8\u5929\uFF0C\u6E38\u5BA2\u5C06\u524D\u5F80\u8D35\u9633\u7684\u8D35\u5B89\u6A31\u82B1\u56ED\u3001\u5929\u6CB3\u6F6D\u3001\u9752\u5CA9\u53E4\u9547\u3001\u9752\u4E91\u5E02\u96C6\uFF0C\u5B89\u987A\u7684\u9EC4\u679C\u6811\u7011\u5E03\uFF0C\u9ED4\u5357\u7684\u8354\u6CE2\u5C0F\u4E03\u5B54\u4EE5\u53CA\u9ED4\u897F\u5357\u7684\u4E07\u5CF0\u6797\u3001\u4E07\u5CF0\u6E56\u3001\u9A6C\u5CAD\u6CB3\u5CE1\u8C37\u7B49\u666F\u533A\u666F\u70B9\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/03/frc-7bb7885dccb13e9ae5b1a2736ff08b90.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u4F5C\u4E3A\u6B64\u6B21\u884C\u7A0B\u7684\u91CD\u70B9\uFF0C2\u665A3\u5929\u7684\u8D35\u9633\u4E4B\u65C5\u8BA9\u9A6C\u6765\u897F\u4E9A\u6E38\u5BA2\u7EB7\u7EB7\u8868\u793A\u671F\u5F85\u3002\u6E38\u5BA2\u9EC4\u71D5\u7F8E\u544A\u8BC9\u8BB0\u8005\uFF1A\u201C\u6211\u6700\u671F\u5F85\u7684\u5C31\u662F\u770B\u6A31\u82B1\uFF0C\u4E4B\u524D\u53BB\u65E5\u672C\u6CA1\u770B\u5230\uFF0C\u8FD9\u6B21\u5C31\u6765\u5168\u7403\u6700\u5927\u7684\u6A31\u82B1\u56ED\u770B\u3002\u201D\u6E38\u5BA2\u5B59\u6842\u7EA2\u66FE\u4E8E2003\u5E74\u6765\u8FC7\u8D35\u5DDE\uFF0C\u5BF9\u4E8E\u8D35\u5DDE\u7F8E\u666F\u5341\u5206\u60F3\u5FF5\uFF0C\u5979\u8868\u793A\uFF1A\u201C\u4E0A\u6B21\u6765\u6CA1\u89C1\u8FC7\u90A3\u4E48\u7F8E\u7684\u6A31\u82B1\uFF0C\u5E0C\u671B\u8FD9\u6B21\u80FD\u770B\u5230\u4E07\u4EA9\u6A31\u82B1\u7684\u7F8E\u666F\u3002\u201D\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/03/frc-10f883df1a99a8a6996b96bd1aec9e8e.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u636E\u6089\uFF0C\u4ECE\u53BB\u5E7411\u6708\u5E95\u5F00\u59CB\uFF0C\u8D1F\u8D23\u6B64\u6B21\u5730\u63A5\u4E1A\u52A1\u7684\u8D35\u5DDE\u9ED4\u6765\u662F\u5BA2\u65C5\u884C\u793E\u5C31\u542F\u52A8\u843D\u5B9E\u9A6C\u6765\u897F\u4E9A\u5409\u9686\u5761\u81F3\u8D35\u9633\u5305\u673A\u7EBF\u8DEF\uFF0C\u4E0E\u9A6C\u5370\u822A\u53F8\u7B7E\u8BA2\u7684\u65C5\u6E38\u5305\u673A\u5408\u540C\uFF0C\u4E0E\u5409\u9686\u5761\u524D\u7A0B\u65C5\u6E38\u548C\u9526\u9686\u65C5\u6E38\u4E24\u5BB6\u5F53\u5730\u7EC4\u56E2\u793E\u516C\u53F8\u8FBE\u6210\u5305\u673A\u9500\u552E\u5408\u4F5C\u534F\u8BAE\u3002\u4E0E\u6B64\u540C\u65F6\uFF0C\u4E3A\u63D0\u524D\u9884\u70ED2024\u5E74\u8D35\u5DDE\u6625\u5B63\u65C5\u6E38\u5E02\u573A\uFF0C\u5305\u62EC\u8D35\u5B89\u6A31\u82B1\u5728\u5185\u7684\u8D35\u5DDE\u65C5\u6E38\u5BA3\u4F20\u63A8\u5E7F\u5C31\u5728\u9A6C\u6765\u897F\u4E9A\u5F00\u5C55\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/03/frc-a5375f2af4ac1b33f6aeb37928b5379f.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u8BE5\u65C5\u884C\u793E\u8D1F\u8D23\u4EBA\u80E1\u660C\u864E\u544A\u8BC9\u8BB0\u8005\uFF0C\u201C\u7531\u4E8E\u524D\u51E0\u5E74\u65E5\u672C\u6A31\u82B1\u5728\u9A6C\u6765\u897F\u4E9A\u5E02\u573A\u5927\u53D7\u6B22\u8FCE\uFF0C\u6211\u4EEC\u6295\u653E\u7684\u8D35\u5DDE\u65C5\u6E38\u5BA3\u4F20\u89C6\u9891\u4E2D\uFF0C\u5173\u4E8E\u8D35\u5B89\u6A31\u82B1\u7684\u53CD\u5E94\u51FA\u5947\u5F97\u597D\u3002\u201D\u4E8E\u662F\uFF0C\u8D35\u5DDE\u9ED4\u6765\u662F\u5BA2\u65C5\u884C\u793E\u7CBE\u5FC3\u8BBE\u8BA1\u4E86\u5173\u4E8E\u201C\u8D35\u5B89\u6A31\u82B1\u8D4F\u82B1\u002B\u9752\u5CA9\u96C6\u5E02\u7F8E\u98DF\u002B\u7532\u79C0\u697C\u8D35\u9633\u672C\u571F\u6587\u5316\u201D\u7684\u884C\u7A0B\uFF0C\u4EA7\u54C1\u6295\u653E\u5E02\u573A\u540E\uFF0C\u6536\u5230\u5F88\u591A\u8BA2\u5355\u3002\u636E\u9ED4\u6765\u662F\u5BA2\u65C5\u884C\u793E\u603B\u7ECF\u7406\u5F20\u535A\u4ECB\u7ECD\uFF0C\u76EE\u524D\u5DF2\u67092000\u4F59\u540D\u9A6C\u6765\u897F\u4E9A\u6E38\u5BA2\u62A5\u540D\u53C2\u56E2\u5C06\u5305\u673A\u8D74\u8D35\u5DDE\u65C5\u6E38\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/03/frc-8ee14d8a8dca2c027155438089c9030e.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u636E\u8D35\u5DDE\u6C11\u822A\u96C6\u56E2\u822A\u7A7A\u5E02\u573A\u8425\u9500\u90E8\u603B\u7ECF\u7406\u848B\u7AF9\u8587\u4ECB\u7ECD\uFF0C2024\u5E74\uFF0C\u8D35\u5DDE\u6C11\u822A\u4EA7\u4E1A\u96C6\u56E2\u5C06\u5728\u7A33\u5B9A\u8FD0\u8425\u6CF0\u56FD\u66FC\u8C37\u3001\u666E\u5409\u822A\u7EBF\u7684\u57FA\u7840\u4E0A\uFF0C\u8BA1\u5212\u4F18\u5148\u6062\u590D\u65E5\u672C\u3001\u9A6C\u6765\u897F\u4E9A\u3001\u8D8A\u5357\u3001\u97E9\u56FD\u3001\u6FB3\u95E8\u3001\u53F0\u5317\u7B49\u5BA2\u6E90\u5730\u822A\u7EBF\u822A\u73ED\uFF1B\u6709\u5E8F\u6062\u590D\u65B0\u52A0\u5761\u3001\u67EC\u57D4\u5BE8\u7B49\u56FD\u5BB6\u57CE\u5E02\u822A\u7EBF\u822A\u73ED\uFF0C\u5E76\u901A\u8FC7\u7ECF\u505C\u3001\u4E2D\u8F6C\u8054\u7A0B\u7B49\u591A\u79CD\u65B9\u5F0F\u9010\u6B65\u5F00\u62D3\u6B27\u6D32\u7B49\u56FD\u5BB6\u57CE\u5E02\u822A\u70B9\u822A\u7EBF\u3002\u622A\u81F3\u76EE\u524D\uFF0C\u8D35\u9633\u673A\u573A\u5DF2\u6062\u590D\u8D35\u9633\u81F3\u66FC\u8C37\u3001\u666E\u5409\u3001\u5409\u9686\u5761\u4EE5\u53CA\u8D35\u9633-\u6D66\u4E1C-\u5927\u962A\u56DB\u6761\u56FD\u9645\u53CA\u5730\u533A\u5BA2\u8FD0\u822A\u7EBF\u3002\u003C/p\u003E\n\u003Cp\u003E\u5409\u7965\u822A\u7A7A\u590F\u79CB\u822A\u5B63\u5C06\u9996\u5F00\u9A6C\u6765\u897F\u4E9A\u69DF\u57CE\u5F80\u8FD4\u822A\u73ED\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/03/frc-ca0d49b802ec640be3f46340426df5ba.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E3\u670812\u65E5\uFF0C\u5409\u7965\u822A\u7A7A\u5BA3\u5E03\uFF0C\u5C06\u4E8E2024\u5E74\u65B0\u822A\u5B63\u65B0\u589E\u9A6C\u6765\u897F\u4E9A\u69DF\u57CE\u65B9\u5411\u5F80\u8FD4\u822A\u73ED\uFF0C\u6BCF\u5468\u56DB\u73ED\u3002\u6B64\u4E3E\u5C06\u8FDB\u4E00\u6B65\u5B8C\u5584\u5409\u7965\u822A\u7A7A\u73B0\u6709\u4E1C\u5357\u4E9A\u65B9\u5411\u7684\u822A\u7EBF\u7F51\u7EDC\u5E03\u5C40\uFF0C\u63A8\u52A8\u56FD\u9645\u65C5\u884C\u7684\u6301\u7EED\u5065\u5EB7\u590D\u82CF\u3002\u003C/p\u003E\n\u003Cp\u003E\u6839\u636E\u822A\u73ED\u8BA1\u5212\uFF0C\u5409\u7965\u822A\u7A7A\u8BA1\u5212\u4E8E5\u670831\u65E5\u8D77\u65B0\u589E\u4E0A\u6D77\u6D66\u4E1C-\u69DF\u57CE\u76F4\u98DE\u822A\u73ED\uFF0C\u4F7F\u7528\u7A7A\u5BA2A320\u7CFB\u5217\u98DE\u673A\uFF0C\u6BCF\u5468\u56DB\u73ED\uFF0C\u53BB\u7A0BHO1365\u822A\u73ED\u4E8E\u5317\u4EAC\u65F6\u95F417:30\u81EA\u6D66\u4E1C\u673A\u573A\u8D77\u98DE\u3001\u5F53\u5730\u65F6\u95F423:00\u98DE\u62B5\u69DF\u57CE\uFF1B\u8FD4\u7A0BHO1366\u822A\u73ED\u8BA1\u5212\u6B21\u65E5\u51CC\u666800:05\u51FA\u53D1\uFF0C\u65E9\u95F405:25\u8FD4\u56DE\u6D66\u4E1C\u3002\u8BE5\u822A\u7EBF\u4E5F\u662F\u5409\u7965\u822A\u7A7A\u9996\u6B21\u6267\u884C\u98DE\u5F80\u9A6C\u6765\u897F\u4E9A\u7684\u5B9A\u671F\u5BA2\u8FD0\u822A\u73ED\u3002\u003C/p\u003E\n\u003Cp\u003E\u76EE\u524D\uFF0C\u9A6C\u6765\u897F\u4E9A\u5BF9\u4E2D\u56FD\u516C\u6C11\u5B9E\u65BD\u505C\u7559\u4E0D\u8D85\u8FC730\u5929\u53EF\u514D\u7B7E\u5165\u5883\u7684\u4FBF\u5229\u63AA\u65BD\u3002\u4E2D\u56FD\u516C\u6C11\u5165\u5883\u9A6C\u6765\u897F\u4E9A\u524D\u4E09\u5929\u5185\u9700\u5B8C\u6210\u9A6C\u6765\u897F\u4E9A\u7535\u5B50\u5165\u5883\u5361MDAC\u7684\u586B\u5199\u7533\u62A5\uFF0C\u5E76\u6253\u5370\u7EB8\u8D28\u7248MDAC\u786E\u8BA4\u4FE1\u5728\u5165\u5883\u65F6\u5411\u79FB\u6C11\u5B98\u5458\u51FA\u793A\u3002\u003C/p\u003E\n\u003Cp\u003E\u636E\u4E86\u89E3\uFF0C\u5305\u62EC\u69DF\u57CE\u5728\u5185\uFF0C\u5409\u7965\u822A\u7A7A\u5728\u5373\u5C06\u5230\u6765\u76842024\u5E74\u590F\u79CB\u822A\u5B63\u4E2D\uFF0C\u8BA1\u5212\u6BCF\u5468\u5728\u4E1C\u5357\u4E9A\u65B9\u5411\u5E73\u5747\u6295\u653E\u8FD1\u767E\u4E2A\u5F80\u8FD4\u822A\u73ED\u8FD0\u529B\uFF0C\u5176\u4E2D\uFF0C\u6CF0\u56FD\u65B9\u5411\u6BCF\u5468\u5F80\u8FD4\u8FD160\u73ED\uFF0C\u5206\u522B\u524D\u5F80\u66FC\u8C37\u3001\u666E\u5409\u4E0E\u6E05\u8FC8\uFF1B\u65B0\u52A0\u5761\u65B9\u5411\u6BCF\u5468\u5F80\u8FD421\u73ED\u3002\u53E6\u5916\uFF0C\u5409\u7965\u822A\u7A7A\u8FD8\u8FD0\u8425\u6BCF\u54687\u73ED\u4E0A\u6D77\u81F3\u5370\u5C3C\u5DF4\u5398\u5C9B\u5F80\u8FD4\u822A\u73ED\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/tKbX3X_ijexeokMaGMNUGw\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
