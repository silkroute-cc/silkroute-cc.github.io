  "route": "/5328/",
  "title": "\u7802\u62C9\u8D8A\u5177\u5907\u5438\u5F15\u9AD8\u79D1\u6280\u4EA7\u4E1A\u4E0E\u7EFF\u8272\u6295\u8D44\u72EC\u7279\u4F18\u52BF",
  "summary": "\uFF08\u53E4\u664B20\u65E5\u8BAF\uFF09\u7802\u62C9\u8D8A\u56FD\u9645\u8D38\u6613\u4E0E\u6295\u8D44\u90E8\u90E8\u957F\u62FF\u7763\u963F\u739B\u963F\u65FA\u767B\u96C5\u8868\u793A\uFF0C\u7802\u62C9\u8D8A\u5177\u5907\u5438\u5F15\u9AD8\u79D1\u6280\u4EA7\u4E1A\u4E0E\u7EFF\u8272\u6295\u8D44\u7684\u72EC\u7279\u4F18\u52BF\uFF0C\u5305\u62EC\u53EF\u6301\u7EED\u80FD\u6E90\u3001\u9AD8\u79D1\u6280\u5236\u9020\u548C\u7EFC\u5408\u77F3\u5316\u9886\u57DF\uFF0C\u5C06\u52A9\u63A8\u7802\u62C9\u8D8A\u8FC8\u5411\u6280\u672F\u521B\u65B0\u9A71\u52A8\u7684\u7ECF\u6D4E\u53D1\u5C55\u65B0\u9AD8\u5730\u3002 \u4ED6\u5F3A\u8C03\u7802\u62C9\u8D8A\u5728\u5438\u5F15\u6295\u8D44\u3001\u9AD8\u79D1\u6280\u4EA7\u4E1A\u53D1\u5C55\u4EE5\u53CA\u80FD\u6E90\u8F6C\u578B\u65B9\u9762\u7684\u663E\u7740\u8FDB\u5C55\uFF0C\u622A\u81F32024\u5E74\u7B2C\u4E09\u5B63\u5EA6\uFF0C\u7802\u62C9\u8D8A\u5DF2\u521D\u6B65\u6279\u51C6\u4EF7\u503C104\u4EBF3000\u4E07\u4EE4\u5409\u7684\u6295\u8D44\uFF0C\u6D89\u53CA212\u4E2A\u9879\u76EE\uFF0C\u9884\u8BA1\u521B\u90205400\u4E2A\u65B0\u5DE5\u4F5C\u5C97\u4F4D\u3002\u5176\u4E2D\uFF0C\u56FD\u5185\u76F4\u63A5\u6295\u8D44\uFF08DDI\uFF09\u536071\u4EBF8000\u4E07\u4EE4\u5409\uFF0C\u800C\u5916\u8D44\uFF08FDI\uFF09\u8D21\u732E32\u4EBF5000\u2026",
  "body": "\u003Cp\u003E\uFF08\u53E4\u664B20\u65E5\u8BAF\uFF09\u7802\u62C9\u8D8A\u56FD\u9645\u8D38\u6613\u4E0E\u6295\u8D44\u90E8\u90E8\u957F\u62FF\u7763\u963F\u739B\u963F\u65FA\u767B\u96C5\u8868\u793A\uFF0C\u7802\u62C9\u8D8A\u5177\u5907\u5438\u5F15\u9AD8\u79D1\u6280\u4EA7\u4E1A\u4E0E\u7EFF\u8272\u6295\u8D44\u7684\u72EC\u7279\u4F18\u52BF\uFF0C\u5305\u62EC\u53EF\u6301\u7EED\u80FD\u6E90\u3001\u9AD8\u79D1\u6280\u5236\u9020\u548C\u7EFC\u5408\u77F3\u5316\u9886\u57DF\uFF0C\u5C06\u52A9\u63A8\u7802\u62C9\u8D8A\u8FC8\u5411\u6280\u672F\u521B\u65B0\u9A71\u52A8\u7684\u7ECF\u6D4E\u53D1\u5C55\u65B0\u9AD8\u5730\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u5F3A\u8C03\u7802\u62C9\u8D8A\u5728\u5438\u5F15\u6295\u8D44\u3001\u9AD8\u79D1\u6280\u4EA7\u4E1A\u53D1\u5C55\u4EE5\u53CA\u80FD\u6E90\u8F6C\u578B\u65B9\u9762\u7684\u663E\u7740\u8FDB\u5C55\uFF0C\u622A\u81F32024\u5E74\u7B2C\u4E09\u5B63\u5EA6\uFF0C\u7802\u62C9\u8D8A\u5DF2\u521D\u6B65\u6279\u51C6\u4EF7\u503C104\u4EBF3000\u4E07\u4EE4\u5409\u7684\u6295\u8D44\uFF0C\u6D89\u53CA212\u4E2A\u9879\u76EE\uFF0C\u9884\u8BA1\u521B\u90205400\u4E2A\u65B0\u5DE5\u4F5C\u5C97\u4F4D\u3002\u5176\u4E2D\uFF0C\u56FD\u5185\u76F4\u63A5\u6295\u8D44\uFF08DDI\uFF09\u536071\u4EBF8000\u4E07\u4EE4\u5409\uFF0C\u800C\u5916\u8D44\uFF08FDI\uFF09\u8D21\u732E32\u4EBF5000\u4E07\u4EE4\u5409\u3002\u003C/p\u003E\n\u003Cp\u003E\u963F\u65FA\u767B\u96C5\u662F\u4ECA\u65E5\u5728\u7802\u7ACB\u6CD5\u8BAE\u4F1A\u4E0A\u4E3A\u5176\u90E8\u95E8\u603B\u7ED3\u65F6\uFF0C\u5982\u662F\u8868\u793A\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u5236\u9020\u4E1A\u662F\u4E3B\u8981\u8D21\u732E\u9886\u57DF\uFF0C\u5360\u6295\u8D44\u603B\u989D\u768455.7% \u8FBE58\u4EBF1000\u4E07\u4EE4\u5409\uFF0C\u91CD\u70B9\u9879\u76EE\u5305\u62EC\uFF0C\u5316\u5B66\u4EA7\u54C1\uFF08\u5C3F\u7D20\u3001\u4E09\u805A\u6C30\u80FA\u53CA\u5316\u80A5\uFF0920\u4EBF\u4EE4\u5409\u3001\u7535\u5B50\u4E0E\u7535\u6C14\u4EA7\u54C1\uFF08\u592A\u9633\u80FD\u7EC4\u4EF6\uFF0912\u4EBF\u4EE4\u5409\u3001\u975E\u91D1\u5C5E\u77FF\u7269\u4EA7\u54C1\uFF08\u6C34\u6CE5\u4E0E\u719F\u6599\uFF098\u4EBF\u4EE4\u5409\u3001\u670D\u52A1\u4E1A\u536028.5%\uFF0C\u8D21\u732E29\u4EBF7000\u4E07\u4EE4\u5409\uFF0C\u4EE5\u53CA\u521D\u7EA7\u4EA7\u4E1A\u536015.8% \u8FBE16\u4EBF5000\u4E07\u4EE4\u5409\u3002\u003C/p\u003E\n\u003Cp\u003E\u963F\u65FA\u767B\u96C5\u6307\u51FA\uFF0C\u81EA2020\u5E74\u4EE5\u6765\uFF0C\u7802\u62C9\u8D8A356\u4E2A\u83B7\u6279\u5236\u9020\u4E1A\u548C\u76F8\u5173\u670D\u52A1\u9879\u76EE\u4E2D\uFF0C\u5DF2\u670957%\u5171\u6709204\u4E2A\u9879\u76EE\u5B8C\u6210\u843D\u5730\uFF0C\u8FDB\u4E00\u6B65\u5DE9\u56FA\u7802\u62C9\u8D8A\u4F5C\u4E3A\u9AD8\u79D1\u6280\u4EA7\u4E1A\u5438\u5F15\u5730\u7684\u5730\u4F4D\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BA4\u4E3A\u4FEE\u8BA2\u540E\u76842023\u5E74\u7535\u529B\u4E3A\u4F4E\u78B3\u80FD\u6E90\u6295\u8D44\u521B\u9020\u4E86\u66F4\u591A\u673A\u9047\uFF0C\u7802\u62C9\u8D8A\u4E0E\u963F\u5E03\u624E\u6BD4\u6295\u8D44\u8005\u7B7E\u7F72\u534F\u8BAE\uFF0C\u5171\u540C\u63A2\u8BA8\u5728Murum\u5F00\u53D1\u6D6E\u52A8\u592A\u9633\u80FD\u9879\u76EE\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u900F\u9732\uFF0C\u8FD9\u5C06\u52A0\u901F\u7802\u62C9\u8D8A\u80FD\u6E90\u7ED3\u6784\u5411\u53EF\u518D\u751F\u80FD\u6E90\u8F6C\u578B\uFF0C\u5438\u5F15\u66F4\u591A\u7EFF\u8272\u6295\u8D44\uFF0C\u63A8\u52A8\u53EF\u6301\u7EED\u4EA7\u4E1A\u53D1\u5C55\u3002\u003C/p\u003E\n\u003Cp\u003E\u963F\u65FA\u767B\u96C5\u6307\u51FA\uFF0CPETROS\u4F5C\u4E3A\u7802\u62C9\u8D8A\u5C5E\u6CB9\u6C14\u516C\u53F8\uFF0C\u73B0\u4E3A\u9A6C\u6765\u897F\u4E9A\u7B2C\u4E09\u5927\u6CB9\u6C14\u80A1\u6743\u751F\u4EA7\u5546\uFF0C\u53C2\u4E0E20\u9879\u751F\u4EA7\u5206\u6210\u5408\u540C\uFF08PSC\uFF09\uFF0C\u8986\u76D6\u4E0A\u4E0B\u6E38\u5168\u4EA7\u4E1A\u94FE\u3002\u003C/p\u003E\n\u003Cp\u003E\u6839\u636E\u7802\u62C9\u8D8A\u5929\u7136\u6C14\u8DEF\u7EBF\u56FE\uFF08SGR\uFF09\uFF0CPETROS\u6B63\u6295\u8D44\u4E2D\u6E38\u57FA\u7840\u8BBE\u65BD\uFF0C\u8FDE\u63A5\u7F8E\u91CC\u3001\u4E09\u9A6C\u62C9\u5982\u3001\u6C11\u90FD\u9C81\u548C\u53E4\u664B\u56DB\u5927\u67A2\u7EBD\uFF0C\u76EE\u6807\u662F\u5C06\u7802\u62C9\u8D8A\u5929\u7136\u6C14\u56FD\u5185\u4F7F\u7528\u7387\u4ECE\u5F53\u524D\u76846%\u63D0\u5347\u81F330%\uFF0C\u9884\u8BA1\u5438\u5F151500\u4EBF\u81F32000\u4EBF\u4EE4\u5409\u6295\u8D44\uFF0C\u521B\u9020\u8D85\u8FC710\u4E07\u4E2A\u4F18\u8D28\u5DE5\u4F5C\u5C97\u4F4D\uFF0C\u5E76\u63D0\u5347\u7802\u62C9\u8D8A\u56FD\u5185\u751F\u4EA7\u603B\u503C\u8FBE10%\u81F315%\u3002\u003C/p\u003E\n\u003Cp\u003E\u5728\u78B3\u6355\u83B7\u4E0E\u5C01\u5B58\uFF08CCUS\uFF09\u9886\u57DF\uFF0C\u7802\u62C9\u8D8A\u62E5\u6709\u7EA63\u4E07\u4EBF\u7ACB\u65B9\u7C73\u7684\u4E8C\u6C27\u5316\u78B3\u5B58\u50A8\u80FD\u529B\uFF0C\u8BA1\u5212\u53D1\u5C55\u4E3A\u5168\u7403\u9886\u5148\u7684\u78B3\u5C01\u5B58\u4E2D\u5FC3\u3002SHELL\u5728\u6C11\u90FD\u9C81Rosmari-Marjoram\u5929\u7136\u6C14\u9879\u76EE\u6295\u8D44\u8FBE90\u4EBF\u4EE4\u5409\uFF0C\u8BA1\u52122026\u5E74\u5E95\u6295\u5165\u751F\u4EA7\u3002PETRONAS\u5728\u7802\u62C9\u8D8A\u4E0A\u6E38\u6CB9\u6C14\u9886\u57DF\u5DF2\u6295\u5165170\u4EBF\u4EE4\u5409\uFF0C\u5176\u4E2D110\u4EBF\u4EE4\u5409\u7528\u4E8E\u65B0\u9879\u76EE\u8D44\u672C\u5F00\u652F\uFF0C\u672C\u5730\u5316\u7387\u8FBE90.6%\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/iWP2MMHa1Qrgh-wQHcJRvA\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
