  "slug": "%e6%89%b9%e5%87%86%e6%8a%95%e8%b5%842250%e4%ba%bf-%e6%89%8e%e5%a4%ab%e9%b2%81%e6%95%b0%e5%ad%97%e7%bb%8f%e6%b5%8e%e5%8d%a070",
  "canonicalUrlKey": "%e6%89%b9%e5%87%86%e6%8a%95%e8%b5%842250%e4%ba%bf-%e6%89%8e%e5%a4%ab%e9%b2%81%e6%95%b0%e5%ad%97%e7%bb%8f%e6%b5%8e%e5%8d%a070",
