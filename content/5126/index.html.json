{
  "id": "%e5%8d%8f%e4%bc%9a%e4%bb%a3%e8%a1%a8%e5%9b%a2%e8%b5%b4%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e8%ae%bf%e9%97%ae%e4%ba%a4%e6%b5%81%ef%bc%8c%e5%85%b1%e5%90%8c%e6%8e%a2%e8%ae%a8%e8%bd%a8%e9%81%93%e4%ba%a4",
  "slug": "%e5%8d%8f%e4%bc%9a%e4%bb%a3%e8%a1%a8%e5%9b%a2%e8%b5%b4%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e8%ae%bf%e9%97%ae%e4%ba%a4%e6%b5%81%ef%bc%8c%e5%85%b1%e5%90%8c%e6%8e%a2%e8%ae%a8%e8%bd%a8%e9%81%93%e4%ba%a4",
  "canonicalUrlKey": "%e5%8d%8f%e4%bc%9a%e4%bb%a3%e8%a1%a8%e5%9b%a2%e8%b5%b4%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e8%ae%bf%e9%97%ae%e4%ba%a4%e6%b5%81%ef%bc%8c%e5%85%b1%e5%90%8c%e6%8e%a2%e8%ae%a8%e8%bd%a8%e9%81%93%e4%ba%a4",
  "route": "/5126/",
  "title": "\u534F\u4F1A\u4EE3\u8868\u56E2\u8D74\u9A6C\u6765\u897F\u4E9A\u8BBF\u95EE\u4EA4\u6D41\uFF0C\u5171\u540C\u63A2\u8BA8\u8F68\u9053\u4EA4\u901A\u9886\u57DF\u5408\u4F5C\u65B0\u673A\u9047",
  "summary": "\u70B9\u51FB\u84DD\u5B57 \u5173\u6CE8\u201C\u4E2D\u56FD\u57CE\u5E02\u8F68\u9053\u4EA4\u901A\u534F\u4F1A\u201D #\u878D\u5408\u57CE\u8F68 #\u65E2\u6709\u7EBF\u6539\u9020 9\u67081\u65E5\u81F34\u65E5\uFF0C\u5E94\u9A6C\u6765\u897F\u4E9A\u516C\u5171\u4EA4\u901A\u8FD0\u8425\u5546\u9A6C\u6765\u897F\u4E9A\u56FD\u5BB6\u57FA\u5EFA\u516C\u53F8\u9080\u8BF7\uFF0C\u4E2D\u56FD\u57CE\u5E02\u8F68\u9053\u4EA4\u901A\u534F\u4F1A\u526F\u4F1A\u957F\u4EF2\u5EFA\u534E\u7387\u56E2\u5BF9\u9A6C\u6765\u897F\u4E9A\u8FDB\u884C\u4E86\u4E3A\u671F\u56DB\u5929\u7684\u8F68\u9053\u4EA4\u901A\u4EA4\u6D41\u4E0E\u8003\u5BDF\u3002\u53D1\u6325\u4E2D\u56FD\u57CE\u5E02\u8F68\u9053\u4EA4\u901A\u534F\u4F1A\u6865\u6881\u4E0E\u7EBD\u5E26\u4F5C\u7528\uFF0C\u63A8\u52A8\u4E24\u56FD\u8F68\u9053\u4EA4\u901A\u884C\u4E1A\u7684\u5171\u540C\u53D1\u5C55\u4E0E\u8FDB\u6B65\u3002 \u4EE3\u8868\u56E2\u5206\u522B\u8BBF\u95EE\u4E86\u9A6C\u6765\u897F\u4E9A\u94C1\u8DEF\u53D1\u5C55\u516C\u53F8\uFF08MRDC\uFF09\u3001\u9A6C\u6765\u897F\u4E9A\u94C1\u9053\u516C\u53F8\uFF08M Rail\uFF09\u53CA\u5176\u7EF4\u4FDD\u4E1A\u52A1\u5B50\u516C\u53F8\uFF08KTMB\uFF09\u3001\u9A6C\u6765\u897F\u4E9A\u57CE\u8F68\u6295\u8D44\u8FD0\u8425\u516C\u53F8\uFF08PMB\uFF09\uFF0C\u73B0\u573A\u8003\u5BDF\u4E86\u5409\u9686\u5761\u8F7B\u8F68\u548C\u5730\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/09/frc-47c7cfafe160a09c8b917ee4c369a947.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u70B9\u51FB\u84DD\u5B57 \u5173\u6CE8\u201C\u4E2D\u56FD\u57CE\u5E02\u8F68\u9053\u4EA4\u901A\u534F\u4F1A\u201D\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u003Ca href=\u0022https://mp.weixin.qq.com/mp/appmsgalbum?__biz=MzI3NzMwODY3OQ%3D%3D\u0026amp;action=getalbum\u0026amp;album_id=3542695616134856708#wechat_redirect\u0022 rel=\u0022noopener noreferrer\u0022\u003E#\u878D\u5408\u57CE\u8F68\u003C/a\u003E\u003C/strong\u003E\u003Cstrong\u003E\u003Ca href=\u0022https://mp.weixin.qq.com/mp/appmsgalbum?__biz=MzI3NzMwODY3OQ%3D%3D\u0026amp;action=getalbum\u0026amp;album_id=3542696335374106636#wechat_redirect\u0022 rel=\u0022noopener noreferrer\u0022\u003E#\u65E2\u6709\u7EBF\u6539\u9020\u003C/a\u003E\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E9\u67081\u65E5\u81F34\u65E5\uFF0C\u5E94\u9A6C\u6765\u897F\u4E9A\u516C\u5171\u4EA4\u901A\u8FD0\u8425\u5546\u9A6C\u6765\u897F\u4E9A\u56FD\u5BB6\u57FA\u5EFA\u516C\u53F8\u9080\u8BF7\uFF0C\u4E2D\u56FD\u57CE\u5E02\u8F68\u9053\u4EA4\u901A\u534F\u4F1A\u526F\u4F1A\u957F\u4EF2\u5EFA\u534E\u7387\u56E2\u5BF9\u9A6C\u6765\u897F\u4E9A\u8FDB\u884C\u4E86\u4E3A\u671F\u56DB\u5929\u7684\u8F68\u9053\u4EA4\u901A\u4EA4\u6D41\u4E0E\u8003\u5BDF\u3002\u53D1\u6325\u4E2D\u56FD\u57CE\u5E02\u8F68\u9053\u4EA4\u901A\u534F\u4F1A\u6865\u6881\u4E0E\u7EBD\u5E26\u4F5C\u7528\uFF0C\u63A8\u52A8\u4E24\u56FD\u8F68\u9053\u4EA4\u901A\u884C\u4E1A\u7684\u5171\u540C\u53D1\u5C55\u4E0E\u8FDB\u6B65\u3002\u003C/p\u003E\n\u003Cp\u003E\u4EE3\u8868\u56E2\u5206\u522B\u8BBF\u95EE\u4E86\u9A6C\u6765\u897F\u4E9A\u94C1\u8DEF\u53D1\u5C55\u516C\u53F8\uFF08MRDC\uFF09\u3001\u9A6C\u6765\u897F\u4E9A\u94C1\u9053\u516C\u53F8\uFF08M Rail\uFF09\u53CA\u5176\u7EF4\u4FDD\u4E1A\u52A1\u5B50\u516C\u53F8\uFF08KTMB\uFF09\u3001\u9A6C\u6765\u897F\u4E9A\u57CE\u8F68\u6295\u8D44\u8FD0\u8425\u516C\u53F8\uFF08PMB\uFF09\uFF0C\u73B0\u573A\u8003\u5BDF\u4E86\u5409\u9686\u5761\u8F7B\u8F68\u548C\u5730\u94C1\u7CFB\u7EDF\uFF0C\u53C2\u89C2\u4E86\u8F68\u9053\u4EA4\u901A\u8F66\u7AD9\uFF0C\u4E58\u5750\u4E86\u8DE8\u5EA7\u5F0F\u5355\u8F68\u548C\u5730\u94C1\uFF0C\u6DF1\u5165\u4E86\u89E3\u4E86\u5F53\u5730\u8F68\u9053\u4EA4\u901A\u7684\u6295\u8D44\u3001\u5EFA\u8BBE\u3001\u8FD0\u8425\u53CA\u7ECF\u8425\u60C5\u51B5\uFF0C\u8003\u5BDF\u4E86\u5409\u9686\u5761\u4F1A\u5C55\u4E2D\u5FC3\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/09/frc-b6a5198ed67c73312032487187f6efe5.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/09/frc-951f9475a226c2e609a5d58775ab6143.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u4EE3\u8868\u56E2\u4E0E\u9A6C\u65B9\u5C31\u8F68\u9053\u4EA4\u901A\u7684\u6218\u7565\u65B9\u5411\u3001\u672C\u571F\u5316\u8BBE\u5907\u4E0E\u4EBA\u624D\u57F9\u517B\u4EE5\u53CA\u5168\u751F\u547D\u5468\u671F\u7684\u8FD0\u8425\u7EF4\u62A4\u7B49\u8BAE\u9898\u8FDB\u884C\u4E86\u6DF1\u5165\u63A2\u8BA8\u3002\u4ECB\u7ECD\u4E86\u4E2D\u56FD\u57CE\u5E02\u8F68\u9053\u4EA4\u901A\u5168\u4EA7\u4E1A\u94FE\u7684\u4F18\u52BF\uFF0C\u63A2\u8BA8\u4E86\u5982\u4F55\u5C06\u8FD9\u4E9B\u4F18\u52BF\u8F6C\u5316\u4E3A\u63A8\u52A8\u9A6C\u6765\u897F\u4E9A\u8F68\u9053\u4EA4\u901A\u53D1\u5C55\u7684\u52A8\u529B\u3002\u9488\u5BF9\u8F68\u9053\u4EA4\u901A\u5168\u751F\u547D\u5468\u671F\u7684\u667A\u80FD\u7EF4\u62A4\u4FDD\u517B\u95EE\u9898\uFF0C\u53CC\u65B9\u4EA4\u6D41\u4E86\u5982\u4F55\u63D0\u5347\u8FD0\u884C\u6548\u7387\uFF0C\u964D\u4F4E\u767E\u4E07\u516C\u91CC\u6545\u969C\u7387\u7684\u4FDD\u969C\u63AA\u65BD\uFF0C\u63A2\u8BA8\u4E86\u6F5C\u5728\u7684\u5408\u4F5C\u673A\u4F1A\u3002\u003C/p\u003E\n\u003Cp\u003E\u540C\u671F\uFF0C\u4EE3\u8868\u56E2\u4E0E\u4E2D\u8F66\u3001\u4EAC\u6295\u79D1\u6280\u3001\u5510\u5C71\u767E\u5DDD\u7B49\u4E2D\u8D44\u4F01\u4E1A\u9A7B\u9A6C\u4EE3\u8868\u53EC\u5F00\u4E86\u4EA4\u6D41\u5EA7\u8C08\u4F1A\uFF0C\u5168\u9762\u4E86\u89E3\u5404\u4F01\u4E1A\u5728\u9A6C\u6765\u897F\u4E9A\u7684\u4E1A\u52A1\u5F00\u5C55\u60C5\u51B5\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/09/frc-7694d0d91d481c2ff0ff5da9eb4c5905.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/09/frc-0309e01f548a3657d8988b27322aac9d.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/09/frc-632f7d4a1267725e3fbcc33690e6451e.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/09/frc-c584046c94ac46fc96e4fbdcd1a5e9a6.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/09/frc-a413393c3db91bb3d501c5392e76f3ca.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/09/frc-9ca3903d3b168d2069348a304d9fb777.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u4EE3\u8868\u56E2\u8BBF\u95EE\u4E86\u9A6C\u6765\u897F\u4E9A\u57CE\u8F68\u6295\u8D44\u8FD0\u8425\u516C\u53F8Prasarana Malaysia Berhad\uFF08PMB\uFF09\uFF0C\u53CC\u65B9\u5C31\u591A\u9879\u5408\u4F5C\u4E8B\u5B9C\u8FBE\u6210\u4E86\u5171\u8BC6\u3002\u5728\u57CE\u5E02\u8F68\u9053\u4EA4\u901A\u7684\u7ECF\u8425\u3001\u8FD0\u8425\u53CA\u7EF4\u62A4\u4FDD\u517B\u7B49\u9886\u57DF\u5C55\u73B0\u4E86\u5F3A\u70C8\u7684\u5408\u4F5C\u610F\u5411\uFF0C\u8BA8\u8BBA\u4E86\u5177\u4F53\u7684\u5408\u4F5C\u6A21\u5F0F\u548C\u8DEF\u5F84\u3002\u4E3A\u8FDB\u4E00\u6B65\u589E\u8FDB\u76F8\u4E92\u4E86\u89E3\uFF0C\u9A6C\u65B9\u8868\u8FBE\u4E86\u7EC4\u7EC7\u4EE3\u8868\u56E2\u524D\u5F80\u4E2D\u56FD\u8F68\u9053\u4EA4\u901A\u8FD0\u8425\u4F01\u4E1A\u548C\u88C5\u5907\u4F01\u4E1A\u8FDB\u884C\u8003\u5BDF\u7684\u613F\u671B\uFF0C\u9009\u62E9\u4E00\u4E2A\u4E0E\u5409\u9686\u5761\u8F68\u9053\u4EA4\u901A\u89C4\u6A21\u76F8\u5F53\u7684\u57CE\u5E02\u4F5C\u4E3A\u6837\u677F\uFF0C\u9488\u5BF9\u5409\u9686\u5761\u7684\u8F68\u9053\u4EA4\u901A\u53D1\u5C55\u9700\u6C42\u8FDB\u884C\u6DF1\u5165\u8C03\u7814\u548C\u5B66\u4E60\uFF0C\u5F00\u5C55\u6280\u672F\u4EA4\u6D41\u3002\u8BA1\u5212\u8054\u5408\u4E3E\u529E\u9488\u5BF9\u9AD8\u5C42\u7BA1\u7406\u4EBA\u5458\u667A\u80FD\u8FD0\u7EF4\u65B9\u9762\u9700\u6C42\u7684\u57F9\u8BAD\u6D3B\u52A8\uFF0C\u63D0\u9AD8\u53CC\u65B9\u591A\u5236\u5F0F\u8F68\u9053\u4EA4\u901A\u8FD0\u7EF4\u53CA\u7BA1\u7406\u6C34\u5E73\u3002\u5171\u540C\u7814\u7A76\u7B56\u5212\u4E3E\u529E\u4E00\u5E26\u4E00\u8DEF\uFF08\u4E1C\u76DF\uFF09\u8F68\u9053\u4EA4\u901A\u56FD\u9645\u5C55\u89C8\u4F1A\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/09/frc-12f6903b80901ac2dd0ee89711d71edd.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u534F\u4F1A\u526F\u79D8\u4E66\u957F\u674E\u5143\u80DC\uFF0C\u4E13\u5BB6\u5B66\u672F\u59D4\u3001\u4F1A\u5C55\u516C\u53F8\u53CA\u76F8\u5173\u4F1A\u5458\u5355\u4F4D\u8D1F\u8D23\u4EBA\u968F\u56E2\u53C2\u52A0\u4E86\u672C\u6B21\u4EA4\u6D41\u8003\u5BDF\u6D3B\u52A8\u3002\u003C/p\u003E\n\u003Cp\u003E\u4F9B\u7A3F\uFF1A\u4E13\u5BB6\u5B66\u672F\u59D4\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/09/frc-6d1aff71714c0197584edffc9602e594.jpg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/09/frc-b870ddb6f3fdad677ffaac9e39da9cf5.jpg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/09/frc-9a974b30d9972a3dfc4fd215e24e4ff2.jpg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/09/frc-d52dbc9b7d3197d9eb858c2fe8dda906.jpg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/09/frc-cf08c8de21e23510cfaff02503d6518f.jpg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/-SIK0o2raObKlAnRx1XHuw\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
