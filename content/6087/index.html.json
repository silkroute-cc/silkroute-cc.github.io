uan Tan Kar Hing \u9648\u5BB6\u5174\u003C/li\u003E\n\u003Cli\u003E\u9EC4\u6D01\uFF0C\u4E9A\u6D32\u521B\u65B0\u7814\u7A76\u4E2D\u5FC3\uFF08AIRH\uFF09\u5E38\u52A1\u526F\u9662\u957F\u003C/li\u003E\n\u003Cli\u003E\u5F20\u626C\uFF0C\u987A\u4E30\u9A6C\u6765\u897F\u4E9A\u533A\u8D1F\u8D23\u4EBA\u003C/li\u003E\n\u003Cli\u003E\u5F90\u5189\uFF0C\u987A\u4E30\u5317\u4EAC\u533A\u56FD\u9645\u4E1A\u52A1\u8D1F\u8D23\u4EBA\u5F90\u5189\u003C/li\u003E\n\u003Cli\u003E\u8BB8\u5FD7\u4F1F\uFF0C\u987A\u4E30\u79D1\u6280\u534E\u5317\u533A\u79D1\u6280\u652F\u6301\u90E8\u8D1F\u8D23\u4EBA\u003C/li\u003E\n\u003C/ul\u003E\n\u003Cp\u003E\u4E0A\u8FF0\u63A5\u5F85\u4EE3\u8868\u4E0E\u9A6C\u6765\u897F\u4E9A\u4EE3\u8868\u56E2\u8FDB\u884C\u4E86\u4EA4\u6D41\u3002\u003C/p\u003E\n\u003Ch3\u003E\u8D70\u8FDB\u4E00\u7EBF\u8FD0\u8425\u4F53\u7CFB\uFF1A\u73B0\u4EE3\u7269\u6D41\u7F51\u7EDC\u5982\u4F55\u534F\u540C\u003C/h3\u003E\n\u003Cp\u003E\u4EE3\u8868\u56E2\u9996\u5148\u5B9E\u5730\u53C2\u89C2\u987A\u4E30\u534E\u5317\u5206\u62E8\u4E2D\u5FC3\uFF0C\u4E86\u89E3\u5927\u578B\u7EFC\u5408\u7269\u6D41\u4F01\u4E1A\u5728\u533A\u57DF\u5206\u62E8\u3001\u8FD0\u8F93\u7EC4\u7EC7\u3001\u7F51\u7EDC\u534F\u540C\u53CA\u65E5\u5E38\u8FD0\u8425\u7B49\u65B9\u9762\u7684\u8FD0\u884C\u6A21\u5F0F\u3002\u003C/p\u003E\n\u003Cp\u003E\u73B0\u573A\u8BB2\u89E3\u4E2D\uFF0C\u987A\u4E30\u9A6C\u6765\u897F\u4E9A\u65B9\u9762\u4ECB\u7ECD\u4E86\u7269\u6D41\u5305\u88F9\u5728\u6536\u5BC4\u3001\u8FD0\u8F93\u3001\u4E2D\u8F6C\u3001\u5206\u62E8\u53CA\u914D\u9001\u7B49\u73AF\u8282\u7684\u8FD0\u8425\u4F53\u7CFB\uFF0C\u4EE5\u53CA\u5982\u4F55\u901A\u8FC7\u89C4\u6A21\u5316\u7F51\u7EDC\u548C\u6570\u5B57\u5316\u7BA1\u7406\u63D0\u5347\u7269\u6D41\u670D\u52A1\u6548\u7387\u3002\u003C/p\u003E\n\u003Cp\u003E\u4EE3\u8868\u56E2\u6210\u5458\u901A\u8FC7\u73B0\u573A\u89C2\u5BDF\uFF0C\u5BF9\u4E2D\u56FD\u7269\u6D41\u4F01\u4E1A\u5982\u4F55\u4F9D\u6258\u5B8C\u5584\u7684\u7269\u6D41\u57FA\u7840\u8BBE\u65BD\u3001\u6807\u51C6\u5316\u8FD0\u8425\u4F53\u7CFB\u548C\u6570\u5B57\u6280\u672F\uFF0C\u5B9E\u73B0\u5927\u89C4\u6A21\u7269\u6D41\u7F51\u7EDC\u534F\u540C\u6709\u4E86\u66F4\u52A0\u76F4\u89C2\u7684\u8BA4\u8BC6\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ECE\u5206\u62E8\u4E2D\u5FC3\u7684\u73B0\u573A\u8FD0\u8425\uFF0C\u5230\u8986\u76D6\u4E0D\u540C\u533A\u57DF\u7684\u8FD0\u8F93\u7F51\u7EDC\uFF0C\u4EE3\u8868\u56E2\u8FDB\u4E00\u6B65\u4E86\u89E3\u5230\uFF0C\u73B0\u4EE3\u7269\u6D41\u5DF2\u4E0D\u4EC5\u662F\u4F20\u7EDF\u610F\u4E49\u4E0A\u7684\u8FD0\u8F93\u670D\u52A1\uFF0C\u800C\u662F\u8FDE\u63A5\u751F\u4EA7\u3001\u8D38\u6613\u3001\u6D88\u8D39\u53CA\u4EA7\u4E1A\u4F9B\u5E94\u94FE\u7684\u91CD\u8981\u57FA\u7840\u8BBE\u65BD\u3002\u003C/p\u003E\n\u003Ch3\u003E\u79D1\u6280\u8D4B\u80FD\u7269\u6D41\uFF1A\u4ECE\u8FD0\u8F93\u670D\u52A1\u8D70\u5411\u667A\u6167\u4F9B\u5E94\u94FE\u003C/h3\u003E\n\u003Cp\u003E\u5728\u53C2\u89C2\u8FC7\u7A0B\u4E2D\uFF0C\u4EE3\u8868\u56E2\u91CD\u70B9\u5173\u6CE8\u7269\u6D41\u79D1\u6280\u5728\u5B9E\u9645\u8FD0\u8425\u4E2D\u7684\u5E94\u7528\u3002\u003C/p\u003E\n\u003Cp\u003E\u968F\u7740\u4EBA\u5DE5\u667A\u80FD\u3001\u5927\u6570\u636E\u3001\u81EA\u52A8\u5316\u8BBE\u5907\u53CA\u6570\u5B57\u5316\u7BA1\u7406\u7CFB\u7EDF\u4E0D\u65AD\u878D\u5165\u7269\u6D41\u884C\u4E1A\uFF0C\u7269\u6D41\u4F01\u4E1A\u6B63\u5728\u4ECE\u4F20\u7EDF\u7684\u201C\u8FD0\u8F93\u670D\u52A1\u201D\u5411\u66F4\u52A0\u667A\u80FD\u5316\u3001\u6570\u5B57\u5316\u7684\u7EFC\u5408\u4F9B\u5E94\u94FE\u670D\u52A1\u8F6C\u578B\u3002\u003C/p\u003E\n\u003Cp\u003E\u987A\u4E30\u9A6C\u6765\u897F\u4E9A\u65B9\u9762\u7ED3\u5408\u81EA\u8EAB\u4E1A\u52A1\u5B9E\u8DF5\uFF0C\u5C31\u7269\u6D41\u7F51\u7EDC\u8FD0\u8425\u3001\u79D1\u6280\u5E94\u7528\u4EE5\u53CA\u56FD\u9645\u4E1A\u52A1\u53D1\u5C55\u7B49\u8FDB\u884C\u4E86\u4ECB\u7ECD\u3002\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u4EE3\u8868\u56E2\u5BF9\u4E2D\u56FD\u7269\u6D41\u4F01\u4E1A\u901A\u8FC7\u79D1\u6280\u63D0\u5347\u8FD0\u8425\u6548\u7387\u3001\u4F18\u5316\u4F9B\u5E94\u94FE\u7BA1\u7406\u7684\u5B9E\u8DF5\u8868\u73B0\u51FA\u6D53\u539A\u5174\u8DA3\uFF0C\u5E76\u5C31\u76F8\u5173\u6A21\u5F0F\u5728\u4E1C\u5357\u4E9A\u5E02\u573A\u7684\u53D1\u5C55\u524D\u666F\u8FDB\u884C\u4E86\u4EA4\u6D41\u3002\u003C/p\u003E\n\u003Cp\u003E\u4EE3\u8868\u56E2\u8BA4\u4E3A\uFF0C\u968F\u7740\u4E2D\u56FD\u4E0E\u4E1C\u76DF\u4E4B\u95F4\u8D38\u6613\u89C4\u6A21\u4E0D\u65AD\u6269\u5927\uFF0C\u7269\u6D41\u548C\u4F9B\u5E94\u94FE\u4F53\u7CFB\u5C06\u5728\u4FC3\u8FDB\u533A\u57DF\u4EA7\u4E1A\u5408\u4F5C\u3001\u8DE8\u5883\u8D38\u6613\u548C\u4F01\u4E1A\u56FD\u9645\u5316\u53D1\u5C55\u65B9\u9762\u53D1\u6325\u66F4\u52A0\u91CD\u8981\u7684\u4F5C\u7528\u3002\u003C/p\u003E\n\u003Ch3\u003E\u4ECE\u7269\u6D41\u8FDE\u63A5\u4EA7\u4E1A\uFF1A\u4E2D\u9A6C\u4F9B\u5E94\u94FE\u5408\u4F5C\u7A7A\u95F4\u5728\u54EA\u003C/h3\u003E\n\u003Cp\u003E\u8FD1\u5E74\u6765\uFF0C\u4E2D\u56FD\u4E0E\u9A6C\u6765\u897F\u4E9A\u7ECF\u8D38\u5F80\u6765\u4E0D\u65AD\u6DF1\u5316\uFF0C\u53CC\u65B9\u5728\u5236\u9020\u4E1A\u3001\u519C\u4EA7\u54C1\u3001\u8DE8\u5883\u7535\u5546\u3001\u6570\u5B57\u7ECF\u6D4E\u4EE5\u53CA\u533A\u57DF\u4F9B\u5E94\u94FE\u7B49\u9886\u57DF\u7684\u5408\u4F5C\u6301\u7EED\u62D3\u5C55\u3002\u003C/p\u003E\n\u003Cp\u003E\u7269\u6D41\u4F5C\u4E3A\u8FDE\u63A5\u4EA7\u4E1A\u94FE\u4E0A\u4E0B\u6E38\u7684\u91CD\u8981\u73AF\u8282\uFF0C\u5BF9\u4E8E\u4E2D\u56FD\u4F01\u4E1A\u8FDB\u5165\u9A6C\u6765\u897F\u4E9A\u53CA\u4E1C\u76DF\u5E02\u573A\u3001\u9A6C\u6765\u897F\u4E9A\u4F01\u4E1A\u62D3\u5C55\u4E2D\u56FD\u5E02\u573A\u540C\u6837\u5177\u6709\u91CD\u8981\u610F\u4E49\u3002\u003C/p\u003E\n\u003Cp\u003E\u6B64\u6B21\u8D70\u8BBF\u987A\u4E30\u534E\u5317\u5206\u62E8\u4E2D\u5FC3\uFF0C\u4F7F\u9A6C\u6765\u897F\u4E9A\u653F\u5546\u4EE3\u8868\u80FD\u591F\u4ECE\u4F01\u4E1A\u8FD0\u8425\u548C\u4EA7\u4E1A\u5B9E\u8DF5\u7684\u89D2\u5EA6\uFF0C\u66F4\u52A0\u76F4\u89C2\u5730\u4E86\u89E3\u4E2D\u56FD\u7269\u6D41\u4F53\u7CFB\u7684\u53D1\u5C55\u6A21\u5F0F\uFF0C\u4E5F\u4E3A\u53CC\u65B9\u672A\u6765\u56F4\u7ED5\u8DE8\u5883\u7269\u6D41\u3001\u4ED3\u50A8\u914D\u9001\u3001\u4F9B\u5E94\u94FE\u7BA1\u7406\u53CA\u6570\u5B57\u8D38\u6613\u7B49\u9886\u57DF\u5F00\u5C55\u8FDB\u4E00\u6B65\u4EA4\u6D41\u63D0\u4F9B\u4E86\u65B0\u7684\u5207\u5165\u70B9\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ECE\u672C\u6B21\u4EA4\u6D41\u5185\u5BB9\u770B\uFF0C\u53CC\u65B9\u5173\u6CE8\u7684\u91CD\u70B9\u65B9\u5411\u5305\u62EC\uFF1A\u003C/p\u003E\n\u003Col\u003E\n\u003Cli\u003E\u003Cstrong\u003E\u8DE8\u5883\u7269\u6D41\u7F51\u7EDC\u4E0E\u533A\u57DF\u5206\u62E8\u003C/strong\u003E \u4F9D\u6258\u7269\u6D41\u67A2\u7EBD\u3001\u5206\u62E8\u4E2D\u5FC3\u548C\u8FD0\u8F93\u7F51\u7EDC\uFF0C\u63D0\u5347\u8DE8\u5883\u8D27\u7269\u96C6\u6563\u4E0E\u533A\u57DF\u914D\u9001\u6548\u7387\u3002\u003C/li\u003E\n\u003Cli\u003E\u003Cstrong\u003E\u4ED3\u50A8\u914D\u9001\u4E0E\u4F9B\u5E94\u94FE\u7BA1\u7406\u003C/strong\u003E \u56F4\u7ED5\u5236\u9020\u4E1A\u3001\u519C\u4EA7\u54C1\u3001\u8DE8\u5883\u7535\u5546\u7B49\u573A\u666F\uFF0C\u63A2\u7D22\u66F4\u9AD8\u6548\u7684\u4ED3\u50A8\u3001\u914D\u9001\u548C\u4F9B\u5E94\u94FE\u534F\u540C\u6A21\u5F0F\u3002\u003C/li\u003E\n\u003Cli\u003E\u003Cstrong\u003E\u6570\u5B57\u5316\u4F9B\u5E94\u94FE\u4E0E\u6570\u5B57\u8D38\u6613\u003C/strong\u003E \u901A\u8FC7\u6570\u5B57\u5316\u7BA1\u7406\u7CFB\u7EDF\u3001\u6570\u636E\u534F\u540C\u548C\u667A\u80FD\u6280\u672F\uFF0C\u63A8\u52A8\u4F9B\u5E94\u94FE\u53EF\u89C6\u5316\u3001\u53EF\u8FFD\u8E2A\u548C\u9AD8\u6548\u8FD0\u8F6C\u3002\u003C/li\u003E\n\u003Cli\u003E\u003Cstrong\u003E\u4EA7\u4E1A\u7269\u6D41\u4E0E\u533A\u57DF\u8D38\u6613\u670D\u52A1\u003C/strong\u003E \u968F\u7740\u4E1C\u76DF\u533A\u57DF\u7ECF\u6D4E\u4E00\u4F53\u5316\u6301\u7EED\u63A8\u8FDB\uFF0C\u4EE5\u53CA\u4E2D\u56FD\u4F01\u4E1A\u52A0\u5FEB\u5E03\u5C40\u4E1C\u5357\u4E9A\u5E02\u573A\uFF0C\u4E2D\u9A6C\u53CC\u65B9\u5728\u7269\u6D41\u7F51\u7EDC\u3001\u8DE8\u5883\u4F9B\u5E94\u94FE\u548C\u6570\u5B57\u5316\u670D\u52A1\u7B49\u9886\u57DF\u5177\u6709\u8F83\u5927\u5408\u4F5C\u6F5C\u529B\u3002\u003C/li\u003E\n\u003C/ol\u003E\n\u003Ch3\u003EAIRH\uFF1A\u6301\u7EED\u63A8\u52A8\u4E2D\u9A6C\u4EA7\u4E1A\u4EA4\u6D41\u003C/h3\u003E\n\u003Cp\u003E\u6B64\u6B21\u8D70\u8BBF\u662F\u4E9A\u6D32\u521B\u65B0\u7814\u7A76\u4E2D\u5FC3\uFF08AIRH\uFF09\u7EC4\u7EC7\u9A6C\u6765\u897F\u4E9A\u653F\u5546\u4EE3\u8868\u56E2\u5F00\u5C55\u4E2D\u56FD\u4F01\u4E1A\u53CA\u4EA7\u4E1A\u8003\u5BDF\u7684\u91CD\u8981\u7EC4\u6210\u90E8\u5206\u3002\u003C/p\u003E\n\u003Cp\u003EAIRH\u957F\u671F\u5173\u6CE8\u4E2D\u56FD\u4E0E\u9A6C\u6765\u897F\u4E9A\u53CA\u4E1C\u76DF\u4E4B\u95F4\u7684\u7ECF\u8D38\u3001\u4EA7\u4E1A\u4E0E\u521B\u65B0\u5408\u4F5C\uFF0C\u901A\u8FC7\u7EC4\u7EC7\u653F\u5546\u4EA4\u6D41\u3001\u4F01\u4E1A\u8003\u5BDF\u3001\u4EA7\u4E1A\u5BF9\u63A5\u53CA\u5546\u52A1\u8003\u5BDF\u7B49\u65B9\u5F0F\uFF0C\u63A8\u52A8\u4E2D\u56FD\u4F01\u4E1A\u66F4\u52A0\u6DF1\u5165\u4E86\u89E3\u9A6C\u6765\u897F\u4E9A\u53CA\u4E1C\u76DF\u5E02\u573A\uFF0C\u540C\u65F6\u5E2E\u52A9\u9A6C\u6765\u897F\u4E9A\u653F\u5546\u754C\u66F4\u52A0\u5168\u9762\u5730\u8BA4\u8BC6\u4E2D\u56FD\u7ECF\u6D4E\u3001\u4EA7\u4E1A\u548C\u4F01\u4E1A\u7684\u53D1\u5C55\u5B9E\u8DF5\u3002\u003C/p\u003E\n\u003Cp\u003E\u6B64\u6B21\u4EE3\u8868\u56E2\u8D70\u8BBF\u987A\u4E30\uFF0C\u65E2\u662F\u5BF9\u4E2D\u56FD\u73B0\u4EE3\u7269\u6D41\u4F53\u7CFB\u7684\u4E00\u6B21\u5B9E\u5730\u8003\u5BDF\uFF0C\u4E5F\u662F\u4E00\u6B21\u56F4\u7ED5\u4E2D\u9A6C\u4EA7\u4E1A\u5408\u4F5C\u548C\u533A\u57DF\u4F9B\u5E94\u94FE\u53D1\u5C55\u7684\u4EA4\u6D41\u3002\u003C/p\u003E\n\u003Cp\u003EAIRH\u8868\u793A\uFF0C\u672A\u6765\u5C06\u7EE7\u7EED\u53D1\u6325\u4E2D\u9A6C\u4E4B\u95F4\u7684\u4EA7\u4E1A\u4EA4\u6D41\u4E0E\u5408\u4F5C\u5E73\u53F0\u4F5C\u7528\uFF0C\u56F4\u7ED5\u73B0\u4EE3\u7269\u6D41\u3001\u4F9B\u5E94\u94FE\u3001\u6570\u5B57\u7ECF\u6D4E\u3001\u519C\u4E1A\u79D1\u6280\u3001\u4EBA\u5DE5\u667A\u80FD\u3001\u5236\u9020\u4E1A\u53CA\u8DE8\u5883\u8D38\u6613\u7B49\u91CD\u70B9\u9886\u57DF\uFF0C\u63A8\u52A8\u66F4\u591A\u653F\u5E9C\u3001\u667A\u5E93\u3001\u4F01\u4E1A\u53CA\u4EA7\u4E1A\u673A\u6784\u5F00\u5C55\u52A1\u5B9E\u4EA4\u6D41\u3002\u003C/p\u003E\n\u003Cp\u003E\u901A\u8FC7\u201C\u8D70\u8FDB\u4E2D\u56FD\u4F01\u4E1A\u3001\u4E86\u89E3\u4E2D\u56FD\u5B9E\u8DF5\u3001\u5BF9\u63A5\u4EA7\u4E1A\u8D44\u6E90\u201D\uFF0C\u8FDB\u4E00\u6B65\u4FC3\u8FDB\u4E2D\u9A6C\u53CC\u65B9\u4ECE\u4FE1\u606F\u4EA4\u6D41\u8D70\u5411\u9879\u76EE\u5408\u4F5C\uFF0C\u4E3A\u4E2D\u56FD\u4F01\u4E1A\u62D3\u5C55\u9A6C\u6765\u897F\u4E9A\u53CA\u4E1C\u76DF\u5E02\u573A\u3001\u9A6C\u6765\u897F\u4E9A\u4F01\u4E1A\u6DF1\u5316\u5BF9\u534E\u5408\u4F5C\u521B\u9020\u66F4\u591A\u673A\u4F1A\u3002\u003C/p\u003E\n\u003Cp\u003E\u6B64\u6B21\u8D70\u8BBF\u4E0D\u4EC5\u52A0\u6DF1\u4E86\u9A6C\u6765\u897F\u4E9A\u653F\u5546\u754C\u4EE3\u8868\u5BF9\u4E2D\u56FD\u667A\u6167\u7269\u6D41\u548C\u73B0\u4EE3\u4F9B\u5E94\u94FE\u4F53\u7CFB\u7684\u8BA4\u8BC6\uFF0C\u4E5F\u8FDB\u4E00\u6B65\u62D3\u5C55\u4E86\u53CC\u65B9\u5728\u8DE8\u5883\u7269\u6D41\u3001\u6570\u5B57\u5316\u4F9B\u5E94\u94FE\u53CA\u533A\u57DF\u8D38\u6613\u670D\u52A1\u7B49\u9886\u57DF\u7684\u5408\u4F5C\u7A7A\u95F4\u3002\u003C/p\u003E\n\u003Ch3\u003E\u5173\u6CE8\u4E0E\u5BF9\u63A5\u003C/h3\u003E\n\u003Cp\u003E\u5173\u6CE8\u3010\u4E9A\u6D32\u521B\u65B0\u7814\u7A76\u4E2D\u5FC3AIRH\u3011\uFF0C\u83B7\u53D6\u66F4\u591A\u4E2D\u9A6C\u4EA7\u4E1A\u5408\u4F5C\u3001\u4F01\u4E1A\u8003\u5BDF\u4E0E\u8D44\u6E90\u5BF9\u63A5\u4FE1\u606F\u3002\u003C/p\u003E\n\u003Cp\u003E\u540E\u53F0\u56DE\u590D\u5173\u952E\u8BCD\uFF1A\u003Cstrong\u003E\u4E2D\u9A6C\u7269\u6D41\u003C/strong\u003E \uFF0C\u83B7\u53D6\u672C\u6B21\u53C2\u8BBF\u8981\u70B9\u53CA\u4E2D\u9A6C\u4F9B\u5E94\u94FE\u5BF9\u63A5\u65B9\u5411\u3002\u003C/p\u003E\n\u003Cp\u003E\u5982\u679C\u60A8\u6240\u5728\u4F01\u4E1A\u6B63\u5728\u5173\u6CE8\u9A6C\u6765\u897F\u4E9A\u53CA\u4E1C\u76DF\u5E02\u573A\uFF0C\u6216\u5E0C\u671B\u5BF9\u63A5\u8DE8\u5883\u7269\u6D41\u3001\u4ED3\u50A8\u914D\u9001\u3001\u4F9B\u5E94\u94FE\u7BA1\u7406\u3001\u6570\u5B57\u8D38\u6613\u7B49\u8D44\u6E90\uFF0C\u6B22\u8FCE\u5728\u8BC4\u8BBA\u533A\u7559\u8A00\uFF1A\u003Cstrong\u003E\u5355\u4F4D\u002B\u804C\u52A1\u002B\u9700\u6C42\u003C/strong\u003E \u3002\u003C/p\u003E\n",
