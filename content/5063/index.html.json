{
  "id": "%e5%85%a8%e7%90%83100%e5%a4%a7%e9%9b%86%e8%a3%85%e7%ae%b1%e6%b8%af%e5%8f%a3%e3%80%80%e5%b7%b4%e7%94%9f%e6%b8%af%e6%8e%92%e5%90%8d%e7%ac%ac11%e4%bd%8d",
  "slug": "%e5%85%a8%e7%90%83100%e5%a4%a7%e9%9b%86%e8%a3%85%e7%ae%b1%e6%b8%af%e5%8f%a3%e3%80%80%e5%b7%b4%e7%94%9f%e6%b8%af%e6%8e%92%e5%90%8d%e7%ac%ac11%e4%bd%8d",
  "canonicalUrlKey": "%e5%85%a8%e7%90%83100%e5%a4%a7%e9%9b%86%e8%a3%85%e7%ae%b1%e6%b8%af%e5%8f%a3%e3%80%80%e5%b7%b4%e7%94%9f%e6%b8%af%e6%8e%92%e5%90%8d%e7%ac%ac11%e4%bd%8d",
  "route": "/5063/",
  "title": "\u5168\u7403100\u5927\u96C6\u88C5\u7BB1\u6E2F\u53E3\u3000\u5DF4\u751F\u6E2F\u6392\u540D\u7B2C11\u4F4D",
  "summary": "\uFF08\u5409\u9686\u576121\u65E5\u8BAF\uFF09\u4EA4\u901A\u90E8\u6307\u51FA\uFF0C\u6839\u636E\u52B3\u57C3\u5FB7\u8239\u8236\u65E5\u62A5\uFF08Lloyd\u0027s List\uFF09\u6570\u636E\uFF0C\u57282023\u5E74\u5168\u7403100\u5927\u96C6\u88C5\u7BB1\u6E2F\u53E3\uFF0C\u5DF4\u751F\u6E2F\u6392\u540D\u7B2C11\u4F4D\u3002 \u4EA4\u901A\u90E8\u6307\u51FA\uFF0C\u8FD9\u4E00\u6210\u5C31\u8BC1\u660E\u5DF4\u751F\u6E2F\u5728\u5168\u7403\u6D77\u8FD0\u884C\u4E1A\u4E2D\u7684\u6301\u7EED\u589E\u957F\u548C\u6218\u7565\u91CD\u8981\u6027\u3002 \u201C2023\u5E74\uFF0C\u5DF4\u751F\u6E2F\u5904\u7406\u4E861406.1\u4E07\u6807\u51C6\u96C6\u88C5\u7BB1\u541E\u5410\u91CF\uFF0C\u6BD42022\u5E74\u76841322.3\u4E07\u6807\u51C6\u7BB1\uFF0C\u589E\u957F\u4E866.3%\u3002\u201D \u201C\u7279\u522B\u662F\u672C\u5730\u8FDB\u51FA\u53E3\u91CF\u589E\u957F\u4E868.4%\uFF0C\u4ECE2022\u5E74\u7684568\u4E07\u6807\u51C6\u96C6\u88C5\u7BB1\u589E\u52A0\u52302023\u5E74\u7684616\u4E07\u6807\u51C6\u96C6\u88C5\u7BB1\u3002\u201D \u4EA4\u901A\u90E8\u8868\u793A\uFF0C\u8FD9\u4E00\u589E\u957F\u63A8\u52A8\u4E86\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/08/frc-f9a6073a21bd058a1f03bd10485c2cb2.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\uFF08\u5409\u9686\u576121\u65E5\u8BAF\uFF09\u4EA4\u901A\u90E8\u6307\u51FA\uFF0C\u6839\u636E\u52B3\u57C3\u5FB7\u8239\u8236\u65E5\u62A5\uFF08Lloyd\u0026#39;s List\uFF09\u6570\u636E\uFF0C\u57282023\u5E74\u5168\u7403100\u5927\u96C6\u88C5\u7BB1\u6E2F\u53E3\uFF0C\u5DF4\u751F\u6E2F\u6392\u540D\u7B2C11\u4F4D\u3002\u003C/p\u003E\n\u003Cp\u003E\u4EA4\u901A\u90E8\u6307\u51FA\uFF0C\u8FD9\u4E00\u6210\u5C31\u8BC1\u660E\u5DF4\u751F\u6E2F\u5728\u5168\u7403\u6D77\u8FD0\u884C\u4E1A\u4E2D\u7684\u6301\u7EED\u589E\u957F\u548C\u6218\u7565\u91CD\u8981\u6027\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C2023\u5E74\uFF0C\u5DF4\u751F\u6E2F\u5904\u7406\u4E861406.1\u4E07\u6807\u51C6\u96C6\u88C5\u7BB1\u541E\u5410\u91CF\uFF0C\u6BD42022\u5E74\u76841322.3\u4E07\u6807\u51C6\u7BB1\uFF0C\u589E\u957F\u4E866.3%\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u201C\u7279\u522B\u662F\u672C\u5730\u8FDB\u51FA\u53E3\u91CF\u589E\u957F\u4E868.4%\uFF0C\u4ECE2022\u5E74\u7684568\u4E07\u6807\u51C6\u96C6\u88C5\u7BB1\u589E\u52A0\u52302023\u5E74\u7684616\u4E07\u6807\u51C6\u96C6\u88C5\u7BB1\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4EA4\u901A\u90E8\u8868\u793A\uFF0C\u8FD9\u4E00\u589E\u957F\u63A8\u52A8\u4E86\u5DF4\u751F\u6E2F\u4ECE2022\u5E74\u7684\u7B2C13\u4F4D\u4E0A\u5347\u4E24\u4F4D\u81F32023\u5E74\u7684\u7B2C11\u4F4D\uFF0C\u53CD\u5E94\u4E86\u5176\u5728\u5168\u7403\u8D38\u6613\u548C\u7269\u6D41\u4E2D\u7684\u91CD\u8981\u89D2\u8272\uFF0C\u5E76\u6210\u4E3A\u4E9A\u6D32\uFF08\u4E0D\u5305\u62EC\u4E2D\u56FD\u6E2F\u53E3\uFF09\u4E09\u5927\u6700\u5927\u8F6C\u8FD0\u67A2\u7EBD\u4E4B\u4E00\u3002\u003C/p\u003E\n\u003Cp\u003E\u6587\u544A\u4E2D\u63D0\u53CA\uFF0C\u5728\u524D20\u5927\u96C6\u88C5\u7BB1\u6E2F\u53E3\u4E2D\uFF0C\u5DF4\u751F\u6E2F\u662F7\u4E2A\u6392\u540D\u4E0A\u5347\u7684\u6E2F\u53E3\u4E4B\u4E00\uFF0C2023\u5E74\u6392\u540D\u4E0A\u5347\u7684\u6E2F\u53E3\u5305\u62EC\u5DF4\u751F\u6E2F\u3001\u8FEA\u62DC\u6E2F\u3001\u53A6\u95E8\u6E2F\u3001\u6797\u67E5\u73ED\u6E2F\u3001\u9AD8\u96C4\u6E2F\u3001\u4E39\u5409\u5C14\u6E2F\u548C\u592A\u4ED3\u6E2F\u3002\u003C/p\u003E\n\u003Cp\u003E\u5DF4\u751F\u6E2F\u6392\u540D\u7684\u663E\u8457\u63D0\u5347\uFF0C\u53CD\u6620\u4E86\u4ECE\u4EA4\u901A\u90E8\u3001\u6E2F\u52A1\u5C40\u3001\u7801\u5934\u8FD0\u8425\u5546\u5230\u6240\u6709\u5176\u4ED6\u6218\u7565\u5408\u4F5C\u4F19\u4F34\u7684\u6BCF\u4E00\u4F4D\u53C2\u4E0E\u8005\u7684\u5949\u732E\u548C\u8F9B\u52E4\u5DE5\u4F5C\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u8FD9\u4E00\u91CC\u7A0B\u7891\u4E0D\u4EC5\u4EC5\u662F\u6570\u5B57\u7684\u63D0\u5347\uFF1B\u5B83\u8C61\u5F81\u5DF4\u751F\u6E2F\u6301\u7EED\u81F4\u529B\u4E8E\u63D0\u5347\u6548\u7387\u3001\u6269\u5927\u4EA7\u80FD\u3001\u5FEB\u901F\u5E94\u5BF9\u4E0D\u65AD\u53D8\u5316\u7684\u8D8B\u52BF\uFF0C\u4EE5\u53CA\u6D77\u4E8B\u884C\u4E1A\u5728\u5168\u7403\u7ECF\u6D4E\u548C\u653F\u6CBB\u7684\u6311\u6218\uFF0C\u5DE9\u56FA\u4E86\u5DF4\u751F\u6E2F\u5728\u5168\u7403\u822A\u8FD0\u9886\u57DF\u7684\u91CD\u8981\u5730\u4F4D\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u5B83\u6307\u51FA\uFF0C\u5DF4\u751F\u6E2F\u6392\u540D\u7684\u4E0A\u5347\u4E5F\u8868\u660E\u4E86\u6211\u56FD\u5728\u56FD\u9645\u8D38\u6613\u4E2D\u65E5\u76CA\u589E\u957F\u7684\u5F71\u54CD\u529B\uFF0C\u8BE5\u6E2F\u53E3\u7684\u6218\u7565\u4F4D\u7F6E\uFF0C\u52A0\u4E0A\u6218\u7565\u653F\u7B56\u3001\u6301\u7EED\u7684\u57FA\u7840\u8BBE\u65BD\u5F00\u53D1\u548C\u5BF9\u5C16\u7AEF\u6280\u672F\u7684\u6295\u8D44\uFF0C\u4F7F\u5176\u6210\u4E3A\u5168\u7403\u822A\u8FD0\u516C\u53F8\u548C\u8D38\u6613\u8DEF\u7EBF\u4E0A\uFF0C\u8D8A\u6765\u8D8A\u5177\u5438\u5F15\u529B\u7684\u67A2\u7EBD\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u968F\u8457\u6E2F\u53E3\u7EE7\u7EED\u6269\u5C55\u5176\u80FD\u529B\uFF0C\u5B83\u81F4\u529B\u4E8E\u652F\u6491\u9A6C\u6765\u897F\u4E9A\u7684\u7ECF\u6D4E\u589E\u957F\u5E76\u4E3A\u5168\u7403\u4F9B\u5E94\u94FE\u4F5C\u51FA\u8D21\u732E\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4EA4\u901A\u90E8\u63D0\u53CA\uFF0C\u541E\u5410\u91CF\u589E\u957F6.3%\u6E05\u695A\u8868\u660E\u5DF4\u751F\u6E2F\u7684\u9002\u5E94\u6027\u548C\u524D\u77BB\u6027\uFF0C\u786E\u4FDD\u5176\u5728\u8BE5\u5730\u533A\u4FDD\u6301\u7ADE\u4E89\u529B\u3002\u003C/p\u003E\n\u003Cp\u003E\u4EA4\u901A\u90E8\u8BA4\u4E3A\uFF0C\u5C55\u671B\u672A\u6765\uFF0C\u5DF4\u751F\u6E2F\u8BA1\u5212\u4FDD\u6301\u4E0A\u5347\u52BF\u5934\uFF0C\u5E76\u5728\u672A\u6765\u51E0\u5E74\u53D6\u5F97\u66F4\u5927\u7684\u91CC\u7A0B\u7891\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u968F\u8457\u8FDB\u4E00\u6B65\u6269\u5C55\u548C\u73B0\u4EE3\u5316\u7684\u8BA1\u5212\uFF0C\u5DF4\u751F\u6E2F\u6709\u671B\u5728\u4FC3\u8FDB\u5168\u7403\u8D38\u6613\u4E2D\u53D1\u6325\u66F4\u52A0\u91CD\u8981\u7684\u4F5C\u7528\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4EA4\u901A\u90E8\u8865\u5145\uFF0C\u5DF4\u751F\u6E2F\u4E0D\u4EC5\u81F4\u529B\u4E8E\u6210\u4E3A\u4E00\u4E2A\u8F6C\u8FD0\u67A2\u7EBD\uFF0C\u5176\u8F6C\u8FD0\u8D27\u7269\u4E0E\u672C\u5730\u8D27\u7269\u7684\u6BD4\u7387\u5728\u8FC7\u53BB10\u5E74\uFF0C\u4ECE70:30\u53D8\u4E3A55:45\uFF0C\u5DF4\u751F\u6E2F\u6B63\u81F4\u529B\u63D0\u5347\u5176\u4F5C\u4E3A\u4E9A\u6D32\u91CD\u8981\u7684\u533A\u57DF\u5206\u9500\u548C\u7269\u6D41\u4E2D\u5FC3\u7684\u89D2\u8272\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u622A\u81F32024\u5E747\u6708\uFF0C\u5DF4\u751F\u6E2F\u5DF2\u5904\u7406\u4E86840\u4E07\u6807\u51C6\u96C6\u88C5\u7BB1\uFF0C\u8F832023\u5E74\u540C\u671F\u589E\u957F5.6%\uFF0C\u5E76\u9884\u6D4B2024\u5E74\u7684\u589E\u957F\u7387\u4E3A5.5%\uFF0C\u8FBE\u52301483.4\u4E07\u6807\u51C6\u96C6\u88C5\u7BB1\uFF0C\u8FD9\u5C06\u4F7F\u5DF4\u751F\u6E2F\u6709\u671B\u57282024\u5E74\u8FDB\u5165\u524D10\u540D\u6E2F\u53E3\u6392\u540D\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u6839\u636E2023\u5E74\u5168\u7403100\u5927\u6E2F\u53E3\u6392\u540D\u4E2D\uFF0C\u4E0A\u6D77\u4F4D\u5C45\u7B2C\u4E00\uFF0C\u65B0\u52A0\u5761\u4F4D\u5C45\u7B2C\u4E8C\uFF0C\u5B81\u6CE2\u821F\u5C71\u6392\u540D\u7B2C\u4E09\u3002\u003C/p\u003E\n\u003Cp\u003E\u53E6\u5916\uFF0C\u5176\u4ED6\u5206\u522B\u4E3A\u6DF1\u5733\uFF08\u7B2C4\uFF09\u3001\u9752\u5C9B\uFF08\u7B2C5\uFF09\u3001\u5E7F\u5DDE\uFF08\u7B2C6\uFF09\u3001\u91DC\u5C71\uFF08\u7B2C7\uFF09\u3001\u5929\u6D25\uFF08\u7B2C8\uFF09\u3001\u8FEA\u62DC\uFF08\u7B2C9\uFF09\u4EE5\u53CA\u9999\u6E2F\uFF08\u7B2C10\uFF09\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/i6Wxv7GaiGoBrB2HU6mQPw\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
