  "title": "\u4E2D\u56FD\u9A7B\u9A6C\u6765\u897F\u4E9A\u5927\u4F7F\u9986\u201C\u4E94\u4E00\u201D\u5047\u671F\u5B89\u5168\u63D0\u9192",
  "summary": "\u9A6C\u6765\u897F\u4E9A\u62E5\u6709\u4E30\u5BCC\u591A\u5F69\u7684\u591A\u5143\u6587\u5316\u548C\u7F8E\u4E3D\u7684\u81EA\u7136\u98CE\u5149\uFF0C\u662F\u53D7\u6E38\u5BA2\u6B22\u8FCE\u7684\u65C5\u6E38\u76EE\u7684\u5730\u3002 \u201C\u4E94\u4E00\u201D\u5047\u671F\u5C06\u81F3\uFF0C\u4E3A\u4E86\u4FDD\u969C\u60A8\u6765\u9A6C\u65C5\u884C\u5E73\u5B89\u3001\u5065\u5EB7\u3001\u6109\u5FEB\uFF0C\u4E2D\u56FD\u9A7B\u9A6C\u6765\u897F\u4E9A\u5927\u4F7F\u9986\u6E29\u99A8\u63D0\u9192\u5982\u4E0B\uFF1A \u4E00\u3001\u505A\u597D\u884C\u524D\u51C6\u5907 \u884C\u524D\u8BF7\u786E\u8BA4\u62A4\u7167\u5B8C\u6574\u65E0\u7834\u635F\uFF0C\u6709\u6548\u671F\u57286\u4E2A\u6708\u4EE5\u4E0A\u3002\u5408\u7406\u5B89\u6392\u884C\u7A0B\uFF0C\u5EFA\u8BAE\u8D2D\u4E70\u5FC5\u8981\u7684\u65C5\u6E38\u3001\u610F\u5916\u4F24\u5BB3\u53CA\u533B\u7597\u4FDD\u9669\u548C\u56DE\u7A0B\u673A\u7968\uFF0C\u65C5\u884C\u671F\u95F4\u4E0E\u4EB2\u53CB\u4FDD\u6301\u6C9F\u901A\u3002\u91CD\u8981\u8BC1\u4EF6\u53CA\u6750\u6599\u8BF7\u63D0\u524D\u5907\u4EFD\u3002 \u4E8C\u3001\u5173\u6CE8\u5165\u5883\u8981\u6C42 \u6765\u9A6C\u65C5\u884C\u4E2D\u56FD\u516C\u6C11\u53EF\u514D\u7B7E\u5165\u5883\uFF0C\u62B5\u79BB\u5409\u9686\u5761\u56FD\u9645\u673A\u573A\u7B49\u53E3\u5CB8\u65F6\u53EF\u4F7F\u2026",
  "body": "\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u62E5\u6709\u4E30\u5BCC\u591A\u5F69\u7684\u591A\u5143\u6587\u5316\u548C\u7F8E\u4E3D\u7684\u81EA\u7136\u98CE\u5149\uFF0C\u662F\u53D7\u6E38\u5BA2\u6B22\u8FCE\u7684\u65C5\u6E38\u76EE\u7684\u5730\u3002\u201C\u4E94\u4E00\u201D\u5047\u671F\u5C06\u81F3\uFF0C\u4E3A\u4E86\u4FDD\u969C\u60A8\u6765\u9A6C\u65C5\u884C\u5E73\u5B89\u3001\u5065\u5EB7\u3001\u6109\u5FEB\uFF0C\u4E2D\u56FD\u9A7B\u9A6C\u6765\u897F\u4E9A\u5927\u4F7F\u9986\u6E29\u99A8\u63D0\u9192\u5982\u4E0B\uFF1A\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u4E00\u3001\u505A\u597D\u884C\u524D\u51C6\u5907\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u884C\u524D\u8BF7\u786E\u8BA4\u62A4\u7167\u5B8C\u6574\u65E0\u7834\u635F\uFF0C\u6709\u6548\u671F\u57286\u4E2A\u6708\u4EE5\u4E0A\u3002\u5408\u7406\u5B89\u6392\u884C\u7A0B\uFF0C\u5EFA\u8BAE\u8D2D\u4E70\u5FC5\u8981\u7684\u65C5\u6E38\u3001\u610F\u5916\u4F24\u5BB3\u53CA\u533B\u7597\u4FDD\u9669\u548C\u56DE\u7A0B\u673A\u7968\uFF0C\u65C5\u884C\u671F\u95F4\u4E0E\u4EB2\u53CB\u4FDD\u6301\u6C9F\u901A\u3002\u91CD\u8981\u8BC1\u4EF6\u53CA\u6750\u6599\u8BF7\u63D0\u524D\u5907\u4EFD\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u4E8C\u3001\u5173\u6CE8\u5165\u5883\u8981\u6C42\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u6765\u9A6C\u65C5\u884C\u4E2D\u56FD\u516C\u6C11\u53EF\u514D\u7B7E\u5165\u5883\uFF0C\u62B5\u79BB\u5409\u9686\u5761\u56FD\u9645\u673A\u573A\u7B49\u53E3\u5CB8\u65F6\u53EF\u4F7F\u7528\u81EA\u52A9\u901A\u5173\u95F8\u95E8\uFF08AUTOGATE\uFF09\u5165\u51FA\u5883\u3002\u8BF7\u5728\u62B5\u8FBE\u9A6C\u6765\u897F\u4E9A\u524D3\u5929\u5185\u5728\u9A6C\u79FB\u6C11\u5C40\u7F51\u7AD9\uFF08https://imigresen-online.imi.gov.my/mdac/main\uFF09\u586B\u62A5\u9A6C\u6765\u897F\u4E9A\u7535\u5B50\u5165\u5883\u5361\uFF08MDAC\uFF09\uFF0C\u6253\u5370\u6216\u59A5\u5B58\u7535\u5B50\u7248\u786E\u8BA4\u4FE1\u5907\u7528\uFF0C\u4EE5\u4FBF\u987A\u5229\u5165\u5883\u3002\u003C/p\u003E\n\u003Cp\u003E\u5165\u51FA\u5883\u65F6\u8BF7\u914D\u5408\u79FB\u6C11\u5B98\u5458\u5DE5\u4F5C\uFF0C\u82E5\u53D7\u963B\u8BF7\u5982\u5B9E\u8BF4\u660E\u60C5\u51B5\uFF0C\u4E3B\u52A8\u63D0\u4F9B\u76F8\u5173\u8BC1\u660E\u6750\u6599\uFF0C\u8010\u5FC3\u6C9F\u901A\u89E3\u91CA\u3002\u5982\u5728\u5165\u5883\u524D\u4E22\u5931\u62A4\u7167\uFF0C\u8BF7\u8054\u7CFB\u822A\u7A7A\u516C\u53F8\u6216\u62A5\u8B66\u534F\u52A9\u5BFB\u627E\uFF0C\u82E5\u5BFB\u627E\u672A\u679C\uFF0C\u53EF\u62E8\u6253\u4F7F\u9986\u9886\u4FDD\u7535\u8BDD\u6C42\u52A9\uFF080060-321645301\uFF09\u3002\u003C/p\u003E\n\u003Cp\u003E\u5165\u5883\u4E1C\u9A6C\u6C99\u5DF4\u5DDE\u548C\u6C99\u635E\u8D8A\u5DDE\u9700\u5728\u673A\u573A\u4EBA\u5DE5\u67DC\u53F0\u529E\u7406\u5165\u51FA\u5883\u624B\u7EED\uFF0C\u62B5\u79BB\u65F6\u8BF7\u6CE8\u610F\u68C0\u67E5\u662F\u5426\u76D6\u597D\u6240\u5728\u5DDE\u5165\u51FA\u5883\u7AE0\uFF0C\u5982\u672A\u52A0\u76D6\u8BF7\u53CA\u65F6\u8054\u7CFB\u79FB\u6C11\u5B98\u5458\u8865\u76D6\uFF0C\u907F\u514D\u5165\u51FA\u5883\u53D7\u963B\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u4E09\u3001\u8C28\u9632\u5404\u7C7B\u8BC8\u9A97\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u5F53\u524D\u6D77\u5916\u7535\u4FE1\u7F51\u7EDC\u7B49\u8BC8\u9A97\u6848\u4EF6\u591A\u53D1\uFF0C\u4F5C\u6848\u65B9\u5F0F\u8F83\u5177\u8FF7\u60D1\u548C\u6B3A\u9A97\u6027\u3002\u8C28\u8BF7\u7262\u8BB0\uFF0C\u4F7F\u9986\u4E0D\u4F1A\u901A\u8FC7\u8F6C\u63A5\u7535\u8BDD\u65B9\u5F0F\u8054\u7CFB\u56FD\u5185\u516C\u68C0\u6CD5\u7B49\u90E8\u95E8\uFF0C\u4E0D\u4F1A\u7D22\u8981\u94F6\u884C\u8D26\u6237\u3001\u5BC6\u7801\u7B49\u91CD\u8981\u4FE1\u606F\uFF0C\u66F4\u4E0D\u4F1A\u63D0\u51FA\u8F6C\u8D26\u3001\u6C47\u6B3E\u7B49\u8981\u6C42\u3002\u5982\u6240\u63A5\u7535\u8BDD\u81EA\u79F0\u201C\u4F7F\u9986\u201D\u201C\u516C\u5B89\u201D\u201C\u6D77\u5173\u201D\u201C\u79FB\u6C11\u5C40\u201D\u5DE5\u4F5C\u4EBA\u5458\u901A\u77E5\u6709\u5F85\u53D6\u5305\u88F9\u3001\u8BC1\u4EF6\u8FC7\u671F\u3001\u6D89\u6D17\u94B1\u9700\u7F34\u7EB3\u4FDD\u8BC1\u91D1\uFF0C\u6216\u4FE1\u606F\u6CC4\u9732\u5BFC\u81F4\u6D89\u5211\u4E8B\u6848\u4EF6\u7B49\uFF0C\u8BF7\u4FDD\u6301\u8B66\u60D5\uFF0C\u5207\u52FF\u8F7B\u4FE1\uFF0C\u53CA\u65F6\u6302\u65AD\u7535\u8BDD\u5E76\u5411\u9A6C\u8B66\u65B9\u6216\u4F7F\u9986\u53CD\u6620\u6838\u5B9E\u3002\u5982\u4E0D\u614E\u88AB\u9A97\uFF0C\u8BF7\u4FDD\u7559\u8BC1\u636E\uFF0C\u5E76\u5411\u5F53\u5730\u8B66\u65B9\u62A5\u6848\u3002\u5982\u6B3E\u9879\u7CFB\u901A\u8FC7\u56FD\u5185\u94F6\u884C\u8F6C\u8D26\uFF0C\u53EF\u540C\u65F6\u5411\u56FD\u5185\u6237\u7C4D\u6240\u5728\u5730\u516C\u5B89\u673A\u5173\u62A5\u6848\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u56DB\u3001\u6CE8\u610F\u6587\u660E\u5B88\u6CD5\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u8BF7\u9075\u5B88\u9A6C\u5F53\u5730\u6CD5\u5F8B\u6CD5\u89C4\uFF0C\u5C0A\u91CD\u5F53\u5730\u5B97\u6559\u4FE1\u4EF0\u548C\u98CE\u4FD7\u4E60\u60EF\uFF0C\u53C2\u89C2\u5B97\u6559\u573A\u6240\u65F6\u8BF7\u8863\u7740\u89C4\u8303\uFF0C\u52FF\u5927\u58F0\u55A7\u54D7\u3002\u4E0D\u5728\u7981\u70DF\u573A\u6240\u5438\u70DF\uFF0C\u52FF\u4ECE\u4E8B\u4E0E\u5165\u5883\u4E8B\u7531\u4E0D\u7B26\u7684\u6D3B\u52A8\uFF0C\u907F\u514D\u903E\u671F\u6EDE\u7559\u3002\u8BF7\u8FDC\u79BB\u8D4C\u535A\u7B49\u8FDD\u6CD5\u6D3B\u52A8\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u4E94\u3001\u59A5\u5904\u7A81\u53D1\u4E8B\u4EF6\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u6839\u636E\u9A6C\u79FB\u6C11\u6CD5\u89C4\u5B9A\uFF0C\u60A8\u5728\u9A6C\u671F\u95F4\u9700\u8981\u968F\u8EAB\u643A\u5E26\u62A4\u7167\u539F\u4EF6\u4EE5\u5907\u68C0\u67E5\u3002\u8BF7\u8C28\u614E\u59A5\u5584\u4FDD\u7BA1\u8BC1\u4EF6\u3001\u968F\u8EAB\u884C\u674E\u548C\u8D22\u7269\uFF0C\u5982\u8BC1\u7167\u4E0D\u614E\u4E22\u5931\uFF0C\u8BF7\u53CA\u65F6\u62A5\u8B66\u5E76\u53D1\u9001\u90AE\u4EF6\u81F3\u4F7F\u9986\u8BC1\u4EF6\u54A8\u8BE2\u90AE\u7BB1kl_hz@csm.mfa.gov.cn\uFF0C\u6211\u4EEC\u5C06\u5C3D\u5FEB\u4E3A\u60A8\u8865\u529E\u8BC1\u4EF6\u3002\u003C/p\u003E\n\u003Cp\u003E\u5982\u9047\u7EA0\u7EB7\uFF0C\u8BF7\u6CE8\u610F\u4FDD\u7559\u8BC1\u636E\uFF0C\u901A\u8FC7\u534F\u5546\u6216\u6CD5\u5F8B\u9014\u5F84\u89E3\u51B3\uFF0C\u7406\u6027\u7EF4\u6743\uFF0C\u907F\u514D\u8FC7\u6FC0\u8A00\u884C\u3002\u5982\u9047\u76D7\u62A2\u3001\u8F66\u7978\u7B49\u7A81\u53D1\u4E8B\u4EF6\u6216\u5371\u9669\uFF0C\u52A1\u5FC5\u51B7\u9759\u5E94\u5BF9\uFF0C\u5728\u786E\u4FDD\u81EA\u8EAB\u5B89\u5168\u524D\u63D0\u4E0B\uFF0C\u53CA\u65F6\u5411\u5F53\u5730\u8B66\u65B9\u62A5\u6848\uFF0C\u5E76\u53EF\u8054\u7CFB\u4F7F\u9986\u5BFB\u6C42\u534F\u52A9\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u516D\u3001\u6CE8\u610F\u4EA4\u901A\u548C\u6D89\u6C34\u5B89\u5168\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u53F3\u8235\u5DE6\u884C\uFF0C\u8F66\u901F\u8F83\u5FEB\uFF0C\u8BF7\u9075\u5B88\u5F53\u5730\u4EA4\u901A\u6CD5\u89C4\uFF0C\u8FC7\u9A6C\u8DEF\u8BF7\u8D70\u4EBA\u884C\u6A2A\u9053\u3001\u8FC7\u8857\u5929\u6865\u6216\u5730\u4E0B\u901A\u9053\uFF0C\u4E58\u8F66\u65F6\u52A1\u5FC5\u7CFB\u597D\u5B89\u5168\u5E26\uFF0C\u4FDD\u969C\u51FA\u884C\u5B89\u5168\u3002\u5BA1\u614E\u9009\u62E9\u53C2\u4E0E\u6D6E\u6F5C\u3001\u6F5C\u6C34\u7B49\u5B89\u5168\u98CE\u9669\u8F83\u9AD8\u7684\u6D89\u6C34\u9879\u76EE\uFF0C\u5982\u786E\u8981\u53C2\u4E0E\uFF0C\u8BF7\u9009\u62E9\u6B63\u89C4\u3001\u6709\u8D44\u8D28\u7684\u65C5\u884C\u793E\uFF0C\u52A1\u5FC5\u786E\u4FDD\u81EA\u8EAB\u8EAB\u4F53\u72B6\u6001\u826F\u597D\uFF0C\u505A\u597D\u5B89\u5168\u9632\u62A4\uFF0C\u4E25\u683C\u9075\u7167\u5B89\u5168\u6307\u4EE4\u548C\u63D0\u9192\u3002\u4E58\u5750\u5FEB\u8247\u3001\u6E38\u8239\u5E94\u5168\u7A0B\u7A7F\u6234\u6551\u751F\u8863\u3002\u003C/p\u003E\n\u003Cp\u003E\u795D\u5927\u5BB6\u5047\u671F\u51FA\u884C\u5E73\u5B89\u3001\u5065\u5EB7\u3001\u6109\u5FEB\uFF01\u003C/p\u003E\n\u003Cp\u003E\u003Cem\u003E\u8054\u7CFB\u7535\u8BDD\uFF1A\u003C/em\u003E\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u62A5\u8B66/\u6025\u6551\u70ED\u7EBF\uFF1A999\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u79FB\u6C11\u5C40\u54A8\u8BE2\u7535\u8BDD\uFF1A\u002B60-38000 8000\u003C/p\u003E\n\u003Cp\u003E\u5916\u4EA4\u90E8\u5168\u7403\u9886\u4E8B\u4FDD\u62A4\u4E0E\u5E94\u6025\u547C\u53EB\u4E2D\u5FC3\u7535\u8BDD\uFF1A0086-10-12308\u6216010-65612308\u003C/p\u003E\n\u003Cp\u003E\u4E2D\u56FD\u9A7B\u9A6C\u6765\u897F\u4E9A\u4F7F\u9986\u9886\u4E8B\u4FDD\u62A4\u4E0E\u534F\u52A9\u7535\u8BDD\uFF1A0060-321645301\u003C/p\u003E\n\u003Cp\u003E\u4E2D\u56FD\u9A7B\u53E4\u664B\u603B\u9886\u9986\u9886\u4E8B\u4FDD\u62A4\u4E0E\u534F\u52A9\u7535\u8BDD\uFF1A0060-82414818\u003C/p\u003E\n\u003Cp\u003E\u4E2D\u56FD\u9A7B\u69DF\u57CE\u603B\u9886\u9986\u9886\u4E8B\u4FDD\u62A4\u4E0E\u534F\u52A9\u7535\u8BDD\uFF1A0060-1110592308\u003C/p\u003E\n\u003Cp\u003E\u4E2D\u56FD\u9A7B\u54E5\u6253\u57FA\u7EB3\u5DF4\u5362\u603B\u9886\u9986\u9886\u4E8B\u4FDD\u62A4\u4E0E\u534F\u52A9\u7535\u8BDD\uFF1A0060-149857312\u003C/p\u003E\n",
