{
  "id": "%e7%a7%af%e6%9e%81%e8%a7%84%e5%88%92%e5%b7%9e%e5%86%85%e5%9f%ba%e8%ae%be%e9%85%8d%e5%a5%97-%e5%bd%ad%e9%9c%b9%e5%80%99%e8%bf%8e%e4%b8%ad%e5%9b%bd%e6%b8%85%e7%9c%9f%e6%8a%95%e8%b5%84",
  "slug": "%e7%a7%af%e6%9e%81%e8%a7%84%e5%88%92%e5%b7%9e%e5%86%85%e5%9f%ba%e8%ae%be%e9%85%8d%e5%a5%97-%e5%bd%ad%e9%9c%b9%e5%80%99%e8%bf%8e%e4%b8%ad%e5%9b%bd%e6%b8%85%e7%9c%9f%e6%8a%95%e8%b5%84",
  "canonicalUrlKey": "%e7%a7%af%e6%9e%81%e8%a7%84%e5%88%92%e5%b7%9e%e5%86%85%e5%9f%ba%e8%ae%be%e9%85%8d%e5%a5%97-%e5%bd%ad%e9%9c%b9%e5%80%99%e8%bf%8e%e4%b8%ad%e5%9b%bd%e6%b8%85%e7%9c%9f%e6%8a%95%e8%b5%84",
  "route": "/5141/",
  "title": "\u79EF\u6781\u89C4\u5212\u5DDE\u5185\u57FA\u8BBE\u914D\u5957 \u5F6D\u9739\u5019\u8FCE\u4E2D\u56FD\u6E05\u771F\u6295\u8D44",
  "summary": "\u65FA\u7F57\u65AF\u8FEA \uFF08\u4E0A\u6D7711\u65E5\u8BAF\uFF09\u5F6D\u4EA8\u548C\u9739\u96F3\u5DDE\u653F\u5E9C\u79EF\u6781\u89C4\u5212\u548C\u53D1\u5C55\u5404\u81EA\u5DDE\u5185\u6E05\u771F\u4EA7\u4E1A\u4E2D\u5FC3\u7684\u57FA\u7840\u8BBE\u65BD\u540E\uFF0C\u5DF2\u51C6\u5907\u597D\u8FCE\u63A5\u6765\u81EA\u4E2D\u56FD\u6E05\u771F\u4EA7\u4E1A\u7684\u5927\u89C4\u6A21\u6295\u8D44\u3002 \u6709\u5173\u51C6\u5907\u5305\u62EC\u5EFA\u9020\u5DE5\u5382\u548C\u519C\u573A\u7684\u573A\u5730\u3001\u57FA\u7840\u8BBE\u65BD\u548C\u719F\u7EC3\u52B3\u52A8\u529B\uFF0C\u4EE5\u5438\u5F15\u6E05\u771F\u4EA7\u4E1A\u7684\u6295\u8D44\u8005\uFF0C\u4ECE\u800C\u6539\u5584\u4E24\u5DDE\u7684\u7ECF\u6D4E\u548C\u6536\u5165\u3002 \u5F6D\u4EA8\u5DDE\u52A1\u5927\u81E3\u62FF\u7763\u65AF\u91CC\u65FA\u7F57\u65AF\u8FEA\u8868\u793A\uFF0C\u8BE5\u5DDE\u63D0\u4F9B\u4E86\u5404\u79CD\u63AA\u65BD\uFF0C\u4EE5\u53CA\u6218\u7565\u4F4D\u7F6E\u6765\u53D1\u5C55\u6E05\u771F\u4EA7\u4E1A\uFF0C\u5305\u62EC\u6E05\u771F\u5DE5\u4E1A\u56ED\u533A\u3001\u6E05\u771F\u7269\u6D41\u4E2D\u5FC3\u548C\u7B26\u5408\u6E05\u771F\u6807\u51C6\u7684\u6E2F\u53E3\u3002 \u4ED6\u8BF4\uFF0C\u63D0\u4F9B\u7ED9\u6295\u8D44\u8005\u7684\u6218\u7565\u4F4D\u7F6E\u5305\u62EC\u5360\u5730304\u516C\u9877\u7684\u683C\u5BBE\u6E05\u771F\u4E2D\u5FC3\u3001\u5360\u573068.4\u516C\u9877\u7684\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/09/frc-16b316bf8ad96469b82914098fce01bc.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u65FA\u7F57\u65AF\u8FEA\u003C/p\u003E\n\u003Cp\u003E\uFF08\u4E0A\u6D7711\u65E5\u8BAF\uFF09\u5F6D\u4EA8\u548C\u9739\u96F3\u5DDE\u653F\u5E9C\u79EF\u6781\u89C4\u5212\u548C\u53D1\u5C55\u5404\u81EA\u5DDE\u5185\u6E05\u771F\u4EA7\u4E1A\u4E2D\u5FC3\u7684\u57FA\u7840\u8BBE\u65BD\u540E\uFF0C\u5DF2\u51C6\u5907\u597D\u8FCE\u63A5\u6765\u81EA\u4E2D\u56FD\u6E05\u771F\u4EA7\u4E1A\u7684\u5927\u89C4\u6A21\u6295\u8D44\u3002\u003C/p\u003E\n\u003Cp\u003E\u6709\u5173\u51C6\u5907\u5305\u62EC\u5EFA\u9020\u5DE5\u5382\u548C\u519C\u573A\u7684\u573A\u5730\u3001\u57FA\u7840\u8BBE\u65BD\u548C\u719F\u7EC3\u52B3\u52A8\u529B\uFF0C\u4EE5\u5438\u5F15\u6E05\u771F\u4EA7\u4E1A\u7684\u6295\u8D44\u8005\uFF0C\u4ECE\u800C\u6539\u5584\u4E24\u5DDE\u7684\u7ECF\u6D4E\u548C\u6536\u5165\u3002\u003C/p\u003E\n\u003Cp\u003E\u5F6D\u4EA8\u5DDE\u52A1\u5927\u81E3\u62FF\u7763\u65AF\u91CC\u65FA\u7F57\u65AF\u8FEA\u8868\u793A\uFF0C\u8BE5\u5DDE\u63D0\u4F9B\u4E86\u5404\u79CD\u63AA\u65BD\uFF0C\u4EE5\u53CA\u6218\u7565\u4F4D\u7F6E\u6765\u53D1\u5C55\u6E05\u771F\u4EA7\u4E1A\uFF0C\u5305\u62EC\u6E05\u771F\u5DE5\u4E1A\u56ED\u533A\u3001\u6E05\u771F\u7269\u6D41\u4E2D\u5FC3\u548C\u7B26\u5408\u6E05\u771F\u6807\u51C6\u7684\u6E2F\u53E3\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u63D0\u4F9B\u7ED9\u6295\u8D44\u8005\u7684\u6218\u7565\u4F4D\u7F6E\u5305\u62EC\u5360\u5730304\u516C\u9877\u7684\u683C\u5BBE\u6E05\u771F\u4E2D\u5FC3\u3001\u5360\u573068.4\u516C\u9877\u7684\u7518\u5B5F\u6E05\u771F\u4E2D\u5FC3\u548C\u5360\u573014.7\u516C\u9877\u7684\u6587\u51AC\u6E05\u771F\u4E2D\u5FC3\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u4E2D\u56FD\u7684\u6E05\u771F\u5DE5\u4E1A\u6295\u8D44\u8005\u5BF9\u5728\u5927\u9A6C\uFF0C\u7279\u522B\u662F\u5728\u5F6D\u4EA8\u5DDE\u8FDB\u884C\u6295\u8D44\u5C55\u73B0\u4E86\u6D53\u539A\u7684\u5174\u8DA3\u3002\u4ED6\u4EEC\u5E0C\u671B\u83B7\u53D6\u66F4\u591A\u7684\u4FE1\u606F\uFF0C\u4F8B\u5982\u6709\u5173\u571F\u5730\u4F7F\u7528\u548C\u5176\u4ED6\u6295\u8D44\u6D41\u7A0B\u7684\u76F8\u5173\u8BE6\u60C5\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u5DF2\u6307\u793A\u5DDE\u7EA7\u3001\u53BF\u5C5E\u5730\u65B9\u653F\u5E9C\u548C\u571F\u5730\u5C40\u7684\u7B80\u5316\u5B98\u50DA\u7A0B\u5E8F\u3002\u6211\u4EEC\u5E0C\u671B\u4E00\u5207\u80FD\u591F\u5FEB\u901F\u5904\u7406\uFF0C\u4E0D\u8981\u6709\u62D6\u5EF6\u5197\u957F\u7684\u6D41\u7A0B\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u5468\u4E8C\u5728\u4E0A\u6D77\u51FA\u5E2D\u9A6C\u4E2D\u6E05\u771F\u5546\u4E1A\u8BBA\u575B\u65F6\uFF0C\u5411\u5927\u9A6C\u5A92\u4F53\u8FD9\u4E48\u8868\u793A\u3002\u003C/p\u003E\n\u003Cp\u003E\u5468\u4E8C\u665A\uFF0C\u526F\u9996\u76F8\u62FF\u7763\u65AF\u91CC\u963F\u672B\u624E\u5E0C\u535A\u58EB\u8868\u793A\uFF0C\u5927\u9A6C\u6709\u671B\u901A\u8FC7\u6B64\u6B21\u8BBA\u575B\uFF0C\u5438\u5F15\u4EF7\u503C40\u4EBF\u4EE4\u5409\u7684\u4E2D\u56FD\u6E05\u771F\u4EA7\u4E1A\u6F5C\u5728\u65B0\u6295\u8D44\uFF0C\u4EE5\u4ECE\u4E2D\u53D7\u76CA\u3002\u8BE5\u8BBA\u575B\u5438\u5F15\u4E86\u6765\u81EA\u5927\u9A6C\u548C\u4E2D\u56FD\u768430\u591A\u540D\u6E05\u771F\u4EA7\u4E1A\u4EE3\u8868\u51FA\u5E2D\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E5F\u662F\u6E05\u771F\u4EA7\u4E1A\u53D1\u5C55\u59D4\u5458\u4F1A(MPIH)\u4E3B\u5E2D\u7684\u4ED6\u6307\u51FA\uFF0C\u6765\u81EA\u4E2D\u56FD\u7684\u5927\u91CF\u6295\u8D44\u6D89\u53CA\u5404\u4E2A\u9886\u57DF\uFF0C\u5305\u62EC\u8349\u836F\u3001\u98DF\u54C1\u548C\u996E\u6599\u3001\u75AB\u82D7\u3001\u5316\u5986\u54C1\u548C\u836F\u54C1\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/09/frc-08bfe1cd28998dd6d9df09098315c0ef.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u6C99\u62C9\u5C3C\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u66FC\u7ED2\u5EFA\u9739\u6E05\u771F\u5DE5\u4E1A\u56ED\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u7B2C\u4E00\u671F\u6599\u660E\u5E74\u521D\u8425\u8FD0\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u9739\u96F3\u5DDE\u52A1\u5927\u81E3\u62FF\u7763\u65AF\u91CC\u6C99\u62C9\u5C3C\u8868\u793A\uFF0C\u5DDE\u653F\u5E9C\u6B63\u5728\u66FC\u7ED2\u53BF\u529B\u4E54\u9644\u8FD1\u5F00\u53D1\u5360\u573057.8\u516C\u9877\u7684\u9739\u96F3\u6E05\u771F\u5DE5\u4E1A\u56ED(HIP)\uFF0C\u9884\u8BA1\u7B2C\u4E00\u671F\u5C06\u4E8E\u660E\u5E74\u521D\u8425\u8FD0\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u6E05\u771F\u5DE5\u4E1A\u56ED\u7684\u6218\u7565\u4F4D\u7F6E\u548C\u8BBE\u65BD\uFF0C\u5C06\u4F7F\u672C\u5730\u548C\u5916\u56FD\u6295\u8D44\u8005\u80FD\u5EFA\u9020\u6E05\u771F\u4EA7\u54C1\u7684\u5DE5\u5382\u6216\u519C\u573A\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u5728\u4E00\u9879\u6B21\u4F1A\u8BAE\u4E0A\u6307\u51FA\uFF0C\u5DDE\u653F\u5E9C\u5411\u4E2D\u56FD\u6295\u8D44\u8005\u89E3\u91CA\u4E86\u53D1\u5C55\u6E05\u771F\u4EA7\u4E1A\u7684\u63D0\u8BAE\u548C\u4FDD\u8BC1\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u9739\u96F3\u6E05\u771F\u5DE5\u4E1A\u56ED\u5C31\u5728\u90A3\u91CC\u3002\u5982\u679C\u6295\u8D44\u8005\u9700\u8981\u66F4\u5927\u7684\u573A\u5730\uFF0C\u5DDE\u79D8\u4E66\u529E\u516C\u5BA4(SSI)\u7684\u571F\u5730\u53EF\u6539\u9020\u6210\u5DE5\u4E1A\u533A\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u4E5F\u6709\u4E00\u4E9B\u79C1\u4EBA\u5730\u6BB5\u7684\u4E1A\u4E3B\u8868\u793A\u5174\u8DA3\u5408\u4F5C\uFF0C\u4EE5\u4E3A\u6295\u8D44\u8005\u51C6\u5907\u5EFA\u5382\u5730\u70B9\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8865\u5145\u9053\uFF0C\u4E00\u5BB6\u6E05\u771F\u4EA7\u54C1\u516C\u53F8\u6709\u610F\u5728\u9739\u96F3\u5DDE\u6295\u8D442000\u4E07\u4EE4\u5409\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u8FD9\u9879\u5916\u8D44\u5C06\u6781\u5927\u5730\u9020\u798F\u9739\u96F3\u5DDE\uFF0C\u7279\u522B\u662F\u4E3A\u5E74\u8F7B\u4EBA\u521B\u9020\u5C31\u4E1A\u673A\u4F1A\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u9664\u4E86\u63A8\u52A8\u5DDE\u5C5E\u7ECF\u6D4E\u53D1\u5C55\u5916\uFF0C\u9739\u96F3\u5DDE\u53C2\u4E0E\u6E05\u771F\u8BBA\u575B\u4E5F\u5951\u5408\u653F\u5E9C\u4FC3\u8FDB\u6E05\u771F\u4EA7\u4E1A\u589E\u957F\u7684\u76EE\u6807\u3002\u6E05\u771F\u4EA7\u4E1A\u5728\u56FD\u9645\u4E0A\u7684\u91CD\u8981\u6027\u6B63\u65E5\u76CA\u63D0\u5347\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/bZ5cFzkhMceV4pPXUc-hBw\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
