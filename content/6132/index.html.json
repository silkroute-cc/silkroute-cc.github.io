{
  "id": "\u8D70\u8FDB\u96EA\u5170\u83AA\u81EA\u7136\u79D8\u5883\u5C55\u5F00\u5468\u672B\u9003\u79BB\u8BA1\u5212",
  "slug": "\u8D70\u8FDB\u96EA\u5170\u83AA\u81EA\u7136\u79D8\u5883\u5C55\u5F00\u5468\u672B\u9003\u79BB\u8BA1\u5212",
  "canonicalUrlKey": "\u8D70\u8FDB\u96EA\u5170\u83AA\u81EA\u7136\u79D8\u5883\u5C55\u5F00\u5468\u672B\u9003\u79BB\u8BA1\u5212",
  "route": "/6132/",
  "title": "\u8D70\u8FDB\u96EA\u5170\u83AA\u81EA\u7136\u79D8\u5883\uFF5C\u5C55\u5F00\u5468\u672B\u9003\u79BB\u8BA1\u5212\uFF01",
  "summary": "\u672C\u6587\u5E26\u4F60\u8D70\u8FDB\u9A6C\u6765\u897F\u4E9A\u96EA\u5170\u83AA\u5DDEHulu Langat\u7684Chongkak Park \u0026 Resort\u68EE\u6797\u79D8\u5883\u3002\u516C\u56ED\u6CBF\u6EAA\u6D41\u800C\u5EFA\uFF0C\u56DB\u5468\u88AB\u8302\u5BC6\u7684\u70ED\u5E26\u96E8\u6797\u73AF\u7ED5\uFF0C\u8DDD\u5409\u9686\u5761\u8F66\u7A0B\u7EA6\u4E00\u5C0F\u65F6\uFF0C\u662F\u672C\u5730\u4EBA\u5468\u672B\u4EB2\u8FD1\u81EA\u7136\u7684\u5EA6\u5047\u5730\u3002\u6587\u4E2D\u5199\u5230\u5728\u6EAA\u6D41\u65C1\u73A9\u6C34\u3001\u547C\u5438\u6E05\u65B0\u7A7A\u6C14\u3001\u4E0E\u4EB2\u53CB\u6162\u4EAB\u65F6\u5149\u7684\u4F53\u9A8C\uFF0C\u5E76\u9644\u73A9\u6C34\u5C0F\u8D34\u58EB\uFF1A\u6EAA\u6D41\u77F3\u5934\u6E7F\u6ED1\uFF0C\u6E38\u73A9\u9700\u653E\u6162\u811A\u6B65\u3002\u56ED\u533A\u5F00\u653E\u65F6\u95F4\u4E3A8am-6pm\uFF0C\u56FE\u6E90Selangor.Travel\u3002",
  "body": "\u003Cp\u003E\u6709\u65F6\u5019\uFF0C\u65C5\u884C\u4E0D\u4E00\u5B9A\u8981\u5C06\u884C\u7A0B\u6392\u6EE1\uFF0C\u003C/p\u003E\n\u003Cp\u003E\u4E00\u7247\u7F8E\u597D\u7684\u98CE\u666F\u3001\u4E00\u4E2A\u8212\u5FC3\u7684\u5730\u65B9\uFF0C\u003C/p\u003E\n\u003Cp\u003E\u518D\u52A0\u4E0A\u4E09\u4E94\u597D\u53CB\uFF0C\u5C31\u8DB3\u4EE5\u5C55\u5F00\u4E00\u573A\u60EC\u610F\u0026#128175;\u7684\u65C5\u884C\u2728\u003C/p\u003E\n\u003Cp\u003E\u5409\u9686\u5761\u9644\u8FD1\u5C31\u9690\u85CF\u7740\u4E00\u4E2A\u672C\u5730\u4EBA\u4E5F\u7231\u53BB\u7684\u68EE\u6797\u79D8\u5883\u0026#127811;\u003C/p\u003E\n\u003Cp\u003E\u0026#127795;\u8FD9\u91CC\u88AB\u81EA\u7136\u7EFF\u610F\u5305\u56F4\uFF0C\u003C/p\u003E\n\u003Cp\u003E\u0026#127754;\u4E0D\u59A8\u5750\u5728\u6EAA\u6D41\u65C1\uFF0C\u003C/p\u003E\n\u003Cp\u003E\u0026#128167;\u6B23\u8D4F\u6F7A\u6F7A\u6D41\u6C34\u3001\u003C/p\u003E\n\u003Cp\u003E\u0026#127811;\u547C\u5438\u4E00\u53E3\u6E05\u65B0\u7A7A\u6C14\uFF0C\u003C/p\u003E\n\u003Cp\u003E\u548C\u4EB2\u670B\u597D\u53CB\u804A\u804A\u751F\u6D3B\u788E\u7247\uFF0C\u9759\u9759\u4EAB\u53D7\u6162\u4E0B\u6765\u7684\u65F6\u5149\u3002\u003C/p\u003E\n\u003Cp\u003E\u0026#128205;Chongkak Park \u0026amp; Resort, Hulu Langat\u003C/p\u003E\n\u003Cp\u003E\u8D81\u7740\u5468\u672B\uFF0C\u4E0D\u59A8\u6765\u5230\u8FD9\u91CC\u653E\u677E\u8EAB\u5FC3\u7075\u3002\u003C/p\u003E\n\u003Cp\u003E\u0026#127807;\u88AB\u68EE\u6797\u7EFF\u610F\u5305\u56F4\u7684\u68EE\u6797\u79D8\u5883\u003C/p\u003E\n\u003Cp\u003E\u516C\u56ED\u6CBF\u7740\u6EAA\u6D41\u800C\u5EFA\uFF0C\u56DB\u5468\u88AB\u8302\u5BC6\u7684\u70ED\u5E26\u96E8\u6797\u73AF\u7ED5\u3002\u8E0F\u5165\u8FD9\u91CC\uFF0C\u4EFF\u4F5B\u77AC\u95F4\u9003\u79BB\u57CE\u5E02\u55A7\u56A3\uFF0C\u4E00\u79D2\u5F00\u542F\u0026#128283;\u7597\u6108\u6A21\u5F0F\u3002\u003C/p\u003E\n\u003Cp\u003E\u0026#128663;\u79BB\u5409\u9686\u5761\u4E0D\u8FDC\u7684\u81EA\u7136\u7CFB\u5EA6\u5047\u5730\u003C/p\u003E\n\u003Cp\u003E\u65E0\u9700\u957F\u9014\u8DCB\u6D89\uFF0C\u9A71\u8F66\u7EA61\u5C0F\u65F6\uFF0C\u5C31\u80FD\u4EB2\u8FD1\u5927\u81EA\u7136\uFF0C\u5C55\u5F00\u4E00\u573A\u8F7B\u677E\u7684\u65C5\u884C\uFF01\u003C/p\u003E\n\u003Cp\u003E\u26A0\uFE0F\u73A9\u6C34\u5C0F\u8D34\u58EB\u003C/p\u003E\n\u003Cp\u003E\u6EAA\u6D41\u4E2D\u7684\u77F3\u5934\u5BB9\u6613\u6E7F\u6ED1\uFF0C\u6E38\u73A9\u65F6\u8BB0\u5F97\u653E\u6162\u811A\u6B65\uFF0C\u907F\u514D\u6ED1\u5012\u53D7\u4F24\u3002\u003C/p\u003E\n\u003Cp\u003E\u0026#127811;Chongkak Park \u0026amp; Resort\u003C/p\u003E\n\u003Cp\u003E\u0026#128205;\u5730\u5740\uFF1AChongkak Park \u0026amp; Resort, Jalan Sungai Congkak, Kampung Padang, Hulu Langat, Selangor, Malaysia\u003C/p\u003E\n\u003Cp\u003E\u5F00\u653E\u65F6\u95F4\uFF1A8am-6pm\u003C/p\u003E\n\u003Cp\u003E\u56FE\u6E90\uFF1ASelangor.Travel\u003C/p\u003E\n\u003Cp\u003E#\u9B45\u529B\u96EA\u5170\u83AA #\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38 #\u9A6C\u6765\u897F\u4E9A\u96EA\u5170\u83AA #VisitSelangor2026 #\u96EA\u5170\u83AA\u60CA\u559C\u8FDE\u8FDE\u003C/p\u003E\n",
