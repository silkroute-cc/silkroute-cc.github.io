  "title": "\u4E1D\u7EF8\u4E4B\u8DEF\u65C5\u6E38\u57CE\u5E02\u8054\u76DF\u6B63\u5F0F\u6210\u7ACB\uFF0C\u9A6C\u6765\u897F\u4E9A\u69DF\u57CE\u6210\u4E3A\u521B\u59CB\u4F1A\u5458\u57CE\u5E02",
  "summary": "9\u67081\u65E5\uFF0C\u4E1D\u7EF8\u4E4B\u8DEF\u65C5\u6E38\u57CE\u5E02\u8054\u76DF\u6210\u7ACB\u7CFB\u5217\u6D3B\u52A8\u5728\u6C5F\u897F\u7701\u666F\u5FB7\u9547\u5E02\u4E3E\u529E\u3002 \u6D3B\u52A8\u5305\u62EC \u4E1D\u7EF8\u4E4B\u8DEF\u65C5\u6E38\u57CE\u5E02\u8054\u76DF\u6210\u7ACB\u4EEA\u5F0F\u30012023\u201C\u4E1D\u7EF8\u4E4B\u8DEF\u57CE\u5E02\u6587\u5316\u548C\u65C5\u6E38\u53D1\u5C55\u56FD\u9645\u8BBA\u575B\u201D\u4EE5\u53CA\u201C\u9B45\u529B\u4E1D\u8DEF \u8FDE\u901A\u4E16\u754C\u2014\u4E1D\u7EF8\u4E4B\u8DEF\u65C5\u6E38\u57CE\u5E02\u8054\u5408\u63A8\u4ECB\u5C55\u201D\u3002 \u6D77\u5185\u5916\u8054\u76DF\u4F1A\u5458\u57CE\u5E02\u4EE3\u8868\u3001 \u9A7B\u534E\u4F7F\u8282\u4EE3\u8868\u3001 \u4E13\u5BB6\u5B66\u8005\u3001\u884C\u4E1A\u534F\u4F1A\u3001\u6587\u5316\u4EA7\u4E1A\u548C\u65C5\u6E38\u4E1A\u4EE3\u8868\u51FA\u5E2D\u6D3B\u52A8\u3002 \u8BE5\u8054\u76DF\u7531\u6587\u5316\u548C\u65C5\u6E38\u90E8\u4E2D\u5916\u6587\u5316\u4EA4\u6D41\u4E2D\u5FC3\u8054\u5408\u56FD\u5185\u5916\u77E5\u540D\u65C5\u6E38\u57CE\u5E02\u5171\u540C\u53D1\u8D77\uFF0C\u65E8\u5728\u4EE5\u4E1D\u7EF8\u4E4B\u8DEF\u7CBE\u795E\u4E3A\u6307\u5F15\uFF0C\u4EE5\u5171\u5546\u5171\u5EFA\u5171\u4EAB\u4E3A\u539F\u5219\uFF0C\u4E3A\u5305\u62EC\u4E1D\u7EF8\u4E4B\u8DEF\u6CBF\u7EBF\u5728\u5185\u7684\u4E2D\u5916\u57CE\u5E02\u65C5\u6E38\u9886\u57DF\u4EA4\u6D41\u5408\u4F5C\u5EFA\u8BBE\u957F\u2026",
  "body": "\u003Cp\u003E9\u67081\u65E5\uFF0C\u4E1D\u7EF8\u4E4B\u8DEF\u65C5\u6E38\u57CE\u5E02\u8054\u76DF\u6210\u7ACB\u7CFB\u5217\u6D3B\u52A8\u5728\u6C5F\u897F\u7701\u666F\u5FB7\u9547\u5E02\u4E3E\u529E\u3002\u6D3B\u52A8\u5305\u62EC\u4E1D\u7EF8\u4E4B\u8DEF\u65C5\u6E38\u57CE\u5E02\u8054\u76DF\u6210\u7ACB\u4EEA\u5F0F\u30012023\u201C\u4E1D\u7EF8\u4E4B\u8DEF\u57CE\u5E02\u6587\u5316\u548C\u65C5\u6E38\u53D1\u5C55\u56FD\u9645\u8BBA\u575B\u201D\u4EE5\u53CA\u201C\u9B45\u529B\u4E1D\u8DEF \u8FDE\u901A\u4E16\u754C\u2014\u4E1D\u7EF8\u4E4B\u8DEF\u65C5\u6E38\u57CE\u5E02\u8054\u5408\u63A8\u4ECB\u5C55\u201D\u3002\u6D77\u5185\u5916\u8054\u76DF\u4F1A\u5458\u57CE\u5E02\u4EE3\u8868\u3001\u9A7B\u534E\u4F7F\u8282\u4EE3\u8868\u3001\u4E13\u5BB6\u5B66\u8005\u3001\u884C\u4E1A\u534F\u4F1A\u3001\u6587\u5316\u4EA7\u4E1A\u548C\u65C5\u6E38\u4E1A\u4EE3\u8868\u51FA\u5E2D\u6D3B\u52A8\u3002\n\u003C/p\u003E\n\u003Cp\u003E\u8BE5\u8054\u76DF\u7531\u6587\u5316\u548C\u65C5\u6E38\u90E8\u4E2D\u5916\u6587\u5316\u4EA4\u6D41\u4E2D\u5FC3\u8054\u5408\u56FD\u5185\u5916\u77E5\u540D\u65C5\u6E38\u57CE\u5E02\u5171\u540C\u53D1\u8D77\uFF0C\u65E8\u5728\u4EE5\u4E1D\u7EF8\u4E4B\u8DEF\u7CBE\u795E\u4E3A\u6307\u5F15\uFF0C\u4EE5\u5171\u5546\u5171\u5EFA\u5171\u4EAB\u4E3A\u539F\u5219\uFF0C\u4E3A\u5305\u62EC\u4E1D\u7EF8\u4E4B\u8DEF\u6CBF\u7EBF\u5728\u5185\u7684\u4E2D\u5916\u57CE\u5E02\u65C5\u6E38\u9886\u57DF\u4EA4\u6D41\u5408\u4F5C\u5EFA\u8BBE\u957F\u6548\u673A\u5236\u3002\u8054\u76DF\u5C06\u4E3E\u529E\u56FD\u9645\u8BBA\u575B\u3001\u8054\u5408\u63A8\u4ECB\u3001\u4EA7\u4E1A\u5BF9\u63A5\u7B49\u4E00\u7CFB\u5217\u4E3B\u9898\u6D3B\u52A8\uFF0C\u52A9\u63A8\u4F1A\u5458\u57CE\u5E02\u65C5\u6E38\u4E1A\u53EF\u6301\u7EED\u53D1\u5C55\u3002\u622A\u81F3\u76EE\u524D\uFF0C\u5DF2\u6709\u5305\u62EC\u4E2D\u56FD\u5728\u5185\u768426\u4E2A\u56FD\u5BB658\u4E2A\u6D77\u5185\u5916\u57CE\u5E02\u4F5C\u4E3A\u521B\u59CB\u4F1A\u5458\u52A0\u5165\u8054\u76DF\u3002\u003C/p\u003E\n\u003Cp\u003E\u6D77\u5916\u57CE\u5E02\u4E2D\uFF0C\u202C\u4E9A\u6D32\u5730\u533A\u6709\u202C\u9A6C\u6765\u897F\u4E9A\u69DF\u57CE\u3001\u6CF0\u56FD\u6E05\u83B1\u3001\u6CF0\u56FD\u5ECA\u5F00\u7B49\u202C\uFF0C\u6B27\u4E9A\u5730\u533A\u6709\u202C\u963F\u585E\u62DC\u7586\u820D\u57FA\u3001\u767D\u4FC4\u7F57\u65AF\u660E\u65AF\u514B\u3001\u4FDD\u52A0\u5229\u4E9A\u5927\u7279\u5C14\u8BFA\u6C83\u3001\u5308\u7259\u5229\u9ED1\u7EF4\u5179\u3001\u5308\u7259\u5229\u585E\u683C\u5FB7\u3001\u5854\u5409\u514B\u65AF\u5766\u5E93\u5229\u4E9A\u5E03\u3001\u4E4C\u5179\u522B\u514B\u65AF\u5766\u5E03\u54C8\u62C9\u3001\u4E4C\u5179\u522B\u514B\u65AF\u5766\u5E0C\u74E6\u3001\u4E4C\u5179\u522B\u514B\u65AF\u5766\u6D69\u7F55\u7B49\u202C\uFF0C\u897F\u4E9A\u5317\u975E\u5730\u533A\u6709\u202C\u57C3\u53CA\u8D6B\u5C14\u683C\u8FBE\u3001\u7EA6\u65E6\u5B89\u66FC\u3001\u7EA6\u65E6\u4F69\u7279\u62C9\u3001\u6469\u6D1B\u54E5\u4E39\u5409\u5C14\u3001\u6C99\u7279\u963F\u62C9\u4F2F\u57C3\u5C14\u5965\u62C9\u3001\u571F\u8033\u5176\u4F0A\u65AF\u5766\u5E03\u5C14\u202C\u7B49\u202C\uFF0C\u975E\u6D32\u5730\u533A\u6709\u202C\u521A\u679C\uFF08\u5E03\uFF09\u5E03\u62C9\u67F4\u7EF4\u5C14\u3001\u521A\u679C\uFF08\u5E03\uFF09\u9ED1\u89D2\u7B49\u202C\uFF0C\u6B27\u6D32\u5730\u533A\u6709\u202C\u9A6C\u8033\u4ED6\u6851\u5854\u9732\u897F\u4E9A\u3001\u82F1\u56FD\u9EA6\u514B\u5C14\u65AF\u83F2\u5C14\u5FB7\u7B49\u202C\uFF0C\u7F8E\u6D32\u5730\u533A\u6709\u202C\u5DF4\u897F\u4F0A\u74DC\u82CF\u3001\u58A8\u897F\u54E5\u574E\u6606\u7B49\u202C\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/09/frc-7a8595df3821e1d5d5ea111ebed06c63.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u4E1D\u7EF8\u4E4B\u8DEF\u65C5\u6E38\u57CE\u5E02\u8054\u76DF\u53D1\u8D77\u4F1A\u5458\u57CE\u5E02\u4EE3\u8868\u5408\u5F71\u003C/p\u003E\n\u003Cp\u003E\u8054\u76DF\u4E4B\u540E\u6BCF\u5E74\u5C06\u5728\u8F6E\u503C\u4E3B\u5E2D\u57CE\u5E02\u4E3E\u529E\u201C\u4E1D\u7EF8\u4E4B\u8DEF\u57CE\u5E02\u6587\u5316\u548C\u65C5\u6E38\u53D1\u5C55\u56FD\u9645\u8BBA\u575B\u201D\uFF0C\u9762\u5411\u4F01\u4E1A\u548C\u516C\u4F17\u5F00\u5C55\u4F1A\u5458\u57CE\u5E02\u6587\u5316\u548C\u65C5\u6E38\u4E3B\u9898\u8054\u5408\u63A8\u4ECB\u6D3B\u52A8\uFF0C\u5E76\u89C6\u60C5\u4E3E\u529E\u8054\u76DF\u6846\u67B6\u5185\u4F1A\u5458\u57CE\u5E02\u5B98\u65B9\u4E92\u8BBF\u3001\u9752\u5E74\u4EA4\u6D41\u3001\u4E13\u4E1A\u57F9\u8BAD\u3001\u8003\u5BDF\u7814\u4FEE\u3001\u4E3B\u9898\u8E29\u7EBF\u3001\u8282\u65E5\u8054\u6B22\u3001\u540D\u57CE\u8BC4\u9009\u7B49\u6D3B\u52A8\u3002\u003C/p\u003E\n\u003Cp\u003E\u8054\u76DF\u8FD8\u5C06\u6301\u7EED\u52A0\u5F3A\u4F1A\u5458\u57CE\u5E02\u95F4\u7684\u653F\u7B56\u8054\u901A\u3001\u8D44\u6E90\u7EDF\u7B79\u3001\u5E02\u573A\u5BF9\u63A5\u3001\u4EA7\u4E1A\u5408\u4F5C\u3001\u4FE1\u606F\u5171\u4EAB\u3001\u6280\u672F\u4F20\u64AD\u548C\u80FD\u529B\u63D0\u5347\uFF0C\u5171\u540C\u6253\u9020\u5E76\u63A8\u51FA\u533A\u57DF\u6027\u3001\u4E3B\u9898\u6027\u56FD\u9645\u65C5\u6E38\u4F18\u8D28\u4EA7\u54C1\u53CA\u7CBE\u54C1\u7EBF\u8DEF\uFF0C\u63D0\u5347\u4F1A\u5458\u57CE\u5E02\u65C5\u6E38\u5F62\u8C61\uFF0C\u52A9\u529B\u4F1A\u5458\u57CE\u5E02\u65C5\u6E38\u4EA7\u4E1A\u5347\u7EA7\uFF0C\u63A8\u52A8\u66F4\u5177\u5305\u5BB9\u6027\u3001\u66F4\u53EF\u6301\u7EED\u7684\u57CE\u5E02\u53D1\u5C55\u3002\u003C/p\u003E\n\u003Cp\u003E\u66F4\u591A\u7CBE\u5F69\uFF0C\u656C\u8BF7\u5173\u6CE8\uFF1A\u003C/p\u003E\n\u003Cp\u003E\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5B98\u7F51\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003Ehttps://www.chinaculturalcentre.my\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EFacebook\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u201CChina Cultural Centre in Kuala Lumpur\u201D\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u516C\u4F17\u53F7\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u201C\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u201D\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EYoutube\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u201CChina Cultural Centre in Kuala Lumpur\u201D\u003C/p\u003E\n\u003Cp\u003