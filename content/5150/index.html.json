{
  "id": "%e7%9f%ad%e6%9c%9f%e5%87%ba%e5%9b%bd%e4%b8%a2%e5%a4%b1%e6%8a%a4%e7%85%a7%e7%94%b3%e5%8a%9e%e7%b4%a7%e6%80%a5%e6%97%85%e8%a1%8c%e8%af%81",
  "slug": "%e7%9f%ad%e6%9c%9f%e5%87%ba%e5%9b%bd%e4%b8%a2%e5%a4%b1%e6%8a%a4%e7%85%a7%e7%94%b3%e5%8a%9e%e7%b4%a7%e6%80%a5%e6%97%85%e8%a1%8c%e8%af%81",
  "canonicalUrlKey": "%e7%9f%ad%e6%9c%9f%e5%87%ba%e5%9b%bd%e4%b8%a2%e5%a4%b1%e6%8a%a4%e7%85%a7%e7%94%b3%e5%8a%9e%e7%b4%a7%e6%80%a5%e6%97%85%e8%a1%8c%e8%af%81",
  "route": "/5150/",
  "title": "\u77ED\u671F\u51FA\u56FD\u4E22\u5931\u62A4\u7167\u7533\u529E\u7D27\u6025\u65C5\u884C\u8BC1",
  "summary": "\u4E00\u3001\u9002\u7528\u60C5\u5F62 \u4E3B\u8981\u9002\u7528\u4E8E\u4E34\u65F6\u51FA\u56FD\u671F\u95F4\u62A4\u7167\u9057\u5931\u3001\u88AB\u76D7\u6216\u635F\u6BC1\u6025\u9700\u56DE\u56FD\u7684\u60C5\u5F62\u3002 \u4E8C\u3001\u7533\u8BF7\u65B9\u5F0F \uFF08\u4E00\uFF09\u7533\u8BF7\u4EBA\u5230\u624B\u673A\u5E94\u7528\u5546\u5E97\u4E0B\u8F7D\u6700\u65B0\u7248\u672C\u201C\u4E2D\u56FD\u9886\u4E8B\u201DAPP\uFF08V2.3.9\u7248\uFF09\uFF0C\u901A\u8FC7APP\u586B\u5199\u53CA\u63D0\u4EA4\u8BC1\u4EF6\u529E\u7406\u7533\u8BF7\uFF0C\u5EFA\u8BAE\u9009\u62E9\u201C\u5230\u9986\u529E\u7406\u201D--\u201C\u5230\u9986\u63D0\u4EA4\u201D\u3002 \u5F53\u201C\u4E2D\u56FD\u9886\u4E8B\u201DAPP\u72B6\u6001\u8F6C\u53D8\u4E3A\u201C\u590D\u5BA1\u4E2D\u201D\u540E\uFF0C\u65E0\u9700\u9884\u7EA6\uFF0C\u672C\u4EBA\u4E8E\u5DE5\u4F5C\u65E59:00-11:30\u76F4\u63A5\u524D\u5F80\u4F7F\u9986\u9886\u4E8B\u670D\u52A1\u5927\u5385\u9012\u4EA4\u7533\u8BF7\u6750\u6599\u3001\u6838\u9A8C\u8EAB\u4EFD\u7B49\u3002 \u4E0D\u4FBF\u5230\u9986\u7684\u7684\u7533\u8BF7\u4EBA\u53EF\u9009\u62E9\u5728\u7EBF\u529E\u7406\uFF0C\u901A\u8FC7\u521D\u5BA1\u540E\u987B\u6839\u636E\u7CFB\u7EDF\u63D0\u793A\u9884\u7EA6\u89C6\u9891\u9762\u5BA1\u3002\u9762\u5BA1\u901A\u8FC7\uFF0C\u201C\u4E2D\u56FD\u9886\u4E8B\u201DAPP\u663E\u2026",
  "body": "\u003Cp\u003E\u4E00\u3001\u9002\u7528\u60C5\u5F62\u003C/p\u003E\n\u003Cp\u003E\u4E3B\u8981\u9002\u7528\u4E8E\u4E34\u65F6\u51FA\u56FD\u671F\u95F4\u62A4\u7167\u9057\u5931\u3001\u88AB\u76D7\u6216\u635F\u6BC1\u6025\u9700\u56DE\u56FD\u7684\u60C5\u5F62\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E8C\u3001\u7533\u8BF7\u65B9\u5F0F\u003C/p\u003E\n\u003Cp\u003E\uFF08\u4E00\uFF09\u7533\u8BF7\u4EBA\u5230\u624B\u673A\u5E94\u7528\u5546\u5E97\u4E0B\u8F7D\u6700\u65B0\u7248\u672C\u201C\u4E2D\u56FD\u9886\u4E8B\u201DAPP\uFF08V2.3.9\u7248\uFF09\uFF0C\u901A\u8FC7APP\u586B\u5199\u53CA\u63D0\u4EA4\u8BC1\u4EF6\u529E\u7406\u7533\u8BF7\uFF0C\u5EFA\u8BAE\u9009\u62E9\u201C\u5230\u9986\u529E\u7406\u201D--\u201C\u5230\u9986\u63D0\u4EA4\u201D\u3002\u003C/p\u003E\n\u003Cp\u003E\u5F53\u201C\u4E2D\u56FD\u9886\u4E8B\u201DAPP\u72B6\u6001\u8F6C\u53D8\u4E3A\u201C\u590D\u5BA1\u4E2D\u201D\u540E\uFF0C\u65E0\u9700\u9884\u7EA6\uFF0C\u672C\u4EBA\u4E8E\u5DE5\u4F5C\u65E59:00-11:30\u76F4\u63A5\u524D\u5F80\u4F7F\u9986\u9886\u4E8B\u670D\u52A1\u5927\u5385\u9012\u4EA4\u7533\u8BF7\u6750\u6599\u3001\u6838\u9A8C\u8EAB\u4EFD\u7B49\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E0D\u4FBF\u5230\u9986\u7684\u7684\u7533\u8BF7\u4EBA\u53EF\u9009\u62E9\u5728\u7EBF\u529E\u7406\uFF0C\u901A\u8FC7\u521D\u5BA1\u540E\u987B\u6839\u636E\u7CFB\u7EDF\u63D0\u793A\u9884\u7EA6\u89C6\u9891\u9762\u5BA1\u3002\u9762\u5BA1\u901A\u8FC7\uFF0C\u201C\u4E2D\u56FD\u9886\u4E8B\u201DAPP\u663E\u793A\u201C\u5F85\u5236\u8BC1\u201D\u540E\u90AE\u5BC4\u7533\u8BF7\u6750\u6599\u5230\u9986\u3002\u003C/p\u003E\n\u003Cp\u003E \uFF08\u4E8C\uFF09\u5F53\u201C\u4E2D\u56FD\u9886\u4E8B\u201DAPP\u8BA2\u5355\u72B6\u6001\u8F6C\u53D8\u4E3A\u201C\u5F85\u53D6\u8BC1\u201D\u540E\uFF0C\u7533\u8BF7\u4EBA\u53EF\u5230\u4F7F\u9986\u9886\u4E8B\u670D\u52A1\u5927\u5385\u7F34\u8D39\u53CA\u9886\u53D6\u65B0\u8BC1\u4EF6\u3002\u53D6\u8BC1\u65F6\u95F4\u4E3A\u5DE5\u4F5C\u65E5\u4E0B\u534814:30-16:30\u3002\u7533\u8BF7\u4EBA\u4EA6\u53EF\u9009\u62E9\u90AE\u5BC4\u53D6\u8BC1\uFF0C\u8D39\u7528\u6C47\u81F3\u4F7F\u9986\u8D26\u6237\u3002\u5F85APP\u72B6\u6001\u66F4\u65B0\u4E3A\u201C\u5DF2\u53D6\u8BC1\u201D\uFF0C\u6211\u9986\u5C06\u4E8E2\u4E2A\u5DE5\u4F5C\u65E5\u5185\u53D1\u9001\u9884\u7EA6\u5FEB\u9012\u53D6\u4EF6\u901A\u77E5\u81F3\u7533\u8BF7\u4EBA\u7535\u5B50\u90AE\u7BB1\u3002\u003C/p\u003E\n\u003Cp\u003E\uFF08\u4E09\uFF09\u7279\u522B\u8BF4\u660E\uFF1A\u4E2D\u56FD\u9A7B\u9A6C\u6765\u897F\u4E9A\u5927\u4F7F\u9986\u4E3B\u8981\u53D7\u7406\u5C45\u4F4F\u5728\u897F\u9A6C\uFF08\u4EE5\u9A6C\u65B9\u7B7E\u8BC1\u7B7E\u53D1\u673A\u6784\u6240\u5728\u5730\u4E3A\u51C6\uFF09\u7684\u4E2D\u56FD\u516C\u6C11\u7533\u8BF7\u3002\u5C45\u4F4F\u4E1C\u9A6C\u7684\u7533\u8BF7\u4EBA\u53EF\u6839\u636E\u4E0D\u540C\u60C5\u51B5\u5206\u522B\u5411\u4E2D\u56FD\u9A7B\u53E4\u664B\u603B\u9886\u9986\u6216\u4E2D\u56FD\u9A7B\u54E5\u6253\u57FA\u7EB3\u5DF4\u5362\u603B\u9886\u9986\u7533\u8BF7\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E09\u3001\u6240\u9700\u4E0A\u4F20\u7533\u8BF7\u6750\u6599\u003C/p\u003E\n\u003Cp\u003E1. \u7167\u7247\uFF1A\u8FD1\u671F\uFF086\u4E2A\u6708\u5185\uFF09\u6B63\u9762\u514D\u51A0\u5F69\u8272\u534A\u8EAB\u8BC1\u4EF6\u7167\u7247\uFF08\u7535\u5B50\u7248\uFF09\uFF0C\u7167\u7247\u5C3A\u5BF8\u4E3A48mmX33mm\uFF0C\u5934\u90E8\u5BBD15mm-22mm\u3001\u9AD8 28mm-33mm\uFF0C\u80CC\u666F\u4E3A\u767D\u8272\uFF0C\u4E0D\u5F97\u7740\u6D45\u8272\u8863\u670D\uFF0C\u8868\u60C5\u81EA\u7136\uFF0C\u53CC\u773C\u7741\u5F00\uFF0C\u53CC\u5507\u81EA\u7136\u95ED\u5408\uFF0C\u5934\u53D1\u52FF\u906E\u6321\u8033\u5ED3\uFF0C\u5168\u90E8\u9762\u90E8\u7279\u5F81\u6E05\u6670\u53EF\u89C1\uFF1B\u003C/p\u003E\n\u003Cp\u003E2. \u62A4\u7167\u8D44\u6599\u9875\u590D\u5370\u4EF6\uFF08\u5982\u6709\uFF09\uFF1B\u003C/p\u003E\n\u003Cp\u003E3. \u5982\u6709\u56FD\u5185\u6709\u6237\u53E3\uFF0C\u8BF7\u63D0\u4F9B\u6237\u53E3\u7C3F\u6216\u5C45\u6C11\u8EAB\u4EFD\u8BC1\u590D\u5370\u4EF6\uFF08\u5982\u6709\uFF09\uFF0C\u5982\u65E0\u6237\u53E3\u5219\u9700\u4F5C\u51FA\u4E66\u9762\u58F0\u660E\uFF1B\u003C/p\u003E\n\u003Cp\u003E4. \u300A\u7533\u8BF7\u4EBA\u58F0\u660E\u300B\uFF08\u53EF\u5728\u4E2D\u56FD\u9A7B\u9A6C\u6765\u897F\u4E9A\u5927\u4F7F\u9986\u5B98\u65B9\u7F51\u7AD9\u201C\u9996\u9875 \u0026gt; \u9886\u4E8B\u670D\u52A1 \u0026gt; \u9886\u4E8B\u8BC1\u4EF6 \u0026gt; \u62A4\u7167\u65C5\u884C\u8BC1 \u0026gt; \u8868\u683C\u4E0B\u8F7D\u201D\u4E2D\u4E0B\u8F7D\uFF09\uFF1B\u003C/p\u003E\n\u003Cp\u003E5.\u300A\u56FD\u7C4D\u72B6\u51B5\u58F0\u660E\u4E66\u300B\uFF1B\u003C/p\u003E\n\u003Cp\u003E6.\u300A\u62A4\u7167\u9057\u5931/\u5931\u6548\u9648\u8FF0\u4E66\u300B\uFF1B\u003C/p\u003E\n\u003Cp\u003E 7. \u5982\u7533\u8BF7\u4EBA\u7CFB\u672A\u6EE116\u5468\u5C81\u672A\u6210\u5E74\u4EBA\uFF0C\u987B\u7531\u4E00\u4F4D\u6CD5\u5B9A\u76D1\u62A4\u4EBA\uFF08\u7236\u6216\u6BCD\u6216\u5176\u4ED6\u6CD5\u5B9A\u76D1\u62A4\u4EBA\uFF09\u51FA\u5177\u300A\u672A\u6210\u5E74\u4EBA\u529E\u7406\u62A4\u7167/\u65C5\u884C\u8BC1\u58F0\u660E\u4E66\u300B\uFF08\u53EF\u5728\u4E2D\u56FD\u9A7B\u9A6C\u6765\u897F\u4E9A\u5927\u4F7F\u9986\u5B98\u65B9\u7F51\u7AD9\u201C\u9996\u9875 \u0026gt; \u9886\u4E8B\u670D\u52A1 \u0026gt; \u9886\u4E8B\u8BC1\u4EF6 \u0026gt; \u62A4\u7167\u65C5\u884C\u8BC1 \u0026gt; \u8868\u683C\u4E0B\u8F7D\u201D\u4E2D\u4E0B\u8F7D\uFF09\uFF0C\u63D0\u4F9B\u6CD5\u5B9A\u76D1\u62A4\u4EBA\u672C\u4EBA\u8EAB\u4EFD\u8BC1\u660E\uFF08\u5982\u62A4\u7167\u3001\u65C5\u884C\u8BC1\uFF09\u4EE5\u53CA\u76D1\u62A4\u5173\u7CFB\u51ED\u8BC1\uFF08\u5982\u7533\u8BF7\u4EBA\u51FA\u751F\u8BC1\u660E\u3001\u8F7D\u660E\u4EB2\u5B50\u5173\u7CFB\u7684\u6237\u53E3\u7C3F\u3001\u76D1\u62A4\u5173\u7CFB\u516C\u8BC1\u4E66\u7B49\uFF09\uFF1B\u003C/p\u003E\n\u003Cp\u003E 8. \u9A6C\u6765\u897F\u4E9A\u5F53\u5730\u8B66\u65B9\u51FA\u5177\u7684\u62A5\u8B66\u5355\uFF08\u6301\u65C5\u884C\u8BC1\u51FA\u5883\u9A6C\u6765\u897F\u4E9A\u524D\u9700\u8D74\u9A6C\u79FB\u6C11\u5C40\u8865\u529E\u5165\u5883\u624B\u7EED\uFF0C\u62A5\u8B66\u5355\u7CFB\u9A6C\u79FB\u6C11\u5C40\u8981\u6C42\u6750\u6599\u4E4B\u4E00\uFF09\uFF1B\u003C/p\u003E\n\u003Cp\u003E 9. \u4F7F\u9986\u8BA4\u4E3A\u9700\u8981\u63D0\u4EA4\u7684\u5176\u4ED6\u6750\u6599\u3002\u003C/p\u003E\n\u003Cp\u003E\u56DB\u3001\u529E\u7406\u65F6\u95F4\u003C/p\u003E\n\u003Cp\u003E1. \u6B63\u5E38\u60C5\u51B5\u4E0B\uFF0C\u7533\u8BF7\u5B8C\u6210\u9884\u5BA1\u3001\u9762\u8C08\u3001\u6536\u5230\u6750\u6599\u540E\uFF0C\u666E\u901A\u4EF6\u7B2C4\u4E2A\u5DE5\u4F5C\u65E5\u53D6\u8BC1\uFF0C\u52A0\u6025\u4EF6\u7B2C3\u4E2A\u5DE5\u4F5C\u65E5\u53D6\u8BC1\uFF0C\u7279\u6025\u4EF6\u7B2C2\u4E2A\u5DE5\u4F5C\u65E5\u53D6\u8BC1\u3002\u003C/p\u003E\n\u003Cp\u003E2. \u56E0\u9700\u5411\u56FD\u5185\u6838\u67E5\u7533\u8BF7\u4EBA\u8EAB\u4EFD\u548C\u8BC1\u4EF6\u60C5\u51B5\uFF0C\u5982\u6838\u67E5\u7ED3\u679C\u672A\u80FD\u53CA\u65F6\u8FD4\u56DE\uFF0C\u529E\u8BC1\u65F6\u95F4\u53EF\u80FD\u76F8\u5E94\u5EF6\u957F\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E94\u3001\u8D39\u7528\u53CA\u4ED8\u6B3E\u65B9\u5F0F\u003C/p\u003E\n\u003Cp\u003E\uFF08\u4E00\uFF09\u666E\u901A\u4EF6\u6BCF\u4EF675\u9A6C\u5E01\uFF0C\u52A0\u6025\u4EF6\u6BCF\u4EF6175\u9A6C\u5E01\uFF0C\u7279\u6025\u4EF6\u6BCF\u4EF6215\u9A6C\u5E01\u3002\u5728APP\u529E\u7406\u65F6\u9009\u62E9\u7EBF\u4E0B\u652F\u4ED8\uFF0C\u53EF\u94F6\u884C\u8F6C\u8D26\u6216\u5230\u9986\u652F\u4ED8\u3002\u003C/p\u003E\n\u003Cp\u003E\uFF08\u4E8C\uFF09\u5982\u5230\u9986\u652F\u4ED8\uFF0C\u53EF\u901A\u8FC7\u94F6\u8054\u501F\u8BB0\u5361\u3001\u652F\u4ED8\u5B9D\u6216\u9A6C\u6765\u897F\u4E9AMyDebit\u5361\u652F\u4ED8\u3002\u003C/p\u003E\n\u003Cp\u003E\uFF08\u4E09\uFF09\u5982\u901A\u8FC7\u94F6\u884C\u8F6C\u8D26\u652F\u4ED8\uFF0C\u8BF7\u5C06\u529E\u8BC1\u8D39\u7528\u6C47\u81F3\u4E2D\u56FD\u94F6\u884C\uFF08\u9A6C\u6765\u897F\u4E9A\uFF09BANK OF CHINA\uFF08MALAYSIA\uFF09\u8D26\u6237\uFF1A\u003C/p\u003E\n\u003Cp\u003E\u8D26\u6237\u53F7\u7801ACCOUNT NUMBER\uFF1A100000400147221\u003C/p\u003E\n\u003Cp\u003E\u8D26\u6237\u540D\u79F0ACCOUNT NAME\uFF1ACHINA EMBASSY VISA FEES COLLECTION\u003C/p\u003E\n\u003Cp\u003E\u8F6C\u8D26\u65B9\u5F0FTRANSFER MODE\uFF1ADUIT NOW/INTERBANK GIRO\u003C/p\u003E\n\u003Cp\u003E\u7528\u6237\u5907\u6CE8RECIPIENT\u2019S REFERENCE\uFF1AAPP\u751F\u6210\u7684\u8BA2\u5355\u53F7\u002B\u59D3\u540D\u62FC\u97F3\u003C/p\u003E\n\u003Cp\u003E\u6E29\u99A8\u63D0\u793A\uFF1A\u8BF7\u52FF\u591A\u4ED8\u6216\u5C11\u4ED8\uFF0C\u8BF7\u52FF\u591A\u540D\u7533\u8BF7\u4EBA\u5408\u5E76\u8F6C\u8D26\u3002\u003C/p\u003E\n\u003Cp\u003E\u516D\u3001\u7D27\u6025\u4E8B\u7531\u201C\u7EFF\u8272\u901A\u9053\u201D\u529E\u7406\u65C5\u884C\u8BC1\u003C/p\u003E\n\u003Cp\u003E\u4E2D\u56FD\u9A7B\u9A6C\u6765\u897F\u4E9A\u4F7F\u9986\u4E3A\u7D27\u6025\u4EBA\u9053\u4E8B\u7531\uFF08\u5305\u62EC\u5954\u4E27\u3001\u63A2\u75C5\u3001\u5C31\u533B\u7B49\u7D27\u6025\u4E8B\u52A1\uFF0C\u4EE5\u53CA\u8001\u3001\u5F31\u3001\u75C5\u3001\u6B8B\u3001\u5B55\u7FA4\u4F53\uFF0C\u6216\u6709\u5176\u5B83\u7279\u6B8A\u56F0\u96BE\u4EBA\u7FA4\uFF09\u5F00\u901A\u65C5\u884C\u8BC1\u7533\u529E\u201C\u7EFF\u8272\u901A\u9053\u201D\uFF0C\u63D0\u4F9B\u529E\u8BC1\u4FBF\u5229\u3002\u987B\u77E5\u5982\u4E0B\uFF1A\u003C/p\u003E\n\u003Cp\u003E\uFF08\u4E00\uFF09\u901A\u8FC7\u201C\u4E2D\u56FD\u9886\u4E8B\u201DAPP\u5728\u7EBF\u63D0\u4EA4\u65C5\u884C\u8BC1\u7533\u8BF7\u8BA2\u5355\uFF1B\u003C/p\u003E\n\u003Cp\u003E\uFF08\u4E8C\uFF09\u8BA2\u5355\u6210\u529F\u63D0\u4EA4\u540E\uFF0C\u5982\u5B9E\u3001\u5B8C\u6574\u586B\u5199\u300A\u7D27\u6025\u7533\u8BF7\u65C5\u884C\u8BC1\u60C5\u51B5\u8BF4\u660E\u300B\uFF08\u53EF\u5728\u4E2D\u56FD\u9A7B\u9A6C\u6765\u897F\u4E9A\u5927\u4F7F\u9986\u5B98\u65B9\u7F51\u7AD9\u201C\u9996\u9875 \u0026gt; \u9886\u4E8B\u670D\u52A1 \u0026gt; \u9886\u4E8B\u8BC1\u4EF6 \u0026gt; \u62A4\u7167\u65C5\u884C\u8BC1 \u0026gt; \u8868\u683C\u4E0B\u8F7D\u201D\u4E2D\u4E0B\u8F7D\uFF09\uFF0C\u5C06\u300A\u8BF4\u660E\u300B\u8FDE\u540C\u76F8\u5173\u8BC1\u660E\u6750\u6599\u7535\u90AE\u53D1\u9001\u81F3kl_hz@csm.mfa.gov.cn\u3002\u90AE\u4EF6\u6807\u9898\u4E3A\u201C\u7D27\u6025\u65C5\u884C\u8BC1\u002B\u2018\u4E2D\u56FD\u9886\u4E8B\u2019APP\u8BA2\u5355\u53F7\u002B\u59D3\u540D\u201D\uFF08\u8BF7\u6CE8\u610F\uFF1A\u5982\u90AE\u4EF6\u6807\u9898\u4E0D\u7B26\u5408\u8981\u6C42\u3001\u300A\u8BF4\u660E\