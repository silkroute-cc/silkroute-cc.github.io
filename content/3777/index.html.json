  "id": "%e9%a9%ac%e5%85%ad%e7%94%b2%e7%9a%84%e5%90%8d%e8%83%9c%e5%8f%a4%e8%bf%b9",
  "slug": "%e9%a9%ac%e5%85%ad%e7%94%b2%e7%9a%84%e5%90%8d%e8%83%9c%e5%8f%a4%e8%bf%b9",
  "canonicalUrlKey": "%e9%a9%ac%e5%85%ad%e7%94%b2%e7%9a%84%e5%90%8d%e8%83%9c%e5%8f%a4%e8%bf%b9",
  "route": "/3777/",
  "title": "\u9A6C\u516D\u7532\u7684\u540D\u80DC\u53E4\u8FF9",
  "summary": "PHOTO \u8054\u5408\u56FD\u6559\u79D1\u6587\u7EC4\u7EC7\u4E16\u754C\u9057\u4EA7 \u540D\u5F55\u57CE\u5E02 \u9A6C\u6765\u897F\u4E9A \u9A6C\u516D\u7532 \u9A6C\u516D\u7532\u7684\u91CD\u8981\u6027\uFF0C\u4E0D\u8A00\u800C\u55BB\u3002 \u76F8\u4F20\u9A6C\u516D\u7532\u5F00\u56FD\u541B\u4E3B \u5DE8\u6E2F\u738B\u5B50\u62DC\u91CC\u7C73\u82CF\u62C9\uFF08Parameswara\uFF09\uFF0C \u5317\u4E0A\u884C\u81F3\u6B64\u5730\uFF0C\u5728\u6CB3\u8FB9\u4E00\u6811\u4E0B\u60CA\u89C1 \u8FFD\u9010\u9F20\u9E7F\u7684\u730E\u72AC\u53CD\u88AB\u9F20\u9E7F\u731B\u8E39\u5760\u6CB3\uFF0C \u8BA4\u4E3A\u6B64\u4E43\u7965\u745E\u4E4B\u5146\u3002 \u6545\u95EE\u9F20\u9E7F\u6240\u6816\u4E4B\u6811\u540D\uFF0C \u7B54\u66F0\u9A6C\u516D\u7532\uFF0C \u4E8E\u662F\u9A6C\u516D\u7532\u738B\u671D\u5373\u4EE5\u6B64\u6811\u4E3A\u540D\u3002 \u4E0D\u7BA1\u4F60\u662F\u5426\u76F8\u4FE1 \u8FD9\u4E2A\u5173\u4E8E\u9A6C\u516D\u7532\u738B\u671D\u5EFA\u7ACB\u7684\u4F20\u8BF4\uFF0C \u4F60\u90FD\u4E0D\u80FD\u5426\u8BA4\uFF0C\u9A6C\u516D\u7532\uFF0C \u4E00\u4E2A\u6D77\u4E0A\u5341\u5B57\u8DEF\u53E3\uFF0C \u4E00\u4E2A\u7E41\u8363\u7684\u8D38\u6613\u6E2F\u2026",
  "body": "\u003Cp\u003E PHOTO\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/05/frc-cfd0d750587c7551b0afd798c1ec75e4.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u8054\u5408\u56FD\u6559\u79D1\u6587\u7EC4\u7EC7\u4E16\u754C\u9057\u4EA7\u003C/p\u003E\n\u003Cp\u003E\u540D\u5F55\u57CE\u5E02\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u516D\u7532\n\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u516D\u7532\u7684\u91CD\u8981\u6027\uFF0C\u4E0D\u8A00\u800C\u55BB\u3002\u003C/p\u003E\n\u003Cp\u003E\u76F8\u4F20\u9A6C\u516D\u7532\u5F00\u56FD\u541B\u4E3B\u003C/p\u003E\n\u003Cp\u003E\u5DE8\u6E2F\u738B\u5B50\u62DC\u91CC\u7C73\u82CF\u62C9\uFF08Parameswara\uFF09\uFF0C\u003C/p\u003E\n\u003Cp\u003E\u5317\u4E0A\u884C\u81F3\u6B64\u5730\uFF0C\u5728\u6CB3\u8FB9\u4E00\u6811\u4E0B\u60CA\u89C1\u003C/p\u003E\n\u003Cp\u003E\u8FFD\u9010\u9F20\u9E7F\u7684\u730E\u72AC\u53CD\u88AB\u9F20\u9E7F\u731B\u8E39\u5760\u6CB3\uFF0C\u003C/p\u003E\n\u003Cp\u003E\u8BA4\u4E3A\u6B64\u4E43\u7965\u745E\u4E4B\u5146\u3002\u003C/p\u003E\n\u003Cp\u003E\u6545\u95EE\u9F20\u9E7F\u6240\u6816\u4E4B\u6811\u540D\uFF0C\u003C/p\u003E\n\u003Cp\u003E\u7B54\u66F0\u9A6C\u516D\u7532\uFF0C\u003C/p\u003E\n\u003Cp\u003E\u4E8E\u662F\u9A6C\u516D\u7532\u738B\u671D\u5373\u4EE5\u6B64\u6811\u4E3A\u540D\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E0D\u7BA1\u4F60\u662F\u5426\u76F8\u4FE1\u003C/p\u003E\n\u003Cp\u003E\u8FD9\u4E2A\u5173\u4E8E\u9A6C\u516D\u7532\u738B\u671D\u5EFA\u7ACB\u7684\u4F20\u8BF4\uFF0C\u003C/p\u003E\n\u003Cp\u003E\u4F60\u90FD\u4E0D\u80FD\u5426\u8BA4\uFF0C\u9A6C\u516D\u7532\uFF0C\u003C/p\u003E\n\u003Cp\u003E\u4E00\u4E2A\u6D77\u4E0A\u5341\u5B57\u8DEF\u53E3\uFF0C\u003C/p\u003E\n\u003Cp\u003E\u4E00\u4E2A\u7E41\u8363\u7684\u8D38\u6613\u6E2F\u53E3\uFF0C\u003C/p\u003E\n\u003Cp\u003E\u5176\u4F18\u8D8A\u7684\u5730\u7406\u4F4D\u7F6E\uFF0C\u003C/p\u003E\n\u003Cp\u003E\u5728\u8FD1\u4EE3\u5BF9\u4E8E\u6B96\u6C11\u56FD\u5BB6\u7684\u81F4\u547D\u5438\u5F15\u529B\u3002\u003C/p\u003E\n\u003Cp\u003E\u5386\u53F2\u4E0A\uFF0C\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u516D\u7532\u66FE\u5206\u5C5E\u8461\u8404\u7259\u3001\u003C/p\u003E\n\u003Cp\u003E\u8377\u5170\u548C\u82F1\u56FD\u7684\u6B96\u6C11\u5730\uFF0C\u003C/p\u003E\n\u003Cp\u003E\u6B96\u6C11\u5730\u6587\u5316\u7ED9\u9A6C\u516D\u7532\u7559\u4E0B\u4E86\u4F17\u591A\u53E4\u8001\u5EFA\u7B51\uFF0C\u003C/p\u003E\n\u003Cp\u003E\u8FD9\u4E9B\u5EFA\u7B51\u878D\u5408\u4E86\u4E2D\u897F\u65B9\u6587\u5316\u5143\u7D20\uFF0C\u003C/p\u003E\n\u003Cp\u003E\u8FD8\u6709\u6563\u843D\u5404\u5730\u4E0D\u540C\u98CE\u683C\u7684\u57CE\u5821\uFF0C\u003C/p\u003E\n\u003Cp\u003E\u518D\u52A0\u4E0A\u5F53\u5730\u7279\u6709\u7684\u7F8E\u98DF\uFF0C\u003C/p\u003E\n\u003Cp\u003E\u8FD9\u4E9B\u90FD\u503C\u5F97\u4F60\u6765\u5230\u6B64\u4E00\u6E38\u3002\u003C/p\u003E\n\u003Cp\u003E\u4EE5\u4E0B\u4E3A\u60A8\u4ECB\u7ECD\u4E00\u4E9B\u9A6C\u516D\u7532\u7684\u666F\u70B9\u3002 \u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u9A6C\u516D\u7532\u003C/strong\u003E / \u003Cstrong\u003E\u9E21\u573A\u8857\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EJonker Street\u003C/strong\u003E\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/05/frc-1204724a3d3d6c32851b471b465e96e3.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u8FD9\u6761\u8457\u540D\u7684\u8857\u9053\u4E24\u65C1\u6797\u7ACB\u7740\u8BB8\u591A\u7ED3\u5408\u4E2D\u5F0F\u5357\u6D0B\u5EFA\u7B51\u98CE\u683C\u7684\u4F20\u7EDF\u53E4\u697C\uFF0C\u8FD9\u4E9B\u53E4\u697C\u6700\u65E9\u53EF\u8FFD\u6EAF\u523017\u4E16\u7EAA\u3002\u8FD9\u91CC\u7ED3\u96C6\u4E86\u53E4\u8463\u5E97\u3001\u624B\u5DE5\u827A\u54C1\u548C\u7EAA\u5FF5\u54C1\u5546\u5E97\u3001\u7F8E\u672F\u9986\uFF0C\u8FD8\u6709\u5404\u79CD\u5730\u9053\u7F8E\u98DF\u5C0F\u5403\u5E97\u3002\u8FD9\u91CC\u7684\u4E00\u5207\u90FD\u5411\u6211\u4EEC\u8FF0\u8BF4\u7740\u5CC7\u5CC7\u5A18\u60F9\u4E0A\u767E\u5E74\u7684\u5386\u53F2\uFF0C\u4ED6\u4EEC\u66FE\u7ECF\u5982\u4F55\u5728\u8FD9\u7247\u6B96\u6C11\u5730\u751F\u6D3B\u5DE5\u4F5C\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/05/frc-2c71cf09dc6e7f1d543ca6420878906f.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cem\u003E\u56FE\u7247\u6765\u6E90\uFF1Arina_sorparno / IG\u003C/em\u003E\u003C/p\u003E\n\u003Cp\u003E\u6BCF\u9022\u5468\u4E94\u81F3\u5468\u65E5\uFF0C\u4E00\u8FDE\u4E09\u5929\u508D\u665A\u8D77\u81F3\u51CC\u6668\uFF0C\u8FD9\u91CC\u8FD8\u4F1A\u6709\u70ED\u95F9\u7684\u591C\u5E02\uFF0C\u53EF\u4EE5\u4E70\u5230\u5404\u79CD\u5730\u9053\u7F8E\u98DF\u3001\u7CBE\u7F8E\u624B\u5DE5\u827A\u54C1\u3001\u95FB\u540D\u571F\u4EA7\u7B49\uFF0C\u751A\u81F3\u8FD8\u53EF\u4EE5\u5728\u795E\u7B97\u5B50\u524D\u5750\u4E00\u5750\uFF0C\u542C\u542C\u5173\u4E8E\u81EA\u5DF1\u672A\u6765\u7684\u6545\u4E8B\u3002 \u003C/p\u003E\n\u003Cp\u003E\u9A6C\u516D\u7532 / \u9A6C\u516D\u7532\u6CB3\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EMalacca River\u003C/strong\u003E\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/05/frc-52aa15b43209ad92f302b23018f361fc.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u6CDB\u821F\u9068\u6E38\u9A6C\u516D\u7532\u6CB3\uFF0C\u4E00\u8DEF\u4F1A\u7ECF\u8FC7\u5386\u53F2\u5EFA\u7B51\u3001\u65E7\u4ED3\u5E93\u3001\u5C45\u6C11\u533A\u548C\u65B0\u5F0F\u5EFA\u7B51\uFF0C\u5728\u8FD9\u4E9B\u5EFA\u7B51\u7269\u5916\u5899\u4F1A\u7ED8\u6709\u4F17\u591A\u6709\u8DA3\u7684\u58C1\u753B\uFF0C\u4EFF\u4F5B\u5728\u4E3A\u60A8\u89E3\u8BF4\u8FD9\u4E2A\u57CE\u5E02\u4E30\u539A\u7684\u6587\u5316\u5E95\u8574\u3002\u6E38\u8239\u7684\u6700\u4F73\u65F6\u95F4\u662F\u9EC4\u660F\uFF0C\u56E0\u4E3A\u8FD9\u4E2A\u65F6\u95F4\u6BB5\u767D\u5929\u7684\u9AD8\u6E29\u5DF2\u9000\uFF0C\u5CB8\u8FB9\u4E5F\u4EAE\u8D77\u4E86\u4E07\u5BB6\u706F\u706B\u3002 \u003C/p\u003E\n\u003Cp\u003E\u9A6C\u516D\u7532 / \u8377\u5170\u7EA2\u5C4B\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EThe Stadthuys\u003C/strong\u003E\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/05/frc-52ce11a44042c134512770d1c9f92be0.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u8377\u5170\u7EA2\u5C4B\u662F\u8377\u5170\u6B96\u6C11\u5730\u65F6\u671F\u6240\u9057\u7559\u81F3\u4ECA\u7684\u7EA2\u8272\u5EFA\u7B51\u7269\uFF0C\u5B83\u66FE\u7ECF\u662F\u653F\u5E9C\u673A\u5173\u6240\u5728\u5730\u3002\u4F4D\u4E8E\u9A6C\u516D\u7532\u5E02\u7684\u4E2D\u5FC3\u5730\u5E26\uFF0C\u5B83\u7684\u7EA2\u8272\u7816\u5899\u548C\u90BB\u8FD1\u7684\u7EA2\u8272\u949F\u697C\u65E0\u7591\u7ED9\u5F88\u591A\u6E38\u5BA2\u7559\u4E0B\u4E86\u76F8\u5F53\u6DF1\u523B\u7684\u5370\u8C61\u3002\u73B0\u5982\u4ECA\uFF0C\u5B83\u5DF2\u6539\u4E3A\u9A6C\u516D\u7532\u535A\u7269\u9986\uFF0C\u60F3\u8981\u6DF1\u5165\u4E86\u89E3\u9A6C\u516D\u7532\u7684\u5386\u53F2\uFF0C\u5305\u62EC\u4E86\u89E3\u4F1F\u5927\u7684\u9A6C\u6765\u82CF\u4E39\u56FD\u548C\u6B96\u6C11\u5730\u56FD\u5BB6\u7684\u5386\u53F2\u6587\u7269\uFF0C\u9A6C\u516D\u7532\u535A\u7269\u9986\u662F\u4F60\u4E0D\u5BB9\u9519\u8FC7\u7684\u6253\u5361\u5730\u3002 \u003C/p\u003E\n\u003Cp\u003E\u9A6C\u516D\u7532 / \u5CC7\u5CC7\u5A18\u60F9\u4F4F\u5C4B\u535A\u7269\u9986 \u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EBaba \u0026amp; Nyonya Heritage Museum\u003C/strong\u003E\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/05/frc-4062f905984000fcbff8b18efd7a16ef.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cem\u003E\u56FE\u7247\u6765\u6E90\uFF1Ababanyonyamuseum / IG\u003C/em\u003E\u003C/p\u003E\n\u003Cp\u003E\u8FD9\u5EA7\u535A\u7269\u9986\u88AB\u5E03\u7F6E\u6210\u4E00\u5EA7\u5178\u578B\u7684\u771F\u5B9E\u768419\u4E16\u7EAA\u5CC7\u5CC7\u5A18\u60F9\u201C\u5927\u9662\u201D\uFF0C\u9986\u5185\u9648\u5217\u7740\u7CBE\u81F4\u7684\u6728\u5236\u54C1\u3001\u53E4\u8463\u5BB6\u5177\u548C\u74F7\u5668\u54C1\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/05/frc-8312981ab64db45dfd2eb77e2ff2ecd7.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cem\u003E\u56FE\u7247\u6765\u6E90\uFF1A landscapesbycil / IG\u003C/em\u003E\u003C/p\u003E\n\u003Cp\u003E\u5728\u8FD9\u91CC\uFF0C\u6E38\u5BA2\u53EF\u4EE5\u5BF9\u571F\u751F\u534E\u4EBA\u6587\u5316\u6709\u4E2A\u66F4\u5168\u9762\u7684\u8BA4\u8BC6\u3002\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u516D\u7532 / \u683C\u52D2\u90A6\u6D77\u6EE9\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EKlebang Beach\u003C/strong\u003E\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/05/frc-1908bf6c83d7ce8f4242fbfc79bdcf4d.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u683C\u52D2\u90A6\u6D77\u6EE9\uFF08Klebang Beach\uFF09\u9644\u8FD1\u7684\u5DE8\u5927\u6C99\u4E18\uFF0C\u662F\u4E13\u4E1A\u548C\u4E1A\u4F59\u6444\u5F71\u7231\u597D\u8005\u7684\u70ED\u95E8\u6253\u5361\u5730\u3002\u6ED1\u6C99\u7231\u597D\u8005\u53EF\u5728\u8FD9\u91CC\u4F53\u9A8C\u6ED1\u6C99\u7684\u523A\u6FC0\u4E0E\u4E50\u8DA3\u3002 \u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/05/frc-2183dca80538d0b6c1e956fba95bbb6f.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u66F4\u591A\u8D44\u8BAF\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u56FD\u5BB6\u65C5\u6E38\u5C40\u5B98\u65B9\u7F51\u7AD9\uFF1A\u003C/p\u003E\n\u003Cp\u003Ewww.malaysia.travel\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u56FD\u5BB6\u65C5\u6E38\u5C40\u5B98\u65B9\u5FAE\u535A\uFF1A\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38\u5C40\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u56FD\u5BB6\u65C5\u6E38\u5C40\u5B98\u65B9\u5FAE\u4FE1\u516C\u4F17\u53F7\uFF1A\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38\u5C40\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/yy5mBYJKt2nsxwlvxqaLbg\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
