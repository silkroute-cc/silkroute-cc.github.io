  "route": "/4932/",
  "title": "\u5C06\u5BFB\u6C42\u4E2D\u56FD\u516C\u53F8\u52A0\u5DE5 \u9A6C\u6765\u897F\u4E9A\u5409\u5170\u4E39\u653F\u5E9C\u52A0\u901F\u52D8\u63A2\u7A00\u571F",
  "summary": "\uFF08\u54E5\u6253\u5CC7\u9C819\u65E5\u8BAF\uFF09\u5409\u5170\u4E39\u5DDE\u653F\u5E9C\u5C06\u52A0\u901F\u975E\u653E\u5C04\u6027\u7A00\u571F\u5143\u7D20\uFF08NR-REE\uFF09\u7684\u52D8\u63A2\uFF0C\u4EE5\u4FBF\u5728\u4E39\u5DDE\u52A0\u5DE5\u8FD9\u4E9B\u539F\u6750\u6599\uFF0C\u4E3A\u8BE5\u5DDE\u5E26\u6765\u7ECF\u6D4E\u6536\u76CA\u3002 \u4E39\u5DDE\u526F\u5DDE\u52A1\u5927\u81E3\u62FF\u7763\u83AB\u54C8\u672B\u6CD5\u5179\u91CC\u6307\u51FA\uFF0C\u6765\u81EA\u4E2D\u56FD\u7684\u6570\u5BB6\u516C\u53F8\u5DF2\u8868\u793A\u5BF9\u52A0\u5DE5NR-REE\u6709\u5174\u8DA3\u3002 \u4ED6\u6628\u65E5\u5728\u201C2024\u6218\u7565\u77FF\u4EA7\u7814\u8BA8\u4F1A - \u7A00\u571F\u5143\u7D20\u201D\u4EEA\u5F0F\u4E0A\uFF0C\u8FD9\u4E48\u8BB2\u3002 \u4ED6\u8BF4\uFF0C\u4E39\u5DDE\u653F\u5E9C\u5E0C\u671B\u5728\u5409\u5170\u4E39\u52A0\u5DE5NR-REE\uFF0C\u4EE5\u83B7\u5F97\u6BD4\u5728\u4E2D\u56FD\u52A0\u5DE5\u66F4\u9AD8\u7684\u5229\u6DA6\uFF0C\u653F\u5E9C\u5C06\u4E0E\u4E2D\u56FD\u516C\u53F8\u9488\u5BF9\u6B64\u4E8B\u9879\u8FDB\u884C\u8BA8\u8BBA\u3002 \u201C\u4F17\u6240\u5468\u77E5\uFF0C\u5409\u5170\u4E39\u5DF2\u83B7\u5F97\u8054\u90A6\u653F\u5E9C\u7684\u8BB8\u53EF\u52D8\u63A2 NR-REE\uFF0C\u4F46\u5B83\u9700\u8981\u6307\u2026",
  "body": "\u003Cp\u003E\uFF08\u54E5\u6253\u5CC7\u9C819\u65E5\u8BAF\uFF09\u5409\u5170\u4E39\u5DDE\u653F\u5E9C\u5C06\u52A0\u901F\u975E\u653E\u5C04\u6027\u7A00\u571F\u5143\u7D20\uFF08NR-REE\uFF09\u7684\u52D8\u63A2\uFF0C\u4EE5\u4FBF\u5728\u4E39\u5DDE\u52A0\u5DE5\u8FD9\u4E9B\u539F\u6750\u6599\uFF0C\u4E3A\u8BE5\u5DDE\u5E26\u6765\u7ECF\u6D4E\u6536\u76CA\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E39\u5DDE\u526F\u5DDE\u52A1\u5927\u81E3\u62FF\u7763\u83AB\u54C8\u672B\u6CD5\u5179\u91CC\u6307\u51FA\uFF0C\u6765\u81EA\u4E2D\u56FD\u7684\u6570\u5BB6\u516C\u53F8\u5DF2\u8868\u793A\u5BF9\u52A0\u5DE5NR-REE\u6709\u5174\u8DA3\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6628\u65E5\u5728\u201C2024\u6218\u7565\u77FF\u4EA7\u7814\u8BA8\u4F1A - \u7A00\u571F\u5143\u7D20\u201D\u4EEA\u5F0F\u4E0A\uFF0C\u8FD9\u4E48\u8BB2\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u4E39\u5DDE\u653F\u5E9C\u5E0C\u671B\u5728\u5409\u5170\u4E39\u52A0\u5DE5NR-REE\uFF0C\u4EE5\u83B7\u5F97\u6BD4\u5728\u4E2D\u56FD\u52A0\u5DE5\u66F4\u9AD8\u7684\u5229\u6DA6\uFF0C\u653F\u5E9C\u5C06\u4E0E\u4E2D\u56FD\u516C\u53F8\u9488\u5BF9\u6B64\u4E8B\u9879\u8FDB\u884C\u8BA8\u8BBA\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u4F17\u6240\u5468\u77E5\uFF0C\u5409\u5170\u4E39\u5DF2\u83B7\u5F97\u8054\u90A6\u653F\u5E9C\u7684\u8BB8\u53EF\u52D8\u63A2 NR-REE\uFF0C\u4F46\u5B83\u9700\u8981\u6307\u5BFC\u65B9\u9488\u548C\u6807\u51C6\u64CD\u4F5C\u7A0B\u5E8F\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u83AB\u54C8\u672B\u6CD5\u5179\u91CC\u5BA3\u79F0\uFF0C\u5409\u5170\u4E39\u662F\u7A00\u571F\u5143\u7D20\u50A8\u91CF\u7B2C\u4E8C\u4E30\u5BCC\u7684\u5DDE\u5C5E\uFF0C\u4F30\u8BA1\u4EF7\u503C1250\u4EBF\u4EE4\u5409\uFF0C\u800C\u5168\u56FD\u7A00\u571F\u5143\u7D20\u50A8\u91CF\u5219\u8D85\u8FC77000\u4EBF\u4EE4\u5409\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u5C3D\u7BA1\u8054\u90A6\u653F\u5E9C\u5C1A\u672A\u5141\u8BB8\u7A00\u571F\u5143\u7D20\u51FA\u53E3\uFF0C\u4F46\u9664\u4E86\u5728 Mukim Kenering \u5F00\u5C55\u7684\u8BD5\u70B9\u9879\u76EE\u5916\uFF0C\u4E39\u5DDE\u5E0C\u671B\u8FD9\u4E2A\u95EE\u9898\u80FD\u591F\u5F97\u5230\u89E3\u51B3\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u4EEC\u5C06\u52AA\u529B\u5BFB\u627E\u6700\u597D\u7684\u524D\u8FDB\u65B9\u5411\uFF0C\u56E0\u4E3A\u6211\u4EEC\uFF08\u5409\u5170\u4E39\uFF09\u4E0D\u53EF\u8D85\u8D8A\u8054\u90A6\u653F\u5E9C\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/n3p83YVs6_REl1UgA3y8qw\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
