81\u706B\u8F66\u7AD9\u3002\u8BE5\u8F66\u7AD9\u7531\u82F1\u56FD\u5EFA\u7B51\u5E08\u963F\u745F\u0026#183;\u8D1D\u5C3C\u68EE\u0026#183;\u514B\u535A\uFF08Arthur Benison Hubback\uFF09\u8BBE\u8BA1\uFF0C\u6DF1\u53D7\u6469\u5C14\u5F0F\u3001\u83AB\u5367\u513F\u5F0F\u3001\u5370\u5EA6-\u6492\u62C9\u900A\u548C\u6492\u62C9\u900A\u590D\u5174\u5EFA\u7B51\u98CE\u683C\u7684\u5F71\u54CD\uFF0C\u878D\u5408\u4E86\u5F53\u65F6\u6D41\u884C\u7684\u4E1C\u897F\u65B9\u8BBE\u8BA1\u98CE\u683C\u3002 \u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5929\u540E\u5BAB\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003EThean Hou Temple\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/06/frc-14fcdc02c5255379c3cd81c84602e4a1.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5929\u540E\u5BAB\u4F4D\u4E8E\u5409\u9686\u5761\u4E00\u5EA7\u9AD8\u5C71\u4E0A\uFF0C\u662F\u8BB0\u5F55\u57CE\u5E02\u5168\u666F\u7684\u6700\u4F73\u62CD\u6444\u70B9\u3002\u8FD9\u5EA7\u5E99\u5B87\u4E3B\u796D\u5929\u540E\u5988\u7956\uFF0C\u5988\u7956\u636E\u8BF4\u662F\u5B88\u62A4\u6E14\u6C11\u548C\u6C34\u624B\u7684\u4E2D\u56FD\u6D77\u795E\u3002\u5929\u540E\u5BAB\u7531\u9A6C\u6765\u897F\u4E9A\u96EA\u9686\u6D77\u5357\u4F1A\u9986\u4E8E20\u4E16\u7EAA\u672B\u7B79\u5EFA\uFF0C\u5E76\u4E8E1989\u5E74\u6B63\u5F0F\u5F00\u5E55\u542F\u7528\u3002\u516D\u5C42\u9AD8\u7684\u5E99\u5B87\u5165\u53E3\u7531\u591A\u4E2A\u62F1\u95E8\u7EC4\u6210\uFF0C\u5927\u6BBF\u91CC\u968F\u5904\u53EF\u4EE5\u89C1\u5404\u79CD\u590D\u6742\u548C\u534E\u4E3D\u7684\u96D5\u523B\u3002\u5728\u4E2D\u56FD\u6587\u5316\u4E2D\uFF0C\u7EA2\u8272\u8C61\u5F81\u7740\u597D\u8FD0\u548C\u7E41\u8363\uFF0C\u5BF9\u6211\u4EEC\u6709\u975E\u51E1\u7684\u610F\u4E49\u3002\u5E99\u5B87\u5185\u9664\u4E86\u5927\u6BBF\uFF0C\u5EAD\u9662\u548C\u5404\u79CD\u96D5\u50CF\u5916\uFF0C\u8FD8\u53EF\u89C1\u6709\u55B7\u6CC9\uFF0C\u82B1\u56ED\u548C\u9F9F\u6C60\u7B49\u4E2D\u56FD\u4F20\u7EDF\u5BFA\u5E99\u5E38\u89C1\u7684\u573A\u666F\u3002\n\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u82CF\u4E39\