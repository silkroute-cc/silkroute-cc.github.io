{
  "id": "%e5%a9%86%e7%bd%97%e6%b4%b2%e4%bc%8a%e7%94%b8%e5%9b%ad%e7%a7%98%e5%a2%83%ef%bc%9a%e6%8e%a2%e7%b4%a2%e7%a0%82%e6%8b%89%e8%b6%8a%e5%9b%bd%e5%ae%b6%e5%85%ac%e5%9b%ad%e7%9a%84%e5%a5%87%e7%8f%8d%e5%bc%82",
  "slug": "%e5%a9%86%e7%bd%97%e6%b4%b2%e4%bc%8a%e7%94%b8%e5%9b%ad%e7%a7%98%e5%a2%83%ef%bc%9a%e6%8e%a2%e7%b4%a2%e7%a0%82%e6%8b%89%e8%b6%8a%e5%9b%bd%e5%ae%b6%e5%85%ac%e5%9b%ad%e7%9a%84%e5%a5%87%e7%8f%8d%e5%bc%82",
  "canonicalUrlKey": "%e5%a9%86%e7%bd%97%e6%b4%b2%e4%bc%8a%e7%94%b8%e5%9b%ad%e7%a7%98%e5%a2%83%ef%bc%9a%e6%8e%a2%e7%b4%a2%e7%a0%82%e6%8b%89%e8%b6%8a%e5%9b%bd%e5%ae%b6%e5%85%ac%e5%9b%ad%e7%9a%84%e5%a5%87%e7%8f%8d%e5%bc%82",
  "route": "/4328/",
  "title": "\u5A46\u7F57\u6D32\u4F0A\u7538\u56ED\u79D8\u5883\uFF1A\u63A2\u7D22\u7802\u62C9\u8D8A\u56FD\u5BB6\u516C\u56ED\u7684\u5947\u73CD\u5F02\u5B9D",
  "summary": "\u5728\u5A46\u7F57\u6D32\u8471\u830F\u84CA\u90C1\u7684\u5FC3\u810F\u5730\u5E26\u6DF1\u5904\u9690\u85CF\u7740\u4E00\u5904\u7EDD\u7F8E\u7684\u5927\u81EA\u7136\u79D8\u5883\u3002\u4E00\u4E2A\u53C8\u4E00\u4E2A\u8D85\u4E4E\u60F3\u8C61\u7684\u56FD\u5BB6\u516C\u56ED\u88AB\u8A89\u4E3A\u7802\u62C9\u8D8A\u6700\u8000\u773C\u7684\u5B9D\u77F3\uFF0C\u8FDB\u800C\u5438\u5F15\u65E0\u6570\u7684\u6E38\u5BA2\u548C\u65E0\u754F\u7684\u63A2\u9669\u8005\u524D\u6765\u8FD9\u7247\u88AB\u5927\u81EA\u7136\u7EFF\u610F\u7B3C\u7F69\u7684\u56FD\u5EA6\u5BFB\u5E7D\u63A2\u79D8\u3002 \u53E4\u8001\u7684\u70ED\u5E26\u96E8\u6797\u662F\u5E9E\u5927\u751F\u7269\u591A\u6837\u6027\u7684\u5B88\u62A4\u795E\uFF0C\u9AD8\u8038\u5165\u4E91\u7684\u6811\u51A0\u5728\u4E1B\u6797\u95F4\u5A46\u5A11\u8D77\u821E\uFF0C\u4EFF\u4F5B\u4E00\u904D\u904D\u56DE\u8361\u7740\u751F\u547D\u7684\u4EA4\u54CD\u4E50\u7AE0\u3002 \u5982\u540C\u94F6\u8272\u6DB2\u4F53\u822C\u7684\u6CB3\u6D41\u873F\u8712\u7A7F\u8FC7\u68EE\u6797\uFF0C\u518D\u6D41\u5411\u6C14\u52BF\u78C5\u7934\u7684\u7011\u5E03\u548C\u7EFF\u836B\u904D\u91CE\u7684\u9759\u8C27\u5927\u5730\u3002 \u5386\u7ECF\u5C81\u6708\u6D17\u793C\u7684\u53E4\u8001\u6D1E\u7A74\u5DCD\u5CE8\u58EE\u89C2\uFF0C\u6BCF\u4E00\u5904\u72B9\u5982\u5728\u4F4E\u8BED\u8FF0\u8BF4\u7740\u8FD9\u7247\u571F\u5730\u5386\u53F2\u60A0\u8FDC\u7684\u4F20\u8BF4\u548C\u5927\u81EA\u7136\u7684\u5965\u79D8\u3002 \u5CC7\u2026",
  "body": "\u003Cp\u003E\u5728\u5A46\u7F57\u6D32\u8471\u830F\u84CA\u90C1\u7684\u5FC3\u810F\u5730\u5E26\u6DF1\u5904\u9690\u85CF\u7740\u4E00\u5904\u7EDD\u7F8E\u7684\u5927\u81EA\u7136\u79D8\u5883\u3002\u4E00\u4E2A\u53C8\u4E00\u4E2A\u8D85\u4E4E\u60F3\u8C61\u7684\u56FD\u5BB6\u516C\u56ED\u88AB\u8A89\u4E3A\u7802\u62C9\u8D8A\u6700\u8000\u773C\u7684\u5B9D\u77F3\uFF0C\u8FDB\u800C\u5438\u5F15\u65E0\u6570\u7684\u6E38\u5BA2\u548C\u65E0\u754F\u7684\u63A2\u9669\u8005\u524D\u6765\u8FD9\u7247\u88AB\u5927\u81EA\u7136\u7EFF\u610F\u7B3C\u7F69\u7684\u56FD\u5EA6\u5BFB\u5E7D\u63A2\u79D8\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/01/frc-2772721fe7b1aa79d5c3c07a76dfd242.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u53E4\u8001\u7684\u70ED\u5E26\u96E8\u6797\u662F\u5E9E\u5927\u751F\u7269\u591A\u6837\u6027\u7684\u5B88\u62A4\u795E\uFF0C\u9AD8\u8038\u5165\u4E91\u7684\u6811\u51A0\u5728\u4E1B\u6797\u95F4\u5A46\u5A11\u8D77\u821E\uFF0C\u4EFF\u4F5B\u4E00\u904D\u904D\u56DE\u8361\u7740\u751F\u547D\u7684\u4EA4\u54CD\u4E50\u7AE0\u3002\u5982\u540C\u94F6\u8272\u6DB2\u4F53\u822C\u7684\u6CB3\u6D41\u873F\u8712\u7A7F\u8FC7\u68EE\u6797\uFF0C\u518D\u6D41\u5411\u6C14\u52BF\u78C5\u7934\u7684\u7011\u5E03\u548C\u7EFF\u836B\u904D\u91CE\u7684\u9759\u8C27\u5927\u5730\u3002\u5386\u7ECF\u5C81\u6708\u6D17\u793C\u7684\u53E4\u8001\u6D1E\u7A74\u5DCD\u5CE8\u58EE\u89C2\uFF0C\u6BCF\u4E00\u5904\u72B9\u5982\u5728\u4F4E\u8BED\u8FF0\u8BF4\u7740\u8FD9\u7247\u571F\u5730\u5386\u53F2\u60A0\u8FDC\u7684\u4F20\u8BF4\u548C\u5927\u81EA\u7136\u7684\u5965\u79D8\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cem\u003E\u003Cstrong\u003E\u5CC7\u54E5\u56FD\u5BB6\u516C\u56ED\uFF1A\u5A46\u7F57\u6D32\u6D77\u5CB8\u4E0A\u7684\u91CE\u751F\u52A8\u7269\u4E50\u571F\u003C/strong\u003E\u003C/em\u003E\u003C/p\u003E\n\u003Cp\u003E\u5CC7\u54E5\u56FD\u5BB6\u516C\u56ED (Bako National Park)\u4F4D\u4E8E\u5A46\u7F57\u6D32\u897F\u5317\u65B9\u7684\u6D77\u5CB8\u533A\uFF0C\u8DDD\u79BB\u53E4\u664B\u5E02\u533A\u4EE5\u5317\u4EC537\u516C\u91CC\u3002\u8981\u662F\u5E78\u8FD0\u7684\u8BDD\uFF0C\u5F53\u60A8\u6765\u5230\u8FD9\u91CC\u65F6\u6216\u6709\u673A\u4F1A\u6355\u6349\u5230\u7F55\u89C1\u957F\u9F3B\u7334\u7684\u8E2A\u5F71\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/01/frc-e79801ae9bdcd7ced7f85aa8318bb8b7.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u8FD9\u79CD\u72EC\u7279\u7684\u7075\u957F\u7C7B\u52A8\u7269\u4E3B\u8981\u7684\u7279\u5F81\u5C31\u662F\u5B83\u90A3\u53C8\u5927\u53C8\u957F\u7684\u201C\u9F3B\u5B50\u201D\u3002\u5145\u6EE1\u539F\u59CB\u6C14\u606F\u7684\u516C\u56ED\u4E0D\u65F6\u53EF\u89C1\u9017\u8DA3\u7684\u957F\u5C3E\u7315\u7334\u5728\u6811\u51A0\u4E0A\u60A0\u8361\u5B09\u620F\uFF1B\u987B\u732A\u5728\u704C\u6728\u4E1B\u4E2D\u89C5\u98DF\uFF1B\u8FD8\u6709\u76D8\u65CB\u5728\u9634\u6697\u5904\u7684\u876E\u86C7\u90FD\u4E3A\u516C\u56ED\u589E\u6DFB\u4E86\u51E0\u5206\u795E\u79D8\u4E0E\u5947\u5E7B\u7684\u6C1B\u56F4\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/01/frc-68b484344134529d3704b7bd5b32688d.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u7136\u800C\uFF0C\u8471\u7EFF\u7684\u5927\u81EA\u7136\u666F\u89C2\u4EC5\u662F\u5CC7\u54E5\u7684\u51B0\u5C71\u4E00\u89D2\u3002\u8FD9\u91CC\u503C\u5F97\u4E00\u63A2\u7684\u8FD8\u6709\u8BB8\u591A\u666F\u8272\u65D6\u65CE\u7684\u539F\u59CB\u6C99\u6EE9\uFF0C\u53EF\u4EE5\u8239\u53EA\u4EE3\u6B65\u6216\u5F92\u6B65\u524D\u884C\u3002\u5F53\u4E2D\u6700\u5177\u4EE3\u8868\u6027\u7684\u6D77\u4E0A\u5947\u666F\u5C31\u662F\u5E38\u5E74\u7ECF\u6D77\u6C34\u4FB5\u8680\u4E0E\u98CE\u5316\u7684\u201C\u6D77\u8680\u67F1\u201D(Sea-Stack)\uFF0C\u5916\u5F62\u9177\u4F3C\u773C\u955C\u86C7\u5934\u7684\u5CA9\u77F3\u5B9B\u5982\u54E8\u5175\u4E00\u6837\u5728\u5927\u6D77\u4E2D\u5C79\u7ACB\u4E0D\u5012\u5730\u575A\u5B88\u6D77\u6D0B\u7684\u79D8\u5BC6\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/01/frc-8f296d945fedd4df60dc1e72294f220b.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5F53\u60A8\u8FDB\u4E00\u6B65\u63A2\u7D22\u5CC7\u54E5\u65F6\uFF0C\u60A8\u5FC5\u4F1A\u88AB\u56ED\u5185\u7EDA\u4E3D\u591A\u5F69\u7684\u73CD\u5947\u690D\u7269\u6240\u6298\u670D\u3002\u5404\u79CD\u8089\u98DF\u6027\u690D\u7269\uFF0C\u5982\u56E0\u5F62\u72B6\u50CF\u732A\u7B3C\u800C\u5F97\u540D\u7684\u732A\u7B3C\u8349\u3001\u817A\u6BDB\u53EF\u5206\u6CCC\u7C98\u6DB2\u7684\u8305\u818F\u83DC\u53CA\u53EF\u8FC5\u731B\u800C\u7CBE\u51C6\u6355\u6349\u730E\u7269\u7684\u72F8\u85FB\u4E0D\u4F46\u5145\u5206\u4F53\u73B0\u5927\u81EA\u7136\u7684\u795E\u5947\uFF0C\u4E5F\u5F70\u663E\u4E86\u56ED\u5185\u751F\u6001\u7684\u4E30\u5BCC\u591A\u5143\u3002\u003C/p\u003E\n\u003Cp\u003E\u5CC7\u54E5\u56ED\u5185\u5171\u8BBE\u670918\u6761\u5177\u6709\u5F69\u8272\u6807\u8BC6\u7684\u4E1B\u6797\u5C0F\u5F84\uFF0C\u662F\u5F92\u6B65\u7231\u597D\u8005\u5FC5\u8BBF\u7684\u666F\u70B9\u3002\u5404\u5177\u7279\u8272\u7684\u6B65\u9053\u96BE\u5EA6\u4E0D\u4E00\uFF0C\u767B\u5C71\u63A2\u9669\u8005\u53EF\u6309\u559C\u597D\u9009\u62E9\u8DEF\u7EBF\uFF0C\u5168\u7136\u6C89\u6D78\u4E8E\u5CC7\u54E5\u65E0\u4E0E\u4F26\u6BD4\u7684\u539F\u91CE\u98CE\u5149\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cem\u003E\u003Cstrong\u003E\u5B9E\u8499\u53E4\u91CE\u751F\u52A8\u7269\u4FDD\u80B2\u4E2D\u5FC3\uFF1A\u4E0E\u5A46\u7F57\u6D32\u4EBA\u733F\u505A\u8FD1\u8DDD\u79BB\u63A5\u89E6\u003C/strong\u003E\u003C/em\u003E\n\u003C/p\u003E\n\u003Cp\u003E\u4F4D\u4E8E\u53E4\u664B\u5357\u5E02\u4EC520\u516C\u91CC\u5904\uFF0C\u5B9E\u8499\u53E4\u91CE\u751F\u52A8\u7269\u4FDD\u80B2\u4E2D\u5FC3 (Semenggoh Wildlife Centre)\u591A\u5E74\u6765\u4E0D\u9057\u4F59\u529B\u7684\u5B88\u62A4\u5927\u81EA\u7136\u73CD\u5B9D\u3002\u8BE5\u4E2D\u5FC3\u5EFA\u4E8E1920\u5E74\uFF0C\u5B83\u662F\u7802\u62C9\u8D8A\u53F2\u4E0A\u9996\u4E2A\u68EE\u6797\u4FDD\u62A4\u533A\uFF0C\u4F46\u8FD1\u5E74\u5DF2\u9010\u6E10\u53D1\u5C55\u6210\u591A\u5143\u5316\u7684\u6816\u606F\u5730\u4EE5\u4FDD\u62A4\u5404\u79CD\u91CE\u751F\u52A8\u690D\u7269\u7684\u591A\u6837\u6027\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/01/frc-1b6dfc2b57be5cadcaf6f8103bc10675.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5B9E\u8499\u53E4\u6700\u53D7\u77A9\u76EE\u7684\u201C\u5C45\u6C11\u201D\u5F53\u7136\u5C31\u662F\u4E00\u7FA4\u534A\u91CE\u751F\u7684\u4EBA\u733F\u3002\u7ECF\u4E13\u4EBA\u6089\u5FC3\u7167\u6599\u5E76\u8BAD\u7EC3\u6709\u7D20\u7684\u4EBA\u733F\u5DF2\u61C2\u5F97\u4E0E\u4EBA\u7C7B\u63A5\u89E6\uFF0C\u800C\u4E14\u8FD8\u5B66\u4F1A\u5728\u5582\u98DF\u65F6\u95F4\u8FA8\u522B\u51FA\u68EE\u6797\u4FDD\u62A4\u533A\u7684\u9972\u517B\u5458\u3002\u4EBA\u733F\u4E0E\u4EBA\u7C7B\u7684\u7D27\u5BC6\u76F8\u4F9D\u4E5F\u56E0\u800C\u8BA9\u5230\u8BBF\u7684\u6E38\u5BA2\u6709\u673A\u4F1A\u4E0E\u8FD9\u4E9B\u7075\u957F\u7C7B\u52A8\u7269\u6765\u573A\u8FD1\u8DDD\u79BB\u63A5\u89E6\u3002\u003C/p\u003E\n\u003Cp\u003E\u4F5C\u4E3A\u4FDD\u80B2\u4EBA\u733F\u7684\u5148\u950B\uFF0C\u5B9E\u8499\u53E4\u91CE\u751F\u52A8\u7269\u4FDD\u80B2\u4E2D\u5FC3\u66F4\u63A8\u51FA\u4E86\u4EBA\u733F\u9886\u517B\u8BA1\u5212\uFF0C\u9886\u517B\u4E00\u53EA\u7329\u7329\u6BCF\u5E74\u53EA\u9700200\u4EE4\u5409\uFF08\u7EA6300\u4EBA\u6C11\u5E01\uFF09\uFF1B\u6BCF\u5BB6\u4F01\u4E1A\u516C\u53F8\u9886\u517B\u4E00\u53EA\u7329\u7329\u4E3A\u6BCF\u5E741\u4E07\u4EE4\u5409\uFF08\u7EA61\u4E075\u5343\u4EBA\u6C11\u5E01\uFF09\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/01/frc-cc36784e3aa0fe3e33c89ea2cc1125dc.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u6BCF\u540D\u9886\u517B\u8005\u5C06\u901A\u8FC7\u7535\u5B50\u90AE\u4EF6\u83B7\u5F97\u9886\u517B\u8BC1\u4E66\u3002\u900F\u8FC7\u4EBA\u733F\u9886\u517B\u8BA1\u5212\u6240\u5F97\u5230\u7684\u8D44\u91D1\u5C06\u5168\u6570\u7528\u5728\u4EBA\u733F\u4FDD\u80B2\u5DE5\u4F5C\u3001\u63D0\u9AD8\u7802\u62C9\u8D8A\u6C11\u4F17\u4FDD\u62A4\u4EBA\u733F\u610F\u8BC6\u3001\u76F8\u5173\u7684\u6559\u80B2\u6D3B\u52A8\u3001\u4FDD\u80B2\u4E2D\u5FC3\u91CC\u7684\u4EBA\u733F\u6240\u9700\u7684\u98DF\u7269\u548C\u533B\u7597\u8D39\u7528\u3002\u003C/p\u003E\n\u003Cp\u003E2016\u5E74\uFF0C\u56FD\u9645\u81EA\u7136\u4FDD\u62A4\u8054\u76DF\uFF08IUCN\uFF09\u5BA3\u5E03\uFF0C\u7802\u62C9\u8D8A\u7684\u5A46\u7F57\u6D32\u7329\u7329(Bornean Orang Utan)\u662F\u6781\u5EA6\u6FD2\u5371\u7684\u7269\u79CD\uFF0C\u9762\u4E34\u7740\u201C\u6781\u9AD8\u98CE\u9669\u7684\u7269\u79CD\u706D\u7EDD\u201D\u7684\u5371\u673A\u3002\u800C\u6839\u636E\u5B9E\u8499\u8C37\u91CE\u751F\u52A8\u7269\u4FDD\u80B2\u4E2D\u5FC3\u5B98\u65B9\u8D44\u6599\uFF0C\u5A46\u7F57\u6D32\u7329\u7329\u5728\u7802\u62C9\u8D8A\u53EA\u5269\u4E0B2\u5343\u81F32\u5343500\u53EA\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u4E39\u7ED2\u62FF\u7763\u56FD\u5BB6\u516C\u56ED\uFF1A\u5A46\u7F57\u6D32\u7F8E\u666F\u4E0E\u6D69\u701A\u6D77\u6D0B\u7684\u4EA4\u6C47\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u5750\u843D\u4E8E\u7802\u62C9\u8D8A\u6D77\u5CB8\u7EBF\u7684\u897F\u5317\u7AEF\uFF0C\u4E39\u7ED2\u62FF\u7763\u56FD\u5BB6\u516C\u56ED (Tanjung Datu National Park)\u4E0D\u4EC5\u53EF\u89C1\u5D0E\u5C96\u7EF5\u5EF6\u7684\u5C71\u5CE6\uFF0C\u8FD8\u6709\u6E05\u6F88\u6E5B\u84DD\u7684\u6D77\u6D0B\u7684\u886C\u6258\uFF0C\u4F9D\u5C71\u508D\u6C34\uFF0C\u7F8E\u4E0D\u80DC\u6536\u3002\u5B83\u88AB\u5230\u8BBF\u8005\u8D4B\u4E88\u201C\u5A46\u7F57\u6D32\u7684\u5929\u5802\u201D\u4E4B\u7F8E\u8A89\u7EDD\u5BF9\u4E0D\u65E0\u9053\u7406\u3002\u8FD9\u91CC\u7684\u666F\u8272\u6444\u4EBA\u5FC3\u9B44\uFF0C\u8BA9\u4EBA\u5B9B\u82E5\u8EAB\u5904\u5728\u4E16\u5916\u6843\u6E90\u3002\u003C/p\u003E\n\u003Cp\u003E\u9664\u4E86\u5750\u62E5\u7EDD\u4E16\u7F8E\u666F\u5916\uFF0C\u8FD9\u5EA7\u56FD\u5BB6\u516C\u56ED\u4E5F\u662F\u591A\u79CD\u91CE\u751F\u52A8\u7269\u7684\u6816\u606F\u5730\u3002\u56ED\u5185\u7684\u7280\u9E1F\u6570\u91CF\u4E0D\u8BA1\u5176\u6570\uFF0C\u4E0D\u65F6\u90FD\u80FD\u770B\u5230\u58EE\u89C2\u7684\u9E1F\u7FA4\u5728\u68EE\u6797\u91CC\u81EA\u7531\u7FF1\u7FD4\u6216\u6816\u606F\u5728\u6811\u53F6\u4E0A\u3002\u66F4\u610F\u60F3\u4E0D\u5230\u7684\u662F\uFF0C\u6765\u5230\u6B64\u5730\u7684\u8BBF\u5BA2\u6216\u6709\u673A\u4F1A\u8FD1\u8DDD\u79BB\u4E00\u7779\u88AB\u51A0\u4E3A\u5168\u7403\u6700\u5927\u7684\u82B1\u5349 \u2013 \u83B1\u4F5B\u58EB\u82B1\u7684\u82B3\u5BB9\u3002\u5947\u7279\u7684\u83B1\u4F5B\u58EB\u82B1\u82B3\u8E2A\u98D8\u5FFD\u4E0D\u5B9A\uFF0C\u5E78\u8FD0\u7684\u76EE\u7779\u8005\u65E0\u4E0D\u88AB\u5B83\u5438\u775B\u3001\u7F8E\u8273\u800C\u5DE8\u5927\u7684\u8840\u7EA2\u8272\u5916\u5F62\u7559\u4E0B\u96BE\u4EE5\u78E8\u706D\u7684\u5370\u8C61\u3002\u5C3D\u7BA1\u5B83\u5982\u6B64\u73CD\u7A00\uFF0C\u4F46\u4ECD\u5949\u529D\u4E00\u53E5\uFF0C\u7F8E\u4E3D\u7684\u4E8B\u7269\u8FDC\u89C2\u5DF2\u8DB3\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/01/frc-bbd81a9f470ae954c359a5a091bb94d5.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cem\u003E\u003Cstrong\u003E\u59C6\u7984\u56FD\u5BB6\u516C\u56ED\uFF1A\u771F\u6B63\u7684\u4EBA\u95F4\u4ED9\u5883\u548C\u4EE4\u4EBA\u60CA\u5FC3\u52A8\u9B44\u7684\u6811\u9876\u540A\u6865\u003C/strong\u003E\u003C/em\u003E\u003C/p\u003E\n\u003Cp\u003E\u85CF\u8EAB\u4E8E\u7802\u62C9\u8D8A\u7684\u539F\u91CE\u4E2D\u5FC3\u5730\u5E26\uFF0C\u6709\u4E00\u5904\u5947\u5E7B\u7684\u5927\u81EA\u7136\u51C0\u571F \u2013 \u59C6\u7984\u56FD\u5BB6\u516C\u56ED (Gunung Mulu National Park)\u6B63\u5F85\u60A8\u6765\u63ED\u5F00\u5176\u795E\u79D8\u7684\u9762\u7EB1\u3002\u003C/p\u003E\n\u003Cp\u003E\u77F3\u6797\u5C16\u5CF0\u662F\u59C6\u7984\u5FC5\u5230\u7684\u6253\u5361\u5730\u6807\u3002\u5CA9\u77F3\u5728\u65E5\u79EF\u6708\u7D2F\u7684\u98CE\u5316\u4E0E\u96E8\u6C34\u7684\u4FB5\u8680\u4E0B\u5C16\u524A\u5982\u5251\uFF0C\u7247\u7247\u5C16\u8038\u76F4\u7ACB\u3002\u7A81\u5140\u8BE1\u5F02\u7684\u77F3\u7070\u5CA9\u5730\u5F62\u66F4\u56E0\u6B64\u5438\u5F15\u4E86\u4E16\u754C\u5404\u5730\u7684\u63A2\u9669\u8005\u4E0D\u8FDC\u5343\u91CC\uFF0C\u6155\u540D\u800C\u6765\u3002\u82E5\u60F3\u6765\u70B9\u66F4\u60CA\u9669\u523A\u6FC0\u7684\u65C5\u7A0B\uFF0C\u4E0D\u59A8\u524D\u5F80\u7802\u62C9\u8D8A\u5385\u9971\u89C8\u5168\u7403\u6700\u5927\u7684\u5929\u7136\u5730\u6D1E\uFF0C\u6291\u6216\u8D70\u8BBF\u9E7F\u6D1E\u4E00\u8D9F\uFF0C\u770B\u770B\u6570\u4EE5\u4E07\u8BA1\u7684\u8759\u8760\u5728\u9EC4\u660F\u65F6\u5206\u6210\u7FA4\u7ED3\u961F\u5916\u51FA\u89C5\u98DF\u7684\u5947\u89C2\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/01/frc-6ce8c43555895ec991abf6716be9ec31.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u56ED\u5185\u5907\u6709\u4E30\u5BCC\u591A\u5F69\u7684\u751F\u7269\u767E\u6001\u548C\u8DA3\u5473\u6D3B\u52A8\uFF0C\u559C\u6B22\u63A2\u9669\u523A\u6FC0\u7684\u60A8\u5FC5\u4F1A\u6D41\u8FDE\u5FD8\u8FD4\uFF0C\u5C3D\u5174\u800C\u5F52\u3002\u51ED\u7740\u9B3C\u65A7\u795E\u5DE5\u7684\u81EA\u7136\u666F\u89C2\uFF0C\u59C6\u7984\u56FD\u5BB6\u516C\u56ED\u57282000\u5E74\u8363\u83B7\u8054\u5408\u56FD\u6559\u79D1\u6587\u7EC4\u7EC7(UNESCO)\u8BC4\u4E3A\u4E16\u754C\u81EA\u7136\u9057\u4EA7\uFF0C\u8BA9\u4EBA\u4E0D\u7981\u5BF9\u8FD9\u7247\u5145\u6EE1\u81EA\u7136\u5B9D\u85CF\u7684\u571F\u5730\u591A\u4E86\u4E00\u4EFD\u671F\u5F85\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/01/frc-fe8401615ac2fc5ddd3df87a5db047b6.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5A46\u7F57\u6D32\u91CE\u8DA3\u4E4B\u884C\uFF1A\u81EA\u7136\u7231\u597D\u8005\u5FC5\u5230\u7684\u671D\u5723\u4E4B\u5730\u003C/strong\u003E\n\u003C/p\u003E\n\u003Cp\u003E\u5A46\u7F57\u6D32\u7684\u7802\u62C9\u8D8A\u88AB\u79F0\u4E4B\u4E3A\u751F\u7269\u591A\u6837\u6027\u7684\u4F0A\u7538\u56ED\u3002\u7136\u800C\uFF0C\u7802\u62C9\u8D8A\u7684\u72EC\u7279\u4E4B\u5904\u4E0D\u4EC5\u9650\u4E8E\u5176\u5F97\u5929\u72EC\u539A\u7684\u5730\u7406\u4F4D\u7F6E\uFF0C\u5B83\u66F4\u662F\u5404\u79CD\u81EA\u7136\u751F\u6001\u8FDB\u5316\u7684\u6E29\u5E8A\u4E0E\u6D3B\u751F\u751F\u7684\u5B9E\u9A8C\u5BA4\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/01/frc-770b0751cb3d49677e254dc5f5f79d5d.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u8FD9\u91CC\u4E94\u5F69\u6591\u6593\u7684\u52A8\u690D\u7269\u4E16\u754C\u5B9E\u5728\u96BE\u4EE5\u9010\u4E00\u5C3D\u8FF0\uFF0C\u4E0D\u5982\u4ECA\u5929\u5C31\u7B56\u5212\u60A8\u7684\u7802\u62C9\u8D8A\u884C\u7A0B\uFF0C\u4EB2\u8EAB\u611F\u53D7\u8FD9\u7247\u571F\u5730\u591A\u59FF\u591A\u5F69\u7684\u91CE\u8DA3\u4E4B\u7F8E\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/-T-e8-JdAI3-1QPXalajHA\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
