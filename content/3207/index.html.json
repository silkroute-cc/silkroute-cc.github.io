  "route": "/3207/",
  "title": "\u4E03\u51B6\u4E2D\u6807\u5370\u5EA6\u5C3C\u897F\u4E9A\u963F\u66FC\u94DC\u51B6\u70BC\u9879\u76EE",
  "summary": "\u8FD1\u65E5\uFF0C\u4E03\u51B6\u5EFA\u8BBE\u96C6\u56E2\u6240\u5C5E\u5370\u5C3C\u516C\u53F8\u6536\u5230\u4E86\u5370\u5EA6\u5C3C\u897F\u4E9A PT.PENGEMBANGAN INDUSTRI LOGAM\u516C\u53F8\u53D1\u6765\u7684\u5370\u5C3C\u963F\u66FC90\u4E07\u5428/\u5E74\u94DC\u51B6\u70BC\u9879\u76EE\u7B2C\u4E09\u6807\u6BB5\u4E2D\u6807\u901A\u77E5\u4E66\u3002 \u5370\u5C3C\u963F\u66FC\u94DC\u51B6\u70BC\u9879\u76EE\u4FEF\u89C6\u6548\u679C\u56FE \u8BE5\u9879\u76EE\u7531\u5370\u5EA6\u5C3C\u897F\u4E9A\u963F\u66FC\u77FF\u4E1A\u516C\u53F8\u6295\u8D44\u5EFA\u8BBE\uFF0C\u4F4D\u4E8E\u5370\u5C3C\u897F\u52AA\u6C99\u767B\u5361\u62C9\u7701\u677E\u5DF4\u54C7\u5C9B\uFF0C\u9879\u76EE\u5305\u62EC\u7535\u89E3\u7CBE\u70BC\u5382\u3001\u7A00\u8D35\u5382\u3001\u6E23\u9009\u5382\u7B49\u5DE5\u7A0B\u5EFA\u8BBE\u5185\u5BB9\u3002\u9879\u76EE\u7BA1\u7406\u516C\u53F8\u4E3ATCE\u53CAIKPT\uFF0C\u5168\u8FC7\u7A0B\u6B27\u6807\u6A21\u5F0F\u7BA1\u7406\uFF0C\u6267\u884CASME\u3001\u5370\u5EA6\u5C3C\u897F\u4E9A\u7B49\u56FD\u5916\u6807\u51C6\uFF0C\u91C7\u7528P6\u9879\u76EE\u8FDB\u5EA6\u63A7\u5236\u7BA1\u7406\uFF0C\u5DE5\u671F18\u4E2A\u6708\u3002 \u8FD9\u662F\u5728\u4E03\u51B6\u4E0A\u4E0B\u6DF1\u5165\u2026",
  "body": "\u003Cp\u003E\u8FD1\u65E5\uFF0C\u4E03\u51B6\u5EFA\u8BBE\u96C6\u56E2\u6240\u5C5E\u5370\u5C3C\u516C\u53F8\u6536\u5230\u4E86\u5370\u5EA6\u5C3C\u897F\u4E9A PT.PENGEMBANGAN INDUSTRI LOGAM\u516C\u53F8\u53D1\u6765\u7684\u5370\u5C3C\u963F\u66FC90\u4E07\u5428/\u5E74\u94DC\u51B6\u70BC\u9879\u76EE\u7B2C\u4E09\u6807\u6BB5\u4E2D\u6807\u901A\u77E5\u4E66\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2022/11/frc-dfeadaaede9127186c95de9b2f15e70f.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5370\u5C3C\u963F\u66FC\u94DC\u51B6\u70BC\u9879\u76EE\u4FEF\u89C6\u6548\u679C\u56FE\u003C/p\u003E\n\u003Cp\u003E\u8BE5\u9879\u76EE\u7531\u5370\u5EA6\u5C3C\u897F\u4E9A\u963F\u66FC\u77FF\u4E1A\u516C\u53F8\u6295\u8D44\u5EFA\u8BBE\uFF0C\u4F4D\u4E8E\u5370\u5C3C\u897F\u52AA\u6C99\u767B\u5361\u62C9\u7701\u677E\u5DF4\u54C7\u5C9B\uFF0C\u9879\u76EE\u5305\u62EC\u7535\u89E3\u7CBE\u70BC\u5382\u3001\u7A00\u8D35\u5382\u3001\u6E23\u9009\u5382\u7B49\u5DE5\u7A0B\u5EFA\u8BBE\u5185\u5BB9\u3002\u9879\u76EE\u7BA1\u7406\u516C\u53F8\u4E3ATCE\u53CAIKPT\uFF0C\u5168\u8FC7\u7A0B\u6B27\u6807\u6A21\u5F0F\u7BA1\u7406\uFF0C\u6267\u884CASME\u3001\u5370\u5EA6\u5C3C\u897F\u4E9A\u7B49\u56FD\u5916\u6807\u51C6\uFF0C\u91C7\u7528P6\u9879\u76EE\u8FDB\u5EA6\u63A7\u5236\u7BA1\u7406\uFF0C\u5DE5\u671F18\u4E2A\u6708\u3002\n\n\u8FD9\u662F\u5728\u4E03\u51B6\u4E0A\u4E0B\u6DF1\u5165\u5B66\u4E60\u8D2F\u5F7B\u515A\u7684\u4E8C\u5341\u5927\u7CBE\u795E\u3001\u63A8\u52A8\u5171\u5EFA\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u9AD8\u8D28\u91CF\u53D1\u5C55\u80CC\u666F\u4E0B\u53D6\u5F97\u7684\u53EF\u559C\u6210\u679C\uFF0C\u4E5F\u662F\u4E03\u51B6\u5EFA\u8BBE\u96C6\u56E2\u56FD\u9645\u5DE5\u7A0B\u5EFA\u8BBE\u91C7\u7528\u5370\u5C3CPT\u516C\u53F8\u8FD0\u884C\u6A21\u5F0F\u201C\u81EA\u6211\u626C\u5E06\u201D\u7684\u91CD\u8981\u7A81\u7834\u3002\u5BF9\u6B64\uFF0C\u96C6\u56E2\u516C\u53F8\u9886\u5BFC\u9AD8\u5EA6\u91CD\u89C6\uFF0C\u8981\u6C42\u4E03\u51B6\u56FD\u9645\u5DE5\u7A0B\u516C\u53F8\u548C\u4E03\u51B6\u5370\u5C3C\u516C\u53F8\u52A1\u5FC5\u7CBE\u5FC3\u7EC4\u7EC7\u3001\u7D27\u5BC6\u914D\u5408\uFF0C\u62D3\u5BBD\u56FD\u9645\u89C6\u91CE\uFF0C\u4EE5\u9AD8\u5EA6\u7684\u4F7F\u547D\u611F\u548C\u8D23\u4EFB\u611F\u5C06\u8BE5\u9879\u76EE\u7EC4\u7EC7\u597D\u5B8C\u6210\u597D\u3002\n\n\u8BE5\u9879\u76EE\u7684\u6210\u529F\u4E2D\u6807\uFF0C\u6807\u5FD7\u7740\u4E03\u51B6\u7ACB\u8DB3\u5370\u5EA6\u5C3C\u897F\u4E9A\u9879\u76EE\u5E02\u573A\u3001\u5411\u56FD\u9645\u9879\u76EE\u5E02\u573A\u8F90\u5C04\u8FC8\u51FA\u575A\u5B9E\u6B65\u4F10\u3002\u5728\u9879\u76EE\u5B9E\u65BD\u8FC7\u7A0B\u4E2D\uFF0C\u8BE5\u9879\u76EE\u5C06\u9762\u4E34\u5DE5\u671F\u7D27\u3001\u65BD\u5DE5\u6807\u51C6\u9AD8\u3001\u4EFB\u52A1\u91CD\u3001\u5546\u8FD0\u7269\u6D41\u3001\u6C47\u7387\u53D8\u5316\u7B49\u65B9\u9762\u4E25\u5CFB\u8003\u9A8C\uFF0C\u4E5F\u662F\u5BF9\u4E03\u51B6\u56FD\u9645\u5DE5\u7A0B\u9879\u76EE\u56E2\u961F\u65BD\u5DE5\u7EC4\u7EC7\u3001\u6D41\u7A0B\u7BA1\u7406\u521B\u65B0\u65B9\u9762\u7684\u4E00\u6B21\u5168\u65B0\u8003\u9A8C\u3002\u4E03\u51B6\u56FD\u9645\u5DE5\u7A0B\u9879\u76EE\u56E2\u961F\u5C06\u4EE5\u8BE5\u9879\u76EE\u4E3A\u4F9D\u6258\uFF0C\u624E\u5B9E\u5B8C\u5584\u9879\u76EE\u5236\u5EA6\u5EFA\u8BBE\uFF0C\u72E0\u6293\u9879\u76EE\u8FC7\u7A0B\u7BA1\u7406\uFF0C\u5408\u7406\u914D\u7F6E\u751F\u4EA7\u8981\u7D20\uFF0C\u6709\u6548\u6574\u5408\u793E\u4F1A\u4F18\u52BF\u8D44\u6E90\uFF0C\u5145\u5206\u5229\u7528\u5DE5\u4E1A\u5EFA\u7B51\u4F20\u7EDF\u4E3B\u4E1A\u7684\u751F\u4EA7\u80FD\u529B\u3001\u6280\u672F\u4F18\u52BF\u548C\u9879\u76EE\u62D3\u5C55\u80FD\u529B\uFF0C\u653B\u575A\u514B\u96BE\u3001\u82E6\u5E72\u5B9E\u5E72\u5DE7\u5E72\uFF0C\u786E\u4FDD\u56FD\u9645\u5DE5\u7A0B\u4E1A\u52A1\u8D28\u4E0E\u91CF\u7684\u7A33\u6B65\u63D0\u5347\uFF0C\u4E3A\u4E03\u51B6\u96C6\u56E2\u9AD8\u8D28\u91CF\u53D1\u5C55\u4F5C\u51FA\u79EF\u6781\u8D21\u732E\u3002\n\u003C/p\u003E\n\u003Cp\u003E\n\u6765\u6E90\uFF1Ahttps://mp.weixin.qq.com/s/OQadFl3R3PQrq1W2gAxW1g\u003C/p\u003E\n",
