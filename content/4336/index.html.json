{
  "id": "%e9%a6%96%e7%9b%b8%e5%ae%89%e5%8d%8e%e8%af%81%e5%ae%9e-%e6%97%a5%e4%bc%81%e9%80%80%e5%87%ba%e9%9a%86%e6%96%b0%e9%ab%98%e9%93%81%e7%ab%9e%e6%a0%87",
  "slug": "%e9%a6%96%e7%9b%b8%e5%ae%89%e5%8d%8e%e8%af%81%e5%ae%9e-%e6%97%a5%e4%bc%81%e9%80%80%e5%87%ba%e9%9a%86%e6%96%b0%e9%ab%98%e9%93%81%e7%ab%9e%e6%a0%87",
  "canonicalUrlKey": "%e9%a6%96%e7%9b%b8%e5%ae%89%e5%8d%8e%e8%af%81%e5%ae%9e-%e6%97%a5%e4%bc%81%e9%80%80%e5%87%ba%e9%9a%86%e6%96%b0%e9%ab%98%e9%93%81%e7%ab%9e%e6%a0%87",
  "route": "/4336/",
  "title": "\u9996\u76F8\u5B89\u534E\u8BC1\u5B9E \u65E5\u4F01\u9000\u51FA\u9686\u65B0\u9AD8\u94C1\u7ADE\u6807",
  "summary": "\uFF08\u5409\u9686\u576112\u65E5\u8BAF\uFF09\u6D88\u606F\u6307\u51FA\uFF0C\u7531\u4E8E\u5927\u9A6C\u653F\u5E9C\u4E0D\u613F\u63D0\u4F9B\u8D22\u52A1\u63F4\u52A9\uFF0C\u53C2\u4E0E\u5EFA\u8BBE\u98CE\u9669\u592A\u9AD8\uFF0C\u65E5\u8D44\u516C\u53F8\u51B3\u5B9A\u9000\u51FA\u53C2\u4E0E\u9686\u65B0\u9AD8\u94C1\uFF08HSR\uFF09\u8BA1\u5212\u3002 \u7531\u5927\u9A6C\u9AD8\u94C1\u673A\u6784\u53D1\u51FA\u7684\u9686\u65B0\u9AD8\u94C1\u4FE1\u606F\u5F81\u8BE2\u4E66\uFF08RFI\uFF09\u5C06\u5728\u4E0B\u5468\u4E00\uFF0815\u65E5\uFF09\u622A\u6B62\uFF0C\u6D88\u606F\u900F\u9732\uFF0C\u968F\u7740\u65E5\u8D44\u516C\u53F8\u64A4\u51FA\u7ADE\u6807\u9686\u65B0\u9AD8\u94C1\u9879\u76EE\uFF0C\u6570\u5BB6\u5927\u9A6C\u516C\u53F8\u8BA1\u5212\u4E0E\u4E2D\u8D44\u53CA\u6B27\u6D32\u516C\u53F8\u8054\u624B\u6295\u6807\u3002 \u65E5\u672C\u300A\u5171\u540C\u793E\u300B\u5F15\u8FF0\u653F\u5E9C\u53CA\u79C1\u4EBA\u754C\u6D88\u606F\u62A5\u9053\uFF0C\u5305\u62EC\u5E0C\u671B\u80FD\u5C06\u65E5\u672C\u65B0\u5E72\u7EBF\u5B50\u5F39\u5217\u8F66\u7CFB\u7EDF\uFF0C\u8FD0\u7528\u5728\u9686\u65B0\u9AD8\u94C1\u7684\u4E1C\u65E5\u672C\u94C1\u9053\uFF08East Japan Railway Co\uFF09\u5728\u5185\u7684\u65E5\u8D44\u516C\u53F8\uFF0C\u5DF2\u51B3\u5B9A\u64A4\u51FA\u6295\u6807\uFF0C\u56E0\u8FD9\u4E2A\u2026",
  "body": "\u003Cp\u003E\uFF08\u5409\u9686\u576112\u65E5\u8BAF\uFF09\u6D88\u606F\u6307\u51FA\uFF0C\u7531\u4E8E\u5927\u9A6C\u653F\u5E9C\u4E0D\u613F\u63D0\u4F9B\u8D22\u52A1\u63F4\u52A9\uFF0C\u53C2\u4E0E\u5EFA\u8BBE\u98CE\u9669\u592A\u9AD8\uFF0C\u65E5\u8D44\u516C\u53F8\u51B3\u5B9A\u9000\u51FA\u53C2\u4E0E\u9686\u65B0\u9AD8\u94C1\uFF08HSR\uFF09\u8BA1\u5212\u3002\u003C/p\u003E\n\u003Cp\u003E\u7531\u5927\u9A6C\u9AD8\u94C1\u673A\u6784\u53D1\u51FA\u7684\u9686\u65B0\u9AD8\u94C1\u4FE1\u606F\u5F81\u8BE2\u4E66\uFF08RFI\uFF09\u5C06\u5728\u4E0B\u5468\u4E00\uFF0815\u65E5\uFF09\u622A\u6B62\uFF0C\u6D88\u606F\u900F\u9732\uFF0C\u968F\u7740\u65E5\u8D44\u516C\u53F8\u64A4\u51FA\u7ADE\u6807\u9686\u65B0\u9AD8\u94C1\u9879\u76EE\uFF0C\u6570\u5BB6\u5927\u9A6C\u516C\u53F8\u8BA1\u5212\u4E0E\u4E2D\u8D44\u53CA\u6B27\u6D32\u516C\u53F8\u8054\u624B\u6295\u6807\u3002\u003C/p\u003E\n\u003Cp\u003E\u65E5\u672C\u300A\u5171\u540C\u793E\u300B\u5F15\u8FF0\u653F\u5E9C\u53CA\u79C1\u4EBA\u754C\u6D88\u606F\u62A5\u9053\uFF0C\u5305\u62EC\u5E0C\u671B\u80FD\u5C06\u65E5\u672C\u65B0\u5E72\u7EBF\u5B50\u5F39\u5217\u8F66\u7CFB\u7EDF\uFF0C\u8FD0\u7528\u5728\u9686\u65B0\u9AD8\u94C1\u7684\u4E1C\u65E5\u672C\u94C1\u9053\uFF08East Japan Railway Co\uFF09\u5728\u5185\u7684\u65E5\u8D44\u516C\u53F8\uFF0C\u5DF2\u51B3\u5B9A\u64A4\u51FA\u6295\u6807\uFF0C\u56E0\u8FD9\u4E2A\u9879\u76EE\u7F3A\u4E4F\u653F\u5E9C\u8D22\u52A1\u63F4\u52A9\uFF0C\u98CE\u9669\u76F8\u5BF9\u589E\u52A0\u3002\u003C/p\u003E\n\u003Cp\u003E\u9AD8\u94C1\u673A\u6784\u5728\u53BB\u5E747\u670811\u65E5\u53D1\u51FA\u4FE1\u606F\u5F81\u8BE2\u4E66\uFF0C\u622A\u6B62\u65E5\u671F\u662F8\u67082\u65E5\uFF0C\u5E76\u5EF6\u540E\u523011\u670815\u65E5\uFF0C\u8FC7\u540E\u518D\u57FA\u4E8E\u83B7\u5F97\u70ED\u70C8\u53CD\u5E94\uFF0C\u5C06\u622A\u6B62\u65E5\u671F\u5EF6\u81F3\u672C\u670815\u65E5\u3002\u003C/p\u003E\n\u003Cp\u003E\u8FD9\u4E2A\u9879\u76EE\u9884\u8BA1\u8017\u8D441000\u4EBF\u4EE4\u5409\uFF0C\u4E0D\u8FC7\u5927\u9A6C\u653F\u5E9C\u8BA1\u5212\u901A\u8FC7\u516C\u79C1\u5408\u8425\uFF0C\u800C\u975E\u653F\u5E9C\u652F\u51FA\u6216\u63D0\u4F9B\u503A\u52A1\u62C5\u4FDD\u3002\u003C/p\u003E\n\u003Cp\u003E\u62A5\u9053\u62AB\u9732\uFF0C\u65E5\u8D44\u516C\u53F8\u6B32\u64A4\u51FA\u6295\u6807\uFF0C\u6216\u8BA9\u7ADE\u4E89\u7684\u4E2D\u8D44\u516C\u53F8\u8FDB\u4E00\u6B65\u5F3A\u5316\u5728\u4E1C\u4E9A\u7684\u57FA\u7840\u5EFA\u8BBE\u7248\u56FE\uFF0C\u5C24\u5176\u4E2D\u8D44\u516C\u53F8\u5DF2\u5728\u53BB\u5E74\u5B8C\u6210\u5728\u5370\u5C3C\u7684\u9AD8\u94C1\u9879\u76EE\uFF0C\u53E6\u5916\u7531\u4E2D\u8D44\u51FA\u8D44\u5EFA\u8BBE\u7A7F\u884C\u5BEE\u56FD\u7684\u9AD8\u94C1\u7EBF\u4E5F\u5728\u8FD0\u4F5C\u4E2D\uFF0C\u4E14\u6B63\u7F13\u6162\u8854\u63A5\u81F3\u6CF0\u56FD\u3002\u003C/p\u003E\n\u003Cp\u003E\u5927\u9A6C\u653F\u5E9C\u8BA1\u5212\u5728RFI\u622A\u6B62\u540E\u7684\u51E0\u4E2A\u6708\u5185\u7B5B\u9009\u6295\u6807\u65B9\uFF0C\u540C\u65F6\u6700\u65E9\u5728\u4ECA\u5E74\u5185\u4E0E\u65B0\u52A0\u5761\u653F\u5E9C\u5C55\u5F00\u5168\u9762\u534F\u5546\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u653E\u773C\u4ECA\u5E74\u52A8\u5DE5\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u53BB\u5E7412\u6708\uFF0C\u65F6\u4EFB\u8D22\u653F\u90E8\u526F\u90E8\u957F\u62FF\u7763\u65AF\u91CC\u963F\u672B\u9A6C\u65AF\u5170\u5728\u56FD\u4F1A\u6307\u51FA\uFF0C\u9884\u8BA1\u5C06\u4E8E\u622A\u6B62\u65E5\u671F\u540E\u6B63\u5F0F\u8FDB\u5165\u5F81\u6C42\u5EFA\u8BAE\u4E66\uFF08RFP\uFF09\u6D41\u7A0B\uFF0C\u9884\u8BA11\u4E2A\u6708\u5DE6\u53F3\uFF0C\u7531\u653F\u5E9C\u6572\u5B9A\u6267\u884C\u9686\u65B0\u9AD8\u94C1\u9879\u76EE\u7684\u516C\u53F8\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u5F53\u65F6\u8BF4\uFF0C\u76EE\u524D\u5DF2\u6709\u903E30\u5BB6\u516C\u53F8\u8868\u793A\u6709\u610F\u7ADE\u6807\u9686\u65B0\u9AD8\u94C1\u9879\u76EE\uFF0C\u5176\u4E2D\u5305\u62EC\u6765\u81EA\u4E2D\u56FD\u3001\u65E5\u672C\u3001\u97E9\u56FD\u3001\u6B27\u6D32\u548C\u672C\u5730\u4F01\u4E1A\u3002\u653F\u5E9C\u5E0C\u671B\u4ECA\u5E74\u5C31\u53EF\u4EE5\u52A8\u5DE5\uFF0C\u53EF\u80FD\u8017\u65F64\u62165\u5E74\u3002\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u65B0\u653F\u5E9C\u662F\u57282013\u5E74\uFF0C\u9488\u5BF9\u5EFA\u8BBE\u9686\u65B0\u9AD8\u94C1\u8FBE\u6210\u521D\u6B65\u534F\u8BAE\uFF0C\u4EE5\u5728\u65B0\u52A0\u5761\u81F3\u5409\u9686\u5761\u4E4B\u95F4\uFF0C\u5EFA\u8BBE\u5168\u957F350\u516C\u91CC\u7684\u9AD8\u94C1\u8F68\u9053\uFF0C\u8FDB\u800C\u53EF\u7F29\u77ED\u4E24\u5730\u901A\u52E4\u65F6\u95F4\u81F390\u5206\u949F\uFF0C\u76F8\u6BD4\u9A71\u8F66\u5219\u9700\u8D39\u65F6\u8D85\u8FC74\u5C0F\u65F6\u3002\u003C/p\u003E\n\u003Cp\u003E\u5F53\u65F6\uFF0C\u4E1C\u65E5\u672C\u94C1\u9053\u53CA\u65E5\u672C\u4F4F\u53CB\u5546\u4E8B\uFF08Sumitomo Corp\uFF09\u90FD\u5BF9\u53C2\u4E0E\u7ADE\u6807\u9686\u65B0\u9AD8\u94C1\u611F\u5174\u8DA3\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E0D\u8FC7\uFF0C\u524D\u9996\u76F8\u4E39\u65AF\u91CC\u6155\u5C24\u4E01\u57FA\u4E8E\u4E0D\u613F\u52A0\u91CD\u653F\u5E9C\u8D22\u653F\u8D1F\u62C5\uFF0C\u57282021\u5E74\u53D6\u6D88\u8FD9\u9879\u8BA1\u5212\uFF0C\u800C\u73B0\u4EFB\u9996\u76F8\u62FF\u7763\u65AF\u91CC\u5B89\u534E\u5219\u6B63\u5F0F\u91CD\u542F\u9686\u65B0\u9AD8\u94C1\u9879\u76EE\u3002\u003C/p\u003E\n\u003Ch1\u003E\u8BC1\u5B9E\u65E5\u4F01\u9000\u51FA\u9686\u65B0\u9AD8\u94C1 \u5B89\u534E:\u521A\u6536\u62A5\u544A\u518D\u7814\u7A76\u003C/h1\u003E\n\u003Cp\u003E\uFF08\u5409\u9686\u576112\u65E5\u8BAF\uFF09\u9996\u76F8\u517C\u8D22\u653F\u90E8\u957F\u62FF\u7763\u65AF\u91CC\u5B89\u534E\u8BC1\u5B9E\uFF0C\u65E5\u8D44\u4F01\u4E1A\u5C06\u9000\u51FA\u9686\u65B0\u9AD8\u94C1\uFF08HSR\uFF09\u9879\u76EE\u7ADE\u6807\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u4ECA\u5929\u4E2D\u5348\u5728\u52A0\u5F71\u6E05\u771F\u5BFA\u8FDB\u884C\u5468\u4E94\u7948\u7977\u540E\uFF0C\u9488\u5BF9\u6709\u5173\u65E5\u672C\u5A92\u4F53\u62A5\u9053\uFF0C\u65E5\u8D44\u516C\u53F8\u9000\u51FA\u9686\u65B0\u9AD8\u94C1\u9879\u76EE\u6295\u6807\u4E00\u4E8B\uFF0C\u7B80\u77ED\u56DE\u5E94\u8868\u793A\u81EA\u5DF1\u521A\u624D\u6536\u5230\u76F8\u5173\u62A5\u544A\uFF0C\u9700\u8981\u65F6\u95F4\u518D\u505A\u7814\u7A76\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u4EEC\u4F1A\u518D\u7814\u7A76\uFF0C\u6211\u521A\u521A\u624D\u6536\u5230\u62A5\u544A\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u65E5\u672C\u300A\u5171\u540C\u793E\u300B\u62A5\u9053\uFF0C\u6D88\u606F\u6307\u51FA\uFF0C\u7531\u4E8E\u5927\u9A6C\u653F\u5E9C\u4E0D\u613F\u63D0\u4F9B\u8D22\u52A1\u63F4\u52A9\uFF0C\u53C2\u4E0E\u5EFA\u8BBE\u98CE\u9669\u592A\u9AD8\uFF0C\u65E5\u8D44\u516C\u53F8\u51B3\u5B9A\u9000\u51FA\u53C2\u4E0E\u9686\u65B0\u9AD8\u94C1\uFF08HSR\uFF09\u8BA1\u5212\u3002\u003C/p\u003E\n\u003Cp\u003E\u7531\u5927\u9A6C\u9AD8\u94C1\u673A\u6784\u53D1\u51FA\u7684\u9686\u65B0\u9AD8\u94C1\u4FE1\u606F\u5F81\u8BE2\u4E66\uFF08RFI\uFF09\u5C06\u5728\u4E0B\u5468\u4E00\uFF0815\u65E5\uFF09\u622A\u6B62\uFF0C\u6D88\u606F\u900F\u9732\uFF0C\u968F\u7740\u65E5\u8D44\u516C\u53F8\u64A4\u51FA\u7ADE\u6807\u9686\u65B0\u9AD8\u94C1\u9879\u76EE\uFF0C\u6570\u5BB6\u5927\u9A6C\u516C\u53F8\u8BA1\u5212\u4E0E\u4E2D\u8D44\u53CA\u6B27\u6D32\u516C\u53F8\u8054\u624B\u6295\u6807\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/DJnPNBOTo-319JVQEAsFEw\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
