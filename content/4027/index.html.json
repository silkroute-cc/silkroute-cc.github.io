  "canonicalUrlKey": "%e4%b8%8d%e6%98%af%e6%b2%a1%e6%9c%89%e7%8c%aa%e8%82%89%e5%b0%b1%e7%ae%97halal%ef%bc%813%e5%88%86%e9%92%9f%e8%af%bb%e6%87%82halal%e7%9a%84%e5%ae%9a%e4%b9%89%e4%b8%8e%e8%a7%84%e5%88%99%ef%bc%81",
  "route": "/4027/",
  "title": "\u4E0D\u662F\u6CA1\u6709\u732A\u8089\u5C31\u7B97Halal\uFF013\u5206\u949F\u8BFB\u61C2Halal\u7684\u5B9A\u4E49\u4E0E\u89C4\u5219\uFF01",
  "summary": "\u6839\u636E2021\u5E74\u9A6C\u6765\u897F\u4E9A\u4EBA\u53E3\u8C03\u67E5\uFF0C\u6211\u4EEC\u6709\u63A5\u8FD170%\u7684\u7A46\u65AF\u6797\u4EBA\u53E3\uFF0C\u76F8\u7B49\u4E8E2\u5343\u4E07\u4EBA\uFF0C\u6240\u4EE5halal\u4E5F\u5C31\u662F\u6E05\u771F\u98DF\u7269\u5728\u6211\u56FD\u4E00\u76F4\u4EE5\u6765\u90FD\u662F\u4E00\u4E2A\u88AB\u91CD\u89C6\u7684\u95EE\u9898\u3002\u8EAB\u4E3A\u975E\u7A46\u65AF\u6797\u7684\u6211\u4EEC\u90FD\u660E\u767D\u53EA\u8981\u6709\u732A\u8089\u7684\u90FD\u4E0D\u662Fhalal\u98DF\u7269\uFF0C\u9664\u4E86\u8FD9\u4E2A\u5176\u5B9E\u8FD8\u6709\u4E00\u4E9B\u5927\u9A6C\u4EBA\u5E38\u5E38\u8BEF\u4F1A\u7684\u5B9A\u4E49\uFF0C\u4ECA\u5929\u5C31\u5E26\u5927\u5BB6\u6765\u7B80\u5355\u5730\u4E86\u89E3\u4E00\u4E0B\u5427\u3002 #1 \u8089\u7C7B\u3001\u852C\u83DC \u4EFB\u4F55\u542B\u6709\u732A\u548C\u72D7\u8089\u7684\u98DF\u7269\u90FD\u662Fharam\u7684\uFF0C\u540C\u65F6\u56DE\u6559\u6CD5\u5178\u4E5F\u7981\u6B62\u7A46\u65AF\u6797\u98DF\u7528\u8840\uFF08\u4F8B\u5982\u9E21/\u732A\u8840\u7CD5\uFF09\u3001\u5C38\u4F53\u3001\u8089\u98DF\u52A8\u7269\uFF08\u6709\u653B\u51FB\u6027\u7684\uFF09\u8FD8\u6709\u5BB3\u866B\u5982\u86C7\u866B\u9F20\u8681\u7B49\u3002\u90A3\u662F\u56E0\u4E3A\u8FD9\u4E9B\u90FD\u662F\u4E0D\u7EAF\u6D01\u800C\u4E14\u6709\u6BD2\u7684\u52A8\u7269\uFF0C\u5403\u4E86\u5BF9\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/09/frc-89c04ee7f39e92840cd296492d6f1b17.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u6839\u636E2021\u5E74\u9A6C\u6765\u897F\u4E9A\u4EBA\u53E3\u8C03\u67E5\uFF0C\u6211\u4EEC\u6709\u63A5\u8FD170%\u7684\u7A46\u65AF\u6797\u4EBA\u53E3\uFF0C\u76F8\u7B49\u4E8E2\u5343\u4E07\u4EBA\uFF0C\u6240\u4EE5halal\u4E5F\u5C31\u662F\u6E05\u771F\u98DF\u7269\u5728\u6211\u56FD\u4E00\u76F4\u4EE5\u6765\u90FD\u662F\u4E00\u4E2A\u88AB\u91CD\u89C6\u7684\u95EE\u9898\u3002\u8EAB\u4E3A\u975E\u7A46\u65AF\u6797\u7684\u6211\u4EEC\u90FD\u660E\u767D\u53EA\u8981\u6709\u732A\u8089\u7684\u90FD\u4E0D\u662Fhalal\u98DF\u7269\uFF0C\u9664\u4E86\u8FD9\u4E2A\u5176\u5B9E\u8FD8\u6709\u4E00\u4E9B\u5927\u9A6C\u4EBA\u5E38\u5E38\u8BEF\u4F1A\u7684\u5B9A\u4E49\uFF0C\u4ECA\u5929\u5C31\u5E26\u5927\u5BB6\u6765\u7B80\u5355\u5730\u4E86\u89E3\u4E00\u4E0B\u5427\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/09/frc-0954a51b1a3b43cc26df1bdd03f8387c.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E#1 \u8089\u7C7B\u3001\u852C\u83DC\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u4EFB\u4F55\u542B\u6709\u732A\u548C\u72D7\u8089\u7684\u98DF\u7269\u90FD\u662Fharam\u7684\uFF0C\u540C\u65F6\u56DE\u6559\u6CD5\u5178\u4E5F\u7981\u6B62\u7A46\u65AF\u6797\u98DF\u7528\u8840\uFF08\u4F8B\u5982\u9E21/\u732A\u8840\u7CD5\uFF09\u3001\u5C38\u4F53\u3001\u8089\u98DF\u52A8\u7269\uFF08\u6709\u653B\u51FB\u6027\u7684\uFF09\u8FD8\u6709\u5BB3\u866B\u5982\u86C7\u866B\u9F20\u8681\u7B49\u3002\u90A3\u662F\u56E0\u4E3A\u8FD9\u4E9B\u90FD\u662F\u4E0D\u7EAF\u6D01\u800C\u4E14\u6709\u6BD2\u7684\u52A8\u7269\uFF0C\u5403\u4E86\u5BF9\u8EAB\u4F53\u6709\u5BB3\u3002\n\u003C/p\u003E\n\u003Cp\u003E\u5BF9\u4E8E\u852C\u679C\u6765\u8BF4\u6211\u4EEC\u90FD\u4EE5\u4E3A\u662F\u767E\u65E0\u7981\u5FCC\uFF0C\u4F46\u5176\u5B9E\u6709\u5BB3\u6216\u6709\u6BD2\u7684\u4E5F\u4E0D\u7B97\u662Fhalal\u98DF\u7269\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/09/frc-8968d438ce040033c4677f109fbb08fc.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E#2 \u5BB0\u6740\u8FC7\u7A0B\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u534E\u4EBA\u5DF4\u5239\u5356\u7684\u9E21\u8089\u7A46\u65AF\u6797\u80FD\u5403\u5417\uFF1F\u7B54\u6848\u662F\u4E0D\u80FD\uFF01\u90A3\u662F\u56E0\u4E3A\u5BB0\u6740\u7272\u755C\u7684\u8FC7\u7A0B\u4E5F\u5341\u5206\u8BB2\u7A76\uFF0C\u7272\u755C\u5FC5\u987B\u53D7\u5230\u6700\u4F4E\u7A0B\u5EA6\u7684\u75DB\u82E6\uFF0C\u800C\u4E14\u7531\u6210\u719F\u548C\u719F\u7EC3\u7684\u7A46\u65AF\u6797\u64CD\u5200\u3002\u9996\u5148\uFF0C\u5229\u5668\u5F97\u591F\u5229\uFF0C\u8981\u5207\u65AD\u7272\u755C\u7684\u6C14\u7BA1\u3001\u98DF\u9053\u548C\u9759\u8109\uFF0C\u786E\u4FDD\u653E\u8840\u5C3D\u53EF\u80FD\u6392\u653E\u5230\u8840\u6D41\u5E72\uFF0C\u4E0D\u8BA9\u5B83\u6709\u592A\u591A\u7684\u6323\u624E\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E#3 \u996E\u6599\uFF08\u9152\u7CBE\uFF09\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u9664\u4E86\u9152\uFF0C\u4EFB\u4F55\u5BF9\u8EAB\u4F53\u6709\u5BB3\u7684\u996E\u6599\u90FD\u7B97haram\u3002\u7A46\u65AF\u6797\u4E0D\u80FD\u559D\u9152\uFF0C\u4F46\u53EF\u4EE5\u4F7F\u7528\u6709\u9152\u7CBE\u7684\u4EA7\u54C1\uFF0C\u7B80\u5355\u6765\u8BF4\uFF0C\u51E1\u662F\u4ECE\u9152\u7CBE\u996E\u6599\uFF08\u7528\u6765\u559D\u7684\uFF09\u5DE5\u4E1A\u53D1\u9175\u800C\u6210\u7684\u4EA7\u54C1\u90FD\u4E0D\u80FD\u4F7F\u7528\u3002\u5982\u679C\u662F\u4E3A\u4E86\u8FBE\u5230\u67D0\u4E9B\u6548\u679C\u800C\u4F7F\u7528\u7684\u9152\u7CBE\uFF0C\u4F8B\u5982\u6D17\u624B\u6DB2\u3001\u53E3\u8154\u6D88\u6BD2\u7B49\uFF0C\u53EF\u4EE5\u5417\uFF1F\u90A3\u662F\u53EF\u4EE5\u7684\uFF0C\u4F46\u6761\u4EF6\u662F\u5B83\u5206\u91CF\u4E00\u5B9A\u8981\u975E\u5E38\u4F4E\u800C\u4E14\u4E0D\u8DB3\u4EE5\u9020\u6210\u4EFB\u4F55\u6548\u679C\uFF08\u9189\uFF09\uFF0C\u8FD8\u6709\u4F7F\u7528\u7684\u76EE\u7684\u4E0D\u662F\u4E3A\u4E86\u4F5C\u4E3A\u9152\u7CBE\u996E\u6599\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/09/frc-e3b2807da0b5e71c65f2988b917c98c2.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E#4 \u5236\u4F5C\u8FC7\u7A0B\u3001\u6536\u85CF\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u5728\u751F\u4EA7halal\u98DF\u54C1\u7684\u5DE5\u5382\u6216\u573A\u6240\u5FC5\u987B\u662F\u5B8C\u5168\u6E05\u771F\u7684\uFF0C\u4E5F\u5C31\u662F\u8BF4\u540C\u4E00\u4E2A\u5730\u65B9\u4E0D\u80FD\u751F\u4EA7\u975Ehalal\u98DF\u7269\u3002\u6E05\u771F\u548C\u975E\u6E05\u771F\u7684\u98DF\u54C1\u4E5F\u4E0D\u80FD\u6709\u63A5\u89E6\uFF0C\u4E0D\u80FD\u4F7F\u7528\u540C\u4E00\u4E2A\u51B0\u7BB1\u6536\u85CF\uFF0C\u540C\u6837\u7684\u9910\u5177/\u5668\u5177\u70F9\u716E\uFF0C\u9664\u975E\u4F60\u5DF2\u7ECF\u4F7F\u7528\u56DE\u6559\u6CD5\u5178\u5F53\u4E2D\u8BB0\u5F55\u7684\u65B9\u6CD5\u6E05\u6D17\u8FC7\u4E86\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/09/frc-2f1c5c36056d1c366eed0840f8634f9b.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E#5 \u4E00\u5B9A\u8981\u6709\u9A8C\u8BC1\u548C\u6267\u7167\uFF01\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u6700\u540E\uFF0C\u4E5F\u5C31\u662F\u6240\u6709\u996E\u98DF\u4E1A\u8005\u5FC5\u987B\u6CE8\u610F\u7684\u4E00\u70B9\uFF0C\u5982\u679C\u4F60\u7684\u98DF\u7269\u6709\u6253\u7B97\u5356\u7ED9\u7A46\u65AF\u6797\uFF0C\u5343\u4E07\u4E00\u5B9A\u8981\u6709\u6267\u7167\uFF0C\u56E0\u4E3A\u53E3\u8BF4\u65E0\u51ED\u3002\u5C31\u7B97\u4F60\u5DF2\u7ECF\u5B8C\u5168\u8DDF\u4ECE\u56DE\u6559\u6CD5\u5178\u5904\u7406\u53CA\u51C6\u5907halal\u98DF\u7269\uFF0C\u8FD8\u662F\u8981\u5F97\u5230\u56FD\u5BB6\u56DE\u6559\u5C40\uFF08JAKIM\uFF09\u7684\u6279\u51C6\u624D\u80FD\u5F00\u59CB\u8425\u4E1A\uFF0C\u8FDD\u89C4\u7684\u8BDD\u5C06\u4F1A\u53D7\u5230\u5F88\u4E25\u91CD\u7684\u540E\u679C\u54E6\uFF01\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/09/frc-2dbfd86310be1767ae77954402fab69c.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u8EAB\u5728\u9A6C\u6765\u897F\u4E9A\u7684\u6211\u4EEC\u6BCF\u5929\u90FD\u4F1A\u63A5\u89E6\u5230\u5F88\u591A\u7684\u7A46\u65AF\u6797\u670B\u53CB\uFF0C\u548C\u4ED6\u4EEC\u4E00\u8D77\u5171\u9910\u6216\u5206\u4EAB\u81EA\u5DF1\u51C6\u5907\u7684\u98DF\u7269\u65F6\uFF0C\u8981\u7406\u89E3\u522B\u4EBA\u7684\u5B97\u6559\u548C\u7981\u5FCC\uFF0C\u522B\u50BB\u50BB\u5730\u8E29\u96F7\u5566\uFF01\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/09/frc-f3221832cb5d0eb90c1d19782f64c503.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/09/frc-fc8a2d87776a34515acadf895870feb7.gif\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u56FE\u6587\u6765\u6E90\uFF1Aopen rice\u003C/p\u003E\n\u003Cp\u003E\u7F16\u8F91\uFF1ABella\u003C/p\u003E\n\u003Cp\u003E\u672C\u5E73\u53F0\u4EC5\u4F9B\u4FE1\u606F\u4F20\u64AD\u670D\u52A1\uFF0C\u82E5\u6709\u6D89\u53CA\u7248\u6743\u95EE\u9898\uFF0C\u003C/p\u003E\n\u003Cp\u003E\u8BF7\u539F\u4F5C\u8005\u6216\u6765\u6E90\u5A92\u4F53\u540E\u53F0\u8054\u7CFB\u53CA\u65F6\u5220\u9664\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/09/frc-032f9abbd7686b29bbc950ead07b16f5.gif\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/09/frc-73420e01efac79b7f8d8b4a3365ce789.gif\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u53D1\u73B0\u003Cstrong\u003E\u201C\u5206\u4EAB\u201D\u003C/strong\u003E\u548C\u003Cstrong\u003E\u201C\u8D5E\u201D\u003C/strong\u003E\u4E86\u5417\uFF0C\u6233\u6211\u770B\u770B\u5427\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/YiT_q1KcuwsN_skp76jrtQ\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
