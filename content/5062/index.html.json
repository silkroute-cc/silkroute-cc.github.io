{
  "id": "%e9%99%86%e5%85%86%e7%a6%8f%e9%93%81%e8%b7%af%e5%b7%a5%e7%a8%8b%e5%ae%8c%e6%88%9083-%e6%9f%94%e6%96%b0%e6%8d%b7%e8%bf%90%e8%b4%ad%e5%81%9c%e8%bd%a6%e4%bd%8d",
  "slug": "%e9%99%86%e5%85%86%e7%a6%8f%e9%93%81%e8%b7%af%e5%b7%a5%e7%a8%8b%e5%ae%8c%e6%88%9083-%e6%9f%94%e6%96%b0%e6%8d%b7%e8%bf%90%e8%b4%ad%e5%81%9c%e8%bd%a6%e4%bd%8d",
  "canonicalUrlKey": "%e9%99%86%e5%85%86%e7%a6%8f%e9%93%81%e8%b7%af%e5%b7%a5%e7%a8%8b%e5%ae%8c%e6%88%9083-%e6%9f%94%e6%96%b0%e6%8d%b7%e8%bf%90%e8%b4%ad%e5%81%9c%e8%bd%a6%e4%bd%8d",
  "route": "/5062/",
  "title": "\u9646\u5146\u798F:\u94C1\u8DEF\u5DE5\u7A0B\u5B8C\u621083% \u67D4\u65B0\u6377\u8FD0\u8D2D\u505C\u8F66\u4F4D",
  "summary": "\uFF08\u5409\u9686\u576120\u65E5\u8BAF\uFF09\u4EA4\u901A\u90E8\u957F\u9646\u5146\u798F\u8868\u793A\uFF0C\u622A\u81F3\u4ECA\u5E747\u6708\u5E95\uFF0C\u67D4\u65B0\u6377\u8FD0\u7CFB\u7EDF\u7684\u94C1\u8DEF\u57FA\u7840\u8BBE\u65BD\u5DE5\u7A0B\u8FDB\u5EA6\uFF0C\u5DF2\u5B8C\u621083%\u3002 \u4ED6\u8BF4\uFF0C\u8003\u8651\u5230\u672A\u6765\u67D4\u65B0\u6377\u8FD0\u7CFB\u7EDF\u6BCF\u65E5\u4E58\u5BA2\u91CF\u7684\u589E\u52A0\uFF0C\u5F53\u5C40\u4E5F\u5E94\u6539\u5584\u516C\u5171\u8BBE\u65BD\uFF0C\u5982\u63D0\u4F9B\u5145\u8DB3\u7684\u505C\u8F66\u4F4D\u3002 \u201C\u6377\u8FD0\u516C\u53F8\u5C06\u5728\u6B66\u5409\u67E5\u5361\u7AD9\uFF0C\u4E3A\u67D4\u65B0\u6377\u8FD0\u7CFB\u7EDF\u7684\u4E58\u5BA2\uFF0C\u5EFA\u9020\u4E00\u4E2A\u65B0\u7684\u591A\u5C42\u2018\u505C\u8F66\u8F6C\u4E58\u2019\uFF08Park\u0026Ride\uFF09\u505C\u8F66\u8BBE\u65BD\uFF0C\u6DB5\u76D61500\u4E2A\u505C\u8F66\u4F4D\u3002\u201D \u65B9\u4FBF\u67D4\u65B0\u901A\u52E4\u8005 \u9646\u5146\u798F\u4ECA\u65E5\u89C1\u8BC1\u6377\u8FD0\u516C\u53F8\uFF08MRT Corp\uFF09\u4E0ECoronade Properties\u79C1\u4EBA\u6709\u9650\u516C\u53F8\uFF08CPSB\uFF09\u7B7E\u7F72\u4E70\u5356\u534F\u2026",
  "body": "\u003Cp\u003E\uFF08\u5409\u9686\u576120\u65E5\u8BAF\uFF09\u4EA4\u901A\u90E8\u957F\u9646\u5146\u798F\u8868\u793A\uFF0C\u622A\u81F3\u4ECA\u5E747\u6708\u5E95\uFF0C\u67D4\u65B0\u6377\u8FD0\u7CFB\u7EDF\u7684\u94C1\u8DEF\u57FA\u7840\u8BBE\u65BD\u5DE5\u7A0B\u8FDB\u5EA6\uFF0C\u5DF2\u5B8C\u621083%\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u8003\u8651\u5230\u672A\u6765\u67D4\u65B0\u6377\u8FD0\u7CFB\u7EDF\u6BCF\u65E5\u4E58\u5BA2\u91CF\u7684\u589E\u52A0\uFF0C\u5F53\u5C40\u4E5F\u5E94\u6539\u5584\u516C\u5171\u8BBE\u65BD\uFF0C\u5982\u63D0\u4F9B\u5145\u8DB3\u7684\u505C\u8F66\u4F4D\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6377\u8FD0\u516C\u53F8\u5C06\u5728\u6B66\u5409\u67E5\u5361\u7AD9\uFF0C\u4E3A\u67D4\u65B0\u6377\u8FD0\u7CFB\u7EDF\u7684\u4E58\u5BA2\uFF0C\u5EFA\u9020\u4E00\u4E2A\u65B0\u7684\u591A\u5C42\u2018\u505C\u8F66\u8F6C\u4E58\u2019\uFF08Park\u0026amp;Ride\uFF09\u505C\u8F66\u8BBE\u65BD\uFF0C\u6DB5\u76D61500\u4E2A\u505C\u8F66\u4F4D\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u65B9\u4FBF\u67D4\u65B0\u901A\u52E4\u8005\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u9646\u5146\u798F\u4ECA\u65E5\u89C1\u8BC1\u6377\u8FD0\u516C\u53F8\uFF08MRT Corp\uFF09\u4E0ECoronade Properties\u79C1\u4EBA\u6709\u9650\u516C\u53F8\uFF08CPSB\uFF09\u7B7E\u7F72\u4E70\u5356\u534F\u8BAE\u65F6\uFF0C\u8FD9\u4E48\u8BF4\u3002\u003C/p\u003E\n\u003Cp\u003E\u6377\u8FD0\u516C\u53F8\uFF08MRT Corp\uFF09\u901A\u8FC7\u5176\u5B50\u516C\u53F8\u5927\u9A6C\u6377\u8FD0\u79C1\u4EBA\u6709\u9650\u516C\u53F8\uFF08MRTS\uFF09\u4E0ECoronade Properties\u79C1\u4EBA\u6709\u9650\u516C\u53F8\uFF08CPSB\uFF09\u7B7E\u7F72\u4E70\u5356\u534F\u8BAE\uFF0C\u4EE5\u6536\u8D2DCoronation\u5E7F\u573A\u7684781\u4E2A\u505C\u8F66\u4F4D\u3002\u003C/p\u003E\n\u003Cp\u003E\u8FD9\u4E9B\u505C\u8F66\u4F4D\u5C06\u5728\u67D4\u65B0\u6377\u8FD0\u7CFB\u7EDF\uFF08RTS\uFF09\u4E8E2026\u5E74\u5E95\u5F00\u59CB\u8425\u8FD0\u65F6\uFF0C\u4E13\u4F9B\u67D4\u65B0\u6377\u8FD0\u7CFB\u7EDF\u901A\u52E4\u8005\u4F7F\u7528\uFF0C\u4EE5\u8FDB\u4E00\u6B65\u52A0\u5F3A\u67D4\u4F5B\u65B0\u5C71\u548C\u65B0\u52A0\u5761\u4E4B\u95F4\u8DE8\u5883\u670D\u52A1\u7684\u8FDE\u901A\u6027\u4E0E\u53EF\u8FBE\u6027\u3002\u4E70\u5356\u534F\u8BAE\u662F\u7531\u6377\u8FD0\u516C\u53F8\u603B\u6267\u884C\u957F\u62FF\u7763\u83AB\u54C8\u672B\u624E\u91CC\u592B\u4E0ECoronade Properties\u4F01\u4E1A\u5173\u7CFB\u603B\u76D1\u62FF\u6C40\u5DF4\u90FD\u5361\u963F\u4E3D\u5A1C\u6240\u7B7E\u7F72\u3002\u003C/p\u003E\n\u003Cp\u003E\u9646\u5146\u798F\u8BF4\uFF1A\u201C\u901A\u8FC7\u8BE5\u534F\u8BAE\uFF0CCoronade Properties\u5C06\u5728\u8DDD\u79BB\u6B66\u5409\u67E5\u5361\u7AD9400\u7C73\u5916\u7684Coronation\u5E7F\u573A\uFF0C\u4E13\u95E8\u4E3A\u67D4\u65B0\u6377\u8FD0\u7CFB\u7EDF\u4E58\u5BA2\u989D\u5916\u63D0\u4F9B781\u4E2A\u7684\u6C7D\u8F66\u548C\u6469\u6258\u505C\u8F66\u4F4D\u3002\u201C\u003C/p\u003E\n\u003Cp\u003E\u201CCoronade Properties\u4E5F\u5C06\u5EFA\u9020\u4E00\u5EA7\u76F4\u63A5\u8FDE\u63A5Coronation\u5E7F\u573A\u4E0E\u65B0\u5C71\u82CF\u4E39\u4F9D\u65AF\u5E72\u8FBE\u5927\u53A6\uFF08CIQ\uFF09\u7684\u4EBA\u884C\u5929\u6865\uFF0C\u4EE5\u4FBF\u5C06\u6765\u67D4\u65B0\u6377\u8FD0\u7CFB\u7EDF\u4E58\u5BA2\u53EF\u4EE5\u4F7F\u7528\u8BE5\u4FBF\u5229\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4E0E\u4F1A\u8005\u8FD8\u6709\u6377\u8FD0\u516C\u53F8\u4E3B\u5E2D\u4E39\u65AF\u91CC\u5DF4\u5E0C\u5C14\u7B49\u4EBA\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/08/frc-ce934aebb2a248dc57b22b2efc32d1a7.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u9646\u5146\u798F\uFF08\u4E2D\uFF09\u89C1\u8BC1\u5927\u9A6C\u6377\u8FD0\u79C1\u4EBA\u6709\u9650\u516C\u53F8\uFF08MRTS\uFF09\u4E0ECoronade Properties\u7684\u4EE3\u8868\u7B7E\u7F72\u4E70\u5356\u534F\u8BAE\u3002\u5DE6\u8D77\u4E3ACoronade Properties\u8D44\u6DF1\u9879\u76EE\u7ECF\u7406\u963F\u65AF\u62C9\u53CA\u963F\u4E3D\u5A1C\u3002\u53F3\u8D77\u4E3A\u5DF4\u5E0C\u5C14\u53CA\u624E\u91CC\u592B\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u76FC\u9884\u7B97\u6848\u5EF6\u7EEDMy50\u6708\u7968\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u5BF9\u4E8E2025\u8D22\u653F\u9884\u7B97\u6848\u613F\u671B\uFF0C\u9646\u5146\u798F\u8BF4\uFF0C\u4EA4\u901A\u90E8\u5E0C\u671B\u660C\u660E\u653F\u5E9C\u6301\u7EED\u4F18\u5148\u5173\u6CE8\u516C\u5171\u4EA4\u901A\u7CFB\u7EDF\uFF0C\u5E76\u5E0C\u671BMy50\u6708\u7968\u5021\u8BAE\u80FD\u591F\u6301\u7EED\u4E0B\u53BB\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8868\u793A\uFF0C\u5982\u4ECA\u7684\u653F\u5E9C\u7684\u786E\u7ED9\u4E88\u4EA4\u901A\u90E8\u8DB3\u591F\u7684\u91CD\u89C6\uFF0C\u5C24\u5176\u662F\u5728\u516C\u5171\u4EA4\u901A\u9879\u76EE\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u4ECE\u62E8\u6B3E\u89D2\u5EA6\u6765\u770B\uFF0C\u6211\u4EEC\u7684\uFF08\u62E8\u6B3E\uFF09\u7684\u786E\u6709\u6240\u63D0\u5347\uFF0C\u8B6C\u5982My50\u6708\u7968\u5021\u8BAE\uFF0C\uFF08\u62E8\u6B3E\uFF09\u53BB\u5E74\u5DF2\u7ECF\u4ECE1\u4EBF\u4EE4\u5409\uFF0C\u63D0\u5347\u81F32\u4EBF\u4EE4\u5409\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u56E0\u6B64\uFF0C\u5E0C\u671B\u8FD9\u9879\u5021\u8BAE\u80FD\u591F\u5EF6\u7EED\u4E0B\u53BB\uFF0C\u4E3A\u5DF4\u751F\u8C37\u5730\u533A\u7684\u6C11\u4F17\uFF0C\u63D0\u4F9B\u4FBF\u5229\uFF0C\u5C24\u5176\u662F\u80FD\u591F\u4EE5\u6BCF\u670850\u4EE4\u5409\u7684\u4FBF\u5B9C\u4EF7\u683C\uFF0C\u83B7\u5F97\u516C\u5171\u4EA4\u901A\u670D\u52A1\u3002\u201C\u003C/p\u003E\n\u003Cp\u003E\u90E8\u957F\u8BF4\uFF0C\u6211\u4EEC\u5F53\u7136\u8981\u6C42\u660E\u5E74\u7EE7\u7EED\u8FD9\u9879\u5021\u8BAE\uFF0C\u5E76\u6307\u5982\u4ECA\u7528\u6237\u6570\u91CF\u4E5F\u6709\u6240\u589E\u957F\uFF0CMy50\u6708\u7968\u5021\u8BAE\u6570\u91CF\u5982\u4ECA\u6B63\u5728\u589E\u52A0\uFF0C\u6BCF\u6708\u5DF2\u8D85\u8FC720\u4E07\u4EBA\u6B21\u3002\u5DF4\u751F\u8C37\u7684\u94C1\u8DEF\u4E58\u5BA2\u5982\u4ECA\u6BCF\u65E5\u5E73\u5747\u63A5\u8FD190\u4E07\u4EBA\u6B21\uFF0C\u800C\u82E5\u4E5F\u628A\u5DF4\u58EB\u4E58\u5BA2\u8BA1\u7B97\u5728\u5185\uFF0C\u5DF4\u751F\u8C37\u6BCF\u65E5\u7684\u4E58\u5BA2\u91CF\u8D85\u8FC7110\u4E07\u4EBA\u6B21\u3002\u003C/p\u003E\n\u003Cp\u003E\u65E0\u8BBA\u5982\u4F55\uFF0C\u9646\u5146\u798F\u4E5F\u8BF4\uFF0C\u5F53\u5C40\u4E5F\u77E5\u9053\u5DF4\u751F\u8C37\u7684\u4E00\u5927\u95EE\u9898\u662F\u4EA4\u901A\u963B\u585E\uFF0C\u6240\u4EE5\u9700\u8981\u4E0D\u65AD\u52AA\u529B\u4EE5\u6539\u5584\u6211\u56FD\u7684\u516C\u5171\u4EA4\u901A\u7CFB\u7EDF\uFF0C\u8BA9\u66F4\u591A\u7684\u57CE\u5E02\u5C45\u6C11\u3001\u5DF4\u751F\u8C37\u7684\u4EBA\u6C11\u4F7F\u7528\u516C\u5171\u4EA4\u901A\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6240\u4EE5\uFF0C\u6211\u5E0C\u671B\u8D22\u653F\u90E8\u80FD\u5C06\u6211\u4EEC\u8981\u6C42\u7684\u6570\u9879\u5021\u8BAE\u4E0E\u9879\u76EE\uFF0C\u7EB3\u5165\u8003\u91CF\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u6C11\u822A\u5C40\u67E5JET VALET\u724C\u7167\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u9488\u5BF9\u838E\u963F\u5357\u827E\u7F8E\u5A1C\u57CE\u5C0F\u578B\u98DE\u673A\u5760\u673A\u4E8B\u6545\u5B8C\u6574\u62A5\u544A\u65E9\u524D\u6307\uFF0C\u5931\u4E8B\u98DE\u673A\u8425\u8FD0\u5546JET VALET\u79C1\u4EBA\u6709\u9650\u516C\u53F8\u5E76\u672A\u6709\u8425\u8FD0\u98DE\u673A\u7684\u724C\u7167\uFF0C\u9646\u5146\u798F\u8868\u793A\uFF0C\u4ED6\u5C06\u4EA4\u7531\u5927\u9A6C\u6C11\u822A\u5C40\u8FDB\u4E00\u6B65\u8C03\u67E5\u6B64\u4E8B\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u89E3\u91CA\uFF0CJET VALET\u662F\u4E00\u822C\u98DE\u673A\uFF0C\u5B83\u662F\u79C1\u4EBA\u98DE\u673A\u7684\u8425\u8FD0\u5546\uFF0C\u800C\u4E0D\u662F\u822A\u7A7A\u516C\u53F8\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u5728\u6267\u6CD5\u65B9\u9762\uFF0C\u6211\u4F1A\u4EA4\u7531\u5927\u9A6C\u6C11\u822A\u5C40\uFF0C\u8FDB\u4E00\u6B65\u8C03\u67E5\u4ED6\u4EEC\u662F\u5426\u8FDD\u53CD\u89C4\u5B9A\u6216\u4EFB\u4F55\u6CD5\u5F8B\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u82E5\u53D1\u73B0\u6D89\u53CA\u8FDD\u89C4\u884C\u4E3A\uFF0C\u5F53\u7136\u8981\u5BF9\uFF08\u6709\u5173\uFF09\u516C\u53F8\u91C7\u53D6\u76F8\u5E94\u7684\u884C\u52A8\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u81F3\u4E8E\u6B63\u526F\u673A\u5E08\u5BF9\u8C03\u4F4D\u7F6E\u4E00\u4E8B\uFF0C\u9646\u5146\u798F\u8BF4\uFF0C\u4EA4\u901A\u90E8\u65E0\u6CD5\u505A\u51FA\u56DE\u5E94\uFF0C\u56E0\u4E3A\u8FD9\u662F\u5F53\u5C40\u5C55\u5F00\u8C03\u67E5\u540E\u624D\u53D1\u73B0\uFF0C\u8087\u56E0\u662F\u7ECF\u8FC7\u822A\u7A7A\u4E8B\u6545\u8C03\u67E5\u5C40\uFF08BSKU\uFF09\u7684\u8BE6\u7EC6\u8C03\u67E5\u540E\uFF0C\u901A\u8FC7\u9ED1\u7BB1\u542C\u5230\u4ED6\u4EEC\u7684\u8C08\u8BDD\u5F55\u97F3\uFF0C\u624D\u77E5\u9053\u526F\u673A\u5E08\u5728\u4E3B\u673A\u5E08\u4F4D\u7F6E\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/5O19c_R83ohvNjWqiLFcUw\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
