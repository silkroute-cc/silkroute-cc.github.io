218\u7565\u4F4D\u7F6E\u6269\u5145\u5730\u5E93\uFF0C\u6216\u8FDB\u884C\u8054\u8425\u5408\u4F5C\u3002\u201D\u003C/p\u003E\n\u003Ch1\u003E\u7EFF\u76DB\u4E16\u903E4\u4EBF\u4EE4\u5409 \u5356\u5DE5\u4E1A\u5730\u7ED9\u5FAE\u8F6F\u652F\u4ED8\u003C/h1\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/06/frc-2a3b1bb2789eb3417bd75981dd89e970.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Ch1\u003E\uFF08\u5409\u9686\u576110\u65E5\u8BAF\uFF09\u7EFF\u76DB\u4E16\uFF08ECOWLD\uFF0C8206\uFF0C\u4E3B\u677F\u4EA7\u4E1A\u80A1\uFF09\u5BA3\u5E03\uFF0C\u4EE54\u4EBF230\u4E072175\u4EE4\u5409\uFF0C\u8131\u552E\u67D4\u4F5B\u5DE5\u4E1A\u5730\u5730\u7ED9\u5FAE\u8F6F\u652F\u4ED8\uFF08\u5927\u9A6C\uFF09\u79C1\u4EBA\u6709\u9650\u516C\u53F8\u3002\u003C/h1\u003E\n\u003Cp\u003E\u8BE5\u516C\u53F8\u5468\u4E00\u5411\u5927\u9A6C\u4EA4\u6613\u6240\u62A5\u5907\uFF0C\u5B50\u516C\u53F8\u5546\u4E1A\u56ED6\uFF08Eco Business Park VI\uFF09\u4E0E\u5FAE\u8F6F\u652F\u4ED8\u7B7E\u7F72\u4E70\u5356\u534F\u8BAE\u3002\u003C/p\u003E\n\u003Cp\u003E\u6839\u636E\u6587\u544A\uFF0C\u6709\u5173\u571F\u5730\u4F4D\u4E8E\u67D4\u4F5B\u53E4\u6765\uFF0C\u5360\u5730123.14\u82F1\u4EA9\u3002\u003C/p\u003E\n\u003Cp\u003E\u8BE5\u516C\u53F8\u8868\u793A\uFF0C\u8131\u552E\u6240\u5F97\u90E8\u5206\u5C06\u7528\u4F5C\u507F\u8FD8\u94F6\u884C\u8D37\u6B3E\uFF0C\u5269\u4E0B\u7684\u6B3E\u9879\u5C06\u7528\u4F5C\u5176\u4ED6\u7528\u9014\u3002\u003C/p\u003E\n\u003Cp\u003E\u7EFF\u76DB\u4E16\u81EA\u4ECA\u5E741\u670818\u65E5\u5B8C\u6210\u8D2D\u4E70\u571F\u5730\u540E\uFF0C\u5982\u4ECA\u5728\u77ED\u77ED6\u4E2A\u6708\u4FBF\u6210\u529F\u5B8C\u6210\u53E6\u4E00\u9879\u571F\u5730\u4E70\u5356\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u6599\u6253\u9020\u6570\u636E\u4E2D\u5FC3\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u6B64\u5916\uFF0C\u7EFF\u76DB\u4E16\u6307\u51FA\uFF0C\u76F8\u4FE1\u5FAE\u8F6F\u652F\u4ED8\u5C06\u628A\u76F8\u5173\u571F\u5730\u6253\u9020\u6210\u53E6\u4E00\u4E2A\u6570\u636E\u4E2D\u5FC3\uFF0C\u501F\u6B64\u80FD\u5E26\u52A8\u8BE5\u5546\u4E1A\u56ED\u7684\u5DE5\u4E1A\u4EA7\u54C1\u3002\u003C/p\u003E\n\u003Cp\u003E\u6709\u5173\u571F\u5730\u4EA4\u6613\u9884\u8BA1\u5C06\u57282025\u5E74\u4E0B\u534A\u5E74\u5B8C\u6210\u3002\u003C/p\u003E\n\u003Cp\u003E\u503C\u5F97\u6CE8\u610F\u7684\u662F\uFF0C\u65E9\u57284\u67084\u65E5\uFF0C\u5FAE\u8F6F\u652F\u4ED8\u4FBF\u4EE51\u4EBF3000\u4E07\u4EE4\u5409\uFF0C\u5411\u5409\u661F\u673A\u6784\uFF08CRESNDO\uFF0C6718\uFF0C\u4E3B\u677F\u4EA7\u4E1A\u80A1\uFF09\u8D2D\u4E70\u4F4D\u4E8E\u67D4\u4F5B\u84B2\u83B1\u7684\u571F\u5730\u3002\u003C/p\u003E\n\u003Ch1\u003E\u6570\u636E\u4E2D\u5FC3\u5408\u7EA6\u589E\u81F332\u4EBF \u53CC\u5A01\u5EFA\u7B51\u80A1\u4EF7\u98D9\u65B0\u9AD8\u003C/h1\u003E\n\u003Cp\u003E\uFF08\u5409\u9686\u576111\u65E5\u8BAF\uFF09\u6570\u636E\u4E2D\u5FC3\u5408\u7EA6\u6269\u5927\u81F332\u4EBF\u4EE4\u5409\uFF0C\u5E26\u52A8\u53CC\u5A01\u5EFA\u7B51\uFF08SUNCON\uFF0C5263\uFF0C\u4E3B\u677F\u5EFA\u7B51\u80A1\uFF09\u80A1\u4EF7\u4ECA\u65E5\u4E00\u5EA6\u98D9\u6DA817%\uFF0C\u81F33.87\u4EE4\u5409\u7684\u5386\u53F2\u65B0\u9AD8\uFF0C\u540C\u65F6\u4E5F\u83B7\u5F97\u5404\u5927\u6295\u884C\u7684\u9752\u7750\uFF0C\u7EE7\u7EED\u558A\u4E70\u8BE5\u80A1\u3002\u003C/p\u003E\n\u003Cp\u003E\u65E9\u57282022\u5E7412\u6708\u676A\uFF0C\u53CC\u5A01\u5EFA\u7B51\u4FBF\u83B7\u5F97Yellowwood\u4EA7\u4E1A\uFF08Yellowwood\uFF09\u9881\u53D1\u4EF7\u503C\u7EA617\u4EBF\u4EE4\u5409\u7684\u603B\u627F\u5305\u5408\u7EA6\uFF0C\u8D1F\u8D23\u67D4\u4F5B\u58EB\u5E74\u7EB3\u79D1\u6280\u56ED\uFF08STeP\uFF09\u7684\u6570\u636E\u4E2D\u5FC3\u5EFA\u7B51\u5DE5\u7A0B\u3002\u003C/p\u003E\n\u003Cp\u003E\u6309\u7167\u5F53\u65F6\u7684\u5408\u7EA6\uFF0C\u5DE5\u7A0B\u8303\u56F4\u5305\u62EC\u8BBE\u8BA1\u548C\u5EFA\u9020\u6253\u6869\u548C\u7ED3\u6784\u9884\u5236\u6DF7\u51DD\u571F\uFF1B\u5EFA\u9020\u6570\u636E\u4E2D\u5FC3\u4E3B\u697C\uFF1B\u5BF9\u673A\u7535\u670D\u52A1\u3001\u7535\u4FE1\u3001\u63A7\u5236\u548C\u5B89\u5168\u4EE5\u53CA\u4E3B\u8981\u8BBE\u5907\u7684\u5B89\u88C5\u53CA\u76F8\u5173\u5DE5\u7A0B\uFF1B\u8FD8\u6709\u5176\u4ED6\u5982\u9053\u8DEF\u3001\u6392\u6C34\u7CFB\u7EDF\u3001\u5916\u90E8\u673A\u7535\u670D\u52A1\u3001\u56F4\u680F\u95F8\u95E8\u7B49\u5916\u90E8\u9644\u5C5E\u5DE5\u7A0B\u3002\u003C/p\u003E\n\u003Cp\u003E\u8BE5\u5DE5\u7A0B\u8FDB\u5EA6\u5C06\u52063\u9636\u6BB5\u8FDB\u884C\uFF0C\u9884\u8BA1\u5C06\u5728\u4ECA\u5E74\u7B2C\u4E09\u5B63\u5B8C\u6210\uFF1B\u5982\u4ECA\uFF0C\u9996\u9636\u6BB5\u786E\u5B9E\u5DF2\u7ECF\u5B8C\u5DE5\uFF0C\u4F46Yellowwood\u7EE7\u7EED\u8FFD\u52A0\u7B2C4\u9636\u6BB5\u7684\u5DE5\u7A0B\uFF0C\u5E76\u5C06\u5408\u7EA6\u603B\u4EF7\u503C\u63D0\u9AD8\u81F332\u4EBF\u4EE4\u5409\uFF1B\u800C\u53CC\u5A01\u5EFA\u7B51\u9700\u572820\u4E2A\u6708\u5185\uFF0C\u5C062\u81F34\u9636\u6BB5\u7684\u5DE5\u7A0B\u5B8C\u6210\u3002\u003C/p\u003E\n\u003Cp\u003E\u8FC4\u4ECA\u4E3A\u6B62\uFF0C\u53CC\u5A01\u5EFA\u7B51\u672A\u5B8C\u6210\u8BA2\u5355\u603B\u989D\u4E3A79\u4EBF\u4EE4\u5409\uFF0C\u5F53\u4E2D\u4E5F\u7EB3\u5165\u4E86\u4ECA\u5E74\u83B7\u5F97\u7684\u65B0\u9879\u76EE\uFF0C\u4EE5\u53CA\u4E0A\u8FF0\u63D0\u53CA\u7684\u7B2C4\u9636\u6BB5\u5DE5\u7A0B\u3002\u003C/p\u003E\n\u003Cp\u003E\u80AF\u7EB3\u683C\u5206\u6790\u5458\u770B\u597D\u8FD9\u9879\u65B0\u589E\u5408\u7EA6\uFF0C\u540C\u65F6\uFF0C\u8FD8\u628A\u516C\u53F8\u4ECA\u660E\u8D22\u5E74\u7684\u51C0\u5229\u9884\u6D4B\uFF0C\u5206\u522B\u63D0\u9AD810%\u548C22%\uFF0C\u4E3B\u8981\u662F\u653E\u773C\u516C\u53F8\u5728\u8FD9\u4E24\u5E74\u5206\u522B\u80FD\u8D62\u53D640\u4EBF\u81F345\u4EBF\u4EE4\u5409\u7684\u5408\u7EA6\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E0D\u4EC5\u5982\u6B64\uFF0C\u5206\u6790\u5458\u8FD8\u5C06\u8BC4\u7EA7\u4ECE\u201C\u8DDF\u968F\u5927\u5E02\u201D\uFF0C\u63D0\u9AD8\u81F3\u201C\u8D85\u8D8A\u5927\u5E02\u201D\uFF0C\u800C\u76EE\u6807\u4EF7\u66F4\u662F\u5927\u5E45\u63D0\u9AD8\u81F33.85\u4EE4\u5409\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/06/frc-3ccd28d388a5caa24883b3f22f640158.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5927\u578B\u57FA\u5EFA\u9879\u76EE\u63A8\u52A8\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u5206\u6790\u5458\u4E50\u89C2\u770B\u5F85\u5EFA\u9020\u9886\u57DF\u5728\u4ECA\u5E74\u80FD\u8FCE\u6765\u91CD\u5927\u590D\u5174\uFF0C\u4E3B\u8981\u662F\u6709\u5927\u578B\u9879\u76EE\u5728\u540E\u63A8\u52A8\uFF0C\u5F53\u4E2D\u5305\u62EC\u6377\u8FD03\u53F7\u7EBF\uFF08MRT 3\uFF09\u3001\u6CDB\u5A46\u7F57\u6D32\u5927\u9053\uFF08Pan-Borneo Highway\uFF09\uFF0C\u548C\u69DF\u57CE\u8F7B\u5FEB\u94C1\uFF08LRT\uFF09\u7B49\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E0D\u4EC5\u5982\u6B64\uFF0C\u79C1\u8425\u5EFA\u9020\u5E02\u573A\u84EC\u52C3\u53D1\u5C55\uFF0C\u4EE5\u53CA\u66F4\u591A\u65B0\u534A\u5BFC\u4F53\u4EE3\u5DE5\u5382\u548C\u6570\u636E\u4E2D\u5FC3\u7684\u52A0\u5165\uFF0C\u4E3A\u5EFA\u9020\u9886\u57DF\u63D0\u4F9B\u66F4\u591A\u652F\u6491\u3002\u003C/p\u003E\n\u003Cp\u003E\u5206\u6790\u5458\u9884\u8BA1\uFF0C\u53CC\u5A01\u5EFA\u7B51\u76EE\u524D\u6B63\u5728\u653E\u773C\u80FD\u4ECE\u4E2D\u83B7\u5F97\u5408\u7EA6\uFF0C\u800C\u8FD9\u4E0D\u4EC5\u4EC5\u662F\u6570\u636E\u4E2D\u5FC3\u7684\u5EFA\u8BBE\u5408\u7EA6\uFF0C\u8FD8\u5305\u62EC\u80FD\u4ECE\u6BCD\u516C\u53F8\u548C\u59D0\u59B9\u516C\u53F8\u83B7\u5F97\u9879\u76EE\u3002\u003C/p\u003E\n\u003Cp\u003E\u94F6\u6CB3\u56FD\u9645\u8BC1\u5238\u548C\u5174\u4E1A\u6295\u884C\u7814\u7A76\uFF0C\u4E5F\u540C\u6837\u770B\u597D\u53CC\u5A01\u5EFA\u7B51\u7684\u6700\u65B0\u8FDB\u5C55\uFF0C\u8BA4\u4E3A\u8FD9\u662F\u4E00\u573A\u503C\u5F97\u5E86\u795D\u7684\u80DC\u5229\uFF0C\u56E0\u4E3A\u76F8\u4FE1\u7C7B\u4F3C\u7684\u5408\u7EA6\u6269\u5927\u5C06\u63A5\u8E2A\u800C\u6765\uFF0C\u5373\u5B8C\u6210\u9996\u4E2A\u9636\u6BB5\uFF0C\u76F8\u5173\u516C\u53F8\u5C31\u4F1A\u63A5\u7740\u9881\u53D1\u65B0\u9636\u6BB5\u3002\u003C/p\u003E\n\u003Cp\u003E\u5F53\u7136\uFF0C\u53CC\u5A01\u5EFA\u7B51\u9700\u8981\u66F4\u59A5\u5584\u7684\u5206\u914D\u4EBA\u624B\uFF0C\u786E\u4FDD\u5728\u4EBA\u529B\u4E00\u76F4\u90FD\u80FD\u5904\u5728\u6EE1\u8377\u72B6\u6001\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/wMMwnWQWBncto3pNDr207A\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
