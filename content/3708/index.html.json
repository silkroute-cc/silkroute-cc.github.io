  "canonicalUrlKey": "%e4%b8%96%e7%95%8c%e4%b8%8d%e5%8a%a8%e4%ba%a7%e8%81%94%e7%9b%9f%e5%8d%b0%e5%b0%bc%e8%bf%81%e9%83%bd%e5%9c%a8%e5%8d%b3-%e6%8a%95%e8%b5%84%e8%80%85%e5%ba%94%e6%8d%89%e7%b4%a7%e6%8a%95%e8%b5%84%e5%95%86",
  "route": "/3708/",
  "title": "\u4E16\u754C\u4E0D\u52A8\u4EA7\u8054\u76DF:\u5370\u5C3C\u8FC1\u90FD\u5728\u5373 \u6295\u8D44\u8005\u5E94\u6349\u7D27\u6295\u8D44\u5546\u673A",
  "summary": "\uFF08\u516B\u6253\u7075\u518D\u4E5F3\u65E5\u8BAF\uFF09\u5370\u5C3C\u8FC1\u90FD\u5728\u5373\uFF0C\u76EE\u524D\u5448\u73B0\u4E00\u63FD\u5B50\u6295\u8D44\u5546\u673A\uFF0C\u7B49\u5F85\u56FD\u5185\u5916\u6295\u8D44\u8005\u652B\u53D6\uFF01 \u4E16\u754C\u4E0D\u52A8\u4EA7\u8054\u76DF\uFF08FIABCI\uFF09\u4E9A\u592A\u533A\u4E3B\u5E2D\u9C81\u65AF\u654F\u8BF4\uFF0C\u9274\u4E8E\u6295\u8D44\u8005\u9AD8\u5EA6\u5173\u6CE8\u5370\u5C3C\u65B0\u9996\u90FD\u52AA\u5C71\u8FBE\u62C9\uFF08Nusantara\uFF09\u53D1\u5C55\u8BA1\u5212\uFF0C\u5370\u5C3C\u653F\u5E9C\u5C06\u6269\u5927\u73B0\u5728\u53D1\u5C55\u89C4\u6A21\u3002 \u4ED6\u4ECA\u5929\u5728\u201C\u5370\u5C3C\u9996\u90FD\u52AA\u5C71\u8FBE\u62C9\u6295\u8D44\u673A\u4F1A\u201D\u8BB2\u5EA7\u4F1A\u4E0A\u8BF4\uFF0C3\u95F4\u516C\u53F8\u5C06\u901A\u8FC7\u516C\u79C1\u5408\u8425\u6A21\u5F0F\u5174\u5EFA\u516C\u52A1\u5458\u623F\u5C4B\uFF0C\u8FD9\u9879\u6295\u8D44\u603B\u989D\u4E3A27\u4EBF1000\u4E07\u7F8E\u5143\uFF08121\u4EBF9500\u4E07\u4EE4\u5409\uFF09\u7684\u8BA1\u5212\u5C06\u5174\u5EFA184\u5EA7\u9AD8\u697C\uFF0C\u4F9B1\u4E074500\u540D\u516C\u52A1\u5458\u5C45\u4F4F\u3002 \u201C\u52AA\u5C71\u8FBE\u62C9\u5C06\u662F\u4E00\u4E2A\u53EF\u6301\u7EED\u68EE\u6797\u57CE\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/05/frc-3018c2bcecd01be62422dd2db9d27430.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\uFF08\u516B\u6253\u7075\u518D\u4E5F3\u65E5\u8BAF\uFF09\u5370\u5C3C\u8FC1\u90FD\u5728\u5373\uFF0C\u76EE\u524D\u5448\u73B0\u4E00\u63FD\u5B50\u6295\u8D44\u5546\u673A\uFF0C\u7B49\u5F85\u56FD\u5185\u5916\u6295\u8D44\u8005\u652B\u53D6\uFF01\u003C/p\u003E\n\u003Cp\u003E\u4E16\u754C\u4E0D\u52A8\u4EA7\u8054\u76DF\uFF08FIABCI\uFF09\u4E9A\u592A\u533A\u4E3B\u5E2D\u9C81\u65AF\u654F\u8BF4\uFF0C\u9274\u4E8E\u6295\u8D44\u8005\u9AD8\u5EA6\u5173\u6CE8\u5370\u5C3C\u65B0\u9996\u90FD\u52AA\u5C71\u8FBE\u62C9\uFF08Nusantara\uFF09\u53D1\u5C55\u8BA1\u5212\uFF0C\u5370\u5C3C\u653F\u5E9C\u5C06\u6269\u5927\u73B0\u5728\u53D1\u5C55\u89C4\u6A21\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u4ECA\u5929\u5728\u201C\u5370\u5C3C\u9996\u90FD\u52AA\u5C71\u8FBE\u62C9\u6295\u8D44\u673A\u4F1A\u201D\u8BB2\u5EA7\u4F1A\u4E0A\u8BF4\uFF0C3\u95F4\u516C\u53F8\u5C06\u901A\u8FC7\u516C\u79C1\u5408\u8425\u6A21\u5F0F\u5174\u5EFA\u516C\u52A1\u5458\u623F\u5C4B\uFF0C\u8FD9\u9879\u6295\u8D44\u603B\u989D\u4E3A27\u4EBF1000\u4E07\u7F8E\u5143\uFF08121\u4EBF9500\u4E07\u4EE4\u5409\uFF09\u7684\u8BA1\u5212\u5C06\u5174\u5EFA184\u5EA7\u9AD8\u697C\uFF0C\u4F9B1\u4E074500\u540D\u516C\u52A1\u5458\u5C45\u4F4F\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u52AA\u5C71\u8FBE\u62C9\u5C06\u662F\u4E00\u4E2A\u53EF\u6301\u7EED\u68EE\u6797\u57CE\u5E02\uFF0C\u4EC5\u670925%\u571F\u5730\u4E3A\u57CE\u5E02\u5EFA\u6210\u533A\uFF0C10%\u516C\u56ED\u53CA\u7CAE\u98DF\u751F\u4EA7\u533A\uFF0C\u4EE5\u53CA65%\u4E3A\u901A\u8FC7\u91CD\u65B0\u9020\u6797\u7684\u70ED\u5E26\u68EE\u6797\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u201C\u52AA\u5C71\u8FBE\u62C9\u79C9\u6301\u7EFF\u5316\u3001\u667A\u80FD\u3001\u5305\u5BB9\u3001\u6D3B\u529B\u53CA\u53EF\u6301\u7EED\u7684\u53D1\u5C55\u539F \u5219\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u6839\u636E\u5370\u5C3C\u52AA\u5C71\u8FBE\u62C9\u9996\u90FD\u7BA1\u7406\u5C40\u7684\u6570\u636E\uFF0C\u622A\u81F3\u4ECA\u5E742\u670815\u65E5\uFF0C\u903E150\u540D\u56FD\u5185\u5916\u6F5C\u5728\u6295\u8D44\u8005\u8868\u8FBE\u6709\u5174\u8DA3\u53C2\u4E0E\u65B0\u9996\u90FD\u7684\u5F00\u53D1\uFF0C\u5F53\u4E2D110\u540D\u6295\u8D44\u8005\u9012\u4EA4\u610F\u5411\u4E66\u3002\u003C/p\u003E\n\u003Cp\u003E35\u540D\u6F5C\u5728\u6295\u8D44\u8005\u6709\u5174\u8DA3\u6295\u8D44\u57FA\u7840\u8BBE\u65BD\u53CA\u516C\u7528\u4E8B\u4E1A\u3001\u8C18\u8BE2\u670D\u52A1\uFF0816\uFF09\u3001\u623F\u5C4B\uFF0813\uFF09\u3001\u6559\u80B2\uFF0811\uFF09\u3001\u5546\u4E1A\u53CA\u6DF7\u5408\u4F7F\u7528\uFF0810\uFF09\u3001\u79D1\u6280\uFF0810\uFF09\u3001\u4FDD\u5065\uFF087\uFF09\u3001\u56FD\u4F01\u53CA\u79C1\u4EBA\u9886\u57DF\u529E\u516C\u5BA4\uFF083\uFF09\uFF0C\u4EE5\u53CA\u516C\u5171\u9886\u57DF\u529E\u516C\u5BA4\uFF081\uFF09\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E3A\u4E86\u5438\u5F15\u56FD\u9645\u6295\u8D44\u8005\uFF0C\u5370\u5C3C\u653F\u5E9C\u65E9\u524D\u5BA3\u5E03\u4E00\u7CFB\u5217\u7A0E\u52A1\u51CF\u514D\u653F\u7B56\uFF0C\u4EFB\u4F55\u4F01\u4E1A\u5728\u65B0\u90FD\u6295\u8D44\u81F3\u5C11100\u4EBF\u5370\u5C3C\u76FE\uFF0C\u5C31\u53EF\u4EAB\u6709100%\u7684\u4F01\u4E1A\u7A0E\u51CF\u514D\uFF0C\u4F18\u60E0\u671F\u8FBE10\u5E74\u81F330\u5E74\u3002\u003C/p\u003E\n\u003Cp\u003E\u5EFA\u8BBE\u52AA\u5C71\u8FBE\u62C9\u9884\u8BA1\u987B\u8017\u8D44340\u4EBF\u7F8E\u5143\uFF08\u7EA61530\u4EBF\u4EE4\u5409\uFF09\uFF0C\u5176\u4E2D20%\u6765\u81EA\u56FD\u5BB6\u9884\u7B97\uFF0C\u5269\u4F5980\uFF05\u901A\u8FC7\u516C\u79C1\u8054\u8425\u6A21\u5F0F\uFF0C\u79C1\u4EBA\u4F01\u4E1A\u548C\u4E2A\u4EBA\u6295\u8D44\u7B79\u8D44\u3002\u003C/p\u003E\n\u003Cp\u003E\u9C81\u65AF\u654F\u8BF4\uFF0C\u52AA\u5C71\u8FBE\u62C9\u53EF\u671B\u57282024\u5E74\u4E0A\u534A\u5E74\u5BA3\u5E03\u4E3A\u65B0\u9996\u90FD\uFF0C\u5E76\u57285\u5E74\u5185\u5C06\u670940\u4E07\u540D\u516C\u52A1\u5458\u8FC1\u79FB\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C40\u4E07\u516C\u52A1\u5458\uFF0C\u52A0\u4E0A\u5BB6\u5EAD\u6210\u5458\uFF0C\u9884\u8BA1\u81F3\u5C11\u6709120\u4E07\u4EBA\u53E3\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u89E3\u91CA\uFF0C\u52AA\u5C71\u8FBE\u62C9\u4F4D\u4E8E\u5CC7\u91CC\u5DF4\u677F\uFF08Balikpapan\uFF09\u53CA\u6C99\u9A6C\u6797\u8FBE\uFF08Samarinda\uFF09\u4E24\u5927\u57CE\u5E02\u4E4B\u95F4\uFF0C\u5206\u522B\u62E5\u6709150\u4E07\u53CA120\u4E07\u4EBA\u53E3\uFF0C\u56E0\u6B64\u6F5C\u5728\u6295\u8D44\u8005\u6839\u672C\u4E0D\u5FC5\u62C5\u5FC3\u4F01\u4E1A\u56E0\u4EBA\u70DF\u7A00\u5C11\u800C\u65E0\u6CD5\u751F\u5B58\u7684\u95EE\u9898\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u65B0\u9996\u90FD\u52065\u9636\u6BB5\u5EFA\u8BBE\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u9C81\u65AF\u654F\u8868\u793A\uFF0C \u5370\u5C3C\u603B\u7EDF\u4F50\u79D1\u4E8E2019\u5E74\u5BA3\u5E03\u9996\u90FD\u8FC1\u79FB\u8BA1\u5212\uFF0C\u65B0\u9996\u90FD\u4F4D\u4E8E\u5A46\u7F57\u6D32\u4E1C\u52A0\u91CC\u66FC\u4E39\u7701\u4E00\u5757\u70ED\u5E26\u96E8\u6797\u8986\u76D6\u7684\u5730\u533A\uFF0C\u8DDD\u79BB\u96C5\u52A0\u8FBE\u7EA62000\u516C\u91CC\uFF0C\u4E26\u4E8E\u53BB\u5E74\u547D\u540D\u4E3A\u201C\u52AA\u5C71\u8FBE\u62C9\u201D\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u6839\u636E\u5370\u5C3C\u653F\u5E9C\u7684\u89C4\u5212\uFF0C\u52AA\u5C71\u8FBE\u62C9\u8BBE\u67099\u4E2A\u7ECF\u6D4E\u63A8\u52A8\u9886\u57DF\uFF0C\u5305\u62EC\u4E2D\u592E\u653F\u5E9C\u533A\u57DF\u3001\u7ECF\u6D4E\u4E0E\u91D1\u878D\u4E2D\u5FC3\u3001\u53EF\u518D\u751F\u80FD\u6E90\u533A\u3001\u65C5\u6E38\u4E0E\u4F11\u95F2\u3001\u6559\u80B2\u670D\u52A1\u3001\u9769\u65B0\u4E0E\u7814\u7A76\u3001\u519C\u4EA7\u54C1\u3001\u8D38\u6613\u4E0E\u7269\u6D41\u3001\u519C\u5DE5\u4E1A\uFF0C\u4EE5\u53CA\u6E14\u4E1A\u548C\u519C\u4E1A\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6307\u51FA\uFF0C\u52AA\u5C71\u8FBE\u62C9\u5C06\u5206\u4E3A\u4E94\u9636\u6BB5\u8FDB\u884C\u5EFA\u8BBE\u3002\u9996\u9636\u6BB5\uFF082022\u81F32024\u5E74\uFF09\u5EFA\u8BBE\u653F\u5E9C\u529E\u516C\u5927\u697C\u548C\u9053\u8DEF\u3001\u7535\u7F51\u7B49\u57FA\u7840\u8BBE\u65BD\uFF0C\u5E76\u8FC1\u79FB\u7279\u5B9A\u653F\u5E9C\u90E8\u95E8\u3002\u003C/p\u003E\n\u003Cp\u003E\u7B2C\u4E8C\u9636\u6BB5\uFF082025\u81F32029\u5E74\uFF09\u4E3A\u5DE9\u56FA\u6838\u5FC3\u5730\u533A\uFF0C\u6269\u5C55\u623F\u5C4B\u3001\u529E\u516C\u5BA4\u53CA\u5546\u4E1A\u533A\uFF0C\u7B2C\u4E09\u9636\u6BB5\uFF082030\u81F32034\u5E74\uFF09\u662F\u53D1\u5C55\u6559\u80B2\u4E0E\u536B\u751F\u9886\u57DF\uFF0C\u4EE5\u53CA\u9AD8\u79D1\u6280\u884C\u4E1A\uFF0C\u7B2C\u56DB\u9636\u6BB5\uFF082040\u81F32045\u5E74\uFF09\u5219\u4E3A\u5DE9\u56FA\u4F5C\u4E3A\u201C\u6240\u6709\u4EBA\u7684\u4E16\u754C\u57CE\u5E02\u201D\u7684\u58F0\u8A89\uFF1B\u6574\u4E2A\u5F00\u53D1\u5EFA\u8BBE\u8FC7\u7A0B\u9884\u8BA1\u6301\u7EED\u52302045\u5E74\u3002\n\n\u8C08\u5230\u8FC1\u90FD\u540E\uFF0C\u96C5\u52A0\u8FBE\u7684\u53D1\u5C55\uFF0C\u9C81\u65AF\u654F\u8868\u793A\uFF0C\u5C4A\u65F6\u96C5\u52A0\u8FBE\u5C06\u72B9\u5982\u7F8E\u56FD\u7EBD\u7EA6\uFF0C\u6210\u4E3A\u65C5\u6E38\u53CA\u91D1\u878D\u4E2D\u5FC3\uFF0C\u4ECD\u65E7\u4F1A\u7EE7\u7EED\u524D\u8FDB\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/bX1Eq5Go-eDPqS3Dx2DpoA\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
