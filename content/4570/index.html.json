{
  "id": "%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e5%89%af%e9%a6%96%e7%9b%b8%ef%bc%9a%e5%8a%a0%e5%9f%94%e6%8b%9f%e5%bb%ba%e6%96%b0%e5%8f%91%e7%94%b5%e5%8e%82",
  "slug": "%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e5%89%af%e9%a6%96%e7%9b%b8%ef%bc%9a%e5%8a%a0%e5%9f%94%e6%8b%9f%e5%bb%ba%e6%96%b0%e5%8f%91%e7%94%b5%e5%8e%82",
  "canonicalUrlKey": "%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e5%89%af%e9%a6%96%e7%9b%b8%ef%bc%9a%e5%8a%a0%e5%9f%94%e6%8b%9f%e5%bb%ba%e6%96%b0%e5%8f%91%e7%94%b5%e5%8e%82",
  "route": "/4570/",
  "title": "\u9A6C\u6765\u897F\u4E9A\u526F\u9996\u76F8\uFF1A\u52A0\u57D4\u62DF\u5EFA\u65B0\u53D1\u7535\u5382",
  "summary": "\uFF08\u5409\u9686\u576127\u65E5\u8BAF\uFF09\u526F\u9996\u76F8\u62FF\u7763\u65AF\u91CC\u6CD5\u8FEA\u62C9\u8868\u793A\uFF0C\u4E0E\u53EF\u518D\u751F\u80FD\u6E90\uFF08TBB\uFF09\u76F8\u5173\u7684\u56FD\u5916\u6216\u56FD\u5185\u6295\u8D44\u94FE\u5C06\u5168\u9762\u8003\u8651\u5404\u4E2A\u65B9\u9762\uFF0C\u4ECE\u6295\u8D44\u3001\u5546\u4E1A\u3001\u6280\u672F\u548C\u793E\u4F1A\u89D2\u5EA6\uFF0C\u8FD8\u9700\u8981\u9075\u5B88\u5305\u62EC\u73AF\u5883\u5728\u5185\u7684\u6BCF\u4E00\u9879\u89C4\u5219\u548C\u653F\u7B56\u3002 \u4ED6\u5F3A\u8C03\uFF0C\u592A\u9633\u80FD\u7684\u6295\u8D44\u9700\u8981\u5927\u9762\u79EF\u571F\u5730\u53CA\u9002\u5408\u5EFA\u8BBE\u519C\u573A\u7684\u5730\u6BB5\uFF0C\u540C\u65F6\u4E5F\u6D89\u53CA\u5927\u91CF\u8D44\u91D1\u3002 \u201C\u4E00\u822C\u6765\u8BF4\uFF0C\u4EE5\u76EE\u524D\u7684\u901F\u5EA6\uFF0C\u6BCF1\u5343\u74E6\uFF08KW\uFF09\uFF08\u592A\u9633\u80FD\uFF09\u6211\u4EEC\u9700\u8981\u82B1\u8D39\u7EA64000\u4EE4\u5409\u3002\u60F3\u8C61\u4E00\u4E0B\uFF0C\u5982\u679C\u6211\u4EEC\u60F3\u8981\u63D0\u4F9B1000\u5146\u74E6\uFF08MW\uFF09\uFF0C\u8FD9\u610F\u5473\u7740\u5C06\u6295\u8D4440\u4EBF\u4EE4\u5409\u7528\u4E8E\u80FD\u6E90\u4F9B\u5E94\u3002 \u201C\u7136\u800C\uFF0C\u592A\u9633\u80FD\u6BCF\u5929\u53EA\u80FD\u63D0\u4F9B\uFF08\u80FD\u91CF\uFF094\u81F3\u2026",
  "body": "\u003Cp\u003E\uFF08\u5409\u9686\u576127\u65E5\u8BAF\uFF09\u526F\u9996\u76F8\u62FF\u7763\u65AF\u91CC\u6CD5\u8FEA\u62C9\u8868\u793A\uFF0C\u4E0E\u53EF\u518D\u751F\u80FD\u6E90\uFF08TBB\uFF09\u76F8\u5173\u7684\u56FD\u5916\u6216\u56FD\u5185\u6295\u8D44\u94FE\u5C06\u5168\u9762\u8003\u8651\u5404\u4E2A\u65B9\u9762\uFF0C\u4ECE\u6295\u8D44\u3001\u5546\u4E1A\u3001\u6280\u672F\u548C\u793E\u4F1A\u89D2\u5EA6\uFF0C\u8FD8\u9700\u8981\u9075\u5B88\u5305\u62EC\u73AF\u5883\u5728\u5185\u7684\u6BCF\u4E00\u9879\u89C4\u5219\u548C\u653F\u7B56\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u5F3A\u8C03\uFF0C\u592A\u9633\u80FD\u7684\u6295\u8D44\u9700\u8981\u5927\u9762\u79EF\u571F\u5730\u53CA\u9002\u5408\u5EFA\u8BBE\u519C\u573A\u7684\u5730\u6BB5\uFF0C\u540C\u65F6\u4E5F\u6D89\u53CA\u5927\u91CF\u8D44\u91D1\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u4E00\u822C\u6765\u8BF4\uFF0C\u4EE5\u76EE\u524D\u7684\u901F\u5EA6\uFF0C\u6BCF1\u5343\u74E6\uFF08KW\uFF09\uFF08\u592A\u9633\u80FD\uFF09\u6211\u4EEC\u9700\u8981\u82B1\u8D39\u7EA64000\u4EE4\u5409\u3002\u60F3\u8C61\u4E00\u4E0B\uFF0C\u5982\u679C\u6211\u4EEC\u60F3\u8981\u63D0\u4F9B1000\u5146\u74E6\uFF08MW\uFF09\uFF0C\u8FD9\u610F\u5473\u7740\u5C06\u6295\u8D4440\u4EBF\u4EE4\u5409\u7528\u4E8E\u80FD\u6E90\u4F9B\u5E94\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u7136\u800C\uFF0C\u592A\u9633\u80FD\u6BCF\u5929\u53EA\u80FD\u63D0\u4F9B\uFF08\u80FD\u91CF\uFF094\u81F35\u5C0F\u65F6\uFF0C\u7136\u540E\u9700\u8981\u7535\u6C60\u6765\u2018\u6062\u590D\u2019\u6216\u4FDD\u5B58\u80FD\u91CF\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u8FD9\u662F\u4E3A\u4E86\u4F7F\uFF08\u80FD\u6E90\uFF09\u80FD\u591F\u6301\u7EED\u4F9B\u5E94\u5230\u7535\u7F51\uFF0C\u4EE5\u786E\u4FDD\u5176\u7A33\u5B9A\u548C\u5B89\u5168\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u4ECA\u5929\u5728\u4E0B\u8BAE\u9662\u7684\u95EE\u7B54\u73AF\u8282\u4E2D\uFF0C\u56DE\u7B54\u56FD\u76DF\u4F0A\u65AF\u5170\u515A\u52A0\u57D4\u56FD\u4F1A\u8BAE\u5458\u54C8\u4E3D\u739B\u533B\u751F\u63D0\u51FA\u6709\u5173\u53EF\u518D\u751F\u80FD\u6E90\u6295\u8D44\u540E\uFF0C\u5E26\u6765\u7684\u6210\u672C\u3001\u793E\u4F1A\u4EE5\u53CA\u5BF9\u653F\u5E9C\u62E5\u6709\u7684\u80FD\u6E90\u5B50\u516C\u53F8\u7684\u5F71\u54CD\uFF0C\u4F5C\u51FA\u56DE\u5E94\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u52A0\u57D4\u62DF\u5EFA\u65B0\u53D1\u7535\u5382\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u4E0E\u6B64\u540C\u65F6\uFF0C\u6CD5\u8FEA\u62C9\u8868\u793A\uFF0C\u653F\u5E9C\u6B63\u8BA1\u5212\u5EFA\u9020\u4E00\u5EA7\u65B0\u53D1\u7535\u5382\uFF0C\u53D6\u4EE3\u96EA\u5170\u83AA\u52A0\u57D4\u53D1\u7535\u7AD9\u7684\u71C3\u7164\u53D1\u7535\u7AD9\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u4E0A\u8FF0\u53D1\u7535\u7AD9\u4EE5\u71C3\u7164\u4E3A\u57FA\u7840\uFF0C\u5230\u4E86\u4E00\u5B9A\u7684\u65F6\u5019\uFF0C\u5C31\u4E0D\u518D\u8D77\u4F5C\u7528\uFF0C\u56E0\u4E3A\u5B83\u5FC5\u987B\u8F6C\u6362\uFF0C\u8981\u4E48\u4F7F\u7528\u5929\u7136\u6C14\uFF0C\u8981\u4E48\u4F7F\u7528\u5176\u4ED6\u6765\u6E90\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u4EEC\u76EE\u524D\u7684\u8BA1\u5212\u662F\uFF0C\u7A0D\u540E\u6211\u4EEC\u5C06\u5728\u52A0\u57D4\u5EFA\u9020\u4E00\u5EA7\u65B0\u7684\u53D1\u7535\u5382\uFF0C\u4F7F\u7528\u5929\u7136\u6C14\u6216\u5176\u4ED6\u6765\u6E90\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u6CD5\u8FEA\u62C9\u8BF4\uFF0C\u4ED6\u4E5F\u662F\u80FD\u6E90\u8F6C\u578B\u548C\u6C34\u8F6C\u578B\u90E8\u957F\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5F00\u53D1\u987C\u76EE\u987B\u900F\u660E\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u6CD5\u8FEA\u62C9\u56DE\u7B54\u884C\u52A8\u515A\u84B2\u79CD\u56FD\u4F1A\u8BAE\u5458\u6768\u7F8E\u76C8\u7684\u63D0\u95EE\u65F6\u8868\u793A\uFF0C\u653F\u5E9C\u575A\u6301\u653F\u7B56\uFF0C\u5373\u56FD\u5185\u53EF\u518D\u751F\u80FD\u6E90\u9879\u76EE\u7684\u5F00\u53D1\u5BA1\u6279\u5FC5\u987B\u900F\u660E\u3001\u516C\u5E73\u5E76\u57FA\u4E8E\u76EE\u524D\u76D1\u7BA1\u89C4\u5B9A\u8FDB\u884C\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u963F\u8054\u914B\u6E05\u6D01\u80FD\u6E90\u5DE8\u5934\u2014\u963F\u5E03\u624E\u6BD4\u672A\u6765\u80FD\u6E90\u516C\u53F8\uFF08Masdar\uFF09\u7684\u6295\u8D44\u9700\u8981\u901A\u8FC7\u53C2\u4E0E\u6B63\u5728\u5B9E\u65BD\u548C\u5373\u5C06\u5B9E\u65BD\u7684\u73B0\u6709\u53EF\u518D\u751F\u80FD\u6E90\u8BA1\u5212\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u653F\u5E9C\u8FD8\u89C4\u5212\u548C\u8D77\u8349\u5B9E\u65BD\u7B2C\u4E09\u65B9\u63A5\u5165\uFF08TPA\uFF09\uFF0C\u4F7F\u5F00\u53D1\u5546\u80FD\u591F\u5229\u7528\u516C\u7528\u4E8B\u4E1A\u516C\u53F8\u7684\u7535\u7F51\u57FA\u7840\u8BBE\u65BD\u76F4\u63A5\u5411\u6D88\u8D39\u8005\u63D0\u4F9B\u53EF\u518D\u751F\u80FD\u6E90\u7535\u529B\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u533A\u5206\u5404\u7C7B\u201C\u627F\u8D2D\u8005\u201D\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u201C\u8BE5\u6295\u8D44\u516C\u53F8\u7684\u53EF\u518D\u751F\u80FD\u6E90\u627F\u8D2D\u5546\u5C06\u6839\u636E\u8BE5\u516C\u53F8\u53C2\u4E0E\u7684\u53EF\u518D\u751F\u80FD\u6E90\u8BA1\u5212\u7C7B\u578B\u6765\u786E\u5B9A\u3002\u4F8B\u5982\uFF0C\u5982\u679C\u8BE5\u516C\u53F8\u53C2\u4E0E\u201C\u5927\u578B\u592A\u9633\u80FD\u201D(LSS) \u8BA1\u5212\uFF0C\u5219\u80FD\u6E90\u201C\u627F\u8D2D\u5546\u201D \u662F\u516C\u7528\u4E8B\u4E1A\u516C\u53F8\u6216\u56FD\u80FD\u516C\u53F8\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u5982\u679C\u6295\u8D44\u8005\u53C2\u4E0E\u5C4B\u9876\u592A\u9633\u80FD\u8BA1\u5212\uFF0C\u90A3\u4E48\u8BE5\u8BA1\u5212\u4E0B\u7684\u80FD\u6E90\u2018\u627F\u8D2D\u8005\u2019\u5C31\u662F\u7535\u529B\u7528\u6237\u672C\u4EBA\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u5982\u679C\u516C\u53F8\u672A\u6765\u53C2\u4E0E\u7B2C\u4E09\u65B9\u63A5\u5165\u8BA1\u5212\uFF0C\u90A3\u4E48\u4E0E\u5F00\u53D1\u5546\u6709\u5408\u540C\u5173\u7CFB\u7684\u4F01\u4E1A\u7528\u6237\u5C06\u6210\u4E3A\u53EF\u518D\u751F\u80FD\u6E90\u751F\u4EA7\u7684\u2018\u627F\u8D2D\u8005\u2019\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u603B\u4F53\u800C\u8A00\uFF0CMasdar\u548C\u5176\u4ED6\u53EF\u518D\u751F\u80FD\u6E90\u5F00\u53D1\u5546\u516C\u53F8\u6240\u7EB3\u5165\u7684\u65B0\u4EA7\u80FD\u5FC5\u987B\u57FA\u4E8E\u653F\u5E9C\u540C\u610F\u7684\u53D1\u7535\u89C4\u5212\u548C\u53D1\u5C55\uFF0C\u540C\u65F6\uFF0C\u8003\u8651\u5230\u6240\u6709\u7ECF\u6D4E\u3001\u6280\u672F\u548C\u76D1\u7BA1\u65B9\u9762\u7684\u56E0\u7D20\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u786E\u4FDD\u7535\u7F51\u7CFB\u7EDF\u5B89\u5168\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u201C\u8FD9\u79CD\u505A\u6CD5\u5C06\u786E\u4FDD\u592A\u9633\u80FD\u8D44\u6E90\u7684\u5F15\u5165\u662F\u2018\u95F4\u6B47\u6027\u2019\u7684\uFF0C\u4E0D\u4F1A\u5F71\u54CD\u7535\u7F51\u7CFB\u7EDF\u548C\u57FA\u7840\u8BBE\u65BD\u7684\u5BB9\u91CF\u548C\u5B89\u5168\uFF0C\u63D0\u4F9B\u516C\u5E73\u516C\u6B63\u7684\u673A\u4F1A\u548C\u7ADE\u4E89\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6B64\u5916\uFF0C\u4E5F\u7EF4\u62A4\u5F53\u5730\u53EF\u518D\u751F\u80FD\u6E90\u884C\u4E1A\u53C2\u4E0E\u8005\u7684\u5229\u76CA\uFF0C\u5E76\u786E\u4FDD\u6240\u6709\u7528\u6237\u7684\u7535\u529B\u4F9B\u5E94\uFF08\u5305\u62EC\u53EF\u518D\u751F\u80FD\u6E90\uFF09\u5177\u6709\u7ADE\u4E89\u529B\u7684\u4EF7\u683C\u548C\u5408\u7406\u7684\u7535\u4EF7\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/iyOffdQV2gq1tMbaT0HKNw\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
