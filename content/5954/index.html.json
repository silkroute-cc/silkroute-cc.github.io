{
  "id": "\u4E2D\u8D44\u4F01\u4E1A\u5408\u4F5C\u5728\u9A6C\u6765\u897F\u4E9A\u9739\u96F3\u5DDE\u6295\u8D4480\u4EBF\u4EE4\u5409\u5EFA\u8BBE\u6570\u636E\u4E2D\u5FC3",
  "slug": "\u4E2D\u8D44\u4F01\u4E1A\u5408\u4F5C\u5728\u9A6C\u6765\u897F\u4E9A\u9739\u96F3\u5DDE\u6295\u8D4480\u4EBF\u4EE4\u5409\u5EFA\u8BBE\u6570\u636E\u4E2D\u5FC3",
  "canonicalUrlKey": "\u4E2D\u8D44\u4F01\u4E1A\u5408\u4F5C\u5728\u9A6C\u6765\u897F\u4E9A\u9739\u96F3\u5DDE\u6295\u8D4480\u4EBF\u4EE4\u5409\u5EFA\u8BBE\u6570\u636E\u4E2D\u5FC3",
  "route": "/5954/",
  "title": "\u4E2D\u8D44\u4F01\u4E1A\u5408\u4F5C\u5728\u9A6C\u6765\u897F\u4E9A\u9739\u96F3\u5DDE\u6295\u8D4480\u4EBF\u4EE4\u5409\u5EFA\u8BBE\u6570\u636E\u4E2D\u5FC3",
  "summary": "NexQuantum 1\u6709\u9650\u516C\u53F8\u4E0E\u4E2D\u56FD\u82CF\u5DDE\u6866\u6C49\u79D1\u6280\u7B7E\u7F72\u6218\u7565\u5408\u4F5C\uFF0C\u5728\u9739\u96F3\u5DDE\u94F6\u8C37\u79D1\u6280\u56ED\u6253\u9020\u6295\u8D44\u989D\u9AD8\u8FBE80\u4EBF\u4EE4\u5409\u7684AI\u6570\u5B57\u56ED\u533A\uFF0C\u9996\u9636\u6BB5\u5C06\u5EFA\u8BBE32\u5146\u74E6Tier III\u6570\u636E\u4E2D\u5FC3\u3002\u8BE5\u56ED\u533A\u5C06\u6DB5\u76D6AI-Ready\u8BBE\u65BD\u3001\u4E91\u670D\u52A1\u3001\u667A\u80FD\u8FD0\u7EF4\u7B49\u9886\u57DF\uFF0C\u76EE\u524D\u9884\u79DF\u7387\u5DF2\u63A5\u8FD1100%\uFF0C\u5951\u5408\u9739\u96F3\u5DDE2030\u5E74\u6570\u5B57\u7ECF\u6D4E\u84DD\u56FE\u3002",
  "body": "\u003Cp\u003E\uFF08\u6021\u4FDD15\u65E5\u8BAF\uFF09NexQuantum 1\u6709\u9650\u516C\u53F8\u4E0E\u4E2D\u56FD\u82CF\u5DDE\u6866\u6C49\u79D1\u6280\u6628\u665A\u7B7E\u7F72\u6218\u7565\u5408\u4F5C\u4EEA\u5F0F\uFF0C\u643A\u624B\u5728\u94F6\u8C37\u79D1\u6280\u56ED\uFF08SVTP\uFF09\u6253\u9020\u6295\u8D44\u989D\u9AD8\u8FBE80\u4EBF\u4EE4\u5409\u7684\u4EBA\u5DE5\u667A\u80FD\uFF08AI\uFF09\u6570\u5B57\u56ED\u533A\uFF0C\u8FDB\u4E00\u6B65\u5F3A\u5316\u9739\u96F3\u5DDE\u7684\u533A\u57DF\u6570\u5B57\u67A2\u7EBD\u5730\u4F4D\u3002\u003C/p\u003E\n\u003Cp\u003E\u8BE5\u4EEA\u5F0F\u7531\u9739\u96F3\u5DDE\u4E09\u738B\u62C9\u60F9\u4F9D\u65AF\u5E72\u8FBE\u7956\u5361\u5948\u56E0\u4EB2\u4E34\u4E3B\u6301\uFF0C\u5E76\u7531\u9739\u96F3\u5DDE\u52A1\u5927\u81E3\u62FF\u7763\u65AF\u91CC\u6C99\u62C9\u5C3C\u89C1\u8BC1\u3002\u003C/p\u003E\n\u003Cp\u003E\u6839\u636E\u534F\u8BAE\uFF0C\u53CC\u65B9\u5C06\u6574\u5408\u672C\u5730\u9879\u76EE\u5F00\u53D1\u80FD\u529B\u4E0E\u56FD\u9645\u6280\u672F\u7ECF\u9A8C\uFF0C\u6253\u9020\u6DB5\u76D6AI-Ready\u8BBE\u65BD\u3001\u4E91\u670D\u52A1\u3001\u667A\u80FD\u8FD0\u7EF4\u3001\u53EF\u6301\u7EED\u53D1\u5C55\u3001\u4EBA\u624D\u57F9\u517B\u53CA\u533A\u57DF\u6570\u5B57\u8FDE\u63A5\u7684\u9AD8\u4EF7\u503C\u6570\u5B57\u751F\u6001\u7CFB\u7EDF\u3002\u003C/p\u003E\n\u003Cp\u003ENexQuantum 1\u6709\u9650\u516C\u53F8\u603B\u6267\u884C\u957F\u738B\u5EAD\u6587\u6307\u51FA\uFF0CNexQuantum AI\u6570\u7801\u56ED\u533A\u5C06\u5B9A\u4F4D\u4E3A\u957F\u671F\u7684\u6570\u5B57\u57FA\u7840\u8BBE\u65BD\u5E73\u53F0\uFF0C\u9884\u5EFA\u8BBE\u516B\u5EA7\u6570\u636E\u4E2D\u5FC3\u8BBE\u65BD\uFF0C\u603B\u5360\u5730140\u82F1\u4EA9\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u7B2C\u4E00\u9636\u6BB5NQ1\u8BA1\u5212\u5C06\u4E8E\u4ECA\u5E74\u52A8\u5DE5\uFF0C\u5E76\u6295\u516510\u4EBF\u4EE4\u5409\u5EFA\u8BBE\u5BB9\u91CF\u8FBE32\u5146\u74E6\u3001\u7B26\u5408Tier III\u7B49\u7EA7\u7684\u5927\u578B\u6570\u636E\u4E2D\u5FC3\uFF0C\u9884\u8BA1\u8017\u65F614\u4E2A\u6708\u7AE3\u5DE5\u3002\u003C/p\u003E\n\u003Cp\u003E\u201CAI-Ready\u6570\u636E\u4E2D\u5FC3\u57FA\u7840\u8BBE\u65BD\u7684\u9700\u6C42\u76EE\u524D\u4F9D\u7136\u5F3A\u52B2\uFF0C\u5C24\u5176\u5728\u4E1C\u76DF\u533A\u57DF\u5E02\u573A\u66F4\u4E3A\u660E\u663E\u3002\u201D\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/mmbiz_png/ToPyia4QzxmSfVtajdkgzicOuyV07n506uibwj7zxfWgiaJu9aibd9siajcpkc6orA4DKrvpicciatOf91DxgUO4hWOC2c8wFhXKfnic6wicKuEgG6IE0/640?wx_fmt=png\u0026amp;from=appmsg\u0026amp;watermark=1#imgIndex=0\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u9739\u96F3\u5DDE\u4E09\u738B\u62C9\u60F9\u4F9D\u65AF\u5E72\u8FBE\u7956\u5361\u5948\u56E0\uFF08\u5DE6\u4E09\uFF09\u4EB2\u4E34\u73B0\u573A\u4E3B\u6301\u4EEA\u5F0F\uFF0C\u524D\u6392\u5DE6\u8D77\u4E3A\u83AB\u54C8\u672B\u624E\u5E0C\u3001\u6C99\u62C9\u5C3C\uFF1B\u53F3\u8D77\u4E3A\u5218\u706B\u5E73\u3001\u697C\u671D\u5B97\u4EE5\u53CA\u738B\u5EAD\u6587\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0CNQ1\u76EE\u524D\u9884\u79DF\u7387\u5DF2\u63A5\u8FD1100%\uFF0CNQ2\u9636\u6BB5\u7684\u6D3D\u8C08\u4EA6\u5DF2\u5C55\u5F00\uFF0C\u672A\u6765\u5404\u9636\u6BB5\u53D1\u5C55\u5C06\u4F9D\u636E\u5E02\u573A\u9700\u6C42\u53CA\u79DF\u6237\u843D\u5B9E\u60C5\u51B5\u9010\u6B65\u63A8\u8FDB\u3002\u003C/p\u003E\n\u003Cp\u003E\u5951\u5408\u6570\u5B57\u7ECF\u6D4E\u003C/p\u003E\n\u003Cp\u003E\u9739\u96F3\u5DDE\u53D1\u5C55\u673A\u6784\uFF08PKNPk\uFF09\u603B\u6267\u884C\u957F\u62FF\u7763\u91CC\u624E\u62C9\u83F2\u5219\u5F3A\u8C03\uFF0C\u6570\u5B57\u57FA\u7840\u8BBE\u65BD\u5DF2\u4E0D\u518D\u53EA\u662F\u4E00\u4E2A\u9009\u9879\uFF0C\u800C\u662F\u786E\u4FDD\u957F\u671F\u7ECF\u6D4E\u7ADE\u4E89\u529B\u7684\u91CD\u8981\u57FA\u7840\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0CNexQuantum AI\u6570\u7801\u56ED\u533A\u7684\u843D\u6237\u5C06\u4E3A\u9739\u96F3\u5DDE\u6574\u4F53\u7ECF\u6D4E\u5E26\u6765\u4E58\u6570\u6548\u5E94\uFF0C\u4E0E2030\u5E74\u9739\u96F3\u7E41\u8363\u84DD\u56FE\u7B2C\u5341\u4E00\u8BAE\u7A0B\u201C\u6570\u5B57\u7ECF\u6D4E\u201D\u7684\u65B9\u5411\u9AD8\u5EA6\u5951\u5408\uFF0C\u7B26\u5408\u9739\u96F3\u5DDE\u5438\u5F15\u672A\u6765\u5BFC\u5411\u53CA\u9AD8\u5F71\u54CD\u529B\u6295\u8D44\u7684\u6218\u7565\u5B9A\u4F4D\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u8BE5\u6570\u7801\u56ED\u533A\u5E76\u975E\u77ED\u671F\u8BA1\u5212\uFF0C\u800C\u662F\u4E00\u4E2A\u5177\u5907\u533A\u57DF\u53D1\u5C55\u6F5C\u529B\u7684\u957F\u671F\u79D1\u6280\u4E0E\u6295\u8D44\u5E73\u53F0\uFF0C\u5C06\u5E26\u52A8\u9AD8\u6280\u80FD\u4EBA\u624D\u9700\u6C42\uFF0C\u8BA9\u672C\u5730\u627F\u5305\u5546\u3001\u987E\u95EE\u53CA\u5DE5\u7A0B\u5E08\u53D7\u60E0\uFF0C\u540C\u65F6\u4E3A\u4E2D\u5C0F\u4F01\u4E1A\u4E0E\u6570\u5B57\u521B\u4E1A\u8005\u521B\u9020\u5916\u6EA2\u6548\u5E94\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4E0E\u4F1A\u8005\u5305\u62EC\u9739\u96F3\u5DDE\u8BAE\u957F\u83AB\u54C8\u672B\u624E\u5E0C\u3001\u82CF\u5DDE\u6866\u6C49\u79D1\u6280\u8463\u4E8B\u957F\u697C\u671D\u5B97\u3001\u82CF\u5DDE\u6866\u53EF\u89C6\u79D1\u6280\u6709\u9650\u516C\u53F8\u9996\u5E2D\u6267\u884C\u5B98\u5218\u706B\u5E73\u3001\u6866\u6C49\u79D1\u6280\u9A6C\u6765\u897F\u4E9A\u603B\u7ECF\u7406\u5434\u666E\u5E86\u4EE5\u53CANexQuantum 1\u6709\u9650\u516C\u53F8\u6267\u884C\u8463\u4E8B\u5F20\u7FE0\u8BD7\u535A\u58EB\u3002\u003C/p\u003E\n",
