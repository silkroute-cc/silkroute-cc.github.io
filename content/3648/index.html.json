{
  "id": "%e5%b1%b1%e8%a5%bf%e6%96%87%e5%8c%96%e6%97%85%e6%b8%b8%e6%8e%a8%e4%bb%8b%e4%bc%9a%e5%9c%a8%e5%90%89%e9%9a%86%e5%9d%a1%e4%b8%be%e8%a1%8c",
  "slug": "%e5%b1%b1%e8%a5%bf%e6%96%87%e5%8c%96%e6%97%85%e6%b8%b8%e6%8e%a8%e4%bb%8b%e4%bc%9a%e5%9c%a8%e5%90%89%e9%9a%86%e5%9d%a1%e4%b8%be%e8%a1%8c",
  "canonicalUrlKey": "%e5%b1%b1%e8%a5%bf%e6%96%87%e5%8c%96%e6%97%85%e6%b8%b8%e6%8e%a8%e4%bb%8b%e4%bc%9a%e5%9c%a8%e5%90%89%e9%9a%86%e5%9d%a1%e4%b8%be%e8%a1%8c",
  "route": "/3648/",
  "title": "\u5C71\u897F\u6587\u5316\u65C5\u6E38\u63A8\u4ECB\u4F1A\u5728\u5409\u9686\u5761\u4E3E\u884C",
  "summary": "\u5C71\u897F\u6587\u5316\u65C5\u6E38(\u9A6C\u6765\u897F\u4E9A)\u63A8\u4ECB\u4F1A13\u65E5\u5728\u5409\u9686\u5761\u4E3E\u884C\u3002\u51FA\u5E2D\u6D3B\u52A8\u7684\u5C71\u897F\u7701\u6587\u5316\u548C\u65C5\u6E38\u5385\u5385\u957F\u738B\u7231\u7434\u8868\u793A\uFF0C\u671F\u5F85\u901A\u8FC7\u6B64\u4E00\u6D3B\u52A8\uFF0C\u52A0\u5F3A\u5C71\u897F\u548C\u9A6C\u6765\u897F\u4E9A\u4E24\u5730\u65C5\u6E38\u5408\u4F5C\uFF0C\u4FC3\u8FDB\u5BF9\u65B9\u6E38\u5BA2\u56DE\u5F52\uFF0C\u4E3A\u65C5\u6E38\u4E1A\u548C\u7ECF\u6D4E\u590D\u82CF\u589E\u6DFB\u52A9\u529B\u3002 \u738B\u7231\u7434\u5728\u63A8\u4ECB\u6D3B\u52A8\u4E0A\u81F4\u8F9E \u738B\u7231\u7434\u4ECB\u7ECD\uFF0C\u5C71\u897F\u5386\u53F2\u539A\u91CD\u3001\u6587\u5316\u707F\u70C2\uFF0C\u662F\u4E2D\u534E\u6587\u660E\u91CD\u8981\u53D1\u7965\u5730\uFF0C\u6587\u5316\u65C5\u6E38\u8D44\u6E90\u4E30\u5BCC\u591A\u5F69\u3002\u8FD1\u5E74\u6765\uFF0C\u5C71\u897F\u65C5\u6E38\u57FA\u7840\u8BBE\u65BD\u65E5\u81FB\u5B8C\u5584\u6210\u719F\uFF0C\u56FD\u9645\u6E38\u5BA2\u8D74\u5C71\u897F\u65C5\u6E38\u65E5\u8D8B\u4FBF\u6377\uFF0C\u5C71\u897F\u6B63\u5728\u52A0\u5FEB\u5EFA\u8BBE\u56FD\u9645\u77E5\u540D\u65C5\u6E38\u76EE\u7684\u5730\uFF0C\u52AA\u529B\u4E3A\u5305\u62EC\u9A6C\u6765\u897F\u4E9A\u6E38\u5BA2\u5728\u5185\u7684\u56FD\u9645\u6E38\u5BA2\u63D0\u4F9B\u6E29\u99A8\u6EE1\u610F\u7684\u65C5\u6E38\u4F53\u9A8C\u3002\u2026",
  "body": "\u003Cp\u003E\u5C71\u897F\u6587\u5316\u65C5\u6E38(\u9A6C\u6765\u897F\u4E9A)\u63A8\u4ECB\u4F1A13\u65E5\u5728\u5409\u9686\u5761\u4E3E\u884C\u3002\u51FA\u5E2D\u6D3B\u52A8\u7684\u5C71\u897F\u7701\u6587\u5316\u548C\u65C5\u6E38\u5385\u5385\u957F\u738B\u7231\u7434\u8868\u793A\uFF0C\u671F\u5F85\u901A\u8FC7\u6B64\u4E00\u6D3B\u52A8\uFF0C\u52A0\u5F3A\u5C71\u897F\u548C\u9A6C\u6765\u897F\u4E9A\u4E24\u5730\u65C5\u6E38\u5408\u4F5C\uFF0C\u4FC3\u8FDB\u5BF9\u65B9\u6E38\u5BA2\u56DE\u5F52\uFF0C\u4E3A\u65C5\u6E38\u4E1A\u548C\u7ECF\u6D4E\u590D\u82CF\u589E\u6DFB\u52A9\u529B\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/04/frc-d6f07441d321433937e7d53685dfbcb3.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u738B\u7231\u7434\u5728\u63A8\u4ECB\u6D3B\u52A8\u4E0A\u81F4\u8F9E\u003C/p\u003E\n\u003Cp\u003E\u738B\u7231\u7434\u4ECB\u7ECD\uFF0C\u5C71\u897F\u5386\u53F2\u539A\u91CD\u3001\u6587\u5316\u707F\u70C2\uFF0C\u662F\u4E2D\u534E\u6587\u660E\u91CD\u8981\u53D1\u7965\u5730\uFF0C\u6587\u5316\u65C5\u6E38\u8D44\u6E90\u4E30\u5BCC\u591A\u5F69\u3002\u8FD1\u5E74\u6765\uFF0C\u5C71\u897F\u65C5\u6E38\u57FA\u7840\u8BBE\u65BD\u65E5\u81FB\u5B8C\u5584\u6210\u719F\uFF0C\u56FD\u9645\u6E38\u5BA2\u8D74\u5C71\u897F\u65C5\u6E38\u65E5\u8D8B\u4FBF\u6377\uFF0C\u5C71\u897F\u6B63\u5728\u52A0\u5FEB\u5EFA\u8BBE\u56FD\u9645\u77E5\u540D\u65C5\u6E38\u76EE\u7684\u5730\uFF0C\u52AA\u529B\u4E3A\u5305\u62EC\u9A6C\u6765\u897F\u4E9A\u6E38\u5BA2\u5728\u5185\u7684\u56FD\u9645\u6E38\u5BA2\u63D0\u4F9B\u6E29\u99A8\u6EE1\u610F\u7684\u65C5\u6E38\u4F53\u9A8C\u3002\u003C/p\u003E\n\u003Cp\u003E\u5979\u5E76\u8868\u793A\uFF0C\u5C71\u897F\u4E5F\u4F1A\u79EF\u6781\u521B\u9020\u6761\u4EF6\uFF0C\u4FC3\u8FDB\u5C71\u897F\u6C11\u4F17\u5230\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38\u89C2\u5149\uFF0C\u4F53\u9A8C\u9A6C\u6765\u897F\u4E9A\u72EC\u7279\u65C5\u6E38\u9B45\u529B\u3002\u5C71\u897F\u8FD8\u652F\u6301\u5F53\u5730\u65C5\u884C\u793E\u4E0E\u9A6C\u6765\u897F\u4E9A\u65C5\u884C\u793E\u5F00\u5C55\u5408\u4F5C\uFF0C\u652F\u6301\u65C5\u884C\u793E\u4E92\u9001\u5BA2\u6E90\uFF0C\u5171\u540C\u4FC3\u8FDB\u65C5\u6E38\u4E1A\u7684\u7E41\u8363\u548C\u53D1\u5C55\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/04/frc-11adf562b53a80535019f909b621b959.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u63A8\u4ECB\u4F1A\u5145\u5206\u5C55\u793A\u5C71\u897F\u4E30\u5BCC\u6587\u5316\u65C5\u6E38\u8D44\u6E90\u3000\u9648\u60A6\u3000\u6444\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38\u3001\u827A\u672F\u548C\u6587\u5316\u90E8\u56FD\u9645\u5408\u4F5C\u53F8\u53F8\u957F\u6768\u5029\u76C8\u51FA\u5E2D\u5F53\u65E5\u6D3B\u52A8\u5E76\u8868\u793A\uFF0C\u9A6C\u6765\u897F\u4E9A\u613F\u4E0E\u5C71\u897F\u52A0\u5F3A\u4E24\u5730\u65C5\u6E38\u6587\u5316\u4EA4\u6D41\uFF0C\u5E0C\u671B\u4E24\u5730\u65C5\u6E38\u6587\u5316\u754C\u5171\u540C\u52AA\u529B\uFF0C\u4E3A\u4E24\u56FD\u6587\u65C5\u4E8B\u4E1A\u53D1\u5C55\u8D21\u732E\u529B\u91CF\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/04/frc-bc6689a18037ae8ba4e018ca457c16fe.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38\u3001\u827A\u672F\u548C\u6587\u5316\u90E8\u56FD\u9645\u5408\u4F5C\u53F8\u53F8\u957F\u6768\u5029\u76C8\u51FA\u5E2D\u5F53\u65E5\u6D3B\u52A8\u5E76\u81F4\u8F9E\u003C/p\u003E\n\u003Cp\u003E\u636E\u6089\uFF0C\u672C\u6B21\u63A8\u5E7F\u8003\u5BDF\u56E2\u7531\u5C71\u897F\u7701\u6587\u5316\u548C\u65C5\u6E38\u5385\u5385\u957F\u738B\u7231\u7434\u4EB2\u81EA\u5E26\u961F\uFF0C\u4ECE4\u67087\u65E5\u81F316\u65E5\u8D74\u65B0\u52A0\u5761\u3001\u6CF0\u56FD\u3001\u9A6C\u6765\u897F\u4E9A\u4E3E\u529E\u6EE1\u610F\u65C5\u6E38\u5728\u5C71\u897F\u6587\u5316\u65C5\u6E38\u63A8\u5E7F\u6D3B\u52A8\uFF0C\u65E8\u5728\u5411\u6D77\u5916\u6E38\u5BA2\u5C55\u793A\u4E2D\u56FD\u5C71\u897F\u7701\u60A0\u4E45\u3001\u539A\u91CD\u3001\u7480\u74A8\u7684\u5386\u53F2\u6587\u5316\u5E95\u8574\u3001\u8FDB\u4E00\u6B65\u63D0\u5347\u5C71\u897F\u6587\u5316\u65C5\u6E38\u54C1\u724C\u5F62\u8C61\uFF0C\u52A0\u5F3A\u4E0E\u4E1C\u5357\u4E9A\u533A\u57DF\u56FD\u5BB6\u548C\u5730\u533A\u7684\u6587\u5316\u65C5\u6E38\u5408\u4F5C\uFF0C\u6269\u5927\u201C\u534E\u590F\u53E4\u6587\u660E\u0026#183;\u5C71\u897F\u597D\u98CE\u5149\u201D\u6587\u5316\u65C5\u6E38\u54C1\u724C\u7684\u77E5\u540D\u5EA6\u548C\u5F71\u54CD\u529B\uFF0C\u4FC3\u8FDB\u5C71\u897F\u6587\u5316\u65C5\u6E38\u4EA7\u4E1A\u5065\u5EB7\u3001\u5FEB\u901F\u53D1\u5C55\uFF0C\u8BA9\u4E16\u754C\u4EBA\u6C11\u4E86\u89E3\u5C71\u897F\u3001\u719F\u6089\u5C71\u897F\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/04/frc-02503461d3db1d0a3f5470682f72361c.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u738B\u7231\u7434(\u5DE6)\u5411\u6768\u5029\u76C8(\u53F3)\u8D60\u9001\u7EAA\u5FF5\u54C1 \u9648\u60A6 \u6444\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/04/frc-64f7580188e907f3c2d98380cbd0c310.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u51FA\u5E2D\u6D3B\u52A8\u5609\u5BBE\u4E3A\u5C71\u897F\u6587\u65C5\u70B9\u8D5E\u003C/p\u003E\n\u003Cp\u003E\u4E2D\u56FD\u9A7B\u9A6C\u6765\u897F\u4E9A\u5927\u4F7F\u9986\u6559\u80B2\u53C2\u8D5E\u8D75\u957F\u6D9B\u3001\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3(\u5409\u9686\u5761)\u4E3B\u4EFB\u5F20\u6770\u946B\u3001\u9A6C\u6765\u897F\u4E9A\u4E2D\u56FD\u4F01\u4E1A\u5BB6\u8054\u5408\u4F1A\u4F1A\u957F\u674E\u4E2D\u5E73\u53CA\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38\u754C\u4EBA\u58EB\u51FA\u5E2D\u4E86\u5F53\u65E5\u7684\u63A8\u4ECB\u4F1A\u3002\u63A8\u4ECB\u4F1A\u4E0A\u5145\u5206\u5C55\u793A\u5C71\u897F\u4E30\u5BCC\u591A\u5F69\u7684\u6587\u5316\u65C5\u6E38\u8D44\u6E90\uFF0C\u63A8\u4ECB\u4E86\u5C71\u897F\u7CBE\u54C1\u65C5\u6E38\u7EBF\u8DEF\uFF0C\u83B7\u5F97\u4E0E\u4F1A\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38\u754C\u4EBA\u58EB\u9AD8\u5EA6\u8BC4\u4EF7\u3002\u003C/p\u003E\n\u003Chr /\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u4E2D\u65B0\u7F51\u003C/p\u003E\n\u003Cp\u003E\u66F4\u591A\u7CBE\u5F69\uFF0C\u656C\u8BF7\u5173\u6CE8\uFF1A\u003C/p\u003E\n\u003Cp\u003E\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5B98\u7F51\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003Ehttps://www.chinaculturalcentre.my\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EFacebook\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u201CChina Cultural Centre in Kuala Lumpur\u201D\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u516C\u4F17\u53F7\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u201C\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u201D\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EYoutube\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u201CChina Cultural Centre in Kuala Lumpur\u201D\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003ETiktok\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u201CCCCKL\u201D\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u957F\u6309\u8BC6\u522B\u4E8C\u7EF4\u7801\n\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u83B7\u53D6\u66F4\u591A\u7CBE\u5F69\u5185\u5BB9\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u25BC\u003C/strong\u003E\n\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/04/frc-393d7a99f3f2b62d8101a4e46568d89f.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/04/frc-55a705354cac3bb838e283010202f339.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/04/frc-e592b6d7fcb0f17eb92480e99a800f61.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/04/frc-38bc8c97af1c04b93222b36dcb5bbbce.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/04/frc-66f61deeda48ac066eaadc74e0ff7ca3.gif\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5206\u4EAB\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/04/frc-4db2f23cf0e6f951e341b