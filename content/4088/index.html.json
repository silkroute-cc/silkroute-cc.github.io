  "route": "/4088/",
  "title": "\u6E56\u5357\u94C1\u9053\u643A\u624B\u9A6C\u6765\u897F\u4E9A\u4E2D\u8F66\u8F68\u9053\u4EA4\u901A\u88C5\u5907\u6709\u9650\u516C\u53F8\u5171\u5EFA\u201C\u9AD8\u94C1\u5DE5\u574A\u201D",
  "summary": "\u5171\u5EFA\u201C\u9AD8\u94C1\u5DE5\u574A\u201D\u643A\u624B\u51FA\u6D77 \u6E56\u5357\u94C1\u9053\u804C\u4E1A\u6280\u672F\u5B66\u9662\u575A\u6301\u624E\u6839\u8F68\u9053\uFF0C\u670D\u52A1\u4EA7\u4E1A\uFF0C\u6DF1\u8015\u8F68\u9053\u4EA4\u901A\u88C5\u5907\u5236\u9020\u5168\u4EA7\u4E1A\u94FE\uFF0C\u8DDF\u968F\u4E2D\u56FD\u4E2D\u8F66\u548C\u4E2D\u56FD\u94C1\u8DEF\u53D1\u5C55\uFF0C\u4F5C\u4E3A\u9996\u4E2A\u56FD\u5BB6\u8F68\u9053\u4EA4\u901A\u88C5\u5907\u884C\u4E1A\u4EA7\u6559\u878D\u5408\u5171\u540C\u4F53\u7684\u526F\u7406\u4E8B\u957F\u5355\u4F4D\u548C\u80FD\u529B\u5EFA\u8BBE\u90E8\u7684\u7275\u5934\u5355\u4F4D\uFF0C\u5B66\u6821\u4E0E\u4E2D\u56FD\u4E2D\u8F66\u80A1\u4EFD\u6709\u9650\u516C\u53F8\uFF08\u7B80\u79F0\u4E2D\u56FD\u4E2D\u8F66\uFF09\u6709\u7740\u957F\u671F\u7684\u826F\u597D\u5408\u4F5C\u5173\u7CFB\uFF0C\u4E2D\u56FD\u9AD8\u94C1\u5F00\u5230\u54EA\uFF0C\u54EA\u91CC\u5C31\u6709\u5B66\u6821\u5E08\u751F\u4EEC\u7684\u8EAB\u5F71\uFF1B\u4E2D\u8F66\u7684\u4EA7\u4E1A\u5EF6\u4F38\u5230\u54EA\uFF0C\u5B66\u6821\u7684\u670D\u52A1\u5C31\u4F34\u968F\u5230\u54EA\u3002\u9A6C\u6765\u897F\u4E9A\u4E2D\u8F66\u8F68\u9053\u4EA4\u901A\u88C5\u5907\u6709\u9650\u516C\u53F8\uFF0C\u662F\u4E2D\u8F66\u682A\u6D32\u7535\u529B\u673A\u8F66\u6709\u9650\u516C\u53F8\u8BBE\u7F6E\u5728\u9A6C\u6765\u897F\u4E9A\u7684\u5B50\u516C\u53F8\uFF0C\u968F\u7740\u4E2D\u56FD\u94C1\u8DEF\u201C\u8D70\u51FA\u53BB\u201D\u7684\u6B65\u4F10\u52A0\u5FEB\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/10/frc-73fcfaf3fa8f19941cb2043a6b85babe.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5171\u5EFA\u201C\u9AD8\u94C1\u5DE5\u574A\u201D\u643A\u624B\u51FA\u6D77\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u6E56\u5357\u94C1\u9053\u804C\u4E1A\u6280\u672F\u5B66\u9662\u575A\u6301\u624E\u6839\u8F68\u9053\uFF0C\u670D\u52A1\u4EA7\u4E1A\uFF0C\u6DF1\u8015\u8F68\u9053\u4EA4\u901A\u88C5\u5907\u5236\u9020\u5168\u4EA7\u4E1A\u94FE\uFF0C\u8DDF\u968F\u4E2D\u56FD\u4E2D\u8F66\u548C\u4E2D\u56FD\u94C1\u8DEF\u53D1\u5C55\uFF0C\u4F5C\u4E3A\u9996\u4E2A\u56FD\u5BB6\u8F68\u9053\u4EA4\u901A\u88C5\u5907\u884C\u4E1A\u4EA7\u6559\u878D\u5408\u5171\u540C\u4F53\u7684\u526F\u7406\u4E8B\u957F\u5355\u4F4D\u548C\u80FD\u529B\u5EFA\u8BBE\u90E8\u7684\u7275\u5934\u5355\u4F4D\uFF0C\u5B66\u6821\u4E0E\u4E2D\u56FD\u4E2D\u8F66\u80A1\u4EFD\u6709\u9650\u516C\u53F8\uFF08\u7B80\u79F0\u4E2D\u56FD\u4E2D\u8F66\uFF09\u6709\u7740\u957F\u671F\u7684\u826F\u597D\u5408\u4F5C\u5173\u7CFB\uFF0C\u4E2D\u56FD\u9AD8\u94C1\u5F00\u5230\u54EA\uFF0C\u54EA\u91CC\u5C31\u6709\u5B66\u6821\u5E08\u751F\u4EEC\u7684\u8EAB\u5F71\uFF1B\u4E2D\u8F66\u7684\u4EA7\u4E1A\u5EF6\u4F38\u5230\u54EA\uFF0C\u5B66\u6821\u7684\u670D\u52A1\u5C31\u4F34\u968F\u5230\u54EA\u3002\u9A6C\u6765\u897F\u4E9A\u4E2D\u8F66\u8F68\u9053\u4EA4\u901A\u88C5\u5907\u6709\u9650\u516C\u53F8\uFF0C\u662F\u4E2D\u8F66\u682A\u6D32\u7535\u529B\u673A\u8F66\u6709\u9650\u516C\u53F8\u8BBE\u7F6E\u5728\u9A6C\u6765\u897F\u4E9A\u7684\u5B50\u516C\u53F8\uFF0C\u968F\u7740\u4E2D\u56FD\u94C1\u8DEF\u201C\u8D70\u51FA\u53BB\u201D\u7684\u6B65\u4F10\u52A0\u5FEB\uFF0C\u4E2D\u8F66\u682A\u6D32\u7535\u529B\u673A\u8F66\u6709\u9650\u516C\u53F8\u8FD8\u5C06\u201C\u4E2D\u56FD\u5236\u9020\u201D\u7684\u7ECF\u9A8C\u548C\u6280\u672F\u4E0E\u9A6C\u6765\u897F\u4E9A\u5206\u4EAB\uFF0C\u5B9E\u73B0\u672C\u571F\u5316\u751F\u4EA7\u30022015\u5E744\u6708\uFF0C\u9A6C\u6765\u897F\u4E9A\u4E2D\u8F66\u8F68\u9053\u4EA4\u901A\u88C5\u5907\u6709\u9650\u516C\u53F8\u6B63\u5F0F\u8FD0\u884C\uFF0C\u8FD9\u4E5F\u4F7F\u5F97\u9A6C\u6765\u897F\u4E9A\u6210\u4E3A\u4E1C\u76DF\u7B2C\u4E00\u4E2A\u62E5\u6709\u8F68\u9053\u4EA4\u901A\u88C5\u5907\u4EA7\u54C1\u5236\u9020\u80FD\u529B\u7684\u56FD\u5BB6\u3002\u6E56\u5357\u94C1\u9053\u804C\u4E1A\u6280\u672F\u5B66\u9662\u4E0E\u9A6C\u6765\u897F\u4E9A\u4E2D\u8F66\u8F68\u9053\u4EA4\u901A\u88C5\u5907\u6709\u9650\u516C\u53F8\u4E4B\u95F4\u7684\u6218\u7565\u5408\u4F5C\u7684\u5F00\u542F\uFF0C\u662F\u4E00\u9879\u91CC\u7A0B\u7891\u5F0F\u7684\u5408\u4F5C\uFF0C\u201C\u9AD8\u94C1\u5DE5\u574A\u201D\u7684\u6210\u7ACB\uFF0C\u5C06\u5145\u5206\u5229\u7528\u9A6C\u6765\u897F\u4E9A\u4E2D\u8F66\u8F68\u9053\u4EA4\u901A\u88C5\u5907\u6709\u9650\u516C\u53F8\u7684\u751F\u4EA7\u57FA\u5730\u548C\u6E56\u5357\u94C1\u9053\u804C\u4E1A\u6280\u672F\u5B66\u9662\u7684\u529E\u5B66\u7279\u8272\u4E0E\u4F18\u52BF\uFF0C\u5171\u540C\u6EE1\u8DB3\u5F53\u5730\u7ECF\u6D4E\u793E\u4F1A\u53D1\u5C55\u7684\u91CD\u70B9\u4EA7\u4E1A\u5BF9\u6280\u672F\u6280\u80FD\u4EBA\u624D\u7684\u9700\u6C42\uFF0C\u4E0D\u4EC5\u6709\u52A9\u4E8E\u6DF1\u5316\u4EA7\u6559\u878D\u5408\uFF0C\u540C\u65F6\u4E5F\u63A8\u52A8\u4E86\u9A6C\u6765\u897F\u4E9A\u5728\u8F68\u9053\u4EA4\u901A\u88C5\u5907\u5236\u9020\u4E1A\u7684\u8FDB\u6B65\uFF0C\u6709\u6548\u5730\u4FC3\u8FDB\u9A6C\u6765\u897F\u4E9A\u7ECF\u6D4E\u53D1\u5C55\uFF0C\u66F4\u5C06\u4E3A\u4E24\u56FD\u7684\u6821\u4F01\u5408\u4F5C\u548C\u56FD\u9645\u5316\u5408\u4F5C\u9879\u76EE\u63D0\u4F9B\u575A\u5B9E\u7684\u57FA\u7840\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/10/frc-f652f105b5f9a8d43420e87021cb9330.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u8FD0\u7528\u201C\u4E2D\u56FD\u6807\u51C6\u201D\u57F9\u517B\u4EBA\u624D\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u4F5C\u4E3A\u9996\u6279\u201C\u4E2D\u56FD\u7279\u8272\u9AD8\u6C34\u5E73\u9AD8\u804C\u5B66\u6821\u5EFA\u8BBE\u5355\u4F4D\u201D\uFF0C\u5B66\u6821\u5728\u5EFA\u8BBE\u65B9\u6848\u4E2D\u63D0\u5230\uFF0C\u8981\u670D\u52A1\u4E2D\u56FD\u4E2D\u8F66\u8F68\u9053\u4EA4\u901A\u88C5\u5907\u201C\u8D70\u51FA\u53BB\u201D\u6218\u7565\uFF0C\u57F9\u517B\u4F34\u968F\u201C\u4E2D\u56FD\u4E2D\u8F66\u201D\u8D70\u904D\u5168\u4E16\u754C\u7684\u56FD\u9645\u5316\u4EBA\u624D\uFF0C\u5728\u5171\u5EFA\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u56FD\u5BB6\u79EF\u6781\u5EFA\u8BBE\u201C\u9AD8\u94C1\u5DE5\u574A\u201D\uFF0C\u8BA9\u804C\u4E1A\u6559\u80B2\u6F02\u6D0B\u8FC7\u6D77\n\u6253\u9020\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u4E0A\u7684\u201C\u6280\u672F\u9A7F\u7AD9\u201D\uFF0C\u4E3A\u5171\u5EFA\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u56FD\u5BB6\u8F68\u9053\u4EA4\u901A\u4EBA\u624D\u6765\u534E\u5B66\u4E60\u548C\u8FDB\u4FEE\u63D0\u4F9B\u652F\u6301\uFF0C\u4E3A\u5171\u5EFA\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u56FD\u5BB6\u5EFA\u6210\u201C\u901A\u5F80\u672A\u6765\u7684\u5217\u8F66\u201D\u3002\u6B64\u6B21\u5EFA\u8BBE\u201C\u9AD8\u94C1\u5DE5\u574A\u201D\uFF0C\u6821\u4F01\u53CC\u65B9\u53EF\u534F\u5546\u8BA2\u5236\u201C\u56FD\u9645\u5DE5\u5320\u73ED\u201D\uFF0C\u53CC\u65B9\u5171\u540C\u5F00\u53D1\u57F9\u8BAD\u3001\u6559\u5B66\u8D44\u6E90\uFF0C\u5171\u540C\u5236\u5B9A\u4EBA\u624D\u57F9\u517B\u4EE5\u53CA\u57F9\u8BAD\u65B9\u6848\uFF0C\u5F00\u53D1\u53CC\u8BED\u8BFE\u7A0B\u3001\u4E13\u4E1A\u6807\u51C6\uFF0C\u5F00\u53D1\u53CC\u8BED\u6559\u6750\u7B49\uFF0C\u53CC\u65B9\u5171\u4EAB\u6559\u5B66\u3001\u751F\u4EA7\u8BBE\u5907\u4EEA\u5668\u7B49\u3002\u540C\u65F6\u8FD8\u53EF\u4EE5\u8BA2\u5236\u7531\u5B66\u6821\u4E3A\u9A6C\u6765\u897F\u4E9A\u516C\u53F8\u62DB\u6536\u9A6C\u65B9\u5B66\u5386\u6559\u80B2\u7559\u5B66\u751F\uFF0C\u4E5F\u53EF\u8BA2\u5236\u7531\u5B66\u6821\u62DB\u6536\u4E2D\u65B9\u5B66\u751F\u6BD5\u4E1A\u540E\u5230\u9A6C\u6765\u897F\u4E9A\u516C\u53F8\u5DE5\u4F5C\u3002\u5728\u9A6C\u6765\u897F\u4E9A\u671F\u95F4\uFF0C\u5B66\u6821\u8FD8\u4E0E\u9A6C\u6765\u897F\u4E9A\u516C\u53F8\u76F8\u5173\u4EBA\u5458\u5171\u540C\u8D74\u62C9\u66FC\u7406\u5DE5\u5927\u5B66\uFF08Universiti\nTunku Abdul Rahman,\n\u7B80\u79F0UTAR\uFF09\u5F00\u5C55\u4E86\u4EA4\u6D41\u6D3B\u52A8\uFF0C\u5927\u5BB6\u5C31\u5E08\u751F\u4E92\u8BBF\u3001\u6D77\u5916\u9876\u5C97\u5B9E\u4E60\u3001\u56FD\u9645\u8BFE\u7A0B\u5F00\u53D1\u3001\u534F\u540C\u7814\u7A76\u7B49\u4E8B\u5B9C\u7545\u8C08\u5408\u4F5C\u3002\u62C9\u66FC\u7406\u5DE5\u5927\u5B66\u7684\u4EBA\u624D\u57F9\u517B\u3001\u4E13\u4E1A\u8BBE\u7F6E\u3001\u4EA7\u6559\u878D\u5408\u7B49\u591A\u65B9\u9762\u4E0E\u6E56\u5357\u94C1\u9053\u804C\u4E1A\u6280\u672F\u5B66\u9662\u7684\u5EFA\u8BBE\u601D\u8DEF\u6709\u5F02\u66F2\u540C\u5DE5\u4E4B\u5999\uFF0C\u4E2D\u56FD\u4E0E\u9A6C\u6765\u897F\u4E9A\u65E2\u6709\u6E0A\u6E90\u6DF1\u539A\u7684\u5386\u53F2\u57FA\u7840\uFF0C\u53C8\u6709\u7D27\u5BC6\u7684\u7ECF\u6D4E\u548C\u6587\u5316\u4EA4\u6D41\uFF0C\u5408\u4F5C\u7A7A\u95F4\u5927\u3001\u524D\u666F\u5E7F\u9614\uFF0C\u76F8\u4FE1\u5B66\u6821\u4E0E\u9A6C\u6765\u897F\u4E9A\u516C\u53F8\u4EE5\u53CA\u62C9\u66FC\u7406\u5DE5\u5927\u5B66\u7684\u7CBE\u8BDA\u5408\u4F5C\uFF0C\u5FC5\u5C06\u4E3A\u4E09\u65B9\u5E26\u6765\u5168\u65B0\u7684\u5408\u4F5C\u601D\u8DEF\u4E0E\u53D1\u5C55\u673A\u9047\u3002 \u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/10/frc-f9242b77bee5add9b1c830b83b4d09d0.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u52A9\u529B\u201C\u4E2D\u56FD\u540D\u7247\u201D\u8D70\u5411\u4E16\u754C\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u4F5C\u4E3A\u53E4\u4EE3\u6D77\u4E0A\u4E1D\u7EF8\u4E4B\u8DEF\u91CD\u8981\u652F\u70B9\u7684\u9A6C\u6765\u897F\u4E9A\uFF0C\u540C\u65F6\u4E5F\u662F\u4E0E\u4E2D\u56FD\u5171\u5EFA\u201C21\u4E16\u7EAA\u6D77\u4E0A\u4E1D\u7EF8\u4E4B\u8DEF\u201D\u7684\u91CD\u8981\u5408\u4F5C\u4F19\u4F34\u3002\u65B0\u7684\u683C\u5C40\u4E0B\uFF0C\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u56CA\u62EC\u7684\u56FD\u5BB6\u548C\u5730\u533A\u5BF9\u94C1\u8DEF\u4EA4\u901A\u90FD\u6709\u7740\u5927\u91CF\u9700\u6C42\u3002\u6E56\u5357\u94C1\u9053\u4F5C\u4E3A\u4E2D\u56FD\u552F\u4E00\u4E3B\u8981\u9762\u5411\u8F68\u9053\u4EA4\u901A\u88C5\u5907\u5236\u9020\u4EA7\u4E1A\u7684\u9AD8\u804C\u9662\u6821\uFF0C\u81EA1951\u5E74\u521B\u7ACB\u4EE5\u6765\uFF0C\u4E00\u76F4\u81F4\u529B\u4E8E\u57F9\u517B\u4F18\u79C0\u7684\u8F68\u9053\u4EA4\u901A\u88C5\u5907\u4E13\u4E1A\u4EBA\u624D\u3002\u8FD1\u5E74\u6765\uFF0C\u5B66\u6821\u4E0E\u4FC4\u7F57\u65AF\u3001\u6CF0\u56FD\u3001\u9A6C\u6765\u897F\u4E9A\u7B4913\u4E2A\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u56FD\u5BB6\uFF08\u5730\u533A\uFF09\u768430\u4E2A\u6559\u80B2\u673A\u6784\u3001\u8DE8\u56FD\u4F01\u4E1A\u5EFA\u7ACB\u4E86\u5408\u4F5C\u5173\u7CFB\u3002\u4E0E\u4FC4\u7F57\u65AF\u5723\u5F7C\u5F97\u5821\u56FD\u7ACB\u4EA4\u901A\u5927\u5B66\u5408\u4F5C\u5F00\u529E\u94C1\u9053\u673A\u8F66\u7B493\u4E2A\u4E2D\u5916\u5408\u4F5C\u529E\u5B66\u4E13\u4E1A\uFF0C\u529E\u5B66\u89C4\u6A21\u8FBE720\u4EBA\uFF0C\u5171\u62DB\u6536\u6709\u6765\u81EA\u6CF0\u56FD\u3001\u5B5F\u52A0\u62C9\u56FD\u7B495\u4E2A\u56FD\u5BB6\u768498\u540D\u7559\u5B66\u751F\u3002\u4E3A\u201C\u8499\u5185\u94C1\u8DEF\u201D\u7B49\u63F4\u5916\u9879\u76EE\u548C\u6CF0\u56FD\u3001\u5C3C\u65E5\u5229\u4E9A\u7B49\u56FD\u5BB6\u57F9\u8BAD\u8F68\u9053\u4EA4\u901A\u884C\u4E1A\u4EBA\u624D3000\u4EBA\u4EE5\u4E0A\u3002\u8FD1\u5E74\u6765\uFF0C\u4E2D\u8001\u94C1\u8DEF\u3001\u5308\u585E\u94C1\u8DEF\u3001\u4E2D\u6B27\u73ED\u5217\u7B49\u4E00\u4E2A\u4E2A\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u5021\u8BAE\u5408\u4F5C\u6210\u679C\u6B63\u60E0\u6CFD\u5404\u65B9\uFF0C\u594F\u54CD\u4E00\u66F2\u66F2\u548C\u5408\u5171\u751F\u7684\u534E\u7F8E\u4E50\u7AE0\u3002\u6B64\u6B21\u5B66\u6821\u4E0E\u9A6C\u6765\u897F\u4E9A\u516C\u53F8\u5171\u5EFA\u201C\u9AD8\u94C1\u5DE5\u574A\u201D\uFF0C\u4E5F\u5FC5\u5C06\u4E3A\u4E2D\u9A6C\u4E24\u56FD\u67B6\u8D77\u201C\u8FDE\u5FC3\u6865\u201D\uFF0C\u4E3A\u9A6C\u6765\u897F\u4E9A\u4EBA\u6C11\u7545\u901A\u201C\u81F4\u5BCC\u8DEF\u201D\uFF0C\u52A9\u529B\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u8DD1\u51FA\u65B0\u901F\u5EA6\uFF0C\u8DC3\u4E0A\u65B0\u9AD8\u5EA6\uFF0C\u4E3A\u4E16\u754C\u7ECF\u6D4E\u590D\u82CF\u6CE8\u5165\u6EE1\u6EE1\u7684\u201C\u6B63\u80FD\u91CF\u201D\u3002(\u901A\u8BAF\u5458\n\u5F90\u654F) \u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/v3cWZAwRWrVmphE0VrJZvA\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
