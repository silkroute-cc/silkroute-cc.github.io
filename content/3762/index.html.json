  "route": "/3762/",
  "title": "\u9A6C\u6765\u897F\u4E9A\u6210\u7ACB\u7B2C\u56DB\u6B21\u5DE5\u4E1A\u9769\u547D\u4E2D\u5FC3 \u52A0\u5FEB\u6570\u5B57\u80FD\u6E90\u8F6C\u578B",
  "summary": "\uFF08\u5409\u9686\u576115\u65E5\u8BAF\uFF09\u9996\u76F8\u62FF\u7763\u65AF\u91CC\u5B89\u534E\u5BA3\u5E03\u9A6C\u6765\u897F\u4E9A\u7B2C\u56DB\u6B21\u5DE5\u4E1A\u9769\u547D\u4E2D\u5FC3\uFF08Malaysia Centre for 4IR\uFF09\u6B63\u5F0F\u6210\u7ACB\uFF0C\u8FD9\u4E5F\u662F\u4E1C\u76DF\u533A\u57DF\u9996\u4E2A\u540C\u7C7B\u4E2D\u5FC3\u3002 \u8BE5\u4E2D\u5FC3\u5C5E\u4E8E\u4E16\u754C\u7ECF\u6D4E\u8BBA\u575B\uFF08WEF\uFF09\u5168\u7403\u751F\u6001\u7CFB\u7EDF\u4E2D\u7684\u5176\u4E2D\u4E00\u4E2A\u72EC\u7ACB\u4E2D\u5FC3\uFF0C\u4E13\u6CE8\u4E8E\u4E24\u4E2A\u4F18\u5148\u4E8B\u9879\u2014\u2014\u6570\u5B57\u8F6C\u578B\u548C\u653F\u5E9C\u79D1\u6280\uFF08GovTech\uFF09\uFF0C\u4EE5\u53CA\u80FD\u6E90\u8F6C\u578B\u3002 \u5B89\u534E\u4ECA\u65E5\u5728\u8BE5\u4E2D\u5FC3\u63A8\u4ECB\u793C\u64AD\u653E\u7684\u5F00\u5E55\u8BCD\u9884\u5F55\u89C6\u9891\u6307\u51FA\uFF0C\u8FD9\u4E2A\u4E1C\u76DF\u533A\u57DF\u7684\u9996\u4E2A\u540C\u7C7B\u4E2D\u5FC3\uFF0C\u5C06\u653F\u5E9C\u3001\u5546\u754C\u9886\u8896\u3001\u4E13\u5BB6\u548C\u5B66\u8005\u805A\u96C6\u5728\u4E00\u8D77\uFF0C\u521B\u5EFA\u4E00\u4E2A\u521B\u65B0\u548C\u4E13\u4E1A\u77E5\u8BC6\u4E2D\u5FC3\uFF0C\u4EE5\u91CA\u653E\u65B0\u5174\u6280\u672F\u7684\u6F5C\u80FD\u3002 \u201C\u2026",
  "body": "\u003Cp\u003E\uFF08\u5409\u9686\u576115\u65E5\u8BAF\uFF09\u9996\u76F8\u62FF\u7763\u65AF\u91CC\u5B89\u534E\u5BA3\u5E03\u9A6C\u6765\u897F\u4E9A\u7B2C\u56DB\u6B21\u5DE5\u4E1A\u9769\u547D\u4E2D\u5FC3\uFF08Malaysia Centre for 4IR\uFF09\u6B63\u5F0F\u6210\u7ACB\uFF0C\u8FD9\u4E5F\u662F\u4E1C\u76DF\u533A\u57DF\u9996\u4E2A\u540C\u7C7B\u4E2D\u5FC3\u3002\u003C/p\u003E\n\u003Cp\u003E\u8BE5\u4E2D\u5FC3\u5C5E\u4E8E\u4E16\u754C\u7ECF\u6D4E\u8BBA\u575B\uFF08WEF\uFF09\u5168\u7403\u751F\u6001\u7CFB\u7EDF\u4E2D\u7684\u5176\u4E2D\u4E00\u4E2A\u72EC\u7ACB\u4E2D\u5FC3\uFF0C\u4E13\u6CE8\u4E8E\u4E24\u4E2A\u4F18\u5148\u4E8B\u9879\u2014\u2014\u6570\u5B57\u8F6C\u578B\u548C\u653F\u5E9C\u79D1\u6280\uFF08GovTech\uFF09\uFF0C\u4EE5\u53CA\u80FD\u6E90\u8F6C\u578B\u3002\u003C/p\u003E\n\u003Cp\u003E\u5B89\u534E\u4ECA\u65E5\u5728\u8BE5\u4E2D\u5FC3\u63A8\u4ECB\u793C\u64AD\u653E\u7684\u5F00\u5E55\u8BCD\u9884\u5F55\u89C6\u9891\u6307\u51FA\uFF0C\u8FD9\u4E2A\u4E1C\u76DF\u533A\u57DF\u7684\u9996\u4E2A\u540C\u7C7B\u4E2D\u5FC3\uFF0C\u5C06\u653F\u5E9C\u3001\u5546\u754C\u9886\u8896\u3001\u4E13\u5BB6\u548C\u5B66\u8005\u805A\u96C6\u5728\u4E00\u8D77\uFF0C\u521B\u5EFA\u4E00\u4E2A\u521B\u65B0\u548C\u4E13\u4E1A\u77E5\u8BC6\u4E2D\u5FC3\uFF0C\u4EE5\u91CA\u653E\u65B0\u5174\u6280\u672F\u7684\u6F5C\u80FD\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u5E0C\u671B\u8FD9\u4E2A\u4E2D\u5FC3\u80FD\u591F\u8FDB\u4E00\u6B65\u52A0\u901F\u5927\u9A6C\u8F6C\u578B\u6210\u4E3A\u4E00\u4E2A\u5305\u5BB9\u3001\u6570\u5B57\u5316\u548C\u6280\u672F\u9A71\u52A8\u7684\u9AD8\u6536\u5165\u56FD\u5BB6\uFF0C\u4EE5\u53CA\u6570\u5B57\u7ECF\u6D4E\u7684\u533A\u57DF\u9886\u5BFC\u8005\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u5728\u6570\u5B57\u8F6C\u578B\u548C\u653F\u5E9C\u79D1\u6280\u65B9\u9762\uFF0C\u5B89\u534E\u8BF4\uFF0C\u8BE5\u4E2D\u5FC3\u5C06\u7531MyDigital Corporation\u4E3B\u5BFC\uFF0C\u5C06\u91CD\u70B9\u5173\u6CE8\u52A0\u901F\u5927\u9A6C\u6570\u5B57\u8F6C\u578B\u8BAE\u7A0B\u4E0B\u4E00\u9636\u6BB5\u7684\u589E\u957F\u9886\u57DF\uFF0C\u4EE5\u53CA\u5728\u4FC3\u8FDB\u4E1C\u76DF\u6570\u5B57\u8F6C\u578B\u7684\u533A\u57DF\u52AA\u529B\u65B9\u9762\uFF0C\u80FD\u591F\u53D1\u6325\u7684\u4F5C\u7528\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u8BE5\u4E2D\u5FC3\u4E5F\u5C06\u652F\u6301\u5927\u9A6C2022-2040\u5E74\u80FD\u6E90\u653F\u7B56\uFF0C\u4EE5\u4FBF\u6210\u529F\u4E3A\u80FD\u6E90\u8F6C\u578B\u548C\u7EFF\u8272\u7ECF\u6D4E\u53D1\u5C55\u5BFC\u822A\uFF0C\u540C\u65F6\u5E73\u8861\u80FD\u6E90\u5B89\u5168\u3001\u53EF\u8D1F\u62C5\u548C\u73AF\u5883\u53EF\u6301\u7EED\u6027\u7B49\u95EE\u9898\u3002\u003C/p\u003E\n\u003Cp\u003E\u7ECF\u6D4E\u90E8\u957F\u62C9\u83F2\u5179\u4E0E\u4E16\u754C\u7ECF\u6D4E\u8BBA\u575B\u4E3B\u5E2D\u535A\u5C14\u683C\u5E03\u4F26\u5FB7\u4ECA\u5929\u6B63\u5F0F\u63A8\u4ECB\u5927\u9A6C4IR\u4E2D\u5FC3\uFF0C\u5168\u7403\u53E6\u670918\u4E2A\u540C\u7C7B\u4E2D\u5FC3\u4E5F\u5728\u4ECA\u5929\u540C\u6B65\u63A8\u4ECB\u3002\u003C/p\u003E\n\u003Cp\u003E\u5927\u9A6C4IR\u4E2D\u5FC3\u5C06\u5728\u63A8\u52A8\u6211\u56FD\u6570\u5B57\u7ECF\u6D4E\u53D1\u5C55\u65B9\u9762\u53D1\u6325\u5173\u952E\u4F5C\u7528\uFF0C\u91CD\u70B9\u652F\u6301\u6570\u5B57\u8F6C\u578B\u548C\u5FEB\u901F\u589E\u957F\u9886\u57DF\u7684\u8FDB\u6B65\uFF0C\u5305\u62EC\u7EFF\u8272\u80FD\u6E90\u8F6C\u578B\u3002\u003C/p\u003E\n\u003Cp\u003E\u5B89\u534E\u8BF4\uFF0C\u610F\u8BC6\u5230\u5DE5\u4E1A\u9769\u547D4.0\u7684\u53D8\u9769\u6F5C\u529B\uFF0C\u4E16\u754C\u7ECF\u6D4E\u8BBA\u575B\u8BBE\u7ACB4IR\u4E2D\u5FC3\u4F5C\u4E3A\u4E00\u4E2A\u5E73\u53F0\uFF0C\u4EE5\u652F\u6301\u9886\u5BFC\u8005\u5B9E\u73B0\u6280\u672F\u8FDB\u5316\u548C\u589E\u957F\u8F68\u8FF9\u7684\u597D\u5904\uFF0C\u5E76\u652F\u6301\u653F\u5E9C\u4E3A\u65B0\u653F\u7B56\u6846\u67B6\u3001\u654F\u6377\u6CBB\u7406\u6A21\u5F0F\u548C\u7075\u6D3B\u7684\u76D1\u7BA1\u6765\u523A\u6FC0\u521B\u65B0\u6240\u505A\u7684\u52AA\u529B\uFF0C\u540C\u65F6\u4E3A\u4EBA\u6C11\u63D0\u4F9B\u5145\u5206\u7684\u793E\u4F1A\u4FDD\u969C\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u8FD9\u4E2A\u751F\u6001\u7CFB\u7EDF\u4E2D\u670960\u591A\u9879\u4E3E\u63AA\u3001300\u4E2A\u653F\u7B56\u548C\u653F\u5E9C\u4E13\u5BB6\uFF0C\u4EE5\u53CA\u8D85\u8FC7450\u540D\u521B\u65B0\u8005\u548C\u6280\u672F\u5148\u9A71\uFF0C\u968F\u7740\u5927\u9A6C\u53D1\u5C55\u5176\u6570\u5B57\u7ECF\u6D4E\uFF0C\u8FD9\u79CD\u4F19\u4F34\u5173\u7CFB\u6070\u9022\u5176\u65F6\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u9996\u76F8\u6307\u51FA\uFF0C\u6570\u5B57\u7ECF\u6D4E\u589E\u957F\u662F\u653F\u5E9C\u5176\u4E2D\u4E00\u9879\u91CD\u8981\u8BAE\u7A0B\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u901A\u8FC7\u4EE5\u4EBA\u4E3A\u672C\u65B9\u6CD5\u4E3A\u7B2C\u56DB\u6B21\u5DE5\u4E1A\u9769\u547D\u5236\u5B9A\u7684\u5927\u9A6C\u6570\u5B57\u7ECF\u6D4E\u84DD\u56FE\u548C\u653F\u7B56\uFF0C\u786E\u4FDD\u6211\u4EEC\u80FD\u591F\u5584\u7528\u6280\u672F\uFF0C\u5E76\u672A\u6765\u7684\u53EF\u6301\u7EED\u53D1\u5C55\u4FDD\u7559\u4EBA\u6587\u3001\u793E\u4F1A\u548C\u6587\u5316\u4EF7\u503C\u89C2\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u5B89\u534E\u8BF4\uFF0C\u8BE5\u84DD\u56FE\u7B26\u5408\u7B2C12\u5927\u9A6C\u8BA1\u5212\uFF0C\u65E8\u5728\u53D1\u63984IR\u548C\u672A\u6765\u5927\u9A6C\u793E\u4F1A\u7ECF\u6D4E\u53D1\u5C55\u5E26\u6765\u7684\u6F5C\u5728\u673A\u4F1A\uFF0C\u5B9E\u73B0\u957F\u671F\u53EF\u6301\u7EED\u53D1\u5C55\u548C\u7E41\u8363\uFF0C\u8FD9\u4E0E\u8054\u5408\u56FD\u53EF\u6301\u7EED\u53D1\u5C55\u76EE\u6807\u7684\u627F\u8BFA\u76F8\u7B26\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u4EEC\u671F\u671B\u8FDB\u4E00\u6B65\u52A0\u5F3A\u5927\u9A6C\u5728\u5168\u7403\u7684\u5730\u4F4D\uFF0C\u914D\u5408\u660C\u660E\u5927\u9A6C\u7406\u5FF5\uFF0C\u6211\u575A\u4FE1\u6211\u4EEC\u80FD\u591F\u901A\u8FC7\u52A0\u5F3A\u57FA\u7840\u8BBE\u65BD\u3001\u4FC3\u8FDB\u521B\u65B0\uFF0C\u4EE5\u53CA\u521B\u9020\u80FD\u5E2E\u6211\u4EEC\u5927\u5BB6\u63D0\u5347\u751F\u6D3B\u6C34\u5E73\u7684\u751F\u6001\u7CFB\u7EDF\uFF0C\u6765\u52A0\u901F\u5927\u9A6C\u671D\u5411\u5148\u8FDB\u6570\u5B57\u7ECF\u6D4E\u8F6C\u578B\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/R2xC9d_QdCjhgmWQ5bHJLQ\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
