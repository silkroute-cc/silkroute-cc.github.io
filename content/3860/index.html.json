  "canonicalUrlKey": "%e9%a9%ac%e4%b8%ad%e4%bc%81%e4%b8%9a%e8%81%94%e6%89%8b-%e5%90%89%e5%85%b0%e4%b8%b9%e5%93%a5%e6%89%93%e5%b3%87%e9%b2%81%e5%bb%ba%e8%88%aa%e7%a9%ba%e5%9f%8e",
  "route": "/3860/",
  "title": "\u9A6C\u4E2D\u4F01\u4E1A\u8054\u624B \u5409\u5170\u4E39\u54E5\u6253\u5CC7\u9C81\u5EFA\u822A\u7A7A\u57CE",
  "summary": "\uFF08\u54E5\u6253\u5CC7\u9C8120\u65E5\u8BAF\uFF09\u6765\u81EA\u4E1C\u9A6C\u7684\u5B9D\u949E\u53D1\u5C55\u96C6\u56E2\u6709\u9650\u516C\u53F8\uFF08SRI Sabak\uFF09\u4E0E\u4E16\u754C500\u5F3A\u4F01\u4E1A\u7684\u4E2D\u56FD\u4E2D\u51B6\u4EA4\u901A\uFF08MCC\uFF09\u7B7E\u7F72\u5408\u4F5C\u5907\u5FD8\u5F55\uFF0C\u8054\u624B\u53D1\u5C55\u5360\u5730536\u82F1\u4EA9\u7684\u54E5\u6253\u5CC7\u9C81\u822A\u7A7A\u57CE\u3002 \u4E0A\u8FF0\u5730\u6BB5\u6BD7\u90BB\u54E5\u6253\u5CC7\u9C81\u673A\u573A\uFF0C\u4E00\u65E6\u83B7\u6709\u5173\u5F53\u5C40\u6279\u51C6\u540E\uFF0C\u9884\u8BA1\u53EF\u4E8E\u660E\u5E74\u52A8\u5DE5\uFF0C\u521D\u6B65\u5C06\u7740\u91CD\u8F7B\u5DE5\u4E1A\u548C\u4E2D\u578B\u5DE5\u4E1A\u3002\u6B64\u533A\u57DF\u652F\u6301\u7535\u5B50\u3001\u5236\u836F\u3001\u80FD\u6E90\u3001\u98DF\u54C1\u548C\u996E\u6599\u7B49\u884C\u4E1A\u7684\u51FA\u53E3\u6D3B\u52A8\u3002 \u4E2D\u51B6\u4EA4\u901A\u6267\u884C\u8463\u4E8B\u4E8E\u6D2A\u4F1F\u63D0\u5230\uFF0C\u6216\u8BB8\u5F88\u591A\u4EBA\u4F1A\u611F\u5230\u60CA\u8BB6\uFF0C\u4E3A\u4F55\u8BE5\u516C\u53F8\u8981\u8FDB\u9A7B\u5409\u5170\u4E39\uFF0C\u5176\u5B9E\u9009\u62E9\u8FDB\u9A7B\u4E39\u5DDE\uFF0C\u4E3B\u8981\u662F\u770B\u51C6\u4E39\u5DDE\u7684\u52B3\u52A8\u529B\uFF0C\u4EE5\u53CA\u5229\u7528\u8BE5\u533A\u57DF\u9760\u8FD1\u673A\u573A\u53CA\u4E39\u5DDE\u76F4\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/06/frc-fc655d390b88dd83d0083b0ebf1b221a.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\uFF08\u54E5\u6253\u5CC7\u9C8120\u65E5\u8BAF\uFF09\u6765\u81EA\u4E1C\u9A6C\u7684\u5B9D\u949E\u53D1\u5C55\u96C6\u56E2\u6709\u9650\u516C\u53F8\uFF08SRI Sabak\uFF09\u4E0E\u4E16\u754C500\u5F3A\u4F01\u4E1A\u7684\u4E2D\u56FD\u4E2D\u51B6\u4EA4\u901A\uFF08MCC\uFF09\u7B7E\u7F72\u5408\u4F5C\u5907\u5FD8\u5F55\uFF0C\u8054\u624B\u53D1\u5C55\u5360\u5730536\u82F1\u4EA9\u7684\u54E5\u6253\u5CC7\u9C81\u822A\u7A7A\u57CE\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E0A\u8FF0\u5730\u6BB5\u6BD7\u90BB\u54E5\u6253\u5CC7\u9C81\u673A\u573A\uFF0C\u4E00\u65E6\u83B7\u6709\u5173\u5F53\u5C40\u6279\u51C6\u540E\uFF0C\u9884\u8BA1\u53EF\u4E8E\u660E\u5E74\u52A8\u5DE5\uFF0C\u521D\u6B65\u5C06\u7740\u91CD\u8F7B\u5DE5\u4E1A\u548C\u4E2D\u578B\u5DE5\u4E1A\u3002\u6B64\u533A\u57DF\u652F\u6301\u7535\u5B50\u3001\u5236\u836F\u3001\u80FD\u6E90\u3001\u98DF\u54C1\u548C\u996E\u6599\u7B49\u884C\u4E1A\u7684\u51FA\u53E3\u6D3B\u52A8\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E2D\u51B6\u4EA4\u901A\u6267\u884C\u8463\u4E8B\u4E8E\u6D2A\u4F1F\u63D0\u5230\uFF0C\u6216\u8BB8\u5F88\u591A\u4EBA\u4F1A\u611F\u5230\u60CA\u8BB6\uFF0C\u4E3A\u4F55\u8BE5\u516C\u53F8\u8981\u8FDB\u9A7B\u5409\u5170\u4E39\uFF0C\u5176\u5B9E\u9009\u62E9\u8FDB\u9A7B\u4E39\u5DDE\uFF0C\u4E3B\u8981\u662F\u770B\u51C6\u4E39\u5DDE\u7684\u52B3\u52A8\u529B\uFF0C\u4EE5\u53CA\u5229\u7528\u8BE5\u533A\u57DF\u9760\u8FD1\u673A\u573A\u53CA\u4E39\u5DDE\u76F4\u63A5\u901A\u5F80\u6CF0\u56FD\u5357\u90E8\u7684\u4F18\u52BF\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u54E5\u6253\u5CC7\u9C81\u822A\u7A7A\u57CE\u662F\u5168\u7403\u7EFF\u8272\u7ECF\u6D4E\u533A\u7684\u4E00\u90E8\u5206\uFF0C\u662F\u5927\u9A6C\u534A\u5C9B\u4E1C\u5317\u90E8\u6700\u5927\u7684\u7ECF\u6D4E\u533A\uFF0C\u4E5F\u662F\u4E1C\u6D77\u5CB8\u6700\u5927\u7ECF\u6D4E\u533A\u4E4B\u4E00\uFF0C\u9884\u8BA1\u4E5F\u5C06\u6269\u5C55\u5230\u5409\u5170\u4E39\uFF0C\u7279\u522B\u662F\u54E5\u6253\u5CC7\u9C81\u7684\u5176\u4ED6\u5730\u533A\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/06/frc-10c3af0b57a40d9b4d2de13da780203f.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5B9D\u949E\u5EFA\u8BBE\u96C6\u56E2\u6709\u9650\u516C\u53F8\u8463\u4E8B\u7ECF\u7406\u6768\u4E49\u714C\u8BF4\uFF0C\u54E5\u6253\u5CC7\u9C81\u822A\u7A7A\u57CE\u5C06\u6210\u4E3A\u57CE\u5E02\u7ECF\u6D4E\u7684\u4E3B\u8981\u8D21\u732E\u8005\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u4EEC\u6253\u7B97\u52A0\u5F3A\u6B64\u7279\u533A\u7684\u9AD8\u4EF7\u503C\u51FA\u53E3\u6D3B\u52A8\uFF0C\u5305\u62EC\u4E3A\u5916\u6765\u76F4\u63A5\u6295\u8D44\u3001\u5F53\u5730\u5DE5\u4E1A\u53CA\u5176\u96C7\u5458\u5F00\u53D1\u533B\u7597\u3001\u6559\u80B2\u3001\u57F9\u8BAD\u3001\u4F4F\u5B85\u53CA\u5DE5\u5382\u7B49\u8BBE\u65BD\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u5409\u5170\u4E39\u5DDE\u52A1\u5927\u81E3\u62FF\u7763\u963F\u672B\u8036\u8C37\u4ECA\u65E5\u5728\u526F\u5927\u81E3\u62FF\u7763\u83AB\u54C8\u672B\u963F\u9A6C\u966A\u540C\u4E0B\uFF0C\u89C1\u8BC1\u7B7E\u7F72\u4EEA\u5F0F\u3002\u5728\u573A\u8005\u5305\u62EC\u827E\u68E3\u7EF4\u6B23\u751F\u7269\u6280\u672F\u80A1\u4EFD\u516C\u53F8\u9AD8\u7EA7\u987E\u95EE\u53F6\u5CF0\u3001\u5B9D\u949E\u53D1\u5C55\u96C6\u56E2\u6709\u9650\u516C\u53F8\u4E3B\u5E2D\u6768\u4E49\u6743\u3001\u5409\u5170\u4E39\u738B\u5BA4\u4EE3\u8868\u62FF\u7763\u8BFA\u62C9\u65AF\u59AE\u3001\u5409\u5170\u4E39\u4E2D\u534E\u5927\u4F1A\u5802\u4F1A\u957F\u62FF\u7763\u9EC4\u4FDD\u4FCA\u7B49\u4EBA\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E0A\u8FF0\u9879\u76EE\u7684\u57CE\u5E02\u89C4\u5212\u7531DPZ Asia\u7684\u62FF\u7763\u5361\u9A6C\u9886\u5BFC\uFF0C\u4ED6\u4E5F\u662F\u571F\u751F\u571F\u957F\u7684\u54E5\u6253\u5CC7\u9C81\u4EBA\uFF0C\u66FE\u53C2\u4E0E\u7F8E\u56FD\u3001\u7F8E\u6D32\u548C\u6B27\u6D32\u7684\u6770\u51FA\u9879\u76EE\uFF0C\u5E76\u9886\u5BFC\u591A\u4E2A\u56FD\u9645\u5305\u62EC\u4E1C\u76DF\u3001\u4E2D\u4E1C\u3001\u5317\u4E9A\u3001\u6FB3\u6D32\u548C\u82F1\u56FD\u7684\u83B7\u5956\u9879\u76EE\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u81EA\u4E2D\u56FD\u7684\u4E2D\u51B6\u4EA4\u901A\u662F\u4E16\u754C500\u5F3A\u4F01\u4E1A\uFF0C\u4E00\u884C\u4EBA\u4E8E\u6628\u65E5\u62B5\u8FBE\u9A6C\u6765\u897F\u4E9A\uFF0C\u5E76\u5728\u5409\u5170\u4E39\u54E5\u6253\u5CC7\u9C81\u8FDB\u884C\u4E3A\u671F\u4E00\u5468\u7684\u65B0\u7ECF\u6D4E\u533A\u6295\u8D44\u8003\u5BDF\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/92PMKVZ-PLlb6lNxXDEtaw\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
