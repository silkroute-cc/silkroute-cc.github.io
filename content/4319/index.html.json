{
  "id": "%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e5%b7%b4%e7%94%9f%e8%a5%bf%e6%b8%af%e6%89%a9%e5%bb%ba%e8%ae%a1%e5%88%92%e4%bb%8a%e5%b9%b4%e5%8a%a8%e5%b7%a5",
  "slug": "%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e5%b7%b4%e7%94%9f%e8%a5%bf%e6%b8%af%e6%89%a9%e5%bb%ba%e8%ae%a1%e5%88%92%e4%bb%8a%e5%b9%b4%e5%8a%a8%e5%b7%a5",
  "canonicalUrlKey": "%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e5%b7%b4%e7%94%9f%e8%a5%bf%e6%b8%af%e6%89%a9%e5%bb%ba%e8%ae%a1%e5%88%92%e4%bb%8a%e5%b9%b4%e5%8a%a8%e5%b7%a5",
  "route": "/4319/",
  "title": "\u9A6C\u6765\u897F\u4E9A\u5DF4\u751F\u897F\u6E2F\u6269\u5EFA\u8BA1\u5212\u4ECA\u5E74\u52A8\u5DE5",
  "summary": "\uFF08\u5DF4\u751F3\u65E5\u8BAF\uFF09\u5DF4\u751F\u6E2F\u52A1\u5C40\u4E3B\u5E2D\u6B27\u9633\u634D\u534E\u8868\u793A\uFF0C\u968F\u8457\u8D27\u67DC\u541E\u5410\u91CF\u7684\u589E\u52A0\uFF0C\u5DF4\u751F\u6E2F\u53E3\u7684\u4E16\u754C\u6392\u540D\u5C06\u63D0\u5347\uFF0C\u4E3A\u6B64\uFF0C\u5DF4\u751F\u6E2F\u53E3\u4ECA\u5E74\u7684\u5927\u8BA1\u5212\u5C06\u662F\u6269\u5EFA\u6E2F\u53E3\u3002 \u4E5F\u662F\u96EA\u5DDE\u884C\u52A8\u515A\u7F72\u7406\u4E3B\u5E2D\u7684\u4ED6\u6307\u51FA\uFF0C\u5E0C\u76DF\u4E0E\u56FD\u9635\u57282022\u5E74\u5168\u56FD\u5927\u9009\u540E\u7EC4\u5EFA\u56E2\u7ED3\u653F\u5E9C\uFF0C\u5728\u65B0\u653F\u5E9C\u9886\u5BFC\u4E0B\uFF0C\u5DF4\u751F\u6E2F\u53E3\u5C06\u843D\u5B9E\u8BB8\u591A\u5927\u578B\u8BA1\u5212\uFF0C\u76EE\u7684\u52A0\u5F3A\u9A6C\u6765\u897F\u4E9A\u56FD\u5185\u7269\u6D41\u4E1A\u53D1\u5C55\u3002 \u201C\u4E0A\u8FF0\u8BA1\u5212\u53EF\u89C6\u4E3A\u63A8\u52A8\u56FD\u5BB6\u7ECF\u6D4E\u53D1\u5C55\u7684\u91CD\u8981\u4E3E\u63AA\uFF0C\u5C24\u5176\u5DF4\u751F\u6E2F\u53E3\u4E1A\u52A1\u5728\u56FD\u5BB6\u672A\u6765\u7684\u7ECF\u6D4E\u53D1\u5C55\u4E2D\uFF0C\u6709\u4E3E\u8DB3\u8F7B\u91CD\u7684\u5730\u4F4D\u5E76\u626E\u6F14\u91CD\u8981\u89D2\u8272\u3002\u201D \u4ED6\u89E3\u91CA\uFF0C\u8D27\u7269\u8FD0\u8F93\u5206\u6D77\u8FD0\u3001\u7A7A\u8FD0\u548C\u9646\u8FD0\u4E09\u79CD\u65B9\u5F0F\uFF0C\u800C\u7A7A\u8FD0\u548C\u9646\u8DEF\u5728\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/01/frc-b823a59fe5ab5c88699fbcda11de815c.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\uFF08\u5DF4\u751F3\u65E5\u8BAF\uFF09\u5DF4\u751F\u6E2F\u52A1\u5C40\u4E3B\u5E2D\u6B27\u9633\u634D\u534E\u8868\u793A\uFF0C\u968F\u8457\u8D27\u67DC\u541E\u5410\u91CF\u7684\u589E\u52A0\uFF0C\u5DF4\u751F\u6E2F\u53E3\u7684\u4E16\u754C\u6392\u540D\u5C06\u63D0\u5347\uFF0C\u4E3A\u6B64\uFF0C\u5DF4\u751F\u6E2F\u53E3\u4ECA\u5E74\u7684\u5927\u8BA1\u5212\u5C06\u662F\u6269\u5EFA\u6E2F\u53E3\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E5F\u662F\u96EA\u5DDE\u884C\u52A8\u515A\u7F72\u7406\u4E3B\u5E2D\u7684\u4ED6\u6307\u51FA\uFF0C\u5E0C\u76DF\u4E0E\u56FD\u9635\u57282022\u5E74\u5168\u56FD\u5927\u9009\u540E\u7EC4\u5EFA\u56E2\u7ED3\u653F\u5E9C\uFF0C\u5728\u65B0\u653F\u5E9C\u9886\u5BFC\u4E0B\uFF0C\u5DF4\u751F\u6E2F\u53E3\u5C06\u843D\u5B9E\u8BB8\u591A\u5927\u578B\u8BA1\u5212\uFF0C\u76EE\u7684\u52A0\u5F3A\u9A6C\u6765\u897F\u4E9A\u56FD\u5185\u7269\u6D41\u4E1A\u53D1\u5C55\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u4E0A\u8FF0\u8BA1\u5212\u53EF\u89C6\u4E3A\u63A8\u52A8\u56FD\u5BB6\u7ECF\u6D4E\u53D1\u5C55\u7684\u91CD\u8981\u4E3E\u63AA\uFF0C\u5C24\u5176\u5DF4\u751F\u6E2F\u53E3\u4E1A\u52A1\u5728\u56FD\u5BB6\u672A\u6765\u7684\u7ECF\u6D4E\u53D1\u5C55\u4E2D\uFF0C\u6709\u4E3E\u8DB3\u8F7B\u91CD\u7684\u5730\u4F4D\u5E76\u626E\u6F14\u91CD\u8981\u89D2\u8272\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u89E3\u91CA\uFF0C\u8D27\u7269\u8FD0\u8F93\u5206\u6D77\u8FD0\u3001\u7A7A\u8FD0\u548C\u9646\u8FD0\u4E09\u79CD\u65B9\u5F0F\uFF0C\u800C\u7A7A\u8FD0\u548C\u9646\u8DEF\u5728\u9A6C\u6765\u897F\u4E9A\u7269\u6D41\u4E1A\u4EC5\u536010%\uFF0C\u6D77\u4E0A\u8FD0\u8F93\u5374\u5728\u7269\u6D41\u9886\u57DF\u536090%\u7684\u91CD\u5927\u6BD4\u4F8B\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u5F3A\u8C03\uFF0C\u9A6C\u6765\u897F\u4E9A\u8FDB\u51FA\u53E3\u8D38\u6613\u4E3B\u8981\u9760\u6D77\u8FD0\uFF0C\u800C50%\u6D77\u4E0A\u8FD0\u8F93\u90FD\u7ECF\u7531\u5DF4\u751F\u6E2F\u53E3\uFF0C\u65E0\u5F62\u4E2D\uFF0C\u5DF4\u751F\u6E2F\u53E3\u7684\u8425\u8FD0\u548C\u7269\u6D41\u4E1A\uFF0C\u5BF9\u9A6C\u6765\u897F\u4E9A\u56FD\u5BB6\u7ECF\u6D4E\u6709\u91CD\u5927\u5F71\u54CD\u3002\u003C/p\u003E\n\u003Cp\u003E\u6B27\u9633\u634D\u534E\u8868\u793A\uFF0C\u4E3A\u63A8\u52A8\u56FD\u5BB6\u7ECF\u6D4E\u53D1\u5C55\uFF0C\u9A6C\u6765\u897F\u4E9A\u4E2D\u592E\u653F\u5E9C\u5C06\u4E13\u6CE8\u53D1\u5C55\u548C\u63D0\u5347\u5DF4\u751F\u6E2F\u53E3\u3002\u76EE\u524D\uFF0C\u5DF4\u751F\u6E2F\u53E3\u7684\u8D27\u67DC\u541E\u5410\u91CF\u5728\u4E16\u754C\u6392\u540D\u7B2C13\u4F4D\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u9274\u4E8E\u53BB\u5E74\u8D27\u67DC\u91CF\u6709\u6240\u589E\u52A0\uFF0C\u636E\u4FE1\u660E\u5E74\u7684\u4E16\u754C\u6392\u540D\u4F1A\u6709\u6240\u63D0\u5347\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u900F\u9732\uFF0C\u5DF4\u751F\u6E2F\u53E3\u7684\u8D27\u67DC\u541E\u5410\u91CF\u5728\u524D\u5E74\u7EA61300\u591A\u4E07\u6807\u51C6\u8D27\u67DC\uFF0C\u53BB\u5E74\u7684\u8D27\u67DC\u541E\u5410\u91CF\u5DF2\u8D85\u8FC71400\u4E07\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6839\u636E\u4E0A\u8FF0\u8D8B\u52BF\uFF0C\u4ECA\u5E74\u8D27\u67DC\u541E\u5410\u91CF\u5C06\u6301\u7EED\u589E\u52A0\u3002\u65E0\u8BBA\u5982\u4F55\uFF0C\u5DF4\u751F\u6E2F\u53E3\u4ECA\u5E74\u5C06\u542F\u52A8\u897F\u6E2F\u6269\u5EFA\u8BA1\u5212\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6307\u51FA\uFF0C\u4E2D\u592E\u653F\u5E9C\u4E8E2023\u5E74\u5E95\u6279\u51C6\u897F\u6E2F\u6269\u5EFA\u8BA1\u5212\uFF0C\u5404\u65B9\u5728\u4EA4\u901A\u90E8\u957F\u9646\u5146\u798F\u89C1\u8BC1\u4E0B\u7B7E\u7F72\u534F\u8BAE\uFF0C\u9884\u8BA1\u4ECA\u5E74\u5185\u542F\u52A8\u7B2C\u4E8C\u897F\u6E2F\u6269\u5EFA\u8BA1\u5212\u5DE5\u7A0B\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8868\u793A\uFF0C\u6709\u5173\u8BA1\u5212\u4E3B\u8981\u5E94\u4ED8\u5DF4\u751F\u6E2F\u53E3\u672A\u676510\u5E74\u8D27\u67DC\u541E\u5410\u91CF\u7684\u9700\u6C42\uFF0C\u540C\u65F6\u4E5F\u4E3A\u56FD\u5BB6\u7ECF\u6D4E\u53D1\u5C55\u4F5C\u51C6\u5907\u3002\u672A\u676530\u5E74\u81F335\u5E74\u7684\u91CD\u70B9\uFF0C\u5219\u662F\u5EFA\u8BBE\u548C\u53D1\u5C55\u5DF4\u751F\u7B2C\u4E09\u6E2F\u53E3\u8BA1\u5212\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u5DF4\u751F\u7B2C\u4E09\u6E2F\u53E3\u5730\u70B9\u4F4D\u4E8E\u5496\u91CC\u5C9B\uFF0C\u800C\u4E14\u5C5E\u4E8E\u4E00\u5927\u578B\u8BA1\u5212\uFF0C\u4E00\u65E6\u7AE3\u5DE5\uFF0C\u5176\u8D27\u67DC\u541E\u5410\u91CF\u5C06\u6FC0\u589E\uFF0C\u9884\u8BA1\u662F\u5DF4\u751F\u6E2F\u53E3\u73B0\u6709\u8D27\u67DC\u541E\u5410\u91CF\u7684\u4E24\u500D\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u91CD\u7533\uFF0C\u5728\u56E2\u7ED3\u653F\u5E9C\u9886\u5BFC\u4E0B\uFF0C\u4EE5\u5DF4\u751F\u6E2F\u53E3\u8D27\u67DC\u541E\u5410\u91CF\u8BA1\u7B97\uFF0C\u53EF\u9884\u89C1\u56FD\u5BB6\u7ECF\u6D4E\u548C\u7269\u6D41\u4E1A\u6B63\u9762\u53D1\u5C55\uFF0C\u5728\u672A\u67655\u5E74\u81F310\u5E74\u53D6\u5F97\u6210\u957F\u548C\u5927\u8DC3\u8FDB\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/01/frc-4fab95a516a43b261a93567ba7b67308.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u9488\u5BF9\u7269\u6D41\u4E1A\u8005\u7684\u671F\u671B\uFF0C\u6B27\u9633\u634D\u534E\u5219\u6307\u51FA\uFF0C\u4E1A\u8005\u90FD\u8BA4\u540C\u6269\u5927\u5DF4\u751F\u6E2F\u53E3\u7684\u89C4\u6A21\uFF0C\u4EE5\u4FBF\u5BB9\u7EB3\u66F4\u591A\u8D27\u8239\u7684\u505C\u9760\uFF0C\u4E5F\u501F\u6B64\u63D0\u9AD8\u8D27\u67DC\u7684\u5904\u7406\u80FD\u529B\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u91CD\u7533\uFF0C\u5168\u56FD50%\u6D77\u8FD0\u7269\u6D41\u4ECE\u5DF4\u751F\u6E2F\u53E3\u8FDB\u51FA\uFF0C\u56E0\u6B64\uFF0C\u5DF4\u751F\u6E2F\u53E3\u4E1A\u52A1\u7684\u53D1\u5C55\u548C\u6D3B\u8DC3\u4E0D\u4EC5\u5F71\u54CD\u96EA\u5DDE\uFF0C\u800C\u662F\u5173\u4E4E\u5168\u56FD\u7ECF\u6D4E\u53D1\u5C55\u7684\u6307\u6807\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u5DF4\u751F\u6E2F\u53E3\u662F\u751F\u6C14\u52C3\u52C3\u6216\u6B7B\u6C14\u6C89\u6C89\uFF0C\u90FD\u5173\u7CFB\u5230\u56FD\u5BB6\u7ECF\u6D4E\u53D1\u5C55\uFF01\u201D\u003C/p\u003E\n\u003Cp\u003E\u53E6\u4E00\u65B9\u9762\uFF0C\u6B27\u9633\u634D\u534E\u4E5F\u6307\u51FA\uFF0C\u4E1C\u6D77\u5CB8\u94C1\u8DEF\uFF08ECRL\uFF09\u5DE5\u7A0B\u5728\u672A\u67651\u30012\u5E74\u5185\u7AE3\u5DE5\uFF0C\u6709\u5173\u8BA1\u5212\u8BB2\u5BF9\u5DF4\u751F\u6E2F\u53E3\u548C\u56FD\u5BB6\u7ECF\u6D4E\u5E26\u6765\u6B63\u9762\u5F71\u54CD\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6307\u51FA\uFF0C\u6709\u5173\u94C1\u8DEF\u8854\u63A5\u534A\u5C9B\u4E1C\u897F\u6D77\u5CB8\u57CE\u5E02\u5E76\u76F4\u8FBE\u5DF4\u751F\u897F\u6E2F\u3002\u672A\u6765\u5728\u94C1\u8DEF\u6240\u7ECF\u8FC7\u7684\u5730\u533A\uFF0C\u5C06\u9884\u89C1\u8BB8\u591A\u65B0\u5174\u5DE5\u4E1A\u533A\u548C\u5DE5\u4E1A\u57CE\u5E02\u7684\u53D1\u5C55\u548C\u5D1B\u8D77\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u4E1C\u94C1\u8BA1\u5212\u53EF\u5E26\u52A8\u7269\u6D41\u53D1\u5C55\uFF0C\u5E76\u53EF\u50AC\u5316\u5730\u65B9\u5DE5\u4E1A\u53D1\u5C55\uFF0C\u4E00\u65E6\u843D\u6210\uFF0C\u65E0\u5F62\u4E2D\u4E3A\u56FD\u5BB6\u7ECF\u6D4E\u6CE8\u5C04\u4E00\u5242\u5F3A\u5FC3\u5242\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8868\u793A\uFF0C\u5DF4\u751F\u6E2F\u52A1\u5C40\u5C06\u8DDF\u96EA\u5DDE\u653F\u5E9C\u3001\u5730\u65B9\u653F\u5E9C\u548C\u4EA4\u901A\u90E8\u52A0\u5F3A\u914D\u5408\uFF0C\u5E76\u542C\u53D6\u4E1A\u754C\u7684\u5EFA\u8BAE\uFF0C\u5171\u540C\u5B9E\u73B0\u63D0\u5347\u56FD\u5BB6\u7ECF\u6D4E\u548C\u6E2F\u53E3\u4E1A\u52A1\u613F\u666F\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/wc98ShoyfDilfwUi556q3w\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
