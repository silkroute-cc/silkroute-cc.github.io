{
  "id": "%e5%b7%a5%e4%bd%9c%e5%9d%8a%ef%bc%9a%e6%b8%85%e9%9f%b5%c2%b7%e5%ae%8b%e4%bb%a3%e5%b1%b1%e6%b0%b4%e5%b0%8f%e5%93%81%ef%bd%9csong-dynasty-landscape-painting",
  "slug": "%e5%b7%a5%e4%bd%9c%e5%9d%8a%ef%bc%9a%e6%b8%85%e9%9f%b5%c2%b7%e5%ae%8b%e4%bb%a3%e5%b1%b1%e6%b0%b4%e5%b0%8f%e5%93%81%ef%bd%9csong-dynasty-landscape-painting",
