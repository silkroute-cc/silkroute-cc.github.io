{
  "id": "1868-2",
  "slug": "1868-2",
  "canonicalUrlKey": "1868-2",
  "route": "/3034/",
  "title": "\u4E1C\u535A\u4F1A\u843D\u5E55 \u00B7 \u201C\u4E2D\u56FD\u5927\u4F7F\u9986\u7559\u534E\u5956\u52A9\u5B66\u91D1\u201D\u540D\u5355\u63ED\u6653",
  "summary": "\u6982 \u8981 \u4EE5\u201C\u5171\u4EABRCEP\u65B0\u673A\u9047\uFF0C\u52A9\u63A8\u4E2D\u56FD\u2014\u4E1C\u76DF\u81EA\u7531\u8D38\u6613\u533A3.0\u7248\u201D\u4E3A\u4E3B\u9898\u7684\u7B2C\u5341\u4E5D\u5C4A\u4E2D\u56FD\u2014\u4E1C\u76DF\u535A\u89C8\u4F1A(\u4EE5\u4E0B\u7B80\u79F0\u201C\u4E1C\u535A\u4F1A\u201D)\u65E5\u524D\u5728\u5E7F\u897F\u5357\u5B81\u843D\u5E55\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2022/10/frc-2ad35fec2cce6cbcbb30c8247461afa6.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u6982 \u8981\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u4EE5\u201C\u5171\u4EABRCEP\u65B0\u673A\u9047\uFF0C\u52A9\u63A8\u4E2D\u56FD\u2014\u4E1C\u76DF\u81EA\u7531\u8D38\u6613\u533A3.0\u7248\u201D\u4E3A\u4E3B\u9898\u7684\u7B2C\u5341\u4E5D\u5C4A\u4E2D\u56FD\u2014\u4E1C\u76DF\u535A\u89C8\u4F1A(\u4EE5\u4E0B\u7B80\u79F0\u201C\u4E1C\u535A\u4F1A\u201D)\u65E5\u524D\u5728\u5E7F\u897F\u5357\u5B81\u843D\u5E55\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u8981\u95FB\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u7B2C\u4E8C\u6B21\u4F5C\u4E3A\u4E3B\u9898\u56FD\u53C2\u4F1A\u3002\u672C\u5C4A\u4E1C\u535A\u4F1A\u4E0A\uFF0C\u9A6C\u6765\u897F\u4E9A\u5171\u670934\u5BB6\u4F01\u4E1A\u53C2\u5C55\uFF0C\u5176\u4E2D23\u5BB6\u4E3A\u7EBF\u4E0B\u53C2\u5C55\uFF0C\u91CD\u70B9\u5C55\u793A\u98DF\u54C1\u996E\u6599\u3001\u5065\u5EB7\u4FDD\u5065\u3001\u77F3\u6CB9\u548C\u5929\u7136\u6C14\u7B49\u9886\u57DF\u6210\u679C\u3002\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u98DF\u54C1\u53C2\u5C55\u5546\u838E\u62C9\u8868\u793A\uFF0C\u901A\u8FC7\u53C2\u52A0\u4E1C\u535A\u4F1A\u7CFB\u5217\u91C7\u8D2D\u5BF9\u63A5\u4F1A\u548C\u7EBF\u4E0A\u76F4\u64AD\u7B49\uFF0C\u516C\u53F8\u7684\u7279\u8272\u6C34\u679C\u62FF\u5230\u4E0D\u5C11\u8BA2\u5355\uFF0C\u8FD8\u6709\u4E2D\u56FD\u5BA2\u5546\u8868\u793A\u60F3\u76F4\u63A5\u53BB\u9A6C\u6765\u897F\u4E9A\u91C7\u8D2D\u3002\u5728\u5979\u770B\u6765\uFF0C\u4E1C\u535A\u4F1A\u662F\u52A0\u5F3A\u4E2D\u56FD\u548C\u4E1C\u76DF\u7ECF\u6D4E\u5F80\u6765\u7684\u91CD\u8981\u5E73\u53F0\uFF0C\u4FC3\u8FDB\u8D38\u6613\u6D3B\u52A8\uFF0C\u63A8\u52A8\u5730\u533A\u7ECF\u6D4E\u590D\u82CF\u3002\u003C/p\u003E\n\u003Cp\u003E\u81EA2004\u5E74\u53C2\u52A0\u4E1C\u535A\u4F1A\u4EE5\u6765\uFF0C\u9A6C\u6765\u897F\u4E9A\u5DF2\u7EC4\u7EC72000\u4F59\u5BB6\u4F01\u4E1A\u53C2\u5C55\uFF0C\u7D2F\u8BA1\u4EA4\u6613\u989D\u8D85\u8FC710\u4EBF\u7F8E\u5143\u3002\u9A6C\u6765\u897F\u4E9A\u5BF9\u5916\u8D38\u6613\u53D1\u5C55\u5C40\u5C40\u957F\u7A46\u65AF\u5854\u6CD5\u8868\u793A\uFF0C\u591A\u4E2A\u9A6C\u6765\u897F\u4E9A\u54C1\u724C\u4EA7\u54C1\u901A\u8FC7\u4E1C\u535A\u4F1A\uFF0C\u8FDB\u4E00\u6B65\u5F00\u62D3\u4E86\u4E2D\u56FD\u5E02\u573A\uFF0C\u4E1C\u535A\u4F1A\u6210\u4E3A\u9A6C\u6765\u897F\u4E9A\u4F01\u4E1A\u8FDB\u5165\u4E2D\u56FD\u5E02\u573A\u7684\u91CD\u8981\u5E73\u53F0\u3002\u003C/p\u003E\n\u003Cp\u003E\u672C\u5C4A\u4E1C\u535A\u4F1A\u8FD8\u8BBE\u7F6E\u4E86\u201C\u4E24\u56FD\u53CC\u56ED\u201D\u5F00\u53D1\u5EFA\u8BBE10\u5468\u5E74\u4E13\u9898\u5C55\u533A\uFF0C\u5E76\u4E3E\u529E\u4E86\u4E2D\u56FD\u2014\u9A6C\u6765\u897F\u4E9A\u201C\u4E24\u56FD\u53CC\u56ED\u201D\u5347\u7EA7\u53D1\u5C55\u8BBA\u575B\u3001\u4E2D\u56FD\u2014\u9A6C\u6765\u897F\u4E9A\u68D5\u6988\u6CB9\u4EA7\u4E1A\u53D1\u5C55\u8BBA\u575B\u7B49\u7CFB\u5217\u6D3B\u52A8\u3002\u4F5C\u4E3A\u4E2D\u9A6C\u4E24\u56FD\u5408\u4F5C\u7684\u65D7\u8230\u9879\u76EE\uFF0C\u4E2D\u56FD\u2014\u9A6C\u6765\u897F\u4E9A\u94A6\u5DDE\u4EA7\u4E1A\u56ED\u533A\u4E0E\u9A6C\u6765\u897F\u4E9A\u2014\u4E2D\u56FD\u5173\u4E39\u4EA7\u4E1A\u56ED\u533A\u9879\u76EE\uFF0C\u88AB\u5916\u754C\u89C6\u4E3A\u52A9\u529B\u75AB\u540E\u7ECF\u6D4E\u590D\u82CF\u7684\u65B0\u4EAE\u70B9\uFF0C\u5171\u5EFA\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u9879\u76EE\u7684\u65B0\u5178\u8303\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ECA\u5E743\u670818\u65E5\uFF0C\u300A\u533A\u57DF\u5168\u9762\u7ECF\u6D4E\u4F19\u4F34\u5173\u7CFB\u534F\u5B9A\u300B(RCEP)\u5728\u9A6C\u6765\u897F\u4E9A\u6B63\u5F0F\u751F\u6548\u3002\u201C\u5728RCEP\u6846\u67B6\u4E0B\uFF0C\u76F8\u4FE1\u4E2D\u9A6C\u2018\u4E24\u56FD\u53CC\u56ED\u2019\u6295\u8D44\u5408\u4F5C\u4EF7\u503C\u5C06\u8FDB\u4E00\u6B65\u63D0\u5347\u3002\u201D\u5E7F\u897F\u793E\u4F1A\u79D1\u5B66\u9662\u526F\u9662\u957F\u89E3\u6842\u6D77\u8868\u793A\uFF0C\u9A6C\u6765\u897F\u4E9A\u4E00\u76F4\u662F\u4E1C\u535A\u4F1A\u79EF\u6781\u7684\u53C2\u4E0E\u8005\u548C\u652F\u6301\u8005\u3002\u4ECA\u5E74\uFF0C\u9A6C\u6765\u897F\u4E9A\u518D\u6B21\u6210\u4E3A\u4E3B\u9898\u56FD\uFF0C\u4E2D\u9A6C\u5408\u4F5C\u7684\u6DF1\u5316\u548C\u53D1\u5C55\u5C06\u8FCE\u6765\u65B0\u5951\u673A\u3001\u5C55\u73B0\u65B0\u6D3B\u529B\u3001\u91CA\u653E\u65B0\u7EA2\u5229\u3002\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u4E2D\u534E\u603B\u5546\u4F1A\u4F1A\u957F\u5362\u6210\u5168\u8BA4\u4E3A\uFF0CRCEP\u6240\u8425\u9020\u7684\u9AD8\u6C34\u5E73\u81EA\u7531\u8D38\u6613\u73AF\u5883\u5C06\u63A8\u52A8\u9A6C\u4E2D\u8D38\u6613\u4EA7\u4E1A\u94FE\u3001\u4F9B\u5E94\u94FE\u6DF1\u5EA6\u878D\u5408\uFF0C\u63A8\u52A8\u533A\u57DF\u6570\u5B57\u8D38\u6613\u53D1\u5C55\uFF0C\u6301\u7EED\u4F18\u5316\u6574\u4F53\u8425\u5546\u73AF\u5883\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E2D\u56FD\u662F\u9A6C\u6765\u897F\u4E9A\u7B2C\u4E00\u5927\u8D38\u6613\u4F19\u4F34\u3002\u622A\u81F32021\u5E74\u5E95\uFF0C\u4E2D\u56FD\u5BF9\u9A6C\u6765\u897F\u4E9A\u76F4\u63A5\u6295\u8D44\u7D2F\u8BA1\u8D85\u8FC7100\u4EBF\u7F8E\u5143\uFF0C\u9A6C\u6765\u897F\u4E9A\u7D2F\u8BA1\u5BF9\u534E\u76F4\u63A5\u6295\u8D44\u8FD180\u4EBF\u7F8E\u5143\u30022021\u5E74\uFF0C\u4E2D\u9A6C\u53CC\u8FB9\u8D38\u6613\u989D\u8FBE1768\u4EBF\u7F8E\u5143\uFF0C\u540C\u6BD4\u589E\u957F34.5%\uFF0C\u589E\u901F\u5FEB\u4E8E\u540C\u5E74\u4E2D\u56FD\u4E0E\u4E1C\u76DF10\u56FD\u8D38\u6613\u7684\u5E73\u5747\u589E\u901F\u3002\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u4F0A\u65AF\u8FC8\u0026#183;\u6C99\u6BD4\u5229\u8868\u793A\uFF0C\u9A6C\u4E2D\u4E24\u56FD\u52A1\u5B9E\u5408\u4F5C\u6210\u679C\u4E30\u7855\uFF0C\u91CD\u5927\u9879\u76EE\u987A\u5229\u63A8\u8FDB\u3002\u9A6C\u65B9\u5BF9\u53CC\u8FB9\u5173\u7CFB\u7684\u672A\u6765\u5145\u6EE1\u671F\u5F85\uFF0C\u613F\u6DF1\u5316\u53CC\u65B9\u5404\u9886\u57DF\u5408\u4F5C\u548C\u4E92\u8054\u4E92\u901A\uFF0C\u63A2\u8BA8\u6253\u901A\u6CDB\u4E9A\u94C1\u8DEF\u4E2D\u7EBF\u8FDC\u666F\u3002\u6B22\u8FCE\u66F4\u591A\u4E2D\u56FD\u4F01\u4E1A\u8D74\u9A6C\u6295\u8D44\uFF0C\u52A9\u529B\u9A6C\u6765\u897F\u4E9A\u5B9E\u73B0\u521B\u65B0\u3001\u5305\u5BB9\u3001\u53EF\u6301\u7EED\u53D1\u5C55\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u201C2022\u5E74\u4E2D\u56FD\u5927\u4F7F\u9986\u7559\u534E\u5956\u52A9\u5B66\u91D1\u201D\u540D\u5355\u63ED\u6653\u003C/strong\u003E\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2022/10/frc-fc28adb2ef8296a80a0d6f56adb33546.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u7559\u534E\u540C\u5B66\u4F1A\u65E5\u524D\u53D1\u6587\u544A\uFF0C\u516C\u5E03\u4E8620\u540D\u83B7\u5F97\u201C2022\u5E74\u4E2D\u56FD\u5927\u4F7F\u9986\u7559\u534E\u5956\u52A9\u5B66\u91D1\u201D\u540D\u5355\u3002\u003C/p\u003E\n\u003Cp\u003E\u6587\u544A\u79F0\uFF0C\u4E3A\u9F13\u52B1\u5927\u9A6C\u5B66\u5B50\u8D74\u4E2D\u56FD\u5347\u5B66\u3001\u5728\u5B66\u672F\u9886\u57DF\u7EE7\u7EED\u529B\u4E89\u4E0A\u6E38\uFF0C\u540C\u65F6\u8F85\u52A9\u54C1\u5B66\u517C\u4F18\u3001\u5BB6\u5883\u6E05\u5BD2\u7684\u5B66\u751F\u6709\u673A\u4F1A\u8FDB\u4FEE\u53CA\u5B8C\u6210\u5927\u5B66\u6559\u80B2\uFF0C\u5E76\u57F9\u80B2\u56FD\u5BB6\u82F1\u624D\uFF0C\u4E2D\u56FD\u9A7B\u9A6C\u6765\u897F\u4E9A\u5927\u4F7F\u9986\u65E5\u524D\u5BA3\u5E03\u5411\u4E0A\u8FF020\u540D\u5B66\u751F\u4E00\u6B21\u6027\u53D1\u653E3000\u9A6C\u5E01\u7559\u534E\u5956\u52A9\u5B66\u91D1\uFF0C\u540D\u5355\u5982\u4E0B\uFF1A\u003C/p\u003E\n\u003Cp\u003E1 \u53F6\u5149\u660E\u5E7F\u5DDE\u4E2D\u533B\u836F\u5927\u5B66\u9488\u7078\u63A8\u62FF\u5B66\u535A\u58EB\u003C/p\u003E\n\u003Cp\u003E2 \u962E\u656C\u4E2D\u4E0A\u6D77\u4EA4\u901A\u5927\u5B66\u56FD\u9645\u5546\u52A1\u7855\u58EB\u003C/p\u003E\n\u003Cp\u003E3 \u5362\u4E49\u5317\u4EAC\u822A\u7A7A\u822A\u5929\u5927\u5B66\u751F\u7269\u533B\u5B66\u5DE5\u7A0B\u672C\u79D1\u003C/p\u003E\n\u003Cp\u003E4 \u989C\u5C0F\u6674\u4E0A\u6D77\u4E2D\u533B\u836F\u5927\u5B66\u4E2D\u533B\u5B66\u672C\u79D1\u003C/p\u003E\n\u003Cp\u003E5 \u9EC4\u92C6\u502A\u5357\u4EAC\u4E2D\u533B\u836F\u5927\u5B66\u4E2D\u533B\u5B66\u672C\u79D1\u003C/p\u003E\n\u003Cp\u003E6 \u5415\u7ACB\u78CA\u6D59\u6C5F\u5927\u5B66\u5316\u5B66\u5DE5\u7A0B\u4E0E\u5DE5\u827A\u672C\u79D1\u003C/p\u003E\n\u003Cp\u003E7 \u5434\u6587\u732E\u5357\u4EAC\u533B\u79D1\u5927\u5B66\u4E34\u5E8A\u533B\u5B66\u672C\u79D1\u003C/p\u003E\n\u003Cp\u003E8 \u76D8\u97E9\u9890\u4E0A\u6D77\u4E2D\u533B\u836F\u5927\u5B66\u4E2D\u533B\u5B66\u672C\u79D1\u003C/p\u003E\n\u003Cp\u003E9 \u5468\u807F\u5E0C\u4E2D\u56FD\u4F20\u5A92\u5927\u5B66\u65B0\u5A92\u4F53\u827A\u672F\u672C\u79D1\u003C/p\u003E\n\u003Cp\u003E10 \u5F20\u8BD7\u6E58\u6E05\u534E\u5927\u5B66\u73AF\u5883\u4E0E\u5316\u5DE5\u7C7B\u672C\u79D1\u003C/p\u003E\n\u003Cp\u003E11 \u6797\u4EBF\u8C6A\u4E0A\u6D77\u4E2D\u533B\u836F\u5927\u5B66\u4E2D\u533B\u5B66\u672C\u79D1\u003C/p\u003E\n\u003Cp\u003E12 \u6797\u6069\u5F64\u4E0A\u6D77\u4E2D\u533B\u836F\u5927\u5B66\u4E2D\u533B\u5B66\u672C\u79D1\u003C/p\u003E\n\u003Cp\u003E13 \u6797\u6B23\u5B9C\u5317\u4EAC\u7406\u5DE5\u5927\u5B66\u6570\u636E\u79D1\u5B66\u4E0E\u5927\u6570\u636E\u6280\u672F\u672C\u79D1\u003C/p\u003E\n\u003Cp\u003E14 \u738B\u96EF\u51C0\u5317\u4EAC\u4E2D\u533B\u836F\u5927\u5B66\u4E2D\u533B\u5B66\u672C\u79D1\u003C/p\u003E\n\u003Cp\u003E15 \u82CF\u82AF\u8339\u5357\u4EAC\u4E2D\u533B\u836F\u5927\u5B66\u4E2D\u533B\u5B66\u672C\u79D1\u003C/p\u003E\n\u003Cp\u003E16 \u8521\u6C38\u8C6A\u590D\u65E6\u5927\u5B66\u4E34\u5E8A\u533B\u5B66\u672C\u79D1\u003C/p\u003E\n\u003Cp\u003E17 \u9648\u52C7\u5A01\u5929\u6D25\u5927\u5B66\u7269\u6D41\u5DE5\u7A0B\uFF08\u667A\u6167\u4F9B\u5E94\u94FE\u4E0E\u8FD0\u8425\u7BA1\u7406\uFF09\u672C\u79D1\u003C/p\u003E\n\u003Cp\u003E18 \u8A79\u7A19\u6DB5\u4E0A\u6D77\u4E2D\u533B\u836F\u5927\u5B66\u4E2D\u533B\u5B66\u672C\u79D1\u003C/p\u003E\n\u003Cp\u003E19 \u9648\u6587\u8431\u66A8\u5357\u5927\u5B66\u7F51\u7EDC\u4E0E\u65B0\u5A92\u4F53\u672C\u79D1\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1Ahttps://mp.weixin.qq.com/s/_YEyJpH0eQ5KVKWdfpsD7w\u003C/p\u003E\n",
