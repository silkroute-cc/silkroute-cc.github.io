{
  "id": "%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e6%97%85%e6%b8%b8%e5%b1%80%e5%90%af%e5%8a%a82023%e5%b9%b4%e4%b8%ad%e5%9b%bd%e8%b7%af%e6%bc%94%e4%b8%8a%e6%b5%b7%e7%ab%99%e5%9c%86%e6%bb%a1%e8%90%bd%e5%b9%95",
  "slug": "%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e6%97%85%e6%b8%b8%e5%b1%80%e5%90%af%e5%8a%a82023%e5%b9%b4%e4%b8%ad%e5%9b%bd%e8%b7%af%e6%bc%94%e4%b8%8a%e6%b5%b7%e7%ab%99%e5%9c%86%e6%bb%a1%e8%90%bd%e5%b9%95",
  "canonicalUrlKey": "%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e6%97%85%e6%b8%b8%e5%b1%80%e5%90%af%e5%8a%a82023%e5%b9%b4%e4%b8%ad%e5%9b%bd%e8%b7%af%e6%bc%94%e4%b8%8a%e6%b5%b7%e7%ab%99%e5%9c%86%e6%bb%a1%e8%90%bd%e5%b9%95",
  "route": "/3669/",
  "title": "\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38\u5C40\u542F\u52A82023\u5E74\u4E2D\u56FD\u8DEF\u6F14\u4E0A\u6D77\u7AD9\u5706\u6EE1\u843D\u5E55",
  "summary": "\u70B9\u51FB\u84DD\u5B57 \u4E28 \u5173\u6CE8\u6211\u4EEC \u2EE2\u6765\u2EC4\u4E9A\u65C5\u6E38\u3001\u827A\u672F\u548C\u2F42\u5316\u90E8\u4E0E\u2EE2\u6765\u2EC4\u4E9A\u65C5\u6E38\u5C40\u4E8E 2023 \u5E743\u2F4929\u2F47\u2F844\u2F4915\u2F47\u671F\u95F4\u542F\u52A8\u75AB\u60C5\u540E\u7684\u2FB8\u6B21\u4E2D\u56FD\u8425\u9500\u8DEF\u6F14\u6D3B\u52A8\u3002\u5728\u5317\u4EAC\u3001\u91CD\u5E86\u548C\u5E7F\u897F\u5F00\u5C55\u8425\u9500\u4F1A\u4E4B\u540E\uFF0C\u7D27\u63A5\u7740\u2F1C\u5728\u2F34\u5DDE\u3001\u5317\u4EAC\u3001\u4E0A\u6D77\u548C\u53A6\u95E8\u4E3E\u529E\u2F24\u578B\u8DEF\u6F14\u6D3B\u52A8\u3002 \u672C\u6B21\u8425\u9500\u4F1A\u53CA\u8DEF\u6F14\u6D3B\u52A8\u662F\u7531\u2EE2\u6765\u2EC4\u4E9A\u65C5\u6E38\u3001\u827A\u672F\u548C\u2F42\u5316\u90E8\u2ED3\u62FF\u7763\u65AF\u2FA5\u5F20\u5E86\u4FE1\u5148\u2F63\u5E26\u961F\uFF0C\u5305\u542B\u767B\u5609\u697C\u3001\u96EA\u5170\u83AA\u3001\u6C99\u5DF4\u53CA\u7802\u62C9\u8D8A\u7684\u56DB\u4E2A\u5DDE\u653F\u5E9C\u65C5\u6E38\u5C40\u4EE3\u8868\u3001\u2EE2\u6765\u2EC4\u4E9A\u533B\u7597\u65C5\u6E38\u7406\u4E8B\u4F1A(MHTC)\u3001\u2EE2\u6765\u2EC4\u4E9A\u7B2C\u2F06\u5BB6\u56ED(MM2H)\uFF0C\u4EE5\u53CA\u6765\u81EA\u9A6C\u4E2D\u65C5\u6E38\u2F42\u5316\u4FC3\u8FDB\u5546\u4F1A(MICA)\u548C\u2EE2\u6765\u2EC4\u2026",
  "body": "\u003Cp\u003E\u003Cstrong\u003E\u70B9\u51FB\u84DD\u5B57\u003C/strong\u003E\u4E28\u003Cstrong\u003E\u5173\u6CE8\u6211\u4EEC\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u2EE2\u6765\u2EC4\u4E9A\u65C5\u6E38\u3001\u827A\u672F\u548C\u2F42\u5316\u90E8\u4E0E\u2EE2\u6765\u2EC4\u4E9A\u65C5\u6E38\u5C40\u4E8E 2023 \u5E743\u2F4929\u2F47\u2F844\u2F4915\u2F47\u671F\u95F4\u542F\u52A8\u75AB\u60C5\u540E\u7684\u2FB8\u6B21\u4E2D\u56FD\u8425\u9500\u8DEF\u6F14\u6D3B\u52A8\u3002\u5728\u5317\u4EAC\u3001\u91CD\u5E86\u548C\u5E7F\u897F\u5F00\u5C55\u8425\u9500\u4F1A\u4E4B\u540E\uFF0C\u7D27\u63A5\u7740\u2F1C\u5728\u2F34\u5DDE\u3001\u5317\u4EAC\u3001\u4E0A\u6D77\u548C\u53A6\u95E8\u4E3E\u529E\u2F24\u578B\u8DEF\u6F14\u6D3B\u52A8\u3002\u003C/p\u003E\n\u003Cp\u003E\u672C\u6B21\u8425\u9500\u4F1A\u53CA\u8DEF\u6F14\u6D3B\u52A8\u662F\u7531\u2EE2\u6765\u2EC4\u4E9A\u65C5\u6E38\u3001\u827A\u672F\u548C\u2F42\u5316\u90E8\u2ED3\u62FF\u7763\u65AF\u2FA5\u5F20\u5E86\u4FE1\u5148\u2F63\u5E26\u961F\uFF0C\u5305\u542B\u767B\u5609\u697C\u3001\u96EA\u5170\u83AA\u3001\u6C99\u5DF4\u53CA\u7802\u62C9\u8D8A\u7684\u56DB\u4E2A\u5DDE\u653F\u5E9C\u65C5\u6E38\u5C40\u4EE3\u8868\u3001\u2EE2\u6765\u2EC4\u4E9A\u533B\u7597\u65C5\u6E38\u7406\u4E8B\u4F1A(MHTC)\u3001\u2EE2\u6765\u2EC4\u4E9A\u7B2C\u2F06\u5BB6\u56ED(MM2H)\uFF0C\u4EE5\u53CA\u6765\u81EA\u9A6C\u4E2D\u65C5\u6E38\u2F42\u5316\u4FC3\u8FDB\u5546\u4F1A(MICA)\u548C\u2EE2\u6765\u2EC4\u4E9A\u65C5\u6E38\u603B\u4F1A(MATTA) \u4F1A\u5458\u5355\u4F4D\u4EE3\u8868\uFF0C\u2EE2\u6765\u2EC4\u4E9A\u5546\u5BB6\u5728\u5185\u768468 \u5BB6\u2EE2\u6765\u2EC4\u4E9A\u65C5\u6E38\u5C40\u5408\u4F5C\u4F19\u4F34\u3002\u003C/p\u003E\n\u003Cp\u003E\u901A\u8FC7\u5728\u4E2D\u56FD\u4E3B\u8981\u57CE\u5E02\u7684\u2F00\u7CFB\u5217\u6D3B\u52A8\uFF0C\u5411\u4E2D\u56FD\u5408\u4F5C\u4F19\u4F34\u4F20\u9012\u2EE2\u6765\u2EC4\u4E9A\u6B63\u79EF\u6781\u7B79\u5907\u201C2025 \u2EE2\u6765\u2EC4\u4E9A\u65C5\u6E38\u5E74\u201D\u7684\u4FE1\u53F7\uFF0C\u5E76\u5F53\u4E2D\u56FD\u5728 2023\u5E742\u2F496\u2F47\u5BA3\u4F20\u91CD\u542F\u56FD\u9645\u65C5\u2F8F\u4E4B\u540E\uFF0C\u6765\u534E\u79EF\u6781\u5F00\u62D3\u5E02\u573A\uFF0C\u63D0\u5347\u4E2D\u56FD\u6E38\u5BA2\u8D74\u2EE2\u65C5\u6E38\u4FE1\u2F3C\u3002\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38\u5C40\u9884\u8BA1\u4ECA\u5E74\u5C06\u6709 1610 \u4E07\u540D\u56FD\u9645\u6E38\u5BA2\u8BBF\u2EE2\uFF0C\u65C5\u6E38\u6536\u2F0A\u8FBE\u5230492\u4EBF\u4EE4\u5409\u3002\u003C/p\u003E\n\u003Cp\u003E\u5728\u4E0E\u4E2D\u56FD\u5408\u4F5C\u4F19\u4F34\u5F00\u5C55\u8425\u9500\u2EC5\u2FAF\u4F1A\u4E4B\u540E\uFF0C\u2EE2\u6765\u2EC4\u4E9A\u65C5\u6E38\u5C40\u2F1C\u5728\u591A\u5730\u4E3E\u529E\u4F11\u95F2\u65C5\u6E38\u53CA\u4E3B\u9898\u65C5\u6E38\u63A8\u4ECB\u4F1A\uFF0C\u5C55\u793A\u2EE2\u6765\u2EC4\u4E9A\u4F11\u95F2\u65C5\u6E38\u8D44\u6E90\uFF0C\u5E76\u5173\u6CE8\u5230\u2F29\u4F17\u4E3B\u9898\u65C5\u6E38\u6108\u53D1\u589E\u5F3A\u7684\u5E02\u573A\u9700\u6C42\uFF0C\u52A0\u2F0A\u4E86\u2EE2\u6765\u2EC4\u4E9A\u6E38\u5B66\u3001\u2EE2\u6765\u2EC4\u4E9A\u7B2C\u2F06\u5BB6\u56ED\u548C\u533B\u7597\u4FDD\u5065\u65C5\u6E38\u7684\u63A8\u2F34\u3002\u7531\u4E8E\u4E4B\u524D\u75AB\u60C5\u7684\u539F\u56E0\u5BFC\u81F4\u53CC\u8FB9\u65C5\u6E38\u4EA4\u6D41\u88AB\u6309\u4E0B\u4E86\u6682\u505C\u952E\uFF0C \u2EE2\u6765\u2EC4\u4E9A\u65C5\u6E38\u5C40\u5E0C\u671B\u901A\u8FC7\u672C\u6B21\u5728\u4E2D\u56FD\u4E3E\u529E\u7EBF\u4E0B\u5546\u52A1\u6D3D\u8C08\u4F1A\uFF0C\u4E3A\u2EE2\u6765\u2EC4\u4E9A\u4E0E\u4E2D\u56FD\u65C5\u6E38\u4E1A\u8005\u91CD\u5EFA\u4EA4\u6D41\u4E0E\u5408\u4F5C\u5E73\u53F0\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/04/frc-be509055d6fae71e551c5955a9b84bd1.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u4E0A\u6D77\u7AD9\u8DEF\u6F14\u5206\u4E3A\u4E24\u5929\uFF0C\u7B2C\u2F00\u5929 4 \u2F49 12 \u2F47\u662F\u2FAF\u5411\u65C5\u6E38\u540C\u4E1A\u7684\u2F6C\u7684\u5730\u63A8\u4ECB\u4E0E\u5546\u52A1\u6D3D\u8C08\uFF0C4 \u2F49 13 \u2F47\u662F\u2FAF\u5411\u6295\u8D44\u2F08\u2F20\u4E0E\u5B9A\u5411\u2F08\u7FA4\u7684\u2F29\u4F17\u4E3B\u9898\u65C5\u6E38\u63A8\u4ECB\u3002\u2EE2\u6765\u2EC4\u4E9A\u65C5\u6E38\u5C40\u56FD\u9645\u5E02\u573A\u5904\u2FBC\u7EA7\u603B\u76D1\u2EE2\u8BFA\u54C8\u5170\u5148\u2F63\u5728\u4E0A\u6D77\u8DEF\u6F14\u4E2D\u8868\u793A\uFF1A\u201C\u4E2D\u56FD\u662F\u2EE2\u6765\u2EC4\u4E9A\u2FAE\u5E38\u91CD\u8981\u7684\u5BA2\u6E90\u5E02\u573A\uFF0C\u6211\u4EEC\u5F88\u2FBC\u5174\u2EE2\u6765\u2EC4\u4E9A\u4E5F\u5728\u4E2D\u56FD\u2FB8\u6279\u8BD5\u70B9\u6062\u590D\u56E2\u961F\u51FA\u5883\u6E38\u7684\u2F6C\u7684\u5730\u540D\u5355\u5185\u3002\u6211\u4EEC\u4ECA\u5929\u6765\u5230\u8FD9\u2FA5\u662F\u4E3A\u4E86\u5F3A\u5316\u4E2D\u56FD\u4E0E\u2EE2\u6765\u2EC4\u4E9A\u4E4B\u95F4\u7684\u5173\u7CFB\u3002\u6211\u4EEC\u4E5F\u5E0C\u671B\u901A\u8FC7\u5BF9\u2EE2\u6765\u2EC4\u4E9A\u7B2C\u2F06\u5BB6\u56ED\u8BA1\u5212\u3001\u533B\u7597\u65C5\u6E38\u548C\u6559\u80B2\u65C5\u6E38\u7684\u63A8\u2F34\uFF0C\u5E2E\u52A9\u6211\u4EEC\u80FD\u591F\u5728 2025 \u5E74\u5B9E\u73B0 2350 \u4E07\u56FD\u9645\u8BBF\u5BA2\u548C 768 \u4EBF\u4EE4\u5409\u65C5\u6E38\u6536\u2F0A\u7684\u2F6C\u6807\u3002\u201D\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/04/frc-822c044bd18ee412bc80f6fc31b2ea4e.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/04/frc-f25983a55d641e22bf15290b7dfd30bd.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/04/frc-ed755e05f6fbdfe55ee64daa065b5c93.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u4ECA\u5E74\uFF0C\u2EE2\u6765\u2EC4\u4E9A\u65C5\u6E38\u5C40\u5C06\u901A\u8FC7\u5317\u4EAC\u3001\u4E0A\u6D77\u548C\u2F34\u5DDE 3 \u4E2A\u529E\u4E8B\u5904\u4E0E\u65C5\u2F8F\u793E\u548C\u822A\u7A7A\u516C\u53F8\u7B49\u2F8F\u4E1A\u4F19\u4F34\u5408\u4F5C\u3002\u2EE2\u6765\u2EC4\u4E9A\u5BF9\u4E2D\u56FD\u5E02\u573A\u7684\u590D\u82CF\u8868\u793A\u4E50\u89C2\u4E0E\u4FE1\u2F3C\uFF0C\u5728\u4E0D\u4E45\u5C06\u4F1A\u6709\u66F4\u591A\u7684\u822A\u73ED\u73ED\u6B21\u5F80\u8FD4\u4E8E\u4E24\u56FD\u4E4B\u95F4\uFF0C\u4FC3\u8FDB\u4E2D\u2EE2\u4E4B\u95F4\u7684\u8FDE\u901A\u6027\u3002\u2F6C\u524D\uFF0C \u6BCF\u5468\u6709\u8FD1\u767E\u4E2A\u822A\u73ED\u4ECE\u4E2D\u56FD\u2F24\u9646\u2EDC\u5F80\u2EE2\u6765\u2EC4\u4E9A\uFF0C\u5305\u62EC\u2EE2\u6765\u2EC4\u4E9A\u56FD\u9645\u822A\u7A7A\u3001\u4E9A\u6D32\u822A\u7A7A\u3001\u2EE2\u5370\u822A\u7A7A\u3001\u56FD\u6CF0\u822A\u7A7A\u3001\u4E2D\u56FD\u4E1C\u2F45\u822A\u7A7A\u3001\u5357\u2F45\u822A\u7A7A\u3001\u6DF1\u5733\u822A\u7A7A\u3001\u53A6\u2ED4\u822A\u7A7A\u548C\u6625\u79CB\u822A\u7A7A\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E9A\u822A\u4E5F\u5728\u8FD1\u671F\u63A8\u51FA\u4E86\u673A\u7968\u4FC3\u9500\u6D3B\u52A8\uFF0C\u5317\u4EAC\u2EDC\u5F80\u5409\u9686\u5761\u673A\u7968 288\u5143\uFF0C\u2F34\u5DDE\u2EDC\u5F80\u5409\u9686\u5761\u673A\u7968 188\u5143\u7684\u4F18\u60E0\u7968\u4EF7\u3002\u672C\u6B21\u4FC3\u9500\u6D3B\u52A8\u7684\u9884\u8BA2\u65F6\u95F4\u4E3A 2023 \u5E74 4 \u2F49 10 \u2F47\u2F84 4 \u2F49 16 \u2F47\uFF0C\u65C5\u2F8F\u2F47\u671F\u4E3A 2023 \u5E74 4 \u2F49 17 \u2F47\u2F84 10 \u2F49 28 \u2F47\u3002\u003C/p\u003E\n\u003Cp\u003E\u6700\u540E\uFF0C\u2EE2\u6765\u2EC4\u4E9A\u65C5\u6E38\u3001\u827A\u672F\u548C\u2F42\u5316\u90E8\u5C06\u901A\u8FC7\u2EE2\u6765\u2EC4\u4E9A\u65C5\u6E38\u5C40\u6301\u7EED\u52A0\u2F24\u4E0E\u822A\u7A7A\u516C\u53F8\u3001\u65C5\u2F8F\u793E\u3001\u65C5\u6E38\u5546\u5BB6\u548C\u9152\u5E97\u7684\u5408\u4F5C\uFF0C\u79EF\u6781\u62D3\u5C55\u4E2D\u56FD\u65C5\u6E38\u5E02\u573A\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/04/frc-585628b3c7cbcd060fcadba16556c9df.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38\u5C40\u003C/p\u003E\n\u003Chr /\u003E\n\u003Chr /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/04/frc-60050acb60529ede259c8e727bcc7738.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/GmkbNJBZBqt0VHJbuawVPA\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
