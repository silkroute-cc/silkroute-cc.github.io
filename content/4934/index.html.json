{
  "id": "%e5%8f%88%e4%b8%80%e4%b8%aa%e4%b8%ad%e8%b5%84%e4%bc%81%e4%b8%9a%e8%a6%81%e6%8a%95%e8%b5%8420%e4%ba%bf%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e5%bb%ba%e7%94%b5%e6%b1%a0%e5%8e%82",
  "slug": "%e5%8f%88%e4%b8%80%e4%b8%aa%e4%b8%ad%e8%b5%84%e4%bc%81%e4%b8%9a%e8%a6%81%e6%8a%95%e8%b5%8420%e4%ba%bf%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e5%bb%ba%e7%94%b5%e6%b1%a0%e5%8e%82",
  "canonicalUrlKey": "%e5%8f%88%e4%b8%80%e4%b8%aa%e4%b8%ad%e8%b5%84%e4%bc%81%e4%b8%9a%e8%a6%81%e6%8a%95%e8%b5%8420%e4%ba%bf%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e5%bb%ba%e7%94%b5%e6%b1%a0%e5%8e%82",
  "route": "/4934/",
  "title": "\u53C8\u4E00\u4E2A\u4E2D\u8D44\u4F01\u4E1A\u8981\u6295\u8D4420\u4EBF\u9A6C\u6765\u897F\u4E9A\u5EFA\u7535\u6C60\u5382",
  "summary": "\u300A\u79D1\u521B\u677F\u65E5\u62A5\u300B7\u67088\u65E5\u8BAF\uFF08\u8BB0\u8005 \u4F59\u4F73\u6B23\uFF09 \u4ECA\u65E5\uFF087\u67088\u65E5\uFF09\u665A\u95F4\uFF0C\u73E0\u6D77\u51A0\u5B87\u516C\u544A\u79F0\uFF0C\u8BE5\u516C\u53F8\u5728\u9A6C\u6765\u897F\u4E9A\u7684\u5168\u8D44\u5B50\u516C\u53F8\u4F18\u5C3C\u601D\u79D1\u6280\u9A6C\u6765\u897F\u4E9A\u6709\u9650\u516C\u53F8\u62DF\u6295\u8D44\u5EFA\u8BBE\u9A6C\u6765\u897F\u4E9A\u51A0\u5B87\u7535\u6C60\u65B0\u80FD\u6E90\u9879\u76EE\uFF0C\u603B\u6295\u8D44\u989D\u9884\u8BA1\u4E0D\u8D85\u8FC720\u4EBF\u5143\u3002 \u73E0\u6D77\u51A0\u5B87\u79F0\uFF0C \u672C\u6B21\u6295\u8D44\u662F\u57FA\u4E8E\u8BE5\u516C\u53F8\u6D88\u8D39\u7C7B\u5BA2\u6237\u9700\u6C42\u53CA\u5B8C\u5584\u516C\u53F8\u6D77\u5916\u4EA7\u4E1A\u5E03\u5C40\u6218\u7565\u7684\u91CD\u8981\u4E3E\u63AA \u3002\u201C\u516C\u53F8\u76EE\u524D\u7684\u6D88\u8D39\u7C7B\u4EA7\u80FD\u5E03\u5C40\u4E3B\u8981\u96C6\u4E2D\u5728\u56FD\u5185\uFF0C\u672C\u6B21\u5728\u9A6C\u6765\u897F\u4E9A\u6295\u8D44\u65B0\u5EFA\u751F\u4EA7\u57FA\u5730\uFF0C\u53EF\u4EE5\u66F4\u597D\u5730\u5F00\u62D3\u56FD\u9645\u5E02\u573A\u53CA\u5E94\u5BF9\u6D77\u5916\u6D88\u8D39\u7C7B\u5BA2\u6237\u7684\u9700\u6C42\uFF0C\u8FDB\u4E00\u6B65\u5B8C\u5584\u516C\u53F8\u5168\u7403\u5316\u5236\u9020\u7684\u5E03\u5C40\u3002\u540C\u65F6\u8BE5\u6295\u8D44\u5EFA\u5382\u4E5F\u6709\u5229\u4E8E\u8D34\u8FD1\u56FD\u2026",
  "body": "\u003Cp\u003E\u003Cstrong\u003E\u300A\u79D1\u521B\u677F\u65E5\u62A5\u300B7\u67088\u65E5\u8BAF\uFF08\u8BB0\u8005 \u4F59\u4F73\u6B23\uFF09\u003C/strong\u003E\u4ECA\u65E5\uFF087\u67088\u65E5\uFF09\u665A\u95F4\uFF0C\u73E0\u6D77\u51A0\u5B87\u516C\u544A\u79F0\uFF0C\u8BE5\u516C\u53F8\u5728\u9A6C\u6765\u897F\u4E9A\u7684\u5168\u8D44\u5B50\u516C\u53F8\u4F18\u5C3C\u601D\u79D1\u6280\u9A6C\u6765\u897F\u4E9A\u6709\u9650\u516C\u53F8\u62DF\u6295\u8D44\u5EFA\u8BBE\u9A6C\u6765\u897F\u4E9A\u51A0\u5B87\u7535\u6C60\u65B0\u80FD\u6E90\u9879\u76EE\uFF0C\u603B\u6295\u8D44\u989D\u9884\u8BA1\u4E0D\u8D85\u8FC720\u4EBF\u5143\u3002\u003C/p\u003E\n\u003Cp\u003E\u73E0\u6D77\u51A0\u5B87\u79F0\uFF0C\u003Cstrong\u003E\u672C\u6B21\u6295\u8D44\u662F\u57FA\u4E8E\u8BE5\u516C\u53F8\u6D88\u8D39\u7C7B\u5BA2\u6237\u9700\u6C42\u53CA\u5B8C\u5584\u516C\u53F8\u6D77\u5916\u4EA7\u4E1A\u5E03\u5C40\u6218\u7565\u7684\u91CD\u8981\u4E3E\u63AA\u003C/strong\u003E\u3002\u201C\u516C\u53F8\u76EE\u524D\u7684\u6D88\u8D39\u7C7B\u4EA7\u80FD\u5E03\u5C40\u4E3B\u8981\u96C6\u4E2D\u5728\u56FD\u5185\uFF0C\u672C\u6B21\u5728\u9A6C\u6765\u897F\u4E9A\u6295\u8D44\u65B0\u5EFA\u751F\u4EA7\u57FA\u5730\uFF0C\u53EF\u4EE5\u66F4\u597D\u5730\u5F00\u62D3\u56FD\u9645\u5E02\u573A\u53CA\u5E94\u5BF9\u6D77\u5916\u6D88\u8D39\u7C7B\u5BA2\u6237\u7684\u9700\u6C42\uFF0C\u8FDB\u4E00\u6B65\u5B8C\u5584\u516C\u53F8\u5168\u7403\u5316\u5236\u9020\u7684\u5E03\u5C40\u3002\u540C\u65F6\u8BE5\u6295\u8D44\u5EFA\u5382\u4E5F\u6709\u5229\u4E8E\u8D34\u8FD1\u56FD\u9645\u5BA2\u6237\uFF0C\u63D0\u5347\u516C\u53F8\u7684\u7EFC\u5408\u7ADE\u4E89\u529B\u4EE5\u53CA\u6574\u4F53\u6297\u98CE\u9669\u80FD\u529B\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u73E0\u6D77\u51A0\u5B87\u76F8\u5173\u8D1F\u8D23\u4EBA\u5411\u300A\u79D1\u521B\u677F\u65E5\u62A5\u300B\u8BB0\u8005\u8868\u793A\uFF0C\u003Cstrong\u003E\u76EE\u524D\u9879\u76EE\u5230\u5FEB\u5F00\u5DE5\u9636\u6BB5\uFF0C\u9884\u8BA1\u9700\u8981\u4E24\u5230\u4E09\u5E74\u5B8C\u6210\u3002\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u201C\u516C\u53F8\u51FA\u6D77\u4E1A\u52A1\u4E3B\u8981\u8FD8\u662F\u96C6\u4E2D\u5728\u9A6C\u6765\u897F\u4E9A\u7684\u6D88\u8D39\u7535\u6C60\u4E1A\u52A1\u3002\u201D\u4E0A\u8FF0\u4EBA\u58EB\u8FDB\u4E00\u6B65\u8868\u793A\uFF0C\u201D\u76EE\u524D\u6D88\u8D39\u7C7B\u7535\u6C60\u8FD8\u662F\u516C\u53F8\u7684\u4E3B\u8981\u4E1A\u52A1\uFF0C\u5360\u6BD4\u6700\u9AD8\u3002\u201C\u003C/p\u003E\n\u003Cp\u003E\u73E0\u6D77\u51A0\u5B87\u4E3B\u8981\u4ECE\u4E8B\u6D88\u8D39\u7C7B\u7535\u6C60\u7684\u7814\u53D1\u3001\u751F\u4EA7\u53CA\u9500\u552E\uFF0C\u4E5F\u63A8\u8FDB\u5728\u52A8\u529B\u53CA\u50A8\u80FD\u7C7B\u7535\u6C60\u9886\u57DF\u7684\u5E03\u5C40\u3002\u8D22\u62A5\u663E\u793A\uFF0C2023\u5E74\uFF0C\u8BE5\u516C\u53F8\u8425\u6536114.46\u4EBF\u5143\uFF0C\u5176\u4E2D\u6D88\u8D39\u7C7B\u7535\u6C60\u8425\u6536\u4E3A104.80\u4EBF\u5143\uFF0C\u540C\u6BD4\u589E\u957F4.13%\uFF1B\u6BDB\u5229\u7387\u4E3A27.60%\uFF0C\u540C\u6BD4\u589E\u52A08.98\u4E2A\u767E\u5206\u70B9\u3002\u4EA7\u9500\u91CF\u6765\u770B\uFF0C2023\u5E74\u8BE5\u516C\u53F8\u6D88\u8D39\u7C7B\u751F\u4EA7\u91CF\u4E3A3.46\u4EBF\u53EA\uFF0C\u9500\u552E\u91CF\u4E3A3.29\u4EBF\u53EA\uFF0C\u5206\u522B\u540C\u6BD4\u589E\u957F13.52%\u53CA3.14%\u3002\u003C/p\u003E\n\u003Cp\u003E\u516C\u544A\u663E\u793A\uFF0C\u6B64\u6B21\u9879\u76EE\u5177\u4F53\u5EFA\u8BBE\u5185\u5BB9\u5305\u62EC\uFF1A\u65B0\u5EFA\u751F\u4EA7\u8F66\u95F4\u3001\u4ED3\u5E93\u3001\u6D4B\u8BD5\u3001\u529E\u516C\u53CA\u5176\u4ED6\u914D\u5957\u8BBE\u65BD\u7B49\uFF0C\u751F\u4EA7\u7B14\u8BB0\u672C\u3001\u5E73\u677F\u3001\u624B\u673A\u7535\u6C60\u7B49\u6D88\u8D39\u7C7B\u7535\u6C60\u4EA7\u54C1\u3002\u636E\u4E86\u89E3\uFF0C\u5F53\u524D\u6D88\u8D39\u7535\u5B50\u5E02\u573A\u9700\u6C42\u8F83\u4E3A\u7A33\u5B9A\uFF0C\u6839\u636ECanalys\u5206\u6790\uFF0C\u9884\u8BA12024\u5E74\u5168\u7403\u4E2A\u4EBA\u7535\u8111\u51FA\u8D27\u91CF\u5C06\u589E\u957F8%\uFF0C\u667A\u80FD\u624B\u673A\u51FA\u8D27\u91CF\u589E\u957F4%\u3002\u003C/p\u003E\n\u003Cp\u003E\u5BF9\u4E8E\u53EF\u80FD\u5B58\u5728\u7684\u4EA7\u80FD\u6D88\u5316\u95EE\u9898\uFF0C\u73E0\u6D77\u51A0\u5B87\u76F8\u5173\u8D1F\u8D23\u4EBA\u5411\u300A\u79D1\u521B\u677F\u65E5\u62A5\u300B\u8BB0\u8005\u8868\u793A\uFF0C\u003Cstrong\u003E\u201C\u6211\u4EEC\u76EE\u524D\u5728\u624B\u673A\u7AEF\u7684\u4EFD\u989D\u5168\u7403\u624D8%\uFF0C\u8FD8\u6709\u5F88\u5927\u7684\u589E\u957F\u7A7A\u95F4\u3002\u7C7B\u4F3C\u4EA7\u7EBF\u5EFA\u8BBE\u4E5F\u662F\u5E94\u5BA2\u6237\u8981\u6C42\uFF0C\u7ED3\u5408\u8BA2\u5355\u9884\u671F\u5EFA\u7684\u3002\u201D\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u73E0\u6D77\u51A0\u5B87\u63D0\u5230\uFF0C\u8BE5\u516C\u53F8\u672C\u6B21\u5BF9\u5916\u6295\u8D44\u7684\u8D44\u91D1\u6765\u6E90\u4E3A\u516C\u53F8\u81EA\u6709\u8D44\u91D1\u6216\u81EA\u7B79\u8D44\u91D1\u3002\u636E\u4E00\u5B63\u5EA6\u663E\u793A\uFF0C\u73E0\u6D77\u51A0\u5B87\u4E00\u5B63\u5EA6\u671F\u672B\u73B0\u91D1\u53CA\u73B0\u91D1\u7B49\u4EF7\u7269\u4F59\u989D\u4E3A36.57\u4EBF\u5143\uFF0C\u8D27\u5E01\u8D44\u91D1\u4E3A42.40\u4EBF\u5143\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E0D\u8FC7\uFF0C\u4E0A\u8FF0\u516C\u544A\u4EA6\u63D0\u53CA\uFF0C\u5982\u56E0\u5883\u5185\u5916\u6709\u5173\u653F\u7B56\u8C03\u6574\u3001\u9879\u76EE\u5BA1\u6279\u7B49\u5B9E\u65BD\u6761\u4EF6\u53D1\u751F\u53D8\u5316\uFF0C\u8BE5\u9879\u76EE\u7684\u5B9E\u65BD\u53EF\u80FD\u5B58\u5728\u987A\u5EF6\u3001\u53D8\u66F4\u3001\u4E2D\u6B62\u751A\u81F3\u7EC8\u6B62\u7684\u98CE\u9669\u3002\u540C\u65F6\uFF0C\u8BE5\u9879\u76EE\u6D89\u53CA\u7684\u5EFA\u8BBE\u5468\u671F\u7B49\u5747\u4E3A\u521D\u6B65\u89C4\u5212\u6216\u9884\u6D4B\u6570\u636E\uFF0C\u6700\u7EC8\u5B9E\u9645\u5B9E\u65BD\u3001\u751F\u4EA7\u60C5\u51B5\u5177\u6709\u4E0D\u786E\u5B9A\u6027\uFF0C\u53EF\u80FD\u5B58\u5728\u672A\u80FD\u6309\u671F\u5EFA\u8BBE\u5B8C\u6210\u6216\u672A\u80FD\u8FBE\u5230\u9884\u671F\u6536\u76CA\u7684\u98CE\u9669\u7B49\u3002\u003C/p\u003E\n\u003Cp\u003E\u73E0\u6D77\u51A0\u5B87\u5728\u8FD1\u671F\u673A\u6784\u8C03\u7814\u4E2D\u8868\u793A\uFF0C\u6D88\u8D39\u7C7B\u7535\u6C60\u4E3A\u8BE5\u516C\u53F8\u76EE\u524D\u7684\u6838\u5FC3\u4EA7\u54C1\u3002\u201C\u516C\u53F8\u672A\u6765\u5728\u6D88\u8D39\u7C7B\u7535\u6C60\u7684\u6295\u8D44\u89C4\u5212\u4ECD\u4E3B\u8981\u96C6\u4E2D\u4E8E\u7B14\u8BB0\u672C\u7535\u8111\u53CA\u5E73\u677F\u7535\u8111\u7535\u6C60\u3001\u667A\u80FD\u624B\u673A\u7535\u6C60\u3002\u5E76\u5C06\u6839\u636E\u73B0\u6709\u53CA\u6F5C\u5728\u8BA2\u5355\u4EE5\u53CA\u5BF9\u672A\u6765\u884C\u4E1A\u89C4\u6A21\u7684\u5224\u65AD\uFF0C\u4F7F\u7528\u81EA\u6709\u8D44\u91D1\u9002\u5F53\u52A0\u5927\u5728\u65E0\u4EBA\u673A\u7535\u6C60\u3001\u667A\u80FD\u7A7F\u6234\u8BBE\u5907\u7535\u6C60\u3001\u667A\u80FD\u6E05\u6D01\u7535\u5668\u3001\u7535\u52A8\u5DE5\u5177\u7535\u6C60\u7B49\u4EA7\u54C1\u9886\u57DF\u7684\u6295\u8D44\uFF0C\u9010\u6B65\u5B8C\u5584\u6D88\u8D39\u7C7B\u7535\u6C60\u4EA7\u54C1\u7ED3\u6784\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u300A\u79D1\u521B\u677F\u65E5\u62A5\u300B\u8BB0\u8005\u6CE8\u610F\u5230\uFF0C\u9664\u6D88\u8D39\u7C7B\u7535\u6C60\u5E02\u573A\u5916\uFF0C\u73E0\u6D77\u51A0\u5B87\u52A8\u529B\u7535\u6C60\u4E1A\u52A1\u4EA6\u6709\u8FDB\u5C55\u3002\u003C/p\u003E\n\u003Cp\u003E\u81EA2023\u5E74\u4EE5\u6765\uFF0C\u968F\u7740\u52A8\u529B\u7535\u6C60\u884C\u4E1A\u7ADE\u4E89\u6FC0\u70C8\uFF0C\u73E0\u6D77\u51A0\u5B87\u8C03\u6574\u89C4\u5212\uFF0C\u8BE5\u516C\u53F8\u79F0\u5C06\u6C7D\u8F66\u4F4E\u538B\u9502\u7535\u6C60\u5B9A\u4F4D\u4E3A\u81EA\u8EAB\u4F18\u52BF\u9879\u76EE\u548C\u5DEE\u5F02\u5316\u7ADE\u4E89\u7684\u6838\u5FC3\u4E1A\u52A1\u3002\u5176\u4E2D\uFF0C\u4ECA\u5E744\u6708\uFF0C\u73E0\u6D77\u51A0\u5B87\u516C\u544A\u79F0\u6536\u5230Stellantis\u5B9A\u70B9\u901A\u77E5\uFF0C\u5C06\u4E3A\u5176\u5F00\u53D1\u548C\u4F9B\u5E9412V\u6C7D\u8F66\u4F4E\u538B\u9502\u7535\u6C60\u3002\u6839\u636E\u5176\u9700\u6C42\u8BA1\u5212\uFF0C\u8BE5\u9879\u76EE\u5C06\u4E8E2026\u5E74\u91CF\u4EA7\uFF0C\u5177\u4F53\u4EA7\u54C1\u4F9B\u5E94\u65F6\u95F4\u3001\u4EF7\u683C\u4EE5\u53CA\u4F9B\u5E94\u91CF\u4EE5\u6700\u7EC8\u7B7E\u8BA2\u7684\u4F9B\u5E94\u534F\u8BAE\u53CA\u9500\u552E\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/_pjioonFhKJNcLNTWUR3iA\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
