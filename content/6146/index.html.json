{
  "id": "\u5DF4\u751F\u534A\u65E5\u6E38\u597D\u53BB\u5904\u514D\u8D39\u901B\u767D\u5BAB\u5C55\u9986",
  "slug": "\u5DF4\u751F\u534A\u65E5\u6E38\u597D\u53BB\u5904\u514D\u8D39\u901B\u767D\u5BAB\u5C55\u9986",
  "canonicalUrlKey": "\u5DF4\u751F\u534A\u65E5\u6E38\u597D\u53BB\u5904\u514D\u8D39\u901B\u767D\u5BAB\u5C55\u9986",
  "route": "/6146/",
  "title": "\uD83C\uDDF2\uD83C\uDDFE\u5DF4\u751F\u534A\u65E5\u6E38\u597D\u53BB\u5904\u2728\u514D\u8D39\u901B\u201C\u767D\u5BAB\u201D\u5C55\u9986",
  "summary": "\u672C\u6587\u4E3A\u96EA\u5170\u83AA\u65C5\u6E38\u5C40\u53D1\u5E03\u7684\u56FE\u96C6\u5F0F\u6E38\u89C8\u63A8\u4ECB\uFF0C\u4E3B\u9898\u662F\u5DF4\u751F\u201C\u767D\u5BAB\u201D\u2014\u2014\u82CF\u4E39\u963F\u90FD\u963F\u5179\u7687\u5BB6\u5C55\u89C8\u9986\u3002\u5C55\u9986\u514D\u8D39\u5165\u573A\uFF0C\u6536\u85CF\u9A6C\u6765\u897F\u4E9A\u5DF2\u6545\u7B2C11\u4EFB\u56FD\u5BB6\u5143\u9996\u3001\u96EA\u5170\u83AA\u82CF\u4E39\u6C99\u62C9\u80E1\u4E01\u00B7\u963F\u90FD\u963F\u5179\u6C99\u7684\u73CD\u8D35\u85CF\u54C1\uFF0C\u4EE5\u53CA\u96EA\u5170\u83AA\u738B\u5BA4\u7684\u6587\u7269\u4E0E\u5386\u53F2\uFF0C\u9986\u85CF\u8D85\u8FC72000\u4EF6\uFF0C\u6DB5\u76D6\u738B\u5BA4\u4E16\u7CFB\u4E0E\u5386\u53F2\u6587\u732E\u3001\u738B\u5BA4\u73E0\u5B9D\u53CA\u5668\u7269\u590D\u5236\u54C1\u3001\u73CD\u8D35\u5386\u53F2\u7167\u7247\u4E0E\u7EAA\u5FF5\u54C1\u3001\u738B\u5BA4\u4E2A\u4EBA\u6536\u85CF\u53CA\u5404\u56FD\u56FD\u793C\uFF0C\u5E76\u8BBE\u5E38\u8BBE\u5C55\u4E0E\u4E34\u65F6\u5C55\u89C8\u3002\u53C2\u89C2\u4FE1\u606F\u65B9\u9762\uFF0C\u5C55\u9986\u5468\u4E8C\u81F3\u5468\u65E510AM\u81F35PM\u5F00\u653E\uFF0C\u5468\u4E00\u53CA\u516C\u5171\u5047\u671F\u4F11\u9986\uFF0C\u53EF\u4E58KTM\u81F3Klang\u7AD9\u6B65\u884C\u7EA63\u5206\u949F\u62B5\u8FBE\uFF1B\u5165\u9986\u9700\u7740\u88C5\u5F97\u4F53\uFF0C\u9986\u5185\u7981\u6B62\u62CD\u7167\u3002",
  "body": "\u003Cp\u003E\u0026#128525;\u6765\u5230\u96EA\u5170\u83AA\u5DF4\u751F\uFF0C\u9664\u4E86\u8981\u5403\u9999\u55B7\u55B7\u7684\u8089\u9AA8\u8336\u0026#127858;\u003C/p\u003E\n\u003Cp\u003E\u2728\u5343\u4E07\u522B\u9519\u8FC7\u8FD9\u5EA7\u5145\u6EE1\u5386\u53F2\u6545\u4E8B\u7684\u201C\u767D\u5BAB\u201D\uFF01\u003C/p\u003E\n\u003Cp\u003E\u0026#128214;\u8FD9\u91CC\u6536\u85CF\u7740\u9A6C\u6765\u897F\u4E9A\u5DF2\u6545\u7B2C11\u4EFB\u56FD\u5BB6\u5143\u9996\u3001\u003C/p\u003E\n\u003Cp\u003E\u96EA\u5170\u83AA\u82CF\u4E39\u6C99\u62C9\u80E1\u4E01\u0026#183;\u963F\u90FD\u963F\u5179\u6C99\u7684\u73CD\u8D35\u85CF\u54C1\u003C/p\u003E\n\u003Cp\u003E\u0026#128081;\u4EE5\u53CA\u96EA\u5170\u83AA\u738B\u5BA4\u7684\u73CD\u8D35\u6587\u7269\u4E0E\u5386\u53F2\u2728\u003C/p\u003E\n\u003Cp\u003E\u0026#128161;\u5E26\u4F60\u8BA4\u8BC6\u96EA\u5170\u83AA\u738B\u5BA4\u7684\u53D1\u5C55\u5386\u7A0B\u4E0E\u5386\u53F2\u6545\u4E8B\uFF01\u003C/p\u003E\n\u003Cp\u003E\u0026#127903;\uFE0F\u800C\u4E14\u2014\u2014\u5C55\u9986\u514D\u8D39\u5165\u573A\uFF01\u003C/p\u003E\n\u003Cp\u003E\u5982\u679C\u4F60\u4E5F\u559C\u6B22\u5386\u53F2\u6587\u5316\u0026#128269;\u003C/p\u003E\n\u003Cp\u003E\u6765\u5DF4\u751F\u5343\u4E07\u522B\u9519\u8FC7\u8FD9\u91CC\u0026#127881;\u003C/p\u003E\n\u003Cp\u003E\u0026#128444;\uFE0F\u82CF\u4E39\u963F\u90FD\u963F\u5179\u7687\u5BB6\u5C55\u89C8\u9986\u003C/p\u003E\n\u003Cp\u003E\u0026#129668;\u8FD9\u5EA7\u5386\u53F2\u5EFA\u7B51\u5EFA\u4E8E1909\u5E74\uFF0C\u5EFA\u7B51\u5916\u89C2\u5E26\u6709\u9C9C\u660E\u7684\u82F1\u56FD\u6B96\u6C11\u65F6\u671F\u98CE\u683C\uFF0C\u6D01\u767D\u5178\u96C5\uFF0C\u56E0\u6B64\u88AB\u79F0\u4E3A\u5DF4\u751F\u201C\u767D\u5BAB\uFF5E\u003C/p\u003E\n\u003Cp\u003E\u0026#129668;\u5C55\u9986\u5171\u4E24\u5C42\uFF0C\u8BBE\u6709\u591A\u4E2A\u5C55\u5385\uFF0C\u4ECE\u96EA\u5170\u83AA\u82CF\u4E39\u738B\u5BA4\u4E16\u7CFB\u3001\u82CF\u4E39\u963F\u90FD\u963F\u5179\u7684\u65E9\u5E74\u751F\u6D3B\uFF0C\u5230\u738B\u5BA4\u793C\u4EEA\u3001\u738B\u5BA4\u804C\u8D23\u53CA\u73CD\u8D35\u738B\u5BA4\u6536\u85CF\u2728\u003C/p\u003E\n\u003Cp\u003E\u0026#128161;\u9986\u5185\u8FD8\u6709\u4EC0\u4E48\u503C\u5F97\u770B\uFF1F\u003C/p\u003E\n\u003Cp\u003E\u2714\uFE0F\u96EA\u5DDE\u738B\u5BA4\u4E16\u7CFB\u4E0E\u5386\u53F2\u0026#128081;\u003C/p\u003E\n\u003Cp\u003E\u4E86\u89E3\u96EA\u5DDE\u738B\u5BA4\u81EA18\u4E16\u7EAA\u4EE5\u6765\u7684\u53D1\u5C55\u8109\u7EDC\uFF0C\u5E76\u8BA4\u8BC6\u76F8\u5173\u5386\u53F2\u4EBA\u7269\u4E0E\u91CD\u8981\u6587\u732E\u0026#128218;\u003C/p\u003E\n\u003Cp\u003E\u2714\uFE0F\u738B\u5BA4\u73E0\u5B9D\u53CA\u738B\u5BA4\u5668\u7269\u590D\u5236\u54C1\u0026#128142;\u003C/p\u003E\n\u003Cp\u003E\u9986\u5185\u6536\u85CF\u5305\u62EC\u738B\u5BA4\u76F8\u5173\u5668\u7269\u3001\u52CB\u7AE0\u3001\u5370\u7AE0\u53CA\u5176\u4ED6\u73CD\u8D35\u85CF\u54C1\uFF0C\u5C55\u73B0\u4E0D\u540C\u5E74\u4EE3\u7684\u7687\u5BB6\u6587\u5316\u4E0E\u5386\u53F2\u2728\u003C/p\u003E\n\u003Cp\u003E\u2714\uFE0F\u73CD\u8D35\u5386\u53F2\u7167\u7247\u4E0E\u7EAA\u5FF5\u54C1\u0026#128248;\u003C/p\u003E\n\u003Cp\u003E\u900F\u8FC7\u73CD\u8D35\u5386\u53F2\u5F71\u50CF\u53CA\u4E0E\u738B\u5BA4\u751F\u6D3B\u76F8\u5173\u7684\u7269\u54C1\uFF0C\u8BA4\u8BC6\u6614\u65E5\u738B\u5BA4\u751F\u6D3B\u4E0E\u65F6\u4EE3\u53D8\u8FC1\u0026#127902;\uFE0F\u003C/p\u003E\n\u003Cp\u003E\u2714\uFE0F\u738B\u5BA4\u4E2A\u4EBA\u6536\u85CF\u53CA\u793C\u7269\u0026#127873;\u003C/p\u003E\n\u003Cp\u003E\u4ECE\u52CB\u7AE0\u3001\u77ED\u5251\u3001\u53E4\u5E01\uFF0C\u5230\u590D\u53E4\u76F8\u673A\u4E0E\u5404\u56FD\u56FD\u793C\uFF0C\u8DB3\u8DB32000\u002B\u4EF6\u85CF\u54C1\u003C/p\u003E\n\u003Cp\u003E\u2714\uFE0F\u5E38\u8BBE\u5C55\u4E0E\u4E34\u65F6\u5C55\u89C8\u0026#127963;\uFE0F\u003C/p\u003E\n\u003Cp\u003E\u9664\u4E86\u5E38\u8BBE\u5C55\u89C8\uFF0C\u9986\u5185\u4E5F\u4F1A\u4E0D\u5B9A\u671F\u63A8\u51FA\u4E0D\u540C\u4E3B\u9898\u7684\u4E34\u65F6\u5C55\u89C8\uFF0C\u6BCF\u6B21\u53C2\u8BBF\u90FD\u80FD\u53D1\u73B0\u4E0D\u540C\u7684\u5386\u53F2\u6545\u4E8B\u003C/p\u003E\n\u003Cp\u003E\u0026#128161;\u6E29\u99A8\u63D0\u9192\u003C/p\u003E\n\u003Cp\u003E\u26A0\uFE0F\u5165\u9986\u9700\u7740\u88C5\u5F97\u4F53\uFF0C\u907F\u514D\u77ED\u88E4\u3001\u62D6\u978B\u53CA\u65E0\u8896\u4E0A\u8863\u7B49\u670D\u88C5\u003C/p\u003E\n\u003Cp\u003E\u26A0\uFE0F\u9986\u5185\u53C2\u89C2\u671F\u95F4\u7981\u6B62\u62CD\u7167\u003C/p\u003E\n\u003Cp\u003E\u0026#128081;\u82CF\u4E39\u963F\u90FD\u963F\u5179\u7687\u5BB6\u5C55\u89C8\u9986\uFF5CGaleri Diraja Sultan Abdul Aziz\u003C/p\u003E\n\u003Cp\u003E\u0026#128205;Bangunan Sultan Suleiman, 41000 Klang, Selangor\u003C/p\u003E\n\u003Cp\u003E\u0026#128345;\u5468\u4E8C\u81F3\u5468\u65E5\uFF5C10AM\u20135PM\u003C/p\u003E\n\u003Cp\u003E\u0026#128345;\u5468\u4E00\u53CA\u516C\u5171\u5047\u671F\u4F11\u9986\u003C/p\u003E\n\u003Cp\u003E\u0026#127903;\uFE0F\u514D\u8D39\u5165\u573A\u0026amp;nbsp;\u003C/p\u003E\n\u003Cp\u003E\u0026#128646;KTM Klang\u7AD9\uFF0C\u51FA\u7AD9\u540E\u6B65\u884C3\u5206\u949F\u5373\u8FBE\u003C/p\u003E\n\u003Cp\u003E#\u9B45\u529B\u96EA\u5170\u83AA   #\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38   #\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38\u653B\u7565   #\u9A6C\u6765\u897F\u4E9A\u96EA\u5170\u83AA   #VisitSelangor2026   #\u96EA\u5170\u83AA\u60CA\u559C\u8FDE\u8FDE   #\u96EA\u5170\u83AA\u65C5\u6E38   #\u5DF4\u751F\u65C5\u6E38   #\u82CF\u4E39\u963F\u90FD\u963F\u5179\u7687\u5BB6\u5C55\u89C8\u9986   #\u5DF4\u751F\u666F\u70B9\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/mmbiz_jpg/p7Ria9Mp2k3rCcX9E76s3wFEflFSZC0FwohJeltZcJP3zjW6C7SOW7ibibibnnkLpnwY4BE3GAmXhgtxShE6lXxXpdJRZOpib753TrLBSJhlY1Jc/0?wx_fmt=jpeg\u0026amp;from=appmsg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/mmbiz_jpg/p7Ria9Mp2k3qZUQ0LHwKXH9G0RTDGnj5wj0TcZtI8Wp9tialpPXia1z3QAA5XdAwyRgf2jNJCuQ6wFYgFkOvOVHFFgORdH3l0fIH3Cutib7Cxqc/0?wx_fmt=jpeg\u0026amp;from=appmsg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/mmbiz_jpg/p7Ria9Mp2k3q8hibZRUVceALxDq7ksebBxpM6qiaJibaFFRUGG8icOjFIYJw3vuA9LzDGjRQSbTDqoaJGMEB5umkGbZd2ebtdAtQC0As4xSDEtbA/0?wx_fmt=jpeg\u0026