  "id": "%e6%b9%96%e9%9d%a2%e4%b8%8a%e6%b5%ae%e5%8a%a8%e8%a7%84%e6%a8%a1%e5%86%a0%e5%85%a8%e9%a9%ac-10%e6%9c%88%e5%ba%95%e5%b3%87%e5%bd%93%e8%89%be%e5%a4%aa%e9%98%b3%e8%83%bd%e5%8f%91%e7%94%b5%e7%ab%a3",
  "slug": "%e6%b9%96%e9%9d%a2%e4%b8%8a%e6%b5%ae%e5%8a%a8%e8%a7%84%e6%a8%a1%e5%86%a0%e5%85%a8%e9%a9%ac-10%e6%9c%88%e5%ba%95%e5%b3%87%e5%bd%93%e8%89%be%e5%a4%aa%e9%98%b3%e8%83%bd%e5%8f%91%e7%94%b5%e7%ab%a3",
  "canonicalUrlKey": "%e6%b9%96%e9%9d%a2%e4%b8%8a%e6%b5%ae%e5%8a%a8%e8%a7%84%e6%a8%a1%e5%86%a0%e5%85%a8%e9%a9%ac-10%e6%9c%88%e5%ba%95%e5%b3%87%e5%bd%93%e8%89%be%e5%a4%aa%e9%98%b3%e8%83%bd%e5%8f%91%e7%94%b5%e7%ab%a3",
  "route": "/4852/",
  "title": "\u6E56\u9762\u4E0A\u6D6E\u52A8\u89C4\u6A21\u51A0\u5168\u9A6C 10\u6708\u5E95\u5CC7\u5F53\u827E\u592A\u9633\u80FD\u53D1\u7535\u7AE3\u5DE5",
  "summary": "\uFF08\u53E4\u664B20\u65E5\u8BAF\uFF09\u7802\u62C9\u8D8A\u80FD\u6E90\u516C\u53F8\u9996\u5E2D\u6267\u884C\u5458\u62FF\u7763\u6C99\u6BD4\u5C3C\u82CF\u6D77\u91CC\u900F\u9732\uFF0C\u4F4D\u4E8E\u5CC7\u5F53\u827E\u6C34\u529B\u53D1\u7535\u7AD9\u7684\u6C34\u4E0A\u6D6E\u52A8\u592A\u9633\u80FD\u53D1\u7535\u8BBE\u65BD\u5DE5\u7A0B\u8FDB\u5C55\u987A\u5229\uFF0C\u76EE\u524D\u5DF2\u5B8C\u6210\u4E8630%\uFF0C\u9884\u8BA1\u5C06\u4E8E\u4ECA\u5E7410\u6708\u5E95\u6B63\u5F0F\u7AE3\u5DE5\u5E76\u6295\u5165\u8FD0\u8425\uFF0C\u5C4A\u65F6\u5C06\u6210\u4E3A\u9A6C\u6765\u897F\u4E9A\u89C4\u6A21\u6700\u5927\u7684\u6C34\u4E0A\u6D6E\u52A8\u592A\u9633\u80FD\u53D1\u7535\u8BBE\u65BD\uFF01 \u4ED6\u6307\u51FA\uFF0C\u8BE5\u9879\u76EE\u5C06\u6210\u4E3A\u9A6C\u6765\u897F\u4E9A\u6700\u5927\u7684\u6DF7\u5408\u53D1\u7535\u8BBE\u65BD\uFF0C\u7ED3\u5408\u6C34\u529B\u548C\u592A\u9633\u80FD\u53D1\u7535\uFF0C\u5360\u5730190\u516C\u9877\uFF0C\u4EC5\u5360\u6E56\u9762\u603B\u9762\u79EF\u7684\u4E0D\u52303%\u3002 190\u516C\u9877\u4EC5\u5360\u6E56\u97623% \u4ED6\u8BF4\uFF0C\u8BE5\u9879\u76EE\u7531\u7802\u62C9\u8D8A\u80FD\u6E90\u516C\u53F8\u3001\u4E2D\u56FD\u7535\u529B\u56FD\u9645\u63A7\u80A1\u516C\u53F8\u53CA\u592A\u9633\u80FD\u516C\u53F8Trina Solar\u5171\u540C\u6295\u8D44\uFF0C\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/06/frc-404effbe57df9324330cc221a0c979b9.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\uFF08\u53E4\u664B20\u65E5\u8BAF\uFF09\u7802\u62C9\u8D8A\u80FD\u6E90\u516C\u53F8\u9996\u5E2D\u6267\u884C\u5458\u62FF\u7763\u6C99\u6BD4\u5C3C\u82CF\u6D77\u91CC\u900F\u9732\uFF0C\u4F4D\u4E8E\u5CC7\u5F53\u827E\u6C34\u529B\u53D1\u7535\u7AD9\u7684\u6C34\u4E0A\u6D6E\u52A8\u592A\u9633\u80FD\u53D1\u7535\u8BBE\u65BD\u5DE5\u7A0B\u8FDB\u5C55\u987A\u5229\uFF0C\u76EE\u524D\u5DF2\u5B8C\u6210\u4E8630%\uFF0C\u9884\u8BA1\u5C06\u4E8E\u4ECA\u5E7410\u6708\u5E95\u6B63\u5F0F\u7AE3\u5DE5\u5E76\u6295\u5165\u8FD0\u8425\uFF0C\u5C4A\u65F6\u5C06\u6210\u4E3A\u9A6C\u6765\u897F\u4E9A\u89C4\u6A21\u6700\u5927\u7684\u6C34\u4E0A\u6D6E\u52A8\u592A\u9633\u80FD\u53D1\u7535\u8BBE\u65BD\uFF01\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6307\u51FA\uFF0C\u8BE5\u9879\u76EE\u5C06\u6210\u4E3A\u9A6C\u6765\u897F\u4E9A\u6700\u5927\u7684\u6DF7\u5408\u53D1\u7535\u8BBE\u65BD\uFF0C\u7ED3\u5408\u6C34\u529B\u548C\u592A\u9633\u80FD\u53D1\u7535\uFF0C\u5360\u5730190\u516C\u9877\uFF0C\u4EC5\u5360\u6E56\u9762\u603B\u9762\u79EF\u7684\u4E0D\u52303%\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E190\u516C\u9877\u4EC5\u5360\u6E56\u97623%\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u8BE5\u9879\u76EE\u7531\u7802\u62C9\u8D8A\u80FD\u6E90\u516C\u53F8\u3001\u4E2D\u56FD\u7535\u529B\u56FD\u9645\u63A7\u80A1\u516C\u53F8\u53CA\u592A\u9633\u80FD\u516C\u53F8Trina Solar\u5171\u540C\u6295\u8D44\uFF0C\u4E8E2023\u5E746\u670820\u65E5\u6B63\u5F0F\u52A8\u5DE5\uFF0C\u8BE5\u8BBE\u65BD\u4E00\u65E6\u5B8C\u5DE5\u5E76\u5168\u9762\u6295\u5165\u4F7F\u7528\uFF0C\u9884\u8BA1\u6BCF\u5E74\u53EF\u62B5\u6D8852\u5343\u5428\u7684\u78B3\u6392\u653E\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u8FD9\u5C06\u8FDB\u4E00\u6B65\u4FC3\u8FDB\u7802\u62C9\u8D8A\u7535\u529B\u7CFB\u7EDF\u7684\u8131\u78B3\u5316\uFF0C\u662F\u6211\u4EEC\u6269\u5927\u53EF\u518D\u751F\u80FD\u6E90\u4EFD\u989D\u7684\u91CD\u8981\u4E3E\u63AA\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6307\u51FA\uFF0C\u6D6E\u52A8\u592A\u9633\u80FD\u53D1\u7535\u5141\u8BB8\u7802\u62C9\u8D8A\u4F18\u5316\u53EF\u518D\u751F\u80FD\u6E90\u7684\u53D1\u7535\u9009\u9879\uFF0C\u540C\u65F6\u6709\u52A9\u4E8E\u5B9E\u73B0\u7802\u62C9\u8D8A\u80FD\u6E90\u8F6C\u578B\u7684\u53EF\u6301\u7EED\u793E\u4F1A\u7ECF\u6D4E\u53D1\u5C55\u613F\u666F\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u6C99\u6BD4\u5C3C\u662F\u4E8E\u4ECA\u65E9\u63A5\u5F85\u7802\u62C9\u8D8A\u603B\u7406\u62FF\u7763\u5DF4\u4E01\u5B9C\u4E39\u65AF\u91CC\u963F\u90A6\u4F50\u54C8\u91CC\u5230\u8BBF\u5CC7\u5F53\u827E\u592A\u9633\u80FD\u53D1\u7535\u5382\u65F6\uFF0C\u5728\u6D3B\u52A8\u4E0A\u5982\u662F\u8868\u793A\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u7EED\u79F0\uFF0C\u5CC7\u5F53\u827E\u6C34\u529B\u53D1\u7535\u9879\u76EE\uFF08HEP\uFF09\u662F\u7802\u62C9\u8D8A\u7684\u9996\u4E2A\u6C34\u529B\u53D1\u7535\u5382\uFF0C\u4E8E1985\u5E74\u6295\u5165\u4F7F\u7528\uFF0C\u660E\u5E74\u5C06\u8FCE\u676540\u5468\u5E74\u7EAA\u5FF5\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/06/frc-98e6d6ea9da1a639a3e3051aaaaca65c.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u592A\u9633\u80FD\u6C34\u529B\u53D1\u7535\u4E92\u8865\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u6C99\u6BD4\u5C3C\u6307\u51FA\uFF0C\u592A\u9633\u80FD\u548C\u6C34\u529B\u53D1\u7535\u662F\u4E24\u79CD\u4E92\u8865\u7684\u53EF\u518D\u751F\u80FD\u6E90\uFF0C\u767D\u5929\u5229\u7528\u592A\u9633\u80FD\u53D1\u7535\uFF0C\u540C\u65F6\u4FDD\u7559\u6C34\u529B\u53D1\u7535\uFF0C\u53EF\u4EE5\u5728\u591C\u95F4\u53D1\u7535\uFF1B\u6D6E\u52A8\u592A\u9633\u5219\u80FD\u7531\u4E8E\u6C34\u4F53\u7684\u81EA\u7136\u51B7\u5374\u6548\u5E94\uFF0C\u63D0\u4F9B\u4E86\u66F4\u9AD8\u7684\u80FD\u91CF\u4EA7\u51FA\uFF0C\u8FD9\u4E5F\u95F4\u63A5\u89E3\u51B3\u4E86\u53EF\u53D8\u53EF\u518D\u751F\u80FD\u6E90\u56FA\u6709\u7684\u95F4\u6B47\u6027\u95EE\u9898\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u66F4\u91CD\u8981\u7684\u662F\uFF0C\u6C99\u6BD4\u5C3C\u4E5F\u8868\u793A\uFF0C\u5E7F\u6CDB\u7684\u73AF\u5883\u7814\u7A76\uFF0C\u5305\u62EC\u73AF\u5883\u5F71\u54CD\u8BC4\u4F30\uFF08EIA\uFF09\uFF0C\u8868\u660E\u6D6E\u52A8\u592A\u9633\u80FD\u677F\u5BF9\u6C34\u5E93\u7684\u6C34\u8D28\u548C\u751F\u7269\u591A\u6837\u6027\u7684\u5F71\u54CD\u6700\u5C0F\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u8FD9\u5C55\u793A\u4E86\u7802\u62C9\u8D8A\u80FD\u6E90\u516C\u53F8\u5BF9\u53EF\u6301\u7EED\u6027\u7684\u627F\u8BFA\uFF0C\u5728\u5EFA\u8BBE\u8FC7\u7A0B\u4E2D\uFF0C\u7802\u62C9\u8D8A\u80FD\u6E90\u516C\u53F8\u81F4\u529B\u4E8E\u4E0E\u5F53\u5730\u793E\u533A\u548C\u5229\u76CA\u76F8\u5173\u8005\u8FDB\u884C\u900F\u660E\u6C9F\u901A\uFF0C\u9075\u5B88\u4E25\u683C\u7684\u5B89\u5168\u63AA\u65BD\u3001\u73AF\u5883\u6807\u51C6\u548C\u53EF\u6301\u7EED\u5B9E\u8DF5\uFF0C\u5C3D\u91CF\u51CF\u5C11\u751F\u6001\u5F71\u54CD\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u521B\u9020\u5C31\u4E1A\u6536\u5165\u6765\u6E90\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u6B64\u5916\uFF0C\u4ED6\u4E5F\u5BF9\u6D6E\u52A8\u592A\u9633\u80FD\u53D1\u7535\u5382\u9879\u76EE\u80FD\u591F\u4E3A\u5F53\u5730\u793E\u533A\u521B\u9020\u5C31\u4E1A\u3001\u5546\u4E1A\u548C\u5B66\u4E60\u673A\u4F1A\u8868\u793A\u4E50\u89C2\uFF0C\u5305\u62EC\u6280\u80FD\u8F6C\u79FB\u3001\u8239\u53EA\u79DF\u8D41\u548C\u573A\u5730\u7BA1\u7406\uFF0C\u4ECE\u800C\u591A\u6837\u5316\u5F53\u5730\u7684\u6536\u5165\u6765\u6E90\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u5F3A\u8C03\uFF0C\u4E00\u65E6\u53D1\u7535\u5382\u6295\u5165\u8FD0\u8425\uFF0C\u5F53\u5730\u53C2\u4E0E\u7EF4\u62A4\u6D3B\u52A8\u7684\u989D\u5916\u673A\u4F1A\u5C06\u8FDB\u4E00\u6B65\u589E\u5F3A\u793E\u533A\u798F\u5229\uFF0C\u6BD5\u7ADF\u5728\u5F00\u53D1\u8FD9\u4E2A\u9879\u76EE\u65F6\uFF0C\u7802\u62C9\u8D8A\u80FD\u6E90\u516C\u53F8\u91C7\u53D6\u4E86\u4F18\u5148\u8003\u8651\u53EF\u6301\u7EED\u6027\u7684\u65B9\u6CD5\uFF0C\u81F4\u529B\u4E8E\u5728\u5C3D\u91CF\u51CF\u5C11\u8D1F\u9762\u5F71\u54CD\u7684\u540C\u65F6\uFF0C\u6700\u5927\u5316\u9879\u76EE\u5BF9\u73AF\u5883\u7684\u79EF\u6781\u5F71\u54CD\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/ttpAIIjX5JRJoR4HzVKmYA\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
