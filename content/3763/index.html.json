{
  "id": "%e5%85%b1%e5%bb%ba%e4%b8%80%e5%b8%a6%e4%b8%80%e8%b7%af-%e7%a6%8f%e5%bb%ba%e4%b8%8e%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e6%b7%b1%e5%8c%96%e5%8a%a1%e5%ae%9e%e5%90%88%e4%bd%9c",
  "slug": "%e5%85%b1%e5%bb%ba%e4%b8%80%e5%b8%a6%e4%b8%80%e8%b7%af-%e7%a6%8f%e5%bb%ba%e4%b8%8e%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e6%b7%b1%e5%8c%96%e5%8a%a1%e5%ae%9e%e5%90%88%e4%bd%9c",
  "canonicalUrlKey": "%e5%85%b1%e5%bb%ba%e4%b8%80%e5%b8%a6%e4%b8%80%e8%b7%af-%e7%a6%8f%e5%bb%ba%e4%b8%8e%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e6%b7%b1%e5%8c%96%e5%8a%a1%e5%ae%9e%e5%90%88%e4%bd%9c",
  "route": "/3763/",
  "title": "\u5171\u5EFA\u201C\u4E00\u5E26\u4E00\u8DEF\u201D \u798F\u5EFA\u4E0E\u9A6C\u6765\u897F\u4E9A\u6DF1\u5316\u52A1\u5B9E\u5408\u4F5C",
  "summary": "\u4E2D\u65B0\u793E\u798F\u5DDE5\u670816\u65E5\u7535 (\u8BB0\u8005 \u9F99\u654F)\u4E00\u767E\u591A\u5E74\u524D\uFF0C\u798F\u5DDE\u4EBA\u9EC4\u4E43\u88F3\u5E26\u7740\u5343\u4F59\u4EBA\u201C\u4E0B\u5357\u6D0B\u201D\uFF0C\u5728\u9A6C\u6765\u897F\u4E9A\u6C99\u635E\u8D8A\u8BD7\u5DEB\u5F00\u8F9F\u51FA\u4E00\u4E2A \u201C\u65B0\u798F\u5DDE\u201D\u3002\u5982\u4ECA\uFF0C\u798F\u5EFA\u548C\u9A6C\u6765\u897F\u4E9A\u53D1\u6325\u4E92\u8865\u4F18\u52BF\uFF0C\u6DF1\u5316\u52A1\u5B9E\u5408\u4F5C\uFF0C\u5171\u5EFA\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\uFF0C\u7ED3\u51FA\u7D2F\u7D2F\u7855\u679C\u3002 5\u670811\u65E5\u81F314\u65E5\uFF0C\u798F\u5EFA\u7701\u59D4\u4E66\u8BB0\u5468\u7956\u7FFC\u7387\u798F\u5EFA\u7701\u4EE3\u8868\u56E2\u5728\u9A6C\u6765\u897F\u4E9A\u8BBF\u95EE\uFF0C\u5C55\u5F00\u7ECF\u8D38\u6587\u5316\u4EA4\u6D41\u3002\u798F\u5EFA\u519C\u6797\u5927\u5B66\u7ECF\u6D4E\u4E0E\u7BA1\u7406\u5B66\u9662\u5DE5\u5546\u7BA1\u7406\u7CFB\u4E3B\u4EFB\u90D1\u4E4916\u65E5\u63A5\u53D7\u4E2D\u65B0\u793E\u8BB0\u8005\u4E13\u8BBF\u65F6\u8BA4\u4E3A\uFF0C\u65F6\u503C\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u5021\u8BAE\u63D0\u51FA10\u5468\u5E74\u548C\u4E2D\u9A6C\u5EFA\u7ACB\u5168\u9762\u6218\u7565\u4F19\u4F34\u5173\u7CFB10\u5468\u5E74\u4E4B\u9645\uFF0C\u4F5C\u4E3A\u201C21\u4E16\u7EAA\u6D77\u4E0A\u4E1D\u7EF8\u4E4B\u8DEF\u201D\u6838\u2026",
  "body": "\u003Cp\u003E\u4E2D\u65B0\u793E\u798F\u5DDE5\u670816\u65E5\u7535 (\u8BB0\u8005 \u9F99\u654F)\u4E00\u767E\u591A\u5E74\u524D\uFF0C\u798F\u5DDE\u4EBA\u9EC4\u4E43\u88F3\u5E26\u7740\u5343\u4F59\u4EBA\u201C\u4E0B\u5357\u6D0B\u201D\uFF0C\u5728\u9A6C\u6765\u897F\u4E9A\u6C99\u635E\u8D8A\u8BD7\u5DEB\u5F00\u8F9F\u51FA\u4E00\u4E2A \u201C\u65B0\u798F\u5DDE\u201D\u3002\u5982\u4ECA\uFF0C\u798F\u5EFA\u548C\u9A6C\u6765\u897F\u4E9A\u53D1\u6325\u4E92\u8865\u4F18\u52BF\uFF0C\u6DF1\u5316\u52A1\u5B9E\u5408\u4F5C\uFF0C\u5171\u5EFA\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\uFF0C\u7ED3\u51FA\u7D2F\u7D2F\u7855\u679C\u3002\u003C/p\u003E\n\u003Cp\u003E5\u670811\u65E5\u81F314\u65E5\uFF0C\u798F\u5EFA\u7701\u59D4\u4E66\u8BB0\u5468\u7956\u7FFC\u7387\u798F\u5EFA\u7701\u4EE3\u8868\u56E2\u5728\u9A6C\u6765\u897F\u4E9A\u8BBF\u95EE\uFF0C\u5C55\u5F00\u7ECF\u8D38\u6587\u5316\u4EA4\u6D41\u3002\u798F\u5EFA\u519C\u6797\u5927\u5B66\u7ECF\u6D4E\u4E0E\u7BA1\u7406\u5B66\u9662\u5DE5\u5546\u7BA1\u7406\u7CFB\u4E3B\u4EFB\u90D1\u4E4916\u65E5\u63A5\u53D7\u4E2D\u65B0\u793E\u8BB0\u8005\u4E13\u8BBF\u65F6\u8BA4\u4E3A\uFF0C\u65F6\u503C\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u5021\u8BAE\u63D0\u51FA10\u5468\u5E74\u548C\u4E2D\u9A6C\u5EFA\u7ACB\u5168\u9762\u6218\u7565\u4F19\u4F34\u5173\u7CFB10\u5468\u5E74\u4E4B\u9645\uFF0C\u4F5C\u4E3A\u201C21\u4E16\u7EAA\u6D77\u4E0A\u4E1D\u7EF8\u4E4B\u8DEF\u201D\u6838\u5FC3\u533A\u7684\u798F\u5EFA\u7701\uFF0C\u4E0E\u9A6C\u6765\u897F\u4E9A\u7EE7\u7EED\u62D3\u5C55\u591A\u9886\u57DF\u52A1\u5B9E\u5408\u4F5C\uFF0C\u7A7A\u95F4\u5DE8\u5927\u3001\u524D\u666F\u5E7F\u9614\u3002\u003C/p\u003E\n\u003Cp\u003E\u76EE\u524D\uFF0C\u798F\u5EFA\u7701\u4E0E\u6C99\u635E\u8D8A\u5DDE\u3001\u53A6\u95E8\u5E02\u4E0E\u69DF\u5C9B\u5E02\u3001\u6CC9\u5DDE\u5E02\u4E0E\u53E4\u664B\u5357\u5E02\u3001\u8386\u7530\u5E02\u4E0E\u8BD7\u5DEB\u5E02\u3001\u5B81\u5FB7\u5E02\u4E0E\u8BD7\u5DEB\u5E02\u5DF2\u7ED3\u4E3A\u53CB\u57CE\u3002\u81EA\u7ED3\u597D\u4EE5\u6765\uFF0C\u53CC\u65B9\u56E2\u7EC4\u4E92\u8BBF\u9891\u9891\uFF0C\u901A\u8FC7\u5F00\u5C55\u5F62\u5F0F\u591A\u6837\u7684\u5404\u9886\u57DF\u4EA4\u6D41\u6D3B\u52A8\uFF0C\u5F62\u6210\u4E86\u52A1\u5B9E\u9AD8\u6548\u7684\u5408\u4F5C\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u9001\u738B\u8239\u201D\u662F\u5E7F\u6CDB\u6D41\u4F20\u4E8E\u798F\u5EFA\u548C\u9A6C\u6765\u897F\u4E9A\u9A6C\u516D\u7532\u6CBF\u6D77\u5730\u533A\u79B3\u707E\u7948\u5B89\u7684\u4E00\u79CD\u6C11\u95F4\u4FE1\u4FD7\u30022020\u5E7412\u6708\uFF0C\u7531\u4E2D\u56FD\u4E0E\u9A6C\u6765\u897F\u4E9A\u8054\u5408\u7533\u62A5\u7684\u201C\u9001\u738B\u8239\u2014\u2014\u6709\u5173\u4EBA\u4E0E\u6D77\u6D0B\u53EF\u6301\u7EED\u8054\u7CFB\u7684\u4EEA\u5F0F\u53CA\u76F8\u5173\u5B9E\u8DF5\u201D\u9879\u76EE\uFF0C\u5217\u5165\u8054\u5408\u56FD\u6559\u79D1\u6587\u7EC4\u7EC7\u4EBA\u7C7B\u975E\u7269\u8D28\u6587\u5316\u9057\u4EA7\u4EE3\u8868\u4F5C\u540D\u5F55\uFF0C\u7559\u4E0B\u4E86\u4E2D\u9A6C\u8054\u5408\u7533\u9057\u7684\u4E00\u6BB5\u4F73\u8BDD\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/05/frc-1fd5d600f0cf3e5252e7f66274d65842.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E2020\u5E7412\u6708\uFF0C\u201C\u9001\u738B\u8239\u201D\u6D3B\u52A8\u5728\u798F\u5EFA\u53A6\u95E8\u949F\u5B85\u7572\u65CF\u793E\u533A\u6F9C\u6D77\u5BAB\u4E3E\u529E\u3002(\u8D44\u6599\u56FE) \u4E2D\u65B0\u793E\u8BB0\u8005 \u5415\u660E \u6444\u003C/p\u003E\n\u003Cp\u003E1921\u5E74\u7231\u56FD\u534E\u4FA8\u9886\u8896\u9648\u5609\u5E9A\u8FD4\u4E61\u503E\u8D44\u521B\u529E\u53A6\u95E8\u5927\u5B66\u3002\u65F6\u9694\u7EA690\u5E74\uFF0C\u53A6\u5927\u9A6C\u6765\u897F\u4E9A\u5206\u6821\u7B79\u5EFA\uFF0C\u5E76\u4E8E2016\u5E74\u8FCE\u6765\u9996\u6279\u5B66\u751F\u3002\u8FD9\u662F\u4E2D\u56FD\u5927\u9646\u9AD8\u6821\u5728\u6D77\u5916\u5EFA\u7ACB\u7684\u7B2C\u4E00\u6240\u5206\u6821\uFF0C\u4E5F\u4F7F\u9A6C\u6765\u897F\u4E9A\u6210\u4E3A\u6D77\u5916\u552F\u4E00\u62E5\u6709\u5B8C\u6574\u534E\u6587\u6559\u80B2\u4F53\u7CFB\u7684\u56FD\u5BB6\u3002\u003C/p\u003E\n\u003Cp\u003E\u534E\u4FA8\u534E\u4EBA\u662F\u798F\u5EFA\u4E0E\u9A6C\u6765\u897F\u4E9A\u52A1\u5B9E\u5408\u4F5C\u7684\u6865\u6881\u3002\u798F\u5EFA\u7701\u4EE3\u8868\u56E2\u6B64\u6B21\u8BBF\u95EE\u9A6C\u6765\u897F\u4E9A\uFF0C\u4E0D\u4EC5\u8003\u5BDF\u534E\u5546\u4F01\u4E1A\uFF0C\u4E0E\u95FD\u7C4D\u534E\u5546\u6DF1\u5165\u4EA4\u6D41\uFF0C\u8FD8\u8003\u5BDF\u534E\u6587\u62A5\uFF0C\u8D70\u8BBF\u534E\u4EBA\u793E\u56E2\uFF0C\u770B\u671B\u534E\u6587\u6559\u5E08\u3002\u5468\u7956\u7FFC\u8868\u793A\uFF0C\u5E0C\u671B\u5E7F\u5927\u4E61\u4EB2\u548C\u793E\u56E2\u79EF\u6781\u53C2\u4E0E\u65B0\u798F\u5EFA\u5EFA\u8BBE\uFF0C\u5728\u4E92\u5229\u5171\u8D62\u4E2D\u62D3\u5C55\u4E8B\u4E1A\u53D1\u5C55\u65B0\u7A7A\u95F4\uFF1B\u53D1\u6325\u4F18\u52BF\u548C\u6E20\u9053\uFF0C\u591A\u63A8\u4ECB\u798F\u5EFA\uFF0C\u5F15\u9886\u66F4\u591A\u9A6C\u6765\u897F\u4E9A\u5404\u754C\u670B\u53CB\u4E00\u8D77\u5230\u798F\u5EFA\u5171\u4EAB\u5546\u673A\u3001\u5171\u4FC3\u5408\u4F5C\u3001\u5171\u8D62\u672A\u6765\u3002\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u73B0\u4E3A\u798F\u5EFA\u5728\u4E1C\u76DF\u7684\u7B2C\u4E8C\u5927\u5BF9\u5916\u6295\u8D44\u76EE\u7684\u5730\u3001\u7B2C\u4E09\u5927\u5916\u8D44\u6765\u6E90\u5730\u548C\u7B2C\u56DB\u5927\u8D38\u6613\u4F19\u4F34\u3002\u5B98\u65B9\u7EDF\u8BA1\u6570\u636E\u663E\u793A\uFF0C\u622A\u81F32022\u5E74\u5E95\uFF0C\u9A6C\u6765\u897F\u4E9A\u5728\u798F\u5EFA\u6295\u8D44689\u4E2A\u9879\u76EE\uFF0C\u7D2F\u8BA1\u5408\u540C\u5916\u8D4429.9\u4EBF\u7F8E\u5143\uFF0C\u5B9E\u9645\u5230\u8D4418.3\u4EBF\u7F8E\u5143\uFF1B\u798F\u5EFA\u7ECF\u5907\u6848\u5BF9\u9A6C\u6765\u897F\u4E9A\u6295\u8D44\u5883\u5916\u4F01\u4E1A\u4E0E\u5206\u652F\u673A\u678475\u5BB6\uFF0C\u4E2D\u65B9\u534F\u8BAE\u6295\u8D44\u989D10.5\u4EBF\u7F8E\u5143\u3002\u003C/p\u003E\n\u003Cp\u003E\u90D1\u4E49\u8BA4\u4E3A\uFF0C\u9A6C\u6765\u897F\u4E9A\u8425\u5546\u73AF\u5883\u4F18\u8D8A\uFF0C\u8F90\u5C04\u5E02\u573A\u5E7F\u9614\uFF0C\u5236\u9020\u4E1A\u548C\u670D\u52A1\u4E1A\u53D1\u8FBE\uFF0C\u4E0E\u798F\u5EFA\u5728\u7ECF\u8D38\u9886\u57DF\u5177\u6709\u5F88\u5F3A\u7684\u4E92\u8865\u6027\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u53CC\u5411\u5954\u8D74\u201D\u70ED\u7EDC\uFF0C\u63A8\u52A8\u798F\u5EFA\u4E0E\u9A6C\u6765\u897F\u4E9A\u6DF1\u5316\u52A1\u5B9E\u5408\u4F5C\u8FC8\u4E0A\u66F4\u9AD8\u5C42\u6B21\u30022020\u5E74\u81F32021\u5E74\uFF0C\u798F\u5EFA\u8FDE\u7EED\u4E24\u5E74\u5408\u4F5C\u3001\u652F\u6301\u4E3E\u529E\u7B2C\u5341\u5C4A\u548C\u7B2C\u5341\u4E00\u5C4A\u9A6C\u4E2D\u4F01\u4E1A\u5BB6\u5927\u4F1A\uFF0C\u7EC4\u7EC7\u7535\u5B50\u4FE1\u606F\u3001\u6E2F\u53E3\u7269\u6D41\u3001\u73B0\u4EE3\u519C\u4E1A\u7B49\u884C\u4E1A\u4F01\u4E1A\u4E0E\u9A6C\u6765\u897F\u4E9A\u4F01\u4E1A\u5BF9\u63A5\u5408\u4F5C\u3002\u003C/p\u003E\n\u003Cp\u003E\u5728\u9A6C\u6765\u897F\u4E9A\uFF0C\u53A6\u95E8\u76C8\u8DA3\u79D1\u6280\u80A1\u4EFD\u6709\u9650\u516C\u53F8\u6295\u8D44\u5EFA\u8BBE\u7684\u76C8\u8DA3\u9A6C\u6765\u897F\u4E9A\u667A\u80FD\u5236\u9020\u4EA7\u4E1A\u7ECF\u8D38\u5408\u4F5C\u56ED\u4E00\u671F\u56DB\u680B\u5382\u623F\u5DF2\u4EA4\u4ED8\u4F7F\u7528\u3002\u8BE5\u516C\u53F8\u8D1F\u8D23\u4EBA\u8868\u793A\uFF0C\u8BE5\u4EA7\u4E1A\u56ED\u5C06\u8FDB\u4E00\u6B65\u5E26\u52A8\u4EA7\u4E1A\u94FE\u53D1\u5C55\uFF0C\u81F4\u529B\u6253\u9020\u6210\u4E16\u754C\u4E00\u6D41\u7684\u9AD8\u7AEF\u667A\u9020\u56ED\u533A\u3002\u003C/p\u003E\n\u003Cp\u003E\u6B64\u6B21\u8BBF\u9A6C\u671F\u95F4\uFF0C\u798F\u5EFA\u7701\u4EE3\u8868\u56E2\u4E3E\u529E\u201C\u6D77\u4E1D\u8D77\u70B9\u3001\u6E05\u65B0\u798F\u5EFA\u201D\u6587\u5316\u65C5\u6E38\u63A8\u4ECB\u4F1A\u548C\u4E2D\u56FD(\u798F\u5EFA)\u2014\u9A6C\u6765\u897F\u4E9A\u4EA7\u4E1A\u5408\u4F5C\u5EA7\u8C08\u4F1A\uFF0C\u798F\u5EFA\u7701\u4E0E\u6C99\u635E\u8D8A\u5DDE\u7B7E\u7F72\u6DF1\u5316\u53CB\u57CE\u5408\u4F5C\u7684\u76F8\u5173\u534F\u8BAE\uFF0C\u4E3A\u4FC3\u8FDB\u53CC\u65B9\u7ECF\u8D38\u3001\u6587\u65C5\u5408\u4F5C\u6CE8\u5165\u65B0\u52A8\u529B\u3001\u521B\u9020\u65B0\u673A\u9047\u3002\u5468\u7956\u7FFC\u8868\u793A\uFF0C\u5C06\u628A\u63E1\u300A\u533A\u57DF\u5168\u9762\u7ECF\u6D4E\u4F19\u4F34\u5173\u7CFB\u534F\u5B9A\u300B(RCEP)\u843D\u5730\u751F\u6548\u7684\u91CD\u8981\u673A\u9047\uFF0C\u7EC4\u7EC7\u4F01\u4E1A\u5F00\u62D3\u9A6C\u6765\u897F\u4E9A\u548C\u4E1C\u76DF\u5E02\u573A\uFF1B\u4E5F\u5E0C\u671B\u9A6C\u6765\u897F\u4E9A\u4F01\u4E1A\u7EC4\u56E2\u53C2\u52A0\u5728\u798F\u5EFA\u53A6\u95E8\u4E3E\u529E\u7684\u4E2D\u56FD\u56FD\u9645\u6295\u8D44\u8D38\u6613\u6D3D\u8C08\u4F1A\u7B49\u5C55\u4F1A\uFF0C\u6DF1\u5316\u5728\u7ECF\u8D38\u3001\u91D1\u878D\u3001\u79D1\u6280\u3001\u4EBA\u6587\u7B49\u65B9\u9762\u7684\u52A1\u5B9E\u5408\u4F5C\uFF0C\u643A\u624B\u5171\u5EFA\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u3002(\u5B8C)\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/Yjh500FwaIfyhK8cjEkwZg\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
