  "route": "/3598/",
  "title": "\u5DF4\u65AF\u592B\u9A6C\u6765\u897F\u4E9A\u5173\u4E39\u57FA\u5730\u5F02\u8F9B\u9178\u6269\u5EFA\u9879\u76EE\u5960\u57FA",
  "summary": "3\u670815\u65E5\uFF0C\u636E\u5DF4\u65AF\u592B\u5B98\u5FAE\u6D88\u606F\uFF0C\u5DF4\u65AF\u592B\u9A6C\u6765\u897F\u4E9A\u5173\u4E39\u57FA\u5730\u5F02\u8F9B\u9178\u6269\u5EFA\u9879\u76EE\u7684\u5960\u57FA\u4EEA\u5F0F\u4E8E\u8FD1\u65E5\u4E3E\u884C\u3002\u8BE5\u57FA\u5730\u7684\u5E74\u4EA7\u80FD\u9884\u8BA1\u5C06\u4E8E2024\u5E74\u7B2C\u56DB\u5B63\u500D\u589E\u81F36\u4E07\u516C\u5428\u3002 \u9A6C\u6765\u897F\u4E9A\u5173\u4E39 \u2014\u2014 2020\u5E7411\u670818\u65E5 \u2014\u2014 \u7531\u5DF4\u65AF\u592B\u4E0E\u9A6C\u6765\u897F\u4E9A\u56FD\u5BB6\u77F3\u6CB9\u516C\u53F8\u65D7\u4E0B\u5B50\u516C\u53F8\u56FD\u6CB9\u77F3\u5316\u96C6\u56E2\uFF08PCG\uFF09\u5408\u8D44\u6210\u7ACB\u7684\u9A6C\u6765\u897F\u4E9A\u5DF4\u65AF\u592B\u56FD\u6CB9\u5316\u5B66\uFF08BPC\uFF09\u6B63\u8BA1\u5212\u91CD\u65B0\u8C03\u6574\u5176\u4EA7\u54C1\u7EC4\u5408\uFF0C\u7740\u773C\u4E8E\u957F\u671F\u589E\u957F\u3002 \u5DF4\u65AF\u592B\u548C PCG \u6301\u7EED\u5BA1\u89C6\u5176\u4EA7\u54C1\u7EC4\u5408\u5E76\u8FDB\u884C\u4F18\u5316\u8C03\u6574\u3002\u9274\u4E8E\u6B64\uFF0C\u9A6C\u6765\u897F\u4E9A\u5DF4\u65AF\u592B\u56FD\u6CB9\u5316\u5B66\u8BA1\u5212\u5C06\u4E8E2021\u5E743\u6708\u5173\u95ED\u5176\u4F4D\u4E8E\u9A6C\u6765\u897F\u4E9A\u5173\u4E39\u7684\u4E01\u2026",
  "body": "\u003Cp\u003E3\u670815\u65E5\uFF0C\u636E\u5DF4\u65AF\u592B\u5B98\u5FAE\u6D88\u606F\uFF0C\u5DF4\u65AF\u592B\u9A6C\u6765\u897F\u4E9A\u5173\u4E39\u57FA\u5730\u5F02\u8F9B\u9178\u6269\u5EFA\u9879\u76EE\u7684\u5960\u57FA\u4EEA\u5F0F\u4E8E\u8FD1\u65E5\u4E3E\u884C\u3002\u8BE5\u57FA\u5730\u7684\u5E74\u4EA7\u80FD\u9884\u8BA1\u5C06\u4E8E2024\u5E74\u7B2C\u56DB\u5B63\u500D\u589E\u81F36\u4E07\u516C\u5428\u3002\n\n\u9A6C\u6765\u897F\u4E9A\u5173\u4E39 \u2014\u2014 2020\u5E7411\u670818\u65E5 \u2014\u2014 \u7531\u5DF4\u65AF\u592B\u4E0E\u9A6C\u6765\u897F\u4E9A\u56FD\u5BB6\u77F3\u6CB9\u516C\u53F8\u65D7\u4E0B\u5B50\u516C\u53F8\u56FD\u6CB9\u77F3\u5316\u96C6\u56E2\uFF08PCG\uFF09\u5408\u8D44\u6210\u7ACB\u7684\u9A6C\u6765\u897F\u4E9A\u5DF4\u65AF\u592B\u56FD\u6CB9\u5316\u5B66\uFF08BPC\uFF09\u6B63\u8BA1\u5212\u91CD\u65B0\u8C03\u6574\u5176\u4EA7\u54C1\u7EC4\u5408\uFF0C\u7740\u773C\u4E8E\u957F\u671F\u589E\u957F\u3002\n\n\u5DF4\u65AF\u592B\u548C PCG \u6301\u7EED\u5BA1\u89C6\u5176\u4EA7\u54C1\u7EC4\u5408\u5E76\u8FDB\u884C\u4F18\u5316\u8C03\u6574\u3002\u9274\u4E8E\u6B64\uFF0C\u9A6C\u6765\u897F\u4E9A\u5DF4\u65AF\u592B\u56FD\u6CB9\u5316\u5B66\u8BA1\u5212\u5C06\u4E8E2021\u5E743\u6708\u5173\u95ED\u5176\u4F4D\u4E8E\u9A6C\u6765\u897F\u4E9A\u5173\u4E39\u7684\u4E01\u4E8C\u9187\uFF08BDO\uFF09\u53CA\u5176\u884D\u751F\u54C1\u751F\u4EA7\u88C5\u7F6E\u3002\u8BE5\u51B3\u5B9A\u5C06\u4E0D\u4F1A\u5F71\u54CD\u8BE5\u5EA7\u751F\u4EA7\u57FA\u5730\u91CC\u7684\u5176\u4ED6\u88C5\u7F6E\u3002\n\n\u5DF4\u65AF\u592B\u4E9A\u592A\u533A\u4E2D\u95F4\u4F53\u4E1A\u52A1\u90E8\u5168\u7403\u9AD8\u7EA7\u526F\u603B\u88C1\u534E\u601D\u6881\uFF08Vasilios Galanos\uFF09\u8868\u793A\uFF1A\u201C\u4F5C\u4E3A\u4ECE\u4E8BBDO\u53CA\u884D\u751F\u54C1\u4E1A\u52A1\u7684\u9886\u5148\u516C\u53F8\u4E4B\u4E00\uFF0C\u6211\u4EEC\u957F\u671F\u81F4\u529B\u4E8EBDO\u4EF7\u503C\u94FE\u7684\u6301\u7EED\u53D1\u5C55\u3002\u8BE5\u4E3E\u63AA\u662F\u6211\u4EEC\u6218\u7565\u7684\u4E00\u90E8\u5206\uFF0C\u4EE5\u786E\u4FDD\u6211\u4EEC\u8FDB\u4E00\u6B65\u63D0\u5347\u5E02\u573A\u7ADE\u4E89\u529B\uFF0C\u4E3A\u6211\u4EEC\u5BA2\u6237\u7684\u4E1A\u52A1\u53D1\u5C55\u3001\u540C\u65F6\u4E5F\u4E3A\u5DF4\u65AF\u592B\u4EE5\u53CABPC\u5E26\u6765\u957F\u671F\u7684\u4EF7\u503C\u3002\u201D\n\nPCG \u8463\u4E8B\u603B\u7ECF\u7406\u517C\u9996\u5E2D\u6267\u884C\u5B98 Datuk Sazali Hamzah \u8868\u793A\uFF1A\u201C\u8003\u8651\u5230\u4E1A\u52A1\u683C\u5C40\u7684\u53D8\u5316\u4EE5\u53CABDO\u88C5\u7F6E\u5E76\u4E0D\u4E50\u89C2\u7684\u957F\u671F\u524D\u666F\uFF0C\u6211\u4EEC\u51B3\u5B9A\u5173\u95ED\u8FD9\u4E00\u88C5\u7F6E\uFF0C\u8FD9\u5C06\u4E3A\u9A6C\u6765\u897F\u4E9A\u5DF4\u65AF\u592B\u56FD\u6CB9\u5316\u5B66\u53CA\u5176\u5229\u76CA\u76F8\u5173\u8005\u5E26\u6765\u957F\u671F\u7684\u6218\u7565\u5229\u76CA\u3002\u8FD9\u4E5F\u4E0E\u9A6C\u6765\u897F\u4E9A\u56FD\u5BB6\u77F3\u6CB9\u516C\u53F8\u65D7\u4E0B\u56FD\u6CB9\u77F3\u5316\u96C6\u56E2\u7684\u6269\u5C55\u8BA1\u5212\u76F8\u4E00\u81F4\uFF0C\u8BE5\u8BA1\u5212\u91CC\u5305\u62EC\u4E86\u53D1\u5C55\u7279\u79CD\u5316\u5B66\u54C1\u4E1A\u52A1\u3002\u6211\u4EEC\u671F\u5F85\u4F7F\u7528\u5148\u8FDB\u6280\u672F\u751F\u4EA7\u51FA\u9AD8\u4EF7\u503C\u7684\u65B0\u4EA7\u54C1\u3002\u8FD9\u4E5F\u5C06\u52A9\u529B\u6211\u4EEC\u5F00\u62D3\u65B0\u5E02\u573A\u3001\u8D62\u5F97\u65B0\u5BA2\u6237\uFF0C\u8FDB\u4E00\u6B65\u4FC3\u8FDB\u4E1A\u52A1\u7684\u53EF\u6301\u7EED\u589E\u957F\u3002\u201D\n\nBPC\u8463\u4E8B\u603B\u7ECF\u7406\u9A6C\u8BDA\u67EF\uFF08Marko Murtonen\uFF09\u8868\u793A\uFF1A\u201C\u8FD9\u4E00\u51B3\u5B9A\u4E5F\u662F\u7531\u4E8E\u8BE5\u5730\u533A\u65B0\u8FD1\u6295\u8D44\u7684\u6570\u4E2A\u7164\u57FABDO \u751F\u4EA7\u88C5\u7F6E\uFF0C\u5BFC\u81F4\u4EA7\u80FD\u4E25\u91CD\u8FC7\u5269\u3002\u76EE\u524D\uFF0CBPC\u6B63\u5728\u5BFB\u6C42\u6240\u6709\u5BA2\u6237\u7684\u652F\u6301\uFF0C\u4EE5\u5B9E\u73B0\u5E73\u7A33\u8FC7\u6E21\u3002\u6211\u4EEC\u5C06\u7EE7\u7EED\u901A\u8FC7\u751F\u4EA7\u5176\u4ED6\u4EA7\u54C1\u4E3A\u8BE5\u5730\u533A\u7684\u5BA2\u6237\u63D0\u4F9B\u670D\u52A1\u3002\u6B64\u5916\uFF0C\u6211\u4EEC\u5C06\u5728\u8FD9\u4E00\u8FC7\u6E21\u65F6\u671F\u4E0E\u53D7\u5F71\u54CD\u7684\u5458\u5DE5\u4FDD\u6301\u5BC6\u5207\u6C9F\u901A\uFF0C\u4E3A\u5176\u63D0\u4F9B\u652F\u6301\u4E0E\u5E2E\u52A9\u3002\u201D\n\nBDO\u53CA\u5176\u884D\u751F\u54C1\u662F\u751F\u4EA7\u5DE5\u7A0B\u5851\u6599\u3001\u805A\u6C28\u916F\u3001\u6EB6\u5242\u548C\u5F39\u6027\u6C28\u7EB6\u7EA4\u7EF4\u7684\u91CD\u8981\u5316\u5B66\u539F\u6599\u3002\n\n\u003Cstrong\u003E\u5173\u4E8E\u9A6C\u6765\u897F\u4E9A\u5DF4\u65AF\u592B\u56FD\u6CB9\u5316\u5B66\u003C/strong\u003E\n\n\u9A6C\u6765\u897F\u4E9A\u5DF4\u65AF\u592B\u56FD\u6CB9\u5316\u5B66\u662F\u5DF4\u65AF\u592B\u516C\u53F8\u4E0E\u9A6C\u6765\u897F\u4E9A\u7EFC\u5408\u6027\u7684\u77F3\u6CB9\u548C\u5929\u7136\u6C14\u4F01\u4E1A\u2014\u2014\u9A6C\u6765\u897F\u4E9A\u56FD\u5BB6\u77F3\u6CB9\u516C\u53F8\uFF08PETRONAS\uFF09\u65D7\u4E0B\u5B50\u516C\u53F8\u56FD\u6CB9\u77F3\u5316\u96C6\u56E2\uFF08PCG\uFF09\u5171\u540C\u6295\u8D44\u6210\u7ACB\u7684\u5408\u8D44\u4F01\u4E1A\u3002\u8BE5\u516C\u53F8\u6210\u7ACB\u4E8E1997\u5E74\uFF0C\u5728\u5F6D\u4EA8\u5DDE\u5173\u4E39\u5E02\u683C\u5BBE\u5DE5\u4E1A\u533A\u5185\u62E5\u6709\u4E00\u5EA7\u7EFC\u5408\u6027\u5316\u5DE5\u4E00\u4F53\u5316\u57FA\u5730\u3002\u5DF4\u65AF\u592B\u6301\u6709\u8BE5\u5408\u8D44\u516C\u53F860%\u7684\u80A1\u4EFD\uFF0C\u800C\u56FD\u6CB9\u77F3\u5316\u96C6\u56E2\uFF08PCG\uFF09\u5219\u6301\u6709\u4F59\u4E0B\u768440%\u7684\u80A1\u4EFD\u3002\u4E3B\u8981\u4EA7\u54C1\u5305\u62EC\u4E19\u70EF\u9178\u5355\u4F53\uFF0C\u7FB0\u57FA\u5408\u6210\u4EA7\u54C1\uFF0C\u4E01\u4E8C\u9187\uFF0C2-\u4E59\u57FA\u5DF1\u9178\uFF0C\u9AD8\u53CD\u5E94\u6027\u805A\u5F02\u4E01\u70EF\u548C\u9999\u6C14\u6210\u5206\u3002\n\u003C/p\u003E\n\u003Cp\u003E\n\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/vVVimTrHFEtO8F71mELnIA\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
