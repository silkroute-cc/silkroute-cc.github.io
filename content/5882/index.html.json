  "summary": "2\u670828\u65E5\uFF0C\u9A6C\u6765\u897F\u4E9A\u2014\u4E2D\u56FD\u603B\u5546\u4F1A\u65B0\u6625\u8054\u6B22\u4F1A\u5728\u5409\u9686\u5761\u4E3E\u884C\u3002\u9A7B\u9A6C\u6765\u897F\u4E9A\u4F7F\u9986\u516C\u4F7F\u90D1\u5B66\u65B9\uFF0C\u9A6C\u6765\u897F\u4E9A\u4EA4\u901A\u90E8\u957F\u9646\u5146\u798F\u3001\u8D38\u5DE5\u90E8\u526F\u90E8\u957F\u6C88\u5FD7\u52E4\uFF0C\u9A6C\u4E2D\u603B\u5546\u4F1A\u603B\u4F1A\u957F\u5362\u56FD\u7965\u7B49\u5609\u5BBE\u51FA\u5E2D\u3002 \u90D1\u516C\u4F7F\u4ECB\u7ECD\u4E86\u4E2D\u56FD\u7ECF\u6D4E\u53D1\u5C55\u6210\u5C31\u548C\u4E2D\u56FD\u5916\u4EA4\u653F\u7B56\uFF0C\u6307\u51FA\u4E2D\u56FD\u201C\u5341\u4E94\u4E94\u201D\u89C4\u5212\u5C06\u4E3A\u4E2D\u9A6C\u52A1\u5B9E\u5408\u4F5C\u63D0\u4F9B\u5F3A\u5927\u52A8\u529B\uFF0C\u5FC5\u5C06\u8C31\u5199\u9AD8\u6C34\u5E73\u6218\u7565\u6027\u4E2D\u9A6C\u547D\u8FD0\u5171\u540C\u4F53\u7684\u5D2D\u65B0\u7BC7\u7AE0\u3002\u9646\u5146\u798F\u8868\u793A\uFF0C\u9A6C\u4E2D\u7ECF\u8D38\u5408\u4F5C\u7A7A\u95F4\u5E7F\u9614\u3001\u673A\u9047\u65E0\u9650\uFF0C\u5E0C\u671B\u9A6C\u5546\u754C\u4E0E\u653F\u5E9C\u5BC6\u5207\u914D\u5408\uFF0C\u5171\u540C\u63A8\u52A8\u9A6C\u4E2D\u5408\u4F5C\u8FC8\u4E0A\u65B0\u53F0\u9636\u3002\u5362\u56FD\u7965\u8868\u793A\uFF0C\u9A6C\u4E2D\u603B\u5546\u4F1A\u5C06\u914D\u5408\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38\u5E74\uFF0C\u6DF1\u5316\u4E24\u56FD\u5728\u65C5\u6E38\u3001\u670D\u8D38\u7B49\u9886\u57DF\u7684\u52A1\u5B9E\u5408\u4F5C\u3002",
