{
  "id": "%e5%a4%ae%e4%bc%81%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e9%a1%b9%e7%9b%ae-%e5%af%bb-%e6%b2%a5%e9%9d%92%e9%81%93%e8%b7%af%e5%b7%a5%e7%a8%8b%e5%88%86%e5%8c%85",
  "slug": "%e5%a4%ae%e4%bc%81%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e9%a1%b9%e7%9b%ae-%e5%af%bb-%e6%b2%a5%e9%9d%92%e9%81%93%e8%b7%af%e5%b7%a5%e7%a8%8b%e5%88%86%e5%8c%85",
  "canonicalUrlKey": "%e5%a4%ae%e4%bc%81%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e9%a1%b9%e7%9b%ae-%e5%af%bb-%e6%b2%a5%e9%9d%92%e9%81%93%e8%b7%af%e5%b7%a5%e7%a8%8b%e5%88%86%e5%8c%85",
  "route": "/3846/",
  "title": "\u592E\u4F01\u9A6C\u6765\u897F\u4E9A\u9879\u76EE \u5BFB \u6CA5\u9752\u9053\u8DEF\u5DE5\u7A0B\u5206\u5305",
  "summary": "\u4E00\u3001\u5DE5\u7A0B\u6982\u51B5 \u9A6C\u6765\u897F\u4E9A\u5DF4\u83B1\u6C34\u7535\u7AD9\u516C\u8DEF\u6807\u6BB5\u5DE5\u7A0B\u4F4D\u4E8E\u9A6C\u6765\u897F\u4E9A\u7802\u62C9\u8D8A\u5DDE\u52A0\u5E1B\u7701\uFF0C\u5C5E\u4E8E\u70ED\u5E26\u96E8\u6797\u6C14\u5019\uFF0C\u5E38\u5E74\u5982\u590F\u548C\u6F6E\u6E7F\uFF0C\u65E0\u56DB\u5B63\u4E4B\u5206\uFF0C\u5168\u5E74\u7684\u6E29\u5EA6\u53D8\u5316\u5C0F\uFF0C\u6C14\u6E29\u5E38\u5E74\u4ECB\u4E8E\u6444\u6C0F 23 \u5EA6\u81F3 36 \u5EA6\u4E4B\u95F4\uFF0C\u5E73\u5747\u6C14\u6E29 27 \u5EA6\u3002\u5176\u4E2D U007 \u9053\u8DEF\u4F4D\u4E8E\u52A0\u5E1B\u4E0A\u6E38\u62C9\u8BA9\u6C5F\u5DE6\u5CB8\uFF0C\u603B\u957F 8285m \uFF08\u542B 3 \u5EA7\u8D1D\u96F7\u6865\uFF09\uFF0C\u6CA5\u9752\u8DEF\u9762\uFF1B U012 \u9053\u8DEF\u4F4D\u4E8E\u52A0\u5E1B\u4E1C\u5357\u4FA7\uFF0C\u603B\u957F 3677m \uFF08\u542B 4 \u5EA7\u8D1D\u96F7\u6865\uFF09\uFF0C\u6CA5\u9752\u8DEF\u9762\u3002\u8BE5\u516C\u8DEF\u6807\u6BB5\u5747\u7531\u9A6C\u6765\u897F\u4E9A\u533A\u57DF\u8D70\u5ECA\u53D1\u5C55\u5C40\uFF08 RECODA \uFF09\u65D7\u4E0B\u62C9\u8BA9\u6C5F\u4E0A\u6E38\u53D1\u5C55\u673A\u6784\uFF08 URDA\u2026",
  "body": "\u003Cp\u003E\u003Cstrong\u003E\u4E00\u3001\u5DE5\u7A0B\u6982\u51B5\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u5DF4\u83B1\u6C34\u7535\u7AD9\u516C\u8DEF\u6807\u6BB5\u5DE5\u7A0B\u4F4D\u4E8E\u9A6C\u6765\u897F\u4E9A\u7802\u62C9\u8D8A\u5DDE\u52A0\u5E1B\u7701\uFF0C\u5C5E\u4E8E\u70ED\u5E26\u96E8\u6797\u6C14\u5019\uFF0C\u5E38\u5E74\u5982\u590F\u548C\u6F6E\u6E7F\uFF0C\u65E0\u56DB\u5B63\u4E4B\u5206\uFF0C\u5168\u5E74\u7684\u6E29\u5EA6\u53D8\u5316\u5C0F\uFF0C\u6C14\u6E29\u5E38\u5E74\u4ECB\u4E8E\u6444\u6C0F 23 \u5EA6\u81F3 36 \u5EA6\u4E4B\u95F4\uFF0C\u5E73\u5747\u6C14\u6E29 27 \u5EA6\u3002\u5176\u4E2DU007\u9053\u8DEF\u4F4D\u4E8E\u52A0\u5E1B\u4E0A\u6E38\u62C9\u8BA9\u6C5F\u5DE6\u5CB8\uFF0C\u603B\u957F8285m\uFF08\u542B3\u5EA7\u8D1D\u96F7\u6865\uFF09\uFF0C\u6CA5\u9752\u8DEF\u9762\uFF1BU012\u9053\u8DEF\u4F4D\u4E8E\u52A0\u5E1B\u4E1C\u5357\u4FA7\uFF0C\u603B\u957F3677m\uFF08\u542B4\u5EA7\u8D1D\u96F7\u6865\uFF09\uFF0C\u6CA5\u9752\u8DEF\u9762\u3002\u8BE5\u516C\u8DEF\u6807\u6BB5\u5747\u7531\u9A6C\u6765\u897F\u4E9A\u533A\u57DF\u8D70\u5ECA\u53D1\u5C55\u5C40\uFF08RECODA\uFF09\u65D7\u4E0B\u62C9\u8BA9\u6C5F\u4E0A\u6E38\u53D1\u5C55\u673A\u6784\uFF08URDA\uFF09\u8D1F\u8D23\u5F00\u53D1\u3002\u003C/p\u003E\n\u003Cp\u003EU012\u6807\u6BB5\u4EA4\u901A\u8F83\u4E3A\u4FBF\u5229\uFF0C\u8DDD\u79BB\u9644\u8FD1\u57CE\u5E02\u52A0\u5E1B\u7EA638km\uFF0C\u73B0\u6709\u6CA5\u9752\u9053\u8DEF\u8FDE\u63A5\uFF0C\u53EF\u8FD0\u8F93\u5404\u79CD\u7269\u8D44\u3002U007\u6807\u6BB5\u4EA4\u901A\u8F83\u5DEE\uFF0C\u7B2C\u4E00\u6BB5\u9053\u8DEF\u4E3A\u6CA5\u9752\u8DEF\u7EA635km\uFF0C\u8DEF\u51B5\u8F83\u597D\uFF0C\u7B2C\u4E8C\u6BB5\u4E3A\u4F10\u6728\u571F\u8DEF\uFF0C\u7EA635km\uFF0C\u8BE5\u6BB5\u8DEF\u6761\u4EF6\u5DEE\uFF0C\u4E0D\u6EE1\u8DB3\u5927\u5B97\u7269\u8D44\u8FD0\u8F93\uFF0C\u7269\u8D44\u53EF\u901A\u8FC7\u6C34\u8DEF\u8FD0\u8F93\u3002\u4E24\u6807\u6BB5\u95F4\u8DEF\u7EBF\u8DDD\u79BB\u7EA6110km\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/06/frc-1d310fe34b8a81e0acda5ca17a8e7c96.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/06/frc-bff38b83f147b897a203276e2c930cbb.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/06/frc-7bf5d1712e7804a89f26218220612d95.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u4E09\u3001\u65BD\u5DE5\u8D28\u91CF\u8981\u70B9\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\uFF081\uFF09\u3001\u6D4B\u91CF\u653E\u6837\u003C/p\u003E\n\u003Cp\u003E1\uFF09\u91C7\u7528\u5168\u7AD9\u4EEA\u653E\u51FA\u644A\u94FA\u9053\u7684\u5E73\u9762\u8F6E\u5ED3\u7EBF\uFF08\u4E2D\u7EBF\u3001\u5DE6\u53F3\u8FB9\u7EBF\uFF09,\u6C34\u51C6\u4EEA\u6D4B\u5B9A\u6807\u9AD8\uFF0C\u5E76\u8BA1\u7B97\u786E\u5B9A\u6BCF\u4E2A\u6D4B\u91CF\u70B9\u4E0B\u627F\u5C42\u8868\u9762\u9AD8\u7A0B\u4E0E\u8BBE\u8BA1\u9AD8\u7A0B\u5DEE\uFF0C\u8BBE\u5B9A\u677E\u94FA\u6807\u9AD8\u4EE5\u4FDD\u8BC1\u644A\u94FA\u539A\u5EA6\uFF0C\u4E3A\u644A\u94FA\u673A\u7684\u81EA\u52A8\u627E\u5E73\u88C5\u7F6E\u786E\u5B9A\u57FA\u51C6\u9762\uFF08\u7EBF\uFF09\u3002\u4E0B\u9762\u5C42\u5E03\u8BBE\u53CC\u57FA\u51C6\u7EBF\u3002\u003C/p\u003E\n\u003Cp\u003E2\uFF09\u4EE57.5m\u0026#215;5m\u4E3A\u7F51\u683C\u5BF9\u8981\u65BD\u5DE5\u7684\u539F\u6709\u8DEF\u9762\u6216\u57FA\u5C42\u9762\u518D\u6B21\u6D4B\u91CF\u4EE5\u786E\u4FDD\u9AD8\u7A0B\u548C\u5E73\u6574\u5EA6\u8FBE\u5230\u89C4\u5B9A\u8981\u6C42\u3002\u003C/p\u003E\n\u003Cp\u003E\uFF082\uFF09\u3001\u94E3\u5228\u003C/p\u003E\n\u003Cp\u003E\u6839\u636E\u56FE\u7EB8\u6216\u5DE5\u7A0B\u5E08\u7684\u6307\u4EE4\uFF0C\u7528\u7C89\u7B14\u53CA\u5176\u5B83\u53EF\u4EE5\u4F5C\u8BB0\u53F7\u7684\u5DE5\u5177\u5728\u8BE5\u94E3\u5228\u7684\u4F4D\u7F6E\u4F5C\u6807\u8BB0\u3002\u5E76\u6309\u7167\u8981\u6C42\u6D17\u5228\u5230\u76F8\u5E94\u7684\u6DF1\u5EA6\u3002\u9488\u5BF9\u6D17\u5228\u540E\u7684\u65E7\u6CA5\u9752\u7684\u4E0D\u540C\u7528\u9014\uFF0C\u5206\u522B\u505A\u4E0D\u540C\u7684\u5904\u7406\u3002\u003C/p\u003E\n\u003Cp\u003E\uFF083\uFF09\u3001\u7C98\u5C42\u6CB9\u548C\u900F\u5C42\u6CB9\u65BD\u5DE5\u003C/p\u003E\n\u003Cp\u003E1\uFF09\u900F\u5C42\u6CB9\u4E0E\u7C98\u5C42\u6CB9\u55B7\u6D12\u003C/p\u003E\n\u003Cp\u003E\u55B7\u6D12\u524D\uFF0C\u6E05\u626B\u4E0B\u627F\u5C42\u4EE5\u63D0\u4F9B\u5408\u683C\u7684\u5DE5\u4F5C\u9762\u3002\u6309\u8BBE\u8BA1\u7528\u91CF\u91C7\u7528\u6CA5\u9752\u6D12\u5E03\u8F66\u81EA\u52A8\u55B7\u6D12\uFF0C\u5F2F\u9053\u3001\u8FB9\u89D2\u4F7F\u7528\u6D12\u5E03\u8F66\u8F66\u8F7D\u624B\u52A8\u55B7\u6746\u8FDB\u884C\u4EBA\u5DE5\u55B7\u6D12\u3002\u003C/p\u003E\n\u003Cp\u003E2\uFF09\u6D12\u5E03\u540E\u7684\u8F66\u9053\u4E88\u4EE5\u5C01\u95ED\u3002\u003C/p\u003E\n\u003Cp\u003E5.4.2.3\u3001\u666E\u901A\u6CA5\u9752\u783C\u65BD\u5DE5\u003C/p\u003E\n\u003Cp\u003E\uFF081\uFF09\u3001\u62CC\u5236\u003C/p\u003E\n\u003Cp\u003E1)\u6839\u636E\u8BD5\u62CC\u786E\u5B9A\u4ECE\u8FDB\u6599\u5230\u51FA\u4ED3\u7EFC\u5408\u62CC\u5408\u65F6\u95F4\u548C\u5E72\u62CC\u3001\u6E7F\u62CC\u3001\u5F85\u6599\u65F6\u95F4\uFF0C\u5E76\u68C0\u6D4B\u96C6\u6599\u3001\u6CA5\u9752\u3001\u6DF7\u5408\u6599\u7684\u6E29\u5EA6\u3002\u003C/p\u003E\n\u003Cp\u003E2)\u6309\u9891\u7387\u5BF9\u6DF7\u5408\u6599\u53D6\u6837\u8BD5\u9A8C\uFF0C\u5E76\u7528\u7EA2\u5916\u7EBF\u6D4B\u6E29\u4EEA\u6216\u6570\u663E\u6E29\u5EA6\u8BA1\u68C0\u6D4B\u6DF7\u5408\u6599\u6E29\u5EA6\uFF0C\u89C2\u5BDF\u5927\u81F4\u6CB9\u77F3\u6BD4\u3001\u8272\u6CFD\u3001\u662F\u5426\u79BB\u6790\u6216\u8005\u7ED3\u5757\u6210\u56E2\u7B49\uFF0C\u5E76\u6839\u636E\u89C2\u5BDF\u7ED3\u679C\u53CA\u65F6\u53CD\u9988\u3001\u5904\u7406\u548C\u8C03\u6574\u3002\u003C/p\u003E\n\u003Cp\u003E\uFF082\uFF09\u3001\u8FD0\u8F93\u003C/p\u003E\n\u003Cp\u003E1\uFF09\u6839\u636E\u62CC\u548C\u7AD9\u7684\u6027\u80FD\u3001\u8FD0\u8DDD\u3001\u9053\u8DEF\u6761\u4EF6\u548C\u8F66\u7684\u5428\u4F4D\u7B49\uFF0C\u62DF\u91C7\u752820t\u81EA\u5378\u8F66\u8FDB\u884C\u8FD0\u8F93\u3002\u003C/p\u003E\n\u003Cp\u003E2\uFF09\u8F66\u53A2\u5185\u8868\u9762\u91C7\u7528\u6D82\u5237\u9694\u79BB\u5242\u4EE5\u9632\u6B62\u6CA5\u9752\u783C\u7C98\u5230\u8F66\u4E0A\u3002\u003C/p\u003E\n\u003Cp\u003E3\uFF09\u91C7\u7528\u8F66\u7528\u5E06\u5E03\u6216\u68C9\u88AB\u8986\u76D6\u5361\u8F66\uFF0C\u4EE5\u786E\u4FDD\u6CA5\u9752\u783C\u6E29\u5EA6\u8FD0\u5230\u73B0\u573A\u540E\u6EE1\u8DB3\u89C4\u8303\u8981\u6C42\u3002\u003C/p\u003E\n\u003Cp\u003E\uFF083\uFF09\u3001\u644A\u94FA\u003C/p\u003E\n\u003Cp\u003E1)\u6B63\u5E38\u644A\u94FA\u6E29\u5EA6\u5E94\u6EE1\u8DB3\u89C4\u8303\u548C\u5DE5\u7A0B\u5E08\u7684\u8981\u6C42\u3002\u003C/p\u003E\n\u003Cp\u003E2)\u644A\u94FA\u65B9\u6CD5\uFF1A\u003C/p\u003E\n\u003Cp\u003E\u91C7\u7528\u5C65\u5E26\u5F0F\u8FDE\u7EED\u644A\u94FA\u673A\u8FDB\u884C\u644A\u94FA\uFF0C\u5BF9\u4E8E\u8FB9\u89D2\u7B49\u673A\u68B0\u4E0D\u6613\u4F5C\u4E1A\u7684\u533A\u57DF\u91C7\u7528\u4EBA\u5DE5\u644A\u94FA\u3002\u003C/p\u003E\n\u003Cp\u003E3)\u644A\u94FA\u8FC7\u7A0B\u003C/p\u003E\n\u003Cp\u003E\u6309\u89C4\u5B9A\u901F\u5EA6\u6CBF\u57FA\u51C6\u9762(\u7EBF)\u5411\u524D\u644A\u94FA\uFF0C\u644A\u94FA\u673A\u884C\u8FDB\u8FC7\u7A0B\u4E2D\u6CE8\u610F\u540C\u6599\u8F66\u7684\u914D\u5408\uFF0C\u5E76\u638C\u63E1\u597D\u8FDB\u6599\u901F\u5EA6\uFF0C\u6BCF\u96945\u7C73\u68C0\u9A8C\u4E00\u6B21\u644A\u94FA\u6807\u9AD8\uFF0C\u505A\u597D\u6536\u6599\u8BB0\u6570\u548C\u644A\u94FA\u6E29\u5EA6\u6D4B\u68C0\u5DE5\u4F5C\u3002\u003C/p\u003E\n\u003Cp\u003E\uFF084\uFF09\u3001\u78BE\u538B\u003C/p\u003E\n\u003Cp\u003E1)\u673A\u68B0\u7684\u9009\u62E9\uFF1A\u62DF\u914D\u59072\u53F0\u632F\u52A8\u78BE\u8FDB\u884C\u78BE\u538B\u3002\u5BF9\u8FB9\u89D2\u533A\u57DF\u5E94\u91C7\u7528\u632F\u52A8\u677F\u8FDB\u884C\u78BE\u538B\uFF0C\u6BCF\u4E2A\u644A\u94FA\u5E26\uFF0C\u4ECE\u8FB9\u7F18\u5230\u4E2D\u95F4\u3002\u4E24\u4E2A\u644A\u94FA\u5E26\u7684\u642D\u63A5\u5BBD\u5EA6\u5E94\u4E3A30cm\u3002\u003C/p\u003E\n\u003Cp\u003E2)\u538B\u5B9E\u65B9\u5F0F\uFF1A\u9759\u78BE\u548C\u632F\u52A8\u76F8\u7ED3\u5408\uFF0C\u6BCF\u644A\u94FA\u9053\u7531\u8FB9\u7F18\u538B\u5411\u4E2D\u95F4\uFF0C\u632F\u52A8\u78BE\u538B\u6BCF\u6B21\u91CD\u53E0\u5BBD\u4E3A10\uFF5E20cm\uFF0C\u9759\u78BE\u91CD\u53E0\u5BBD20cm\u4EE5\u4E0A\u3002\u003C/p\u003E\n\u003Cp\u003E3)\u78BE\u538B\u7A0B\u5E8F\uFF1A\u521D\u78BE\u538B\u2192\u518D\u6B21\u78BE\u538B\u2192\u6700\u7EC8\u78BE\u538B\u3002\u003C/p\u003E\n\u003Cp\u003E\uFF085\uFF09\u3001\u63A5\u7F1D\u7684\u5904\u7406\u003C/p\u003E\n\u003Cp\u003E\u5F53\u65E5\u644A\u94FA\u7ED3\u675F\u7EC8\u7AEF\u505A\u6210\u659C\u5761\uFF0C\u6B21\u65E5\u65BD\u5DE5\u524D\u7528\u76F4\u5C3A\u786E\u5B9A\u6A2A\u63A5\u7F1D\u7684\u94E3\u5228\u4F4D\u7F6E\uFF0C\u7528\u952F\u7F1D\u673A\u6216\u94E3\u5228\u673A\u5C06\u63A5\u7F1D\u8FB9\u53E3\u5207\u6210\u76F4\u89D2\uFF0C\u6E05\u626B\u5E72\u51C0\u540E\u5237\u7C98\u5C42\u6CB9\u3002\u003C/p\u003E\n\u003Cp\u003E\u51B7\u7F1D\u5904\u7406\u91C7\u7528\u53CC\u5411\u78BE\u538B\u6CD5\uFF0C\u538B\u8DEF\u673A\u5148\u4ECE\u65B0\u644A\u94FA\u5C42\u4E0A\u9010\u6E10\u5411\u5DF2\u94FA\u5C42\u8FDB\u884C\u8DE8\u7F1D\u632F\u538B\uFF0C\u7136\u540E\u5728\u5DF2\u94FA\u5C42\u9010\u6E10\u79FB\u52A8\u8DE8\u7F1D\u9759\u538B\u4EE5\u6D88\u9664\u7F1D\u8FF9\u3002\u003C/p\u003E\n\u003Cp\u003E\n\u003Cstrong\u003E\u8054\u7CFB\u65B9\u5F0F\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003EEmail\uFF1A7jchengxianbing@7j.powerchina.cn\u003C/p\u003E\n\u003Cp\u003EWhatsApp/Tel: 013-8202781\u003C/p\u003E\n\u003Cp\u003EAddress: Jalan Selangan 47A, Sibu, Sarawak, Malaysia\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/nH0xJX7wOFoHqXmP7cxQKA\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
