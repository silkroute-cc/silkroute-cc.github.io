  "title": "\u201C\u8BD7\u753B\u9526\u7EE3 \u6F2B\u884C\u6C5F\u5357\u201D\u63A8\u4ECB\u4F1A\u5728\u5409\u9686\u5761\u6210\u529F\u4E3E\u529E",
  "summary": "2023\u5E7411\u67089\u65E5\uFF0C\u7531\u6D59\u6C5F\u7701\u6587\u5316\u548C\u65C5\u6E38\u5385\u4E3B\u529E\u3001\u8BD7\u753B\u6D59\u6C5F\u4E1C\u5357\u4E9A\u6D77\u5916\u63A8\u5E7F\u4E2D\u5FC3\u627F\u529E\u7684\u201C\u8BD7\u753B\u9526\u7EE3 \u6F2B\u884C\u6C5F\u5357\u201D\u6587\u65C5\u4EA4\u6D41\u63A8\u5E7F\u6D3B\u52A8\u5728\u9A6C\u6765\u897F\u4E9A\u9996\u90FD\u5409\u9686\u5761\u6210\u529F\u4E3E\u884C\uFF0C \u7ED9\u201C\u8BD7\u753B\u6C5F\u5357 \u6D3B\u529B\u6D59\u6C5F\u201D\u7684\u91D1\u540D\u7247\u518D\u6DFB\u4EAE\u8272 \u3002 \u4E3A\u5438\u5F15\u4E1C\u5357\u4E9A\u65C5\u5BA2\uFF0C\u672C\u6B21\u63A8\u4ECB\u6D3B\u52A8\u63A8\u51FA\u4E24\u6761\u201C\u8BD7\u753B\u6C5F\u5357 \u6D3B\u529B\u6D59\u6C5F\u201D\u4E3B\u9898\u65C5\u6E38\u8DEF\u7EBF\uFF0C\u9080\u8BF7\u4E1C\u5357\u4E9A\u6C11\u4F17\u884C\u65C5\u6D59\u6C5F\uFF0C\u611F\u53D7\u201C\u8BD7\u753B\u6C5F\u5357\u201D\u7684\u591A\u5F69\u9B45\u529B\u3002 \uFF08\u5DE6\u8D77\uFF1A\u4E01\u7EA2\u6C5F\u3001\u953A\u542F\u7AE0\u3001\u6768\u7F8E\u73E0\u3001\u9648\u79D1\u3001\u5305\u4E00\u96C4\u3001\u5F20\u6770\u946B\u3001\u674E\u4E2D\u5E73\u3001\u53F6\u5C0F\u5A9A\u3001\u738B\u598D\u6D47\u548C\u4FDE\u71D5\u4E00\u8D77\u4E3A\u6D59\u6C5F\u65C5\u6E38\u70B9\u8D5E\uFF09 \u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u4E3B\u4EFB\u5F20\u6770\u946B\u3001\u9A6C\u6765\u2026",
  "body": "\u003Cp\u003E2023\u5E7411\u67089\u65E5\uFF0C\u7531\u6D59\u6C5F\u7701\u6587\u5316\u548C\u65C5\u6E38\u5385\u4E3B\u529E\u3001\u8BD7\u753B\u6D59\u6C5F\u4E1C\u5357\u4E9A\u6D77\u5916\u63A8\u5E7F\u4E2D\u5FC3\u627F\u529E\u7684\u201C\u8BD7\u753B\u9526\u7EE3 \u6F2B\u884C\u6C5F\u5357\u201D\u6587\u65C5\u4EA4\u6D41\u63A8\u5E7F\u6D3B\u52A8\u5728\u9A6C\u6765\u897F\u4E9A\u9996\u90FD\u5409\u9686\u5761\u6210\u529F\u4E3E\u884C\uFF0C\u7ED9\u201C\u8BD7\u753B\u6C5F\u5357 \u6D3B\u529B\u6D59\u6C5F\u201D\u7684\u91D1\u540D\u7247\u518D\u6DFB\u4EAE\u8272\u3002\n\u003C/p\u003E\n\u003Cp\u003E\u4E3A\u5438\u5F15\u4E1C\u5357\u4E9A\u65C5\u5BA2\uFF0C\u672C\u6B21\u63A8\u4ECB\u6D3B\u52A8\u63A8\u51FA\u4E24\u6761\u201C\u8BD7\u753B\u6C5F\u5357 \u6D3B\u529B\u6D59\u6C5F\u201D\u4E3B\u9898\u65C5\u6E38\u8DEF\u7EBF\uFF0C\u9080\u8BF7\u4E1C\u5357\u4E9A\u6C11\u4F17\u884C\u65C5\u6D59\u6C5F\uFF0C\u611F\u53D7\u201C\u8BD7\u753B\u6C5F\u5357\u201D\u7684\u591A\u5F69\u9B45\u529B\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/11/frc-446ec7623293abe973b6af02798c7aaa.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cem\u003E\uFF08\u5DE6\u8D77\uFF1A\u4E01\u7EA2\u6C5F\u3001\u953A\u542F\u7AE0\u3001\u6768\u7F8E\u73E0\u3001\u9648\u79D1\u3001\u5305\u4E00\u96C4\u3001\u5F20\u6770\u946B\u3001\u674E\u4E2D\u5E73\u3001\u53F6\u5C0F\u5A9A\u3001\u738B\u598D\u6D47\u548C\u4FDE\u71D5\u4E00\u8D77\u4E3A\u6D59\u6C5F\u65C5\u6E38\u70B9\u8D5E\uFF09\u003C/em\u003E\u003C/p\u003E\n\u003Cp\u003E\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u4E3B\u4EFB\u5F20\u6770\u946B\u3001\u9A6C\u6765\u897F\u4E9A\u534E\u4EBA\u65C5\u6E38\u4E1A\u516C\u4F1A\u4F1A\u957F\u5305\u4E00\u96C4\u3001\u8BD7\u753B\u6D59\u6C5F\u4E1C\u5357\u4E9A\u63A8\u5E7F\u4E2D\u5FC3\u9996\u5E2D\u4EE3\u8868\u62FF\u7763\u674E\u4E2D\u5E73\u53CA\u6587\u65C5\u4F20\u5A92\u754C\u517160\u4F59\u4EBA\u53C2\u52A0\u4E86\u672C\u6B21\u63A8\u4ECB\u6D3B\u52A8\u3002\u003C/p\u003E\n\u003Cp\u003E\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u4E3B\u4EFB\u5F20\u6770\u946B\u81F4\u8F9E\u65F6\u8BF4\uFF0C\u6D59\u6C5F\u65E2\u662F\u4E2D\u56FD\u7684\u7ECF\u6D4E\u5927\u7701\u3001\u5F3A\u7701\uFF0C\u4E5F\u6709\u5176\u5F15\u4EE5\u4E3A\u50B2\u7684\u5386\u53F2\u6587\u5316\u3002\u4E2D\u56FD\u516D\u5927\u53E4\u90FD\u4E4B\u4E00\u7684\u676D\u5DDE\u4EE5\u98CE\u666F\u79C0\u4E3D\u8457\u79F0\uFF0C\u7D20\u6709\u201C\u4EBA\u95F4\u5929\u5802\u201D\u7684\u7F8E\u8A89\u3002\u826F\u6E1A\u53E4\u57CE\u9057\u5740\u88AB\u8A89\u4E3A\u201C\u4E2D\u534E\u7B2C\u4E00\u57CE\u201D\uFF0C\u662F\u5B9E\u8BC1\u4E2D\u534E\u4E94\u5343\u5E74\u6587\u660E\u53F2\u7684\u5723\u5730\u3002\u4ECA\u5E7410\u6708\uFF0C\u4E60\u8FD1\u5E73\u4E3B\u5E2D\u5728\u7B2C\u4E09\u5C4A\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u56FD\u9645\u5408\u4F5C\u9AD8\u5CF0\u8BBA\u575B\u5BA3\u5E03\uFF0C\u4E2D\u65B9\u5C06\u4E3E\u529E\u201C\u826F\u6E1A\u8BBA\u575B\u201D\uFF0C\u6DF1\u5316\u540C\u5171\u5EFA\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u56FD\u5BB6\u7684\u6587\u660E\u5BF9\u8BDD\u3002\u4ECA\u5E74\u4EE5\u6765\uFF0C\u9A6C\u6765\u897F\u4E9A\u9996\u76F8\u5B89\u534E\u4E24\u5EA6\u8BBF\u534E\uFF0C\u4E24\u56FD\u9886\u5BFC\u4EBA\u5B9E\u73B0\u591A\u6B21\u4E92\u8BBF\u3002\u76F8\u4FE1\u4E58\u7740\u4E2D\u9A6C\u5173\u7CFB\u5927\u8E0F\u6B65\u524D\u8FDB\u7684\u4E1C\u98CE\uFF0C\u4E24\u56FD\u4EBA\u5458\u4EA4\u5F80\u9010\u6E10\u9891\u7E41\u548C\u6DF1\u5165\uFF0C\u6D59\u6C5F\u548C\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38\u5408\u4F5C\u4E5F\u5C06\u9F50\u5934\u5E76\u8FDB\u3001\u6C34\u6DA8\u8239\u9AD8\uFF0C\u66F4\u4E0A\u4E00\u5C42\u697C\u3002\u003C/p\u003E\n\u003Cp\u003E\u63A8\u4ECB\u4F1A\u73B0\u573A\uFF0C\u4E5F\u6709\u6765\u81EA\u6D59\u6C5F\u7684\u77E5\u540D\u65C5\u884C\u5546\u6D59\u6C5F\u7701\u4E2D\u56FD\u65C5\u884C\u793E\u96C6\u56E2\u6709\u9650\u516C\u53F8\u3001\u4E2D\u56FD\u65C5\u6E38\u96C6\u56E2\u6E2F\u4E2D\u65C5\u56FD\u9645\uFF08\u676D\u5DDE\uFF09\u65C5\u884C\u793E\u6709\u9650\u516C\u53F8\u3001\u6D59\u6C5F\u7701\u4E2D\u9752\u56FD\u9645\u65C5\u6E38\u6709\u9650\u516C\u53F8\u548C\u676D\u5DDE\u8FDC\u666F\u56FD\u9645\u65C5\u884C\u793E\u6709\u9650\u516C\u53F8\u7B49\u4EE3\u8868\u4E0E\u9A6C\u6765\u897F\u4E9A\u65C5\u884C\u793E\u4EE3\u8868\u8FDB\u884C\u4E86\u9762\u5BF9\u9762\u78CB\u5546\u4EA4\u6D41\uFF0C\u4E3A\u5B9E\u73B0\u6D59\u9A6C\u4E24\u5730\u6587\u65C5\u5408\u4F5C\u8D44\u6E90\u5171\u4EAB\u3001\u4F18\u52BF\u4E92\u8865\u3001\u4E92\u5229\u5171\u8D62\u8FC8\u51FA\u4E86\u575A\u5B9E\u7684\u4E00\u6B65\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ECA\u5E74\uFF0C\u9002\u9022\u4E2D\u9A6C\u5EFA\u7ACB\u5168\u9762\u6218\u7565\u4F19\u4F34\u5173\u7CFB10\u5468\u5E74\u548C\u5171\u5EFA\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u5021\u8BAE\u63D0\u51FA10\u5468\u5E74\uFF0C\u662F\u6D59\u6C5F\u4E0E\u9A6C\u6765\u897F\u4E9A\u6DF1\u5165\u5F00\u5C55\u6587\u5316\u65C5\u6E38\u4EA4\u6D41\u7684\u91CD\u8981\u5951\u673A\u3002\u6B64\u6B21\u201C\u8BD7\u753B\u9526\u7EE3 \u6F2B\u884C\u6C5F\u5357\u201D\u7684\u4E1C\u5357\u4E9A\u4EAE\u76F8\uFF0C\u662F\u6D59\u9A6C\u4E24\u5730\u65C5\u884C\u5546\u5728\u540E\u75AB\u60C5\u65F6\u4EE3\u7684\u9996\u6B21\u6C9F\u901A\uFF0C\u65E8\u5728\u52A0\u6DF1\u9A6C\u6765\u897F\u4E9A\u4EBA\u6C11\u5BF9\u6D59\u6C5F\u7684\u8BA4\u8BC6\u548C\u4E86\u89E3\uFF0C\u589E\u8FDB\u4E24\u5730\u6587\u65C5\u4EA4\u6D41\u5408\u4F5C\u3002\u672A\u6765\uFF0C\u6D59\u6C5F\u5C06\u7EE7\u7EED\u52A0\u5F3A\u4E0E\u4E1C\u5357\u4E9A\u5730\u533A\u7684\u65C5\u6E38\u5408\u4F5C\uFF0C\u643A\u624B\u63A8\u8FDB\u4E24\u5730\u65C5\u6E38\u5E02\u573A\u7684\u7E41\u8363\u53D1\u5C55\u3002\u003C/p\u003E\n\u003Cp\u003E\u66F4\u591A\u7CBE\u5F69\uFF0C\u656C\u8BF7\u5173\u6CE8\uFF1A\u003C/p\u003E\n\u003Cp\u003E\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5B98\u7F51\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003Ehttps://www.chinaculturalcentre.my\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EFacebook\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u201CChina Cultural Centre in Kuala Lumpur\u201D\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u516C\u4F17\u53F7\uFF1A\u003C/strong\u003E\u003C/p\