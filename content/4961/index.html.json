{
  "id": "%e5%8d%a0%e5%9c%b0122%e8%8b%b1%e4%ba%a9%e8%80%97%e8%b5%843-2%e4%ba%bf%e3%80%80%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a-%e4%bd%9b%e5%b1%b1%e4%ba%a7%e4%b8%9a%e5%9b%ad%e6%8e%a8%e4%bb%8b",
  "slug": "%e5%8d%a0%e5%9c%b0122%e8%8b%b1%e4%ba%a9%e8%80%97%e8%b5%843-2%e4%ba%bf%e3%80%80%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a-%e4%bd%9b%e5%b1%b1%e4%ba%a7%e4%b8%9a%e5%9b%ad%e6%8e%a8%e4%bb%8b",
  "canonicalUrlKey": "%e5%8d%a0%e5%9c%b0122%e8%8b%b1%e4%ba%a9%e8%80%97%e8%b5%843-2%e4%ba%bf%e3%80%80%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a-%e4%bd%9b%e5%b1%b1%e4%ba%a7%e4%b8%9a%e5%9b%ad%e6%8e%a8%e4%bb%8b",
  "route": "/4961/",
  "title": "\u5360\u5730122\u82F1\u4EA9\u8017\u8D443.2\u4EBF\u3000\u201C\u9A6C\u6765\u897F\u4E9A-\u4F5B\u5C71\u4EA7\u4E1A\u56ED\u201D\u63A8\u4ECB\u52A8\u571F",
  "summary": "\u5F20\u8052\u7FD4\uFF08\u5DE64\uFF09\u8046\u542C\u53F6\u7ECD\u5168\uFF08\u5DE63\uFF09\u53CA\u4E01\u9521\u4E30\uFF08\u5DE65\uFF09\u4ECB\u7ECD\u201C\u9A6C\u6765\u897F\u4E9A-\u4F5B\u5C71\u4EA7\u4E1A\u56ED\u201D\u8BA1\u5212\u3002\u5DE6\u8D77\u4E3A\u9A6C\u65AF\u7C73\u8FEA\u4E9A\u4E07\u3001\u9648\u4E3D\u7FA4\u3001\u9648\u8000\u7136\u3001\u7EB3\u5C14\u6155\u4E01\u3001\u963F\u9C81\u53E4\u739B\u3001\u9EC4\u5723\u680B\u53CA\u5434\u91D1\u8D22\u3002 \uFF08\u8299\u84C911\u65E5\u8BAF\uFF09\u7531\u4F76\u5E1D\u96C6\u56E2\u5F00\u53D1\u5360\u5730122\u82F1\u4EA9\uFF0C\u8BBE\u7ACB\u5728\u68EE\u5DDE\u5C0F\u7518\u5BC6\u7684\u201C\u9A6C\u6765\u897F\u4E9A-\u4F5B\u5C71\u4EA7\u4E1A\u56ED\u201D\uFF08SIP\uFF09\u4ECA\u65E5\u6B63\u5F0F\u63A8\u4ECB\u53CA\u5C55\u5F00\u7B2C\u4E00\u9636\u6BB5\u5DE5\u7A0B\u52A8\u571F\u793C\uFF0C\u6599\u5C06\u4E3A\u68EE\u5DDE\u5E26\u6765\u91CD\u5927\u7ECF\u6D4E\u5229\u76CA\u7684\u6218\u7565\u4E3E\u63AA\u3002 \u8BE5\u9879\u8BA1\u5212\u5408\u4F5C\u4F19\u4F34\u4E3A\u9A6C\u6765\u897F\u4E9A\u2013\u4F5B\u5C71\u603B\u5546\u4F1A\uFF1B\u53D1\u5C55\u8BA1\u5212\u603B\u8017\u8D443\u4EBF2000\u4E07\u4EE4\u5409\u3002 \u4F76\u5E1D\u6267\u884C\u526F\u4E3B\u5E2D\u62FF\u7763\u9EC4\u5723\u680B\u4ECA\u65E9\u5728\u201C\u9A6C\u6765\u897F\u4E9A-\u4F5B\u5C71\u4EA7\u4E1A\u56ED\u201D\u5960\u57FA\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/07/frc-54b32e0f52853ab5c99253aae5f5b2a6.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5F20\u8052\u7FD4\uFF08\u5DE64\uFF09\u8046\u542C\u53F6\u7ECD\u5168\uFF08\u5DE63\uFF09\u53CA\u4E01\u9521\u4E30\uFF08\u5DE65\uFF09\u4ECB\u7ECD\u201C\u9A6C\u6765\u897F\u4E9A-\u4F5B\u5C71\u4EA7\u4E1A\u56ED\u201D\u8BA1\u5212\u3002\u5DE6\u8D77\u4E3A\u9A6C\u65AF\u7C73\u8FEA\u4E9A\u4E07\u3001\u9648\u4E3D\u7FA4\u3001\u9648\u8000\u7136\u3001\u7EB3\u5C14\u6155\u4E01\u3001\u963F\u9C81\u53E4\u739B\u3001\u9EC4\u5723\u680B\u53CA\u5434\u91D1\u8D22\u3002\u003C/p\u003E\n\u003Cp\u003E\uFF08\u8299\u84C911\u65E5\u8BAF\uFF09\u7531\u4F76\u5E1D\u96C6\u56E2\u5F00\u53D1\u5360\u5730122\u82F1\u4EA9\uFF0C\u8BBE\u7ACB\u5728\u68EE\u5DDE\u5C0F\u7518\u5BC6\u7684\u201C\u9A6C\u6765\u897F\u4E9A-\u4F5B\u5C71\u4EA7\u4E1A\u56ED\u201D\uFF08SIP\uFF09\u4ECA\u65E5\u6B63\u5F0F\u63A8\u4ECB\u53CA\u5C55\u5F00\u7B2C\u4E00\u9636\u6BB5\u5DE5\u7A0B\u52A8\u571F\u793C\uFF0C\u6599\u5C06\u4E3A\u68EE\u5DDE\u5E26\u6765\u91CD\u5927\u7ECF\u6D4E\u5229\u76CA\u7684\u6218\u7565\u4E3E\u63AA\u3002\u003C/p\u003E\n\u003Cp\u003E\u8BE5\u9879\u8BA1\u5212\u5408\u4F5C\u4F19\u4F34\u4E3A\u9A6C\u6765\u897F\u4E9A\u2013\u4F5B\u5C71\u603B\u5546\u4F1A\uFF1B\u53D1\u5C55\u8BA1\u5212\u603B\u8017\u8D443\u4EBF2000\u4E07\u4EE4\u5409\u3002\u003C/p\u003E\n\u003Cp\u003E\u4F76\u5E1D\u6267\u884C\u526F\u4E3B\u5E2D\u62FF\u7763\u9EC4\u5723\u680B\u4ECA\u65E9\u5728\u201C\u9A6C\u6765\u897F\u4E9A-\u4F5B\u5C71\u4EA7\u4E1A\u56ED\u201D\u5960\u57FA\u4EEA\u5F0F\u4E0A\u81F4\u8BCD\u65F6\u8868\u793A\uFF0C\u8FD9\u9879\u53D1\u5C55\u8BA1\u5212\u662F\u4F76\u5E1D\u96C6\u56E2\u548C\u68EE\u5DDE\u5C0F\u7518\u5BC6\u793E\u533A\u7684\u91CD\u8981\u91CC\u7A0B\u7891\uFF0C\u8FD9\u6807\u5FD7\u8457\u4E00\u4E2A\u62E5\u62B1\u521B\u65B0\u3001\u53EF\u6301\u7EED\u53D1 \u5C55\u548C\u7ECF\u6D4E\u589E\u957F\u7684\u613F\u666F\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u9A6C\u4F5B\u4EA7\u4E1A\u56ED\u5360\u5730122\u82F1\u4EA9\uFF0C\u5F00\u53D1\u9879\u76EE\u5305\u62EC40\u4E2A\u5546\u4E1A\u5E97\u94FA\u5355\u4F4D\uFF0C\u540C\u65F6\uFF0C\u4E5F\u4F1A\u5EFA\u8BBE20\u4E2A\u534A\u72EC\u7ACB\u5DE5\u5382\u5355\u4F4D\uFF0C\u5EFA\u7B51\u9762\u79EF\u4E3A\u4E00\u4E07\u5E73\u65B9\u82F1\u5C3A\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u5382\u623F\u533A\u57DF\u62E5\u670940\u82F1\u5C3A\u7684\u5929\u82B1\u677F\u9AD8\u5EA6\uFF0C\u5E76\u914D\u6709\u4E09\u5C42\u529E\u516C\u7A7A\u95F4\u3002\u8FD9\u4E9B\u534A\u72EC\u7ACB\u5DE5\u5382\u975E\u5E38\u9002\u5408\u5BFB\u6C42\u5229\u7528\u8F7B\u578B\u8BBE\u5907\u6216\u4ED3\u50A8\u8BBE\u65BD\u5FEB\u901F\u5EFA\u7ACB\u8FD0\u8425\u7684\u4E2D\u5C0F\u4F01\u4E1A\u3002\u5BF9\u4E8E\u9700\u8981\u66F4\u591A\u7A7A\u95F4\u7684\u4F01\u4E1A\uFF0C\u53EF\u4EE5\u5C06\u5355\u4F4D\u7EC4\u5408\u6210\u66F4\u5927\u7684\u914D\u7F6E\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u4E5F\u62AB\u9732\uFF0C\u4EA7\u4E1A\u56ED\u8FD8\u63D0\u4F9B\u5DE5\u4E1A\u7528\u5730\uFF0C\u4E13\u4E3A\u9700\u8981\u5BA2\u5236\u5316\u5927\u578B\u5DE5\u5382\u7684\u5236\u9020\u5546\u800C\u8BBE\u8BA1\u3002\u8FD9\u4E9B\u5730\u6BB5\u914D\u5907\u4E86\u57FA\u672C\u8BBE\u65BD\u5982\u6C34\u4F9B\u3001\u7535\u529B\u548C\u9053\u8DEF\u901A\u8FBE\u571F\u5730\u5E73\u6574\u9002\u5408\u5373\u65F6\u65BD\u5DE5\u3002\u5C55\u671B\u672A\u6765\uFF0C\u5F00\u53D1\u7684\u7B2C\u4E8C\u9636\u6BB5\u5C06\u5305\u62EC\u52B3\u5DE5\u96C6\u4E2D\u5BBF\u820D\uFF08CLQ\uFF09\u8BA1\u5212\uFF0C\u663E\u793A\u4E86\u6211\u4EEC\u5728\u4FC3\u8FDB\u5168\u9762\u5DE5\u4E1A\u57FA\u7840\u8BBE\u65BD\u65B9\u9762\u7684\u627F\u8BFA\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u4E01\u9521\u4E30\uFF1A2023\u5E74\u4F5B\u5C71\u5927\u9A6C\u8FDB\u51FA\u53E3\u603B\u989D\u8FBE414\u4EBF\u4EBA\u6C11\u5E01\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u4F5B\u5C71\u5E02\u59D4\u5E38\u59D4\u4E01\u9521\u4E30\u81F4\u8BCD\u65F6\u8868\u793A\uFF0C\u57282023\u5E74\uFF0C\u4F5B\u5C71\u4E0E\u5927\u9A6C\u8FDB\u51FA\u53E3\u603B\u989D\u8FBE414\u4EBF\u4EBA\u6C11\u5E01\uFF0C\u589E\u957F12.4%\u3002\u4F5B\u5C71\u4E0E\u5927\u9A6C\u7684\u7ECF\u8D38\u5173\u7CFB\u6E90\u8FDC\u6D41\u957F\u3001\u4E92\u4FE1\u4E92\u5229\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u4F5B\u5C71\u5E02\u4F5C\u4E3A\u4E2D\u56FD\u5236\u9020\u4E1A\u7684\u91CD\u8981\u57FA\u5730\uFF0C\u4E00\u76F4\u4EE5\u6765\u81F4\u529B\u4E8E\u63A8\u52A8\u9AD8\u8D28\u91CF\u53D1\u5C55\uFF0C\u79EF\u6781\u54CD\u5E94\u56FD\u5BB6\u201C\u8D70\u51FA\u53BB\u201D\u6218\u7565\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6307\u51FA\uFF0C\u4ED6\u4EEC\u62E5\u6709\u201C\u4F5B\u5C71\u4F01\u4E1A\u4E09\u6B65\u8D70\u201D\u7684\u5927\u65B9\u5411\uFF0C\u800C\u201C\u8D70\u51FA\u53BB\u201D\u662F\u8FD9\u6B21\u8003\u5BDF\u7684\u4E3B\u8F74\uFF0C\u4EE5\u9009\u62E9\u6700\u7B56\u7565\u6027\u7684\u5730\u70B9\uFF0C\u505A\u4E3A\u4E2D\u56FD\u4F01\u4E1A\u5728\u5916\u843D\u811A\u7684\u533A\u57DF\u603B\u90E8\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E01\u9521\u4E30\u62AB\u9732\uFF0C\u8FD9\u4E2A\u4EA7\u4E1A\u56ED\u4E0D\u4EC5\u662F\u4F5B\u5C71\u4F01\u4E1A\u201C\u8D70\u51FA\u53BB\u201D\u7684\u91CD\u8981\u8F7D\u4F53\uFF0C\u66F4\u627F\u8F7D\u8457\u63A8\u52A8\u4E24\u5730\u7ECF\u8D38\u5408\u4F5C\u3001\u4FC3\u8FDB\u53CC\u65B9\u4F01\u4E1A\u53D1\u5C55\u7684\u91CD\u8981\u4F7F\u547D\uFF0C\u901A\u8FC7\u5404\u9886\u57DF\u6DF1\u5EA6\u5408\u4F5C\uFF0C\u63A8\u52A8\u53CC\u65B9\u4EA7\u4E1A\u94FE\u7684\u6DF1\u5EA6\u878D\u5408\uFF0C\u5B9E\u73B0\u4E92\u5229\u5171\u8D62\u3002\u003C/p\u003E\n\u003Cp\u003E\u51FA\u5E2D\u8005\u5305\u62EC\u4EE3\u8868\u4E0D\u514B\u51FA\u5E2D\u7684\u68EE\u5DDE\u52A1\u5927\u81E3\u62FF\u7763\u65AF\u91CC\u963F\u7C73\u52AA\u4E01\u4E3B\u6301\u4EEA\u5F0F\u7684\u638C\u7BA1\u5DE5\u4E1A\u548C\u975E\u4F0A\u65AF\u5170\u4E8B\u52A1\u7684\u68EE\u5DDE\u884C\u653F\u8BAE\u5458\u5F20\u8052\u7FD4\u3001\u68EE\u5DDE\u884C\u653F\u8BAE\u5458\u963F\u9C81\u53E4\u739B\u3001\u68EE\u5DDE\u884C\u653F\u8BAE\u5458\u9648\u4E3D\u7FA4\u3001\u6C89\u9999\u5DDE\u8BAE\u5458\u5434\u91D1\u8D22\u3001\u9A6C\u6765\u897F\u4E9A\u4F5B\u5C71\u603B\u5546\u4F1A\u603B\u4F1A\u957F\u517C\u4F76\u5E1D\u96C6\u56E2\u6267\u884C\u4E3B\u5E2D\u62FF\u7763\u65AF\u91CC\u53F6\u7ECD\u5168\u3001\u68EE\u5DDE\u4E2D\u534E\u603B\u5546\u4F1A\u4F1A\u957F\u62FF\u7763\u5415\u6D77\u5EAD\u3001\u68EE\u5DDE\u6295\u8D44\u673A\u6784\uFF08Invest NS\uFF09\u603B\u6267\u884C\u957F\u62FF\u7763\u7EB3\u5C14\u6155\u4E01\u3001\u8299\u84C9\u5E02\u653F\u5385\u79D8\u4E66\u9A6C\u65AF\u7C73\u8FEA\u4E9A\u4E07\u3001\u300A\u4E1C\u65B9\u65E5\u62A5\u300B\u6267\u884C\u8463\u4E8B\u517C\u5A92\u4F53\u987E\u95EE\u9648\u5229\u826F\u3001\u4F5B\u5C71\u5E02\u8FDB\u51FA\u53E3\u5546\u4F1A\u8363\u8A89\u4F1A\u957F\u9648\u8000\u7136\u53CA50\u540D\u4E2D\u5C0F\u4F01\u4E1A\u5BB6\u548C\u8DE8\u56FD\u516C\u53F8\u4EE3\u8868\u7EC4\u6210\u7684\u8BBF\u95EE\u56E2\u7B49\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/ztL-nrfrnUOIqItzDqLUcQ\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
