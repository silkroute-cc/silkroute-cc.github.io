{
  "id": "\u4E0D\u7528\u5F00\u8F66\u642Dlrt3\u7545\u6E38\u5DF4\u751F\u8001\u57CE\u8DEF\u7EBF",
  "slug": "\u4E0D\u7528\u5F00\u8F66\u642Dlrt3\u7545\u6E38\u5DF4\u751F\u8001\u57CE\u8DEF\u7EBF",
  "canonicalUrlKey": "\u4E0D\u7528\u5F00\u8F66\u642Dlrt3\u7545\u6E38\u5DF4\u751F\u8001\u57CE\u8DEF\u7EBF",
  "route": "/6145/",
  "title": "\u4E0D\u7528\u5F00\u8F66\uFF01\u642DLRT3\u7545\u6E38\uD83C\uDDF2\uD83C\uDDFE\u5DF4\u751F\u8001\u57CE\u8DEF\u7EBF\uD83D\uDDFA\uFE0F",
  "summary": "\u672C\u6587\u4E3A\u96EA\u5170\u83AA\u65C5\u6E38\u5C40\u53D1\u5E03\u7684\u56FE\u96C6\u5F0F\u653B\u7565\uFF0C\u4E3B\u9898\u662F\u4E0D\u5F00\u8F66\u3001\u642D\u4E58LRT3\u8F7B\u5FEB\u94C1\u7545\u6E38\u9A6C\u6765\u897F\u4E9A\u5DF4\u751F\u8001\u57CE\u7684\u4E00\u65E5\u6E38\u8DEF\u7EBF\u3002\u884C\u7A0B\u4ECE\u4E0A\u53488\u65F6\u5728\u4E2D\u56FD\u9152\u5E97\u8336\u9910\u5385\u5403\u5357\u6D0B\u98CE\u5473\u65E9\u9910\u5F00\u59CB\uFF0C9\u65F6\u5230\u54E5\u6253\u6865\u62CD\u7167\u6253\u5361\uFF0C10\u65F6\u8D70\u8FDBPlay Klang Caf\u00E9\u4E0E\u5DF4\u751F\u6545\u4E8B\u9986\u4E86\u89E3\u5DF4\u751F\u5386\u53F2\uFF0C11\u65F6\u6CBF\u767E\u5E74\u53E4\u8FF9Citywalk\u9014\u7ECF\u9732\u5FB7\u5723\u6BCD\u5929\u4E3B\u6559\u5802\u3001\u54E5\u6253\u62C9\u60F9\u6D88\u9632\u5C40\u4E0E\u82CF\u4E39\u963F\u90FD\u963F\u5179\u7687\u5BB6\u5C55\u89C8\u9986\uFF1B\u4E2D\u5348\u5728\u5427\u751F\u76DB\u53D1\uFF08\u6865\u5E95\uFF09\u8089\u9AA8\u8336\u7528\u9910\uFF0C\u4E0B\u5348\u63A2\u7D22\u5C0F\u5370\u5EA6\u4E0E\u8001\u8857\u58C1\u753B\u3001\u5230\u9526\u76DB\u86CB\u7CD5\u5C4B\u4E70\u624B\u4FE1\uFF0C\u508D\u665A\u5728\u4F38\u6CE2\u58EB\u987F\u9910\u5BA4\u5403\u5566\u5566\uFF0C\u665A\u4E0A\u5230\u5DF4\u751F\u7687\u5BB6\u57CE\u6E05\u771F\u5BFA\u770B\u591C\u666F\uFF0C\u6700\u540E\u642D\u8F7B\u5FEB\u94C1\u8FD4\u7A0B\u3002",
  "body": "\u003Cp\u003E\u4E0D\u7528\u5F00\u8F66\u4E5F\u80FD\u73A9\u0026#127474;\u0026#127486;\u9A6C\u6765\u897F\u4E9A\u5DF4\u751F\uFF01LRT 3 \u901A\u8F66\u540E\uFF0C\u642D\u4E58\u8F7B\u5FEB\u94C1\u5C31\u80FD\u8F7B\u677E\u62B5\u8FBE\u5DF4\u751F\u0026#128646;\u003C/p\u003E\n\u003Cp\u003E\u4ECE\u5357\u6D0B\u98CE\u5473\u65E9\u9910\u3001\u767E\u5E74\u53E4\u8FF9\u5230\u5728\u5730\u7F8E\u98DF\uFF0C\u4E00\u5929\u5E26\u4F60\u5403\u559D\u73A9\u4E50\u3001\u6253\u5361\u8001\u57CE\u9B45\u529B\u2728\u003C/p\u003E\n\u003Cp\u003E\u0026#128317;\u8FD9\u4EFD\u5DF4\u751F\u4E00\u65E5\u6E38\u653B\u7565\u5148\u2B50\uFE0F\uFF0C\u8DDF\u7740\u8DEF\u7EBF\u51FA\u53D1\u5C31\u5BF9\u4E86\uFF01\u003C/p\u003E\n\u003Cp\u003E\u0026#128205;8AM\uFF5C\u4E2D\u56FD\u9152\u5E97\u8336\u9910\u5385 \u5403\u65E9\u9910\u2615\uFE0F\u003C/p\u003E\n\u003Cp\u003E\u642D\u4E58\u8F7B\u5FEB\u94C1\u62B5\u8FBE Pasar Klang \u7AD9\u540E\u0026#128694;\u003C/p\u003E\n\u003Cp\u003E\u6B65\u884C\u524D\u5F80\u4E2D\u56FD\u9152\u5E97\uFF0C\u5403\u5357\u6D0B\u98CE\u5473\u65E9\u9910\uFF01\u003C/p\u003E\n\u003Cp\u003E\u0026#127838;\u70AD\u70E4\u9762\u5305\u3001\u534A\u751F\u719F\u86CB\u914D\u4E0A\u4E00\u676F\u9999\u6D53\u5357\u6D0B\u5496\u5561\uFF0C\u518D\u5916\u5E26\u4E00\u4EFD\u6930\u6D46\u996D\uFF0C\u6EE1\u6EE1\u5DF4\u751F\u5728\u5730\u65E9\u9910\u70DF\u706B\u6C14\uFF01\u003C/p\u003E\n\u003Cp\u003E\u0026#128205;9AM\uFF5C\u54E5\u6253\u6865 \u62CD\u7167\u6253\u5361\u003C/p\u003E\n\u003Cp\u003E\u5403\u9971\u559D\u8DB3\u540E\uFF0C\u7EE7\u7EED\u767B\u4E0A\u8F7B\u5FEB\u94C1\u524D\u5F80 Jambatan Kota \u7AD9\uFF0C\u003C/p\u003E\n\u003Cp\u003E\u8D70\u4E0A\u54E5\u6253\u6865\uFF08Kota Bridge\uFF09\u4E0B\u5C42\u6B65\u884C\u9053\uFF0C\u6B23\u8D4F\u5DF4\u751F\u6CB3\u666F\u0026#129331;\u987A\u4FBF\u62CD\u4E0B\u6865\u4E0A\u7684\u827A\u672F\u58C1\u753B\uFF5E\u003C/p\u003E\n\u003Cp\u003E\u0026#128205;10AM\uFF5CPlay Klang Caf\u0026#233; \u8BA4\u8BC6\u5DF4\u751F\u6545\u4E8B\u003C/p\u003E\n\u003Cp\u003E\u8D70\u8FDB\u5DF4\u751F\u6545\u4E8B\u9986\uFF0C\u901A\u8FC7\u624B\u7ED8\u56FE\u672C\u3001\u58F0\u6548\u4E0E\u88C5\u7F6E\u4E86\u89E3\u5DF4\u751F\u5386\u53F2\uFF0C\u003C/p\u003E\n\u003Cp\u003E\u8FD8\u80FD\u9886\u53D6\u5DF4\u751F\u65C5\u6E38\u624B\u7ED8\u5730\u56FE\uFF0C\u4E3A\u63A5\u4E0B\u6765\u7684 Citywalk \u505A\u51C6\u5907\uFF01\u0026#128506;\uFE0F\u003C/p\u003E\n\u003Cp\u003E\u0026#128205;11AM\uFF5C\u767E\u5E74\u53E4\u8FF9 Citywalk\u003C/p\u003E\n\u003Cp\u003E\u6CBF\u9014\u6253\u5361\u4E09\u5927\u5386\u53F2\u5EFA\u7B51\uFF1A\u003C/p\u003E\n\u003Cp\u003E\u2728\u5DF4\u751F\u9732\u5FB7\u5723\u6BCD\u5929\u4E3B\u6559\u5802\uFF1A\u5DF4\u751F\u767E\u5E74\u54E5\u7279\u5F0F\u6559\u5802\uFF0C\u5F69\u8272\u73BB\u7483\u4E0E\u5C16\u62F1\u6572\u597D\u62CD\u003C/p\u003E\n\u003Cp\u003E\u2728\u5DF4\u751F\u54E5\u6253\u62C9\u60F9\u6D88\u9632\u5C40\uFF1A\u6B23\u8D4F\u82F1\u6B96\u6C11\u98CE\u683C\u5EFA\u7B51\u4E0E\u8001\u6D88\u9632\u6587\u7269\u003C/p\u003E\n\u003Cp\u003E\u2728\u82CF\u4E39\u963F\u90FD\u963F\u5179\u7687\u5BB6\u5C55\u89C8\u9986\uFF1A\u8D70\u8FDB\u96EA\u5DDE\u7687\u5BA4\u5386\u53F2\uFF0C\u6B23\u8D4F\u73CD\u8D35\u6536\u85CF\u003C/p\u003E\n\u003Cp\u003E\u0026#128205;1PM\uFF5C\u5427\u751F\u76DB\u53D1\uFF08\u6865\u5E95\uFF09\u8089\u9AA8\u8336 \u5348\u9910\u0026amp;nbsp;\u003C/p\u003E\n\u003Cp\u003E\u5230\u5DF4\u751F\u4EBA\u6C14\u8001\u5B57\u53F7\u8089\u9AA8\u8336\uFF0C\u54C1\u5C1D\u7ECF\u5178\u5DF4\u751F\u8089\u9AA8\u8336\u7684\u6D53\u90C1\u6C64\u5934\u0026#127858;\u003C/p\u003E\n\u003Cp\u003E\u0026#128205;2PM\uFF5C\u5C0F\u5370\u5EA6\u002B\u8001\u8857\u63A2\u7D22\u003C/p\u003E\n\u003Cp\u003E\u6F2B\u6B65 Little India\uFF0C\u611F\u53D7\u70ED\u95F9\u7684\u8857\u5934\u6C1B\u56F4\uFF5E\u003C/p\u003E\n\u003Cp\u003E\u518D\u5230\u52A8\u7269\u58C1\u753B\u8857\u62CD\u7167\uFF1B\u855E\u540E\u901B\u901B\u6F6E\u4E61\u6545\u4E8B\u9986\uFF0C\u4E86\u89E3\u65E9\u5E74\u6F6E\u5DDE\u4EBA\u5357\u4E0B\u5DF4\u751F\u7684\u6545\u4E8B\u0026#128269;\u003C/p\u003E\n\u003Cp\u003E\u0026#128205;4PM\uFF5C\u9526\u76DB\u86CB\u7CD5\u5C4B \u4E70\u624B\u4FE1\u003C/p\u003E\n\u003Cp\u003E\u6765\u5230\u8001\u5B57\u53F7\u300C\u9526\u76DB\u86CB\u7CD5\u5C4B\u300D\u522B\u9519\u8FC7\u62DB\u724C\u73ED\u5170\u5C42\u7CD5\uFF01\u003C/p\u003E\n\u003Cp\u003E\u73ED\u5170\u6E05\u9999\u4E0E\u6930\u9999\u4EA4\u7EC7\uFF0C\u4E70\u51E0\u76D2\u5E26\u56DE\u5BB6\u5206\u4EAB\u4E5F\u4E0D\u9519\uFF5E\u003C/p\u003E\n\u003Cp\u003E\u0026#128205;5PM\uFF5C\u4F38\u6CE2\u58EB\u987F\u9910\u5BA4 \u5403\u5566\u5566\uFF08\u86E4\u870A\uFF09\u003C/p\u003E\n\u003Cp\u003E\u5468\u672B\u4EBA\u6C14\u65FA\u4EBA\uFF0C\u8BB0\u5F97\u63D0\u65E9\u5230\u573A\u6392\u961F\uFF01\u003C/p\u003E\n\u003Cp\u003E\u9C9C\u751C\u591F\u5473\u7684\u4E0A\u6C64\u84B8\u5566\u5566\u3001\u9999\u6C14\u5341\u8DB3\u7684\u9EA6\u7247\u7092\u85AF\u7C89\uFF0C\u90FD\u503C\u5F97\u4E00\u8BD5\u0026#128523;\u003C/p\u003E\n\u003Cp\u003E\u0026#128205;7PM\uFF5C\u5DF4\u751F\u7687\u5BB6\u57CE\u6E05\u771F\u5BFA \u770B\u591C\u666F\u0026amp;nbsp;\u003C/p\u003E\n\u003Cp\u003E\u6765\u5230\u5DF4\u751F\u6CB3\u7554\u7684 Masjid Bandar Diraja Klang\uFF0C\u6B23\u8D4F\u6E05\u771F\u5BFA\u5EFA\u7B51\u4E0E\u6CB3\u7554\u666F\u8272\u0026#127747;\u003C/p\u003E\n\u003Cp\u003E\u0026#128205;8PM\uFF5C\u642D\u4E58\u5730\u94C1\u56DE\u5BB6\u003C/p\u003E\n\u003Cp\u003E\u4ECE Jambatan Kota \u7AD9\u642D\u4E58\u5730\u94C1\u56DE\u7A0B\uFF0C\u7ED3\u675F\u4E00\u5929\u7684\u5DF4\u751F\u7F8E\u98DF\u6587\u5316\u4E4B\u65C5\uFF01\u003C/p\u003E\n\u003Cp\u003E#\u9B45\u529B\u96EA\u5170\u83AA   #\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38   #\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38\u653B\u7565   #VisitSelangor2026   #\u96EA\u5170\u83AA\u60CA\u559C\u8FDE\u8FDE   #\u96EA\u5170\u83AA\u65C5\u6E38   #\u96EA\u5170\u83AA\u65C5\u6E38\u653B\u7565   #\u5DF4\u751F\u65C5\u6E38\u653B\u7565   #LRT3\u5DF4\u751F\u4E00\u65E5\u6E38   #\u5DF4\u751F\u8089\u9AA8\u8336\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/sz_mmbiz_jpg/p7Ria9Mp2k3o4LWicoIa8d85hezibfE6GITqMl0z9pa1KzspkNlV70X9AaQPpg1kzrxvTmsg4mdAKyY5Nibd7XSia4X1mo55uuENYhpaxJCC6t9g/0?wx_fmt=jpeg\u0026amp;fro