{
  "id": "\u9886\u4E8B\u63D0\u9192\u6C99\u5DF4\u7EB3\u5BBE\u65C5\u6E38\u4E5D\u9879\u6CE8\u610F",
  "slug": "\u9886\u4E8B\u63D0\u9192\u6C99\u5DF4\u7EB3\u5BBE\u65C5\u6E38\u4E5D\u9879\u6CE8\u610F",
  "canonicalUrlKey": "\u9886\u4E8B\u63D0\u9192\u6C99\u5DF4\u7EB3\u5BBE\u65C5\u6E38\u4E5D\u9879\u6CE8\u610F",
  "route": "/6129/",
  "title": "\u9886\u4E8B\u63D0\u9192\uFF1A\u6C99\u5DF4\u3001\u7EB3\u5BBE\u65C5\u6E38\u201C\u4E5D\u9879\u6CE8\u610F\u201D",
  "summary": "\u4E2D\u56FD\u9A7B\u54E5\u6253\u57FA\u7EB3\u5DF4\u5362\u603B\u9886\u9986\u53D1\u5E03\u9886\u4E8B\u63D0\u9192\uFF0C\u8D74\u9A6C\u6765\u897F\u4E9A\u6C99\u5DF4\u5DDE\u53CA\u7EB3\u5BBE\u65C5\u6E38\u7684\u65C5\u5BA2\u9700\u5173\u6CE8\u4E5D\u9879\u4E8B\u9879\u3002\u62B5\u8FBE\u9996\u4E2A\u5165\u5883\u673A\u573A\u5E94\u529E\u59A5\u5165\u5883\u624B\u7EED\u5E76\u52A0\u76D6\u5165\u5883\u7AE0\uFF0C\u53D1\u73B0\u6F0F\u7AE0\u987B\u7B2C\u4E00\u65F6\u95F4\u524D\u5F80\u6C99\u5DF4\u5DDE\u79FB\u6C11\u5C40\u8865\u529E\u3002\u51FA\u884C\u5E94\u9009\u62E9\u5408\u6CD5\u5408\u89C4\u7684\u9152\u5E97\u4E0E\u65C5\u884C\u793E\uFF0C\u5728\u4EBA\u5458\u5BC6\u96C6\u573A\u6240\u59A5\u5584\u4FDD\u7BA1\u62A4\u7167\u8D22\u7269\u3002\u5F53\u5730\u4E3A\u53F3\u8235\u5DE6\u884C\u4E14\u8F66\u901F\u8F83\u5FEB\uFF0C\u8FC7\u9A6C\u8DEF\u52A1\u5FC5\u5BDF\u770B\u8DEF\u51B5\uFF1B\u73B0\u91D1\u3001\u9996\u9970\u7B49\u8D35\u91CD\u7269\u54C1\u8BF7\u968F\u8EAB\u643A\u5E26\u5207\u52FF\u6258\u8FD0\u3002\u4E25\u683C\u9075\u5B88\u6D77\u5173\u5173\u4E8E\u8FDD\u7981\u54C1\u4E0E\u73B0\u91D1\u7684\u7533\u62A5\u89C4\u5B9A\uFF1B\u53C2\u4E0E\u6469\u6258\u8247\u3001\u6D6E\u6F5C\u7B49\u6D89\u6C34\u9879\u76EE\u987B\u91CF\u529B\u800C\u884C\u3002\u524D\u5F80\u6D77\u5C9B\u3001\u5C71\u533A\u7B49\u4FE1\u53F7\u8584\u5F31\u533A\u57DF\u524D\uFF0C\u5E94\u5C06\u884C\u7A0B\u544A\u77E5\u56FD\u5185\u4EB2\u53CB\u3002\u6587\u672B\u9644\u5F53\u5730\u62A5\u8B66\u7535\u8BDD\u3001\u65C5\u6E38\u5C40\u6295\u8BC9\u6E20\u9053\u53CA\u9886\u4FDD\u70ED\u7EBF\u3002",
  "body": "\u003Cimg src=\u0022/assets/uploads/26bff0c56e8eaef2f7d73a7ac8e815c44e5a23f8e8eca9dd9737646cf4302960.jpg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u4E00\u3001\u62B5\u8FBE\u9996\u7AD9\u5FC5\u76D6\u7AE0\uFF1A\u65E0\u8BBA\u76F4\u98DE\u8FD8\u662F\u4E2D\u8F6C\uFF0C\u52A1\u5FC5\u5728\u62B5\u8FBE\u6C99\u5DF4\u7684\u9996\u4E2A\u673A\u573A\u529E\u59A5\u5165\u5883\u624B\u7EED\u5E76\u52A0\u76D6\u5165\u5883\u7AE0\uFF0C\u5426\u5219\u5C06\u9762\u4E34\u5904\u7F5A\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E8C\u3001\u79BB\u5883\u524D\u6838\u5BF9\u5370\u7AE0\uFF1A\u5982\u53D1\u73B0\u5165\u5883\u65F6\u6F0F\u76D6\u7AE0\uFF0C\u8BF7\u7B2C\u4E00\u65F6\u95F4\u524D\u5F80\u6C99\u5DF4\u5DDE\u79FB\u6C11\u5C40\u8865\u529E\uFF0C\u5207\u52FF\u5FC3\u5B58\u4FA5\u5E78\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E09\u3001\u7504\u522B\u5408\u89C4\u8D44\u8D28\uFF1A\u52A1\u5FC5\u9009\u62E9\u5408\u6CD5\u5408\u89C4\u3001\u5177\u5907\u826F\u597D\u5B89\u5168\u4FDD\u969C\u7684\u9152\u5E97\u3001\u5EA6\u5047\u6751\u53CA\u65C5\u884C\u793E\u3002\u003C/p\u003E\n\u003Cp\u003E\u56DB\u3001\u59A5\u5584\u4FDD\u7BA1\u62A4\u7167\uFF1A\u5728\u4EBA\u5458\u5BC6\u96C6\u573A\u6240\u63D0\u9AD8\u8B66\u60D5\uFF0C\u770B\u7BA1\u597D\u968F\u8EAB\u8D22\u7269\u8BC1\u4EF6\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E94\u3001\u9002\u5E94\u53F3\u8235\u5DE6\u884C\uFF1A\u5F53\u5730\u4EA4\u901A\u4E3A\u53F3\u8235\u5DE6\u884C\u4E14\u8F66\u901F\u8F83\u5FEB\u3001\u4EBA\u884C\u9053\u8F83\u5C11\uFF0C\u8FC7\u9A6C\u8DEF\u65F6\u52A1\u5FC5\u5BDF\u770B\u8DEF\u51B5\u3001\u6CE8\u610F\u5B89\u5168\u3002\u003C/p\u003E\n\u003Cp\u003E\u516D\u3001\u8D35\u91CD\u7269\u54C1\u968F\u8EAB\uFF1A\u63D0\u524D\u4E86\u89E3\u822A\u53F8\u6258\u8FD0\u653F\u7B56\uFF0C\u73B0\u91D1\u3001\u9996\u9970\u3001\u7535\u8111\u7B49\u8D35\u91CD\u7269\u54C1\u8BF7\u968F\u8EAB\u643A\u5E26\uFF0C\u5207\u52FF\u6258\u8FD0\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E03\u3001\u9075\u5B88\u6D77\u5173\u7533\u62A5\uFF1A\u4E25\u683C\u9075\u5B88\u9A6C\u6765\u897F\u4E9A\u6D77\u5173\u5173\u4E8E\u52FF\u643A\u5E26\u8FDD\u7981\u54C1\u3001\u73B0\u91D1\u548C\u7269\u54C1\u51FA\u5165\u5883\u7684\u7533\u62A5\u89C4\u5B9A\u3002\u003C/p\u003E\n\u003Cp\u003E\u516B\u3001\u9AD8\u5371\u9879\u76EE\u91CF\u529B\uFF1A\u53C2\u4E0E\u6469\u6258\u8247\u3001\u6D46\u677F\u3001\u6D6E\u6F5C\u3001\u6DF1\u6F5C\u7B49\u6D89\u6C34\u9879\u76EE\u65F6\uFF0C\u987B\u4E25\u683C\u542C\u4ECE\u4E13\u4E1A\u6559\u7EC3\u6307\u5BFC\uFF0C\u6839\u636E\u81EA\u8EAB\u8EAB\u4F53\u60C5\u51B5\u91CF\u529B\u800C\u884C\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E5D\u3001\u4FDD\u6301\u8054\u7EDC\u7545\u901A\uFF1A\u524D\u5F80\u6D77\u5C9B\u3001\u5C71\u533A\u7B49\u4FE1\u53F7\u8584\u5F31\u533A\u57DF\u524D\uFF0C\u52A1\u5FC5\u5C06\u884C\u7A0B\u8BA1\u5212\u63D0\u524D\u544A\u77E5\u56FD\u5185\u4EB2\u53CB\u3002\u4FE1\u53F7\u6062\u590D\u540E\u53CA\u65F6\u62A5\u5E73\u5B89\u3002\u003C/p\u003E\n\u003Cp\u003E\u6E29\u99A8\u63D0\u793A\uFF1A\u5883\u5916\u51FA\u884C\uFF0C\u5E73\u5B89\u7B2C\u4E00\u3002\u5982\u9047\u7D27\u6025\u60C5\u51B5\uFF0C\u8BF7\u53CA\u65F6\u62A5\u8B66\u6216\u6C42\u52A9\u3002\u003C/p\u003E\n\u003Cp\u003E\uFF08\u4E00\uFF09\u62A5\u8B66\u7535\u8BDD\u003C/p\u003E\n\u003Cp\u003E\u672C\u5730\u62A5\u8B66\u7535\u8BDD\uFF1A999\u003C/p\u003E\n\u003Cp\u003E\u54E5\u6253\u57FA\u7EB3\u5DF4\u5362\uFF08\u4E9A\u5E87\uFF09\u8B66\u5C40\uFF1A\u002B60-88529222\u003C/p\u003E\n\u003Cp\u003E\u6597\u6E56\u8B66\u5C40\uFF1A\u002B60-89752222/\u002B60-89772121\u003C/p\u003E\n\u003Cp\u003E\u4ED9\u672C\u90A3\u8B66\u5C40\uFF1A\u002B60-89782020\u003C/p\u003E\n\u003Cp\u003E\uFF08\u4E8C\uFF09\u65C5\u6E38\u670D\u52A1\u6295\u8BC9\u003C/p\u003E\n\u003Cp\u003E\u6C99\u5DF4\u5DDE\u65C5\u6E38\u5C40\u7535\u8BDD\uFF1A\u002B6019-939 2121/\u002B60-88212121\u003C/p\u003E\n\u003Cp\u003E\u5728\u7EBF\u6295\u8BC9\u5E73\u53F0\uFF1Ahttps://helpdesk.sabahtourism.com/\u003C/p\u003E\n\u003Cp\u003E\uFF08\u4E09\uFF09\u9886\u4E8B\u4FDD\u62A4\u003C/p\u003E\n\u003Cp\u003E\u5916\u4EA4\u90E8\u9886\u4FDD\u670D\u52A1\u70ED\u7EBF\uFF1A\u002B86-10-12308/\u002B86-10-65612308\u003C/p\u003E\n\u003Cp