{
  "id": "%ef%bc%88%e5%90%88%e8%a7%84%e8%b5%84%e8%ae%af%ef%bc%89%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e7%9a%84%e9%9b%87%e5%91%98%e5%85%ac%e7%a7%af%e9%87%91%ef%bc%88epf-kwsp%ef%bc%89",
  "slug": "%ef%bc%88%e5%90%88%e8%a7%84%e8%b5%84%e8%ae%af%ef%bc%89%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e7%9a%84%e9%9b%87%e5%91%98%e5%85%ac%e7%a7%af%e9%87%91%ef%bc%88epf-kwsp%ef%bc%89",
  "canonicalUrlKey": "%ef%bc%88%e5%90%88%e8%a7%84%e8%b5%84%e8%ae%af%ef%bc%89%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e7%9a%84%e9%9b%87%e5%91%98%e5%85%ac%e7%a7%af%e9%87%91%ef%bc%88epf-kwsp%ef%bc%89",
  "route": "/4714/",
  "title": "\uFF08\u5408\u89C4\u8D44\u8BAF\uFF09\u9A6C\u6765\u897F\u4E9A\u7684\u96C7\u5458\u516C\u79EF\u91D1\uFF08EPF/KWSP\uFF09",
  "summary": "\u9A6C\u6765\u897F\u4E9A\u7684\u96C7\u5458\u516C\u79EF\u91D1\uFF08 EPF/KWSP \uFF09 \u96C7\u5458\u516C\u79EF\u91D1\u662F\u7531\u653F\u5E9C\u7BA1\u7406\u7684\u9000\u4F11\u50A8\u84C4\u8BA1\u5212\uFF0C\u5728\u5370\u5EA6\u3001\u9999\u6E2F\u3001\u65B0\u52A0\u5761\u3001\u9A6C\u6765\u897F\u4E9A\u3001\u58A8\u897F \u54E5\u548C\u5176\u4ED6\u56FD\u5BB6\u5C5E\u4E8E\u5F3A\u5236\u6027\u7F34\u6B3E\uFF0C\u4E0E\u7F8E\u56FD\u7684\u793E\u4F1A\u4FDD\u969C\u5236\u5EA6\u7C7B\u4F3C\u3002 \u4EC0\u4E48\u662F\u96C7\u5458\u516C\u79EF\u91D1\uFF08 EPF/KWSP \uFF09\uFF1F \u9A6C\u6765\u897F\u4E9A\u7684\u96C7\u5458\u516C\u79EF\u91D1\uFF08 EPF/KWSP \uFF09\u662F\u4F9D\u636E\u300A 1991 \u5E74\u96C7\u5458\u516C\u79EF\u91D1\u6CD5\u300B\uFF08\u7B2C 452 \u53F7\u6CD5\u4EE4\uFF09 \u6210\u7ACB\uFF0C\u900F\u8FC7\u4E24\u65B9\u7684\u5F3A\u5236\u6027\u7F34\u6B3E\uFF08\u5458\u5DE5\u85AA\u8D44\u7684\u4E00\u90E8\u5206\u548C\u96C7\u4E3B\u4EE3\u8868\u5458\u5DE5\u7684\u7F34\u6B3E\uFF09\u4E3A\u4F1A\u5458\u63D0\u4F9B\u9000\u4F11\u798F\u5229\u3002\u96C7\u5458\u516C\u79EF\u91D1\u4E3A\u96C7\u4E3B\u63D0\u4F9B\u4E86\u65B9\u4FBF\u7684\u6846\u67B6\uFF0C\u8BA9\u4ED6\u4EEC\u900F\u8FC7\u6BCF\u6708\u6301\u2026",
  "body": "\u003Cp\u003E\u003Cstrong\u003E\u9A6C\u6765\u897F\u4E9A\u7684\u96C7\u5458\u516C\u79EF\u91D1\uFF08EPF/KWSP\uFF09\u003C/strong\u003E\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/05/frc-4ebf14871c36bd67d117c05ddccaebbd.jpg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u96C7\u5458\u516C\u79EF\u91D1\u662F\u7531\u653F\u5E9C\u7BA1\u7406\u7684\u9000\u4F11\u50A8\u84C4\u8BA1\u5212\uFF0C\u5728\u5370\u5EA6\u3001\u9999\u6E2F\u3001\u65B0\u52A0\u5761\u3001\u9A6C\u6765\u897F\u4E9A\u3001\u58A8\u897F\u54E5\u548C\u5176\u4ED6\u56FD\u5BB6\u5C5E\u4E8E\u5F3A\u5236\u6027\u7F34\u6B3E\uFF0C\u4E0E\u7F8E\u56FD\u7684\u793E\u4F1A\u4FDD\u969C\u5236\u5EA6\u7C7B\u4F3C\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u4EC0\u4E48\u662F\u96C7\u5458\u516C\u79EF\u91D1\uFF08EPF/KWSP\uFF09\uFF1F\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u7684\u96C7\u5458\u516C\u79EF\u91D1\uFF08EPF/KWSP\uFF09\u662F\u4F9D\u636E\u300A1991\u5E74\u96C7\u5458\u516C\u79EF\u91D1\u6CD5\u300B\uFF08\u7B2C452\u53F7\u6CD5\u4EE4\uFF09\u6210\u7ACB\uFF0C\u900F\u8FC7\u4E24\u65B9\u7684\u5F3A\u5236\u6027\u7F34\u6B3E\uFF08\u5458\u5DE5\u85AA\u8D44\u7684\u4E00\u90E8\u5206\u548C\u96C7\u4E3B\u4EE3\u8868\u5458\u5DE5\u7684\u7F34\u6B3E\uFF09\u4E3A\u4F1A\u5458\u63D0\u4F9B\u9000\u4F11\u798F\u5229\u3002\u96C7\u5458\u516C\u79EF\u91D1\u4E3A\u96C7\u4E3B\u63D0\u4F9B\u4E86\u65B9\u4FBF\u7684\u6846\u67B6\uFF0C\u8BA9\u4ED6\u4EEC\u900F\u8FC7\u6BCF\u6708\u6301\u7EED\u7F34\u4EA4\u5F3A\u5236\u6027\u7F34\u6B3E\u81F3\u5458\u5DE5\u7684\u9000\u4F11\u57FA\u91D1\u6237\u53E3\uFF0C\u5C65\u884C\u4ED6\u4EEC\u5BF9\u5458\u5DE5\u7684\u6CD5\u5B9A\u548C\u9053\u5FB7\u4E49\u52A1\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u8C01\u662F\u96C7\u4E3B\uFF1F\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u96C7\u4E3B\u88AB\u5B9A\u4E49\u4E3A\u4E0E\u5458\u5DE5\u7B7E\u8BA2\u670D\u52A1\u5408\u7EA6\u6216\u5B66\u5F92\u5408\u7EA6\u7684\u4EBA\u58EB\u3002\u003C/p\u003E\n\u003Cp\u003E\u96C7\u4E3B\u5305\u62EC\uFF1A\u003C/p\u003E\n\u003Cp\u003E\u0026#183; \u8D1F\u8D23\u53D1\u653E\u5DE5\u8D44\u7ED9\u201C\u5458\u5DE5\u201D\u7684\u7ECF\u7406\u3001\u4EE3\u7406\u6216\u4EBA\u58EB\u003C/p\u003E\n\u003Cp\u003E\u0026#183; \u4E00\u7EC4\u4EBA\u58EB\uFF0C\u65E0\u8BBA\u662F\u6CD5\u5B9A\u3001\u975E\u6CD5\u5B9A\u6216\u5DF2\u6CE8\u518C\u003C/p\u003E\n\u003Cp\u003E\u0026#183; \u300A1991\u5E74\u96C7\u5458\u516C\u79EF\u91D1\u6CD5\u300B\u9644\u88682\u5217\u660E\u7684\u653F\u5E9C\u3001\u653F\u5E9C\u90E8\u95E8\u3001\u6CD5\u5B9A\u673A\u6784\u3001\u5730\u65B9\u653F\u5E9C\u6216\u5176\u4ED6\u673A\u6784\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u8C01\u662F\u5458\u5DE5\uFF1F\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u5458\u5DE5\u88AB\u5B9A\u4E49\u4E3A\u4F9D\u636E\u670D\u52A1\u5408\u7EA6\u6216\u5B66\u5F92\u5408\u7EA6\u88AB\u96C7\u7528\u7684\u4EBA\u58EB\u3002\u670D\u52A1\u5408\u7EA6\u6216\u5B66\u5F92\u5408\u7EA6\u53EF\u4EE5\u662F\u4E66\u9762\u6216\u53E3\u5934\u5F62\u5F0F\u3001\u660E\u793A\u6216\u6697\u793A\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5408\u4F19\u4EBA\u6216\u72EC\u8D44\u7ECF\u8425\u8005\u662F\u5458\u5DE5\u5417\uFF1F\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u6839\u636E\u300A1991\u5E74\u96C7\u5458\u516C\u79EF\u91D1\u6CD5\u300B\u7684\u5B9A\u4E49\uFF0C\u72EC\u8D44\u7ECF\u8425\u8005\u6216\u5408\u4F19\u4EBA\u4E0D\u662F\u5458\u5DE5\uFF0C\u800C\u662F\u81EA\u96C7\u4EBA\u58EB\u3002\u56E0\u6B64\uFF0C\u4ED6\u4EEC\u4E0D\u5FC5\u7F34\u7EB3\u516C\u79EF\u91D1\uFF0C\u4F46\u4ED6\u4EEC\u53EF\u4EE5\u9009\u62E9\u81EA\u613F\u7F34\u7EB3\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/05/frc-ee75bb5d25a9ab3201a1f3c212932077.jpg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u54EA\u4E9B\u6B3E\u9879\u987B\u7F34\u7EB3\u96C7\u5458\u516C\u79EF\u91D1\uFF1F\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u5458\u5DE5\u5728\u5176\u670D\u52A1\u5408\u7EA6\u6216\u5B66\u5F92\u5408\u7EA6\u4E0B\u6240\u5E94\u83B7\u5F97\u7684\u6240\u6709\u62A5\u916C\uFF0C\u65E0\u8BBA\u662F\u6BCF\u6708\u3001\u6BCF\u5468\u3001\u6BCF\u65E5\u6216\u4EE5\u5176\u4ED6\u5F62\u5F0F\u53D1\u653E\u3002\u003C/p\u003E\n\u003Cp\u003E\u987B\u7F34\u7EB3\u516C\u79EF\u91D1\u7684\u6B3E\u9879\u5982\u4E0B\uFF1A\u003C/p\u003E\n\u003Cp\u003E\u0026#183; \u85AA\u91D1\u003C/p\u003E\n\u003Cp\u003E\u0026#183; \u672A\u4F7F\u7528\u5E74\u5047\u6216\u75C5\u5047\u8F6C\u6362\u6210\u7684\u73B0\u91D1\u003C/p\u003E\n\u003Cp\u003E\u0026#183; \u82B1\u7EA2\u003C/p\u003E\n\u003Cp\u003E\u0026#183; \u6D25\u8D34\u003C/p\u003E\n\u003Cp\u003E\u0026#183; \u4F63\u91D1\u003C/p\u003E\n\u003Cp\u003E\u0026#183; \u5956\u91D1\u003C/p\u003E\n\u003Cp\u003E\u0026#183; \u62D6\u6B20\u7684\u85AA\u8D44\u003C/p\u003E\n\u003Cp\u003E\u0026#183; \u4EA7\u5047\u7684\u85AA\u8D44\u003C/p\u003E\n\u003Cp\u003E\u0026#183; \u5B66\u4E60\u5047\u7684\u85AA\u8D44\u003C/p\u003E\n\u003Cp\u003E\u0026#183; \u534A\u5929\u5047\u7684\u85AA\u8D44\u003C/p\u003E\n\u003Cp\u003E\u0026#183; \u670D\u52A1\u5408\u7EA6\u6216\u5176\u4ED6\u5408\u7EA6\u4E0B\u7684\u5176\u4ED6\u62A5\u916C\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u96C7\u5458\u516C\u79EF\u91D1\u7684\u6BCF\u6708\u7F34\u7EB3\u7387\u662F\u591A\u5C11\uFF1F\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003Ei. \u5458\u5DE5\uFF1A\u6708\u85AA\u76848%\uFF0860\u5C81\u4EE5\u4E0A\u5458\u5DE5\uFF1A\u6708\u85AA\u76844%\uFF09\uFF0C\u81EA\u52A8\u4ECE\u5458\u5DE5\u7684\u85AA\u8D44\u4E2D\u6263\u9664*1\u003C/p\u003E\n\u003Cp\u003Eii. \u96C7\u4E3B\uFF1A\u6708\u85AA5,000\u4EE4\u5409\u53CA\u4EE5\u4E0B\u4E3A13%\uFF1B\u6708\u85AA\u8D85\u8FC75,000\u4EE4\u5409\u4E3A12%*2\u003C/p\u003E\n\u003Cp\u003E*1 \u5E0C\u671B\u5C06\u5458\u5DE5\u7F34\u7EB3\u7387\u7EF4\u6301\u572811%\uFF0860\u5C81\u4EE5\u4E0A\u5458\u5DE5\u4E3A5.5%\uFF09\u7684\u5458\u5DE5\u5FC5\u987B\u586B\u5199\u8868\u683CKWSP17A\uFF082016\u5E74\u7279\u522B\u7248\uFF09\u53CA\u7B7E\u5B57\uFF0C\u7136\u540E\u63D0\u4EA4\u7ED9\u96C7\u4E3B\u3002\u96C7\u4E3B\u5E94\u8BE5\u68C0\u67E5\u8868\u683C\u662F\u5426\u5DF2\u6B63\u786E\u586B\u5199\uFF0C\u7136\u540E\u5C06\u8868\u683C\u6574\u7406\u597D\uFF0C\u63D0\u4EA4\u81F3\u6700\u9760\u8FD1\u7684\u516C\u79EF\u91D1\u5C40\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ECE2018\u5E741\u67081\u65E5\u5F00\u59CB\uFF0C\u5458\u5DE5\u7F34\u7EB3\u7387\u6062\u590D11%\uFF0860\u5C81\u4EE5\u4E0A\u5458\u5DE5\u4E3A5.5%\uFF09\u3002\u003C/p\u003E\n\u003Cp\u003E*2 \u9A6C\u6765\u897F\u4E9A\u653F\u5E9C\u9F13\u52B1\u96C7\u4E3B\u7F34\u4EA4\u8D85\u8FC7\u6CD5\u5B9A\u7F34\u7EB3\u7387\u7684\u7F34\u6B3E\uFF0C\u989D\u5916\u7684\u7F34\u6B3E\u53EF\u4EAB\u6709\u514D\u7A0E\u4F18\u60E0\uFF0C\u6700\u9AD8\u53EF\u8FBE\u5458\u5DE5\u6708\u85AA\u768419%\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u4EC0\u4E48\u662F\u81EA\u613F\u7F34\u7EB3\u516C\u79EF\u91D1\uFF1F\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u9664\u4E86\u300A1991\u5E74\u96C7\u5458\u516C\u79EF\u91D1\u6CD5\u300B\u6240\u89C4\u5B9A\u7684\u4EBA\u58EB\uFF0C\u653F\u5E9C\u4E5F\u9F13\u52B1\u4E0D\u5728\u6B64\u6CD5\u4EE4\u6DB5\u76D6\u8303\u56F4\u5185\u7684\u4EBA\u58EB\u81EA\u613F\u7F34\u7EB3\u516C\u79EF\u91D1\uFF0C\u589E\u52A0\u9000\u4F11\u50A8\u84C4\u3002\u003C/p\u003E\n\u003Cp\u003E\u300A1991\u5E74\u96C7\u5458\u516C\u79EF\u91D1\u6CD5\u300B\u5141\u8BB8\u81EA\u613F\u7F34\u7EB3\u516C\u79EF\u91D1\u7684\u4EBA\u58EB\u5982\u4E0B\uFF1A\u003C/p\u003E\n\u003Cp\u003Ea) \u5728\u4F4F\u5B85\u4E2D\u5DE5\u4F5C\u3001\u7531\u4F4F\u5B85\u6240\u6709\u8005\u96C7\u7528\u7684\u5BB6\u5EAD\u4F63\u4EBA\u3002\u003C/p\u003E\n\u003Cp\u003Eb) \u72EC\u8D44\u7ECF\u8425\u8005\u3001\u6CA1\u6709\u85AA\u8D44\u7684\u5408\u4F19\u4EBA\u3001\u9000\u4F11\u5DE5\u4EBA\u548C\u672A\u88AB\u300A1991\u5E74\u96C7\u5458\u516C\u79EF\u91D1\u6CD5\u300B\u5B9A\u4E49\u4E3A\u96C7\u4E3B\u6216\u5458\u5DE5\u7684\u4EBA\u58EB\u3002\u003C/p\u003E\n\u003Cp\u003Ec) \u5DF2\u5728\u201C\u79BB\u56FD\u63D0\u6B3E\u8BA1\u5212\u201D\u4E0B\u63D0\u51FA\u6240\u6709\u50A8\u84C4\u3001\u540E\u6765\u8FD4\u56DE\u9A6C\u6765\u897F\u4E9A\u5DE5\u4F5C\u7684\u5927\u9A6C\u516C\u6C11\u3002\u81EA\u613F\u7F34\u7EB3\u516C\u79EF\u91D1\u53EF\u901A\u8FC7\u586B\u5199\u8868\u683CKWSP 6A(1) \u8FDB\u884C\u3002\u003C/p\u003E\n\u003Cp\u003E\u6700\u540E\u4E00\u70B9\uFF0C\u590D\u5408\u673A\u5236\u53EF\u4EE5\u63D0\u9AD8\u60A8\u7684\u50A8\u84C4\u7684\u4EF7\u503C\uFF0C\u60A8\u73B0\u5728\u5B58\u5165\u7684\u6BCF\u4E00\u6BDB\u94B1\u65E5\u540E\u90FD\u4F1A\u5927\u5E45\u589E\u503C\u3002\u6B64\u5916\uFF0C\u4F5C\u4E3A\u9A6C\u6765\u897F\u4E9A\u9996\u5C48\u4E00\u6307\u7684\u9000\u4F11\u50A8\u84C4\u57FA\u91D1\uFF0C\u96C7\u5458\u516C\u79EF\u91D1\u627F\u8BFA\u6D3E\u606F\u7ED9\u6240\u6709\u4F1A\u5458\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E-END-\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/u-JkPy0OrqRraAbPViqc-w\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
