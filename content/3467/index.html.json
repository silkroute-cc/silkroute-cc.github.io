  "title": "\u5173\u4E8EAPEC\u5546\u52A1\u65C5\u884C\u5361\u865A\u62DF\u5361\u6301\u5361\u4EBA\u6765\u534E\u5B89\u6392\u7684\u901A\u77E5",
  "summary": "\u4E3A\u8FDB\u4E00\u6B65\u4FBF\u5229\u4E9A\u592A\u5730\u533A\u5546\u52A1\u4EBA\u5458\u5F80\u6765\uFF0C\u4E2D\u65B9\u51B3\u5B9A\u81EA2023\u5E745\u67081\u65E5\u8D77\u63A5\u53D7\u5916\u65B9APEC\u5546\u52A1\u65C5\u884C\u5361 \u865A\u62DF\u5361 \u6301\u5361\u4EBA\u5165\u5883\u3002 \u4F5C\u4E3A\u8FC7\u6E21\u6027\u5B89\u6392\uFF0C2023\u5E745\u67081\u65E5\u524D\uFF0C \u865A\u62DF\u5361 \u6301\u5361\u4EBA\u5982\u8D74\u534E\u9700\u7533\u529E\u7B7E\u8BC1\uFF0C\u4E2D\u65B9\u5C06\u63D0\u4F9B\u4FBF\u5229\uFF0C\u5177\u4F53\u8981\u6C42\u53EF\u53D1\u90AE\u4EF6\u81F3klcentre@visaforchina.org\u54A8\u8BE2\u3002 \u53E6\uFF0C\u4E2D\u65B9\u5DF2\u81EA2022\u5E748\u670824\u65E5\u8D77\uFF0C\u5141\u8BB8\u6301\u6709\u6548APEC\u5546\u52A1\u65C5\u884C\u5361 \u5B9E\u4F53\u5361 \u4EBA\u5458\u5165\u5883\u4E2D\u56FD\uFF0C\u76F8\u5173\u4EBA\u5458\u65E0\u9700\u91CD\u65B0\u7533\u529E\u8D74\u534E\u7B7E\u8BC1\u3002 \u7279\u6B64\u901A\u77E5\u3002 \u4E2D\u56FD\u9A7B\u9A6C\u6765\u897F\u4E9A\u5927\u4F7F\u9986 2023\u5E742\u670817\u65E5\u2026",
  "body": "\u003Cp\u003E \u4E3A\u8FDB\u4E00\u6B65\u4FBF\u5229\u4E9A\u592A\u5730\u533A\u5546\u52A1\u4EBA\u5458\u5F80\u6765\uFF0C\u4E2D\u65B9\u51B3\u5B9A\u81EA2023\u5E745\u67081\u65E5\u8D77\u63A5\u53D7\u5916\u65B9APEC\u5546\u52A1\u65C5\u884C\u5361\u003Cstrong\u003E\u865A\u62DF\u5361\u003C/strong\u003E\u6301\u5361\u4EBA\u5165\u5883\u3002\u003C/p\u003E\n\u003Cp\u003E\u4F5C\u4E3A\u8FC7\u6E21\u6027\u5B89\u6392\uFF0C2023\u5E745\u67081\u65E5\u524D\uFF0C\u003Cstrong\u003E\u865A\u62DF\u5361\u003C/strong\u003E\u6301\u5361\u4EBA\u5982\u8D74\u534E\u9700\u7533\u529E\u7B7E\u8BC1\uFF0C\u4E2D\u65B9\u5C06\u63D0\u4F9B\u4FBF\u5229\uFF0C\u5177\u4F53\u8981\u6C42\u53EF\u53D1\u90AE\u4EF6\u81F3klcentre@visaforchina.org\u54A8\u8BE2\u3002\u003C/p\u003E\n\u003Cp\u003E\u53E6\uFF0C\u4E2D\u65B9\u5DF2\u81EA2022\u5E748\u670824\u65E5\u8D77\uFF0C\u5141\u8BB8\u6301\u6709\u6548APEC\u5546\u52A1\u65C5\u884C\u5361\u003Cstrong\u003E\u5B9E\u4F53\u5361\u003C/strong\u003E\u4EBA\u5458\u5165\u5883\u4E2D\u56FD\uFF0C\u76F8\u5173\u4EBA\u5458\u65E0\u9700\u91CD\u65B0\u7533\u529E\u8D74\u534E\u7B7E\u8BC1\u3002\u003C/p\u003E\n\u003Cp\u003E\u7279\u6B64\u901A\u77E5\u3002\u003C/p\u003E\n\u003Cp\u003E \u4E2D\u56FD\u9A7B\u9A6C\u6765\u897F\u4E9A\u5927\u4F7F\u9986\u003C/p\u003E\n\u003Cp\u003E 2023\u5E742\u670817\u65E5 \u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/C76hyEdlKFNymqAZumZywQ\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
