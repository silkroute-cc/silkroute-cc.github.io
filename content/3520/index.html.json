{
  "id": "%e5%85%a5%e5%a2%83%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%ef%bc%8c%e7%9c%8b%e8%bf%99%e4%b8%80%e7%af%87%e5%b0%b1%e5%a4%9f%e4%ba%86",
  "slug": "%e5%85%a5%e5%a2%83%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%ef%bc%8c%e7%9c%8b%e8%bf%99%e4%b8%80%e7%af%87%e5%b0%b1%e5%a4%9f%e4%ba%86",
  "canonicalUrlKey": "%e5%85%a5%e5%a2%83%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%ef%bc%8c%e7%9c%8b%e8%bf%99%e4%b8%80%e7%af%87%e5%b0%b1%e5%a4%9f%e4%ba%86",
  "route": "/3520/",
  "title": "\u5165\u5883\u9A6C\u6765\u897F\u4E9A\uFF0C\u770B\u8FD9\u4E00\u7BC7\u5C31\u591F\u4E86",
  "summary": "\u5165\u5883\u653F\u7B56 \u4E2D\u79CB\u00B7 \u4F73\u8282 zh\u014Dng qi\u016B ji\u00E9 \u00B7 \u65E0\u9700 \u8FDB\u884C\u5C45\u5BB6\u9694\u79BB\u6216\u9694\u79BB\u63AA\u65BD\uFF0C\u5165\u5883\u4E5F\u4E0D\u7528\u586B\u5199MySejahteryCard; \u00B7\u514DPCR \uFF08\u6838\u9178\u8BC1\u660E\uFF09\u9664\u975E\u5165\u5883\u65F6\uFF0C\u6709\u75C7\u72B6 ; \u00B7\u9A6C\u6765\u897F\u4E9A\u5DF2\u53D6\u6D88\u5065\u5EB7\u5E94\u7528\u7A0B\u5E8F\uFF0C\u5165\u5883\u4E0D\u7528\u7533\u8BF7\u65C5\u6E38\u5361\uFF0C\u6CA1\u6709\u75AB\u82D7\u8981\u6C42\uFF1B \u00B7\u9A6C\u6765\u897F\u4E9A\u536B\u751F\u90E8\u4F9D\u7136\u4F1A\u7EE7\u7EED\u6267\u884C\u6240\u6709\u56FD\u9645\u5165\u5883\u5904\u7684\u76D1\u6D4B\u63AA\u65BD\uFF0C\u4E00\u65E6\u5165\u5883\u8005\u88AB\u70ED\u80FD\u611F\u5E94\u5668\u63A2\u6D4B\u5230\u6709\u53D1\u70E7\u75C7\u72B6\uFF0C\u5C06\u4F1A\u88AB\u9001\u5F80\u533B\u7597\u673A\u6784\u63A5\u53D7\u8FDB\u4E00\u6B65\u7684\u68C0\u6D4B\u3002\u5982\u679C\u7591\u4F3C\u611F\u67D3\u65B0\u51A0\u3001\u7334\u75D8\u3001\u4E2D\u4E1C\u547C\u5438\u7EFC\u5408\u75C7\u7B49\u75C5\u6BD2\uFF0C\u987B\u7559\u9662\u6CBB\u7597\uFF1B\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/02/frc-c69995bbb1b5108c5572ac6663c3cb03.gif\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5165\u5883\u653F\u7B56\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u4E2D\u79CB\u0026#183;\u003C/p\u003E\n\u003Cp\u003E\u4F73\u8282\u003C/p\u003E\n\u003Cp\u003Ezh\u014Dng\u003C/p\u003E\n\u003Cp\u003Eqi\u016Bji\u0026#233;\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/02/frc-65ebdbc1305e167599379c6e444b1fd3.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\n\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u0026#183;\u003C/strong\u003E\u65E0\u9700\u8FDB\u884C\u5C45\u5BB6\u9694\u79BB\u6216\u9694\u79BB\u63AA\u65BD\uFF0C\u5165\u5883\u4E5F\u4E0D\u7528\u586B\u5199MySejahteryCard;\u003C/p\u003E\n\u003Cp\u003E\u0026#183;\u514DPCR \uFF08\u6838\u9178\u8BC1\u660E\uFF09\u9664\u975E\u5165\u5883\u65F6\uFF0C\u6709\u75C7\u72B6 ;\u003C/p\u003E\n\u003Cp\u003E\u0026#183;\u9A6C\u6765\u897F\u4E9A\u5DF2\u53D6\u6D88\u5065\u5EB7\u5E94\u7528\u7A0B\u5E8F\uFF0C\u5165\u5883\u4E0D\u7528\u7533\u8BF7\u65C5\u6E38\u5361\uFF0C\u6CA1\u6709\u75AB\u82D7\u8981\u6C42\uFF1B\u003C/p\u003E\n\u003Cp\u003E\u0026#183;\u9A6C\u6765\u897F\u4E9A\u536B\u751F\u90E8\u4F9D\u7136\u4F1A\u7EE7\u7EED\u6267\u884C\u6240\u6709\u56FD\u9645\u5165\u5883\u5904\u7684\u76D1\u6D4B\u63AA\u65BD\uFF0C\u4E00\u65E6\u5165\u5883\u8005\u88AB\u70ED\u80FD\u611F\u5E94\u5668\u63A2\u6D4B\u5230\u6709\u53D1\u70E7\u75C7\u72B6\uFF0C\u5C06\u4F1A\u88AB\u9001\u5F80\u533B\u7597\u673A\u6784\u63A5\u53D7\u8FDB\u4E00\u6B65\u7684\u68C0\u6D4B\u3002\u5982\u679C\u7591\u4F3C\u611F\u67D3\u65B0\u51A0\u3001\u7334\u75D8\u3001\u4E2D\u4E1C\u547C\u5438\u7EFC\u5408\u75C7\u7B49\u75C5\u6BD2\uFF0C\u987B\u7559\u9662\u6CBB\u7597\uFF1B\u003C/p\u003E\n\u003Cp\u003E\u0026#183;\u73B0\u5728\u5165\u5883\u9A6C\u6765\u897F\u4E9A\uFF0C\u5728\u6237\u5916\u6D3B\u52A8\u5E76\u4E0D\u5F3A\u5236\u4F69\u6234\u95E8\u7F69\uFF0C\u4F46\u5728\u5BA4\u5185\u6216\u5BC6\u95ED\u7A7A\u95F4\uFF0C\u5982\u6559\u5BA4\u3001\u5546\u573A\u3001\u516C\u5171\u4EA4\u901A\u8FD8\u662F\u5EFA\u8BAE\u4F69\u6234\u53E3\u7F69\u54DF~\u4FDD\u6301\u5B89\u5168\u793E\u4EA4\u8DDD\u79BB.\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/02/frc-c6471063f23e3a156b3de3251bf74635.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5165\u5883\u6750\u6599\u003C/strong\u003E\n\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/02/frc-8fe0d46fbc18372e79941f826b270b61.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u0026#183;\u62A4\u7167\u539F\u4EF6 (\u6709\u6548\u671F\u81F3\u5C116\u4E2A\u6708) \u53CA\u62A4\u7167\u9996\u9875 (\u4FE1\u606F\u9875) \u590D\u5370\u4EF6\u3001\u8EAB\u4EFD\u8BC1\u539F\u4EF6\uFF1B\n\u003C/p\u003E\n\u003Cp\u003E\u0026#183;\u6709\u6548\u7B7E\u8BC1: \u7535\u5B50\u7B7E\u52A1\u5FC5\u5F69\u8272\u6253\u53702\u4EFD\uFF1B\u003C/p\u003E\n\u003Cp\u003E\u0026#183;\u75AB\u82D7\u8BC1\u660E (\u4E00\u4E9B\u822A\u7A7A\u516C\u53F8\u4F9D\u7136\u8981\u6C42\u75AB\u82D7\u8BC1\u4E66\uFF0C\u52A1\u5FC5\u5148\u4E0E\u822A\u7A7A\u516C\u53F8\u786E\u8BA4)\uFF1B\u003C/p\u003E\n\u003Cp\u003E\u0026#183;\u5F80\u8FD4\u673A\u7968\u0026amp;\u9152\u5E97\u9884\u8BA2\u5355(\u65C5\u6E38\u7B7E)\uFF1B\u003C/p\u003E\n\u003Cp\u003E\u0026#183;\u901A\u77E5\u4E66Offer\u5F69\u8272\u6253\u5370\u4EF62\u4EFD (\u5B66\u751F)\uFF1B\u003C/p\u003E\n\u003Cp\u003E\u0026#183;\u968F\u8EAB\u643A\u5E262000\u9A6C\u5E01\u62165000\u4EBA\u6C11\u5E01\uFF1B\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5165\u5883\u6D41\u7A0B\u003C/strong\u003E\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/02/frc-4a4bca4c6fe18b405c946949fd14ed92.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u0026#183;\u79BB\u5883\u68C0\u67E5\uFF1A\u8FC7\u8FB9\u68C0\u65F6\u9700\u8981\u63D0\u4F9B\u7B7E\u8BC1\u3001\u62A4\u7167\u3001\u673A\u7968\u3001\u5B66\u751FOFFER\uFF08\u5B66\u751F\u7B7E\u9700\u8981\uFF09\uFF0C\u8FC7\u4E86\u8FB9\u68C0\u540E\uFF0C\u5DE5\u4F5C\u4EBA\u5458\u4F1A\u5728\u4F60\u7684\u673A\u7968\u4E0A\u8D34\u4E0A\u7EFF\u8272\u201CPASS\u201D\u6807\u7B7E\uFF1B\u003C/p\u003E\n\u003Cp\u003E\u0026#183;\u62B5\u8FBE\uFF1A\u5230\u8FBE\u9A6C\u6765\u897F\u4E9A\u540E\uFF0C\u6309\u7167\u5ECA\u6865\u6807\u8BC6\uFF0C\u5750\u4E0A\u6446\u6E21\u8F66\uFF08\u6446\u6E21\u8F66\u901A\u5E38\u662F\u5C0F\u706B\u8F66\u6216\u8005\u5927\u5DF4\u8F66\uFF09\u53BB\u5230\u5165\u5883\u5927\u5385\u68C0\u6D4B\u5904\uFF0C\u8FDB\u884C\u5165\u5173\u68C0\u67E5\u3002\u6574\u4E2A\u51FA\u5883\u8FC7\u7A0B\u7279\u522B\u6CE8\u610F\u7684\u662F\uFF0C\u9700\u8981\u7D27\u8DDF\u7740immigration\u7684\u724C\u5B50\u8D70\uFF0C\u5982\u679C\u627E\u4E0D\u5230\u5C31\u8BE2\u95EE\u201Cwhere is immigration?\u201D\uFF1B\u003C/p\u003E\n\u003Cp\u003E\u0026#183;\u5151\u6362\u9A6C\u5E01\uFF0C\u8D2D\u4E70\u7535\u8BDD\u5361\uFF1A\u5982\u679C\u4F60\u9700\u8981\u6362\u9A6C\u5E01\u6216\u8005\u8D2D\u4E70\u5F53\u5730\u624B\u673A\u5361\uFF08\u5176\u5B9E\uFF0C\u53EF\u5F00\u901A\u652F\u4ED8\u5B9D\u4E09\u5929\u5883\u5916\u6D41\u91CF\uFF09\uFF0C\u4F60\u53EF\u4EE5\u5728\u673A\u573A\u4E0B\u4E86\u6446\u6E21\u8F66\u540E\u518D\u53BB\u8D2D\u4E70\u6216\u8005\u6362\u9A6C\u5E01\uFF0C\u5EFA\u8BAE\u6700\u597D\u5728\u56FD\u5185\u5151\u6362\u597D\u9A6C\u5E01\u3002\u003C/p\u003E\n\u003Cp\u003E\u0026#183;\u8FC7\u6D77\u5173\uFF1A\u6D77\u5173\u7A97\u53E3\u5206\u4E3A\u9A6C\u6765\u7C4D\u62A4\u7167\u901A\u9053\u3001\u5916\u56FD\u4EBA\u62A4\u7167\u901A\u9053\u3001VIP\u901A\u9053\u3002\u8FC7\u5173\u65F6\u9700\u8981\u63D0\u4F9B\u7535\u5B50\u7B7E\u8BC1\u3001eVAL\u548C\u62A4\u7167\uFF0C\u8FC7\u5173\u65F6\uFF0C\u6D77\u5173\u4EBA\u5458\u4F1A\u5C06\u4F60\u7684\u5DE6\u53F3\u624B\u98DF\u6307\u6307\u7EB9\u8FDB\u884C\u6309\u538B\u5F55\u5165\uFF0C\u6D77\u5173\u4EBA\u5458\u53EF\u80FD\u4F1A\u63D0\u95EE\uFF0C\u5982\u5728\u9A6C\u6765\u897F\u4E9A\u54EA\u91CC\u4E0A\u5B66\u7B49\uFF0C\u5982\u5B9E\u56DE\u7B54\u5373\u53EF\u3002\uFF08\u6CE8\u610F\uFF1A\u9A6C\u6765\u897F\u4E9A\u8FC7\u6D77\u5173\u6548\u7387\u8F83\u4F4E\uFF0C\u6392\u961F1-2\u5C0F\u65F6\u5C5E\u4E8E\u6B63\u5E38\u6392\u961F\u7B49\u5F85\u65F6\u95F4\u3002\uFF09\u003C/p\u003E\n\u003Cp\u003E\u0026#183;\u53D6\u884C\u674E\uFF1A\u4E00\u5B9A\u8BB0\u4F4F\u9A6C\u6765\u897F\u4E9A\u8FD9\u8FB9\u662F\u51FA\u6D77\u5173\u540E\u62FF\u884C\u674E\uFF0C\u63D0\u53D6\u884C\u674E\u4E4B\u540E\u518D\u51FA\u673A\u573A\u54DF\uFF1B\u003C/p\u003E\n\u003Cp\u003E\u79BB\u5F00\u673A\u573A\uFF1A\u8FC7\u5B8C\u6D77\u5173\uFF0C\u62FF\u4E0A\u884C\u674E\u540E\uFF0C\u5C31\u53EF\u4EE5\u5F00\u542F\u60A8\u7684\u9A6C\u6765\u897F\u4E9A\u4E4B\u65C5\u5566\uFF01\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/02/frc-acff6c8db602261467d04f3c7d5bf6ab.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5176\u4ED6\u5C0F\u8D34\u58EB~\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E1\u3001\u7531\u4E8E\u4E2D\u56FD\u653E\u5BBD\u9632\u75AB\u653F\u7B56\uFF0C\u5BFC\u81F4\u5165\u5883\u9A6C\u6765\u897F\u4E9A\u4F1A\u51FA\u73B0\u66F4\u591A\u7684\u53D8\u5316\uFF0C\u5EFA\u8BAE\u5927\u5BB6\u51FA\u884C\u524D\u90FD\u8981\u505A\u597D\u51C6\u5907\uFF0C\u80FD\u505A\u6838\u9178\u7684\u5C3D\u91CF\u90FD\u53BB\u505A\uFF1B\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\n\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E2\u3001\u5165\u5883\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38\u7B7E\uFF0C\u4E00\u5B9A\u8981\u5F80\u8FD4\u673A\u7968\u7684\uFF0C\u6CA1\u6709\u7684\u8BDD\uFF0C\u5F88\u5BB9\u6613\u5361\u5173\u6216\u8005\u9063\u8FD4\uFF1B\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\n\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E3\u3001\u51FA\u884C\u9A6C\u6765\u897F\u4E9A\uFF0C\u5EFA\u8BAE\u5927\u5BB6\u51FA\u4E86\u7B7E\u8BC1\u518D\u8D2D\u4E70\u673A\u7968\uFF0C\u4EE5\u514D\u9020\u6210\u4E0D\u5FC5\u8981\u635F\u5931\uFF1B\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\n\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E4\u3001\u5409\u9686\u5761\u56FD\u9645\u673A\u573A\u7684\u4EA4\u901A\u975E\u5E38\u65B9\u4FBF\uFF0C\u673A\u573A\u5927\u5DF4\u3001\u8F68\u9053\u4EA4\u901A\u548C\u51FA\u79DF\u8F66\u670D\u52A1\u90FD\u5F88\u65B9\u4FBF\uFF0C\u9996\u6B21\u5165\u5883\u9A6C\u6765\u897F\u4E9A\u7684\u5B66\u751F\u53EF\u4EE5\u7ED9\u8054\u7CFB\u5B66\u6821\u4E00\u822C\u4F1A\u5B89\u6392\u8001\u5E08\u6765\u63A5\u673A\uFF1B\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\n\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E5\u3001\u9A6C\u6765\u897F\u4E9A\u56DB\u5B63\u5982\u590F\uFF0C\u9633\u5149\u5F3A\u70C8\uFF0C\u4E00\u5B9A\u8981\u6CE8\u610F\u9632\u6652\u54DF\u3002\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u66F4\u591A\u7B7E\u8BC1-\u673A\u7968-\u9152\u5E97\u4E00\u7AD9\u5F0F\u670D\u52A1\uFF08\u5173\u6CE8\u516C\u4F17\u53F7\u4E86\u89E3\u66F4\u591A\uFF09\u003C/p\u003E\n\u003Cp\u003E\u4E13\u5C5E\u5BA2\u670D\u5E2E\u4F60\u89E3\u51B3\u9A6C\u6765\u897F\u4E9A\u5404\u79CD\u7B7E\u8BC1\u95EE\u9898\u2193\u2193\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/02/frc-28c222323e2d631cc489289165f8b454.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/1yvHpj-Y1C2jhxjxRFf8ag\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
