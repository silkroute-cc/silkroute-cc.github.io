{
  "id": "%e8%b7%a8%e5%a2%83%e9%93%81%e8%b7%af%e7%8f%ad%e5%88%97%e4%b8%be%e8%a1%8c%e9%a6%96%e5%8f%91-%e5%a4%a7%e9%a9%ac%e8%b4%a7%e7%89%a99%e5%a4%a9%e8%bf%90%e6%8a%b5%e9%87%8d%e5%ba%86",
  "slug": "%e8%b7%a8%e5%a2%83%e9%93%81%e8%b7%af%e7%8f%ad%e5%88%97%e4%b8%be%e8%a1%8c%e9%a6%96%e5%8f%91-%e5%a4%a7%e9%a9%ac%e8%b4%a7%e7%89%a99%e5%a4%a9%e8%bf%90%e6%8a%b5%e9%87%8d%e5%ba%86",
  "canonicalUrlKey": "%e8%b7%a8%e5%a2%83%e9%93%81%e8%b7%af%e7%8f%ad%e5%88%97%e4%b8%be%e8%a1%8c%e9%a6%96%e5%8f%91-%e5%a4%a7%e9%a9%ac%e8%b4%a7%e7%89%a99%e5%a4%a9%e8%bf%90%e6%8a%b5%e9%87%8d%e5%ba%86",
  "route": "/4881/",
  "title": "\u8DE8\u5883\u94C1\u8DEF\u73ED\u5217\u4E3E\u884C\u9996\u53D1 \u5927\u9A6C\u8D27\u72699\u5929\u8FD0\u62B5\u91CD\u5E86",
  "summary": "\u9646\u5146\u798F\uFF08\u53F3\u56DB\u8D77\uFF09\u4E0E\u6B27\u9633\u7389\u9756\u7B49\u4E00\u4F17\u5609\u5BBE\u4E3B\u6301\u63A8\u4ECB\u4EEA\u5F0F\u3002\u53F3\u4E8C\u8D77\u62C9\u5C3C\u53CA\u62C9\u8FBE\u666E\u739B\u3002 \u9A6C\u65B0\u793E \uFF08\u516B\u6253\u7075\u518D\u4E5F27\u65E5\u8BAF\uFF09\u9A6C\u6765\u897F\u4E9A\u96EA\u5170\u83AA\u76F4\u8FBE\u4E2D\u56FD\u91CD\u5E86\u7684\u9646\u6D77\u65B0\u901A\u9053\u4E2D\u5BEE\u6CF0\u9A6C\u8DE8\u5883\u94C1\u8DEF\u73ED\u5217\uFF0C\u4ECA\u65E5\u4E3E\u884C\u9996\u53D1\u4EEA\u5F0F\uFF0C\u5168\u7A0B\u53EA\u97009\u5929\uFF0C\u9884\u8BA1\u53EF\u4E3A\u8FDB\u51FA\u53E3\u4E1A\u8005\u8282\u7701\u81F3\u5C1120%\u8FD0\u8F93\u6210\u672C\u3002 \u4EA4\u901A\u90E8\u957F\u9646\u5146\u798F\u6307\u51FA\uFF0C\u8FD9\u9879\u7531\u6765\u81EA4\u4E2A\u56FD\u5BB6\u76F8\u5173\u5355\u4F4D\u53CA\u4E1A\u8005\u7684\u5408\u4F5C\u6DF1\u5177\u610F\u4E49\uFF0C\u9996\u5148\u4E3A\u53EF\u6269\u5927\u9A6C\u4E2D\u4E24\u56FD\u8D38\u6613\uFF0C\u5176\u6B21\u4E3A\u6211\u56FD\u4E0E\u6CF0\u56FD\u53CA\u5BEE\u56FD\u7684\u6E05\u5173\u7AD9\u6210\u529F\u8FBE\u81F4\u5408\u4F5C\u3002 \u201C\u4E1C\u76DF\u7279\u5FEB\u5217\u8F66\uFF08ASEAN Express\uFF09\u63D0\u4F9B\u4E86\u6BD4\u4F20\u7EDF\u8DEF\u7EBF\u66F4\u5FEB\u7684\u66FF\u4EE3\u65B9\u6848\uFF0C\u4ECE\uFF08\u96EA\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/06/frc-1e9a15b0d89f5b28207cc1c8d85a3dc2.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u9646\u5146\u798F\uFF08\u53F3\u56DB\u8D77\uFF09\u4E0E\u6B27\u9633\u7389\u9756\u7B49\u4E00\u4F17\u5609\u5BBE\u4E3B\u6301\u63A8\u4ECB\u4EEA\u5F0F\u3002\u53F3\u4E8C\u8D77\u62C9\u5C3C\u53CA\u62C9\u8FBE\u666E\u739B\u3002\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u65B0\u793E\u003C/p\u003E\n\u003Cp\u003E\uFF08\u516B\u6253\u7075\u518D\u4E5F27\u65E5\u8BAF\uFF09\u9A6C\u6765\u897F\u4E9A\u96EA\u5170\u83AA\u76F4\u8FBE\u4E2D\u56FD\u91CD\u5E86\u7684\u9646\u6D77\u65B0\u901A\u9053\u4E2D\u5BEE\u6CF0\u9A6C\u8DE8\u5883\u94C1\u8DEF\u73ED\u5217\uFF0C\u4ECA\u65E5\u4E3E\u884C\u9996\u53D1\u4EEA\u5F0F\uFF0C\u5168\u7A0B\u53EA\u97009\u5929\uFF0C\u9884\u8BA1\u53EF\u4E3A\u8FDB\u51FA\u53E3\u4E1A\u8005\u8282\u7701\u81F3\u5C1120%\u8FD0\u8F93\u6210\u672C\u3002\u003C/p\u003E\n\u003Cp\u003E\u4EA4\u901A\u90E8\u957F\u9646\u5146\u798F\u6307\u51FA\uFF0C\u8FD9\u9879\u7531\u6765\u81EA4\u4E2A\u56FD\u5BB6\u76F8\u5173\u5355\u4F4D\u53CA\u4E1A\u8005\u7684\u5408\u4F5C\u6DF1\u5177\u610F\u4E49\uFF0C\u9996\u5148\u4E3A\u53EF\u6269\u5927\u9A6C\u4E2D\u4E24\u56FD\u8D38\u6613\uFF0C\u5176\u6B21\u4E3A\u6211\u56FD\u4E0E\u6CF0\u56FD\u53CA\u5BEE\u56FD\u7684\u6E05\u5173\u7AD9\u6210\u529F\u8FBE\u81F4\u5408\u4F5C\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u4E1C\u76DF\u7279\u5FEB\u5217\u8F66\uFF08ASEAN Express\uFF09\u63D0\u4F9B\u4E86\u6BD4\u4F20\u7EDF\u8DEF\u7EBF\u66F4\u5FEB\u7684\u66FF\u4EE3\u65B9\u6848\uFF0C\u4ECE\uFF08\u96EA\u5DDE\uFF09Kontena Nasional\u6E05\u5173\u7AD9(KNICD) \u5230\u91CD\u5E86\u6240\u9700\u65F6\u95F4\u4E3A9\u5929\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6307\u51FA\uFF0C\u82E5\u662F\u901A\u8FC7\u6D77\u8FD0\uFF0C\u5176\u6240\u9700\u65F6\u95F4\u4ECB\u4E8E14\u81F321\u5929\uFF1B\u82E5\u4E0E\u516C\u8DEF\u8FD0\u8F93\u76F8\u6BD4\uFF0C\u94C1\u8DEF\u8FD0\u8F93\u7684\u78B3\u8DB3\u8FF9\u4E5F\u663E\u7740\u964D\u4F4E\u3002\u003C/p\u003E\n\u003Cp\u003E\u9646\u5146\u798F\u5728\u9646\u6D77\u65B0\u901A\u9053\u4E2D\u5BEE\u6CF0\u9A6C\u8DE8\u5883\u94C1\u8DEF\u73ED\u5217\uFF08\u5927\u9A6C\u96EA\u5170\u83AA-\u6CF0\u56FD\u66FC\u8C37-\u5BEE\u56FD\u4E07\u8C61-\u4E2D\u56FD\u91CD\u5E86\uFF09\u53CC\u5411\u53D1\u8F66\u4EEA\u5F0F\u81F4\u8BCD\u65F6\uFF0C\u8FD9\u4E48\u8BF4\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u6210\u672C\u8F83\u4F4E\u7684\u539F\u56E0\u662F\u4E0A\u8FF0\u670D\u52A1\u5C5E\u4E8E\u5355\u4E00\u6A21\u5F0F\u6027\u8D28\uFF0C\u5373\u76F4\u63A5\u4ECE\u70B9\u5230\u70B9\u8FD0\u9001\u8D27\u7269\uFF0C\u8FD9\u4E0E\u7ED3\u5408\u5361\u8F66\u8FD0\u8F93\u3001\u822A\u8FD0\u548C\u94C1\u8DEF\u670D\u52A1\u7684\u591A\u79CD\u8FD0\u8F93\u6A21\u5F0F\u4E0D\u540C\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8868\u793A\uFF0C\u8FD0\u8F93\u65F6\u95F4\u51CF\u5C11\u53EF\u663E\u8457\u5E26\u6765\u6539\u53D8\uFF0C\u5305\u62EC\u53EF\u6269\u5927\u5BB9\u6613\u8150\u70C2\u5546\u54C1\u5982\u519C\u4EA7\u54C1\u7684\u5E02\u573A\u3002\u003C/p\u003E\n\u003Cp\u003E\u9646\u5146\u798F\u8865\u5145\uFF0C\u6211\u56FD\u4E0E\u4E2D\u6CF0\u5BEE\u7684\u94C1\u8DEF\u673A\u6784\u5408\u4F5C\uFF0C\u4E0D\u4F46\u53EF\u4FC3\u8FDB\u8D27\u8FD0\u6D41\u901A\uFF0C\u4E5F\u5C06\u63A8\u52A8\u7ECF\u6D4E\u589E\u957F\uFF0C\u5E76\u52A0\u5F3A\u4E1C\u76DF\u56FD\u5BB6\u4E4B\u95F4\u7684\u8D38\u6613\u5173\u7CFB\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u56FD\u5C06\u5229\u7528\u6218\u7565\u5408\u4F5C\u4F19\u4F34\u7684\u4F18\u52BF\uFF0C\u63D0\u4F9B\u66F4\u5FEB\u548C\u66F4\u9AD8\u6548\u7684\u8FD0\u8F93\u89E3\u51B3\u65B9\u6848\uFF0C\u4ECE\u800C\u63D0\u9AD8\u5168\u7403\u7ADE\u4E89\u529B\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4E1C\u76DF\u7279\u5FEB\u5217\u8F66\u662F\u7531\u9A6C\u6765\u4E9A\u94C1\u9053\u516C\u53F8\u63A8\u51FA\u7684\u8DE8\u5883\u8D27\u8FD0\u5217\u8F66\u670D\u52A1\u3002\u4ECE\u96EA\u5DDE\u81F3\u91CD\u5E86\u7684\u65B0\u670D\u52A1\uFF0C\u5C06\u4EE5\u96EA\u5DDE\u53CC\u6EAA\u5A01\u7684Kontena Nasional\u6E05\u5173\u7AD9(KNICD)\u3001\u73BB\u7483\u5E02\u6E05\u5173\u7AD9\u3001\u6CF0\u56FD\u53FB\u7532\u633D\u53BF\u6E05\u5173\u7AD9\u548C\u5BEE\u56FD\u5854\u7EB3\u6881\u6E05\u5173\u7AD9\u4F5C\u4E3A\u67A2\u7EBD\u3002\u003C/p\u003E\n\u003Cp\u003E\u4FC4\u901A\u793E\u4E0A\u4E2A\u67088\u65E5\u62A5\u9053\uFF0C\u4ECE\u4E2D\u56FD\u5230\u9A6C\u6765\u897F\u4E9A\u7684\u9996\u5217\u201C\u4E2D\u5BEE\u6CF0\u9A6C\u201D\u5217\u8F66\u4E8E4\u670830\u65E5\u53D1\u8F66\uFF0C\u9996\u6B21\u5B9E\u73B0\u4E2D\u56FD\u51FA\u53E3\u5927\u9A6C\u7684\u8D27\u7269\u5168\u94C1\u8FD0\u8F93\u76F4\u8FBE\uFF0C\u4E14\u4E0E\u6D77\u8FD0\u76F8\u6BD4\uFF0C\u8DEF\u4E0A\u8FD0\u8F93\u65F6\u95F4\u7F29\u77ED\u4E00\u534A\u3002\u003C/p\u003E\n\u003Cp\u003E\u8BE5\u5217\u8F66\u6CBF\u94C1\u8DEF\u5FEB\u7EBF\u4ECE\u4E2D\u56FD\u56DB\u5DDD\u81F3\u4E91\u5357\u6606\u660E\uFF0C\u6CBF\u4E2D\u5BEE\u94C1\u8DEF\u5230\u8FBE\u5BEE\u56FD\u9996\u90FD\u6C38\u73CD\uFF0C\u518D\u8F6C\u8F68\u6CF0\u56FD\u94C1\u8DEF\u5BEE\u56FD\u652F\u7EBF\uFF0C\u4ECE\u4E1C\u5317\u5411\u5357\uFF0C\u7A7F\u8D8A\u6574\u4E2A\u6CF0\u56FD\uFF0C\u76F4\u8FBE\u5927\u9A6C\u5DF4\u751F\u6E2F\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u6807\u5FD7\u6CDB\u4E9A\u94C1\u8DEF\u8BA1\u5212\u53EF\u671B\u83B7\u843D\u5B9E\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u9646\u5146\u798F\u8BF4\uFF0C\u672C\u6B21\u4ECE\u96EA\u5DDE\u81F3\u91CD\u5E86\u7684\u8DE8\u5883\u8D27\u8FD0\u65B0\u8DEF\u5F84\u4E5F\u6DF1\u5177\u610F\u4E49\uFF0C\u6807\u5FD7\u6CDB\u4E9A\u94C1\u8DEF\u8BA1\u5212\u53EF\u671B\u83B7\u843D\u5B9E\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6307\u51FA\uFF0C\u4E2D\u56FD\u603B\u7406\u674E\u5F3A\u4E0A\u5468\u540C\u610F\u6211\u56FD\u6B32\u5C06\u4E1C\u6D77\u5CB8\u94C1\u8DEF\u8BA1\u5212\uFF08ECRL\uFF09\u8854\u63A5\u81F3\u6CF0\u56FD\u3001\u5BEE\u56FD\u53CA\u4E2D\u56FD\u6606\u660E\u7684\u8BA1\u5212\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u4E00\u65E6\u4E1C\u94C1\u5B8C\u6210\u540E\uFF0C\u6211\u4EEC\u66F4\u8FDB\u4E00\u6B65\u63A5\u8FD1\u6211\u4EEC\u7684\u68A6\u60F3\uFF0C\u8FD8\u67092500\u516C\u91CC\u7684\u8DDD\u79BB\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u56FD\u5DF2\u5F00\u59CB\u4E0E\u6CF0\u56FD\u63A5\u89E6\uFF0C\u4EE5\u4FBF\u4E1C\u94C1\u65E5\u540E\u53EF\u4EE5\u8854\u63A5\u6CF0\u56FD\u56FD\u5BB6\u94C1\u8DEF\u516C\u53F8\uFF08SRT\uFF09\u7684\u94C1\u8DEF\u7F51\u7EDC\uFF0C\u76EE\u524D\u8BE5\u94C1\u8DEF\u5927\u591A\u6570\u4E3A\u5355\u8F68\u53CA\u5C1A\u672A\u7535\u52A8\u5316\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6307\u51FA\uFF0C\u901A\u8FC7\u9A6C\u4E2D\u4E24\u56FD\u90FD\u53EF\u53D1\u6325\u4F5C\u7528\u7684\u6295\u8D44\u53CA\u4E13\u624D\uFF0C\u4ECE\u65B0\u5C71\u81F3\u6606\u660E\u7684\u6CDB\u4E9A\u94C1\u8DEF\u53EF\u572810\u5E74\u5185\u5B8C\u6210\u3002\u003C/p\u003E\n\u003Cp\u003E\u636E\u9A6C\u6765\u4E9A\u94C1\u9053\u516C\u53F8\u53D1\u5E03\u7684\u6587\u544A\uFF0C\u8BE5\u516C\u53F8\u8BA1\u5212\u6BCF\u5468\u5F00\u884C\u4E24\u8D9F\u4E1C\u76DF\u7279\u5FEB\u5217\u8F66\u53CA\u6BCF\u8D9F\u8FD0\u8F7D40\u4E2A\u8D27\u67DC\uFF0C\u7136\u540E\u518D\u9010\u6B65\u589E\u52A0\u5230\u6BCF\u65E5\u53D1\u8F66\u3002\u003C/p\u003E\n\u003Cp\u003E\u6B64\u5916\uFF0C\u672C\u6B21\u6D3B\u52A8\u8FD8\u63A8\u4ECB\u4E86\u9996\u6B21\u4F7F\u7528\u672C\u5730\u5236\u9020\u7684\u673A\u8F66\u548C\u8F66\u53A2\u7684\u201C\u6309\u4F7F\u7528\u4ED8\u8D39\u201D\u670D\u52A1\u3002\u8FD9\u4E9B\u5217\u8F66\u662F\u7531SMH Rail\u79C1\u4EBA\u6709\u9650\u516C\u53F8\u63D0\u4F9B\uFF0C\u5E76\u7531\u9A6C\u6765\u4E9A\u94C1\u9053\u516C\u53F8\u79DF\u8D41\u3002\u003C/p\u003E\n\u003Cp\u003E\u51FA\u5E2D\u5609\u5BBE\u5305\u62EC\u4E2D\u56FD\u9A7B\u9A6C\u5927\u4F7F\u6B27\u9633\u7389\u9756\uFF0C\u6CF0\u56FD\u9A7B\u9A6C\u5927\u4F7F\u62C9\u8FBE\u666E\u739B\u3001\u5BEE\u56FD\u516C\u4F7F\u8854\u53C2\u8D5E\u4F69\u7EF4\u62C9\u5360\u3001\u9A6C\u6765\u4E9A\u94C1\u9053\u516C\u53F8\u603B\u6267\u884C\u957F\u62FF\u7763\u83AB\u54C8\u672B\u62C9\u5C3C\u3001Kontena Nasional\u6709\u9650\u516C\u53F8\u4E3B\u5E2D\u4E39\u65AF\u91CC\u4EC4\u5361\u7ACB\u3001SMH Rail\u516C\u53F8\u4E3B\u5E2D\u517C\u8463\u4E8B\u7ECF\u7406\u7EB3\u62C9\u3001\u9646\u6D77\u65B0\u901A\u9053\u8FD0\u8425\u6709\u9650\u516C\u53F8\u4E3B\u5E2D\u5218\u6CF0\u5E73\uFF08\u8BD1\u97F3\uFF09\u53CA\u4E1C\u5357\u4E9ASavan DP World\u6267\u884C\u526F\u4E3B\u5E2D\u5E0C\u7EF4\u5C14\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/_r9_AbeG8uuImTnxP8O-tg\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
