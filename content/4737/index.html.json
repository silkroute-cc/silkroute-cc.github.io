{
  "id": "%e7%95%99%e5%ad%a6%e5%9b%bd%e9%99%85%e7%94%9f%e6%b8%90%e5%a2%9e-%e5%a4%a7%e9%a9%ac2035%e6%9c%89%e6%9c%9b%e6%88%90%e5%ad%a6%e6%9c%af%e5%bc%ba%e5%9b%bd",
  "slug": "%e7%95%99%e5%ad%a6%e5%9b%bd%e9%99%85%e7%94%9f%e6%b8%90%e5%a2%9e-%e5%a4%a7%e9%a9%ac2035%e6%9c%89%e6%9c%9b%e6%88%90%e5%ad%a6%e6%9c%af%e5%bc%ba%e5%9b%bd",
  "canonicalUrlKey": "%e7%95%99%e5%ad%a6%e5%9b%bd%e9%99%85%e7%94%9f%e6%b8%90%e5%a2%9e-%e5%a4%a7%e9%a9%ac2035%e6%9c%89%e6%9c%9b%e6%88%90%e5%ad%a6%e6%9c%af%e5%bc%ba%e5%9b%bd",
  "route": "/4737/",
  "title": "\u7559\u5B66\u56FD\u9645\u751F\u6E10\u589E \u5927\u9A6C2035\u6709\u671B\u6210\u5B66\u672F\u5F3A\u56FD",
  "summary": "\u5361\u5E0C\u592B\uFF08\u53D6\u81EA\u5361\u5E0C\u592Blinkedin\uFF09 \uFF08\u5409\u9686\u576114\u65E5\u8BAF\uFF09\u6700\u65B0\u8C03\u67E5\u663E\u793A\uFF0C\u5728\u5168\u7403\u5B66\u751F\u6570\u91CF\u589E\u591A\u53CA\u6765\u9A6C\u7559\u5B66\u7684\u56FD\u9645\u5B66\u751F\u4EBA\u6570\u6E10\u589E\u7684\u8D8B\u52BF\u4E0B\uFF0C\u6211\u56FD\u6709\u671B\u57282035\u5E74\u6210\u4E3A\u56FD\u9645\u5B66\u672F\u5F3A\u56FD\u3002 \u5C45\u5916IQI\u96C6\u56E2\u8054\u5408\u521B\u59CB\u4EBA\u517C\u603B\u6267\u884C\u957F\u5361\u5E0C\u592B\u6307\u51FA\uFF0C\u968F\u7740\u6325\u522B\u51A0\u75C5\u75AB\u60C5\uFF0C\u6765\u9A6C\u7559\u5B66\u7684\u6D77\u5916\u4E2D\u5B66\u751F\u548C\u5927\u5B66\u751F\u5DF2\u8D8A\u6765\u8D8A\u591A\uFF0C\u6570\u636E\u663E\u793A\uFF0C\u6211\u56FD\u4E00\u5E74\u53EF\u8FCE\u6765\u7EA612\u4E075000\u540D\u56FD\u9645\u5B66\u751F\u3002 \u4ED6\u8BF4\uFF0C\u5176\u4E2D\uFF0C\u5927\u7EA670%\u7684\u56FD\u9645\u5B66\u751F\u5728\u79C1\u7ACB\u9AD8\u7B49\u6559\u80B2\u673A\u6784\u5347\u5B66\uFF0C\u5176\u4F59\u5219\u5728\u653F\u5E9C\u5927\u5B66\u548C\u4E2D\u5B66\u5C31\u8BFB\u3002 \u201C\u6839\u636E\u6559\u80B2\u90E8\u7684\u6570\u636E\uFF0C\u5728\u6211\u56FD\u9AD8\u7B49\u5B66\u5E9C\u63A5\u53D7\u6559\u80B2\u7684\u5B66\u751F\u4E2D\uFF0C\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/05/frc-e4d2c7355b394f66fd4b5af62c5e48c0.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5361\u5E0C\u592B\uFF08\u53D6\u81EA\u5361\u5E0C\u592Blinkedin\uFF09\u003C/p\u003E\n\u003Cp\u003E\uFF08\u5409\u9686\u576114\u65E5\u8BAF\uFF09\u6700\u65B0\u8C03\u67E5\u663E\u793A\uFF0C\u5728\u5168\u7403\u5B66\u751F\u6570\u91CF\u589E\u591A\u53CA\u6765\u9A6C\u7559\u5B66\u7684\u56FD\u9645\u5B66\u751F\u4EBA\u6570\u6E10\u589E\u7684\u8D8B\u52BF\u4E0B\uFF0C\u6211\u56FD\u6709\u671B\u57282035\u5E74\u6210\u4E3A\u56FD\u9645\u5B66\u672F\u5F3A\u56FD\u3002\u003C/p\u003E\n\u003Cp\u003E\u5C45\u5916IQI\u96C6\u56E2\u8054\u5408\u521B\u59CB\u4EBA\u517C\u603B\u6267\u884C\u957F\u5361\u5E0C\u592B\u6307\u51FA\uFF0C\u968F\u7740\u6325\u522B\u51A0\u75C5\u75AB\u60C5\uFF0C\u6765\u9A6C\u7559\u5B66\u7684\u6D77\u5916\u4E2D\u5B66\u751F\u548C\u5927\u5B66\u751F\u5DF2\u8D8A\u6765\u8D8A\u591A\uFF0C\u6570\u636E\u663E\u793A\uFF0C\u6211\u56FD\u4E00\u5E74\u53EF\u8FCE\u6765\u7EA612\u4E075000\u540D\u56FD\u9645\u5B66\u751F\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u5176\u4E2D\uFF0C\u5927\u7EA670%\u7684\u56FD\u9645\u5B66\u751F\u5728\u79C1\u7ACB\u9AD8\u7B49\u6559\u80B2\u673A\u6784\u5347\u5B66\uFF0C\u5176\u4F59\u5219\u5728\u653F\u5E9C\u5927\u5B66\u548C\u4E2D\u5B66\u5C31\u8BFB\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6839\u636E\u6559\u80B2\u90E8\u7684\u6570\u636E\uFF0C\u5728\u6211\u56FD\u9AD8\u7B49\u5B66\u5E9C\u63A5\u53D7\u6559\u80B2\u7684\u5B66\u751F\u4E2D\uFF0C\u6709\u8FD16%\u7684\u5B66\u751F\u662F\u6765\u81EA\u6D77\u5916\u7684\u56FD\u9645\u5B66\u751F\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u5361\u5E0C\u592B\u8868\u793A\uFF0C\u6839\u636E\u8054\u5408\u56FD\u6559\u79D1\u6587\u7EC4\u7EC7\u7684\u6570\u636E\uFF0C\u8FC7\u53BB20\u5E74\u91CC\uFF0C\u51FA\u56FD\u7559\u5B66\u7684\u56FD\u9645\u5B66\u751F\u4EBA\u6570\u51E0\u4E4E\u589E\u52A0\u4E86\u4E24\u500D\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u4E2D\u56FD\u662F\u4E16\u754C\u7B2C\u4E00\u5927\u7559\u5B66\u751F\u6765\u6E90\u56FD\uFF0C\u4F46\u5176\u4ED6\u56FD\u5BB6\u7684\u7559\u5B66\u751F\u4E5F\u4E0D\u5C11\uFF0C\u968F\u7740\u4EBA\u4EEC\u7684\u8D22\u5BCC\u4E0D\u65AD\u589E\u52A0\uFF0C\u51FA\u56FD\u7559\u5B66\u7684\u8D8B\u52BF\u5DF2\u65E5\u6E10\u589E\u5F3A\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BA4\u4E3A\uFF0C\u82E5\u76EE\u524D\u7684\u8D8B\u52BF\u6301\u7EED\u4E0B\u53BB\uFF0C\u52302040\u5E74\uFF0C\u4F30\u8BA1\u6BCF\u5E74\u5C06\u67091200\u4E07\u540D\u5927\u5B66\u751F\u79BB\u4E61\u80CC\u4E95\u5230\u5176\u4ED6\u56FD\u5BB6\u7559\u5B66\uFF0C\u662F\u73B0\u9636\u6BB5630\u4E07\u4EBA\u7684\u53CC\u500D\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6839\u636ET.I.M.E.\u7684\u56FD\u9645\u5B66\u751F\u6D41\u52A8\u6027\u6982\u89C8\u5168\u7403\u5206\u6790\uFF0C\u52302050\u5E74\uFF0C\u5168\u740320\u5C81\u81F324\u5C81\u7684\u5E74\u8F7B\u4EBA\u603B\u6570\u5C06\u8FBE\u52306\u4EBF6500\u4E07\u4EBA\uFF0C\u5176\u4E2D\uFF0C4\u4EBF\u4EBA\u5C06\u662F\u5927\u5B66\u751F\u3002 \u003C/p\u003E\n\u003Cp\u003E\u201C\u8FD9\u5C06\u8BA9\u5927\u9A6C\u83B7\u76CA\u532A\u6D45\uFF0C\u5BF9\u4E8E\u90A3\u4E9B\u76EE\u524D\u5DF2\u5411\u6211\u56FD\u8F93\u9001\u4E86\u5927\u91CF\u5B66\u751F\u7684\u56FD\u5BB6\uFF0C\u5C06\u6765\u6D8C\u5165\u6211\u56FD\u5347\u5B66\u7684\u7559\u5B66\u751F\u4EBA\u6570\u5FC5\u4F1A\u5927\u589E\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u5361\u5E0C\u592B\u6307\u51FA\uFF0C\u5927\u9A6C\u6B63\u5728\u52AA\u529B\u5B9E\u73B0\u4E00\u4E2A\u957F\u671F\u76EE\u6807\uFF0C\u5373\u52302025\u5E74\u5C06\u56FD\u9645\u5B66\u751F\u4EBA\u6570\u589E\u81F325\u4E07\u4EBA\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u867D\u7136\u65E0\u6CD5\u4E0E\u7F8E\u56FD\u7B49\u5927\u56FD\u7684\u89C4\u6A21\u5AB2\u7F8E\uFF0C\u4F46\u8FD110\u5E74\u6765\uFF0C\u5927\u9A6C\u4E00\u76F4\u662F\u53D7\u6B22\u8FCE\u7684\u6559\u80B2\u76EE\u7684\u5730\uFF0C\u65E9\u57282015\u5E74\uFF0C\u5927\u9A6C\u7684\u56FD\u9645\u65B0\u751F\u5165\u5B66\u4EBA\u6570\u5C31\u5DF2\u6392\u540D\u4E16\u754C\u7B2C8\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u900F\u9732\uFF0C\u6570\u636E\u663E\u793A\uFF0C\u6211\u56FD\u76845\u5927\u56FD\u9645\u5B66\u751F\u6765\u6E90\u5E02\u573A\u4F9D\u5E8F\u662F\u4E2D\u56FD\u3001\u5370\u5C3C\u3001\u5B5F\u52A0\u62C9\u3001\u5370\u5EA6\u548C\u5C3C\u65E5\u5229\u4E9A\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u56FD\u53EF\u5360\u9886\u66F4\u591A\u5E02\u573A\u4EFD\u989D\uFF0C\u56E0\u4E3A\u6211\u56FD\u5BF9\u4E2D\u56FD\u548C\u5C3C\u65E5\u5229\u4E9A\u5B66\u751F\u7684\u5438\u5F15\u529B\u8D8A\u6765\u8D8A\u5927\uFF0C\u6211\u4EEC\u5177\u5907\u4F18\u52BF\uFF0C\u56E0\u4E3A\u8FD9\u91CC\u7684\u751F\u6D3B\u6210\u672C\u6BD4\u65E5\u672C\u548C\u65B0\u52A0\u5761\u4F4E\u3001\u8BF4\u534E\u8BED\u7684\u4EBA\u53E3\u6BD4\u65E5\u672C\u591A\u3001\u73AF\u5883\u6BD4\u6CF0\u56FD\u76F8\u5BF9\u5B89\u5168\uFF0C\u800C\u9A6C\u6765\u897F\u4E9A\u6211\u7684\u7B2C\u4E8C\u5BB6\u56ED\u8BA1\u5212\uFF08MM2H\uFF09\uFF0C\u5219\u662F\u53E6\u4E00\u4E2A\u91CD\u8981\u4FBF\u5229\u56E0\u7D20\u3002\u201D\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/05/frc-b59661852d87e1a3c106e20d8e30b592.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003EAppliedHE\u4E1C\u76DF\u653F\u5E9C\u548C\u79C1\u7ACB\u5927\u5B66\u6392\u540D\nUKM\u548C\u53CC\u5A01\u5927\u5B66\u5206\u5217\u699C\u9996\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u5361\u5E0C\u592B\u63D0\u53CA\uFF0C\u6211\u56FD\u9AD8\u7B49\u5B66\u5E9C\u5728AppliedHE\u4E1C\u76DF\u653F\u5E9C\u5927\u5B66\u548C\u79C1\u7ACB\u5927\u5B66\u6392\u540D\u4E2D\u540D\u5217\u524D\u8305\uFF0C\u5176\u4E2D\uFF0C\u9A6C\u6765\u897F\u4E9A\u56FD\u7ACB\u5927\u5B66\uFF08UKM\uFF09\u548C\u53CC\u5A01\u5927\u5B66\uFF08Sunway University\uFF09\u66F4\u662F\u5206\u5217\u699C\u9996\u4F4D\u7F6E\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u5728\u6392\u540D\u6700\u9AD8\u768410\u6240\u4E1C\u76DF\u653F\u5E9C\u5927\u5B66\u4E2D\uFF0C\u5927\u9A6C\u5360\u636E4\u5E2D\uFF0C\u800C\u5728\u6392\u540D\u6700\u9AD8\u768410\u6240\u4E1C\u76DF\u79C1\u7ACB\u5927\u5B66\u4E2D\uFF0C\u5927\u9A6C\u5219\u636E\u53606\u5E2D\uFF0C\u8FD9\u663E\u793A\u6211\u56FD\u7684\u9AD8\u7B49\u6559\u80B2\u9886\u57DF\u5177\u6709\u56FD\u9645\u7ADE\u4E89\u529B\uFF0C\u6DF1\u53D7\u6D77\u5916\u5B66\u751F\u6B22\u8FCE\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6307\u51FA\uFF0C\u56FD\u9645\u5B66\u751F\u5BF9\u6211\u56FD\u7ECF\u6D4E\u521B\u9020\u51FA\u7684\u4EF7\u503C\u751A\u81F3\u6BD4\u6E38\u5BA2\u8FD8\u8981\u9AD8\uFF0C\u6839\u636E\u6559\u80B2\u90E8\u6570\u636E\uFF0C\u5F53\u6211\u56FD\u5B9E\u73B0\u6BCF\u5E74\u62DB\u653625\u4E07\u540D\u56FD\u9645\u5B66\u751F\u7684\u76EE\u6807\u65F6\uFF0C\u5373\u53EF\u4E3A\u6211\u56FD\u5E26\u6765160\u4EBF\u4EE4\u5409\u7684\u989D\u5916\u6536\u5165\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6BCF\u4F4D\u56FD\u9645\u5B66\u751F\u6BCF\u5E74\u7684\u82B1\u8D39\u4F30\u8BA1\u4E3A4\u4E076000\u4EE4\u5409\uFF0C\u5982\u679C\u6709\u5BB6\u5C5E\u966A\u4F34\uFF0C\u5219\u6BCF\u5E74\u82B1\u8D398\u4E078000\u4EE4\u5409\uFF0C\u9664\u4E86\u4FC3\u8FDB\u7ECF\u6D4E\uFF0C\u56FD\u9645\u5B66\u751F\u8FD8\u521B\u9020\u6587\u5316\u4EA4\u6D41\u5E76\u5EFA\u7ACB\u56FD\u5BB6\u4E4B\u95F4\u7684\u8DE8\u5883\u8054\u7CFB\uFF0C\u8FD9\u4E9B\u5173\u7CFB\u5728\u60C5\u611F\u4E0A\u548C\u7ECF\u6D4E\u4E0A\u90FD\u4E30\u5BCC\u4E86\u6211\u4EEC\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/r32oryKZuM-YriqQYMUf7A\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
