  "title": "\u5927\u9A6C\u9996\u4E09\u5B63\u83B7\u62791937\u4EBF\u53472.5%  \u6CE8\u610F\u5206\u6790\u5305\u542B\u7684\u9879\u76EE\u4FE1\u606F",
  "summary": "\u9A6C\u6765\u897F\u4E9A\u6295\u8D44\u53D1\u5C55\u5C40\uFF08MIDA\uFF09\u516C\u5E03\u6211\u56FD\u5728\u4ECA\u5E74\u99969\u4E2A\u6708\u53D6\u5F971937\u4EBF\u4EE4\u5409\uFF08\u7EA6417\u4EBF\u7F8E\u5143\uFF09\u7684\u83B7\u6279\u6295\u8D44\u989D\uFF0C\u76F8\u6BD4\u53BB\u5E74\u540C\u671F\u589E\u957F2.5%\uFF0C\u8BC1\u660E\u5927\u9A6C\u4ECD\u662F\u6295\u8D44\u8005\u7684\u70ED\u95E8\u9009\u62E9\u3002 \u56FD\u9645\u8D38\u6613\u53CA\u5DE5\u4E1A\u90E8\u957F\u62FF\u7763\u65AF\u91CC\u4E1C\u59D1\u624E\u592B\u9C81\u6307\u51FA\uFF0C\u5F3A\u5927\u4F9B\u5E94\u94FE\u3001\u5177\u6709\u7ADE\u4E89\u529B\u7684\u6210\u672C\u7ED3\u6784\u3001\u7CBE\u7B80\u4E1A\u52A1\u6D41\u7A0B\u3001\u5C16\u7AEF\u521B\u65B0\u4E0E\u6280\u672F\u548C\u4F18\u79C0\u4EBA\u624D\uFF0C\u662F\u6211\u56FD\u5438\u5F15\u6295\u8D44\uFF0C\u63A8\u52A8\u53EF\u6301\u7EED\u589E\u957F\u7684\u5173\u952E\u56E0\u7D20\u3002 \u201C\u6211\u4EEC\u653E\u773C\u672A\u6765\uFF0C\u786E\u4FDD\u65B0\u6295\u8D44\u673A\u4F1A\u5C06\u5728\u76EE\u6807\u9886\u57DF\u5EFA\u8BBE\u80FD\u529B\u548C\u4EBA\u624D\uFF0C\u6301\u7EED\u53D1\u5C55\u56FD\u5BB6\u7ECF\u6D4E\u3002\u201D \u4E2D\u56FD492\u4EBF\u5C45\u9996 \u5916\u6765\u76F4\u63A5\u6295\u8D44 \uFF08FDI\uFF09\u4EE51307\u4EBF\u4EE4\u5409\u6210\u4E3A\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2022/12/frc-15417c2e105b14e03f8f114978712b45.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u6295\u8D44\u53D1\u5C55\u5C40\uFF08MIDA\uFF09\u516C\u5E03\u6211\u56FD\u5728\u4ECA\u5E74\u99969\u4E2A\u6708\u53D6\u5F971937\u4EBF\u4EE4\u5409\uFF08\u7EA6417\u4EBF\u7F8E\u5143\uFF09\u7684\u83B7\u6279\u6295\u8D44\u989D\uFF0C\u76F8\u6BD4\u53BB\u5E74\u540C\u671F\u589E\u957F2.5%\uFF0C\u8BC1\u660E\u5927\u9A6C\u4ECD\u662F\u6295\u8D44\u8005\u7684\u70ED\u95E8\u9009\u62E9\u3002\u003C/p\u003E\n\u003Cp\u003E\u56FD\u9645\u8D38\u6613\u53CA\u5DE5\u4E1A\u90E8\u957F\u62FF\u7763\u65AF\u91CC\u4E1C\u59D1\u624E\u592B\u9C81\u6307\u51FA\uFF0C\u5F3A\u5927\u4F9B\u5E94\u94FE\u3001\u5177\u6709\u7ADE\u4E89\u529B\u7684\u6210\u672C\u7ED3\u6784\u3001\u7CBE\u7B80\u4E1A\u52A1\u6D41\u7A0B\u3001\u5C16\u7AEF\u521B\u65B0\u4E0E\u6280\u672F\u548C\u4F18\u79C0\u4EBA\u624D\uFF0C\u662F\u6211\u56FD\u5438\u5F15\u6295\u8D44\uFF0C\u63A8\u52A8\u53EF\u6301\u7EED\u589E\u957F\u7684\u5173\u952E\u56E0\u7D20\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u4EEC\u653E\u773C\u672A\u6765\uFF0C\u786E\u4FDD\u65B0\u6295\u8D44\u673A\u4F1A\u5C06\u5728\u76EE\u6807\u9886\u57DF\u5EFA\u8BBE\u80FD\u529B\u548C\u4EBA\u624D\uFF0C\u6301\u7EED\u53D1\u5C55\u56FD\u5BB6\u7ECF\u6D4E\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u4E2D\u56FD492\u4EBF\u5C45\u9996\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u5916\u6765\u76F4\u63A5\u6295\u8D44 \uFF08FDI\uFF09\u4EE51307\u4EBF\u4EE4\u5409\u6210\u4E3A\u4E3B\u8981\u8D21\u732E\uFF0867.5%\uFF09\uFF0C\u76F8\u6BD4\u53BB\u5E74\u540C\u671F\u589E\u957F15%\uFF0C\u4E2D\u56FD\u4EE5492\u4EBF\u4EE4\u5409\u5360\u636E\u699C\u9996\uFF0C\u5176\u6B21\u4E3A\u7F8E\u56FD\u3001\u8377\u5170\u3001\u5FB7\u56FD\u548C\u65B0\u52A0\u5761\u3002\u56FD\u5185\u76F4\u63A5\u6295\u8D44\uFF08DDI\uFF09\u5219\u6709630\u4EBF\u4EE4\u5409\uFF0832.5%\uFF09\u3002\u524D\u4E94\u5DDE\u5C5E\u5206\u522B\u4E3A\u67D4\u4F5B\u3001\u5409\u9686\u5761\u3001\u96EA\u5170\u83AA\u3001\u7802\u62C9\u8D8A\u548C\u5409\u6253\u3002\u003C/p\u003E\n\u003Cp\u003E\u5176\u4E2D\uFF0C\u670D\u52A1\u4E1A\u662F\u63A8\u52A8\u7ECF\u6D4E\u590D\u82CF\u7684\u91CD\u8981\u9F7F\u8F6E\uFF0C\u4EE51133\u4EBF\u4EE4\u5409\u5360\u603B\u989D\u768458.5%\uFF0C\u5236\u9020\u4E1A\u548C\u521D\u7EA7\u4EA7\u4E1A\u5206\u522B\u4EE5649 \u4EBF\u4EE4\u5409\uFF0833.5%\uFF09\u548C155 \u4EBF\u4EE4\u5409\uFF088%\uFF09\u7D27\u968F\u5176\u540E\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2022/12/frc-456fab2800bb7dc9572dd3b790c78c19.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u4E0B\u4E2A\u4E3B\u8981\u7ECF\u6D4E\u4E2D\u5FC3\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u6295\u8D44\u53D1\u5C55\u5C40\u603B\u6267\u884C\u957F\u62FF\u7763\u5A01\u62C9\u963F\u7F55\u963F\u90FD\u62C9\u66FC\u8BF4\uFF0C\u5927\u9A6C\u51ED\u501F\u826F\u597D\u5546\u4E1A\u73AF\u5883\uFF0C\u6709\u671B\u6210\u4E3A\u4E0B\u4E00\u4E2A\u4E3B\u8981\u7ECF\u6D4E\u4E2D\u5FC3\uFF0C\u4E5F\u5C06\u5584\u7528\u9A6C\u516D\u7532\u6D77\u5CE1\u7684\u4F18\u8D8A\u4F4D\u7F6E\u3001\u5168\u9762\u5DE5\u4E1A\u751F\u6001\u7CFB\u7EDF\u3001\u4E30\u5BCC\u81EA\u7136\u8D44\u6E90\u4EE5\u53CA\u5E74\u8F7B\u6709\u624D\u7684\u4EBA\u529B\uFF0C\u63D0\u4F9B\u4F01\u4E1A\u5728\u56FD\u9645\u5E02\u573A\u4E0A\u6210\u529F\u7684\u6240\u9700\u6761\u4EF6\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u653F\u5E9C\u79EF\u6781\u4E3A\u5236\u9020\u4E1A\u548C\u670D\u52A1\u4E1A\u5438\u5F15\u66F4\u591A\u9AD8\u8D28\u91CF\u548C\u9AD8\u5F71\u54CD\u529B\u7684\u8D44\u672C\u5BC6\u96C6\u578B\u9879\u76EE\uFF0C\u5E76\u4E13\u6CE8\u5728\u6570\u5B57\u7ECF\u6D4E\u3001\u80FD\u6E90\u548C\u9AD8\u4EF7\u503C\u5236\u9020\u6D3B\u52A8\uFF0C\u5982\u8FD0\u8F93\u6280\u672F\u9886\u57DF\u7684\u7535\u52A8\u6C7D\u8F66\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u622A\u81F3\u4ECA\u5E7411\u6708\uFF0CMIDA\u603B\u503C199\u4EBF\u4EE4\u5409\u7684285\u4E2A\u6295\u8D44\u9879\u76EE\u4E2D\uFF0C247\u4E2A\u6765\u81EA\u670D\u52A1\u4E1A\uFF08137\u4EBF\u4EE4\u5409\uFF09\uFF0C38\u4E2A\u6765\u81EA\u5236\u9020\u4E1A\uFF0862 \u4EBF\u4EE4\u5409\uFF09\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u4E0E\u8D38\u5DE5\u90E8\u643A\u624B\u5438\u8D44\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003EMIDA\u4E0E\u56FD\u9645\u8D38\u6613\u53CA\u5DE5\u4E1A\u90E8\uFF08MITI\uFF09\u643A\u624B\u5438\u5F15\u5168\u7403\u6295\u8D44\u8005\uFF0C\u4EE5\u4FBF\u5347\u7EA7\u5DE5\u4E1A\u751F\u6001\u7CFB\u7EDF\u548C\u8D38\u6613\u683C\u5C40\uFF0C\u5B9E\u884C\u63AA\u65BD\u5305\u62EC\u63D0\u4F9B\u4E1A\u52A1\u4FBF\u5229\u548C\u4EF7\u503C\u94FE\u7F51\u7EDC\u3002\u003C/p\u003E\n\u003Cp\u003E\u653F\u5E9C\u5E0C\u671B\u52A9\u4F01\u4E1A\u6210\u529F\uFF0C\u4F7F\u6211\u56FD\u6210\u4E3A\u5546\u754C\u53D1\u6325\u5145\u5206\u6F5C\u529B\u7684\u5B9D\u5730\uFF0C\u540C\u65F6\u79EF\u6781\u53D1\u6398\u65B0\u9886\u57DF\uFF0C\u589E\u5F3A\u4F01\u4E1A\u548C\u793E\u533A\u80FD\u529B\uFF0C\u5728\u56FD\u5BB6\u6295\u8D44\u613F\u666F\uFF08NIA\uFF09\u4E4B\u4E0B\uFF0C\u575A\u6301\u8BDA\u4FE1\u3001\u5584\u6CBB\u548C\u6CD5\u6CBB\u539F\u5219\uFF0C\u4EE5\u53EF\u6301\u7EED\u53D1\u5C55\u76EE\u6807\u548C\u65B0\u6295\u8D44\u653F\u7B56\uFF08NIP\uFF09\u63A8\u52A8\u53D1\u5C55\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2022/12/frc-b6f211d0842e4e02e716ce344db3dcd0.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u670D\u52A1\u4E1A\u9065\u9065\u9886\u5148\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u4FE1\u606F\u901A\u4FE1\u4E3A\u4E3B\u5BFC\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u5927\u9A6C\u6570\u5B57\u5316\u8F6C\u578B\u84EC\u52C3\u53D1\u5C55\u4E2D\uFF0C\u7269\u8054\u7F51 \uFF08IoT\uFF09\u3001\u4EBA\u5DE5\u667A\u80FD \uFF08AI\uFF09 \u548C\u4E91\u8BA1\u7B97\u5F00\u542F\u65B0\u578B\u670D\u52A1\u7684\u5F53\u513F\uFF0C\u670D\u52A1\u4E1A\u4EE52167\u4E2A\u9879\u76EE\u8D21\u732E1133\u4EBF\u4EE4\u5409\uFF0C\u9884\u8BA1\u521B\u90203\u4E079772\u4E2A\u5DE5\u4F5C\u8BA1\u5212\uFF0C\u9886\u519B\u7ECF\u6D4E\u53D1\u5C55\u3002\u003C/p\u003E\n\u003Cp\u003E\u5916\u6765\u6295\u8D44\u5728\u524D\u4E09\u5B63\u5EA6\u8FBE\u5230690\u4EBF\u4EE4\u5409\uFF0C\u5728\u8FD9\u4E4B\u4E2D\uFF0C\u4FE1\u606F\u901A\u4FE1\u884C\u4E1A\u89C4\u6A21\u6700\u58EE\u5927\uFF0C\u6279\u51C6\u6295\u8D44\u989D\u8FBE692\u4EBF\u4EE4\u5409\u3002\u003C/p\u003E\n\u003Cp\u003E\u5176\u4ED6\u8868\u73B0\u826F\u597D\u7684\u884C\u4E1A\u5305\u62EC\u623F\u5730\u4EA7\uFF08169\u4EBF\u4EE4\u5409\uFF09\u3001\u91D1\u878D\u670D\u52A1\uFF0890\u4EBF\u4EE4\u5409\uFF09\u3001\u516C\u7528\u4E8B\u4E1A\uFF0875\u4EBF\u4EE4\u5409 \uFF09\u548C\u5206\u9500\u8D38\u6613\uFF0837\u4EBF\u4EE4\u5409\uFF09\u3002\u003C/p\u003E\n\u003Cp\u003E\u6B64\u5916\uFF0C\u91CD\u70B9\u9879\u76EE\u5305\u62ECBridge Data Centres Malaysia III\u79C1\u4EBA\u6709\u9650\u516C\u53F8\u3001 ByteDance System\u79C1\u4EBA\u6709\u9650\u516C\u53F8\u548CYTL Power\u56FD\u9645\u6709\u9650\u516C\u53F8\u7684\u6570\u636E\u4E2D\u5FC3\uFF0C\u53CAMamee Double Decker Distribution (M) \u6709\u9650\u516C\u53F8\u7684\u533A\u57DF\u603B\u90E8\u4E2D\u5FC3\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2022/12/frc-b82f06e34df74400f1e60e19d088e78f.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5236\u9020\u4E1A\u7EF4\u6301\u5F3A\u5927\u7ADE\u4E89\u529B\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u5236\u9020\u4E1A\u5728\u524D\u4E09\u5B63\u5EA6\u83B7\u5F97649\u4EBF\u4EE4\u5409\u7684\u6279\u51C6\u6295\u8D44\u989D\uFF0C\u5916\u6765\u6295\u8D44\u8FBE502\u4EBF\u4EE4\u5409\uFF0C\u5176\u4E2D\u5C5E\u6269\u5F20\u6216\u591A\u5143\u5316\u9879\u76EE\u53D1\u5C55\u663E\u8457\uFF0C\u589E\u957F51%\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u4EBA\u529B\u8FDB\u9636\u9AD8\u5C42\u6B21\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u8868\u73B0\u4F18\u79C0\u7684\u884C\u4E1A\u4E3A\u7535\u6C14\u548C\u7535\u5B50\uFF08226\u4EBF\u4EE4\u5409\uFF09\u3001\u8FD0\u8F93\u8BBE\u5907\uFF0875\u4EBF\u4EE4\u5409\uFF09 \u3001\u77F3\u6CB9\u4EA7\u54C1\uFF0855\u4EBF\u4EE4\u5409\uFF09\u3001\u975E\u91D1\u5C5E\u77FF\u4EA7\uFF0854\u4EBF\u4EE4\u5409\uFF09\u3001\u673A\u68B0\u548C\u8BBE\u5907\uFF0840\u4EBF\u4EE4\u5409\uFF09\u7B49\u3002\u003C/p\u003E\n\u003Cp\u003E\u5236\u9020\u4E1A\u9884\u8BA1\u5E26\u67655\u4E078141\u4E2A\u5DE5\u4F5C\u673A\u4F1A\uFF0C\u5176\u4E2D\u67094.5%\u7BA1\u7406\u5C97\u4F4D\u300110.8%\u4E13\u4E1A\u6280\u672F\u6027\u548C\u76D1\u7763\u5C97\u4F4D\uFF0C\u8BF4\u660E\u5236\u9020\u4E1A\u8FCE\u6765\u66F4\u9AD8\u5C42\u6B21\u7684\u4EF7\u503C\u94FE\u8F6C\u578B\uFF0C\u5176\u4E2D\u83B7\u6279\u7684\u9879\u76EE\u8FD8\u970020.7%\u7684\u6280\u80FD\u5C31\u4E1A\u8005\u3002\u003C/p\u003E\n\u003Cp\u003E\u53E6\u5916\uFF0C\u7275\u6D89\u91CD\u70B9\u9879\u76EE\u7684\u4F01\u4E1A\u5305\u62ECSamsung SDI Energy Malaysia\u79C1\u4EBA\u6709\u9650\u516C\u53F8\u3001TF-AMD Microelectronics\u79C1\u4EBA\u6709\u9650\u516C\u53F8\u3001Ferrotec Holdings Corporation\u548CSmart Glove Holdings\u6709\u9650\u516C\u53F8\u3002\uFF08\u8D44\u8BAF\uFF09\u003C/p\u003E\n\u003Cp\u003E\n\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/PhhFsItNus3c6Byihi8RdQ\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
