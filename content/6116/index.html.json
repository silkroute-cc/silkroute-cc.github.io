  "title": "\u3010\u6559\u80B2\u3011\u4E2D\u9A6C\u535A\u58EB\u751F\u5171\u8BDD\u5171\u5EFA\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u9AD8\u8D28\u91CF\u53D1\u5C55\u51DD\u805A\u9752\u5E74\u5408\u4F5C\u5171\u8BC6",
  "summary": "\u7531\u4E9A\u592A\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u5171\u7B56\u4F1A\u4E3B\u529E\u3001\u4E2D\u56FD\u793E\u4F1A\u79D1\u5B66\u9662\u4FC4\u7F57\u65AF\u4E1C\u6B27\u4E2D\u4E9A\u7814\u7A76\u6240\u652F\u6301\u7684\u201C\u9A6C\u4E2D\u535A\u58EB\u751F\u77E5\u884C\u8BA1\u5212\u201D\u6D3B\u52A8\u65E5\u524D\u5728\u9A6C\u6765\u897F\u4E9A\u4E2D\u56FD\u8D38\u6613\u4FC3\u8FDB\u4E2D\u5FC3\u4E3E\u884C\u3002\u4E2D\u9A6C\u667A\u5E93\u4E13\u5BB6\u3001\u9AD8\u6821\u5B66\u8005\u4E0E41\u4F4D\u9A6C\u6765\u897F\u4E9A\u7C4D\u548C\u4E2D\u56FD\u7C4D\u535A\u58EB\u751F\u4EE3\u8868\uFF0C\u4EE5\u95EE\u7B54\u5F62\u5F0F\u56F4\u7ED5\u5171\u5EFA\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u9AD8\u8D28\u91CF\u53D1\u5C55\u3001\u533A\u57DF\u5730\u7F18\u7ECF\u6D4E\u53D8\u5316\u3001\u4E2D\u9A6C\u4EA7\u4E1A\u5408\u4F5C\u53CA\u9752\u5E74\u4EBA\u624D\u53D1\u5C55\u7B49\u8BAE\u9898\u5C55\u5F00\u4EA4\u6D41\u3002\u4E0E\u4F1A\u4E13\u5BB6\u5EFA\u8BAE\uFF0C\u9752\u5E74\u5B66\u8005\u53EF\u4ECE\u6D0B\u6D66\u6E2F\u8425\u5546\u73AF\u5883\u3001\u6D77\u5357\u4E0E\u7CA4\u6E2F\u6FB3\u5927\u6E7E\u533A\u8054\u52A8\u7B49\u5177\u4F53\u95EE\u9898\u5207\u5165\uFF0C\u7528\u597DRCEP\u6846\u67B6\u4E0B\u7684\u5408\u4F5C\u673A\u9047\uFF0C\u52A0\u5F3A\u53D1\u5C55\u6218\u7565\u5BF9\u63A5\uFF0C\u534F\u540C\u63A8\u52A8\u57FA\u7840\u8BBE\u65BD\u201C\u786C\u8054\u901A\u201D\u3001\u89C4\u5219\u6807\u51C6\u201C\u8F6F\u8054\u901A\u201D\u548C\u4EBA\u6C11\u4E4B\u95F4\u201C\u5FC3\u8054\u901A\u201D\u3002",
  "body": "\u003Cimg src=\u0022/assets/uploads/b3885a3f9d90097f7b5906eb92c5249576cd68955d466a67b10717d801213986.jpg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u7531\u4E9A\u592A\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u5171\u7B56\u4F1A\u4E3B\u529E\uFF0C\u9A6C\u6765\u897F\u4E9A\u4E2D\u56FD\u8D38\u6613\u4FC3\u8FDB\u4E2D\u5FC3\u4EBA\u624D\u3001\u9752\u5E74\u53CA\u6559\u80B2\u59D4\u5458\u4F1A\u627F\u529E\uFF0C\u4E2D\u56FD\u793E\u4F1A\u79D1\u5B66\u9662\u4FC4\u7F57\u65AF\u4E1C\u6B27\u4E2D\u4E9A\u7814\u7A76\u6240\u652F\u6301\u7684\u201C\u9A6C\u4E2D\u535A\u58EB\u751F\u77E5\u884C\u8BA1\u5212\u201D\u6D3B\u52A8\u65E5\u524D\u5728\u9A6C\u6765\u897F\u4E9A\u4E2D\u56FD\u8D38\u6613\u4FC3\u8FDB\u4E2D\u5FC3\u4E3E\u884C\u3002\u4E2D\u9A6C\u667A\u5E93\u4E13\u5BB6\u3001\u9AD8\u6821\u5B66\u8005\u4E0E\u9A6C\u6765\u897F\u4E9A\u4E2D\u56FD\u8D38\u6613\u4FC3\u8FDB\u4E2D\u5FC3\u535A\u58EB\u53D1\u5C55\u9662\u517141\u4F4D\u9A6C\u6765\u897F\u4E9A\u7C4D\u548C\u4E2D\u56FD\u7C4D\u535A\u58EB\u751F\u4EE3\u8868\uFF0C\u5168\u7A0B\u4EE5\u95EE\u7B54\u5F62\u5F0F\u56F4\u7ED5\u5171\u5EFA\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u9AD8\u8D28\u91CF\u53D1\u5C55\u3001\u533A\u57DF\u5730\u7F18\u7ECF\u6D4E\u53D8\u5316\u3001\u4E2D\u9A6C\u4EA7\u4E1A\u5408\u4F5C\u53CA\u9752\u5E74\u4EBA\u624D\u53D1\u5C55\u7B49\u8BAE\u9898\u5C55\u5F00\u4EA4\u6D41\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/sz_mmbiz_jpg/fbMdxGOEufdn12PBqH69IJo4hLRFH6NDNGLT2cTggxJWdKIURPhInmI7RK8hiagm47DjxP8B0KicicgukkfzFP45rKZYI6uJc3Gn5emkQia8zlE/640?wx_fmt=webp\u0026amp;from=appmsg#imgIndex=0\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u201C\u9A6C\u4E2D\u535A\u58EB\u751F\u77E5\u884C\u8BA1\u5212\u201D\u6D3B\u52A8\u73B0\u573A\u3002\u4E3B\u529E\u65B9\u4F9B\u56FE\u003C/p\u003E\n\u003Cp\u003E\u56F4\u7ED5\u4E2D\u56FD\u6D77\u5357\u81EA\u8D38\u6E2F\u4E0E\u4E1C\u76DF\u5408\u4F5C\u7684\u7814\u7A76\u65B9\u5411\uFF0C\u4E9A\u592A\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u5171\u7B56\u4F1A\u4E3B\u5E2D\u3001\u9A6C\u6765\u897F\u4E9A\u56FD\u4F1A\u4E0B\u8BAE\u9662\u539F\u526F\u8BAE\u957F\u3001\u4EA4\u901A\u90E8\u539F\u90E8\u957F\u7FC1\u8BD7\u6770\u8868\u793A\uFF0C\u9752\u5E74\u5B66\u8005\u53EF\u4ECE\u6D0B\u6D66\u6E2F\u8425\u5546\u73AF\u5883\u3001\u901A\u5173\u901A\u68C0\u6548\u7387\u3001\u6D77\u5357\u4E0E\u7CA4\u6E2F\u6FB3\u5927\u6E7E\u533A\u8054\u52A8\u7B49\u5177\u4F53\u95EE\u9898\u5207\u5165\uFF0C\u7814\u7A76\u5982\u4F55\u5229\u7528\u300A\u533A\u57DF\u5168\u9762\u7ECF\u6D4E\u4F19\u4F34\u5173\u7CFB\u534F\u5B9A\u300B(RCEP)\u6846\u67B6\u4E0B\u7684\u5408\u4F5C\u673A\u9047\uFF0C\u5F62\u6210\u5DEE\u5F02\u5316\u4F18\u52BF\u3002\u9A6C\u6765\u897F\u4E9A\u5B66\u754C\u5BF9\u6D77\u5357\u81EA\u8D38\u6E2F\u7684\u7CFB\u7EDF\u6027\u7814\u7A76\u4ECD\u6709\u62D3\u5C55\u7A7A\u95F4\uFF0C\u503C\u5F97\u535A\u58EB\u751F\u548C\u9752\u5E74\u5B66\u8005\u5173\u6CE8\uFF0C\u6DF1\u5316\u65B0\u5174\u4EA7\u4E1A\u5408\u4F5C\uFF0C\u5E76\u63A2\u7D22\u5171\u540C\u53C2\u4E0E\u53EF\u6301\u7EED\u53D1\u5C55\u76F8\u5173\u6807\u51C6\u7684\u4EA4\u6D41\u4E0E\u5236\u5B9A\u3002\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u4E2D\u56FD\u8D38\u6613\u4FC3\u8FDB\u4E2D\u5FC3\u603B\u6267\u884C\u957F\u3001\u4E9A\u592A\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u5171\u7B56\u4F1A\u5BF9\u534E\u4E8B\u52A1\u8D1F\u8D23\u4EBA\u73ED\u5F66\u4E1C\u8868\u793A\uFF0C\u9A6C\u4E2D\u4EA7\u4E1A\u5408\u4F5C\u5E94\u91CD\u89C6\u6280\u672F\u3001\u4EBA\u624D\u4E0E\u672C\u5730\u4EA7\u4E1A\u9700\u6C42\u7684\u8854\u63A5\u3002\u4F01\u4E1A\u56FD\u9645\u5316\u53D1\u5C55\u9700\u8981\u6DF1\u5165\u4E86\u89E3\u5F53\u5730\u5236\u5EA6\u73AF\u5883\u3001\u884C\u4E1A\u6807\u51C6\u548C\u793E\u4F1A\u6587\u5316\uFF0C\u901A\u8FC7\u6280\u672F\u5408\u4F5C\u3001\u4EBA\u624D\u57F9\u517B\u53CA\u4F9B\u5E94\u94FE\u534F\u4F5C\uFF0C\u63D0\u5347\u672C\u5730\u5316\u7ECF\u8425\u80FD\u529B\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E2D\u56FD\u793E\u4F1A\u79D1\u5B66\u9662\u4FC4\u7F57\u65AF\u4E1C\u6B27\u4E2D\u4E9A\u7814\u7A76\u6240\u526F\u4E3B\u4EFB\u90ED\u6653\u743C\u7814\u7A76\u5458\u8868\u793A\uFF0C\u5171\u5EFA\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u7ECF\u8FC7\u5341\u4F59\u5E74\u53D1\u5C55\uFF0C\u6B63\u8FDB\u4E00\u6B65\u5411\u9AD8\u8D28\u91CF\u53D1\u5C55\u9636\u6BB5\u8FC8\u8FDB\u3002\u5404\u56FD\u53D1\u5C55\u9636\u6BB5\u3001\u6587\u5316\u80CC\u666F\u548C\u73B0\u5B9E\u9700\u6C42\u4E0D\u540C\uFF0C\u5E94\u52A0\u5F3A\u53D1\u5C55\u6218\u7565\u5BF9\u63A5\uFF0C\u901A\u8FC7\u4EA7\u4E1A\u534F\u4F5C\u3001\u6280\u672F\u8F6C\u79FB\u548C\u80FD\u529B\u5EFA\u8BBE\u5BFB\u627E\u5408\u4F5C\u5951\u5408\u70B9\uFF0C\u534F\u540C\u63A8\u52A8\u57FA\u7840\u8BBE\u65BD\u201C\u786C\u8054\u901A\u201D\u3001\u89C4\u5219\u6807\u51C6\u201C\u8F6F\u8054\u901A\u201D\u548C\u4EBA\u6C11\u4E4B\u95F4\u201C\u5FC3\u8054\u901A\u201D\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E2D\u56FD\u793E\u4F1A\u79D1\u5B66\u9662\u4FC4\u7F57\u65AF\u4E1C\u6B27\u4E2D\u4E9A\u7814\u7A76\u6240\u526F\u7814\u7A76\u5458\u8BB8\u6587\u9E3F\u52C9\u52B1\u535A\u58EB\u751F\uFF0C\u628A\u63E1\u4E2D\u56FD\u79D1\u6280\u4E0E\u4EA7\u4E1A\u53D1\u5C55\u5E26\u6765\u7684\u673A\u9047\uFF0C\u5584\u7528\u9AD8\u65B0\u6280\u672F\u5DE5\u5177\uFF0C\u6301\u7EED\u6DF1\u8015\u81EA\u8EAB\u7814\u7A76\u9886\u57DF\uFF0C\u6210\u957F\u4E3A\u5177\u6709\u624E\u5B9E\u4E13\u4E1A\u80FD\u529B\u7684\u4E13\u5BB6\u3002\u4ED6\u5E0C\u671B\u9752\u5E74\u5B66\u8005\u53D1\u6325\u8DE8\u56FD\u5B66\u4E60\u4E0E\u7814\u7A76\u4F18\u52BF\uFF0C\u4E3A\u4E2D\u56FD\u4F01\u4E1A\u56FD\u9645\u5316\u53D1\u5C55\u63D0\u4F9B\u4E13\u4E1A\u652F\u6301\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E9A\u592A\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u5171\u7B56\u4F1A\u9AD8\u7EA7\u7814\u7A76\u5458Bunn Nagara\u8868\u793A\uFF0C\u4E1C\u76DF\u5404\u56FD\u57FA\u4E8E\u81EA\u8EAB\u53D1\u5C55\u9700\u6C42\u4E0E\u56FD\u5BB6\u5229\u76CA\uFF0C\u5BF9\u5916\u5408\u4F5C\u7B56\u7565\u5404\u6709\u4E0D\u540C\uFF0C\u4E0D\u5B9C\u7B80\u5355\u4EE5\u201C\u9009\u8FB9\u7AD9\u961F\u201D\u6982\u62EC\u3002\u5BF9\u4E8E\u533A\u57DF\u56FD\u5BB6\u800C\u8A00\uFF0C\u66F4\u91CD\u8981\u7684\u662F\u5408\u4F5C\u80FD\u5426\u5E26\u6765\u5207\u5B9E\u7684\u53D1\u5C55\u6536\u76CA\uFF0C\u4EE5\u53CA\u80FD\u5426\u4E3A\u7CAE\u98DF\u5B89\u5168\u3001\u6C14\u5019\u53D8\u5316\u3001\u8DE8\u5883\u72AF\u7F6A\u6CBB\u7406\u7B49\u73B0\u5B9E\u95EE\u9898\u63D0\u4F9B\u53EF\u884C\u7684\u89E3\u51B3\u65B9\u6848\u3002\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u4E9A\u5927\u5B66\u4E2D\u56FD\u7814\u7A76\u6240\u7814\u7A76\u5458\u3001\u535A\u58EB\u751F\u5BFC\u5E08\u674E\u5189\u8868\u793A\uFF0C\u535A\u58EB\u751F\u4E0E\u9752\u5E74\u5B66\u8005\u5177\u6709\u4E13\u4E1A\u80CC\u666F\u591A\u5143\u3001\u56FD\u9645\u5316\u7A0B\u5EA6\u8F83\u9AD8\u7B49\u7279\u70B9\u3002\u9752\u5E74\u4EBA\u624D\u4E0E\u667A\u5E93\u53CA\u4E13\u5BB6\u5B66\u8005\u9762\u5BF9\u9762\u4EA4\u6D41\uFF0C\u6709\u52A9\u4E8E\u4ECE\u73B0\u5B9E\u95EE\u9898\u4E2D\u5BFB\u627E\u7814\u7A76\u65B9\u5411\uFF0C\u66F4\u7D27\u5BC6\u5730\u7ED3\u5408\u5B66\u672F\u79EF\u7D2F\u3001\u533A\u57DF\u53D1\u5C55\u53CA\u9A6C\u4E2D\u5408\u4F5C\u9700\u6C42\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u4EBA\u6C11\u7F51\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/mmbiz_jpg/a2dkibewrKibRDpdqOVEu6Zo2ZKE4ib4UqdOr8OVKViabBHAErxibo1MuNt6Oha81UuO8ico9Xf3KIJkGzuvxvl2zHKw/640?wx_fmt=jpeg\u0026amp;from=appmsg#imgIndex=1\u0022 alt=\u0022\u0022 /\u003E\n",
