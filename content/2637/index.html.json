  "canonicalUrlKey": "880",
  "route": "/2637/",
  "title": "RCEP\u5F00\u542F\u6D77\u5357\u81EA\u8D38\u6E2F\u4E0E\u9A6C\u6765\u897F\u4E9A\u5408\u4F5C\u7684\u65B0\u673A\u9047",
  "summary": "\u7F16\u8005\u6309\uFF1A2020\u5E746\u67081\u65E5\uFF0C\u4E2D\u5171\u4E2D\u592E\u3001\u56FD\u52A1\u9662\u5370\u53D1\u300A\u6D77\u5357\u81EA\u7531\u8D38\u6613\u6E2F\u5EFA\u8BBE\u603B\u4F53\u65B9\u6848\u300B\uFF0C\u6807\u5FD7\u7740\u6D77\u5357\u81EA\u7531\u8D38\u6613\u6E2F\u5EFA\u8BBE\u6B63\u5F0F\u542F\u52A8\u3002\u8FC7\u53BB\u4E00\u5E74\u6765\uFF0C\u6D77\u5357\u79EF\u6781\u8DF5\u884C\u515A\u4E2D\u592E\u3001\u56FD\u52A1\u9662\u5236\u5B9A\u7684\u53D1\u5C55\u7B56\u7565\uFF0C\u6301\u7EED\u6269\u5927\u5BF9\u5916\u5F00\u653E\uFF0C\u5F15\u5165\u5916\u8D44\u4F01\u4E1A\u6570\u91CF\u548C\u89C4\u6A21\u90FD\u51FA\u73B0\u5927\u5E45\u5EA6\u589E\u957F\u3002\u503C\u6B64\u300A\u6D77\u5357\u81EA\u7531\u8D38\u6613\u6E2F\u5EFA\u8BBE\u603B\u4F53\u65B9\u6848\u300B\u53D1\u5E03\u4E00\u5468\u5E74\uFF0C\u6D77\u5357\u56FD\u9645\u4F20\u64AD\u4E2D\u5FC3\u3001\u6D77\u5357\u56FD\u9645\u4F20\u64AD\u7F51\u7279\u522B\u7B56\u5212\u201C\u5916\u773C\u770B\u81EA\u8D38\u6E2F\u4E00\u5468\u5E74\u201D\uFF0C\u9080\u8BF7\u9A6C\u6765\u897F\u4E9A\u7ECF\u6D4E\u5B66\u8005\u6F58\u8363\u5FB7\u4EE5\u201C\u6D77\u5357\u5728\u533A\u57DF\u5168\u9762\u7ECF\u6D4E\u4F19\u4F34\u5173\u7CFB\u534F\u5B9A\u4E2D\u53D1\u6325\u7684\u4F5C\u7528\u201D\u4E3A\u4E3B\u9898\uFF0C\u64B0\u5199\u89C2\u5BDF\u6587\u7AE0\uFF0C\u7545\u8C08\u6D77\u5357\u81EA\u8D38\u6E2F\u673A\u9047\u3002 \u8FD1\u671F\uFF0C\u533A\u57DF\u2026",
  "body": "\u003Cp\u003E\u7F16\u8005\u6309\uFF1A2020\u5E746\u67081\u65E5\uFF0C\u4E2D\u5171\u4E2D\u592E\u3001\u56FD\u52A1\u9662\u5370\u53D1\u300A\u6D77\u5357\u81EA\u7531\u8D38\u6613\u6E2F\u5EFA\u8BBE\u603B\u4F53\u65B9\u6848\u300B\uFF0C\u6807\u5FD7\u7740\u6D77\u5357\u81EA\u7531\u8D38\u6613\u6E2F\u5EFA\u8BBE\u6B63\u5F0F\u542F\u52A8\u3002\u8FC7\u53BB\u4E00\u5E74\u6765\uFF0C\u6D77\u5357\u79EF\u6781\u8DF5\u884C\u515A\u4E2D\u592E\u3001\u56FD\u52A1\u9662\u5236\u5B9A\u7684\u53D1\u5C55\u7B56\u7565\uFF0C\u6301\u7EED\u6269\u5927\u5BF9\u5916\u5F00\u653E\uFF0C\u5F15\u5165\u5916\u8D44\u4F01\u4E1A\u6570\u91CF\u548C\u89C4\u6A21\u90FD\u51FA\u73B0\u5927\u5E45\u5EA6\u589E\u957F\u3002\u503C\u6B64\u300A\u6D77\u5357\u81EA\u7531\u8D38\u6613\u6E2F\u5EFA\u8BBE\u603B\u4F53\u65B9\u6848\u300B\u53D1\u5E03\u4E00\u5468\u5E74\uFF0C\u6D77\u5357\u56FD\u9645\u4F20\u64AD\u4E2D\u5FC3\u3001\u6D77\u5357\u56FD\u9645\u4F20\u64AD\u7F51\u7279\u522B\u7B56\u5212\u201C\u5916\u773C\u770B\u81EA\u8D38\u6E2F\u4E00\u5468\u5E74\u201D\uFF0C\u9080\u8BF7\u9A6C\u6765\u897F\u4E9A\u7ECF\u6D4E\u5B66\u8005\u6F58\u8363\u5FB7\u4EE5\u201C\u6D77\u5357\u5728\u533A\u57DF\u5168\u9762\u7ECF\u6D4E\u4F19\u4F34\u5173\u7CFB\u534F\u5B9A\u4E2D\u53D1\u6325\u7684\u4F5C\u7528\u201D\u4E3A\u4E3B\u9898\uFF0C\u64B0\u5199\u89C2\u5BDF\u6587\u7AE0\uFF0C\u7545\u8C08\u6D77\u5357\u81EA\u8D38\u6E2F\u673A\u9047\u3002\u003C/p\u003E\n\u003Cp\u003E\u8FD1\u671F\uFF0C\u533A\u57DF\u5168\u9762\u7ECF\u6D4E\u4F19\u4F34\u5173\u7CFB\u534F\u5B9A(RCEP)\u533A\u57DF\u53D1\u5C55\u5A92\u4F53\u667A\u5E93\u8BBA\u575B\u5728\u6D77\u5357\u6D77\u53E3\u53EC\u5F00\uFF0C\u53D7\u5230\u4E86\u6765\u81EA\u5305\u62EC\u4E2D\u56FD\u3001\u97E9\u56FD\u3001\u65B0\u52A0\u5761\u3001\u83F2\u5F8B\u5BBE\u3001\u8001\u631D\u3001\u7F05\u7538\u3001\u9A6C\u6765\u897F\u4E9A\u3001\u5370\u5EA6\u5C3C\u897F\u4E9A\u7B49RCEP\u6846\u67B6\u4E0B\u7684\u56FD\u5BB6\u7684\u4E3B\u6D41\u5A92\u4F53\u3001\u9AD8\u7AEF\u667A\u5E93\u4EBA\u58EB\u4EE5\u53CA\u9A7B\u534E\u4F7F\u9986\u5B98\u5458\u548C\u4F01\u4E1A\u4EE3\u8868\u7B49300\u4F59\u4EBA\u901A\u8FC7\u7EBF\u4E0A\u7EBF\u4E0B\u7684\u65B9\u5F0F\u53C2\u52A0\u8BBA\u575B\u3002RCEP\u88AB\u79F0\u4E3A\u5168\u7403\u6700\u5927\u7684\u81EA\u7531\u8D38\u6613\u534F\u8BAE\uFF0C\u5305\u62EC10\u4E2A\u4E1C\u76DF\u6210\u5458\u3001\u4E2D\u56FD\u3001\u65E5\u672C\u3001\u97E9\u56FD\u3001\u6FB3\u5927\u5229\u4E9A\u548C\u65B0\u897F\u5170\uFF0CRCEP\u7684\u7B7E\u7F72\uFF0C\u4E5F\u8C61\u5F81\u7740\u4E16\u754C\u591A\u8FB9\u8D38\u6613\u4F53\u7CFB\u4ECA\u540E\u5C06\u8FC8\u5411\u5D2D\u65B0\u7684\u91CC\u7A0B\u7891\uFF0C\u9664\u4E86\u6210\u5458\u56FD\u4E4B\u95F4\u9AD8\u8FBE90%\u7684\u5173\u7A0E\u964D\u5E45\uFF0C\u800C\u4E14\u4E5F\u6709\u671B\u6210\u4E3A\u533A\u57DF\u548C\u5168\u7403\u7ECF\u6D4E\u7684\u589E\u957F\u505A\u51FA\u5DE8\u5927\u8D21\u732E\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u643A\u624B\u63A8\u52A8\u75AB\u540E\u7ECF\u6D4E\u590D\u82CF\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u5BF9\u4E8E\u5F53\u4E0B\u6B63\u5904\u4E8E\u75AB\u60C5\u4E25\u5CFB\u8003\u9A8C\u7684\u9A6C\u6765\u897F\u4E9A\u800C\u8A00\uFF0CRCEP\u82E5\u80FD\u5728\u77ED\u671F\u5185\u8FC5\u901F\u53CA\u6709\u6548\u7684\u843D\u5B9E\uFF0C\u90A3\u5C06\u6709\u671B\u6210\u4E3A\u63A8\u52A8\u75AB\u540E\u65B0\u5E38\u6001\u4E0B\u7ECF\u6D4E\u590D\u82CF\u7684\u91CD\u8981\u5F15\u64CE\u3002\u53EF\u4EE5\u9884\u89C1\uFF0C\u5728RCEP\u7684\u63A8\u52A8\u4E0B\uFF0C\u6D77\u5357\u81EA\u8D38\u6E2F\u4E0E\u9A6C\u6765\u897F\u4E9A\u6709\u671B\u5F3A\u5F3A\u8054\u624B\u5728\u8FD9\u6846\u67B6\u4E0B\u8FDB\u884C\u6DF1\u5EA6\u5408\u4F5C\uFF0C\u4EE5\u5B9E\u73B0\u53CC\u65B9\u5728\u63A8\u52A8\u9AD8\u8D28\u91CF\u53D1\u5C55\u4E0A\u95EF\u51FA\u65B0\u8DEF\u5B50\uFF0C\u540C\u65F6\u4E5F\u4E00\u540C\u5728\u6784\u5EFA\u65B0\u53D1\u5C55\u683C\u5C40\u4E2D\u5C55\u73B0\u65B0\u4F5C\u4E3A\u3002\u6B64\u5916\uFF0C\u968F\u7740\u53CC\u8FB9\u8D38\u6613\u58C1\u5792\u964D\u4F4E\uFF0C\u8D38\u6613\u4FBF\u5229\u5316\u89C4\u5219\u548C\u6CD5\u89C4\u7684\u8FDB\u4E00\u6B65\u7B80\u5316\uFF0C\u518D\u52A0\u4E0A\u6D77\u5357\u81EA\u8D38\u6E2F\u5236\u5B9A\u51FA\u53F022\u6761\u653E\u5BBD\u5E02\u573A\u51C6\u5165\u7279\u522B\u63AA\u65BD\uFF0C\u6DB5\u76D6\u533B\u7597\u3001\u91D1\u878D\u3001\u6587\u5316\u7B49\u4E94\u5927\u9886\u57DF\uFF0C\u5C06\u6709\u52A9\u4E8E\u63D0\u9AD8\u8D38\u6613\u548C\u6295\u8D44\u7684\u900F\u660E\u5EA6\uFF0C\u5E76\u534F\u52A9\u9A6C\u6765\u897F\u4E9A\u4E2D\u5C0F\u578B\u4F01\u4E1A\u6210\u4E3A\u533A\u57DF\u6027\u4F9B\u5E94\u94FE\uFF0C\u5305\u62EC\u4E0E\u6D77\u5357\u81EA\u8D38\u6E2F\u5EFA\u7ACB\u66F4\u5927\u7684\u8D38\u6613\u4E00\u4F53\u5316\u548C\u591A\u5143\u5316\u7684\u751F\u4EA7\u7F51\u7EDC\u3002\u53E6\u5916\uFF0C\u5728\u76EE\u524D\u9A6C\u6765\u897F\u4E9A\u6B63\u5728\u8FC5\u901F\u63A5\u79CD\u75AB\u82D7\u7684\u60C5\u51B5\u4E0B\uFF0C\u53CC\u65B9\u4E5F\u53EF\u4E00\u540C\u63A2\u8BA8\u75AB\u82D7\u62A4\u7167\u7684\u53EF\u884C\u6027\uFF0C\u4EE5\u52A0\u901F\u53CC\u8FB9\u7684\u65C5\u6E38\u4E1A\uFF0C\u9152\u5E97\u4E1A\u548C\u56FD\u9645\u822A\u7A7A\u7684\u590D\u82CF\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u6253\u9020RCEP\u6210\u5458\u56FD\u6865\u5934\u5821\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u503C\u5F97\u4E00\u63D0\u7684\u662F\uFF0CRCEP\u5C06\u4EE5\u81EA\u7531\u3001\u516C\u5E73\u7684\u8D38\u6613\u5173\u7CFB\u5BF9\u6297\u65E5\u76CA\u9AD8\u6DA8\u7684\u4FDD\u62A4\u4E3B\u4E49\u6D6A\u6F6E\u4E3A\u91CD\u4E2D\u4E4B\u91CD\u3002\u56E0\u6B64\uFF0C\u6D77\u5357\u81EA\u8D38\u6E2F\u4F5C\u4E3A\u65B0\u65F6\u4EE3\u4E2D\u56FD\u7684\u91CD\u8981\u5F00\u653E\u95E8\u6237\uFF0C\u6709\u671B\u4E0E\u9A6C\u6765\u897F\u4E9A\u5BF9\u5916\u8D38\u6613\u7684\u4F01\u4E1A\u548C\u6D88\u8D39\u8005\u5F00\u62D3\u66F4\u591A\u7684\u5546\u673A\u548C\u5408\u4F5C\u673A\u4F1A\uFF0C\u4EE5\u8FDB\u4E00\u6B65\u63A8\u8FDB\u533A\u57DF\u7ECF\u6D4E\u4E00\u4F53\u5316\uFF0C\u7279\u522B\u662F\u5F3A\u5316\u53CC\u8FB9\u533A\u57DF\u6027\u7684\u6E2F\u53E3\u3001\u7269\u6D41\u3001\u8FDB\u51FA\u53E3\u8D38\u6613\u7B49\u9886\u57DF\u3002\u540C\u65F6\uFF0C\u6D77\u5357\u81EA\u8D38\u6E2F\u5B9E\u65BD\u768415%\u4F01\u4E1A\u6240\u5F97\u7A0E\u7684\u4F18\u60E0\u653F\u7B56\uFF0C\u8FD9\u5C06\u6709\u52A9\u4E8E\u9A6C\u6765\u897F\u4E9A\u4F01\u4E1A\u5230\u6D77\u5357\u81EA\u7531\u6E2F\u8FDB\u884C\u6295\u8D44\uFF0C\u8BA9\u4E2D\u5C0F\u578B\u4F01\u4E1A\u5229\u60E0\u4E8E\u66F4\u52A0\u5F00\u653E\u7684\u5E02\u573A\u548C\u7B80\u5316\u7684\u8D38\u6613\uFF0C\u751A\u81F3\u8BA9\u53CC\u8FB9\u6210\u4E3ARCEP\u6210\u5458\u56FD\u7684\u6865\u5934\u5821\u53CA\u8D38\u6613\u7A97\u53E3\u3002\u800C\u9A6C\u6765\u897F\u4E9A\u7684\u98DF\u54C1\u4EA7\u4E1A\u3001\u5316\u5B66\u53CA\u5316\u5DE5\u4EA7\u54C1\u3001\u68D5\u6988\u6CB9\u4E0A\u4E0B\u6E38\u4EA7\u54C1\u3001\u6A61\u80F6\u4EA7\u54C1\u3001\u5851\u6599\u5236\u54C1\u3001\u673A\u68B0\u5668\u5177\u8BBE\u5907\u4EE5\u53CA\u7535\u5B50\u7535\u5668\u4EA7\u54C1\u4E5F\u5C06\u6709\u671B\u5728\u6D77\u5357\u81EA\u8D38\u6E2F\u8BBE\u7ACB\u4E2D\u8F6C\u7AD9\uFF0C\u4EE5\u4FBF\u52A0\u901F\u8FDB\u519B\u4E2D\u56FD14\u4EBF\u4EBA\u53E3\u7684\u5E9E\u5927\u5E02\u573A\u3002\u003C/p\u003E\n\u003Cp\u003E\u4EE5\u5B8F\u89C2\u7ECF\u6D4E\u89D2\u5EA6\u770B\u6765\uFF0CRCEP\u6210\u5458\u56FD\u4E0D\u4EC5\u5360\u4E86\u5168\u740329.7%\u4EBA\u53E3\uFF0C15\u4E2A\u6210\u5458\u56FD\u7684\u603B\u56FD\u5185\u751F\u4EA7\u603B\u503C(GDP)\u66F4\u9AD8\u8FBE24.8\u5146\u7F8E\u5143\uFF0C\u5171\u5360\u4E86\u5168\u7403GDP\u768428.9%\uFF0C\u800C\u4E14\u8D38\u6613\u603B\u989D\u4E5F\u8FBE\u523010.4\u5146\u7F8E\u5143\u3002\u6709\u9274\u4E8E\u6B64\uFF0C\u8FD9\u5C06\u6709\u52A9\u4E8E\u5F3A\u5316\u4F9B\u5E94\u94FE\u8FDE\u901A\u6027\uFF0C\u6269\u5927\u4E1C\u76DF\u4E0E\u4E1C\u4E9A\u7ECF\u6D4E\u5F3A\u56FD\u4E4B\u95F4\u7684\u5546\u8D38\u5F80\u6765\u3002\u57FA\u4E8E\u4E1C\u76DF\u56FD\u5BB6\u4E4B\u95F4\u5B58\u5728\u8F83\u5927\u5DEE\u5F02\uFF0C\u56E0\u6B64\u4F5C\u4E3A\u4E1C\u76DF\u7B2C\u4E8C\u5927\u56FD\u7684\u9A6C\u6765\u897F\u4E9A\u5C06\u6709\u671B\u4E0E\u6D77\u5357\u81EA\u8D38\u6E2F\u626E\u6F14\u7740\u9886\u5934\u7F8A\uFF0C\u9664\u4E86\u53D1\u6325\u53CC\u8FB9\u5404\u81EA\u7684\u660E\u663E\u4F18\u52BF\uFF0C\u4E5F\u8BA9\u8FD9\u4E2A\u62E5\u670922\u4EBF\u4EBA\u53E3\u7684RCEP\u6210\u5458\u56FD\u5F00\u62D3\u5DE8\u5927\u6D88\u8D39\u5E02\u573A\uFF0C\u4E00\u540C\u643A\u624B\u5954\u8D74\u66F4\u9065\u8FDC\u7684\u661F\u8FB0\u5927\u6D77\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u878D\u5165\u4E9A\u592A\u8D85\u7EA7\u7ECF\u6D4E\u5708\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u603B\u7684\u6765\u8BF4\uFF0CRCEP \u662F\u5386\u7ECF\u4E868\u5E74\u7684\u8C08\u5224\u624D\u5F97\u4EE5\u7B7E\u7F72\uFF0C\u8FD9\u4E5F\u662F\u5C5E\u4E8E\u4E2D\u56FD\u4E0E\u4E9A\u592A\u56FD\u5BB6\u53F2\u65E0\u524D\u4F8B\u6253\u9020\u7684\u8D85\u7EA7\u7ECF\u6D4E\u5708\uFF0C\u540C\u65F6\u4E5F\u8FDB\u4E00\u6B65\u6DF1\u5316\u7ECF\u8D38\u8054\u7CFB\u3001\u652F\u6301\u591A\u8FB9\u4E3B\u4E49\u548C\u81EA\u7531\u8D38\u6613\u3002\u66F4\u4E3A\u5173\u952E\u7684\u662F\uFF0C\u968F\u7740\u65B0\u51A0\u80BA\u708E\u5168\u7403\u5927\u6D41\u884C\u800C\u4FC3\u4F7F\u8FD9\u4E2A\u5927\u53D8\u5C40\u52A0\u901F\u6F14\u8FDB\uFF0C\u56E0\u6B64\u6D77\u5357\u81EA\u8D38\u6E2F\u4E0E\u9A6C\u6765\u897F\u4E9A\u5C06\u9F50\u5FC3\u534F\u529B\uFF0C\u6293\u7D27\u53D1\u5C55\u65B0\u673A\u9047\uFF0C\u5171\u540C\u5206\u4EAB\u53D1\u5C55\u6210\u679C\uFF0C\u4ECE\u800C\u4E3A\u4E16\u754C\u7ECF\u6D4E\u589E\u957F\u63D0\u4F9B\u5F3A\u52B2\u52A8\u529B\uFF0C\u7EE7\u7EED\u8C31\u5199\u4ECA\u5E74\u4E2D\u9A6C\u5EFA\u4EA447\u5468\u5E74\u7684\u65B0\u7BC7\u7AE0\u3002(\u4F5C\u8005\uFF1A\u6F58\u8363\u5FB7)\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/mmbiz_jpg/uKucKpKOlXJmaficXM50KThmY0DZbFEIQaIciaXu2e5vZ7xRqLV7YhBzNJPFxM0rgWeibtESsyttqvwpjkeKEzjiaw/640?wx_fmt=jpeg\u0026amp;tp=webp\u0026amp;wxfrom=5\u0026amp;wx_lazy=1\u0026amp;wx_co=1\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u6F58\u8363\u5FB7(\u9A6C\u6765\u897F\u4E9A\u4EA7\u4E1A\u548C\u65F6\u4E8B\u8BC4\u8BBA\u5458)\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u82F1\u56FD\u91D1\u878D\u7855\u58EB\u548C\u4E1C\u76DF\u7ECF\u8D38\u535A\u58EB\u7814\u7A76\u751F\uFF0C\u9A6C\u6765\u897F\u4E9A\u521B\u65B0\u4E2D\u5FC3(\u9A6C\u6765\u89