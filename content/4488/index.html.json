  "id": "%e4%b8%87%e5%9b%bd%e6%95%b0%e6%8d%ae%e4%b8%8ecenergi%e7%ad%be%e7%bd%b2%e5%8f%af%e5%86%8d%e7%94%9f%e8%83%bd%e6%ba%90vppa%ef%bc%8c%e6%88%90%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e9%a6%96%e6%89%b9%e7%bb%bf",
  "slug": "%e4%b8%87%e5%9b%bd%e6%95%b0%e6%8d%ae%e4%b8%8ecenergi%e7%ad%be%e7%bd%b2%e5%8f%af%e5%86%8d%e7%94%9f%e8%83%bd%e6%ba%90vppa%ef%bc%8c%e6%88%90%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e9%a6%96%e6%89%b9%e7%bb%bf",
  "canonicalUrlKey": "%e4%b8%87%e5%9b%bd%e6%95%b0%e6%8d%ae%e4%b8%8ecenergi%e7%ad%be%e7%bd%b2%e5%8f%af%e5%86%8d%e7%94%9f%e8%83%bd%e6%ba%90vppa%ef%bc%8c%e6%88%90%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e9%a6%96%e6%89%b9%e7%bb%bf",
  "route": "/4488/",
  "title": "\u4E07\u56FD\u6570\u636E\u4E0ECenergi\u7B7E\u7F72\u53EF\u518D\u751F\u80FD\u6E90VPPA\uFF0C\u6210\u9A6C\u6765\u897F\u4E9A\u9996\u6279\u7EFF\u7535\u627F\u8D2D\u5546\u4E4B\u4E00",
  "summary": "\u4ECA\u5E742\u6708\uFF0C\u4E07\u56FD\u6570\u636E\u4E0E \u9A6C\u6765\u897F\u4E9A\u592A\u9633\u80FD\u53D1\u7535\u5546\u548C\u591A\u5143\u5316\u53EF\u518D\u751F\u80FD\u6E90\u5F00\u53D1\u5546 Cenergi \u7B7E\u7F72\u4E86 \u4E3A\u671F21\u5E74\uFF0C \u603B\u8BA122.5MWac \u7684\u53EF\u518D\u751F\u80FD\u6E90\u865A\u62DF\u7535\u529B\u8D2D\u4E70\u534F\u8BAE\uFF08VPPA\uFF09 \uFF0C \u7528\u4E8E\u4E3A\u516C\u53F8\u67D4\u4F5B\u5DDE\u52AA\u6C99\u518D\u4E5F\u79D1\u6280\u56ED\u6570\u636E\u4E2D\u5FC3\u56ED\u533A\u4F9B\u5E94\u7EFF\u8272\u7535\u529B\u3002 \u534F\u8BAE\u7B7E\u7F72\u540E\uFF0C\u4E07\u56FD\u6570\u636E\u6210\u4E3A\u9A6C\u6765\u897F\u4E9A\u4F01\u4E1A\u7EFF\u8272\u7535\u529B\u8BA1\u5212\uFF08Corporate Green Power Program\uFF09\u4E2D\uFF0C\u9996\u6279\u7EFF\u8272\u7535\u529B\u627F\u8D2D\u5546\u4E4B\u4E00 \uFF0C\u7EE7\u7EED\u63A8\u52A8\u516C\u53F8\u7EFF\u8272\u4F4E\u78B3\u5347\u7EA7\uFF0C\u8DF5\u884C\u53EF\u6301\u7EED\u53D1\u5C55\u627F\u8BFA\u3002 \u4E07\u56FD\u6570\u636E\u6280\u672F\u9AD8\u7EA7\u526F\u603B\u88C1 Verghese Jacob\uFF08\u5DE6\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/03/frc-9609f955805801f232bdfaf51e7e1173.gif\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u4ECA\u5E742\u6708\uFF0C\u4E07\u56FD\u6570\u636E\u4E0E\u9A6C\u6765\u897F\u4E9A\u592A\u9633\u80FD\u53D1\u7535\u5546\u548C\u591A\u5143\u5316\u53EF\u518D\u751F\u80FD\u6E90\u5F00\u53D1\u5546 Cenergi \u7B7E\u7F72\u4E86\u003Cstrong\u003E\u4E3A\u671F21\u5E74\uFF0C\u603B\u8BA122.5MWac\u7684\u53EF\u518D\u751F\u80FD\u6E90\u865A\u62DF\u7535\u529B\u8D2D\u4E70\u534F\u8BAE\uFF08VPPA\uFF09\u003C/strong\u003E\uFF0C\u7528\u4E8E\u4E3A\u516C\u53F8\u67D4\u4F5B\u5DDE\u52AA\u6C99\u518D\u4E5F\u79D1\u6280\u56ED\u6570\u636E\u4E2D\u5FC3\u56ED\u533A\u4F9B\u5E94\u7EFF\u8272\u7535\u529B\u3002\u003Cstrong\u003E\u534F\u8BAE\u7B7E\u7F72\u540E\uFF0C\u4E07\u56FD\u6570\u636E\u6210\u4E3A\u9A6C\u6765\u897F\u4E9A\u4F01\u4E1A\u7EFF\u8272\u7535\u529B\u8BA1\u5212\uFF08Corporate Green Power Program\uFF09\u4E2D\uFF0C\u9996\u6279\u7EFF\u8272\u7535\u529B\u627F\u8D2D\u5546\u4E4B\u4E00\u003C/strong\u003E\uFF0C\u7EE7\u7EED\u63A8\u52A8\u516C\u53F8\u7EFF\u8272\u4F4E\u78B3\u5347\u7EA7\uFF0C\u8DF5\u884C\u53EF\u6301\u7EED\u53D1\u5C55\u627F\u8BFA\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/03/frc-cf655521b8ca0d9f85d7483c5b764a9b.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u4E07\u56FD\u6570\u636E\u6280\u672F\u9AD8\u7EA7\u526F\u603B\u88C1 Verghese Jacob\uFF08\u5DE6\u4E8C\uFF09\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003ECenergi \u96C6\u56E2\u9996\u5E2D\u6267\u884C\u5B98 Hairol Azizi Tajudin\uFF08\u53F3\u4E8C\uFF09\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u4E07\u56FD\u6570\u636E\u9A6C\u6765\u897F\u4E9A\u603B\u7ECF\u7406 Jimmy Yan\uFF08\u5DE6\u4E00\uFF09\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003ECenergi \u9996\u5E2D\u4E1A\u52A1\u53D1\u5C55\u5B98 Ir. Kwok Yew Hoe\uFF08\u53F3\u4E00\uFF09\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u901A\u8FC7\u6B64\u6B21\u4E0ECenergi\u7B7E\u7EA6\uFF0C\u4E07\u56FD\u6570\u636E\u5C06\u63D0\u9AD8\u6570\u636E\u4E2D\u5FC3\u7684\u53EF\u518D\u751F\u80FD\u6E90\u4F7F\u7528\uFF0C\u5927\u5E45\u51CF\u5C11\u6E29\u5BA4\u6C14\u4F53\u6392\u653E\uFF0C\u003Cstrong\u003E\u9884\u8BA1\u6BCF\u5E74\u53EF\u6700\u591A\u51CF\u6392\u4E8C\u6C27\u5316\u78B338,000\u5428\uFF0C\u76F8\u5F53\u4E8E\u6BCF\u5E74\u51CF\u5C118,400\u8F86\u71C3\u6CB9\u6C7D\u8F66\u884C\u9A76\u7684\u4E8C\u6C27\u5316\u78B3\u6392\u653E\u91CF\uFF0C\u62167,400\u4E2A\u5BB6\u5EAD\u4E00\u5E74\u7684\u7528\u7535\u91CF*\u3002\u003C/strong\u003E\u6B64\u5916\uFF0C\u4E07\u56FD\u6570\u636E\u62E5\u6709\u5148\u8FDB\u7684\u6570\u636E\u4E2D\u5FC3\u7EFF\u8272\u6280\u672F\uFF0C\u53EF\u8FDB\u4E00\u6B65\u964D\u4F4E\u5BF9\u73AF\u5883\u9020\u6210\u7684\u5F71\u54CD\uFF0C\u63A8\u52A8\u5B9E\u73B02030\u5E74\u78B3\u4E2D\u548C\u53CA100%\u4F7F\u7528\u53EF\u518D\u751F\u80FD\u6E90\u7684\u76EE\u6807\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/03/frc-fa37a483d8b7b25023618dca8437953b.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u4E07\u56FD\u6570\u636E\u67D4\u4F5B\u5DDE\u52AA\u6C99\u518D\u4E5F\u79D1\u6280\u56ED\u6570\u636E\u4E2D\u5FC3\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u4E07\u56FD\u6570\u636E\u8463\u4E8B\u957F\u517C\u9996\u5E2D\u6267\u884C\u5B98\u9EC4\u4F1F\u003C/strong\u003E\u8868\u793A\uFF1A\u201C\u6211\u4EEC\u5F88\u9AD8\u5174\u4E0ECenergi\u8FBE\u6210\u5408\u4F5C\uFF0C\u8FD9\u4E0D\u4F46\u4F7F\u6211\u4EEC\u6210\u4E3A\u9996\u6279\u53C2\u4E0E\u9A6C\u6765\u897F\u4E9A\u7EFF\u7535\u627F\u8D2D\u7684\u4F01\u4E1A\uFF0C\u8FD8\u4F53\u73B0\u7740\u4E07\u56FD\u6570\u636E\u5BF9\u4FC3\u8FDB\u884C\u4E1A\u53CA\u5F53\u5730\u53EF\u6301\u7EED\u53D1\u5C55\u7684\u627F\u8BFA\u3002\u003C/p\u003E\n\u003Cp\u003E\u901A\u8FC7\u5728\u67D4\u4F5B\u5DDE\u6295\u8D44\u5EFA\u8BBE\u8D85\u5927\u89C4\u6A21\u6570\u636E\u4E2D\u5FC3\u56ED\u533A\uFF0C\u4E07\u56FD\u6570\u636E\u5DF2\u6210\u4E3A\u9A6C\u6765\u897F\u4E9A\u6570\u5B57\u7ECF\u6D4E\u84EC\u52C3\u53D1\u5C55\u7684\u5173\u952E\u9A71\u52A8\u529B\u4E4B\u4E00\uFF0C\u800C\u4E0ECenergi\u7684\u4F19\u4F34\u5173\u7CFB\uFF0C\u4E0D\u4F46\u5C06\u003Cstrong\u003E\u5F3A\u5316\u4E07\u56FD\u6570\u636E\u5728\u672A\u6765\u6301\u7EED\u4F18\u5316\u80FD\u6E90\u7ED3\u6784\u7684\u80FD\u529B\u003C/strong\u003E\uFF0C\u8FD8\u5C06\u003Cstrong\u003E\u5DE9\u56FA\u6211\u4EEC\u5728\u53EF\u6301\u7EED\u521B\u65B0\u9886\u57DF\u7684\u9886\u5BFC\u5730\u4F4D\u003C/strong\u003E\uFF0C\u4E3A\u6700\u7EC8\u5B9E\u73B0\u51C0\u96F6\u6392\u653E\u63D0\u4F9B\u5E2E\u52A9\uFF0C\u671F\u5F85\u53CC\u65B9\u7684\u534F\u4F5C\u53EF\u4EE5\u63A8\u52A8\u7EFF\u8272\u7535\u529B\u5E94\u7528\u53CA\u521B\u65B0\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003ECenergi \u96C6\u56E2\u9996\u5E2D\u6267\u884C\u5B98 Hairol Azizi Tajudin \u003C/strong\u003E\u8868\u793A\uFF1A\u201C\u6211\u4EEC\u5F88\u9AD8\u5174\u4E0E\u4E07\u56FD\u6570\u636E\u5728\u53EF\u518D\u751F\u80FD\u6E90\u9886\u57DF\u8FBE\u6210\u5408\u4F5C\uFF0C\u8FD9\u51F8\u663E\u4E86\u6211\u4EEC\u5BF9\u53EF\u6301\u7EED\u53D1\u5C55\u7684\u5949\u732E\u7CBE\u795E\uFF0C\u5E76\u5B8C\u5168\u7B26\u5408\u6211\u4EEC\u63A8\u8FDB\u53EF\u518D\u751F\u80FD\u6E90\u9879\u76EE\u7684\u76EE\u6807\u3002\u901A\u8FC7\u516C\u53F8\u5373\u5C06\u5EFA\u6210\u7684\u592A\u9633\u80FD\u53D1\u7535\u5382\u4E3A\u4E07\u56FD\u6570\u636E\u63D0\u4F9B\u7EFF\u8272\u7535\u529B\uFF0C\u6211\u4EEC\u4E0D\u4EC5\u5C06\u5E2E\u52A9\u4ED6\u4EEC\u5B9E\u73B0\u51C0\u96F6\u6392\u653E\u76EE\u6807\uFF0C\u8FD8\u5C06\u4E3A\u9A6C\u6765\u897F\u4E9A\u63A8\u52A8\u66F4\u5927\u89C4\u6A21\u7EFF\u8272\u80FD\u6E90\u7EC4\u5408\u7684\u89C4\u5212\u505A\u51FA\u8D21\u732E\u3002\u6211\u4EEC\u76F8\u4FE1\u8FD9\u79CD\u4F19\u4F34\u5173\u7CFB\u80FD\u591F\u4EA7\u751F\u79EF\u6781\u5F71\u54CD\uFF0C\u4E3A\u6240\u6709\u4EBA\u521B\u9020\u4E00\u4E2A\u66F4\u52A0\u53EF\u6301\u7EED\u7684\u672A\u6765\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u6B64\u6B21\u7B7E\u7F72VPPA\u7684\u53EF\u518D\u751F\u80FD\u6E90\u5C06\u7531 Cenergi \u4F4D\u4E8E\u9A6C\u6765\u897F\u4E9A\u5409\u6253\u5DDE\u768429.99MWac\u5927\u578B\u592A\u9633\u80FD\u5149\u4F0F\u53D1\u7535\u5382\u63D0\u4F9B\uFF0C\u8BE5\u53D1\u7535\u5382\u9884\u8BA1\u5C06\u4E8E2025\u5E74\u7B2C\u56DB\u5B63\u5EA6\u6295\u5165\u8FD0\u8425\u3002Cenergi \u662F UEM Group Berhad \u7684\u5B50\u516C\u53F8\uFF0C\u662F\u4E00\u5BB6\u9886\u5148\u7684\u53EF\u6301\u7EED\u80FD\u6E90\u89E3\u51B3\u65B9\u6848\u63D0\u4F9B\u5546\uFF0C\u4E13\u6CE8\u4E8E\u901A\u8FC7\u6295\u8D44\u53EF\u518D\u751F\u80FD\u6E90\u548C\u80FD\u6E90\u6548\u7387\u9879\u76EE\u6765\u51CF\u5C11\u78B3\u8DB3\u8FF9\u3002Cenergi \u76EE\u524D\u662F\u9A6C\u6765\u897F\u4E9A\u591A\u5143\u5316\u7684\u53EF\u518D\u751F\u80FD\u6E90\u5F00\u53D1\u5546\u4E4B\u4E00\uFF0C\u4E5F\u662F\u8BE5\u56FD\u6700\u5927\u7684\u6CBC\u6C14\u751F\u4EA7\u5546\u3002\u003C/p\u003E\n\u003Cp\u003E*\u57FA\u4E8E\u7F8E\u56FD EPA \u6E29\u5BA4\u6C14\u4F53\u5F53\u91CF\u8BA1\u7B97\u5668\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/03/frc-e7eb5c0f486337539759dbe942f3f300.gif\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cem\u003E\u003Cstrong\u003E\u5173\u4E8ECenergi\u003C/strong\u003E\u003C/em\u003E\u003C/p\u003E\n\u003Cp\u003ECenergi\u81F4\u529B\u4E8E\u521B\u9020\u4E00\u4E2A\u66F4\u73AF\u4FDD\u7684\u5730\u7403\u3002\u6211\u4EEC\u7684\u76EE\u6807\u662F\u901A\u8FC7\u53EF\u6301\u7EED\u9879\u76EE\u51CF\u5C11\u9A6C\u6765\u897F\u4E9A\u548C\u4E1C\u5357\u4E9A\u5730\u533A\u7684\u78B3\u6392\u653E\u3002\u003C/p\u003E\n\u003Cp\u003ECenergi\u5728\u53EF\u6301\u7EED\u53D1\u5C55\u9886\u57DF\u7684\u5B9E\u8DF5\u548C\u9879\u76EE\u8986\u76D6\u4E09\u4E2A\u5173\u952E\u9886\u57DF\uFF1A\u53EF\u518D\u751F\u80FD\u6E90\u3001\u80FD\u6E90\u6548\u7387\u548C\u65B0\u98CE\u9669\u6295\u8D44\u3002\u6211\u4EEC\u62E5\u6709\u6E05\u6D01\u80FD\u6E90\u548C\u80FD\u6548\u76F8\u5173\u9879\u76EE\u6240\u9700\u7684\u5168\u65B9\u4F4D\u6280\u672F\u548C\u8FD0\u8425\u80FD\u529B\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/03/frc-e9490f81984891358b70cde002ecd25b.gif\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/MkFlUrbPX_e8hHrJxpjMTA\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
