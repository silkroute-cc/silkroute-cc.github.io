  "route": "/3174/",
  "title": "\u4E1C\u65B9\u65E5\u5347\u51FA\u5E2D2022\u9A6C\u6765\u897F\u4E9A\u56FD\u9645\u5149\u4F0F\u5927\u4F1A \u83B7\u6388\u201C\u5E74\u5EA6\u5353\u8D8A\u592A\u9633\u80FD\u6280\u672F\u5956\u201D",
  "summary": "11\u67088\u65E5\uFF0C\u201C2022\u5E74\u9A6C\u6765\u897F\u4E9A\u56FD\u9645\u5149\u4F0F\u5927\u4F1A\u201D\u5728\u9A6C\u6765\u897F\u4E9A\u5409\u9686\u5761\u9686\u91CD\u4E3E\u884C\uFF0C\u5168\u7403\u9886\u5148\u7684\u5149\u4F0F\u667A\u6167\u80FD\u6E90\u6574\u4F53\u89E3\u51B3\u65B9\u6848\u4F9B\u5E94\u5546\u4E1C\u65B9\u65E5\u5347\u53D7\u9080\u51FA\u5E2D\u5927\u4F1A\uFF0C\u4E0E\u5F53\u5730\u804C\u80FD\u90E8\u95E8\u3001\u884C\u4E1A\u9886\u8896\u3001\u6280\u672F\u5927\u5496\u4EE5\u53CA\u4F01\u4E1A\u4EE3\u8868\u7B49\u5609\u5BBE\u56F4\u7ED5\u4E1C\u5357\u4E9A\u5149\u4F0F\u884C\u4E1A\u53D1\u5C55\u73B0\u72B6\u53CA\u8D8B\u52BF\u5C55\u5F00\u6DF1\u5165\u4EA4\u6D41\u3002\u4E1C\u65B9\u65E5\u5347\u6D77\u5916\u6218\u7565\u5BA2\u6237\u90E8\u5F6D\u603B(\u5F6D\u534E)\u4EE5\u300A\u4E3A\u4EC0\u4E48\u5F02\u8D28\u7ED3\u662F\u672A\u6765\u53D1\u5C55\u7684\u8D8B\u52BF\u300B\u4E3A\u4E3B\u9898\uFF0C\u4E0E\u73B0\u573A\u5927\u5496\u5206\u4EABN\u578B\u5F02\u8D28\u7ED3\u6280\u672F\u8FED\u4EE3\u8D8B\u52BF\uFF0C\u4EE5\u53CA\u53EF\u63A8\u52A8\u5F53\u5730\u52A0\u901F\u5B9E\u73B0\u80FD\u6E90\u8F6C\u578B\u7684\u6700\u4F18\u65B9\u6848\u3002\u4E3B\u529E\u65B9\u5145\u5206\u8BA4\u53EF\u4E1C\u65B9\u65E5\u5347\u5F3A\u52B2\u6280\u672F\u5B9E\u529B\uFF0C\u5E76\u6388\u4E88\u516C\u53F8\u201C2022\u5E74\u5EA6\u5353\u8D8A\u592A\u9633\u80FD\u6280\u672F\u5956\u201D\u5927\u5956\u3002\u2026",
  "body": "\u003Cp\u003E11\u67088\u65E5\uFF0C\u201C2022\u5E74\u9A6C\u6765\u897F\u4E9A\u56FD\u9645\u5149\u4F0F\u5927\u4F1A\u201D\u5728\u9A6C\u6765\u897F\u4E9A\u5409\u9686\u5761\u9686\u91CD\u4E3E\u884C\uFF0C\u5168\u7403\u9886\u5148\u7684\u5149\u4F0F\u667A\u6167\u80FD\u6E90\u6574\u4F53\u89E3\u51B3\u65B9\u6848\u4F9B\u5E94\u5546\u4E1C\u65B9\u65E5\u5347\u53D7\u9080\u51FA\u5E2D\u5927\u4F1A\uFF0C\u4E0E\u5F53\u5730\u804C\u80FD\u90E8\u95E8\u3001\u884C\u4E1A\u9886\u8896\u3001\u6280\u672F\u5927\u5496\u4EE5\u53CA\u4F01\u4E1A\u4EE3\u8868\u7B49\u5609\u5BBE\u56F4\u7ED5\u4E1C\u5357\u4E9A\u5149\u4F0F\u884C\u4E1A\u53D1\u5C55\u73B0\u72B6\u53CA\u8D8B\u52BF\u5C55\u5F00\u6DF1\u5165\u4EA4\u6D41\u3002\u4E1C\u65B9\u65E5\u5347\u6D77\u5916\u6218\u7565\u5BA2\u6237\u90E8\u5F6D\u603B(\u5F6D\u534E)\u4EE5\u300A\u4E3A\u4EC0\u4E48\u5F02\u8D28\u7ED3\u662F\u672A\u6765\u53D1\u5C55\u7684\u8D8B\u52BF\u300B\u4E3A\u4E3B\u9898\uFF0C\u4E0E\u73B0\u573A\u5927\u5496\u5206\u4EABN\u578B\u5F02\u8D28\u7ED3\u6280\u672F\u8FED\u4EE3\u8D8B\u52BF\uFF0C\u4EE5\u53CA\u53EF\u63A8\u52A8\u5F53\u5730\u52A0\u901F\u5B9E\u73B0\u80FD\u6E90\u8F6C\u578B\u7684\u6700\u4F18\u65B9\u6848\u3002\u4E3B\u529E\u65B9\u5145\u5206\u8BA4\u53EF\u4E1C\u65B9\u65E5\u5347\u5F3A\u52B2\u6280\u672F\u5B9E\u529B\uFF0C\u5E76\u6388\u4E88\u516C\u53F8\u201C2022\u5E74\u5EA6\u5353\u8D8A\u592A\u9633\u80FD\u6280\u672F\u5956\u201D\u5927\u5956\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2022/11/frc-33f9f287d7bef5727266f8cbfd315eaf.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u4F5C\u4E3A\u5168\u7403\u62E5\u6709\u6700\u9AD8\u5149\u4F0F\u53D1\u7535\u6F5C\u529B\u7684\u56FD\u5BB6\u4E4B\u4E00\uFF0C\u5149\u7167\u5F3A\u5EA6\u9AD8\u8FBE1400-1900kW\u0026#183;h/m\u0026#178;\u3002\u201C\u78B3\u4E2D\u548C\u201D\u80CC\u666F\u4E0B\uFF0C\u4F34\u968F\u5F53\u5730\u7ECF\u6D4E\u53D1\u5C55\u53CA\u7535\u529B\u9700\u6C42\u91CF\u7684\u6301\u7EED\u6500\u5347\uFF0C\u5149\u4F0F\u4F5C\u4E3A\u5F53\u5730\u80FD\u6E90\u8F6C\u578B\u4E3B\u529B\u53D1\u5C55\u52BF\u5934\u826F\u597D\uFF0C\u603B\u88C5\u673A\u6F5C\u529B\u9884\u8BA1\u8FBE269GW\u3002\u5F02\u8D28\u7ED3\u6280\u672F\u4F5C\u4E3A\u5149\u4F0F\u4EA7\u4E1A\u5347\u7EA7\u53D1\u5C55\u7684\u4EA7\u7269\uFF0C\u53EF\u4E3A\u4EE5\u9A6C\u6765\u897F\u4E9A\u4E3A\u4EE3\u8868\u7684\u5927\u578B\u65B0\u5174\u5E02\u573A\u5E26\u6765\u201C\u5F2F\u9053\u8D85\u8F66\u201D\u65B0\u673A\u9047\uFF0C\u66F4\u9AD8\u7684\u80FD\u91CF\u5BC6\u5EA6\u589E\u52A0\u88C5\u673A\u6548\u7387\u3001\u66F4\u4F4E\u7684BOS\u4E0E\u5EA6\u7535\u6210\u672C\u964D\u4F4E\u521D\u59CB\u6295\u8D44\uFF0C\u6709\u52A9\u4E8E\u9A6C\u6765\u897F\u4E9A\u5728\u77ED\u65F6\u95F4\u8FDB\u884C\u5927\u89C4\u6A21\u3001\u9AD8\u8D28\u91CF\u88C5\u673A\u884C\u52A8\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E1C\u65B9\u65E5\u5347\u6301\u7EED\u6DF1\u8015\u5F02\u8D28\u7ED3\u6280\u672F\u5F00\u5C55\u521B\u65B0\u7814\u53D1\uFF0C\u4F9D\u6258\u8584\u7247\u5316\u3001\u5FAE\u6676\u53CA\u4F4E\u94F6\u542B\u6D46\u6599\u7B49\u6838\u5FC3\u6280\u672F\uFF0C\u5F00\u53D1\u5168\u65B0\u5927\u5C3A\u5BF8\u9AD8\u6548\u5F02\u8D28\u7ED3\u7EC4\u4EF6Hyper-ion\u4F0F\u66E6\u7CFB\u5217\u3002\u8BE5\u7CFB\u5217\u7EC4\u4EF6\u62E5\u6709700W\u002B\u8D85\u9AD8\u7EC4\u4EF6\u529F\u7387\uFF0C\u7EFC\u5408\u53D1\u7535\u6536\u76CA\u9886\u5148\u884C\u4E1A\u3002\u66F4\u9AD8\u7684\u7EC4\u4E32\u529F\u7387\u964D\u4F4EBOS\u6210\u672C\uFF0C\u53D1\u7535\u91CF\u63D0\u5347\u5219\u8FDB\u4E00\u6B65\u7A00\u91CALCOE\uFF0C\u663E\u8457\u63D0\u9AD8\u88C5\u673A\u7ECF\u6D4E\u6536\u76CA\u3002\u4F0F\u66E6\u7CFB\u5217\u540C\u6B65\u642D\u8F7D\u4E1C\u65B9\u65E5\u5347\u72EC\u521B\u7684\u5408\u91D1\u94A2\u8FB9\u6846\uFF0C\u4EA7\u54C1\u78B3\u8DB3\u8FF9\u5927\u5E45\u4F18\u5316\uFF0C\u8DF5\u884C\u5149\u4F0F\u7EFF\u8272\u80FD\u6E90\u73AF\u4FDD\u4F18\u52BF\u3002\u003C/p\u003E\n\u003Cp\u003E\u5148\u8FDB\u6280\u672F\u52A0\u6301\u4E0B\uFF0C\u53E0\u52A0\u4F18\u8D28\u4EA7\u54C1\u53E3\u7891\u4E0E\u5168\u7403\u5316\u54C1\u724C\u5B9E\u529B\uFF0C\u4E1C\u65B9\u65E5\u5347\u83B7\u4E3B\u529E\u65B9\u6388\u4E88\u201C2022\u5E74\u5EA6\u5353\u8D8A\u592A\u9633\u80FD\u6280\u672F\u5956\u201D\uFF0C\u6280\u672F\u5F15\u9886\u578B\u4F01\u4E1A\u7279\u8D28\u518D\u83B7\u5F70\u663E\u3002\u5F6D\u603B\u8868\u793A\uFF1A\u201C\u5956\u9879\u662F\u5BF9\u516C\u53F8\u8FC7\u5F80\u52AA\u529B\u7684\u8BA4\u53EF\uFF0C\u4E1C\u65B9\u65E5\u5347\u5C06\u4EE5\u6B64\u4E3A\u6FC0\u52B1\uFF0C\u56F4\u7ED5210\u3001\u5F02\u8D28\u7ED3\u7B49\u524D\u6CBF\u6280\u672F\uFF0C\u518D\u63A5\u518D\u5389\u521B\u65B0\u7814\u53D1\u66F4\u591A\u9AD8\u529F\u7387\u7EC4\u4EF6\u65B9\u6848\uFF0C\u52A9\u529B\u5BA2\u6237\u8FDB\u884C\u66F4\u5177\u590D\u5408\u4EF7\u503C\u7684\u8131\u78B3\u884C\u52A8\uFF0C\u5171\u521B\u53EF\u6301\u7EED\u7684\u2018\u96F6\u78B3\u672A\u6765\u2019\u3002\u201D\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2022/11/frc-4e878ae5c996273c7966549f65cfc881.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\n\u6765\u6E90\uFF1Ahttps://mp.weixin.qq.com/s/glw0VryPOgnFTDgKWxYeZg\u003C/p\u003E\n",
