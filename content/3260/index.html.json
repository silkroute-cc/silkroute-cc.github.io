  "canonicalUrlKey": "%e8%bf%9e%e9%80%9a%e4%b8%ad%e5%9b%bd%e6%8b%93%e5%b1%95%ef%bd%9c%e3%80%8a%e7%be%8e%e5%be%80%e4%bd%95%e5%a4%84%e5%af%bb-%e6%8e%a2%e7%b4%a2%e4%b8%ad%e5%9b%bd%e6%88%8f",
  "route": "/3260/",
  "title": "\u201C\u8FDE\u901A\u4E2D\u56FD\u201D\u62D3\u5C55\uFF5C\u300A\u7F8E\u5F80\u4F55\u5904\u5BFB\u2014\u2014\u63A2\u7D22\u4E2D\u56FD\u620F\u66F2\u4E4B\u7F8E\u300B\u8BB2\u5EA7\uFF0C\u5F00\u653E\u62A5\u540D\uFF01",
  "summary": "\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3 Zoom \u7EBF\u4E0A\u7CFB\u5217\u4E13\u9898\u8BB2 \u5EA7 2023 \u7678\u536F\u5E74\u7EE7\u7EED\u5F00\u8BB2\uFF01\u7279\u522B\u9080\u8BF7 \u4E2D\u592E\u620F\u5267\u5B66\u9662\u4EAC\u5267\u7CFB\u8BB2\u5E08 \u3001 \u4E2D\u56FD\u620F\u66F2\u5B66\u9662\u4EAC\u5267\u8868\u6F14\u7855\u58EB \u6768\u7426\u8001\u5E08 \u4E3B\u8BB2\uFF0C\u4EE5\u4E2D\u56FD\u620F\u66F2\u8868\u6F14\u827A\u672F\u4E3A\u4E3B\u9898\uFF0C \u7ED3\u5408\u7CBE\u5F69\u8BB2\u89E3\u4E0E\u8868\u6F14\u5F62\u5F0F\u5C55\u793A\u4E2D\u56FD\u620F\u66F2\u8F7D\u6B4C\u8F7D\u821E\uFF0C\u7CBE\u6E5B\u6DB5\u539A\u7684\u8868\u6F14\u827A\u672F\u6587\u5316\u3002 \u620F\u66F2\u4F5C\u4E3A\u4E2D\u534E\u6587\u660E\u7684\u91CD\u8981\u6587\u5316\u8F7D\u4F53\uFF0C\u6C89\u6DC0\u4E86\u4E2D\u56FD\u4EBA\u5343\u767E\u5E74\u7684\u5FC3\u7075\u4E16\u754C\uFF0C\u6ECB\u517B\u7740\u4E2D\u56FD\u4EBA\u6700\u5178\u578B\u7684\u4F20\u7EDF\u5BA1\u7F8E\u3002\u4E3B\u8BB2\u4EBA\u5C06\u4ECE\u620F\u66F2\u8868\u6F14\u3001\u620F\u66F2\u670D\u9970\u3001\u620F\u66F2\u88C5\u626E\u3001\u620F\u66F2\u821E\u53F0\u7EFC\u5408\u5448\u73B0\u7B49\u65B9\u9762\u591A\u7EF4\u5EA6\u63A2\u7D22\u4E2D\u56FD\u620F\u66F2\u7684\u827A\u672F\u7279\u70B9\u3001\u5BA1\u7F8E\u4EF7\u503C\u3001\u6587\u5316\u610F\u4E49\uFF0C\u8BA9\u9A6C\u6765\u897F\u4E9A\u6C11\u4F17\u611F\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2022/12/frc-73f91a6199c7dcf38ea79404d7c6660e.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3Zoom\u7EBF\u4E0A\u7CFB\u5217\u4E13\u9898\u8BB2\u5EA72023\u7678\u536F\u5E74\u7EE7\u7EED\u5F00\u8BB2\uFF01\u7279\u522B\u9080\u8BF7\u4E2D\u592E\u620F\u5267\u5B66\u9662\u4EAC\u5267\u7CFB\u8BB2\u5E08\u3001\u4E2D\u56FD\u620F\u66F2\u5B66\u9662\u4EAC\u5267\u8868\u6F14\u7855\u58EB\u6768\u7426\u8001\u5E08\u4E3B\u8BB2\uFF0C\u4EE5\u4E2D\u56FD\u620F\u66F2\u8868\u6F14\u827A\u672F\u4E3A\u4E3B\u9898\uFF0C\u7ED3\u5408\u7CBE\u5F69\u8BB2\u89E3\u4E0E\u8868\u6F14\u5F62\u5F0F\u5C55\u793A\u4E2D\u56FD\u620F\u66F2\u8F7D\u6B4C\u8F7D\u821E\uFF0C\u7CBE\u6E5B\u6DB5\u539A\u7684\u8868\u6F14\u827A\u672F\u6587\u5316\u3002\u003C/p\u003E\n\u003Cp\u003E\u620F\u66F2\u4F5C\u4E3A\u4E2D\u534E\u6587\u660E\u7684\u91CD\u8981\u6587\u5316\u8F7D\u4F53\uFF0C\u6C89\u6DC0\u4E86\u4E2D\u56FD\u4EBA\u5343\u767E\u5E74\u7684\u5FC3\u7075\u4E16\u754C\uFF0C\u6ECB\u517B\u7740\u4E2D\u56FD\u4EBA\u6700\u5178\u578B\u7684\u4F20\u7EDF\u5BA1\u7F8E\u3002\u4E3B\u8BB2\u4EBA\u5C06\u4ECE\u620F\u66F2\u8868\u6F14\u3001\u620F\u66F2\u670D\u9970\u3001\u620F\u66F2\u88C5\u626E\u3001\u620F\u66F2\u821E\u53F0\u7EFC\u5408\u5448\u73B0\u7B49\u65B9\u9762\u591A\u7EF4\u5EA6\u63A2\u7D22\u4E2D\u56FD\u620F\u66F2\u7684\u827A\u672F\u7279\u70B9\u3001\u5BA1\u7F8E\u4EF7\u503C\u3001\u6587\u5316\u610F\u4E49\uFF0C\u8BA9\u9A6C\u6765\u897F\u4E9A\u6C11\u4F17\u611F\u53D7\u4E2D\u56FD\u4F20\u7EDF\u827A\u672F\u7684\u72EC\u7279\u9B45\u529B\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u7EBF\u4E0A\u8BFE\u7A0B\u4EAE\u70B9\uFF1A\u6B23\u8D4F\u5317\u4EAC\u56FD\u5BB6\u4EAC\u5267\u9662\u5C55\u9648\u9986\uFF0C\u89E3\u8BFB\u540D\u4F5C\u300A\u9501\u9E9F\u56CA\u300B\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u6B64\u7EBF\u4E0A\u8BB2\u5EA7\u5C06\u4E8E\u003Cstrong\u003E2023\u5E741\u67083\u65E5\u8D77\u5F00\u8BB2\u003C/strong\u003E\uFF01\u8BB2\u5EA7\u4E2D\uFF0C\u8001\u5E08\u5C06\u5E26\u7740\u5B66\u5458\u6C89\u6D78\u5F0F\u4F53\u9A8C\u620F\u66F2\u65E6\u89D2\u5986\u53D1\u3001\u5C55\u793A\u5316\u5986\u3001\u5305\u5934\u7684\u8FC7\u7A0B\u3002\u003C/p\u003E\n\u003Cp\u003E\u8001\u5E08\u8FD8\u5C06\u5E26\u5927\u5BB6\u6B23\u8D4F\u56FD\u5BB6\u4EAC\u5267\u9662\u2014\u2014\u4EAC\u5267\u827A\u672F\u5C55\u9648\u9986\uFF0C\u8BA9\u620F\u66F2\u85CF\u54C1\u56DE\u5F52\u821E\u53F0\u827A\u672F\uFF0C\u901A\u8FC7\u89C6\u9891\u8BB2\u89E3\u5C55\u793A\u4EAC\u5267\u540D\u5BB6\u66FE\u7528\u7684\u4EAC\u5267\u6587\u7269\uFF0C\u4EAC\u5267\u670D\u9970\uFF0C\u9053\u5177\uFF0C\u5B8B\u88C5\u5B9E\u7269\u7B49\uFF0C\u6709\u4EAC\u5267\u6B66\u751F\uFF0C\u8001\u751F\u674E\u5C11\u6625\u5148\u751F\u5728\u4F20\u4E16\u540D\u4F5C\u300A\u91CE\u732A\u6797\u300B\u4E2D\u6240\u7528\u7684\u84DD\u8936\u5B50\u539F\u7269\uFF0C\u4EAC\u5267\u5C0F\u751F\u5927\u5E08\u53F6\u76DB\u5170\u5148\u751F\u5728\u821E\u53F0\u4E0A\u7528\u8FC7\u7684\u767D\u87D2\uFF0C\u867D\u5DF2\u89C1\u6591\u9A73\uFF0C\u5374\u4F9D\u7136\u62B9\u4E0D\u53BB\u5B83\u7684\u5149\u5F69\uFF01\u540C\u65F6\uFF0C\u4E3B\u8BB2\u4EBA\u8FD8\u5C06\u4E0E\u5927\u5BB6\u4E00\u8D77\u89E3\u8BFB\u4EAC\u5267\u540D\u4F5C\u300A\u9501\u9E9F\u56CA\u300B\u3002\u003C/p\u003E\n\u003Cp\u003E\u8BB2\u5EA7\u4E0D\u9650\u5E74\u9F84\uFF0C\u6B22\u8FCE\u70ED\u7231\u4E2D\u56FD\u620F\u66F2\u827A\u672F\u7684\u4F60\u53C2\u4E0E\uFF0C\u4E00\u8D77\u6B23\u8D4F\u4E2D\u56FD\u620F\u66F2\u827A\u672F\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E3B\u9898\uFF1A\u300A\u7F8E\u5F80\u4F55\u5904\u5BFB\u2014\u2014\u63A2\u7D22\u4E2D\u56FD\u620F\u66F2\u4E4B\u7F8E\u300B\u003C/p\u003E\n\u003Cp\u003E\u4E3B\u8BB2\u4EBA\uFF1A\u6768\u7426\u8001\u5E08\u003C/p\u003E\n\u003Cp\u003E\u65E5\u671F\uFF1A3.1.2023-17.1.2023 \n\u7B2C\u4E00\u8BB2 | 1\u6708 3\u65E5 \u300A\u4E2D\u56FD\u620F\u66F2\u8868\u6F14\u4E4B\u7F8E\u300B\n\u7B2C\u4E8C\u8BB2 | 1\u670810\u65E5 \u300A\u4E2D\u56FD\u620F\u66F2\u670D\u9970\u4E4B\u7F8E\u300B\n\u7B2C\u4E09\u8BB2 | 1\u670813\u65E5 \u300A\u4E2D\u56FD\u620F\u66F2\u68B3\u5986\u4E4B\u7F8E\u300B\n\u7B2C\u56DB\u8BB2 | 1\u670817\u65E5 \u300A\u4E2D\u56FD\u620F\u66F2\u7EFC\u5408\u4E4B\u7F8E\u300B\n\u65F6\u95F4\uFF1A8PM\n\u5A92\u4ECB\u8BED\uFF1A\u4E2D\u6587\u003C/p\u003E\n\u003Cp\u003E\u62A5\u540D\u94FE\u63A5\uFF1Ahttps://bit.ly/3urBOLD\u003C/p\u003E\n\u003Cp\u003E\u540D\u989D\u6709\u9650\uFF0C\u62A5\u540D\u4ECE\u901F\uFF0C\u4EE5\u514D\u5411\u9685\uFF01\u003C/p\u003E\n\u003Cp\u003E\u8BE2\u95EE: edu@chinaculturalcentre.my\u003C/p\u003E\n\u003Cp\u003E\u66F4\u591A\u8BE6\u60C5,\u8BF7\u6D4F\u89C8\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u003C/p\u003E\n\u003Cp\u003E\u5B98\u7F51\uFF1Ahttp://www.chinaculturalcentre.my\u003C/p\u003E\n\u003Cp\u003E\u9762\u5B50\u4E66\uFF1A\u201CChina Cultural Centre in Kuala Lumpur\u201D\u3001\u003C/p\u003E\n\u003Cp\u003E\u5FAE\u4FE1\u516C\u4F17\u53F7\uFF1A\u201C\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u201D\u003C/p\u003E\n\u003Cp\u003E- End -\n\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u957F\u6309\u8BC6\u522B\u4E8C\u7EF4\u7801\n\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u83B7\u53D6\u66F4\u591A\u7CBE\u5F69\u5185\u5BB9\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u25BC\u003C/strong\u003E\n\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2022/12/frc-393d7a99f3f2b62d8101a4e46568d89f.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2022/12/frc-55a705354cac3bb838e283010202f339.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2022/12/frc-e592b6d7fcb0f17eb92480e99a800f61.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2022/12/frc-38bc8c97af1c04b93222b36dcb5bbbce.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2022/12/frc-66f61deeda48ac066eaadc74e0ff7ca3.gif\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5206\u4EAB\u003C/p\u003E\n\u00