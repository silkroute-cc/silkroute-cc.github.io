{
  "id": "\u9A6C\u6765\u897F\u4E9A\u9996\u4E2A\u5E76\u7F51\u50A8\u80FD\u7CFB\u7EDF\u542F\u7528-\u5BB9\u91CF100\u5146\u74E6-\u4F9B\u4E1C\u6D77\u5CB84\u4E07\u6237",
  "slug": "\u9A6C\u6765\u897F\u4E9A\u9996\u4E2A\u5E76\u7F51\u50A8\u80FD\u7CFB\u7EDF\u542F\u7528-\u5BB9\u91CF100\u5146\u74E6-\u4F9B\u4E1C\u6D77\u5CB84\u4E07\u6237",
  "canonicalUrlKey": "\u9A6C\u6765\u897F\u4E9A\u9996\u4E2A\u5E76\u7F51\u50A8\u80FD\u7CFB\u7EDF\u542F\u7528-\u5BB9\u91CF100\u5146\u74E6-\u4F9B\u4E1C\u6D77\u5CB84\u4E07\u6237",
  "route": "/5972/",
  "title": "\u9A6C\u6765\u897F\u4E9A\u9996\u4E2A\u5E76\u7F51\u50A8\u80FD\u7CFB\u7EDF\u542F\u7528 \u5BB9\u91CF100\u5146\u74E6 \u4F9B\u4E1C\u6D77\u5CB84\u4E07\u6237",
  "summary": "\u9A6C\u6765\u897F\u4E9A\u56FD\u5BB6\u80FD\u6E90\u5728\u767B\u5609\u697C\u9F99\u8FD0\u542F\u7528\u9A6C\u6765\u897F\u4E9A\u9996\u4E2A\u5E76\u7F51\u7535\u6C60\u50A8\u80FD\u7CFB\u7EDF\uFF08BESS\uFF09\uFF0C\u5BB9\u91CF100\u5146\u74E6\u3001\u50A8\u80FD\u80FD\u529B400\u5146\u74E6\u65F6\u3002\u8BE5\u7CFB\u7EDF\u91C7\u7528\u6DB2\u51B7\u6280\u672F\u4E0E\u7535\u7F51\u6210\u5F62\u80FD\u529B\uFF0C\u53EF\u50A8\u5B58\u592A\u9633\u80FD\u7B49\u53EF\u518D\u751F\u80FD\u6E90\u591A\u4F59\u7535\u529B\u5E76\u7075\u6D3B\u8C03\u914D\uFF0C\u9879\u76EE\u4EC5\u8017\u65F6309\u5929\u5B8C\u5DE5\uFF0C\u5C55\u73B0\u9A6C\u6765\u897F\u4E9A\u65B0\u80FD\u6E90\u57FA\u7840\u8BBE\u65BD\u5EFA\u8BBE\u7684\u9AD8\u6548\u7387\u3002",
  "body": "\u003Cimg src=\u0022https://mmbiz.qpic.cn/sz_mmbiz_png/LRoqHEicY0hs1RmIIc2AtYt5m8LCS1o7j3euOnQVVDkfFt74FkLvuaKibS8icwpMD6GE4l9AX5ZayRHOMUmEFlnJOEg0UFSKSxV9vKG5wI8YCw/640?wx_fmt=png\u0026amp;from=appmsg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\uFF08\u9F99\u8FD018\u65E5\u8BAF\uFF09\u9A6C\u6765\u897F\u4E9A\u56FD\u5BB6\u80FD\u6E90\uFF08TENAGA\uFF0C5347\uFF0C\u4E3B\u677F\u516C\u7528\u4E8B\u4E1A\u80A1\uFF09\u5DF2\u5728\u767B\u5609\u697C\u9F99\u8FD0\u5723\u4E1C132/33\u5343\u4F0F\u7279\u4E3B\u8981\u5165\u7535\u53D8\u538B\u7AD9\uFF0C\u542F\u7528\u9A6C\u6765\u897F\u4E9A\u9996\u4E2A\u5E76\u7F51\u7535\u6C60\u50A8\u80FD\u7CFB\u7EDF\uFF08BESS\uFF09\u3002\u003C/p\u003E\n\u003Cp\u003E\u8BE5\u7CFB\u7EDF\u5BB9\u91CF\u4E3A100\u5146\u74E6\uFF0C\u50A8\u80FD\u80FD\u529B\u8FBE400\u5146\u74E6\u65F6\uFF0C\u65E8\u5728\u63D0\u5347\u9A6C\u6765\u897F\u4E9A\u56FD\u5BB6\u7535\u7F51\u7A33\u5B9A\u6027\uFF0C\u5E76\u914D\u5408\u9A6C\u6765\u897F\u4E9A\u53EF\u518D\u751F\u80FD\u6E90\u8F6C\u578B\u3002\u003C/p\u003E\n\u003Cp\u003E\u8BE5\u9879\u5177\u6709\u91CC\u7A0B\u7891\u610F\u4E49\u7684\u9879\u76EE\uFF0C\u662F\u7531\u9A6C\u6765\u897F\u4E9A\u526F\u9996\u76F8\u517C\u80FD\u6E90\u53CA\u6C34\u52A1\u8F6C\u578B\u90E8\u957F\u62FF\u7763\u65AF\u91CC\u6CD5\u8FEA\u62C9\u5C24\u7D22\u592B\u4E3B\u6301\u542F\u7528\u793C\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/sz_mmbiz_png/LRoqHEicY0ht3s6ZpYxs3UatlK1tExHZm7ovcl2KT0a8DiasyP7R6HStib91ORzU7oJSegm3QHb6Rfce0OC2HXmFgKPO0xky7BEqJueMFgyNhk/640?wx_fmt=png\u0026amp;from=appmsg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u8FD9\u4E5F\u662F\u9A6C\u6765\u897F\u4E9A\u56FD\u80FD\u914D\u5408\u56FD\u5BB6\u80FD\u6E90\u8F6C\u578B\u8DEF\u7EBF\u56FE\uFF08NETR\uFF09\uFF0C\u4F5C\u4E3A\u5F3A\u5316\u56FD\u5BB6\u7535\u7F51\u57FA\u7840\u8BBE\u65BD\u7684\u5176\u4E2D\u4E00\u9879\u5173\u952E\u8BA1\u5212\u3002\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u56FD\u80FD\u603B\u88C1\u517C\u603B\u6267\u884C\u957F\u62FF\u7763\u4E09\u82CF\u963F\u672B\u6307\u51FA\uFF0C\u8BE5\u8BBE\u65BD\u7684\u8FD0\u4F5C\u539F\u7406\u72B9\u5982\u4E00\u4E2A\u5927\u578B\u7684\u80FD\u6E90\u94F6\u884C\u3002\u003C/p\u003E\n\u003Cp\u003E\u0026quot;\u5B83\u80FD\u591F\u7387\u5148\u50A8\u5B58\u6765\u81EA\u5927\u578B\u592A\u9633\u80FD\u53D1\u7535\u573A\uFF0C\u4EE5\u53CA\u6C34\u529B\u6DF7\u5408\u6F02\u6D6E\u592A\u9633\u80FD\u7CFB\u7EDF\u7B49\u53EF\u518D\u751F\u80FD\u6E90\u6240\u4EA7\u751F\u7684\u591A\u4F59\u7535\u529B\uFF0C\u5E76\u5728\u7535\u7F51\u6709\u9700\u6C42\u65F6\uFF0C\u968F\u65F6\u5C06\u7535\u529B\u8F93\u9001\u56DE\u56FD\u7F51\u3002\u0026quot;\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u8BE5\u7CFB\u7EDF\u91C7\u7528\u4E86\u5148\u8FDB\u7684\u6DB2\u51B7\u6280\u672F\uFF08Liquid Cooling\uFF09\u4EE5\u53CA\u7535\u7F51\u6210\u5F62\uFF08Grid-forming\uFF09\u80FD\u529B\u3002\u8FD9\u4E0D\u4EC5\u80FD\u652F\u6301\u66F4\u5927\u89C4\u6A21\u7684\u53EF\u518D\u751F\u80FD\u6E90\u6574\u5408\uFF0C\u8FD8\u80FD\u5728\u7535\u529B\u4F9B\u9700\u5931\u8861\u65F6\uFF08\u7279\u522B\u662F\u5728\u7528\u7535\u9AD8\u5CF0\u671F\u6216\u7CFB\u7EDF\u53D7\u5230\u5E72\u6270\u671F\u95F4\uFF09\u8FC5\u901F\u505A\u51FA\u53CD\u5E94\u3002\u003C/p\u003E\n\u003Cp\u003E\u521B309\u5929\u6700\u5FEB\u5B8C\u5DE5\u7EAA\u5F55\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u56FD\u80FD\u900F\u9732\uFF0C\u6839\u636E\u672C\u5730\u7684\u7528\u7535\u6A21\u5F0F\u8BA1\u7B97\uFF0C\u5723\u4E1C\u7535\u6C60\u50A8\u80FD\u7CFB\u7EDF\uFF08Santong BESS\uFF09\u6709\u80FD\u529B\u4E3A\u4E1C\u6D77\u5CB8\u7EA64\u4E07\u6237\u5BB6\u5EAD\u63D0\u4F9B\u540C\u7B49\u89C4\u6A21\u7684\u7535\u529B\u9700\u6C42\u652F\u63F4\u3002\u003C/p\u003E\n\u003Cp\u003E\u503C\u5F97\u4E00\u63D0\u7684\u662F\uFF0C\u8BE5\u9879\u76EE\u4ECE\u52A8\u5DE5\u5174\u5EFA\u5230\u6B63\u5F0F\u6295\u5165\u8FD0\u4F5C\uFF0C\u4EC5\u8017\u65F6309\u5929\u4FBF\u5BA3\u544A\u843D\u6210\uFF0C\u5C55\u73B0\u9A6C\u6765\u897F\u4E9A\u5728\u90E8\u7F72\u5927\u578B\u65B0\u80FD\u6E90\u57FA\u7840\u8BBE\u65BD\u9879\u76EE\u4E0A\u7684\u9AD8\u6548\u7387\u4E0E\u8FC5\u901F\u63A8\u8FDB\u3002\u003C/p\u003E\n\u003Cp\u003E\u968F\u7740\u5168\u9A6C\u6765\u897F\u4E9A\u53EF\u518D\u751F\u80FD\u6E90\u7684\u4F7F\u7528\u7387\u4E0D\u65AD\u6269\u5927\uFF0C\u9A6C\u6765\u897F\u4E9A\u56FD\u80FD\u4E5F\u540C\u6B65\u5F15\u5165\u6570\u5B57\u4E0E\u6570\u636E\u5206\u6790\u7CFB\u7EDF\uFF0C\u4EE5\u8FBE\u7CBE\u786E\u9884\u6D4B\u7535\u529B\u9700\u6C42\u3001\u4F18\u5316\u7535\u529B\u5206\u914D\uFF0C\u5E76\u8FDB\u884C\u5B9E\u65F6\u8D44\u4EA7\u76D1\u6D4B\uFF0C\u4EE5\u5168\u9762\u63D0\u5347\u9A6C\u6765\u897F\u4E9A\u56FD\u5BB6\u7535\u7F51\u7684\u6574\u4F53\u6548\u7387\u4E0E\u8FD0\u4F5C\u7075\u6D3B\u6027\u3002\u003C/p\u003E\n",
