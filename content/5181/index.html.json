  "canonicalUrlKey": "8%e5%b9%b4%e6%9d%a5%e6%9c%80%e9%ab%98%e6%8e%92%e5%90%8d-%e5%a4%a7%e9%a9%ac%e5%88%9b%e6%96%b0%e5%8a%9b%e5%85%a8%e7%90%83%e7%ac%ac33",
  "route": "/5181/",
  "title": "8\u5E74\u6765\u6700\u9AD8\u6392\u540D \u5927\u9A6C\u521B\u65B0\u529B\u5168\u7403\u7B2C33",
  "summary": "\u9A6C\u65B0\u793E \uFF08\u5E03\u57CE26\u65E5\u8BAF\uFF09\u5927\u9A6C\u5728\u4E16\u754C\u77E5\u8BC6\u4EA7\u6743\u7EC4\u7EC72024\u5E74\u5168\u7403\u521B\u65B0\u6307\u6570\u7684\u6392\u540D\u8DC3\u5347\u81F3\u7B2C33\u4F4D\uFF0C\u5199\u4E0B2016\u5E74\u4EE5\u6765\u7684\u6700\u9AD8\u540D\u6B21\u3002 \u8FC7\u53BB3\u5E74\uFF0C\u5927\u9A6C\u90FD\u6392\u540D\u7B2C36\uFF0C\u56E0\u6B64\u4ECA\u5E74\u7684\u6392\u540D\u8DC3\u5347\u662F\u4E00\u5927\u7A81\u7834\u3002 \u5728\u4E1C\u5357\u4E9A\uFF0C\u5927\u9A6C\u7684\u6392\u540D\u4EC5\u6B21\u4E8E\u65B0\u52A0\u5761\uFF0C\u9AD8\u8FC7\u6CF0\u56FD\u3001\u8D8A\u5357\u3001\u5370\u5C3C\u548C\u83F2\u5F8B\u5BBE\u7B49\u5176\u4ED6\u90BB\u56FD\u3002 \u8BE5\u6307\u6570\u6D89\u53CA\u5168\u7403\u7B2C133\u4E2A\u56FD\u5BB6\u548C\u5730\u533A\uFF0C\u65B0\u52A0\u5761\u6392\u540D\u5168\u7403\u7B2C\u56DB\u3002 \u7136\u800C\uFF0C\u5927\u9A6C\u4ECA\u5E74\u5728\u8FD9\u4EFD\u62A5\u544A\u7684\u5F97\u5206\u4E3A 40.5\uFF0C\u7565\u4F4E\u4E8E\u53BB\u5E74\u768440.9\u3002 \u79D1\u5B66\u3001\u5DE5\u827A\u53CA\u9769\u65B0\u90E8\u4ECA\u65E5\u53D1\u6587\u544A\u8BF4\uFF0C\u8FD9\u662F\u5927\u9A6C\u5728\u8FDE\u7EED3\u5E74\u6392\u540D\u7B2C36\u4F4D\u4E4B\u540E\u53D6\u5F97\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/09/frc-df8e58aec34cf06dd9a8a8dd89fca9af.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u9A6C\u65B0\u793E\u003C/p\u003E\n\u003Cp\u003E\uFF08\u5E03\u57CE26\u65E5\u8BAF\uFF09\u5927\u9A6C\u5728\u4E16\u754C\u77E5\u8BC6\u4EA7\u6743\u7EC4\u7EC72024\u5E74\u5168\u7403\u521B\u65B0\u6307\u6570\u7684\u6392\u540D\u8DC3\u5347\u81F3\u7B2C33\u4F4D\uFF0C\u5199\u4E0B2016\u5E74\u4EE5\u6765\u7684\u6700\u9AD8\u540D\u6B21\u3002\u003C/p\u003E\n\u003Cp\u003E\u8FC7\u53BB3\u5E74\uFF0C\u5927\u9A6C\u90FD\u6392\u540D\u7B2C36\uFF0C\u56E0\u6B64\u4ECA\u5E74\u7684\u6392\u540D\u8DC3\u5347\u662F\u4E00\u5927\u7A81\u7834\u3002\u003C/p\u003E\n\u003Cp\u003E\u5728\u4E1C\u5357\u4E9A\uFF0C\u5927\u9A6C\u7684\u6392\u540D\u4EC5\u6B21\u4E8E\u65B0\u52A0\u5761\uFF0C\u9AD8\u8FC7\u6CF0\u56FD\u3001\u8D8A\u5357\u3001\u5370\u5C3C\u548C\u83F2\u5F8B\u5BBE\u7B49\u5176\u4ED6\u90BB\u56FD\u3002\u003C/p\u003E\n\u003Cp\u003E\u8BE5\u6307\u6570\u6D89\u53CA\u5168\u7403\u7B2C133\u4E2A\u56FD\u5BB6\u548C\u5730\u533A\uFF0C\u65B0\u52A0\u5761\u6392\u540D\u5168\u7403\u7B2C\u56DB\u3002\u003C/p\u003E\n\u003Cp\u003E\u7136\u800C\uFF0C\u5927\u9A6C\u4ECA\u5E74\u5728\u8FD9\u4EFD\u62A5\u544A\u7684\u5F97\u5206\u4E3A 40.5\uFF0C\u7565\u4F4E\u4E8E\u53BB\u5E74\u768440.9\u3002\u003C/p\u003E\n\u003Cp\u003E\u79D1\u5B66\u3001\u5DE5\u827A\u53CA\u9769\u65B0\u90E8\u4ECA\u65E5\u53D1\u6587\u544A\u8BF4\uFF0C\u8FD9\u662F\u5927\u9A6C\u5728\u8FDE\u7EED3\u5E74\u6392\u540D\u7B2C36\u4F4D\u4E4B\u540E\u53D6\u5F97\u7684\u663E\u8457\u8FDB\u6B65\uFF0C\u663E\u793A\u6211\u56FD\u6301\u7EED\u81F4\u529B\u4E8E\u6539\u5584\u56FD\u5BB6\u521B\u65B0\u751F\u6001\u7CFB\u7EDF\uFF0C\u5E76\u8FDB\u800C\u63D0\u9AD8\u6211\u56FD\u5728\u5168\u7403\u7684\u7ADE\u4E89\u529B\u3002\u003C/p\u003E\n\u003Cp\u003E\u5728\u62A5\u544A\u4E2D36\u4E2A\u4E2D\u4E0A\u7B49\u6536\u5165\u56FD\u5BB6\u548C\u5730\u533A\u5F53\u4E2D\uFF0C\u5927\u9A6C\u662F\u7EE7\u4E2D\u56FD\u4E4B\u540E\uFF0C\u521B\u65B0\u80FD\u529B\u7B2C\u4E8C\u9AD8\u7684\u56FD\u5BB6\u3002\u003C/p\u003E\n\u003Cp\u003E\u5927\u9A6C\u4E5F\u5728\u8BE5\u6307\u6570\u76843\u4E2A\u6307\u6807\u4E2D\u4FDD\u6301\u7B2C\u4E00\uFF0C\u5373\u79D1\u5B66\u4E0E\u5DE5\u7A0B\u4E13\u4E1A\u6BD5\u4E1A\u751F\u3001\u9AD8\u79D1\u6280\u51FA\u53E3\u53CA\u521B\u610F\u4EA7\u54C1\u51FA\u53E3\u3002\u003C/p\u003E\n\u003Cp\u003E\u8BE5\u90E8\u8868\u793A\uFF0C\u5409\u9686\u5761\u8FD8\u88AB\u5217\u4E3A\u5168\u7403\u767E\u5927\u79D1\u5B66\u4E0E\u79D1\u6280\u96C6\u7FA4\u4E4B\u4E00\uFF0C\u6392\u540D\u7B2C93\u4F4D\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u8FD9\u662F\u5927\u9A6C\u81EA 2016 \u5E74\u4EE5\u6765\u9996\u6B21\u4E0A\u699C\uFF0C\u8BC1\u660E\u9A6C\u6765\u897F\u4E9A\u4F5C\u4E3A\u4E1C\u5357\u4E9A\u5730\u533A\u521B\u65B0\u548C\u8FDB\u6B65\u79D1\u6280\u4E2D\u5FC3\u7684\u5730\u4F4D\u65E5\u76CA\u589E\u5F3A\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u4E3A\u786E\u4FDD\u9A6C\u6765\u897F\u4E9A\u57282025\u5E74\u8FDB\u5165\u5168\u7403\u521B\u65B0\u6307\u6570\u524D30\u540D\uFF0C\u79D1\u5B66\u3001\u5DE5\u827A\u53CA\u9769\u65B0\u90E8\u6B63\u4E0E\u5404\u90A6\u5DDE\u653F\u5E9C\u5408\u4F5C\u5236\u5B9A\u9A6C\u6765\u897F\u4E9A\u521B\u65B0\u6307\u6570\uFF0C\u8BE5\u6307\u6570\u5C06\u4E8E\u660E\u5E74\u63A8\u51FA\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u8FD9\u9879\u4E3E\u63AA\u65E8\u5728\u786E\u5B9A\u6BCF\u4E2A\u90A6\u548C\u5DDE\u5C5E\u521B\u65B0\u751F\u6001\u7CFB\u7EDF\u7684\u4F18\u52BF\u548C\u52A3\u52BF\uFF0C\u4ECE\u800C\u91C7\u53D6\u5E72\u9884\u63AA\u65BD\u6765\u52A0\u5F3A\u56FD\u5BB6\u751F\u6001\u7CFB\u7EDF\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u5B83\u8865\u5145\uFF0C\u6B64\u4E3E\u7B26\u5408\u9A6C\u6765\u897F\u4E9A\u516C\u6C11\u653F\u7B56\u6846\u67B6\u7684\u627F\u8BFA\uFF0C\u5373\u786E\u4FDD\u5927\u9A6C\u57282030\u5E74\u6210\u4E3A\u4E00\u4E2A\u521B\u65B0\u578B\u56FD\u5BB6\u548C\u79D1\u6280\u751F\u4EA7\u56FD\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/YHPmsGOc8NtSjVK6q6-BGw\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
