  "title": "\u9A6C\u6765\u897F\u4E9A\u4EA4\u901A\u90E8\u957F\uFF1A7\u4EFD\u9686\u65B0\u9AD8\u94C1\u9879\u76EE\u5EFA\u8BAE\u4E66 \u9A6C\u9AD8\u94C1\u673A\u6784\u97002\u4E2A\u6708\u8BC4\u4F30",
  "summary": "\u4EA4\u901A\u90E8\u957F\u9646\u5146\u798F\u8868\u793A\uFF0C\u76EE\u524D\u5927\u9A6C\u9AD8\u94C1\u673A\u6784\uFF08MyHSR Corp\uFF09\u6B63\u5BF97\u4EFD\u9686\u65B0\u9AD8\u94C1\u7684\u9879\u76EE\u5EFA\u8BAE\u4E66\uFF08Project Proposal\uFF09\u8FDB\u884C\u8BC4\u4F30\u3002 \u4ED6\u6307\u51FA\uFF0C\u8FD9\u4E9B\u5EFA\u8BAE\u4E66\u6765\u81EA\u672C\u5730\u53CA\u56FD\u9645\u8D22\u56E2\uFF0C\u8BE5\u673A\u6784\u4F30\u8BA1\u9700\u89812\u4E2A\u6708\u7684\u4E8B\u4EF6\u8FDB\u884C\u8BC4\u4F30\u3002 \u4ED6\u8868\u793A\uFF0C\u8BC4\u4F30\u7ED3\u679C\u5C06\u63D0\u5448\u7ED9\u653F\u5E9C\u5BFB\u6C42\u901A\u8FC7\uFF0C\u4EE5\u4FBF\u80FD\u591F\u5C06\u7B26\u5408\u8D44\u683C\u7684\u8D22\u56E2\u5217\u5165\u540D\u5355\u4EE5\u8FDB\u884C\u9700\u6C42\u5EFA\u8BAE\u4E66\uFF08RFP\uFF09\u7A0B\u5E8F\u3002 \u9646\u5146\u798F\u5468\u4E8C\u900F\u8FC7\u56FD\u4F1A\u4E66\u9762\uFF0C\u7B54\u590D\u56DB\u52A0\u4EAD\u56FD\u4F1A\u8BAE\u5458\u963F\u7C73\u8BFA\u80E1\u8FBE\u7684\u63D0\u95EE\u65F6\uFF0C\u5982\u662F\u6307\u51FA\u3002 \u6765\u6E90\uFF1A \u9605\u8BFB\u539F\u6587",
