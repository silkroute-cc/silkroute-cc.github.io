  "canonicalUrlKey": "%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e9%a9%bb%e5%8d%8e%e5%a4%a7%e4%bd%bf%e9%a6%86%e6%95%99%e8%82%b2%e5%a4%84",
  "route": "/5711/",
  "title": "\u9A6C\u6765\u897F\u4E9A\u9A7B\u534E\u5927\u4F7F\u9986\u6559\u80B2\u5904",
  "summary": "\u76EE\u524D\uFF0C\u4E2D\u56FD\u5171\u670917\u6240\u9AD8\u6821\u5F00\u8BBE\u9A6C\u6765\u8BED\u8BFE\u7A0B\u3002\u8FC7\u53BB\u516D\u5341\u5E74\u6765\uFF0C\u9A6C\u6765\u8BED\u4E0D\u4EC5\u53D1\u5C55\u52BF\u5934\u826F\u597D\uFF0C\u66F4\u6210\u4E3A\u4E86\u9A6C\u6765\u897F\u4E9A\u4E0E\u4E2D\u56FD\u4E4B\u95F4\u5B66\u672F\u4EA4\u6D41\u548C\u6559\u80B2\u5916\u4EA4\u65E5\u76CA\u7D27\u5BC6\u7684\u8C61\u5F81\u3002 2024\u5E749\u670821\u65E5\uFF0C\u9A6C\u6765\u897F\u4E9A\u6700\u9AD8\u5143\u9996\u6613\u535C\u62C9\u6B23\u6765\u534E\u8FDB\u884C\u56FD\u4E8B\u8BBF\u95EE\uFF0C\u5317\u4EAC\u5916\u56FD\u8BED\u5927\u5B66\u4EE5\u6B64\u4E3A\u5951\u673A\uFF0C\u5C06\u6821\u5185\u539F\u6709\u7684\u9A6C\u6765\u7814\u7A76\u6559\u5E2D\u6B63\u5F0F\u66F4\u540D\u4E3A\u201C\u82CF\u4E39\u6613\u535C\u62C9\u6B23\u9A6C\u6765\u7814\u7A76\u9AD8\u7EA7\u8BBF\u95EE\u5B66\u8005\u6559\u5E2D\u201D\u3002\u6B64\u4E3E\u5145\u5206\u4F53\u73B0\u4E86\u9A6C\u6765\u897F\u4E9A\u738B\u5BA4\u5BF9\u9A6C\u6765\u8BED\u5728\u534E\u63A8\u5E7F\u5DE5\u4F5C\u7684\u5927\u529B\u652F\u6301\u3002 \u8BED\u8A00\u63A8\u5E7F\u9700\u5404\u65B9\u534F\u540C\u53D1\u529B\u3002\u6B63\u5982\u9A6C\u6765\u8C1A\u8BED\u6240\u8A00\uFF0C\u201C\u5982\u848C\u53F6\u822C\u7C07\u62E5\u6210\u675F\uFF0C\u4F3C\u9999\u8305\u822C\u4E1B\u751F\u8FDE\u6839\u201D\u3002\u552F\u6709\u5982\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2025/11/image-2-1024x683.jpg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u76EE\u524D\uFF0C\u4E2D\u56FD\u5171\u670917\u6240\u9AD8\u6821\u5F00\u8BBE\u9A6C\u6765\u8BED\u8BFE\u7A0B\u3002\u8FC7\u53BB\u516D\u5341\u5E74\u6765\uFF0C\u9A6C\u6765\u8BED\u4E0D\u4EC5\u53D1\u5C55\u52BF\u5934\u826F\u597D\uFF0C\u66F4\u6210\u4E3A\u4E86\u9A6C\u6765\u897F\u4E9A\u4E0E\u4E2D\u56FD\u4E4B\u95F4\u5B66\u672F\u4EA4\u6D41\u548C\u6559\u80B2\u5916\u4EA4\u65E5\u76CA\u7D27\u5BC6\u7684\u8C61\u5F81\u3002\u003C/p\u003E\n\u003Cp\u003E2024\u5E749\u670821\u65E5\uFF0C\u9A6C\u6765\u897F\u4E9A\u6700\u9AD8\u5143\u9996\u6613\u535C\u62C9\u6B23\u6765\u534E\u8FDB\u884C\u56FD\u4E8B\u8BBF\u95EE\uFF0C\u5317\u4EAC\u5916\u56FD\u8BED\u5927\u5B66\u4EE5\u6B64\u4E3A\u5951\u673A\uFF0C\u5C06\u6821\u5185\u539F\u6709\u7684\u9A6C\u6765\u7814\u7A76\u6559\u5E2D\u6B63\u5F0F\u66F4\u540D\u4E3A\u201C\u82CF\u4E39\u6613\u535C\u62C9\u6B23\u9A6C\u6765\u7814\u7A76\u9AD8\u7EA7\u8BBF\u95EE\u5B66\u8005\u6559\u5E2D\u201D\u3002\u6B64\u4E3E\u5145\u5206\u4F53\u73B0\u4E86\u9A6C\u6765\u897F\u4E9A\u738B\u5BA4\u5BF9\u9A6C\u6765\u8BED\u5728\u534E\u63A8\u5E7F\u5DE5\u4F5C\u7684\u5927\u529B\u652F\u6301\u3002\u003C/p\u003E\n\u003Cp\u003E\u8BED\u8A00\u63A8\u5E7F\u9700\u5404\u65B9\u534F\u540C\u53D1\u529B\u3002\u6B63\u5982\u9A6C\u6765\u8C1A\u8BED\u6240\u8A00\uFF0C\u201C\u5982\u848C\u53F6\u822C\u7C07\u62E5\u6210\u675F\uFF0C\u4F3C\u9999\u8305\u822C\u4E1B\u751F\u8FDE\u6839\u201D\u3002\u552F\u6709\u5982\u6B64\uFF0C\u8BED\u8A00\u7684\u9886\u609F\u4E4B\u5999\u4E0E\u638C\u63E1\u4E4B\u4E50\uFF0C\u624D\u80FD\u4E3A\u4EBA\u4EEC\u6240\u5171\u611F\u3001\u5171\u4EAB\u3002\u003C/p\u003E\n\u003Cp\u003E2025\u5E749\u670824\u65E5\u81F326\u65E5\uFF0C\u7531\u5E7F\u4E1C\u5916\u8BED\u5916\u8D38\u5927\u5B66\u4E0E\u9A6C\u6765\u4E9A\u5927\u5B66\u5171\u540C\u4E3B\u529E\u7684\u201C2025\u5E74\u9A6C\u6765\u897F\u4E9A\u2014\u4E2D\u56FD\u9A6C\u6765\u7814\u7A76\u5B66\u672F\u8BBA\u575B\u201D\u5728\u5E7F\u4E1C\u5916\u8BED\u5916\u8D38\u5927\u5B66\u6210\u529F\u4E3E\u884C\u3002\u672C\u5C4A\u8BBA\u575B\u4E0D\u4EC5\u4E3A\u4E24\u56FD\u95F4\u7684\u5B66\u672F\u4EA4\u6D41\u642D\u5EFA\u4E86\u5E73\u53F0\uFF0C\u4E5F\u5F70\u663E\u4E86\u6211\u4EEC\u5171\u540C\u81F4\u529B\u4E8E\u5C06\u9A6C\u6765\u8BED\u63D0\u5347\u4E3A\u91CD\u8981\u77E5\u8BC6\u4E0E\u6587\u660E\u8BED\u8A00\u7684\u575A\u5B9A\u627F\u8BFA\u3002\u003C/p\u003E\n\u003Cp\u003E\u6211\u4EEC\u76F8\u4FE1\uFF0C\u5E7F\u4E1C\u5916\u8BED\u5916\u8D38\u5927\u5B66\u2014\u9A6C\u6765\u4E9A\u5927\u5B66\u9A6C\u6765\u7814\u7A76\u4E2D\u5FC3\u5C06\u4E3A\u4E2D\u56FD\u9A6C\u6765\u8BED\u548C\u9A6C\u6765\u6587\u5316\u7814\u7A76\u8005\u3001\u5B66\u4E60\u8005\u53CA\u7231\u597D\u8005\u642D\u5EFA\u201C\u77E5\u8BC6\u6865\u6881\u201D\u3001\u6784\u7B51\u201C\u5B66\u672F\u5BB6\u56ED\u201D\uFF0C\u6301\u7EED\u5438\u5F15\u66F4\u591A\u4EBA\u6295\u8EAB\u9A6C\u6765\u8BED\u7814\u7A76\uFF0C\u5E76\u8FDB\u4E00\u6B65\u62D3\u5C55\u81F3\u9A6C\u6765\u793E\u4F1A\u3001\u9A6C\u6765\u897F\u4E9A\u6587\u5B66\u3001\u5386\u53F2\u3001\u653F\u6CBB\u53CA\u793E\u4F1A\u6587\u5316\u7B49\u591A\u5143\u9886\u57DF\u3002\u003C/p\u003E\n\u003Cp\u003E\u671F\u5F85\u4F9D\u6258\u8BE5\u7814\u7A76\u4E2D\u5FC3\uFF0C\u4E2D\u9A6C\u53CC\u65B9\u80FD\u5728\u5408\u4F5C\u7814\u7A76\u3001\u5E08\u751F\u4E92\u8BBF\u3001\u7ECF\u5178\u4E92\u8BD1\u7B49\u591A\u4E2A\u9886\u57DF\u5F00\u5C55\u66F4\u7D27\u5BC6\u7684\u5408\u4F5C\u3002\u8FD9\u4E0D\u4EC5\u4E0E \u201C\u4E00\u5E26\u4E00\u8DEF\u201D \u5021\u8BAE\u6240\u5021\u5BFC\u7684 \u201C\u6C11\u5FC3\u76F8\u901A\u201D \u7406\u5FF5\u9AD8\u5EA6\u5951\u5408\uFF0C\u4E5F\u5C06\u4E3A\u4E2D\u9A6C\u5171\u521B\u548C\u8C10\u7F8E\u597D\u7684\u672A\u6765\u6CE8\u5165\u65B0\u7684\u52A8\u529B\u3002\u003C/p\u003E\n\u003Cp\u003E\u5728\u6B64\uFF0C\u8C28\u5411\u672C\u6B21\u5B66\u672F\u8BBA\u575B\u7EC4\u59D4\u4F1A\u81F4\u4EE5\u6700\u70ED\u70C8\u7684\u795D\u8D3A\u3002\u613F\u7814\u8BA8\u4F1A\u80FD\u591F\u59CB\u7EC8\u6210\u4E3A\u4FC3\u8FDB\u4E2D\u9A6C\u8BED\u8A00\u6587\u5316\u4EA4\u6D41\u7684\u91CD\u8981 \u201C\u5B66\u672F\u5BB6\u56ED\u201D\uFF0C\u7528\u5B9E\u9645\u6210\u6548\u5370\u8BC1\u201C\u8BED\u8A00\u662F\u6C11\u65CF\u56E2\u7ED3\u7684\u7EBD\u5E26\u201D\u4E4B\u4E00\u6DF1\u523B\u4EF7\u503C\u3002\u003C/p\u003E\n\u003Cp\u003ETingkap papan kayu bersegi,\u003C/p\u003E\n\u003Cp\u003EBatu suasa di Pulau Angsa;\u003C/p\u003E\n\u003Cp\u003EIndah tampan kerana budi,\u003C/p\u003E\n\u003Cp\u003ETinggi bangsa kerana bahasa.\u003C/p\u003E\n\u003Cp\u003E\u7A97\u683C\u56DB\u65B9\u6728\u677F\u9576\uFF0C\u003C/p\u003E\n\u003Cp\u003E\u9E45\u5C9B\u91D1\u77F3\u6620\u8F89\u5149\uFF1B\u003C/p\u003E\n\u003Cp\u003E\u98CE\u534E\u4FCA\u9038\u5FB7\u4E3A\u672C\uFF0C\u003C/p\u003E\n\u003Cp\u003E\u6C11\u65CF\u810A\u6881\u7C4D\u8BED\u5F70\u3002\u003C/p\u003E\n\u003Cp\u003E#BahasaJiwaBangsa\u003C/p\u003E\n\u003Cp\u003E#educationmalaysiadiplomacytour\u003C/p\u003E\n\u003Cp\u003E#research@educationmalaysia\u003C/p\u003E\n\u003Cp\u003E#emb2work2engage2facilitate\u7FFB\u8BD1\uFF1A\u621A\u9896\u7476\u003C/p\u003E\n\u003Cp\u003E\u003Ca href=\u0022https://mp.weixin.qq.com/s?__biz=MzkwNjEwNTA3OA%3D%3D\u0026amp;mid=2247498836\u0026amp;idx=1\u0026amp;sn=467c27cf71b8892f43c8264de940695b\u0026amp;chksm=c14b399324f735f362a62a1ad3e4ea8a380da2d69137f791da0cf745e543de968c0db4f3d26e\u0026amp;forbs=1\u0026amp;scene=126\u0026amp;subscene=91\u0026amp;sessionid=1762676869\u0026amp;flutter_pos=0\u0026amp;clicktime=1762676919\u0026amp;enterid=1762676919\u0026amp;finder_biz_enter_id=5\u0026amp;jumppath=1127_1762676842961%2C1106_1762676851387%2C1001_1762676852168%2C50094_1762676870046\u0026amp;jumppathdepth=4\u0026amp;ascene=56\u0026amp;fasttmpl_type=4\u0026amp;fasttmpl_fullversion=7986945-zh_CN-zip\u0026amp;fasttmpl_flag=0\u0026amp;realreporttime=1762676919587\u0026amp;devicetype=android-36\u0026amp;version=28003e41\u0026amp;nettype=my3g\u0026amp;abtest_cookie=AAACAA%3D%3D\u0026amp;lang=zh_CN\u0026amp;session_us=gh_08002b6879e2\u0026amp;countrycode=MY\u0026amp;exportkey=n_ChQIAhIQSBDuow6IigVgk7hjySl6shLW