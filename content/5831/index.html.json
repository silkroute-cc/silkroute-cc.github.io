  "title": "\u4E2D\u4EA4\u9A6C\u6765\u897F\u4E9A\u6C99\u5DF4\u5B9E\u90A6\u52A0\u7801\u5934\u6269\u5EFA\u9879\u76EE\u7EC4\u7EC7\u591A\u65B9\u4EE3\u8868\u524D\u5F80\u201C\u901A\u745E\u201D\u8F6E\u5F00\u5C55\u8C03\u7814",
  "summary": "\u8FD1\u65E5\uFF0C\u4E2D\u4EA4\u9A6C\u6765\u897F\u4E9A\u6C99\u5DF4\u96C6\u88C5\u7BB1\u7801\u5934\u9879\u76EE\u9879\u76EE\u4E1A\u4E3B\u3001\u54A8\u8BE2\u5DE5\u7A0B\u5E08\u53CAWCT-CCCC JV\u8054\u8425\u4F53\u4EE3\u8868\u4E00\u884C\u8D74\u9879\u76EE\u73B0\u573A\u201C\u901A\u745E\u201D\u8F6E\u5F00\u5C55\u8C03\u7814\uFF0C\u5168\u9762\u4E86\u89E3\u9879\u76EE\u63A8\u8FDB\u60C5\u51B5\u53CA\u65BD\u5DE5\u88C5\u5907\u8FD0\u884C\u60C5\u51B5\u3002 \u8C03\u7814\u671F\u95F4\uFF0C\u9879\u76EE\u90E8\u53CA\u8239\u8236\u4E3B\u8981\u8D1F\u8D23\u4EBA\u56F4\u7ED5\u201C\u901A\u745E\u201D\u8F6E\u7684\u7EFC\u5408\u6280\u672F\u6027\u80FD\u3001\u6838\u5FC3\u65BD\u5DE5\u80FD\u529B\u53CA\u9879\u76EE\u6574\u4F53\u65BD\u5DE5\u7EC4\u7EC7\u60C5\u51B5\uFF0C\u5411\u6765\u8BBF\u4EE3\u8868\u8FDB\u884C\u4E86\u7CFB\u7EDF\u4ECB\u7ECD\u3002\u6765\u8BBF\u4EE3\u8868\u5B9E\u5730\u53C2\u89C2\u4E86\u8239\u8236\u4E3B\u8981\u53CA\u9644\u5C5E\u8BBE\u5907\u3001\u824F\u5439\u88C5\u7F6E\u3001\u52A8\u529B\u7CFB\u7EDF\u548C\u9A7E\u9A76\u64CD\u7EB5\u53F0\u7B49\u5173\u952E\u90E8\u4F4D\uFF0C\u5E76\u5C31\u65BD\u5DE5\u80FD\u529B\u4FDD\u969C\u3001\u8FD0\u884C\u7BA1\u7406\u4F53\u7CFB\u53CA\u5E94\u6025\u7BA1\u7406\u673A\u5236\u7B49\u65B9\u9762\u8FDB\u884C\u4E86\u6DF1\u5165\u4EA4\u6D41\u3002\u2026",
