{
  "id": "\u9A6C\u6765\u897F\u4E9A\u7ADF\u7136\u6709\u8FD9\u6837\u7684\u5C0F\u4F17\u79D8\u5883",
  "slug": "\u9A6C\u6765\u897F\u4E9A\u7ADF\u7136\u6709\u8FD9\u6837\u7684\u5C0F\u4F17\u79D8\u5883",
  "canonicalUrlKey": "\u9A6C\u6765\u897F\u4E9A\u7ADF\u7136\u6709\u8FD9\u6837\u7684\u5C0F\u4F17\u79D8\u5883",
  "route": "/6154/",
  "title": "\uD83C\uDDF2\uD83C\uDDFE\u9A6C\u6765\u897F\u4E9A\u7ADF\u7136\u6709\u8FD9\u6837\u7684\u5C0F\u4F17\u79D8\u5883\uFF1F\uD83C\uDF33\uD83E\uDD29",
  "summary": "\u5E16\u6587\u4ECB\u7ECD\u9A6C\u6765\u897F\u4E9A\u96EA\u5170\u83AA\u4E00\u5904\u5C0F\u4F17\u5EA6\u5047\u79D8\u5883\u2014\u2014\u5750\u843D\u4E8E\u6CB3\u7554\u7684\u73BB\u7483\u5C4B\u6C11\u5BBFTanah Larwina\u3002\u6C11\u5BBF\u85CF\u8EAB\u7EFF\u610F\u76CE\u7136\u7684\u81EA\u7136\u79D8\u5883\uFF0C\u7ED3\u5408\u519C\u573A\u5EFA\u6210\uFF0C\u53EF\u8FD1\u8DDD\u79BB\u63A5\u89E6\u5C0F\u52A8\u7269\uFF0C\u8FDC\u79BB\u57CE\u5E02\u55A7\u56A3\u3002\u4F4F\u5BBF\u65B9\u9762\u63D0\u4F9BRumah Tebing\u5F00\u653E\u5F0F\u7A7A\u95F4\u3001Pod Hijau\u4E0EPod Biru\u5E10\u7BF7\u5F0F\u7761\u7720\u8231\uFF0C\u4EE5\u53CA\u53EF\u8F6C\u6362\u4E3A\u4F1A\u8BAE\u5BA4\u6216\u7948\u7977\u5BA4\u7684Bilik TigaGuna\u7B49\u623F\u578B\u3002\u6587\u4E2D\u8FD8\u5217\u51FA\u6E38\u6CF3\u6CE1\u6C34\u3001\u6EAA\u6D41\u63A2\u7D22\u3001Sungai Larwin\u6EAA\u8FB9\u5782\u9493\u3001\u519C\u573A\u4E92\u52A8\u4E0E\u6C34\u679C\u5B63\u4F53\u9A8C\u7B49\u6D3B\u52A8\uFF0C\u5E76\u63D0\u793A\u53A8\u5177\u3001\u70E7\u70E4\u7089\u3001\u6CF3\u6C60\u3001\u8425\u706B\u8BBE\u5907\u7B49\u8BBE\u65BD\u9F50\u5168\uFF0C\u9644\u4E0A\u5730\u5740\u4E0E\u9884\u8BA2\u5EFA\u8BAE\u3002",
  "body": "\u003Cp\u003E\u5728\u9A6C\u6765\u897F\u4E9A\u60F3\u8981\u9003\u79BB\u7E41\u5FD9\u7684\u751F\u6D3B\uFF0C\u003C/p\u003E\n\u003Cp\u003E\u597D\u597D\u6C89\u6DC0\u4E0B\u6765\u3001\u653E\u677E\u8EAB\u5FC3\uFF0C\u003C/p\u003E\n\u003Cp\u003E\u522B\u9519\u8FC7\u8FD9\u4E2A\u9690\u85CF\u4E8E\u96EA\u5170\u83AA\uFF0C\u003C/p\u003E\n\u003Cp\u003E\u5750\u843D\u4E8E\u6CB3\u7554\u7684\u73BB\u7483\u5C4B\u6C11\u5BBF\u0026#127968;\u003C/p\u003E\n\u003Cp\u003E\u0026#128205;Tanah Larwina\u003C/p\u003E\n\u003Cp\u003E\u0026#129496;\u0026#127995;\u200D\u2640\uFE0F\u611F\u53D7\u4E0E\u4E16\u9694\u7EDD\u7684\u5EA6\u5047\u751F\u6D3B\u003C/p\u003E\n\u003Cp\u003E\u6C11\u5BBF\u85CF\u8EAB\u4E8E\u7EFF\u610F\u76CE\u7136\u7684\u81EA\u7136\u79D8\u5883\u4E2D\u0026#127811;\u7ED3\u5408\u519C\u573A\u5EFA\u6210\uFF0C\u968F\u5904\u90FD\u53EF\u4EE5\u770B\u5230\u5C0F\u52A8\u7269\u7684\u8EAB\u5F71\u0026#128004;\u6765\u5230\u8FD9\u91CC\uFF0C\u8FDC\u79BB\u57CE\u5E02\u55A7\u56A3\uFF0C\u4EAB\u53D7\u4E00\u6BB5\u60EC\u610F\u53C8\u5B89\u9759\u7684\u65F6\u5149\u2728\u003C/p\u003E\n\u003Cp\u003E\u0026#127968;\u5165\u4F4F\u7279\u8272\u73BB\u7483\u5C4B\u003C/p\u003E\n\u003Cp\u003E\u6C11\u5BBF\u7531\u51E0\u680B\u98CE\u683C\u72EC\u7279\u7684\u73BB\u7483\u5C4B\u7EC4\u6210\uFF0C\u63D0\u4F9B\u51E0\u79CD\u623F\u578B\u9009\u62E9\uFF0C\u6EE1\u8DB3\u4E0D\u540C\u5165\u4F4F\u9700\u6C42\uFF1A\u003C/p\u003E\n\u003Cp\u003E\u2714\uFE0FRumah Tebing\uFF1A\u5F00\u653E\u5F0F\u7A7A\u95F4\uFF0C\u65E0\u72EC\u7ACB\u623F\u95F4\uFF0C\u53EF\u5BB9\u7EB38\u4EBA\u003C/p\u003E\n\u003Cp\u003E\u2714\uFE0FPod Hijau / Pod Biru\uFF1A\u5E10\u7BF7\u5F0F\u7761\u7720\u8231\uFF0C\u53EF\u5BB9\u7EB32\u4EBA\u003C/p\u003E\n\u003Cp\u003E\u2714\uFE0FBilik TigaGuna (B3G)\uFF1A\u53EF\u8F6C\u6362\u4E3A\u4F1A\u8BAE\u5BA4\u6216\u7948\u7977\u5BA4\uFF0C\u53EF\u5BB9\u7EB34\u4EBA\u003C/p\u003E\n\u003Cp\u003E\u0026#128073;\u0026#127995;Pod Hijau\u3001Pod Biru \u4EE5\u53CA Bilik TigaGuna \u4EC5\u4F9B\u989D\u5916\u52A0\u8BA2\u3002\u003C/p\u003E\n\u003Cp\u003E\u0026#127807;\u89E3\u9501\u81EA\u7136\u63A2\u7D22\u4E4B\u65C5\u003C/p\u003E\n\u003Cp\u003E\u0026#127946;\u200D\u2640\uFE0F\u6E38\u6CF3\u3001\u6CE1\u6C34\u3001\u4EAB\u53D7\u6C34\u4E2D\u6309\u6469\uFF0C\u4E00\u6574\u5929\u90FD\u80FD\u653E\u677E\u8EAB\u5FC3\u2728\u003C/p\u003E\n\u003Cp\u003E\u0026#129406;\u6CBF\u7740\u6EAA\u6D41\u4E00\u8DEF\u63A2\u7D22\uFF0C\u611F\u53D7\u6E05\u65B0\u7684\u6237\u5916\u6C14\u606F\u0026#127807;\u003C/p\u003E\n\u003Cp\u003E\u0026#127907;\u6765\u5230 Sungai Larwin\uFF0C\u4F53\u9A8C\u6EAA\u8FB9\u5782\u9493\u7684\u4E50\u8DA3\uFF01\u003C/p\u003E\n\u003Cp\u003E\u0026#128016;\u6765\u5230\u519C\u573A\u8DDF\u5C0F\u52A8\u7269\u4EEC\u8FD1\u8DDD\u79BB\u4E92\u52A8\uFF0C\u611F\u53D7\u6EE1\u6EE1\u7684\u6CBB\u6108\u611F\u0026#128017;\u0026#128014;\u003C/p\u003E\n\u003Cp\u003E\u0026#127816;\u6BCF\u5F53\u6C34\u679C\u5B63\u6765\u4E34\uFF0C\u8FD8\u80FD\u4E00\u8FB9\u4EB2\u8FD1\u5927\u81EA\u7136\uFF0C\u4E00\u8FB9\u4EAB\u53D7\u5F53\u5B63\u6C34\u679C\u7684\u7F8E\u5473\uFF01\u003C/p\u003E\n\u003Cp\u003E\u2668\uFE0F\u914D\u5907\u4E30\u5BCC\u8BBE\u65BD\u003C/p\u003E\n\u003Cp\u003E\u53A8\u5177\u3001\u9910\u5177\u3001\u70E7\u70E4\u7089\u3001\u6CF3\u6C60\u3001\u8425\u706B\u8BBE\u5907\u26FA\uFE0F\u0026#128293;\u4E00\u5E94\u4FF1\u5168\uFF0C\u8FD8\u6709\u6237\u5916\u6D17\u624B\u95F4\u0026#128699;\u3001\u7535\u52A8\u8F66\u5145\u7535\u6869\u7B49\u3002\u003C/p\u003E\n\u003Cp\u003E\u0026#127807;Tanah Larwina\u003C/p\u003E\n\u003Cp\u003E\u0026#128205;\u5730\u5740\uFF1ABatu 23, Jalan Sungai Lui, Kampung Paya Lebar, 43100 Hulu Langat, Selangor\u003C/p\u003E\n\u003Cp\u003E*\u5EFA\u8BAE\u5230G\u7F51\u76F4\u63A5\u9884\u5B9A\uFF5E\u003C/p\u003E\n\u003Cp\u003E\u56FE\u6E90\uFF1ATanah Larwina\u003C/p\u003E\n\u003Cp\u003E#\u9B45\u529B\u96EA\u5170\u83AA   #\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38   #\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38\u653B\u7565   #\u9A6C\u6765\u897F\u4E9A\u96EA\u5170\u83AA   #VisitSelangor2026   #\u96EA\u5170\u83AA\u60CA\u559C\u8FDE\u8FDE   #\u96EA\u5170\u83AA\u65C5\u6E38   #\u96EA\u5170\u83AA\u65C5\u6E38\u653B\u7565   #\u96EA\u5170\u83AA\u4F11\u95F2\u68EE\u6797 \u0026amp;nbsp; #\u96EA\u5170\u83AA\u73BB\u7483\u5C4B\u6C11\u5BBF\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/sz_mmbiz_jpg/p7Ria9Mp2k3pEDamhAJFJ4mnchyLR8AFlnM8dTv30iaCOqSQXtPYzH7RrFeOXMz1sv8KPRbAD9DiatHkULZQibiaziaAD747Cq1gZ5YayE4cPlfZU/0?wx_fmt=jpeg\u0026amp;from=appmsg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/sz_mmbiz_jpg/p7Ria9Mp2k3ovfzIubmAG4QeHjVcrkd1fhvNU2cvYaVLX5yicmvNlYiagoxRWtoaSrd95UDCPMaicCZshWSEQhhjq2v91riam6NLiaIK1gupPgt88/0?wx_fmt=jpeg\u0026amp;from=appmsg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/mmbiz_jpg/p7Ria9Mp2k3qc6msuDTnvym5eCdEV1Aia6JZNwgyicNWx6BxzgERiaDrMuzETJYeYGliae3ZgWQ3wtyUwvVcrwTS1xlKlBUBtP9uYsI91NH3Kmvk/0?wx_fmt=jpeg\u0026amp;from=appmsg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/mmbiz_jpg/p7Ria9Mp2k3po1ibI4dSvSj7ocSAgRONpeTOEDwvyJick5eKtkI81NOv9jygGSEaAddicrEAIfCYtiatvEwgaKDB6jWjPHG8Njww28gxibXzWsO7I/0?wx_fmt=jpeg\u0026amp;from=appmsg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/mmbiz_jpg/p7Ria9Mp2k3oWVgIaUN3GeneUrGkRnD1micLaNmKWTe3Rfmd1wrF0IuRThqqxdXCpOMAnic2Jyciav3mfldGdjonJBUhHQvkpLaPz7RsAChPCIQ/0?wx_fmt=jpeg\u0026amp;from=appmsg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/mmbiz_jpg/p7Ria9Mp2k3ot9tohoicOvQ7jWf4ncuVoRpLpOmHSHs3hjsqyVPK5nDJhkKJzn9SjLHW6tg2FHibKRIzjhVJJGUiaS9jFRjL52dzHNw00eDv6lU/0?wx_fmt=jpeg\u0026amp;from=appmsg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/sz_mmbiz_jpg/p7Ria9Mp2k3rP8EuBnyx0ZloQViaF0saHXXt528mxFDiaFcvxPLTRPvMKmDc4hCCr4jU2TVPnrcGNMnxhMK742B2a7PaEuPxmtegRl9ibDpI2xM/0?wx_fmt=jpeg\u0026amp;from=appmsg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/sz_mmbiz_jpg/p7Ria9Mp2k3qbUofQQHT96MiawRbicDPt0DG0QhccMOM91uGCyIzkRFAtB8KI2q5BIutUZD85KAXTuZgm8OCfD0oPSuia3bVJia23abrQoc51f7M/0?wx_fmt=jpeg\u0026amp;from=appm