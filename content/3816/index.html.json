  "id": "%e5%b8%a6%e6%82%a8%e6%8e%a2%e7%b4%a2%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e9%87%8e%e7%94%9f%e5%8a%a8%e7%89%a9%e4%bf%9d%e6%8a%a4%e5%8c%ba",
  "slug": "%e5%b8%a6%e6%82%a8%e6%8e%a2%e7%b4%a2%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e9%87%8e%e7%94%9f%e5%8a%a8%e7%89%a9%e4%bf%9d%e6%8a%a4%e5%8c%ba",
  "canonicalUrlKey": "%e5%b8%a6%e6%82%a8%e6%8e%a2%e7%b4%a2%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e9%87%8e%e7%94%9f%e5%8a%a8%e7%89%a9%e4%bf%9d%e6%8a%a4%e5%8c%ba",
  "route": "/3816/",
  "title": "\u5E26\u60A8\u63A2\u7D22\u9A6C\u6765\u897F\u4E9A\u91CE\u751F\u52A8\u7269\u4FDD\u62A4\u533A",
  "summary": "\u91CE\u751F\u52A8\u7269 EARTH \u4FDD\u62A4\u533A - \u9A6C\u6765\u897F\u4E9A - \u7231\u62A4\u52A8\u7269\uFF0C\u4FDD\u536B\u5730\u7403 \u5728\u9A6C\u6765\u897F\u4E9A\u7684\u539F\u59CB\u68EE\u6797\u4E2D\uFF0C \u6816\u606F\u7740\u6FD2\u4E8E\u7EDD\u8FF9\u7684\u5F02\u517D\u73CD\u79BD\uFF0C \u5982\u9A6C\u6765\u592A\u9633\u718A\u3001\u9A6C\u6765\u8C98\u548C\u7EA2\u6BDB\u7329\u7329\u7B49\u7B49 \u3002 \u4E3A\u7ED9\u53D7\u4F24\u7684\u52A8\u7269 \u6216\u4ECE\u6B8B\u9177\u7684\u73AF\u5883\u4E2D \u83B7\u6551\u7684\u52A8\u7269\u63D0\u4F9B\u5B89\u5168\u907F\u96BE\u6240\uFF0C \u9A6C\u6765\u897F\u4E9A\u5404\u5730\u90FD\u6709 \u4E3A \u4FDD\u62A4\u4E0D\u540C\u52A8\u7269\u800C\u8BBE\u7ACB\u7684\u52A8\u7269\u4FDD\u62A4\u533A\u3002 \u73B0\u5982\u4ECA\uFF0C\u8FD9\u4E9B\u4FDD\u62A4\u533A\u4E5F\u5F00\u59CB\u5BF9\u5916\u5F00\u653E \uFF0C \u8BA9\u60A8\u53EF\u4EE5\u8FD1\u8DDD\u79BB \u89C2\u5BDF\u548C\u63A5\u89E6\u8FD9\u4E9B\u73CD\u8D35\u7684\u91CE\u751F\u52A8\u7269\u3002 \u5982\u679C\u60A8\u672A\u66FE\u5230\u8BBF\u8FC7\u8FD9\u4E9B\u5730\u65B9\uFF0C \u90A3\u4E48\uFF0C\u73B0\u5728\u5C31\u62FF\u51FA\u4F60\u7684\u5C0F\u672C\u672C\uFF0C \u8BB0\u2026",
  "body": "\u003Cp\u003E\u003Cstrong\u003E\u91CE\u751F\u52A8\u7269\n\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003EEARTH\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u4FDD\u62A4\u533A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E- \u9A6C\u6765\u897F\u4E9A -\u003C/p\u003E\n\u003Cp\u003E\u7231\u62A4\u52A8\u7269\uFF0C\u4FDD\u536B\u5730\u7403\u003C/p\u003E\n\u003Cp\u003E\u5728\u9A6C\u6765\u897F\u4E9A\u7684\u539F\u59CB\u68EE\u6797\u4E2D\uFF0C\u003C/p\u003E\n\u003Cp\u003E\u6816\u606F\u7740\u6FD2\u4E8E\u7EDD\u8FF9\u7684\u5F02\u517D\u73CD\u79BD\uFF0C\u003C/p\u003E\n\u003Cp\u003E\u5982\u9A6C\u6765\u592A\u9633\u718A\u3001\u9A6C\u6765\u8C98\u548C\u7EA2\u6BDB\u7329\u7329\u7B49\u7B49 \u3002\u003C/p\u003E\n\u003Cp\u003E\u4E3A\u7ED9\u53D7\u4F24\u7684\u52A8\u7269\u003C/p\u003E\n\u003Cp\u003E\u6216\u4ECE\u6B8B\u9177\u7684\u73AF\u5883\u4E2D\u003C/p\u003E\n\u003Cp\u003E\u83B7\u6551\u7684\u52A8\u7269\u63D0\u4F9B\u5B89\u5168\u907F\u96BE\u6240\uFF0C\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u5404\u5730\u90FD\u6709\u003C/p\u003E\n\u003Cp\u003E\u4E3A\u4FDD\u62A4\u4E0D\u540C\u52A8\u7269\u800C\u8BBE\u7ACB\u7684\u52A8\u7269\u4FDD\u62A4\u533A\u3002\u003C/p\u003E\n\u003Cp\u003E\u73B0\u5982\u4ECA\uFF0C\u8FD9\u4E9B\u4FDD\u62A4\u533A\u4E5F\u5F00\u59CB\u5BF9\u5916\u5F00\u653E\uFF0C\u003C/p\u003E\n\u003Cp\u003E\u8BA9\u60A8\u53EF\u4EE5\u8FD1\u8DDD\u79BB\u003C/p\u003E\n\u003Cp\u003E\u89C2\u5BDF\u548C\u63A5\u89E6\u8FD9\u4E9B\u73CD\u8D35\u7684\u91CE\u751F\u52A8\u7269\u3002\u003C/p\u003E\n\u003Cp\u003E\u5982\u679C\u60A8\u672A\u66FE\u5230\u8BBF\u8FC7\u8FD9\u4E9B\u5730\u65B9\uFF0C\u003C/p\u003E\n\u003Cp\u003E\u90A3\u4E48\uFF0C\u73B0\u5728\u5C31\u62FF\u51FA\u4F60\u7684\u5C0F\u672C\u672C\uFF0C\u003C/p\u003E\n\u003Cp\u003E\u8BB0\u5F55\u4E0B\u5C0F\u53EF\u7231\u4EEC\u7684\u5BB6\u56ED\uFF0C\u003C/p\u003E\n\u003Cp\u003E\u4E0B\u6B21\u6765\u9A6C\u6765\u897F\u4E9A\u65F6\u548C\u6211\u4EEC\u4E00\u540C\u53BB\u63A2\u8BBF\u4ED6\u4EEC\u5427\uFF01 \u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E01\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u25CF\u7EA2\u6BDB\u7329\u7329\u25CF\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u6C99\u5DF4\u897F\u5FC5\u6D1B \u0026#183; \u4EBA\u733F\u4FDD\u62A4\u4E2D\u5FC3\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/06/frc-32528b5c7ed0b939a232f5eae74c5aec.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u002B \u002B \u002B \u002B\u003C/p\u003E\n\u003Cp\u003E\u8DDD\u79BB\u5C71\u6253\u683925\u516C\u91CC\u7684\u897F\u5FC5\u6D1B\uFF08Sepilok\uFF09\u4EBA\u733F\u4FDD\u62A4\u4E2D\u5FC3\u5750\u843D\u5728\u5360\u573043\u516C\u9877\u7684\u897F\u5FC5\u6D1B-\u5361\u6BD4\u5229\u68EE\u6797\u4FDD\u62A4\u533A(Kabili-Sepilok Forest Reserve)\u5185\uFF0C\u4E13\u95E8\u7167\u987E\u5931\u53BB\u4E86\u6BCD\u4EB2\u3001\u53D7\u4F24\u548C\u65E0\u5BB6\u53EF\u5F52\u7684\u7EA2\u6BDB\u7329\u7329\uFF0C\u5E76\u5E2E\u52A9\u5B83\u4EEC\u91CD\u8FD4\u91CE\u5916\u72EC\u7ACB\u751F\u6D3B\u3002\u56ED\u5185\u7684\u9972\u517B\u5458\u3001\u517D\u533B\u548C\u770B\u62A4\u4EBA\u5458\u4F1A\u6559\u8FD9\u4E9B\u5C0F\u5BB6\u4F19\u5728\u5927\u81EA\u7136\u751F\u5B58\u7684\u5FC5\u5907\u6280\u80FD\u3002\u6E38\u5BA2\u53EF\u4EE5\u6F2B\u6B65\u5728\u6728\u677F\u8DEF\u4E0A\uFF0C\u8FD1\u8DDD\u79BB\u89C2\u8D4F\u53EF\u7231\u7684\u7EA2\u6BDB\u7329\u7329\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E02\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u25CF\u9A6C\u6765\u592A\u9633\u718A \u25CF\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u6C99\u5DF4\u5A46\u7F57\u6D32 \u0026#183; \u592A\u9633\u718A\u4FDD\u62A4\u4E2D\u5FC3\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/06/frc-69f228b3e4d28097a745cd6f117e8e6a.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u002B \u002B \u002B \u002B\u003C/p\u003E\n\u003Cp\u003E\u5A46\u7F57\u6D32\u592A\u9633\u718A\u4FDD\u62A4\u4E2D\u5FC3\u6BD7\u90BB\u897F\u5FC5\u6D1B\uFF08Sepilok\uFF09\u4EBA\u733F\u4FDD\u62A4\u4E2D\u5FC3\uFF0C\u662F\u592A\u9633\u718A\u7684\u5E87\u62A4\u4E4B\u6240\u3002\u8BE5\u4E2D\u5FC3\u521B\u59CB\u4EBA\u9EC4\u9521\u5FB7\u535A\u58EB\uFF0C\u4E5F\u662F\u4E00\u4F4D\u70ED\u5FC3\u7684\u91CE\u751F\u52A8\u7269\u4FDD\u62A4\u8005\uFF0C\u4ED6\u9886\u5BFC\u7740\u56E2\u961F\u5BF9\u88AB\u6536\u7559\u7684\u592A\u9633\u718A\u8FDB\u884C\u5EB7\u590D\u6CBB\u7597\uFF0C\u4EE5\u6C42\u5C06\u5B83\u4EEC\u5C3D\u5FEB\u56DE\u5F52\u91CE\u5916\uFF0C\u72EC\u7ACB\u751F\u6D3B\u3002\u5230\u76EE\u524D\u4E3A\u6B62\uFF0C\u8BE5\u4E2D\u5FC3\u5DF2\u7ECF\u62EF\u6551\u4E86\u7EA640\u591A\u53EA\u592A\u9633\u718A\uFF0C\u5E76\u5E2E\u52A9\u4ED6\u4EEC\u91CD\u8FD4\u5927\u81EA\u7136\u3002 \u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E03\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u25CF\u5927 \u8C61\u25CF\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u5F6D\u4EA8\u74DC\u62C9\u7518\u8FBE \u0026#183; \u5927\u8C61\u4FDD\u80B2\u4E2D\u5FC3\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/06/frc-9b0aca0c126b0f4b33b49db5af98e71b.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u002B \u002B \u002B \u002B\u003C/p\u003E\n\u003Cp\u003E\u74DC\u62C9\u7518\u8FBE\uFF08Kuala Gandah\uFF09\u5927\u8C61\u4FDD\u62A4\u533A\u662F\u9A6C\u6765\u897F\u4E9A\u7B2C\u4E00\u4E2A\u5927\u8C61\u4FDD\u80B2\u4E2D\u5FC3\u3002\u5728\u8FD9\u91CC\uFF0C\u6E38\u5BA2\u4EEC\u53EF\u4EE5\u8FD1\u8DDD\u79BB\u7684\u63A5\u89E6\u5927\u8C61\uFF0C\u5982\u89C2\u770B\u5927\u8C61\u5982\u4F55\u5728\u6CB3\u91CC\u4EAB\u53D7\u6C34\u4E2D\u6D74\uFF0C\u6216\u8005\u53C2\u4E0E\u4E2D\u5FC3\u51C6\u5907\u7684\u5206\u4EAB\u4F1A\uFF0C\u8FD9\u91CC\u7684\u4FDD\u80B2\u5458\u4F1A\u5411\u60A8\u4ECB\u7ECD\u66F4\u591A\u5173\u4E8E\u4ED6\u4EEC\u5927\u8C61\u7684\u6545\u4E8B\u548C\u5C0F\u77E5\u8BC6\uFF0C\u4E5F\u4F1A\u5411\u60A8\u4ECB\u7ECD\u4FDD\u80B2\u4E2D\u5FC3\u7684\u8FD0\u4F5C\u65B9\u5F0F\u3002 \u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E04\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u25CF\u9A6C\u6765\u8C98\u25CF\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u96EA\u5170\u83AA\u5DDE\u0026#183;\u53CC\u6EAA\u675C\u987A\u91CE\u751F\u52A8\u7269\u4FDD\u62A4\u4E2D\u5FC3\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/06/frc-2d7d7c06eff45a180141943cf1452458.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u002B \u002B \u002B \u002B\u003C/p\u003E\n\u003Cp\u003E\u96EA\u5170\u83AA\u5DDE\u7684\u53CC\u6EAA\u675C\u987A\u91CE\uFF08Sungai Dusun\uFF09\u751F\u52A8\u7269\u4FDD\u62A4\u4E2D\u5FC3\uFF0C\u5BC4\u5C45\u7740\u9A6C\u6765\u897F\u4E9A\u6700\u6FD2\u5371\u7684\u52A8\u7269\u3002\u5728\u8FD9\u91CC\uFF0C\u4F60\u53EF\u4EE5\u770B\u5230\u4E16\u754C\u4E0A\u73B0\u5B58\u76844\u79CD\u8C98\u4E4B\u4E00\u3001\u9A6C\u6765\u897F\u4E9A\u7684\u56FD\u5B9D\u2014\u2014\u9A6C\u6765\u8C98\uFF0C\u5B83\u7684\u9F3B\u4F3C\u5C0F\u8C61\u3001\u8EAB\u8EAF\u50CF\u732A\u3001\u817F\u50CF\u7280\u725B\u3001\u53EB\u58F0\u5374\u6E05\u8106\u5A49\u8F6C\u5982\u9E1F\u513F\uFF1B\u8FD8\u53EF\u4EE5\u770B\u5230\u5634\u5DF4\u53C8\u957F\u53C8\u7EC6\u7684\u6052\u6CB3\u9CC4\u3002\u5982\u679C\u4F60\u6709\u610F\u5411\u53C2\u89C2\u8FD9\u91CC\uFF0C\u522B\u5FD8\u4E86\u4E8B\u5148\u83B7\u5F97\u91CE\u751F\u52A8\u7269\u548C\u56FD\u5BB6\u516C\u56ED\u90E8\u7684\u8BB8\u53EF\u3002 \u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E05\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u25CF\u9E1F \u7C7B\u25CF\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u9739\u96F3\u5DDE\u74DC\u62C9\u725B\u62C9 \u0026#183; \u9E1F\u7C7B\u4FDD\u62A4\u533A\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/06/frc-ecf844dc798db084e3d60295da61a68f.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u002B \u002B \u002B \u002B\u003C/p\u003E\n\u003Cp\u003E\u4F5C\u4E3A\u201C\u4F17\u591A\u5019\u9E1F\u7B2C\u4E8C\u5BB6\u56ED\u201D\u7684\u9A6C\u6765\u897F\u4E9A\uFF0C\u5176\u9739\u96F3\u5DDE\u7684\u74DC\u62C9\u725B\u62C9\uFF08Kuala Gula\uFF09\u9E1F\u7C7B\u4FDD\u62A4\u533A\u5C24\u5176\u503C\u5F97\u63A8\u8350\u7ED9\u559C\u6B22\u89C2\u9E1F\u7684\u8FBE\u4EBA\u3002\u5728\u6BCF\u5E748\u6708\u81F3\u6B21\u5E744\u6708\u7684\u8FC1\u5F99\u5B63\u8282\uFF0C\u90FD\u6709\u8FD160\u4E2A\u79CD\u7C7B\u7684\u5019\u9E1F\u5728\u8FD9\u7247\u4FDD\u62A4\u533A\u7684\u7EA2\u6811\u6797\u91CC\u843D\u811A\uFF0C\u4F60\u53EF\u4EE5\u4EB2\u773C\u89C2\u8D4F\u5230\u5168\u7403\u6FD2\u5371\u7684\u9E3B\u9E6C\u7C7B\u7FA4\u843D\uFF0C\u4E73\u767D\u9E73\uFF0C\u767D\u9E6D\u548C\u82CD\u9E6D\u3002\u5982\u679C\u4F60\u6709\u610F\u5411\u5728\u6B64\u8FC7\u591C\uFF0C\u8FD8\u53EF\u4EE5\u79DF\u501F\u8FD9\u91CC\u7684\u5C0F\u5C4B\uFF0C\u5728\u6E05\u6668\u4EB2\u773C\u76EE\u7779\u5404\u79CD\u9E1F\u7C7B\u5728\u6EE9\u6D82\u96C6\u805A\u7684\u58EE\u89C2\u573A\u9762\u3002 \u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/06/frc-2183dca80538d0b6c1e956fba95bbb6f.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u66F4\u591A\u8D44\u8BAF\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u56FD\u5BB6\u65C5\u6E38\u5C40\u5B98\u65B9\u7F51\u7AD9\uFF1A\u003C/p\u003E\n\u003Cp\u003Ewww.tourism.gov.my\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u56FD\u5BB6\u65C5\u6E38\u5C40\u5B98\u65B9\u5FAE\u535A\uFF1A\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38\u5C40\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u56FD\u5BB6\u65C5\u6E38\u5C40\u5B98\u65B9\u5FAE\u4FE1\u516C\u4F17\u53F7\uFF1A\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38\u5C40\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/gjKa8jDEtzPreVLlnVa7Bg\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
