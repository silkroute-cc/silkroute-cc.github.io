  "route": "/5486/",
  "title": "\u7802\u635E\u8D8A\u603B\u7406\uFF1A\u653E\u773C5\u5E74\u8FCE\u67651000\u4EBF\u6295\u8D44\u3000\u7802\u5EFA\u65B0\u56FD\u9645\u673A\u573A\u53CA\u6DF1\u6C34\u6E2F\u53E3",
  "summary": "\uFF08\u53E4\u664B13\u65E5\u8BAF\uFF09\u7802\u62C9\u8D8A\u603B\u7406\u62FF\u7763\u5DF4\u4E01\u5B9C\u4E39\u65AF\u91CC\u963F\u90A6\u4F50\u54C8\u91CC\u6307\u51FA\uFF0C\u672A\u67655\u5E74\u5185\u7802\u62C9\u8D8A\u7ECF\u6D4E\u5C06\u8FCE\u6765\u7EA61000\u4EBF\u4EE4\u5409\u7684\u6295\u8D44\u3002 \u4ED6\u6307\u51FA\uFF0C\u8FD9\u7B14\u5E9E\u5927\u8D44\u91D1\u5C06\u652F\u6301\u4E24\u4E2A\u53D8\u9769\u6027\u9879\u76EE\uFF0C\u5373\u5728\u53E4\u664B\u5174\u5EFA\u4E00\u5EA7\u65B0\u56FD\u9645\u673A\u573A\u4EE5\u53CA\u6DF1\u6C34\u6E2F\u53E3\uFF0C\u65E8\u5728\u63D0\u5347\u7802\u62C9\u8D8A\u4F5C\u4E3A\u533A\u57DF\u7ECF\u6D4E\u65B0\u5174\u5F3A\u56FD\u7684\u5730\u4F4D\u3002 \u4ED6\u4ECA\u65E9\u57282025\u5E74\u9996\u8981\u81F4\u8BCD\u6D3B\u52A8\u4E0A\u8FD9\u4E48\u5BA3\u5E03\u3002 \u4ED6\u8868\u793A\uFF0C\u8BA1\u5212\u4E2D\u7684\u4E39\u7ED2\u5B89\u90A6\u6DF1\u6C34\u6E2F\uFF08Tanjung Embang\uFF09\u5C06\u4E0E\u7802\u62C9\u8D8A\u77F3\u6CB9\u516C\u53F8\u5408\u4F5C\u5EFA\u8BBE\uFF0C\u6210\u4E3A\u80FD\u6E90\u51FA\u53E3\u548C\u8FDB\u53E3\u7684\u6218\u7565\u67A2\u7EBD\u3002 \u201C\u8FD9\u5EA7\u6E2F\u53E3\u5C06\u4E0E\u7802\u62C9\u8D8A\u5929\u7136\u6C14\u8DEF\u7EBF\u56FE\u76F8\u5951\u5408\uFF0C\u652F\u6301\u7EFF\u8272\u6C22\u71C3\u6599\u52A0\u6CE8\u3001\u2026",
  "body": "\u003Cp\u003E\uFF08\u53E4\u664B13\u65E5\u8BAF\uFF09\u7802\u62C9\u8D8A\u603B\u7406\u62FF\u7763\u5DF4\u4E01\u5B9C\u4E39\u65AF\u91CC\u963F\u90A6\u4F50\u54C8\u91CC\u6307\u51FA\uFF0C\u672A\u67655\u5E74\u5185\u7802\u62C9\u8D8A\u7ECF\u6D4E\u5C06\u8FCE\u6765\u7EA61000\u4EBF\u4EE4\u5409\u7684\u6295\u8D44\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6307\u51FA\uFF0C\u8FD9\u7B14\u5E9E\u5927\u8D44\u91D1\u5C06\u652F\u6301\u4E24\u4E2A\u53D8\u9769\u6027\u9879\u76EE\uFF0C\u5373\u5728\u53E4\u664B\u5174\u5EFA\u4E00\u5EA7\u65B0\u56FD\u9645\u673A\u573A\u4EE5\u53CA\u6DF1\u6C34\u6E2F\u53E3\uFF0C\u65E8\u5728\u63D0\u5347\u7802\u62C9\u8D8A\u4F5C\u4E3A\u533A\u57DF\u7ECF\u6D4E\u65B0\u5174\u5F3A\u56FD\u7684\u5730\u4F4D\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u4ECA\u65E9\u57282025\u5E74\u9996\u8981\u81F4\u8BCD\u6D3B\u52A8\u4E0A\u8FD9\u4E48\u5BA3\u5E03\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8868\u793A\uFF0C\u8BA1\u5212\u4E2D\u7684\u4E39\u7ED2\u5B89\u90A6\u6DF1\u6C34\u6E2F\uFF08Tanjung Embang\uFF09\u5C06\u4E0E\u7802\u62C9\u8D8A\u77F3\u6CB9\u516C\u53F8\u5408\u4F5C\u5EFA\u8BBE\uFF0C\u6210\u4E3A\u80FD\u6E90\u51FA\u53E3\u548C\u8FDB\u53E3\u7684\u6218\u7565\u67A2\u7EBD\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u8FD9\u5EA7\u6E2F\u53E3\u5C06\u4E0E\u7802\u62C9\u8D8A\u5929\u7136\u6C14\u8DEF\u7EBF\u56FE\u76F8\u5951\u5408\uFF0C\u652F\u6301\u7EFF\u8272\u6C22\u71C3\u6599\u52A0\u6CE8\u3001\u6DB2\u5316\u5929\u7136\u6C14\u51FA\u53E3\u53CA\u5176\u4ED6\u80FD\u6E90\u8D44\u6E90\uFF0C\u63A8\u52A8\u7802\u62C9\u8D8A\u5411\u53EF\u518D\u751F\u80FD\u6E90\u7684\u8F6C\u578B\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u8BE5\u6E2F\u53E3\u5C06\u914D\u5907\u6700\u5148\u8FDB\u7684\u57FA\u7840\u8BBE\u65BD\u53CA\u667A\u6167\u79D1\u6280\uFF0C\u4EE5\u786E\u4FDD\u5353\u8D8A\u7684\u8FD0\u8425\u6548\u7387\u53CA\u53EF\u6301\u7EED\u6027\uFF0C\u5E76\u9884\u8BA1\u4E8E2030\u5E74\u6295\u5165\u8FD0\u8425\uFF0C\u5DE9\u56FA\u7802\u62C9\u8D8A\u4F5C\u4E3A\u533A\u57DF\u53EF\u6301\u7EED\u80FD\u6E90\u4E0E\u8D38\u6613\u9886\u5BFC\u8005\u7684\u5730\u4F4D\u3002\u003C/p\u003E\n\u003Cp\u003E\u6B64\u5916\uFF0C\u4ED6\u63D0\u5230\u7802\u62C9\u8D8A\u6B63\u5728\u6536\u8D2D\u98DE\u7FFC\u822A\u7A7A\u516C\u53F8\uFF0C\u8FD9\u4E00\u8FDB\u7A0B\u5DF2\u8FDB\u5165\u6700\u7EC8\u9636\u6BB5\uFF0C\u672A\u6765\u5C06\u4F7F\u7802\u62C9\u8D8A\u6210\u4E3A\u8FDE\u63A5\u4E1C\u76DF\u7684\u95E8\u6237\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u900F\u8FC7\u589E\u52A0\u673A\u961F\u5BB9\u91CF\u53CA\u63D0\u5347\u670D\u52A1\uFF0C\u6211\u4EEC\u7684\u76EE\u6807\u662F\u5728\u672A\u6765\u4E94\u5E74\u5185\u4FC3\u8FDB\u56DB\u81F3\u4E03\u5C0F\u65F6\u98DE\u884C\u534A\u5F84\u5185\u7684\u8D38\u6613\u3001\u65C5\u6E38\u53CA\u6295\u8D44\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8FD8\u63D0\u5230\u653F\u5E9C\u51B3\u5B9A\u6295\u8D44\u758F\u6D5A\u7F8E\u91CC\u6E2F\u53E3\uFF0C\u8FD9\u5C06\u63D0\u5347\u6E2F\u53E3\u5904\u7406\u5927\u578B\u8D27\u7269\u7684\u80FD\u529B\uFF0C\u6539\u5584\u8FD0\u8425\u6548\u7387\uFF0C\u5E76\u52A0\u5F3A\u5176\u4F5C\u4E3A\u56FD\u9645\u8D38\u6613\u548C\u533A\u57DF\u8FDE\u63A5\u6218\u7565\u6E2F\u53E3\u7684\u4F5C\u7528\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6307\u51FA\uFF0C\u53BB\u5E74\u7802\u62C9\u8D8A\u5DDE\u653F\u5E9C\u63D0\u51FA\u4E86158\u4EBF\u4EE4\u5409\u7684\u53F2\u4E0A\u6700\u5927\u7802\u62C9\u8D8A\u9884\u7B97\u6848\uFF0C\u5145\u5206\u663E\u793A\u4E86\u7802\u62C9\u8D8A\u653F\u5E9C\u63A8\u52A8\u53D8\u9769\u548C\u7ECF\u6D4E\u8FDB\u6B65\u7684\u51B3\u5FC3\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u5F3A\u8C03\uFF0C\u5404\u673A\u6784\u5FC5\u987B\u4E13\u6CE8\u5E76\u81F4\u529B\u4E8E\u52A0\u901F\u6267\u884C\u8BA1\u5212\u53CA\u9879\u76EE\uFF0C\u786E\u4FDD\u9AD8\u6548\u843D\u5B9E\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u547C\u5401\u5404\u65B9\u52AA\u529B\u4E0E2026\u81F32030\u5E74\u671F\u95F4\u7684\u7B2C13\u5927\u9A6C\u8BA1\u5212\u6838\u5FC3\u4F18\u5148\u4E8B\u9879\u4FDD\u6301\u4E00\u81F4\uFF1B\u76EE\u524D\uFF0C\u7B2C13\u5927\u9A6C\u8BA1\u5212\u7684\u7B79\u5907\u5DE5\u4F5C\u5DF2\u7ECF\u5C55\u5F00\uFF0C\u6DB5\u76D6\u591A\u90E8\u95E8\u3001\u4EA7\u4E1A\u53CA\u793E\u4F1A\u5404\u754C\u7684\u5E7F\u6CDB\u534F\u5546\uFF0C\u4EE5\u786E\u4FDD\u7B56\u7565\u5177\u5305\u5BB9\u6027\u53CA\u5168\u9762\u6027\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u8FD9\u4E2A\u8FC7\u7A0B\u8FD8\u5305\u62EC\u5BF9\u7B2C12\u5927\u9A6C\u8BA1\u5212\u7684\u6210\u5C31\u8FDB\u884C\u68C0\u8BA8\uFF0C\u8BA9\u6211\u4EEC\u80FD\u5728\u6210\u529F\u7684\u57FA\u7840\u4E0A\u89C4\u5212\u672A\u6765\u3002\u7802\u62C9\u8D8A\u7ECF\u6D4E\u884C\u52A8\u7406\u4E8B\u4F1A\uFF0C\u7531\u5185\u9601\u6210\u5458\u3001\u5B66\u8005\u3001\u4EA7\u4E1A\u4E13\u5BB6\u53CA\u653F\u5E9C\u5B98\u5458\u7EC4\u6210\uFF0C\u5C06\u53C2\u4E0E\u8BA8\u8BBA\u5E76\u6700\u7EC8\u6572\u5B9A\u7B2C13\u5927\u9A6C\u8BA1\u5212\u7684\u7B56\u7565\u53CA\u524D\u8FDB\u65B9\u5411\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u5F3A\u8C03\uFF0C\u7B2C13\u5927\u9A6C\u8BA1\u5212\u5C06\u4E13\u6CE8\u4E8E\u900F\u8FC7\u8F6C\u578B\u4E0E\u591A\u5143\u5316\u63D0\u5347\u7ECF\u6D4E\u97E7\u6027\u3001\u63A8\u8FDB\u6570\u5B57\u5316\u8F6C\u578B\u3001\u4FC3\u8FDB\u793E\u4F1A\u5305\u5BB9\u6027\uFF0C\u4EE5\u53CA\u786E\u4FDD\u53EF\u6301\u7EED\u6027\u4E0E\u516C\u5E73\u6027\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/wTCp_ZqBLmnz-cWsp5pGAA\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
