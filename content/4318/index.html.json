{
  "id": "%e6%96%99%e4%bb%8a%e5%b9%b4%e5%90%af%e5%8a%a8-%e6%a3%ae%e5%b7%9e%e6%89%b9%e5%bc%80%e9%87%87%e9%9d%9e%e6%94%be%e5%b0%84%e6%80%a7%e7%a8%80%e5%9c%9f",
  "slug": "%e6%96%99%e4%bb%8a%e5%b9%b4%e5%90%af%e5%8a%a8-%e6%a3%ae%e5%b7%9e%e6%89%b9%e5%bc%80%e9%87%87%e9%9d%9e%e6%94%be%e5%b0%84%e6%80%a7%e7%a8%80%e5%9c%9f",
  "canonicalUrlKey": "%e6%96%99%e4%bb%8a%e5%b9%b4%e5%90%af%e5%8a%a8-%e6%a3%ae%e5%b7%9e%e6%89%b9%e5%bc%80%e9%87%87%e9%9d%9e%e6%94%be%e5%b0%84%e6%80%a7%e7%a8%80%e5%9c%9f",
  "route": "/4318/",
  "title": "\u6599\u4ECA\u5E74\u542F\u52A8 \u68EE\u5DDE\u6279\u5F00\u91C7\u975E\u653E\u5C04\u6027\u7A00\u571F",
  "summary": "\uFF08\u8299\u84C93\u65E5\u8BAF\uFF09\u68EE\u7F8E\u5170\u5DDE\u52A1\u5927\u81E3\u62FF\u7763\u65AF\u91CC\u963F\u7C73\u52AA\u4E01\u6307\u51FA\uFF0C\u5DDE\u653F\u5E9C\u5DF2\u6279\u51C6\u5DDE\u5185\u975E\u653E\u5C04\u6027\u7A00\u571F\u5143\u7D20\u8D44\u6E90\uFF08NR-REE\uFF09\u5F00\u91C7\u7684\u6807\u51C6\u4F5C\u4E1A\u7A0B\u5E8F\uFF08SOP\uFF09\u3002 \u4ED6\u8BF4\uFF0C\u68EE\u5DDE\u7684\u975E\u653E\u5C04\u6027\u7A00\u571F\u5143\u7D20\u5F00\u91C7\u9884\u8BA1\u5C06\u4E8E\u4ECA\u5E74\u542F\u52A8\uFF0C\u800C\u6240\u6709\u5F00\u53D1\u90FD\u5FC5\u987B\u4E0E\u5DDE\u653F\u5E9C\u5B50\u516C\u53F8\u2014\u2014\u68EE\u5DDE\u5927\u81E3\u673A\u6784\uFF08MBI\uFF09\u8054\u8425\uFF0C\u4EE5\u76D1\u7763\u5F00\u91C7\u8FC7\u7A0B\u53CA\u786E\u4FDD\u4E0D\u4F1A\u88AB\u6EE5\u7528\u3002 \u4ED6\u4ECA\u65E5\u4E3B\u6301\u5DDE\u884C\u653F\u8BAE\u4F1A\u540E\uFF0C\u5728\u8BB0\u8005\u4F1A\u4E0A\u8FD9\u4E48\u8868\u793A\u3002\u4E0E\u4F1A\u8005\u5C1A\u6709\u68EE\u5DDE\u9AD8\u7EA7\u884C\u653F\u8BAE\u5458\u62FF\u7763\u65AF\u91CC\u8D3E\u62C9\u9C81\u4E01\u3001\u68EE\u5DDE\u884C\u653F\u8BAE\u5458\u5F20\u8052\u7FD4\u3001\u5DDE\u79D8\u4E66\u62FF\u7763\u83AB\u54C8\u672B\u624E\u83F2\u53CA\u8D22\u653F\u53F8\u83AB\u54C8\u672B\u5361\u8FEA\u5C14\u3002 \u4ED6\u8BF4\uFF0C\u68EE\u5DDE\u884C\u653F\u4F1A\u8BAE\u901A\u8FC7\u7684\u975E\u653E\u5C04\u6027\u7A00\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/01/frc-0dfd2bda4b7aa2c18398dc3c2be60c4b.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\uFF08\u8299\u84C93\u65E5\u8BAF\uFF09\u68EE\u7F8E\u5170\u5DDE\u52A1\u5927\u81E3\u62FF\u7763\u65AF\u91CC\u963F\u7C73\u52AA\u4E01\u6307\u51FA\uFF0C\u5DDE\u653F\u5E9C\u5DF2\u6279\u51C6\u5DDE\u5185\u975E\u653E\u5C04\u6027\u7A00\u571F\u5143\u7D20\u8D44\u6E90\uFF08NR-REE\uFF09\u5F00\u91C7\u7684\u6807\u51C6\u4F5C\u4E1A\u7A0B\u5E8F\uFF08SOP\uFF09\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u68EE\u5DDE\u7684\u975E\u653E\u5C04\u6027\u7A00\u571F\u5143\u7D20\u5F00\u91C7\u9884\u8BA1\u5C06\u4E8E\u4ECA\u5E74\u542F\u52A8\uFF0C\u800C\u6240\u6709\u5F00\u53D1\u90FD\u5FC5\u987B\u4E0E\u5DDE\u653F\u5E9C\u5B50\u516C\u53F8\u2014\u2014\u68EE\u5DDE\u5927\u81E3\u673A\u6784\uFF08MBI\uFF09\u8054\u8425\uFF0C\u4EE5\u76D1\u7763\u5F00\u91C7\u8FC7\u7A0B\u53CA\u786E\u4FDD\u4E0D\u4F1A\u88AB\u6EE5\u7528\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u4ECA\u65E5\u4E3B\u6301\u5DDE\u884C\u653F\u8BAE\u4F1A\u540E\uFF0C\u5728\u8BB0\u8005\u4F1A\u4E0A\u8FD9\u4E48\u8868\u793A\u3002\u4E0E\u4F1A\u8005\u5C1A\u6709\u68EE\u5DDE\u9AD8\u7EA7\u884C\u653F\u8BAE\u5458\u62FF\u7763\u65AF\u91CC\u8D3E\u62C9\u9C81\u4E01\u3001\u68EE\u5DDE\u884C\u653F\u8BAE\u5458\u5F20\u8052\u7FD4\u3001\u5DDE\u79D8\u4E66\u62FF\u7763\u83AB\u54C8\u672B\u624E\u83F2\u53CA\u8D22\u653F\u53F8\u83AB\u54C8\u672B\u5361\u8FEA\u5C14\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u68EE\u5DDE\u884C\u653F\u4F1A\u8BAE\u901A\u8FC7\u7684\u975E\u653E\u5C04\u6027\u7A00\u571F\u793A\u7D20\u8D44\u6E90\u7684\u6807\u51C6\u4F5C\u4E1A\u7A0B\u5E8F\uFF0C\u4E0E\u8054\u90A6\u653F\u5E9C\u7684\u5927\u540C\u5C0F\u5F02\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u4EFB\u4F55\u7B26\u5408\u6761\u4EF6\u7684\u79C1\u4EBA\u5730\u4E3B\u6216\u516C\u53F8\u90FD\u53EF\u5411\u5DDE\u653F\u5E9C\u4F5C\u51FA\u7533\u8BF7\uFF0C\u4E0D\u8FC7\u5FC5\u987B\u4E0EMBI\u8054\u8425\uFF0C\u800C\u5F00\u91C7\u65B9\u5F0F\u5FC5\u987B\u6839\u636E\u4E2D\u56FD\u7684\u6280\u672F\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u5DDE\u653F\u5E9C\u5BF9\u5176\u4ED6\u56FD\u5BB6\u7684\u6280\u672F\u4FDD\u6301\u5F00\u653E\uFF0C\u82E5\u8981\u91C7\u7528\u5176\u4ED6\u56FD\u5BB6\u7684\u5F00\u91C7\u6280\u672F\uFF0C\u5FC5\u987B\u5148\u5411\u5DDE\u653F\u5E9C\u8FDB\u884C\u7533\u8BF7\u53CA\u6C47\u62A5\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u68EE\u5DDE\u4E5F\u4E0D\u5141\u8BB8\u7A00\u571F\u52D8\u63A2\u6D3B\u52A8\uFF0C\u56E0\u8FD9\u5F62\u540C\u5728\u5F00\u91C7\uFF0C\u800C\u4E14\u4E4B\u524D\u52D8\u5BDF\u5DE5\u4F5C\u5DF2\u8FDB\u884C\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u63D0\u53CA\uFF0C\u76EE\u524D\u8054\u90A6\u77FF\u7269\u548C\u5730\u7406\u79D1\u5B66\u5C40\uFF08JMG\uFF09\u4E5F\u5728\u63A2\u8BA8\uFF0C\u68EE\u5DDE\u5927\u81E3\u673A\u6784\u4E5F\u5C06\u59D4\u4EFB\u5730\u8D28\u5B66\u5BB6\uFF0C\u4EE5\u786E\u4FDD\u5DDE\u653F\u5E9C\u80FD\u591F\u7BA1\u63A7\u7A00\u571F\u5F00\u91C7\u7684\u76F8\u5173\u6D3B\u52A8\uFF0C\u4EE5\u514D\u4E0D\u4F1A\u5BF9\u5468\u906D\u571F\u5730\u5E26\u6765\u8D1F\u9762\u5F71\u54CD\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5F20\u8052\u7FD4\u8D74\u4E2D\u56FD\u8D1B\u5DDE\u8003\u5BDF\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u62AB\u9732\uFF0C\u68EE\u5DDE\u884C\u653F\u8BAE\u5458\u5F20\u8052\u7FD4\u672C\u6708\u4E5F\u5C06\u5230\u4E2D\u56FD\u8D1B\u5DDE\u8FDB\u884C\u5B98\u8BBF\uFF0C\u4EE5\u8003\u5BDF\u5F53\u5730\u7684\u7A00\u571F\u5DE5\u5382\u8FD0\u4F5C\u5B9E\u51B5\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u76EE\u524D\u5DF2\u6709\u516C\u53F8\u7533\u8BF7\u5F00\u91C7\uFF0C\u5927\u9A6C\u77FF\u7269\u53CA\u5730\u8D28\u5C40\u5DF2\u9274\u5B9A\u74DC\u62C9\u5E87\u52B3\u53CA\u65E5\u53FB\u52A1\u8574\u542B\u7A00\u571F\u8D44\u6E90\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u6B64\u5916\uFF0C\u4ED6\u63D0\u53CA\uFF0C\u53BB\u5E74\u5728\u74DC\u62C9\u5E87\u52B3\u906D\u63ED\u53D1\u975E\u6CD5\u5F00\u91C7\u7A00\u571F\u7684\u516C\u53F8\uFF0C\u572812\u6708\u5DF2\u7F34\u4ED850\u4E07\u4EE4\u5409\u7F5A\u6B3E\uFF0C\u9664\u4E86\u571F\u5730\u5C40\uFF0C\u4ECD\u6709\u5176\u4ED6\u653F\u5E9C\u673A\u6784\u7684\u7F5A\u6B3E\uFF1B\u81F3\u4E8E\u65E5\u53FB\u52A1\u975E\u6CD5\u5F00\u91C7\u7A00\u571F\u6D3B\u52A8\u4ECD\u5728\u8C03\u67E5\u4E2D\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u6536\u5165\u518D\u521B\u8F89\u714C\n\u8FBE\u81F35.4\u4EBF\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u53E6\u4E00\u65B9\u9762\uFF0C\u963F\u7C73\u52AA\u4E01\u62AB\u9732\uFF0C\u68EE\u5DDE2023\u5E74\u7684\u6536\u5165\u518D\u6B21\u53D6\u5F97\u8F89\u714C\u6210\u5C31\uFF0C\u6536\u5165\u8FBE\u81F35\u4EBF4129\u4E07\u4EE4\u5409\uFF0C\u8D85\u8D8A\u539F\u5B9A\u76EE\u6807\u76844\u4EBF5000\u4E07\u4EE4\u5409\uFF0C\u8FBE\u5230120.29%\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8868\u793A\uFF0C\u5176\u4E2D\u975E\u7A0E\u6536\u8FBE\u52303\u4EBF2501\u4E07\u4EE4\u5409\uFF08142.57%\uFF09\uFF0C\u5176\u6B21\u662F\u975E\u6B63\u5F0F\u6536\u5165\uFF0C\u8FBE\u52306394\u4E07\u4EE4\u5409\uFF08102.8%\uFF09\uFF0C\u800C\u7A0E\u6536\u6536\u5165\u5219\u4E3A1\u4EBF5233\u4E07\u4EE4\u5409\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C2023\u8D22\u653F\u9884\u7B97\u6848\u7684\u8D64\u5B57\u9884\u7B97\u8FBE1\u4EBF\u96F6896\u4E07\u4EE4\u5409\uFF0C\u7136\u800C\uFF0C\u5728\u6240\u6709\u7A0E\u6536\u90E8\u95E8\u7684\u52AA\u529B\u4E0B\uFF0C\u5DDE\u653F\u5E9C\u6210\u529F\u83B7\u5F97479\u4E07\u4EE4\u5409\u7684\u76C8\u4F59\uFF0C\u800C\u8FD9\u4E5F\u662F\u5DDE\u653F\u5E9C\u8FDE\u7EED\u4E8C\u5E74\u53D6\u5F97\u5C06\u8D22\u653F\u8D64\u5B57\u8F6C\u4E8F\u4E3A\u76C8\u7684\u6210\u5C31\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BA4\u4E3A\uFF0C\u5BF9\u4E8E2024\u5E74\u8D22\u653F\u9884\u7B97\u6848\uFF0C\u5DDE\u653F\u5E9C\u5C06\u7EE7\u7EED\u52AA\u529B\u5B9E\u73B06\u4EBF\u4EE4\u5409\u7684\u6536\u5165\u9884\u7B97\u76EE\u6807\uFF0C\u4EE5\u53CA\u843D\u5B9E\u4E0E\u8BE5\u9884\u7B97\u6848\u4E00\u5E76\u63D0\u5448\u7684\u68EE\u5DDE\u56E2\u7ED3\u613F\u666F\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8865\u5145\uFF0C\u5DDE\u653F\u5E9C\u6B63\u5728\u62DF\u5B9A\u6709\u5173\u68EE\u5DDE\u56E2\u7ED3\u613F\u666F\u63F4\u52A9\u91D1\u7684\u673A\u5236\uFF0C\u5E76\u5C06\u52A0\u901F\u5176\u8FDB\u7A0B\uFF0C\u4E00\u65E6\u5B8C\u6210\u540E\uFF0C\u5C06\u901A\u77E5\u5404\u5DDE\u9009\u533A\u7684\u8BAE\u5458\u670D\u52A1\u4E2D\u5FC3\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/opexLf9Ggq7s9sZy2pPTGQ\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
