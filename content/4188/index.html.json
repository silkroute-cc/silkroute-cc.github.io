  "slug": "%e7%be%8e%e5%9b%bd%e9%ab%98%e7%ba%a7%e7%a1%85%e7%94%b5%e6%b1%a0%e7%94%9f%e4%ba%a7%e5%95%86enovix%e5%b0%86%e6%96%a5%e8%b5%84%e8%b6%8512%e4%ba%bf%e7%be%8e%e5%85%83-%e5%9c%a8%e9%a9%ac%e6%9d%a5%e8%a5%bf",
