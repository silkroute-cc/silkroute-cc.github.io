  "route": "/5203/",
  "title": "\u9A6C\u534E\u9A6C\u4E2D\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u7ECF\u8D38\u4FE1\u606F\u54A8\u8BE2\u4E2D\u5FC3\u6B63\u5F0F\u6295\u5165\u8FD0\u4F5C",
  "summary": "\uFF08\u5409\u9686\u576124\u65E5\u8BAF\uFF09\u9A6C\u534E\u5BF9\u534E\u4E8B\u52A1\u53CA\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u59D4\u5458\u4F1A\u526F\u4E3B\u5E2D\u517C\u79D8\u4E66\u957F\u62FF\u7763\u8BB8\u91D1\u6C49\u6307\u51FA\uFF0C\u9A6C\u4E2D\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u7ECF\u8D38\u4FE1\u606F\u8C18\u8BE2\u4E2D\u5FC3\u6B63\u5F0F\u6295\u5165\u8FD0\u4F5C\uFF0C\u4EE5\u4FC3\u8FDB\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u5021\u8BAE\u4E0B\u9A6C\u4E2D\u7684\u7ECF\u6D4E\u5408\u4F5C\u3002 \u4ED6\u4ECA\u65E5\u53D1\u6587\u544A\u6307\u51FA\uFF0C\u5927\u9A6C\u4F01\u4E1A\u53EF\u4EE5\u901A\u8FC7\u63D0\u4EA4\u516C\u53F8\u540D\u79F0\u3001\u516C\u53F8\u7B80\u4ECB\u3001\u6210\u7ACB\u65E5\u671F\u3001\u516C\u53F8\u7F51\u5740\u3001\u4E1A\u52A1\u9886\u57DF\u4E0E\u4E13\u957F\u3001\u4E3B\u8981\u4EA7\u54C1\u53CA\u4EA7\u54C1\u63CF\u8FF0\u7B49\u8D44\u6599\u81F3\u8C18\u8BE2\u4E2D\u5FC3\uFF0C\u4EE5\u4FBF\u4FE1\u606F\u4E2D\u5FC3\u53EF\u4EE5\u66F4\u597D\u5730\u534F\u52A9\u76F8\u5173\u4F01\u4E1A\u5BFB\u627E\u5408\u9002\u7684\u4E2D\u56FD\u5408\u4F5C\u4F19\u4F34\uFF0C\u5E76\u83B7\u53D6\u8C18\u8BE2\u670D\u52A1\u3002 \u201C\u6211\u4EEC\u7684\u76EE\u6807\u662F\u901A\u8FC7\u4FC3\u8FDB\u4E2D\u5C0F\u4F01\u4E1A\u4E4B\u95F4\u7684\u7ECF\u8D38\u5408\u4F5C\uFF0C\u52A0\u5F3A\u9A6C\u4E2D\u4E24\u56FD\u5728\u2018\u4E00\u5E26\u4E00\u8DEF\u2019\u6846\u67B6\u4E0B\u7684\u7ECF\u6D4E\u8054\u7CFB\u4E0E\u5408\u4F5C\uFF0C\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/10/frc-367c67edc2164a037389f5024291b0e4.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\uFF08\u5409\u9686\u576124\u65E5\u8BAF\uFF09\u9A6C\u534E\u5BF9\u534E\u4E8B\u52A1\u53CA\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u59D4\u5458\u4F1A\u526F\u4E3B\u5E2D\u517C\u79D8\u4E66\u957F\u62FF\u7763\u8BB8\u91D1\u6C49\u6307\u51FA\uFF0C\u9A6C\u4E2D\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u7ECF\u8D38\u4FE1\u606F\u8C18\u8BE2\u4E2D\u5FC3\u6B63\u5F0F\u6295\u5165\u8FD0\u4F5C\uFF0C\u4EE5\u4FC3\u8FDB\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u5021\u8BAE\u4E0B\u9A6C\u4E2D\u7684\u7ECF\u6D4E\u5408\u4F5C\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u4ECA\u65E5\u53D1\u6587\u544A\u6307\u51FA\uFF0C\u5927\u9A6C\u4F01\u4E1A\u53EF\u4EE5\u901A\u8FC7\u63D0\u4EA4\u516C\u53F8\u540D\u79F0\u3001\u516C\u53F8\u7B80\u4ECB\u3001\u6210\u7ACB\u65E5\u671F\u3001\u516C\u53F8\u7F51\u5740\u3001\u4E1A\u52A1\u9886\u57DF\u4E0E\u4E13\u957F\u3001\u4E3B\u8981\u4EA7\u54C1\u53CA\u4EA7\u54C1\u63CF\u8FF0\u7B49\u8D44\u6599\u81F3\u8C18\u8BE2\u4E2D\u5FC3\uFF0C\u4EE5\u4FBF\u4FE1\u606F\u4E2D\u5FC3\u53EF\u4EE5\u66F4\u597D\u5730\u534F\u52A9\u76F8\u5173\u4F01\u4E1A\u5BFB\u627E\u5408\u9002\u7684\u4E2D\u56FD\u5408\u4F5C\u4F19\u4F34\uFF0C\u5E76\u83B7\u53D6\u8C18\u8BE2\u670D\u52A1\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u4EEC\u7684\u76EE\u6807\u662F\u901A\u8FC7\u4FC3\u8FDB\u4E2D\u5C0F\u4F01\u4E1A\u4E4B\u95F4\u7684\u7ECF\u8D38\u5408\u4F5C\uFF0C\u52A0\u5F3A\u9A6C\u4E2D\u4E24\u56FD\u5728\u2018\u4E00\u5E26\u4E00\u8DEF\u2019\u6846\u67B6\u4E0B\u7684\u7ECF\u6D4E\u8054\u7CFB\u4E0E\u5408\u4F5C\uFF0C\u800C\u59D4\u5458\u4F1A\u4F5C\u4E3A\u2018\u8054\u7EDC\u7A97\u53E3\u2019\uFF0C\u81F4\u529B\u4E8E\u63A8\u52A8\u4E24\u56FD\u4E4B\u95F4\u7684\u5546\u4E1A\u5BF9\u63A5\u4E0E\u6295\u8D44\u673A\u4F1A\u3002\u201D\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/10/frc-7a6ff2ba93c77564fc14acb2e3988595.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u901A\u8FC7\u6B64\u5E73\u53F0\uFF0C\u672C\u5730\u4F01\u4E1A\u51B2\u51FA\u6D77\u5916\u5E02\u573A\uFF0C\u5171\u540C\u63A2\u7D22\u5E76\u5229\u7528\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u5021\u8BAE\u4E0B\u7684\u5E02\u573A\u6F5C\u529B\u4E0E\u6295\u8D44\u673A\u4F1A\uFF0C\u63A8\u52A8\u9A6C\u4E2D\u4E24\u56FD\u7684\u7ECF\u6D4E\u5408\u4F5C\u4E0E\u53D1\u5C55\u3002\u003C/p\u003E\n\u003Cp\u003E\u6B32\u77E5\u66F4\u591A\u5173\u4E8E\u9A6C\u4E2D\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u7ECF\u8D38\u4FE1\u606F\u8C18\u8BE2\u4E2D\u5FC3\u7684\u4FE1\u606F\uFF0C\u6216\u6709\u610F\u53C2\u4E0E\u6B64\u5E73\u53F0\uFF0C\u53EF\u901A\u8FC7\u94FE\u63A5 https://mcaprcbri.mca.org.my/ \uFF0C\u586B\u5199\u5E76\u63D0\u4EA4\u4F01\u4E1A\u8D44\u6599\uFF0C\u6216\u62E8\u6253\u4FE1\u606F\u4E2D\u5FC3\u624B\u673A\u53F7\u7801\uFF0C\u8054\u7CFB\u674E\u6653\u83F1\u548C\u67EF\u71D5\u6E05\uFF08\u002B60176038190\uFF09\u8BE2\u95EE\u8BE6\u60C5\u3002\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u534E\u603B\u4F1A\u957F\u62FF\u7763\u65AF\u91CC\u9B4F\u5BB6\u7965\u8BA4\u4E3A\uFF0C\u9A6C\u4E2D\u4E24\u56FD\u4F01\u4E1A\u5728\u4EBA\u5DE5\u667A\u80FD\u3001\u65B0\u80FD\u6E90\u53CA\u6570\u7801\u7ECF\u6D4E\u4E0A\u80FD\u591F\u52A0\u5F3A\u5408\u4F5C\u3002\u4ED6\u5468\u516D\uFF085\u65E5\uFF09\u5728\u4E3A\u9A6C\u4E2D\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u7ECF\u8D38\u4FE1\u606F\u54A8\u8BE2\u4E2D\u5FC3\u4E3B\u6301\u63A8\u4ECB\u793C\u65F6\u6307\u51FA\uFF0C\u9A6C\u4E2D\u5E94\u8BE5\u6DF1\u5316\u4EBA\u5DE5\u667A\u80FD\u9886\u57DF\u3001\u52A0\u5F3A\u65B0\u80FD\u6E90\u9886\u57DF\u53CA\u63A8\u52A8\u6570\u7801\u7ECF\u6D4E\u7684\u5408\u4F5C\u3002\u4ED6\u6307\u51FA\uFF0C\u9A6C\u4E2D\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u7ECF\u8D38\u4FE1\u606F\u54A8\u8BE2\u4E2D\u5FC3\u7684\u6210\u7ACB\uFF0C\u662F\u9A6C\u4E2D\u4E24\u56FD\u7ECF\u6D4E\u5408\u4F5C\u7684\u53E6\u4E00\u5EA7\u4E30\u7891\uFF0C\u5B83\u4E3A\u4E2D\u56FD\u4F01\u4E1A\u843D\u5730\u9A6C\u6765\u897F\u4E9A\u63D0\u4F9B\u4E86\u4E00\u4E2A\u9AD8\u6548\u3001\u4FBF\u6377\u7684\u5BF9\u63A5\u5E73\u53F0\uFF0C\u4E3A\u63A8\u52A8\u4E24\u56FD\u5728\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u5021\u8BAE\u6846\u67B6\u4E0B\u7684\u7ECF\u8D38\u5408\u4F5C\u6CE8\u5165\u4E86\u65B0\u52A8\u80FD\u3002\u4ED6\u8BF4\uFF0C\u8FD9\u4E2A\u7531\u9A6C\u534E\u5BF9\u534E\u4E8B\u52A1\u53CA\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u59D4\u5458\u4F1A\u6210\u7ACB\u7684\u4FE1\u606F\u54A8\u8BE2\u4E2D\u5FC3\uFF0C\u5C06\u6210\u4E3A\u9A6C\u4E2D\u4F01\u4E1A\u5BF9\u63A5\u7684\u6865\u6881\uFF0C\u5E2E\u52A9\u4F01\u4E1A\u627E\u5230\u6700\u9002\u5408\u7684\u5408\u4F5C\u4F19\u4F34\uFF0C\u63D0\u5347\u5408\u4F5C\u7684\u6548\u7387\u548C\u6210\u529F\u7387\u3002\u201C\u4E0E\u6B64\u540C\u65F6\uFF0C\u8FD9\u4E2A\u54A8\u8BE2\u4E2D\u5FC3\u4E5F\u80FD\u4E3A\u4E2D\u56FD\u4F01\u4E1A\u843D\u5730\u9A6C\u6765\u897F\u4E9A\u5E02\u573A\u63D0\u4F9B\u8BE6\u7EC6\u4FE1\u606F\uFF0C\u4F7F\u4F01\u4E1A\u80FD\u591F\u66F4\u5FEB\u5730\u719F\u6089\u548C\u878D\u5165\u672C\u5730\u5E02\u573A\uFF0C\u6709\u6548\u5730\u52A9\u4E2D\u56FD\u4F01\u4E1A\u51CF\u5C11\u4E0D\u5FC5\u8981\u7684\u6210\u672C\u548C\u98CE\u9669\u3002\u201D\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/10/frc-91f658bdae2e4ad53f4afb75ef920d64.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u4ED6\u76F8\u4FE1\uFF0C\u968F\u7740\u7ECF\u8D38\u4FE1\u606F\u54A8\u8BE2\u4E2D\u5FC3\u7684\u6210\u7ACB\uFF0C\u8FD9\u5C06\u8FDB\u4E00\u6B65\u5F3A\u5316\u9A6C\u4E2D\u8D38\u6613\u5408\u4F5C\u3002\u201C\u6211\u547C\u5401\u56FD\u5185\u4F01\u4E1A\u5C3D\u901F\u5411\u7ECF\u8D38\u4FE1\u606F\u54A8\u8BE2\u4E2D\u5FC3\u8FDB\u884C\u767B\u8BB0\uFF0C\u5927\u5BB6\u643A\u624B\u5408\u4F5C\uFF0C\u901A\u8FC7\u8FD9\u4E2A\u5E73\u53F0\u6269\u5C55\u4E1A\u52A1\u3002\u201D\n\n\u51FA\u5E2D\u7684\u6709\u9A6C\u534E\u7F72\u7406\u603B\u4F1A\u957F\u62FF\u7763\u9A6C\u6C49\u987A\u3001\u526F\u603B\u4F1A\u957F\u517C\u5BF9\u534E\u4E8B\u52A1\u66A8\u4E00\u5E26\u4E00\u8DEF\u4E2D\u5FC3\u59D4\u5458\u4F1A\u4E3B\u5E2D\u62FF\u7763\u9648\u5FB7\u94A6\u3001\u603B\u8D22\u653F\u9648\u4F20\u5E73\uFF0C\u5168\u56FD\u7EC4\u7EC7\u79D8\u4E66\u957F\u5ED6\u56FD\u8D48\u3001\u526F\u603B\u79D8\u4E66\u62FF\u7763\u6768\u71D5\u7F8E\u3001\u526F\u7EC4\u7EC7\u79D8\u4E66\u957F\u517C\u5BF9\u534E\u4E8B\u52A1\u59D4\u5458\u4F1A\u526F\u4E3B\u5E2D\u62FF\u7763\u7B80\u6C11\u53D1\u3001\u4E00\u5E26\u4E00\u8DEF\u4E2D\u5FC3\u59D4\u5458\u4F1A\u4E3B\u5E2D\u526F\u4E3B\u5E2D\u62FF\u7763\u8BB8\u91D1\u6C49\u7B49\u3002\u4E00\u5E26\u4E00\u8DEF\u4E2D\u5FC3\u59D4\u5458\u4F1A\u4E3B\u5E2D\u62FF\u7763\u9648\u5FB7\u94A6\u5728\u81F4\u8BCD\u65F6\u5219\u5EFA\u8BAE\u653F\u5E9C\uFF0C\u6210\u7ACB\u653F\u5E9C\u5355\u4F4D\u4E3A\u4E3B\u7684\u201C\u9A6C\u4E2D\u7ECF\u6D4E\u54A8\u8BE2\u62D3\u5C55\u4E2D\u5FC3\u201D\uFF0C\u5E76\u76F8\u4FE1\u901A\u8FC7\u5B98\u65B9\u7684\u7AD9\u53F0\u548C\u80CC\u4E66\uFF0C\u5728\u914D\u5408\u6C11\u95F4\u7EC4\u7EC7\u7684\u6267\u884C\uFF0C\u9A6C\u4E2D\u4E00\u5E26\u4E00\u8DEF\u7684\u5DE5\u4F5C\u5C06\u5982\u864E\u6DFB\u7FFC\u3002\u4ED6\u8BF4\uFF0C\u672C\u8EAB\u6240\u5EFA\u8BAE\u7684\u201D\u9A6C\u4E2D\u7ECF\u6D4E\u54A8\u8BE2\u62D3\u5C55\u4E2D\u5FC3\u201C\u7684\u529F\u80FD\u3001\u6A21\u5F0F\u53CA\u65B9\u5F0F\u53EF\u4EE5\u6548\u4EFF\u5F53\u5E74\u9B4F\u5BB6\u7965\u62C5\u4EFB\u9996\u76F8\u7F72\u90E8\u957F\u65F6\u6240\u9886\u5BFC\u7684\u9A6C\u6765\u897F\u4E9A\u4E2D\u5C0F\u4F01\u4E1A\u62D3\u5C55\u4E2D\u5FC3\uFF08SAME\uFF09\u3002\u4ED6\u76F8\u4FE1\uFF0C\u901A\u8FC7\u6210\u7ACB\u5B98\u65B9\u7684\u201C\u9A6C\u4E2D\u7ECF\u6D4E\u54A8\u8BE2\u62D3\u5C55\u4E2D\u5FC3\u201D\u5C06\u5BF9\u9A6C\u4E2D\u4F01\u4E1A\u7684\u4E92\u76F8\u4EA4\u6D41\u8D77\u7684\u5F88\u5927\u7684\u5E2E\u52A9\u3002\u201D\u6211\u76F8\u4FE1\u603B\u4F1A\u957F\u9B4F\u5BB6\u7965\u5728\u8FD9\u65B9\u9762\u6709\u5F88\u591A\u7684\u6784\u601D\u548C\u65B9\u5F0F\u53EF\u4EE5\u8D21\u732E\u7ED9\u56FD\u5BB6\uFF0C\u9A6C\u534E\u968F\u65F6\u51C6\u5907\u5728\u56FD\u5BB6\u7ECF\u6D4E\u53D1\u5C55\u5217\u8F66\u5F53\u4E2D\uFF0C\u63D0\u4F9B\u66F4\u597D\u7684\u770B\u6CD5\u548C\u5EFA\u8BAE\u3002\u201C\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/AORRi8co0T797ayhIZdu5A\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
