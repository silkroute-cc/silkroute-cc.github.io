  "route": "/3373/",
  "title": "\u5370\u5C3C\u5C06\u4ECE6\u6708\u8D77\u7981\u6B62\u94DD\u571F\u77FF\u51FA\u53E3\uFF0C\u9A6C\u6765\u897F\u4E9A\u7784\u51C6\u201C\u4F9B\u5E94\u7A7A\u767D\u201D\u4E0E\u4E2D\u56FD\u5E02\u573A\u9700\u6C42",
  "summary": "\u300A\u6D77\u5CE1\u65F6\u62A5\u300B1\u67081\u65E5\u6D88\u606F\uFF0C\u5728\u5370\u5C3C\u5BA3\u5E03\u4ECE2023\u5E746\u6708\u8D77\u7981\u6B62\u94DD\u571F\u77FF\u51FA\u53E3\u4E4B\u540E\uFF0C\u4F5C\u4E3A\u66FE\u662F\u5BF9\u534E\u524D\u5341\u5927\u94DD\u571F\u77FF\u4F9B\u5E94\u56FD\u7684\u9A6C\u6765\u897F\u4E9A\u6709\u671B\u4ECE\u4E2D\u53D7\u76CA\u3002 \u6839\u636E\u5370\u5C3C\u6D77\u5173\u6570\u636E\uFF0C2021\u4E2D\u56FD\u4ECE\u5370\u5C3C\u8FDB\u53E31780\u4E07\u5428\u94DD\u571F\u77FF\uFF0C\u7EA6\u5360\u8FDB\u53E3\u603B\u91CF\u768415%\u3002\u53E6\u636E\u4E0A\u6D77\u6709\u8272\u7F51\u7EDF\u8BA1\uFF0C2021\u5E74\u4E2D\u56FD\u5408\u8BA1\u8FDB\u53E3\u94DD\u571F\u77FF10742\u4E07\u5428\uFF0C\u5176\u4E2D16.61%\u6765\u81EA\u5370\u5C3C\u3002 \u9A6C\u6765\u897F\u4E9A\u5929\u7136\u8D44\u6E90\u53CA\u73AF\u5883\u6C14\u5019\u53D8\u5316\u90E8\u957F\u8042\u7EB3\u5179\u7C73\uFF08Nik Nazmi bin Nik Ahmad\uFF09\u8868\u793A\uFF1A\u201C\u5982\u679C\u4E00\u4E2A\u56FD\u5BB6\uFF08\u5370\u5C3C\uFF09\u5BF9\u94DD\u571F\u77FF\u51FA\u53E3\u5B9E\u65BD\u7981\u4EE4\uFF0C\u90A3\u4E48\u5168\u7403\u9700\u6C42\u5C06\u8F6C\u79FB\u5230\u4EFB\u4F55\u5176\u4ED6\u2026",
  "body": "\u003Cp\u003E\u300A\u6D77\u5CE1\u65F6\u62A5\u300B1\u67081\u65E5\u6D88\u606F\uFF0C\u5728\u5370\u5C3C\u5BA3\u5E03\u4ECE2023\u5E746\u6708\u8D77\u7981\u6B62\u94DD\u571F\u77FF\u51FA\u53E3\u4E4B\u540E\uFF0C\u4F5C\u4E3A\u66FE\u662F\u5BF9\u534E\u524D\u5341\u5927\u94DD\u571F\u77FF\u4F9B\u5E94\u56FD\u7684\u9A6C\u6765\u897F\u4E9A\u6709\u671B\u4ECE\u4E2D\u53D7\u76CA\u3002\u003C/p\u003E\n\u003Cp\u003E\n\u6839\u636E\u5370\u5C3C\u6D77\u5173\u6570\u636E\uFF0C2021\u4E2D\u56FD\u4ECE\u5370\u5C3C\u8FDB\u53E31780\u4E07\u5428\u94DD\u571F\u77FF\uFF0C\u7EA6\u5360\u8FDB\u53E3\u603B\u91CF\u768415%\u3002\u53E6\u636E\u4E0A\u6D77\u6709\u8272\u7F51\u7EDF\u8BA1\uFF0C2021\u5E74\u4E2D\u56FD\u5408\u8BA1\u8FDB\u53E3\u94DD\u571F\u77FF10742\u4E07\u5428\uFF0C\u5176\u4E2D16.61%\u6765\u81EA\u5370\u5C3C\u3002\n\n\u9A6C\u6765\u897F\u4E9A\u5929\u7136\u8D44\u6E90\u53CA\u73AF\u5883\u6C14\u5019\u53D8\u5316\u90E8\u957F\u8042\u7EB3\u5179\u7C73\uFF08Nik Nazmi bin Nik Ahmad\uFF09\u8868\u793A\uFF1A\u201C\u5982\u679C\u4E00\u4E2A\u56FD\u5BB6\uFF08\u5370\u5C3C\uFF09\u5BF9\u94DD\u571F\u77FF\u51FA\u53E3\u5B9E\u65BD\u7981\u4EE4\uFF0C\u90A3\u4E48\u5168\u7403\u9700\u6C42\u5C06\u8F6C\u79FB\u5230\u4EFB\u4F55\u5176\u4ED6\u80FD\u591F\u63D0\u4F9B\u8FD9\u4E9B\u8D44\u6E90\u7684\u56FD\u5BB6\u3002\u5728\u8FD9\u79CD\u60C5\u51B5\u4E0B\uFF0C\u5BF9\u9A6C\u6765\u897F\u4E9A\u94DD\u571F\u77FF\u7684\u9700\u6C42\u4F1A\u5F88\u9AD8\uFF0C\u5C24\u5176\u662F\u6765\u81EA\u4E2D\u56FD\u7684\u9700\u6C42\u3002\u201D\n\n2019\u5E74\uFF0C\u9A6C\u6765\u897F\u4E9A\u5728\u5168\u7403\u4E8C\u5341\u5927\u94DD\u571F\u77FF\u751F\u4EA7\u56FD\u6392\u540D\u4E2D\u4E0B\u964D\u5230\u7B2C18\u4F4D\u3002\u6B64\u524D\uFF0C\u7531\u4E8E\u8BE5\u56FD\u4E1C\u90E8\u5F6D\u4EA8\u5DDE\u5B58\u5728\u65E0\u7BA1\u5236\u91C7\u77FF\u884C\u4E3A\uFF0C\u9A6C\u6765\u897F\u4E9A\u4ECE2016\u5E74\u8D77\u5B9E\u65BD\u4E3A\u671F3\u5E74\u7684\u91C7\u77FF\u7981\u4EE4\u3002\u8BE5\u56FD\u94DD\u571F\u77FF\u4EA7\u91CF\u4ECE2015\u5E74\u76842770\u4E07\u5428\u9510\u51CF\u81F32019\u5E74\u768490\u4E07\u5428\u51FA\u5934\uFF0C\u51FA\u53E3\u89C4\u6A21\u5219\u4ECE2015\u5E74\u7684350\u4E07\u5428\u51CF\u81F32019\u5E74\u768491.2\u4E07\u5428\uFF0C\u8DCC\u5E45\u8FD174%\u3002\n\n2019\u5E74\u53D6\u6D88\u91C7\u77FF\u7981\u4EE4\u540E\uFF0C\u9A6C\u6765\u897F\u4E9A\u653F\u5E9C\u5F00\u59CB\u5B9E\u65BD\u65B0\u7684\u4E25\u683C\u89C4\u5B9A\uFF0C\u5982\u51CF\u5C11\u5F6D\u4EA8\u5DDE\u57282020\u5E746\u6708\u81F32021\u5E745\u6708\u671F\u95F4\u7684\u53EF\u91C7\u77FF\u6D3B\u52A8\u533A\u57DF\uFF0C\u5E76\u8981\u6C42\u5C55\u5F00\u73AF\u5883\u5F71\u54CD\u8BC4\u4F30\uFF0C\u5BFC\u81F4\u9A6C\u6765\u897F\u4E9A\u7684\u94DD\u571F\u77FF\u51FA\u53E3\u8FDB\u4E00\u6B65\u840E\u7F29\uFF0C\u57282021\u5E74\u53EA\u6709\u8FD122.8\u4E07\u5428\u3002\n\u003C/p\u003E\n\u003Cp\u003E\n\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/B2JzYzhhKnDZmCxktGvLlg\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
