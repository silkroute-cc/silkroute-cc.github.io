  "title": "\u603B\u503C320\u4EBF\u4EE4\u5409\u7684\u6C7D\u8F66\u9AD8\u79D1\u6280\u8C37\u53D1\u5C55\u9879\u76EE",
  "summary": "\uFF08\u7F8E\u7F5713\u65E5\u8BAF\uFF09\u9739\u96F3\u5DDE\u52A1\u5927\u81E3\u62FF\u7763\u65AF\u91CC\u6C99\u62C9\u5C3C\u8BF4\uFF0C\u4E39\u7ED2\u9A6C\u6797\u5C06\u89C1\u8BC1\u6C7D\u8F66\u9AD8\u79D1\u6280\u8C37\uFF08AHTV\uFF09\u53D1\u5C55\u9879\u76EE\u7684\u7ECF\u6D4E\u6EA2\u51FA\u6548\u5E94\uFF0C\u9884\u8BA1\u8BE5\u9879\u76EE\u5728\u65BD\u5DE5\u671F\u95F4\u5C06\u521B\u902037\u4E07\u4E2A\u5C31\u4E1A\u673A\u4F1A\uFF0C\u6295\u5165\u8425\u8FD0\u540E\u5219\u521B\u902016\u4E07\u4E2A\u5C31\u4E1A\u673A\u4F1A\u3002 \u4ED6\u6307\u51FA\uFF0C\u603B\u503C320\u4EBF\u4EE4\u5409\u7684\u6C7D\u8F66\u9AD8\u79D1\u6280\u8C37\u53D1\u5C55\u9879\u76EE\u5C06\u4E3A\u7F8E\u7F57\u53CA\u9A6C\u767B\u5DF4\u51B7\u623F\u5730\u4EA7\u4EF7\u683C\u53CA\u53D1\u5C55\u5E26\u6765\u79EF\u6781\u5F71\u54CD\u3002 \u6C99\u62C9\u5C3C\u4ECA\u5929\u5728\u5F00\u658B\u8282\u8336\u4F1A\u66A8\u623F\u5C4B\u9879\u76EE\u63A8\u4ECB\u793C\u4E0A\u8BF4\uFF0C\u9739\u96F3\u5DDE\u653F\u5E9C\u4E5F\u901A\u8FC7\u9739\u96F3\u623F\u5730\u4EA7\u5C40\u63D0\u4F9B\u65B0\u7684\u623F\u5C4B\u9879\u76EE\uFF0C\u4EE5\u6EE1\u8DB3\u8BE5\u53BF\u7684\u9AD8\u4F01\u9700\u6C42\uFF1A\u201CAHTV\u5927\u578B\u9879\u76EE\u80AF\u5B9A\u4F1A\u8981\u6C42\u63D0\u4F9B\u8DB3\u591F\u7684\u4F4F\u5B85\u5355\u4F4D\uFF0C\u4EE5\u6EE1\u8DB3\u5BF9\u623F\u5C4B\u7684\u957F\u671F\u9700\u6C42\u3002\u201D\u2026",
  "body": "\u003Cp\u003E\uFF08\u7F8E\u7F5713\u65E5\u8BAF\uFF09\u9739\u96F3\u5DDE\u52A1\u5927\u81E3\u62FF\u7763\u65AF\u91CC\u6C99\u62C9\u5C3C\u8BF4\uFF0C\u4E39\u7ED2\u9A6C\u6797\u5C06\u89C1\u8BC1\u6C7D\u8F66\u9AD8\u79D1\u6280\u8C37\uFF08AHTV\uFF09\u53D1\u5C55\u9879\u76EE\u7684\u7ECF\u6D4E\u6EA2\u51FA\u6548\u5E94\uFF0C\u9884\u8BA1\u8BE5\u9879\u76EE\u5728\u65BD\u5DE5\u671F\u95F4\u5C06\u521B\u902037\u4E07\u4E2A\u5C31\u4E1A\u673A\u4F1A\uFF0C\u6295\u5165\u8425\u8FD0\u540E\u5219\u521B\u902016\u4E07\u4E2A\u5C31\u4E1A\u673A\u4F1A\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6307\u51FA\uFF0C\u603B\u503C320\u4EBF\u4EE4\u5409\u7684\u6C7D\u8F66\u9AD8\u79D1\u6280\u8C37\u53D1\u5C55\u9879\u76EE\u5C06\u4E3A\u7F8E\u7F57\u53CA\u9A6C\u767B\u5DF4\u51B7\u623F\u5730\u4EA7\u4EF7\u683C\u53CA\u53D1\u5C55\u5E26\u6765\u79EF\u6781\u5F71\u54CD\u3002\u003C/p\u003E\n\u003Cp\u003E\u6C99\u62C9\u5C3C\u4ECA\u5929\u5728\u5F00\u658B\u8282\u8336\u4F1A\u66A8\u623F\u5C4B\u9879\u76EE\u63A8\u4ECB\u793C\u4E0A\u8BF4\uFF0C\u9739\u96F3\u5DDE\u653F\u5E9C\u4E5F\u901A\u8FC7\u9739\u96F3\u623F\u5730\u4EA7\u5C40\u63D0\u4F9B\u65B0\u7684\u623F\u5C4B\u9879\u76EE\uFF0C\u4EE5\u6EE1\u8DB3\u8BE5\u53BF\u7684\u9AD8\u4F01\u9700\u6C42\uFF1A\u201CAHTV\u5927\u578B\u9879\u76EE\u80AF\u5B9A\u4F1A\u8981\u6C42\u63D0\u4F9B\u8DB3\u591F\u7684\u4F4F\u5B85\u5355\u4F4D\uFF0C\u4EE5\u6EE1\u8DB3\u5BF9\u623F\u5C4B\u7684\u957F\u671F\u9700\u6C42\u3002\u201D\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/04/frc-1967baa0ac9e8b65c4dff5687bc5c827.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u6C99\u62C9\u5C3C\uFF08\u4E2D\uFF09\u51FA\u5E2D\u5F00\u658B\u8282\u8336\u4F1A\u66A8\u623F\u5C4B\u9879\u76EE\u63A8\u4ECB\u793C\u3002\u5DE6\u4E8C\u4E3A\u897F\u534E\u5C3C\u7533\uFF0C\u6C99\u62C9\u5C3C\u8EAB\u540E\u4E3A\u9EC4\u8BD7\u60C5\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8868\u793A\uFF0C\u516C\u79C1\u5408\u4F5C\u4F19\u4F34\u5173\u7CFB\u5B9E\u65BD\u7684\u623F\u5C4B\u9879\u76EE\uFF0C\u53EF\u4EE5\u901A\u8FC7\u4E3A\u4EBA\u6C11\u63D0\u4F9B\u623F\u5C4B\u7684\u9879\u76EE\u523A\u6FC0\u7ECF\u6D4E\u589E\u957F\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u636E\u6211\u4E86\u89E3\uFF0C\u5728\u9739\u96F3\u623F\u5730\u4EA7\u5C40\u6240\u62E5\u6709\u571F\u5730\u4E0A\u5EFA\u9020\u7684\u7F8E\u7F57\u6E56\u666F\u56ED\u4F4F\u5B85\u9879\u76EE\uFF08Lakeview Residences Bidor\uFF09\u4E8E2022\u5E7410\u670820\u65E5\u52A8\u5DE5\uFF0C\u8BE5\u9879\u76EE\u63D0\u4F9B64\u4E2A\u4F4F\u5B85\u5355\u4F4D\uFF0C\u5305\u62EC52\u4E2A\u5355\u5C42\u534A\u72EC\u7ACB\u5F0F\u5355\u4F4D\u548C12\u4E2A\u5355\u5C42\u6392\u5C4B\u5355\u4F4D\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u9739\u96F3\u623F\u5730\u4EA7\u5C40\u4E0EDemi Hartajaya\u4E4B\u95F4\u7684\u5408\u4F5C\u662F\u671D\u7740\u5EFA\u9020\u66F4\u591A\u4F4F\u5B85\u533A\u7684\u65B9\u5411\u8FC8\u8FDB\uFF0C\u4E3A\u60F3\u8981\u62E5\u6709\u623F\u5C4B\u8005\u63D0\u4F9B\u66F4\u591A\u9009\u62E9\u3002\u003C/p\u003E\n\u003Cp\u003E\u6C99\u62C9\u5C3C\u4FC3\u8BF7\u79C1\u4EBA\u53D1\u5C55\u5546\u7EE7\u7EED\u901A\u8FC7\u9739\u96F3\u623F\u5730\u4EA7\u5C40\u4E0E\u5DDE\u653F\u5E9C\u5408\u4F5C\uFF0C\u5728\u9739\u96F3\u5F00\u53D1\u66F4\u591A\u4F4F\u5B85\u533A\uFF0C\u63D0\u4F9B\u5404\u79CD\u7C7B\u623F\u5C4B\u3002\u003C/p\u003E\n\u003Cp\u003E\u51FA\u5E2D\u5609\u5BBE\u5305\u62EC\u9739\u96F3\u5DDE\u884C\u653F\u8BAE\u5458\u897F\u534E\u5C3C\u7533\u3001\u8FEA\u906E\u5DDE\u8BAE\u5458\u9EC4\u8BD7\u60C5\u7B49\u3002\u003C/p\u003E\n\u003Ch1\u003E\u5B89\u534E\u89C1\u8BC1\u5409\u5229\u4E0E\u591A\u5143\u91CD\u5DE5\u7B7E\u7F72\u4E3B\u5408\u4F5C\u534F\u8BAE\u003C/h1\u003E\n\u003Cp\u003E\u53D1\u5E03\u4E8E 2023\u5E7410\u670811\u65E5\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/04/frc-70ca25666d429cf0c6e231ef14a8eb60.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5B89\u534E\uFF08\u7AD9\u8005\u5DE66\uFF09\u89C1\u8BC1\u591A\u5143\u91CD\u5DE5\u4E0E\u5409\u5229\u63A7\u80A1\u96C6\u56E2\u7B7E\u7F72\u4E3B\u5408\u4F5C\u534F\u8BAE\u3002\u5750\u5DE6\u8D77\u963F\u5179\u91CC\u624E\u54C8\u9C81\u4E01\u548C\u9B4F\u6885\u3002\u003C/p\u003E\n\u003Cp\u003E\uFF08\u4E39\u7ED2\u9A6C\u679711\u65E5\u8BAF\uFF09\u9996\u76F8\u62FF\u7763\u65AF\u91CC\u5B89\u534E\u4ECA\u5929\u5728\u4E39\u7ED2\u9A6C\u6797\u5B9D\u817E\u57CE\u4E3B\u6301\u9AD8\u79D1\u6280\u6C7D\u8F66\u8C37\uFF08AHTV\uFF09\u9879\u76EE\u7684\u4F1A\u8BAE\uFF0C\u5E76\u5DF2\u89C1\u8BC1\u5409\u5229\u96C6\u56E2\u4E0E\u591A\u5143\u91CD\u5DE5\u7B7E\u7F72\u4E3B\u5408\u4F5C\u4F1A\u8BAE\uFF08MCA\uFF09\uFF0C\u5E0C\u671B\u8BE5\u9879\u76EE\u80FD\u4F9D\u8BA1\u5212\u6210\u529F\u63A8\u884C\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u4ECA\u5929\u4E0B\u5348\u900F\u8FC7\u793E\u5A92\u4E13\u9875\u4E0A\u4F20\u8D34\u6587\u6307\u51FA\uFF0C\u4ED6\u5DF2\u5728\u4E39\u7ED2\u9A6C\u6797\u5B9D\u817E\u57CE\u4E3B\u6301\u9AD8\u79D1\u6280\u6C7D\u8F66\u8C37\uFF08AHTV\uFF09\u7684\u4F1A\u8BAE\u3002\u51FA\u5E2D\u4F1A\u8BAE\u8005\u5305\u62EC\u9739\u96F3\u5DDE\u52A1\u5927\u81E3\u62FF\u7763\u65AF\u91CC\u6C99\u62C9\u5C3C\u3001\u6295\u8D44\u3001\u8D38\u6613\u53CA\u5DE5\u4E1A\u90E8\u957F\u4E1C\u59D1\u624E\u592B\u9C81\u548C\u79D1\u5B66\u5DE5\u827A\u53CA\u9769\u65B0\u90E8\u957F\u90D1\u7ACB\u6177\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u8BE5\u9AD8\u79D1\u6280\u6C7D\u8F66\u8C37\u662F\u4E00\u9879\u6D89\u53CA\u6295\u8D44\u989D320\u4EBF\u4EE4\u5409\u7684\u5927\u578B\u9879\u76EE\uFF0C\u7531\u5409\u5229\u63A7\u80A1\u96C6\u56E2\uFF08Geely Holding\uFF09\uFF0C\u8054\u540C\u9A6C\u6765\u897F\u4E9A\u591A\u5143\u91CD\u5DE5\uFF08DRB_Hicom\uFF09\u63A8\u5C55\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8868\u793A\uFF0C\u8BE5\u9879\u76EE\u5C06\u4F1A\u628A\u4E39\u7ED2\u9A6C\u6797\u6253\u9020\u6210\u4E3A\u4E00\u4E2A\u65B0\u80FD\u6E90\u6C7D\u8F66\uFF08NEV\uFF09\u7684\u5168\u7403\u6027\u6C7D\u8F66\u4E1A\u67A2\u7EBD\uFF0C\u540C\u65F6\u4E5F\u6210\u4E3A\u6316\u6398\u624D\u80FD\u3001\u7814\u7A76\u4E0E\u53D1\u5C55\u53CA\u57CE\u5E02\u5316\u7B49\u91CD\u8981\u5730\u533A\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6307\u51FA\uFF0C\u4ED6\u4E5F\u89C1\u8BC1\u4E86\u591A\u5143\u91CD\u5DE5\u4E0E\u5409\u5229\u7B7E\u7F72\u7684\u4E3B\u5408\u4F5C\u534F\u8BAE\uFF08MCA\uFF09\uFF0C\u4F5C\u4E3A\u5171\u540C\u6210\u5C31\u9AD8\u79D1\u6280\u6C7D\u8F66\u8C37\u9879\u76EE\u7684\u5171\u8BC6\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/04/frc-23ca8be2946b69ef65c4c40a1f564f91.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u6B64\u5916\uFF0C\u4ED6\u4E5F\u5728\u4F1A\u4E0A\u89C1\u8BC1\u4E86Altel Communication\u548CGeespace Technology\uFF08\u5409\u5229\u7B56\u7565\u6295\u8D44\u516C\u53F8\uFF09\u7B7E\u7F72\u610F\u5411\u534F\u8BAE\uFF08HOA\uFF09\uFF0C\u5C06\u8457\u91CD\u5728\u9AD8\u79D1\u6280\u53D1\u5C55\u548C\u6267\u884C\uFF0C\u4EE5\u53CA\u5F3A\u5316\u5F00\u53D1\u65B9\u6848\u4E88\u5404\u9886\u57DF\uFF0C\u6BD4\u5982\u667A\u80FD\u6E2F\u53E3\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u56E2\u7ED3\u653F\u5E9C\u7684\u652F\u6301\u4E0E\u8BE5\u9879\u76EE\u7684\u6D41\u7545\u6027\uFF0C\u900F\u8FC7\u7B80\u5316\u7684\u6295\u8D44\u65B9\u5F0F\uFF0C\u5C06\u6210\u4E3A\u6295\u8D44\u8005\u5728\u9A6C\u6765\u897F\u4E9A\u6295\u8D44\u7684\u5178\u8303\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u4E5F\u795D\u613F\u8BE5\u9879\u76EE\u80FD\u4F9D\u636E\u8BA1\u5212\u987A\u5229\u548C\u6210\u529F\u6267\u884C\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/04/frc-26a77dbf16934cec50f3d9b26b786947.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u53E6\u4E00\u65B9\u9762\uFF0C\u591A\u5143\u91CD\u5DE5\u4E5F\u53D1\u6587\u544A\u6307\u51FA\uFF0C\u8BE5\u516C\u53F8\u548C\u5409\u5229\u96C6\u56E2\u7B7E\u7F72\u4E3B\u5408\u4F5C\u534F\u8BAE\uFF08MCA\uFF09\uFF0C\u5C06\u6210\u4E3A\u9AD8\u79D1\u6280\u6C7D\u8F66\u8C37\u9879\u76EE\u7684\u91CD\u8981\u5386\u53F2\u6027\u65F6\u523B\u3002\u003C/p\u003E\n\u003Cp\u003E\u6587\u544A\u6307\u51FA\uFF0C\u8BE5\u534F\u8BAE\u7531\u591A\u5143\u91CD\u5DE5\u96C6\u56E2\u623F\u5730\u4EA7\u3001\u89C4\u5212\u4E0E\u7B56\u7565\u9996\u5E2D\u8425\u8FD0\u5B98\u963F\u5179\u91CC\u624E\u54C8\u9C81\u4E01\uFF0C\u4EE5\u53CA\u5409\u5229\u63A7\u80A1\u96C6\u56E2\u9AD8\u7EA7\u526F\u603B\u88C1\u517C\u9996\u5E2D\u8425\u8FD0\u5B98\u9B4F\u6885\u7B7E\u7F72\uFF0C\u5E76\u7531\u9996\u76F8\u5B89\u534E\u89C1\u8BC1\u3002\u003C/p\u003E\n\u003Cp\u003E\u6587\u544A\u89E3\u91CA\uFF0C\u8BE5\u534F\u8BAE\u5236\u5B9A\u6570\u9879\u57FA\u672C\u539F\u5219\u3001\u884C\u653F\u7BA1\u7406\u8303\u7574\uFF0C\u4EE5\u53CA\u5171\u540C\u53D1\u5C55\u9AD8\u79D1\u6280\u6C7D\u8F66\u8C37\u7684\u5171\u8BC6\uFF0C\u5305\u62EC\u9700\u8981\u5B9E\u65BD\u7684\u53D1\u5C55\u548C\u63A8\u5E7F\u89D2\u8272\u3002\u003C/p\u003E\n\u003Cp\u003E\u6587\u544A\u6307\u51FA\uFF0C\u8BE5\u9AD8\u79D1\u6280\u6C7D\u8F66\u8C37\u7684\u9879\u76EE\u5C06\u4F1A\u5438\u5F15\u56FD\u5185\u5916\u7684\u6295\u8D44\u8005\uFF0C\u8BE5\u6C7D\u8F66\u8C37\u4E0D\u4EC5\u8457\u91CD\u751F\u4EA7\u5404\u4E2A\u54C1\u724C\u7684\u8F7F\u8F66\uFF0C\u66F4\u80FD\u5236\u9020\u9AD8\u79D1\u6280\u7684\u65B0\u80FD\u6E90\u6C7D\u8F66\u673A\u4EF6\uFF0C\u6253\u9020\u6210\u4E3A\u56FD\u9645\u65B0\u80FD\u6E90\u6C7D\u8F66\u67A2\u7EBD\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/z48Uk5dK7bXHVHdue-Zc7g\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
