{
  "id": "%e6%b0%91%e9%83%bd%e9%b2%81%e6%b5%b7%e6%b8%af%e6%98%af%e4%b8%9c%e4%ba%9a%e6%9c%80%e5%a4%a7%e6%b6%b2%e5%8c%96%e5%a4%a9%e7%84%b6%e6%b0%94%e5%87%ba%e5%8f%a3%e7%a0%81%e5%a4%b4-%e4%b9%9f%e6%98%af%e4%b8%9c",
  "slug": "%e6%b0%91%e9%83%bd%e9%b2%81%e6%b5%b7%e6%b8%af%e6%98%af%e4%b8%9c%e4%ba%9a%e6%9c%80%e5%a4%a7%e6%b6%b2%e5%8c%96%e5%a4%a9%e7%84%b6%e6%b0%94%e5%87%ba%e5%8f%a3%e7%a0%81%e5%a4%b4-%e4%b9%9f%e6%98%af%e4%b8%9c",
  "canonicalUrlKey": "%e6%b0%91%e9%83%bd%e9%b2%81%e6%b5%b7%e6%b8%af%e6%98%af%e4%b8%9c%e4%ba%9a%e6%9c%80%e5%a4%a7%e6%b6%b2%e5%8c%96%e5%a4%a9%e7%84%b6%e6%b0%94%e5%87%ba%e5%8f%a3%e7%a0%81%e5%a4%b4-%e4%b9%9f%e6%98%af%e4%b8%9c",
  "route": "/4482/",
  "title": "\u6C11\u90FD\u9C81\u6D77\u6E2F\u662F\u4E1C\u4E9A\u6700\u5927\u6DB2\u5316\u5929\u7136\u6C14\u51FA\u53E3\u7801\u5934 \u4E5F\u662F\u4E1C\u9A6C\u6700\u5927\u96C6\u88C5\u7BB1\u7801\u5934",
  "summary": "\uFF08\u53E4\u664B28\u65E5\u8BAF\uFF09\u6C11\u90FD\u9C81\u6D77\u6E2F\u63A7\u80A1\u516C\u53F8\u9996\u5E2D\u6267\u884C\u5458\u9C81\u65AF\u5170\u5BBE\u963F\u90FD\u5609\u5C3C\u8868\u793A\uFF0C\u6839\u636E\u4ED6\u7684\u4F30\u8BA1\uFF0C\u6C11\u90FD\u9C81\u6D77\u6E2F\u53CA\u6C99\u739B\u62C9\u5982\u5DE5\u4E1A\u6D77\u6E2F\u7684\u7ED3\u5408\u9884\u8BA1\u6BCF\u5E74\u5904\u7406\u7684\u8D27\u7269\u4EF7\u503C\u5C06\u8FBE\u5230\u7EA6\u534A\u4E07\u4EBF\u4EE4\u5409\u3002 \u201C\u8BBA\u4EF7\u503C\u6216\u4EA7\u54C1\u6210\u672C\u800C\u8A00\uFF0C\u6211\u4EEC\u5F88\u53EF\u80FD\u662F\u7B2C\u4E00\uFF0C\u7279\u522B\u662F\u7531\u4E8E\u6BCF\u5E74\u7EA6\u6709450\u8258\u6DB2\u5316\u5929\u7136\u6C14\u8239\uFF0C\u4E00\u8258\u6DB2\u5316\u5929\u7136\u6C14\u8239\u7684\u8D27\u7269\u4EF7\u503C\u6570\u4EBF\u3002\u201D \u4ED6\u8BF4\uFF0C\u6C11\u90FD\u9C81\u6D77\u6E2F\u662F\u4E00\u4E2A\u771F\u6B63\u7684\u7EFC\u5408\u6027\u6E2F\u53E3\uFF0C\u4E0E\u5176\u4ED6\u4EFB\u4F55\u6E2F\u53E3\u90FD\u4E0D\u540C\uFF0C\u4E0D\u4EC5\u62E5\u6709\u6DB2\u5316\u5929\u7136\u6C14\u51FA\u53E3\uFF0C\u800C\u4E14\u662F\u4E1C\u4E9A\u6700\u5927\u7684\u6DB2\u5316\u5929\u7136\u6C14\u51FA\u53E3\u7801\u5934\u3002 \u9C81\u65AF\u5170\u5BBE\u963F\u90FD\u5609\u5C3C\u4E8E27\u65E5\u5728Sheraton\u9152\u5E97\u4E3E\u529E\u6C11\u90FD\u9C81\u6D77\u6E2F\u5A92\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/03/frc-d221692e0104e510d2c42fe9140af5ab.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\uFF08\u53E4\u664B28\u65E5\u8BAF\uFF09\u6C11\u90FD\u9C81\u6D77\u6E2F\u63A7\u80A1\u516C\u53F8\u9996\u5E2D\u6267\u884C\u5458\u9C81\u65AF\u5170\u5BBE\u963F\u90FD\u5609\u5C3C\u8868\u793A\uFF0C\u6839\u636E\u4ED6\u7684\u4F30\u8BA1\uFF0C\u6C11\u90FD\u9C81\u6D77\u6E2F\u53CA\u6C99\u739B\u62C9\u5982\u5DE5\u4E1A\u6D77\u6E2F\u7684\u7ED3\u5408\u9884\u8BA1\u6BCF\u5E74\u5904\u7406\u7684\u8D27\u7269\u4EF7\u503C\u5C06\u8FBE\u5230\u7EA6\u534A\u4E07\u4EBF\u4EE4\u5409\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u8BBA\u4EF7\u503C\u6216\u4EA7\u54C1\u6210\u672C\u800C\u8A00\uFF0C\u6211\u4EEC\u5F88\u53EF\u80FD\u662F\u7B2C\u4E00\uFF0C\u7279\u522B\u662F\u7531\u4E8E\u6BCF\u5E74\u7EA6\u6709450\u8258\u6DB2\u5316\u5929\u7136\u6C14\u8239\uFF0C\u4E00\u8258\u6DB2\u5316\u5929\u7136\u6C14\u8239\u7684\u8D27\u7269\u4EF7\u503C\u6570\u4EBF\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u6C11\u90FD\u9C81\u6D77\u6E2F\u662F\u4E00\u4E2A\u771F\u6B63\u7684\u7EFC\u5408\u6027\u6E2F\u53E3\uFF0C\u4E0E\u5176\u4ED6\u4EFB\u4F55\u6E2F\u53E3\u90FD\u4E0D\u540C\uFF0C\u4E0D\u4EC5\u62E5\u6709\u6DB2\u5316\u5929\u7136\u6C14\u51FA\u53E3\uFF0C\u800C\u4E14\u662F\u4E1C\u4E9A\u6700\u5927\u7684\u6DB2\u5316\u5929\u7136\u6C14\u51FA\u53E3\u7801\u5934\u3002\u003C/p\u003E\n\u003Cp\u003E\u9C81\u65AF\u5170\u5BBE\u963F\u90FD\u5609\u5C3C\u4E8E27\u65E5\u5728Sheraton\u9152\u5E97\u4E3E\u529E\u6C11\u90FD\u9C81\u6D77\u6E2F\u5A92\u4F53\u4E4B\u591C\u4E0A\u81F4\u8BCD\u65F6\uFF0C\u5982\u662F\u8868\u793A\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u63A5\u7740\u4E5F\u6307\u51FA\uFF0C\u6C11\u90FD\u9C81\u6D77\u6E2F\u4E5F\u662F\u4E1C\u9A6C\u6700\u5927\u7684\u96C6\u88C5\u7BB1\u7801\u5934\uFF0C\u6BD4\u6C99\u5DF4\u7684\u5168\u90E88\u4E2A\u6E2F\u53E3\u5904\u7406\u7684\u96C6\u88C5\u7BB1\u603B\u548C\u8FD8\u8981\u591A\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u4EEC\u662F\u7802\u62C9\u8D8A\u68D5\u6988\u6CB9\u4EA7\u54C1\u7684\u4E3B\u8981\u51FA\u53E3\u6E20\u9053\uFF0C\u5360\u7802\u62C9\u8D8A\u51FA\u53E3\u768495%\uFF0C\u7EA6\u4E3A400\u4E07\u5428/\u5E74\u3002\u6211\u4EEC\u4EE5\u5428\u4F4D\u8BA1\u7B97\u5728\u9A6C\u6765\u897F\u4E9A\u5168\u56FD\u6392\u540D\u7B2C\u4E09\uFF0C\u7EA6\u4E3A5000\u4E07\u5428/\u5E74\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u900F\u9732\uFF0C\u6C11\u90FD\u9C81\u6D77\u6E2F\u4E5F\u6709\u83B7\u5F97\u8D22\u653F\u90E8\u53CA\u6D77\u5173\u5728\u53BB\u5E749\u6708\u6388\u4E88\u7684\u5728\u7802\u62C9\u8D8A\u7ECF\u8425\u5B8C\u6574\u7684\u77F3\u6CB9\u548C\u5929\u7136\u6C14\u4F9B\u5E94\u57FA\u5730\u7684\u552F\u4E00\u8BB8\u53EF\u8BC1\uFF0C\u8FD9\u5C06\u4F7F\u5F97\u6C11\u90FD\u9C81\u6D77\u6E2F\u80FD\u591F\u66F4\u6709\u6548\u5730\u4E3A\u7802\u62C9\u8D8A\u6D77\u57DF\uFF0C\u7279\u522B\u662F\u6C11\u90FD\u9C81\u6C34\u57DF\u63D0\u4F9B\u670D\u52A1\u3002\u003C/p\u003E\n\u003Cp\u003E\u9C81\u65AF\u5170\u5BBE\u963F\u90FD\u5609\u5C3C\u8868\u793A\uFF0C\u6C11\u90FD\u9C81\u6D77\u6E2F\u63A7\u80A1\u516C\u53F8\u5728\u5E02\u503C\u65B9\u9762\u662F\u7802\u62C9\u8D8A\u4E0A\u5E02\u516C\u53F8\u4E2D\u7684\u7B2C\u4E00\u540D\uFF0C\u7EA6\u4E3A26\u4EBF\u4EE4\u5409\uFF0C\u4E1D\u6BEB\u6CA1\u6709\u611F\u5230\u9A84\u50B2\u81EA\u6EE1\uFF0C\u751A\u81F3\u6709\u65F6\u5019\u6392\u5728Dayang Enterprise\u4E4B\u540E\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u4E8B\u5B9E\u4E0A\uFF0C\u8FD9\u8BA9\u6211\u4EEC\u66F4\u52A0\u8C26\u5351\uFF0C\u56E0\u4E3A\u6211\u4EEC\u610F\u8BC6\u5230\u4E86\u80A9\u4E0A\u6240\u627F\u8F7D\u7684\u91CD\u5927\u4FE1\u6258\u3002\u6211\u4EEC\u4EE5\u8363\u5E78\u627F\u62C5\u8FD9\u4EFD\u8D23\u4EFB\uFF0C\u5E76\u4EE5\u6700\u575A\u5B9A\u548C\u4E13\u6CE8\u7684\u6001\u5EA6\u6765\u5C65\u884C\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u900F\u9732\uFF0C\u7279\u522B\u662F\u5728\u5B9E\u73B0\u7802\u603B\u7406\u7684\u613F\u666F\uFF0C\u4F7F\u7802\u62C9\u8D8A\u6210\u4E3A\u7ECF\u6D4E\u5F3A\u56FD\uFF0C\u5E76\u5F15\u9886\u9A6C\u6765\u897F\u4E9A\u8FC8\u5411\u7EFF\u8272\u548C\u6E05\u6D01\u80FD\u6E90\u7684\u613F\u666F\u65B9\u9762\uFF0C\u5FC5\u987B\u62E5\u6709\u5F3A\u5927\u57FA\u7840\u8BBE\u65BD\uFF0C\u7279\u522B\u662F\u4E00\u4E2A\u9AD8\u6548\u8FD0\u8425\u7684\u6E2F\u53E3\uFF0C\u5C06\u662F\u5B9E\u73B0\u8FD9\u4E00\u613F\u666F\u7684\u5173\u952E\u3002\u003C/p\u003E\n\u003Cp\u003E\u56E0\u6B64\uFF0C\u8BE5\u516C\u53F8\u7ACB\u5FD7\u6210\u4E3A\u4E00\u4E2A\u201C\u9996\u8981\u7684\u7EFF\u8272\u80FD\u6E90\u6E2F\u53E3\u201D \uFF0C\u5728\u672A\u6765\u51E0\u5E74\u6EE1\u8DB3\u4E16\u754C\u5BF9\u7EFF\u8272\u548C\u6E05\u6D01\u80FD\u6E90\u7684\u9700\u6C42\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E0E\u6B64\u540C\u65F6\uFF0C\u5F53\u665A\u9C81\u65AF\u5170\u5BBE\u963F\u90FD\u5609\u5C3C\u4E5F\u4E0D\u5FD8\u606D\u8D3A\u7802\u62C9\u8D8A\u5DDE\u52A1\u79D8\u4E66\u62FF\u7763\u65AF\u91CC\u83AB\u54C8\u672B\u963F\u5E03\u5DF4\u5361\u4E8E\u53BB\u5E7412\u67081\u65E5\u88AB\u59D4\u4EFB\u4E3A\u6C11\u90FD\u9C81\u6D77\u6E2F\u63A7\u80A1\u516C\u53F8\u7684\u4E3B\u5E2D\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6307\u51FA\uFF0C\u83AB\u54C8\u672B\u963F\u5E03\u5DF4\u5361\u521B\u9020\u4E86\u5386\u53F2\uFF0C\u6210\u4E3A\u8BE5\u516C\u53F8\u6709\u53F2\u4EE5\u6765\u7684\u7B2C\u4E00\u4F4D\u7802\u62C9\u8D8A\u4E3B\u5E2D\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u81EA\u6210\u7ACB\u4EE5\u6765\uFF0C\u6211\u4EEC\u4ECE\u672A\u6709\u8FC7\u8FD9\u6837\u7684\u60C5\u51B5\uFF0C\u4E5F\u6CA1\u6709\u572830\u5E74\u524D\u7684\u6C11\u90FD\u9C81\u6D77\u6E2F\u63A7\u80A1\u516C\u53F8\u4E2D\u6709\u8FC7\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u5BF9\u4ED6\u6765\u8BF4\uFF0C\u8FD9\u7B97\u662F\u4E00\u6B21\u76F8\u5F53\u6210\u529F\u7684\u884C\u52A8\uFF0C\u5E76\u4E0D\u662F\u56E0\u4E3A\u593A\u53D6\u4E3B\u5E2D\u804C\u4F4D\uFF0C\u800C\u662F\u56E0\u4E3A\u80FD\u591F\u6709\u4E00\u4F4D\u73B0\u4EFB\u7802\u62C9\u8D8A\u5DDE\u52A1\u79D8\u4E66\u4F5C\u4E3A\u6C11\u90FD\u9C81\u6D77\u6E2F\u63A7\u80A1\u516C\u53F8\u4E3B\u5E2D\u5B9E\u5C5E\u4E0D\u6613\u3002\u003C/p\u003E\n\u003Cp\u003E\u9C81\u65AF\u5170\u5BBE\u963F\u90FD\u5609\u5C3C\u8868\u793A\uFF0C\u6C11\u90FD\u9C81\u6E2F\u5A92\u4F53\u611F\u8C22\u4E4B\u591C\u4E0D\u4EC5\u4EC5\u662F\u4E00\u573A\u665A\u5BB4\uFF0C\u800C\u4E14\u662F\u5BF9\u6240\u6709\u5A92\u4F53\u4ECE\u4E1A\u8005\u3001\u8BB0\u8005\u3001\u653F\u5E9C\u673A\u6784\u548C\u79C1\u8425\u673A\u6784\u7684\u8BA4\u53EF\uFF0C\u59CB\u7EC8\u652F\u6301\u8BE5\u516C\u53F8\u7684\u6D3B\u52A8\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u4F20\u64AD\u6C11\u90FD\u9C81\u6D77\u6E2F\u63A7\u80A1\u516C\u53F8\u57282023\u5E74\u5B9E\u65BD\u7684\u9879\u76EE\u7684\u5BA3\u4F20\u65B9\u9762\uFF0C\u5F53\u665A\u9881\u53D1\u4E8614\u4E2A\u611F\u8C22\u5956\u9879\uFF0C\u5305\u62EC\u653F\u5E9C\u673A\u6784\u3001\u79C1\u8425\u673A\u6784\u548C\u5176\u4ED6\u5A92\u4F53\u5408\u4F5C\u4F19\u4F34\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6307\u51FA\uFF0C\u8FD9\u4E9B\u611F\u8C22\u5956\u9879\u90FD\u662F\u8BE5\u516C\u53F8\u5BF9\u653F\u5E9C\u673A\u6784\u3001\u79C1\u8425\u673A\u6784\u548C\u5A92\u4F53\u5408\u4F5C\u4F19\u4F34\u57282023\u5E74\u5168\u5E74\u4E3A\u65B0\u95FB\u62A5\u9053\u548C\u5BA3\u4F20\u5DE5\u4F5C\u6240\u4F5C\u51FA\u7684\u5408\u4F5C\u548C\u627F\u8BFA\u7684\u8BA4\u53EF\u548C\u8868\u5F70\u3002\u003C/p\u003E\n\u003Cp\u003E\u5F53\u665A\u6C11\u90FD\u9C81\u6D77\u6E2F\u63A7\u80A1\u516C\u53F8\u53D1\u51FA14\u4E2A\u611F\u8C22\u5956\u9879\u4E2D\uFF0C\u5176\u4E2D\u5C31\u6709\u8BD7\u534E\u65E5\u62A5\u3001\u5A46\u7F57\u6D32\u90AE\u62A5\u53CAUtusan Borneo\u90FD\u6709\u83B7\u5F97\u8868\u5F70\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/tSYUql7pwsAjmMetHXggdg\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
