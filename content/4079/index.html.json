{
  "id": "%e6%9f%94%e5%a4%a7%e8%87%a3%ef%bc%9a%e7%ba%ac%e9%a2%96%e7%a7%91%e6%8a%80%e6%9f%94%e4%bd%9b%e7%bb%84%e8%a3%85%e5%8e%82%e8%90%bd%e6%88%90%e3%80%80%e4%bf%83%e8%bf%9b%e6%9f%94%e7%bb%8f%e6%b5%8e%e5%8f%8a",
  "slug": "%e6%9f%94%e5%a4%a7%e8%87%a3%ef%bc%9a%e7%ba%ac%e9%a2%96%e7%a7%91%e6%8a%80%e6%9f%94%e4%bd%9b%e7%bb%84%e8%a3%85%e5%8e%82%e8%90%bd%e6%88%90%e3%80%80%e4%bf%83%e8%bf%9b%e6%9f%94%e7%bb%8f%e6%b5%8e%e5%8f%8a",
  "canonicalUrlKey": "%e6%9f%94%e5%a4%a7%e8%87%a3%ef%bc%9a%e7%ba%ac%e9%a2%96%e7%a7%91%e6%8a%80%e6%9f%94%e4%bd%9b%e7%bb%84%e8%a3%85%e5%8e%82%e8%90%bd%e6%88%90%e3%80%80%e4%bf%83%e8%bf%9b%e6%9f%94%e7%bb%8f%e6%b5%8e%e5%8f%8a",
  "route": "/4079/",
  "title": "\u67D4\u5927\u81E3\uFF1A\u7EAC\u9896\u79D1\u6280\u67D4\u4F5B\u7EC4\u88C5\u5382\u843D\u6210\u3000\u4FC3\u8FDB\u67D4\u7ECF\u6D4E\u53CA\u53EF\u6301\u7EED\u589E\u957F\u9886\u57DF",
  "summary": "\uFF08\u65B0\u5C7112\u65E5\u8BAF\uFF09 \u7EAC\u9896\u79D1\u6280\u4F4D\u4E8E\u58EB\u4E43\u7684\u4F3A\u670D\u5668\u7EC4\u88C5\u5382\u4ECA\u65E5\u5F00\u5E55\uFF0C\u4E3A\u8D85\u5927\u578B\u8D44\u6599\u4E2D\u5FC3\u542F\u52A8\u6574\u673A\u67DC\u7EC4\u88C5\u670D\u52A1\uFF0C\u67D4\u4F5B\u5DDE\u52A1\u5927\u81E3\u62FF\u7763\u62FF\u7763\u7FC1\u54C8\u83F2\u5179\u8BF4\uFF0C\u7EAC\u9896\u79D1\u6280\u7684\u524D\u77BB\u7B56\u7565\u548C\u6295\u8D44\u5C06\u5728\u67D4\u4F5B\u5DDE\u5E26\u6765\u6B63\u9762\u7684\u793E\u4F1A\u7ECF\u6D4E\u5F71\u54CD\uFF0C\u5E76\u4E3A\u7ECF\u6D4E\u548C\u53EF\u6301\u7EED\u589E\u957F\u9886\u57DF\u5E26\u6765\u65B0\u7684\u673A\u4F1A\u3002 \u4ED6\u8868\u793A\uFF0C\u67D4\u5DDE\u653F\u5E9C\u5C06\u7EE7\u7EED\u9AD8\u89C4\u683C\u4E3A\u7EAC\u9896\u63D0\u4F9B\u5728\u672C\u533A\u589E\u957F\u6240\u9700\u7684\u652F\u6301\u3002 \u7FC1\u54C8\u83F2\u5179\u4ECA\u65E5\u51FA\u5E2D\u7EAC\u9896\u79D1\u6280\u4F4D\u4E8E\u58EB\u4E43\u673A\u573A\u57CE\u7B2C\u4E00\u671F\u4F3A\u670D\u5668\u6574\u673A\u67DC\u7EC4\u88C5\u5382\u5F00\u5E55\u5178\u793C\u4E0A\uFF0C\u4F5C\u51FA\u4E0A\u8FF0\u8868\u793A\u3002\u7EAC\u9896\u79D1\u6280\u603B\u90E8\u8BBE\u7ACB\u4E8E\u53F0\u6E7E\uFF0C\u4E0A\u8FF0\u5DE5\u5382\u4E13\u4E3A\u8D85\u5927\u578B\u8D44\u6599\u4E2D\u5FC3\u63D0\u4F9B\u4E91\u7AEFIT\u57FA\u7840\u67B6\u6784\u3002 \u9A6C\u6765\u897F\u4E9A\u6295\u8D44\u53D1\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/10/frc-b973371c08ab8e4786fb67cd8b09e04c.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\uFF08\u65B0\u5C7112\u65E5\u8BAF\uFF09 \u7EAC\u9896\u79D1\u6280\u4F4D\u4E8E\u58EB\u4E43\u7684\u4F3A\u670D\u5668\u7EC4\u88C5\u5382\u4ECA\u65E5\u5F00\u5E55\uFF0C\u4E3A\u8D85\u5927\u578B\u8D44\u6599\u4E2D\u5FC3\u542F\u52A8\u6574\u673A\u67DC\u7EC4\u88C5\u670D\u52A1\uFF0C\u67D4\u4F5B\u5DDE\u52A1\u5927\u81E3\u62FF\u7763\u62FF\u7763\u7FC1\u54C8\u83F2\u5179\u8BF4\uFF0C\u7EAC\u9896\u79D1\u6280\u7684\u524D\u77BB\u7B56\u7565\u548C\u6295\u8D44\u5C06\u5728\u67D4\u4F5B\u5DDE\u5E26\u6765\u6B63\u9762\u7684\u793E\u4F1A\u7ECF\u6D4E\u5F71\u54CD\uFF0C\u5E76\u4E3A\u7ECF\u6D4E\u548C\u53EF\u6301\u7EED\u589E\u957F\u9886\u57DF\u5E26\u6765\u65B0\u7684\u673A\u4F1A\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8868\u793A\uFF0C\u67D4\u5DDE\u653F\u5E9C\u5C06\u7EE7\u7EED\u9AD8\u89C4\u683C\u4E3A\u7EAC\u9896\u63D0\u4F9B\u5728\u672C\u533A\u589E\u957F\u6240\u9700\u7684\u652F\u6301\u3002\u003C/p\u003E\n\u003Cp\u003E\u7FC1\u54C8\u83F2\u5179\u4ECA\u65E5\u51FA\u5E2D\u7EAC\u9896\u79D1\u6280\u4F4D\u4E8E\u58EB\u4E43\u673A\u573A\u57CE\u7B2C\u4E00\u671F\u4F3A\u670D\u5668\u6574\u673A\u67DC\u7EC4\u88C5\u5382\u5F00\u5E55\u5178\u793C\u4E0A\uFF0C\u4F5C\u51FA\u4E0A\u8FF0\u8868\u793A\u3002\u7EAC\u9896\u79D1\u6280\u603B\u90E8\u8BBE\u7ACB\u4E8E\u53F0\u6E7E\uFF0C\u4E0A\u8FF0\u5DE5\u5382\u4E13\u4E3A\u8D85\u5927\u578B\u8D44\u6599\u4E2D\u5FC3\u63D0\u4F9B\u4E91\u7AEFIT\u57FA\u7840\u67B6\u6784\u3002\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u6295\u8D44\u53D1\u5C55\u5C40\u9996\u5E2D\u6267\u884C\u5B98\u963F\u7F55\u963F\u90FD\u62C9\u66FC\u8868\u793A\uFF0C\u6570\u636E\u4E2D\u5FC3\u5BF9\u652F\u6301\u7ECF\u6D4E\u53D1\u5C55\u4E0E\u8FD0\u8425\u7684\u6BCF\u4E00\u4E2A\u73AF\u8282\u90FD\u626E\u6F14\u8457\u81F3\u5173\u91CD\u8981\u7684\u89D2\u8272\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u7EAC\u9896\u5C06\u4E3A\u672C\u5730\u4F01\u4E1A\u521B\u9020\u5927\u91CF\u7684\u5408\u4F5C\u673A\u4F1A\uFF0C\u7279\u522B\u662F\u5728\u9AD8\u4EF7\u503C\u3001\u9AD8\u901F\u53D1\u5C55\u3001\u4E13\u4E3A\u8D85\u5927\u578B\u8D44\u6599\u4E2D\u5FC3\u63D0\u4F9B\u4E91\u7AEFIT\u57FA\u7840\u67B6\u6784\u7684\u9886\u57DF\u3002\u8FD9\u4E0E\u9A6C\u6765\u897F\u4E9A\u7684\u300A2030\u5E74\u65B0\u5DE5\u4E1A\u5927\u84DD\u56FE\u300B\u613F\u666F\u76F8\u4E00\u81F4\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u968F\u8457\u7EAC\u9896\u5728\u9A6C\u6765\u897F\u4E9A\u7684\u6210\u7ACB\uFF0C\u8BE5\u5C40\u671F\u5F85\u7EAC\u9896\u80FD\u8FDB\u4E00\u6B65\u6210\u4E3A\u6211\u56FD\u7684\u91CD\u8981\u4F19\u4F34\uFF0C\u5728\u7ECF\u6D4E\u9886\u57DF\u505A\u51FA\u91CD\u5927\u8D21\u732E\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/10/frc-47c90d8b91d3bc7feb917d030ed59a14.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u7EAC\u9896\u79D1\u6280\u8463\u4E8B\u957F\u517C\u7B56\u7565\u957F\u6D2A\u4E3D\u5BD7\u8868\u793A\uFF0C\u7EAC\u9896\u5728\u9A6C\u6765\u897F\u4E9A\u5EFA\u8BBE\u65B0\u5382\u4E0D\u4EC5\u662F\u56DE\u5E94\u4E1C\u5357\u4E9A\u5730\u533A\u5BF9\u4E91\u7AEF\u670D\u52A1\u65E5\u76CA\u589E\u957F\u7684\u9700\u6C42,\u66F4\u662F\u7EAC\u9896\u5728\u5168\u7403\u5236\u9020\u7B56\u7565\u4E0A\u7684\u91CD\u5927\u7A81\u7834\u3002\u4F5C\u4E3A\u5168\u7403\u6700\u5927\u7684\u4E91\u7AEFIT\u57FA\u7840\u8BBE\u5907\u539F\u5382\u76F4\u9500\u4F01\u4E1A\u4E4B\u4E00\uFF0C\u8BE5\u516C\u53F8\u59CB\u7EC8\u575A\u5B9A\u5BF9\u6280\u672F\u9886\u5148\u548C\u521B\u65B0\u7684\u627F\u8BFA\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u901A\u8FC7\u4E0E\u9A6C\u6765\u897F\u4E9A\u5728\u5730\u9876\u5C16\u5927\u5B66\u7684\u6DF1\u5EA6\u5408\u4F5C\uFF0C\u7EAC\u9896\u4E0D\u4EC5\u8BA1\u5212\u5728\u9A6C\u6765\u897F\u4E9A\u5F00\u542F\u5236\u9020\u548C\u670D\u52A1\u4E1A\u52A1\uFF0C\u4E5F\u5C06\u5F3A\u5316\u5F53\u5730\u7684\u5DE5\u7A0B\u6280\u672F\u80FD\u529B\u3002\u8FD9\u5C06\u8BA9\u7EAC\u9896\u9A6C\u6765\u897F\u4E9A\u80FD\u8FDB\u4E00\u6B65\u4E3A\u8D85\u5927\u578B\u8D44\u6599\u4E2D\u5FC3\u63D0\u4F9B\u5C16\u7AEF\u7684\u4EBA\u5DE5\u667A\u6167\u4F3A\u670D\u5668\u548C\u5148\u8FDB\u7684\u51B7\u5374\u6280\u672F\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u5979\u900F\u9732\uFF0C\u968F\u8457\u7B2C\u4E00\u671F\u4F3A\u670D\u5668\u6574\u673A\u67DC\u7EC4\u88C5\u7684\u65B0\u5382\u63ED\u5E55\u843D\u6210\uFF0C\u4EE5\u53CA\u9884\u8BA12024\u5E74\u6295\u5165\u8FD0\u8425\u7684\u7B2C\u4E8C\u671F\u4F3A\u670D\u5668\u4E3B\u673A\u677F\u4EA7\u7EBF\uFF0C\u7EAC\u9896\u5C06\u5DE9\u56FA\u5176\u4ECE\u4F3A\u670D\u5668\u4E3B\u673A\u677F\u5230\u6574\u673A\u67DC\u7EC4\u88C5\u7684\u5B8C\u6574\u4EA4\u4ED8\u80FD\u529B\uFF0C\u4F53\u73B0\u5176\u5728\u4E9A\u592A\u5730\u533A\u5EFA\u7ACB\u4E00\u7AD9\u5F0F\u5236\u9020\u3001\u670D\u52A1\u548C\u5DE5\u7A0B\u4E2D\u5FC3\u7684\u8FDC\u666F\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u7EAC\u9896\u79D1\u6280\u5728\u8425\u8FD0\u4E2D\u81F4\u529B\u5B9E\u8DF5\u73AF\u5883\u4FDD\u62A4\u3001\u793E\u4F1A\u8D23\u4EFB\u548C\u516C\u53F8\u6CBB\u7406\uFF08ESG\uFF09\u539F\u5219,\u4EE5\u7B26\u5408\u5176\u5BF9\u6C38\u7EED\u53D1\u5C55\u627F\u8BFA\u3002\u5DE5\u5382\u4F9D\u5FAA\u7EFF\u8272\u5EFA\u7B51\u6307\u6807\u6280\u672F\u7684\u6700\u9AD8\u9EC4\u91D1\u6807\u51C6\u5EFA\u9020\uFF0C\u91C7\u7528\u518D\u751F\u80FD\u6E90\uFF0C\u5E76\u5BFC\u5165\u667A\u6167\u5236\u9020\u6280\u672F\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u6B64\u5916\uFF0C\u7EAC\u9896\u4E5F\u4E0E\u5F53\u5730\u4F19\u4F34\u5408\u4F5C\uFF0C\u8BA1\u5212\u4ECA\u5E74\u5728\u58EB\u4E43\u673A\u573A\u5DE5\u4E1A\u56ED\u533A\u548C\u9A6C\u6765\u897F\u4E9A\u5176\u4ED6\u5730\u533A\u79CD\u690D\u5171\u8BA12\u4E072000d\u68F5\u6811\u3002\u8BE5\u516C\u53F8\u4E5F\u8D5E\u52A9\u8D77\u6E90\u4E8E\u65B0\u5C71\u7684\u4E8C\u5341\u56DB\u8282\u4EE4\u9F13\u961F\uFF0C\u65E8\u5728\u4FC3\u8FDB\u5F53\u5730\u6587\u5316\u7684\u4FDD\u62A4\u548C\u5EF6\u7EED\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/zcmTLcSFWsUk9KKDXjFs9Q\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
