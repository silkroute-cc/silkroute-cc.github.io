{
  "id": "%e5%ae%9e%e5%9c%a8%e6%99%ba%e8%83%bd%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e8%ae%be%e7%ab%8b%e5%ad%90%e5%85%ac%e5%8f%b8-%e5%b8%83%e5%b1%80%e4%b8%9c%e5%8d%97%e4%ba%9a%e6%95%b0%e5%ad%97%e5%91%98%e5%b7%a5",
  "slug": "%e5%ae%9e%e5%9c%a8%e6%99%ba%e8%83%bd%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e8%ae%be%e7%ab%8b%e5%ad%90%e5%85%ac%e5%8f%b8-%e5%b8%83%e5%b1%80%e4%b8%9c%e5%8d%97%e4%ba%9a%e6%95%b0%e5%ad%97%e5%91%98%e5%b7%a5",
  "canonicalUrlKey": "%e5%ae%9e%e5%9c%a8%e6%99%ba%e8%83%bd%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e8%ae%be%e7%ab%8b%e5%ad%90%e5%85%ac%e5%8f%b8-%e5%b8%83%e5%b1%80%e4%b8%9c%e5%8d%97%e4%ba%9a%e6%95%b0%e5%ad%97%e5%91%98%e5%b7%a5",
  "route": "/4275/",
  "title": "\u5B9E\u5728\u667A\u80FD\u9A6C\u6765\u897F\u4E9A\u8BBE\u7ACB\u5B50\u516C\u53F8  \u5E03\u5C40\u4E1C\u5357\u4E9A\u6570\u5B57\u5458\u5DE5\u5E02\u573A\u5E76\u5DF2\u53D6\u5F97\u9636\u6BB5\u6027\u8FDB\u5C55",
  "summary": "\u8BB0\u8005\u4ECA\u65E5\u83B7\u6089\uFF0C\u676D\u5DDE\u5B9E\u5728\u667A\u80FD\u79D1\u6280\u6709\u9650\u516C\u53F8\uFF08\u4EE5\u4E0B\u7B80\u79F0\u201C\u5B9E\u5728\u667A\u80FD\u201D\uFF09\u5DF2\u5B8C\u6210\u8FD12\u4EBF\u5143C\u8F6E\u878D\u8D44\u3002\u672C\u8F6E\u7531\u91D1\u6CF0\u5BCC\u8D44\u672C\u548C\u5B89\u5409\u667A\u6167\u8C37\u5171\u540C\u9886\u6295\u3001\u5B89\u5409\u4E24\u5C71\u56FD\u521B\u8DDF\u6295\u3002\u636E\u4E86\u89E3\uFF0C\u5728\u6B64\u8F6E\u878D\u8D44\u4EE5\u524D\uFF0C\u5B9E\u5728\u667A\u80FD\u5DF2\u5B8C\u6210\u516D\u6B21\u878D\u8D44\uFF0C\u6295\u8D44\u65B9\u5305\u62EC\u7A7F\u8D8A\u57FA\u91D1\u3001\u541B\u8054\u8D44\u672C\u3001\u677E\u79BE\u8D44\u672C\u3001\u8D5B\u667A\u4F2F\u4E50\u3001\u805A\u6570\u94F6\u8D44\u672C\u3001\u4E2D\u8D62\u8D44\u672C\u3001\u5149\u4E91\u79D1\u6280\u3001\u5353\u6E90\u8D44\u672C\u3001\u82F1\u7279\u5C14\u8D44\u672C\u7B49\u591A\u5BB6\u884C\u4E1A\u5934\u90E8\u6295\u8D44\u673A\u6784\u53CA\u4E0A\u5E02\u516C\u53F8\u3002 \u5B9E\u5728\u667A\u80FD\u6210\u7ACB\u4E8E2018\u5E74\uFF0C\u603B\u90E8\u4F4D\u4E8E\u6D59\u6C5F\u676D\u5DDE\uFF0C\u662F\u4E00\u5BB6\u901A\u8FC7\u81EA\u7814AGI\u5927\u6A21\u578B\uFF0B\u8D85\u81EA\u52A8\u5316\u6280\u672F\uFF0C\u9886\u8DD1\u4EBA\u673A\u534F\u540C\u65F6\u4EE3\u7684\u4EBA\u5DE5\u667A\u80FD\u79D1\u6280\u516C\u53F8\u3002\u4F5C\u4E3A\u4E2D\u56FDAI\u51C6\u72EC\u89D2\u517D\u548CR\u2026",
  "body": "\u003Cp\u003E\u8BB0\u8005\u4ECA\u65E5\u83B7\u6089\uFF0C\u676D\u5DDE\u5B9E\u5728\u667A\u80FD\u79D1\u6280\u6709\u9650\u516C\u53F8\uFF08\u4EE5\u4E0B\u7B80\u79F0\u201C\u5B9E\u5728\u667A\u80FD\u201D\uFF09\u5DF2\u5B8C\u6210\u8FD12\u4EBF\u5143C\u8F6E\u878D\u8D44\u3002\u672C\u8F6E\u7531\u91D1\u6CF0\u5BCC\u8D44\u672C\u548C\u5B89\u5409\u667A\u6167\u8C37\u5171\u540C\u9886\u6295\u3001\u5B89\u5409\u4E24\u5C71\u56FD\u521B\u8DDF\u6295\u3002\u636E\u4E86\u89E3\uFF0C\u5728\u6B64\u8F6E\u878D\u8D44\u4EE5\u524D\uFF0C\u5B9E\u5728\u667A\u80FD\u5DF2\u5B8C\u6210\u516D\u6B21\u878D\u8D44\uFF0C\u6295\u8D44\u65B9\u5305\u62EC\u7A7F\u8D8A\u57FA\u91D1\u3001\u541B\u8054\u8D44\u672C\u3001\u677E\u79BE\u8D44\u672C\u3001\u8D5B\u667A\u4F2F\u4E50\u3001\u805A\u6570\u94F6\u8D44\u672C\u3001\u4E2D\u8D62\u8D44\u672C\u3001\u5149\u4E91\u79D1\u6280\u3001\u5353\u6E90\u8D44\u672C\u3001\u82F1\u7279\u5C14\u8D44\u672C\u7B49\u591A\u5BB6\u884C\u4E1A\u5934\u90E8\u6295\u8D44\u673A\u6784\u53CA\u4E0A\u5E02\u516C\u53F8\u3002\u003C/p\u003E\n\u003Cp\u003E\u5B9E\u5728\u667A\u80FD\u6210\u7ACB\u4E8E2018\u5E74\uFF0C\u603B\u90E8\u4F4D\u4E8E\u6D59\u6C5F\u676D\u5DDE\uFF0C\u662F\u4E00\u5BB6\u901A\u8FC7\u81EA\u7814AGI\u5927\u6A21\u578B\uFF0B\u8D85\u81EA\u52A8\u5316\u6280\u672F\uFF0C\u9886\u8DD1\u4EBA\u673A\u534F\u540C\u65F6\u4EE3\u7684\u4EBA\u5DE5\u667A\u80FD\u79D1\u6280\u516C\u53F8\u3002\u4F5C\u4E3A\u4E2D\u56FDAI\u51C6\u72EC\u89D2\u517D\u548CRPA\uFF08Robotic Process Automation\uFF09\u884C\u4E1A\u5934\u90E8\u4F01\u4E1A\u3001\u8D85\u81EA\u52A8\u5316\u89E3\u51B3\u65B9\u6848\u63D0\u4F9B\u5546\uFF0C\u5B9E\u5728\u667A\u80FD\u7ED3\u5408\u56FD\u4EA7\u5168\u81EA\u7814\u7684AI\u6280\u672F\u4E0ERPA\u4EA7\u54C1\uFF0C\u52A9\u529B\u653F\u5E9C\u4F01\u4E1A\u5B9E\u73B0\u6570\u5B57\u5316\u6539\u9769\u548C\u8F6C\u578B\u5347\u7EA7\u3002 \u003C/p\u003E\n\u003Cp\u003E\u636E\u5B9E\u5728\u667A\u80FD\u4ECB\u7ECD\uFF0C\u516C\u53F8\u5DF2\u7ECF\u52A9\u529B\u8D852000\u5BB6\u592E\u4F01\u56FD\u4F01\u3001\u4E16\u754C500\u5F3A\u3001\u4E0A\u5E02\u96C6\u56E2\u516C\u53F8\u53CA\u653F\u5E9C\u673A\u6784\u6570\u5B57\u5316\u8F6C\u578B\u5347\u7EA7\uFF0C\u5168\u9762\u5E94\u7528\u90E8\u7F72\u5404\u7C7B\u6570\u5B57\u5458\u5DE5\u3002\u540C\u65F6\uFF0C\u003Cstrong\u003E\u5B9E\u5728\u667A\u80FD\u5DF2\u5206\u522B\u5728\u65E5\u672C\u548C\u9A6C\u6765\u897F\u4E9A\u8BBE\u7ACB\u5B50\u516C\u53F8\uFF0C\u5168\u9762\u5E03\u5C40\u4E1C\u5357\u4E9A\u6570\u5B57\u5458\u5DE5\u5E02\u573A\u5E76\u5DF2\u53D6\u5F97\u9636\u6BB5\u6027\u8FDB\u5C55\u3002\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u4ECA\u5E74\u4EE5\u6765\uFF0C\u5927\u6A21\u578B\u6280\u672F\u7684\u5DE8\u5927\u7A81\u7834\u4E0E\u5FEB\u901F\u53D1\u5C55\uFF0C\u8D4B\u80FD\u6570\u5B57\u4EBA\u884C\u4E1A\u5B9E\u73B0\u964D\u672C\u589E\u6548\u3002\u6570\u5B57\u4EBA\u667A\u80FD\u5316\u6C34\u5E73\u5927\u5E45\u63D0\u9AD8\uFF0C\u5E76\u5E7F\u6CDB\u5E94\u7528\u4E8E\u77ED\u89C6\u9891\u3001\u7535\u5546\u76F4\u64AD\u7B49\u9886\u57DF\uFF0C\u6210\u4E3A\u5927\u6A21\u578B\u7387\u5148\u5546\u4E1A\u5316\u843D\u5730\u7684\u521B\u4E1A\u8D5B\u9053\u3002\u8BB8\u591A\u4F01\u4E1A\u7EB7\u7EB7\u63A8\u51FA\u4E86\u81EA\u5DF1\u7684\u6570\u5B57\u4EBA\uFF0C\u800C\u8FD9\u4E9B\u4F01\u4E1A\u6570\u5B57\u4EBA\u4E5F\u6709\u53E6\u5916\u4E00\u4E2A\u79F0\u547C\u2014\u2014\u201C\u6570\u5B57\u5458\u5DE5\u201D\u3002\u003C/p\u003E\n\u003Cp\u003E\u6570\u5B57\u5458\u5DE5\u662F\u4EE5\u201CAI\u002BRPA\u002B\u6570\u636E\u002B\u673A\u5668\u4EBA\u201D\u7B49\u591A\u91CD\u6280\u672F\u6DF1\u5165\u878D\u5408\u5E94\u7528\u521B\u9020\u7684\u9AD8\u5EA6\u62DF\u4EBA\u5316\u7684\u65B0\u578B\u5DE5\u4F5C\u4EBA\u5458\uFF0C\u53EF\u4EE5\u534F\u52A9\u6216\u66FF\u4EE3\u4EBA\u7C7B\u5B8C\u6210\u4E00\u4E9B\u91CD\u590D\u6027\u3001\u6807\u51C6\u5316\u6216\u9AD8\u6548\u7387\u7684\u5DE5\u4F5C\u4EFB\u52A1\uFF0C\u6709\u6548\u63D0\u9AD8\u4F01\u4E1A\u7684\u751F\u4EA7\u6548\u7387\u3001\u964D\u4F4E\u4EBA\u529B\u6210\u672C\u3001\u4F18\u5316\u7528\u5DE5\u6A21\u5F0F\u3002\u4E0D\u4EC5\u5982\u6B64\uFF0C\u6570\u5B57\u5458\u5DE5\u53EF\u5B9E\u73B07\u0026#215;24\u5C0F\u65F6\u5168\u5929\u5DE5\u4F5C\uFF0C\u65E0\u9700\u4F11\u606F\u3001\u8BF7\u5047\u6216\u52A0\u73ED\uFF0C\u80FD\u8282\u7701\u4EBA\u529B\u6210\u672C\u548C\u7BA1\u7406\u6210\u672C\u3002\u6839\u636E\u300AIDC Future Scape: \u5168\u7403\u4EBA\u5DE5\u667A\u80FD\u5E02\u573A2021\u9884\u6D4B\u300B\u62A5\u544A\uFF0C\u201C\u52302024\u5E74\uFF0C45%\u7684\u91CD\u590D\u5DE5\u4F5C\u4EFB\u52A1\u5C06\u901A\u8FC7\u4F7F\u7528\u7531AI\u3001\u673A\u5668\u4EBA\u548C\u673A\u5668\u4EBA\u6D41\u7A0B\u81EA\u52A8\u5316\uFF08RPA\uFF09\u63D0\u4F9B\u652F\u6301\u7684\u2018\u6570\u5B57\u5458\u5DE5\u2019\u5B9E\u73B0\u81EA\u52A8\u5316\u6216\u589E\u5F3A\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u5B9E\u5728\u667A\u80FD\u521B\u59CB\u4EBA\u517C\u9996\u5E2D\u6267\u884C\u5B98\u5B59\u6797\u541B\u5728\u63A5\u53D7\u5A92\u4F53\u91C7\u8BBF\u65F6\u66FE\u8868\u793A\uFF0C\u4F34\u968F\u7740\u8001\u9F84\u5316\u3001\u672A\u6765\u52B3\u52A8\u529B\u4E0D\u8DB3\u7B49\u793E\u4F1A\u95EE\u9898\uFF0C\u6570\u5B57\u5458\u5DE5\u5C06\u8FCE\u5E7F\u9614\u673A\u9047\u3002\u5728\u67D0\u4E9B\u7279\u5B9A\u5C97\u4F4D\u5DE5\u4F5C\uFF0C\u5927\u698220%\u523030%\u7684\u5DE5\u4F5C\u91CF\u53EF\u4EE5\u7531RPA\u673A\u5668\u4EBA\u66FF\u4EE3\u5B8C\u6210\u3002\u003C/p\u003E\n\u003Cp\u003E\u6570\u5B57\u5458\u5DE5\u7684\u667A\u80FD\u5316\u6C34\u5E73\u53D6\u51B3\u4E8E\u5927\u6A21\u578B\uFF0C\u5F88\u5927\u7A0B\u5EA6\u5F71\u54CD\u4E86\u4EA7\u54C1\u7684\u6027\u80FD\u4E0E\u4F53\u9A8C\u3002\u636E\u5B9E\u5728\u667A\u80FD\u4ECB\u7ECD\uFF0C\u516C\u53F8\u4ECE2022\u5E74\u8D77\u5C31\u5F00\u59CB\u63A2\u7D22\u201C\u4E00\u53E5\u8BDD\u751F\u6210\u6D41\u7A0B\u4EE3\u7801\u201D\u7684\u6280\u672F\uFF0C\u4F46\u5F53\u65F6\u7684\u9884\u8BAD\u7EC3\u6A21\u578B\u8FD8\u4E0D\u5177\u5907\u5F88\u5F3A\u7684\u4E1A\u52A1\u7406\u89E3\u548C\u63A8\u7406\u80FD\u529B\u3002\u4F46\u662F\uFF0C\u968F\u7740\u4EE5ChatGPT\u4E3A\u4EE3\u8868\u7684\u5927\u8BED\u8A00\u6A21\u578B\u7684\u51FA\u73B0\uFF0C\u8FD9\u4E00\u6280\u672F\u5177\u5907\u4E86\u5B9E\u73B0\u7684\u53EF\u80FD\u6027\u3002\u003C/p\u003E\n\u003Cp\u003E6\u6708\u4E0B\u65EC\uFF0C\u5B9E\u5728\u667A\u80FD\u5F00\u542F\u81EA\u7814\u5782\u76F4\u5927\u8BED\u8A00\u6A21\u578B\u201C\u5854\u65AF\uFF08TARS\uFF09\u201D\u5185\u6D4B\u30028\u6708\uFF0C\u5B9E\u5728\u667A\u80FD\u53EC\u5F00\u7B2C\u4E03\u6B21\u65B0\u54C1\u53D1\u5E03\u4F1A\uFF0C\u6B63\u5F0F\u5BF9\u5916\u53D1\u5E03\u201C\u5854\u65AF\uFF08TARS\uFF09\u201D\u5927\u6A21\u578B\uFF0C\u5E76\u63A8\u51FA\u884C\u4E1A\u9996\u4E2A\u57FA\u4E8E\u5927\u6A21\u578B\u7684TARS-RPA-Agent\u4EA7\u54C1\uFF0C\u5C06\u6570\u5B57\u5458\u5DE5\u5E94\u7528\u95E8\u69DB\u8FDB\u4E00\u6B65\u964D\u4F4E\u3002\u53D1\u5E03\u4F1A\u4E0A\uFF0C\u5854\u65AF\u5927\u6A21\u578B\u4E5F\u5C55\u73B0\u4E86\u81EA\u8EAB\u5728\u6587\u672C\u751F\u6210\u3001\u8BED\u8A00\u7406\u89E3\u3001\u77E5\u8BC6\u95EE\u7B54\u3001\u903B\u8F91\u63A8\u7406\u7B49\u65B9\u9762\u7684\u4E3B\u6D41\u80FD\u529B\u3002\u003C/p\u003E\n\u003Cp\u003E\u636E\u6089\uFF0C\u5B9E\u5728\u667A\u80FD\u76EE\u524D\u5DF2\u670D\u52A1\u56FD\u5BB6\u7535\u7F51\u3001\u4E2D\u56FD\u70DF\u8349\u3001\u4E09\u5927\u8FD0\u8425\u5546\u3001\u963F\u91CC\u4E91\u3001\u6D77\u5C14\u96C6\u56E2\u3001\u7F8E\u7684\u96C6\u56E2\u3001\u4E2D\u56FD\u5E73\u5B89\u3001\u534E\u590F\u94F6\u884C\u3001\u795E\u5DDE\u6570\u7801\u3001\u5F90\u5DE5\u96C6\u56E2\u3001\u73C0\u83B1\u96C5\u3001\u7EB3\u7231\u65AF\u7B49\u5BA2\u6237\uFF0C\u805A\u7126\u91D1\u878D\u3001\u5236\u9020\u3001\u8FD0\u8425\u5546\u3001\u7535\u5546\u3001\u70DF\u8349\u3001\u80FD\u6E90\u3001\u4EA4\u901A\u7B49\u884C\u4E1A\u83B7\u5F97\u4E30\u5BCC\u7684\u670D\u52A1\u7ECF\u9A8C\u548C\u6807\u6746\u843D\u5730\u9879\u76EE\u6848\u4F8B\u3002\u003C/p\u003E\n\u003Cp\u003E\u5B9E\u5728\u667A\u80FD\u8868\u793A\uFF0C\u672C\u8F6E\u878D\u8D44\u5C06\u52A9\u529B\u5B9E\u5728\u667A\u80FD\u7EE7\u7EED\u4FDD\u6301\u5728AI Agent\uFF08AI\u667A\u80FD\u4F53\uFF09\u8D5B\u9053\u7684\u5168\u9762\u9886\u5148\u4F18\u52BF\u3002\u9884\u8BA1\u57282024\u5E74\u521D\uFF0C\u5B9E\u5728Agent\u667A\u80FD\u4F53\u5C06\u516C\u6D4B\u6295\u653E\u5E02\u573A\uFF0C\u4E3A\u4E2A\u4EBA\u7528\u6237\u5E26\u6765\u89E3\u51B3\u957F\u5C3E\u4F4E\u9891\u81EA\u52A8\u5316\u9700\u6C42\u7684PC\u52A9\u7406\uFF0C\u4E3A\u653F\u5E9C\u4F01\u4E1A\u5E26\u6765\u5458\u5DE5\u529E\u516C\u52A9\u624B\uFF0C\u5B9E\u73B0\u5BF9\u5404\u7C7B\u529E\u516C\u8F6F\u4EF6\u7684\u201C\u4F60\u8BF4PC\u505A\u201D\uFF0C\u5168\u9762\u5F00\u542FAI Agent\u667A\u80FD\u4F53\u65F6\u4EE3\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/Kviz4OHh5vEWohj7Mf51vw\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
