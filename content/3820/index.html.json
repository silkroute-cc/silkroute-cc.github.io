{
  "id": "%e5%8f%b2%e6%b5%b7%e9%92%a9%e6%b2%89-%e7%99%be%e5%b9%b4%e5%8f%98%e8%bf%81%e7%9c%8b%e5%ae%89%e9%a1%ba%e7%9a%84%e6%98%a8%e6%97%a5%e3%80%81%e4%bb%8a%e6%97%a5%e3%80%81%e6%98%8e%e6%97%a5",
  "slug": "%e5%8f%b2%e6%b5%b7%e9%92%a9%e6%b2%89-%e7%99%be%e5%b9%b4%e5%8f%98%e8%bf%81%e7%9c%8b%e5%ae%89%e9%a1%ba%e7%9a%84%e6%98%a8%e6%97%a5%e3%80%81%e4%bb%8a%e6%97%a5%e3%80%81%e6%98%8e%e6%97%a5",
  "canonicalUrlKey": "%e5%8f%b2%e6%b5%b7%e9%92%a9%e6%b2%89-%e7%99%be%e5%b9%b4%e5%8f%98%e8%bf%81%e7%9c%8b%e5%ae%89%e9%a1%ba%e7%9a%84%e6%98%a8%e6%97%a5%e3%80%81%e4%bb%8a%e6%97%a5%e3%80%81%e6%98%8e%e6%97%a5",
  "route": "/3820/",
  "title": "\u53F2\u6D77\u94A9\u6C89 / \u767E\u5E74\u53D8\u8FC1\u770B\u5B89\u987A\u7684\u6628\u65E5\u3001\u4ECA\u65E5\u3001\u660E\u65E5",
  "summary": "\u5B89\u987A\u4F4D\u4E8E\u9739\u96F3\u6CB3\u30ED\uFF0C\u5176\u5730\u7406\u4F4D\u7F6E\u4EE5\u53CA\u73AF\u5883\u7279\u5F81\u5F62\u6210\u72EC\u7279\u7684\u57CE\u5E02\u6587\u5316\uFF0C\u5728\u4E00\u767E\u591A\u5E74\u6765\u89C1\u8BC1\u4E86\u9739\u96F3\u6CB3\u4E0A\u4E0B\u6E38\u5730\u533A\u7684\u6587\u5316\u4E0E\u7ECF\u6D4E\u53D1\u5C55\u3002 \u5B89\u987A\u4F4D\u4E8E\u9739\u96F3\u6CB3\u9760\u8FD1\u51FA\u6D77\u53E3\u5904\uFF0C\u6700\u521D\u4F5C\u4E3A\u82CF\u95E8\u7B54\u814A\u4EBA\u8FDB\u5165\u9739\u96F3\u5DDE\u5185\u9646\u5730\u533A\uFF0C\u6CB3\u9053\u4EA4\u901A\u7684\u7B2C\u4E00\u5927\u578B\u636E\u70B9\u3002 \u6839\u636E\u65E9\u671F\u5C45\u6C11\u7684\u53E3\u8FF0\u8BB0\u8F7D\uFF0C\u5B89\u987A\u7684\u9A6C\u6765\u539F\u540D\u662F\u4E3A\u4E86\u7EAA\u5FF5\u4E00\u4F4D\u6770\u51FA\u7684Mandailing(\u66FC\u9EDB\u6797)\u5973\u5E03\u5546Mak Intan\u3002 \u6839\u636E\u4F20\u8BF4\uFF0C\u5979\u4E0E\u670B\u53CB\u5728\u6CB3\u4E2D\u5B09\u620F\u65F6\uFF0C\u4E0D\u614E\u5931\u53BB\u4E86\u7236\u6BCD\u8D60\u4E88\u5979\u7684\u73E0\u5B9D(Intan)\u53D1\u5939\uFF0C\u56E0\u6B64\u5C06\u6B64\u5730\u70B9\u53D6\u540D\u4E3ATeluk Intan,\u5373\u5B9D\u77F3\u7684\u6CB3\u6E7E\u4E4B\u610F\u3002 \u65E9\u5728\u82F1\u56FD\u4EBA\u62B5\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/06/frc-d0e0ff4a2fc4bf67a4eaf5f65e00a8e3.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/06/frc-636ca3d5dcf6dd466c18fc77a65f4cf2.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5B89\u987A\u4F4D\u4E8E\u9739\u96F3\u6CB3\u30ED\uFF0C\u5176\u5730\u7406\u4F4D\u7F6E\u4EE5\u53CA\u73AF\u5883\u7279\u5F81\u5F62\u6210\u72EC\u7279\u7684\u57CE\u5E02\u6587\u5316\uFF0C\u5728\u4E00\u767E\u591A\u5E74\u6765\u89C1\u8BC1\u4E86\u9739\u96F3\u6CB3\u4E0A\u4E0B\u6E38\u5730\u533A\u7684\u6587\u5316\u4E0E\u7ECF\u6D4E\u53D1\u5C55\u3002\u003C/p\u003E\n\u003Cp\u003E\u5B89\u987A\u4F4D\u4E8E\u9739\u96F3\u6CB3\u9760\u8FD1\u51FA\u6D77\u53E3\u5904\uFF0C\u6700\u521D\u4F5C\u4E3A\u82CF\u95E8\u7B54\u814A\u4EBA\u8FDB\u5165\u9739\u96F3\u5DDE\u5185\u9646\u5730\u533A\uFF0C\u6CB3\u9053\u4EA4\u901A\u7684\u7B2C\u4E00\u5927\u578B\u636E\u70B9\u3002\u6839\u636E\u65E9\u671F\u5C45\u6C11\u7684\u53E3\u8FF0\u8BB0\u8F7D\uFF0C\u5B89\u987A\u7684\u9A6C\u6765\u539F\u540D\u662F\u4E3A\u4E86\u7EAA\u5FF5\u4E00\u4F4D\u6770\u51FA\u7684Mandailing(\u66FC\u9EDB\u6797)\u5973\u5E03\u5546Mak Intan\u3002\u6839\u636E\u4F20\u8BF4\uFF0C\u5979\u4E0E\u670B\u53CB\u5728\u6CB3\u4E2D\u5B09\u620F\u65F6\uFF0C\u4E0D\u614E\u5931\u53BB\u4E86\u7236\u6BCD\u8D60\u4E88\u5979\u7684\u73E0\u5B9D(Intan)\u53D1\u5939\uFF0C\u56E0\u6B64\u5C06\u6B64\u5730\u70B9\u53D6\u540D\u4E3ATeluk Intan,\u5373\u5B9D\u77F3\u7684\u6CB3\u6E7E\u4E4B\u610F\u3002\u003C/p\u003E\n\u003Cp\u003E\u65E9\u5728\u82F1\u56FD\u4EBA\u62B5\u8FBE\u524D\uFF0C\u9739\u96F3\u6CB3\u6CB3\u53E3\u81F3\u4E0A\u6E38\u4E00\u5E26\u5DF2\u662F\u9739\u96F3\u5DDE\u5883\u5185\u6700\u591A\u4EBA\u53E3\u5C45\u4F4F\u7684\u533A\u57DF\u3002\u81EA\u90A6\u54AF\u6761\u7EA6\u57281874\u5E74\u7B7E\u8BA2\u4E4B\u540E\uFF0C\u82F1\u56FD\u4EBA\u5148\u4EE5\u9732\u96F3\u6CB3\u4E00\u5E26\u7740\u624B\uFF0C\u96C7\u7528\u9A6C\u6765\u8239\u592B\uFF0C\u4EE5\u8239\u5C4B(Boat-house)\u4E3A\u4EA4\u901A\u5DE5\u5177\uFF0C\u4ECE\u6CB3\u53E3\u4E00\u76F4\u5230\u6700\u4E0A\u6E38\u5730\u6BB5\u52D8\u67E5\uFF0C\u5E76\u4E0E\u5404\u5730\u65B9\u9886\u8896\u4F1A\u9762\u8BF4\u660E\u82F1\u56FD\u627F\u8BA4\u963F\u90FD\u62C9(Rja Muda Abdullah)\u4E3A\u859B\u96F3\u5DDE\u82CF\u4E39\u3002\u8FD9\u7A81\u5982\u5176\u6765\u7684\u653F\u6CBB\u53D8\u52A8\uFF0C\u5728\u5185\u9646\u5730\u533A\u5F15\u8D77\u4E0D\u5C11\u9A9A\u52A8\uFF0C\u4EE5\u81F4\u4E8E\u57281875\u5E74\uFF0C\u9996\u540D\u53C2\u653F\u53F8\u6BD5\u6CBB(J.W.W.Birch)\u57281875\u5E74\u88AB\u6740\u5BB3\uFF0C\u8F70\u52A8\u4E86\u6574\u4E2A\u82F1\u56FD\u3002\u8FD9\u8D77\u4E8B\u4EF6\u5E76\u6CA1\u6709\u963B\u6B62\u82F1\u56FD\u52BF\u529B\uFF0C\u53CD\u800C\u8BA9\u82F1\u56FD\u4EBA\u627E\u5230\u66F4\u52A0\u6709\u5229\u7684\u8BF4\u6CD5\uFF0C\u5927\u52BF\u53D1\u52A8\u653F\u6CBB\u53D8\u9769\uFF0C\u52A0\u901F\u9739\u96F3\u5185\u9646\u5730\u533A\u7684\u6B96\u6C11\u4E8B\u4E1A\u3002\u003C/p\u003E\n\u003Cp\u003E\u6BD5\u6CBB\u88AB\u6740\u5BB3\u4E8B\u4EF6\u5F15\u8D77\u82F1\u56FD\u4EBA\u5BF9\u9739\u96F3\u5DDE\u7684\u6CE8\u610F\uFF0C1876\u5E74\u82F1\u56FD\u5730\u7406\u5B66\u5BB6\u5A01\u5EC9\u0026#183;\u5DF4\u6797\u987F(William Barrington D\u0026#39;Almeida)\u5728\u7687\u5BB6\u5730\u7406\u5B66\u4F1A(Roval Geographical Society)\u53D1\u8868\u4E86\u9739\u96F3\u4E0E\u96EA\u5170\u83AA\u5730\u7406\u52D8\u67E5\u62A5\u544A\uFF0C\u6587\u7AE0\u9644\u4E86\u4E00\u5F20\u9739\u96F3\u5DDE\u53CA\u5468\u8FB9\u7684\u6D4B\u7ED8\u8349\u56FE\uFF0C\u5C06\u9739\u96F3\u6CB3\u6CBF\u5CB8\u5927\u5C0F\u6751\u5E84\u540D\u5B57\u53CA\u5730\u7406\u4F4D\u7F6E\u5B8C\u5168\u6E05\u695A\u6807\u793A\u51FA\u6765\u3002\u5728\u8FD9\u5F20\u5730\u56FE\u4E0A\u5E76\u672A\u51FA\u73B0Teluk Intan\u6216\u76F8\u5173\u5730\u540D\uFF0C\u800C\u662F\u663E\u793ADurian R.,\u5373\u69B4\u94FE\u6CB3\u4E4B\u610F\uFF0C\u4ECE\u5982\u4ECA\u7684\u5730\u7406\u4F4D\u7F6E\u5BF9\u7167\u8D77\u6765\uFF0C\u5E94\u8BE5\u662F\u6307\u5B89\u987A\u5E02\u8FD1\u90CA\u53F8\u9A6C\u767B(Durian Sebatang)\u7684\u4F4D\u7F6E\u3002\u003C/p\u003E\n\u003Cp\u003E\u6839\u636E\u5B89\u987A\u798F\u987A\u5BAB\u7684\u5386\u53F2\uFF0C\u65E9\u57281845\u5E74\u5DE6\u53F3\uFF0C\u95FD\u5357\u4EBA\u5728\u53F8\u9A6C\u767B\u5EFA\u7ACB\u4E86\u4E00\u95F4\u7B80\u964B\u5E99\u5B87\uFF0C\u540E\u57281860\u5E74\u5DE6\u53F3\u642C\u8FC1\u5230\u66FE\u5409\u5BB9\u533A\u30021883\u5E74\uFF0C\u83B7\u5F97\u82F1\u6B96\u6C11\u653F\u5E9C\u63D0\u4F9B\u5728\u5982\u4ECA\u5B89\u987A\u5E02\u9760\u8FD1\u6CB3\u8FB9\u7684\u4F4D\u7F6E\uFF0C\u7531\u4F17\u4EBA\u51FA\u8D44\u51FA\u529B\uFF0C\u5174\u5EFA\u6210\u5B8C\u6574\u7684\u56FD\u5357\u5E99\u5B87\u89C4\u683C\u3002\u003C/p\u003E\n\u003Cp\u003E1881\u5E74\uFF0C\u5B89\u987A\u53D6\u4EE3\u4E86\u53F8\u9A6C\u767B\uFF0C\u6210\u4E3A\u8FD1\u6253\u6CB3\u53CA\u4E0B\u9739\u96F3\u5730\u533A\u7684\u4E3B\u8981\u6E2F\u53E3\uFF0C\u4E0E\u62C9\u5F8B\u5730\u533A\u7684\u4F53\u5A01(Port Weld,\u5341\u516B\u4E01)\u7ADE\u4E89\u9521\u7684\u51FA\u53E3\u53CA\u7CAE\u98DF\u548C\u7269\u8D44\u7684\u8FDB\u53E3\u3002\u7FCC\u5E74\uFF0C\u82F1\u653F\u5E9C\u5C06\u6B64\u5730\u66F4\u540D\u4E3ATeuk Anson,\u4EE5\u7EAA\u5FF5\u6D77\u5CE1\u6B96\u6C11\u5730\u526F\u603B\u7763\u5B89\u987A(Lord Archibald Anson),\u636E\u79F0\uFF0C\u4ED6\u4EB2\u81EA\u7ED8\u5236\u4E86\u8BE5\u5E02\u9547\u7684\u7B2C\u4E00\u4EFD\u89C4\u5212\u56FE\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5B89\u987A\u7684\u672A\u4F86\u8D70\u5411\u4F55\u65B9\uFF1F\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u5982\u4ECA\uFF0C\u5B89\u987A\u7684\u57CE\u5E02\u4E3B\u8981\u75313\u4E2A\u90E8\u5206\u7EC4\u6210\u3002\u9996\u5148\u662F\u653F\u5E9C\u673A\u5173\u548C\u516C\u5171\u5EFA\u7B51\u533A\uFF0C\u8FD9\u4E9B\u533A\u57DF\u5F62\u6210\u4E8E\u65E9\u671F\u7684\u94C1\u8DEF\u8BBE\u65BD\uFF0C\u96C6\u4E2D\u4E86\u884C\u653F\u673A\u6784\u3001\u653F\u5E9C\u529E\u516C\u5BA4\u548C\u5176\u4ED6\u516C\u5171\u8BBE\u65BD\uFF0C\u662F\u57CE\u5E02\u7684\u884C\u653F\u4E2D\u5FC3\u3002\u003C/p\u003E\n\u003Cp\u003E\u7B2C\u4E8C\u4E2A\u90E8\u5206\u662F\u4EE5\u5B89\u987A\u659C\u5854\u4E3A\u4E2D\u5FC3\u7684\u5546\u5E97\u8857\u7ECF\u6D4E\u6D3B\u52A8\u533A\u3002\u5B89\u987A\u659C\u5854\u662F\u57CE\u5E02\u7684\u5730\u6807\u5EFA\u7B51\uFF0C\u5468\u56F4\u662F\u7531\u6218\u524D\u5E97\u5C4B\u7EC4\u6210\u7684\u5546\u4E1A\u533A\u3002\u7531\u4E8E\u5B89\u987A\u4E3A\u4E0B\u9739\u96F3\u4E3B\u8981\u7269\u6D41\u96C6\u6563\u5730\uFF0C\u5E02\u533A\u5185\u7684\u5546\u5E97\u6709\u8D38\u6613\u516C\u53F8\u3001\u4E94\u91D1\u5E97\u3001\u767E\u8D27\u5546\u884C\u3001\u996E\u98DF\u7B49\u7B49\u670D\u52A1\u5BF9\u8C61\u9664\u4E86\u5F53\u5730\u5C45\u6C11\uFF0C\u4E5F\u5305\u62EC\u5916\u56F4\u5730\u533A\u53CA\u6E38\u5BA2\u7B49\u3002\u003C/p\u003E\n\u003Cp\u003E\u7B2C\u4E09\u4E2A\u90E8\u5206\u662F\u5B89\u987A\u534A\u5C9B\u672B\u7AEF\u7684\u82AD\u5C3E\u65B0\u6751\uFF0C\u8FD9\u91CC\u6709\u72EC\u7ACB\u7684\u82F1\u9A6C(Anglo-Malay)\u5F62\u5F0F\u623F\u5B50\u548C\u6392\u5C4B\u7B49\u4F4F\u5B85\uFF0C\u5927\u90E8\u5206\u7684\u5C45\u6C11\u4E3A\u534E\u4EBA\u3002\u8FD9\u4E2A\u5730\u533A\u4FDD\u7559\u4E86\u4F20\u7EDF\u5EFA\u7B51\u98CE\u683C\u548C\u793E\u533A\u7ED3\u6784\uFF0C\u5C24\u5176\u65B0\u6751\u5185\u7684\u82F1\u9A6C\u5F62\u5F0F\u623F\u5B50\uFF0C\u72EC\u5177\u4E00\u683C\uFF0C\u662F\u56FD\u5185\u5176\u4ED6\u65B0\u6751\u5C11\u6709\u7684\u5EFA\u7B51\u5F62\u5F0F\u3002\u003C/p\u003E\n\u003Cp\u003E\u5B89\u987A\u7684\u53D1\u5C55\u548C\u53D8\u8FC1\u53CD\u6620\u4E86\u8FD9\u4E2A\u5730\u533A\u7684\u7ECF\u6D4E\u548C\u6587\u5316\u6F14\u53D8\u3002\u4ECE\u6700\u521D\u4F5C\u4E3A\u82CF\u95E8\u7B54\u814A\u4EBA\u767B\u9646\u70B9\u7684\u6E2F\u53E3\uFF0C\u5230\u8FD1\u6253\u6CB3\u6D41\u57DF\u9521\u77FF\u5F00\u53D1\u4E4B\u540E\u7269\u8D44\u8FDB\u51FA\u53E3\u7684\u91CD\u8981\u6E2F\u53E3\uFF0C\u5B89\u987A\u5728\u8FC7\u53BB\u7684\u4E00\u767E\u591A\u5E74\u4E2D\uFF0C\u5728\u9739\u96F3\u6CB3\u53E3\u4E43\u81F3\u4E8E\u9A6C\u6765\u534A\u5C9B\u4E2D\u90E8\uFF0C\u626E\u6F14\u4E86\u91CD\u8981\u7269\u8D44\u96C6\u6563\u5730\u7684\u89D2\u8272\u3002\u968F\u7740\u94C1\u8DEF\u53D6\u6D88\u3001\u6CB3\u8FD0\u6CA1\u843D\u53CA\u534A\u5C9B\u9AD8\u901F\u516C\u8DEF\u5EFA\u6210\u4E4B\u540E\uFF0C\u5B89\u987A\u7684\u7ECF\u6D4E\u6D3B\u52A8\u5DF2\u8F83\u4E0A\u4E16\u7EAA\u6C89\u5BC2\u4E86\u4E0D\u5C11\u3002\u4E0D\u8FC7\uFF0C\u968F\u7740\u897F\u6D77\u5CB8\u5927\u9053\u9646\u7EED\u5B8C\u5DE5\u901A\u884C\uFF0C\u53EF\u4EE5\u9884\u89C1\u5B89\u987A\u53CA\u5176\u5468\u56F4\u5730\u533A\uFF0C\u4F1A\u5F00\u59CB\u8FC8\u4EBA\u65B0\u7684\u53D1\u5C55\u6F6E\uFF0C\u5E0C\u671B\u653F\u5E9C\u53EF\u4EE5\u770B\u89C1\u5B89\u987A\u7684\u767E\u5E74\u5386\u53F2\uFF0C\u5728\u53D1\u5C55\u7ECF\u6D4E\u7684\u540C\u65F6\uFF0C\u6CE8\u91CD\u5F53\u5730\u7684\u4EBA\u6587\u5EFA\u8BBE\uFF0C\u4E00\u5EA7\u4F1F\u5927\u7684\u57CE\u5E02\u5F80\u5F80\u662F\u56E0\u4E3A\u5979\u62E5\u6709\u4E30\u5BCC\u7684\u6587\u5316\u5386\u53F2\uFF0C\u5927\u90E8\u5206\u7684\u4EBA\u62E5\u6709\u5171\u540C\u96C6\u4F53\u8BB0\u5FC6\u53EF\u4EE5\u4FC3\u8FDB\u793E\u4F1A\u548C\u8C10\uFF0C\u5F53\u5730\u4EBA\u4EEC\u81EA\u7136\u8868\u73B0\u51FA\u6765\u7684\u5E78\u798F\u611F\uFF0C\u624D\u80FD\u5438\u5F15\u6E38\u5BA2\u524D\u6765\u89C2\u5149\uFF0C\u4EE5\u6301\u7EED\u63A8\u52A8\u5F53\u5730\u7ECF\u6D4E\u6587\u5316\u5EFA\u8BBE\u3002\u003C/p\u003E\n\u003Cp\u003E\u57CE\u9109\u9918\u96C6\u003C/p\u003E\n\u003Cp\u003E\u6587\u25CF\u5F35\u96C6\u5F37\u003C/p\u003E\n\u003Chr /\u003E\n\u003Cp\u003E\u66F4\u591A\u7CBE\u5F69\uFF0C\u656C\u8BF7\u5173\u6CE8\uFF1A\u003C/p\u003E\n\u003Cp\u003E\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5B98\u7F51\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003Ehttps://www.chinaculturalcentre.my\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EFacebook\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u201CChina Cultural Centre in Kuala Lumpur\u201D\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u516C\u4F17\u53F7\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u201C\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u201D\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EYoutube\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u201CChina Cultural Centre in Kuala Lumpur\u201D\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003ETiktok\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u201CCCCKL\u201D\u003C/p\u003E\n\u003Chr /\u003E\n\u003Cp\u003E- End -\n\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u957F\u6309\u8BC6\u522B\u4E8C\u7EF4\u7801\n\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u83B7\u53D6\u66F4\u591A\u7CBE\u5F69\u5185\u5BB9\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u25BC\u003C/strong\u003E\n\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/06/frc-393d7a99f3f2b62d8101a4e46568d89f.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/06/frc-55a705354cac3bb838e283010202f339.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/06/frc-e592b6d7fcb0f17eb92480e99a800f61.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/06/frc-38bc8c97af1c04b93222b36dcb5bbbce.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/06/frc-66f61deeda48ac066eaadc74e0ff7ca3.gif\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5206\u4EAB\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/06/frc-4db2f23cf0e6f951e341ba1ced8f0917.gif\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u6536\u85CF\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/06/frc-280a49ece728eeef36bddfc55343e370.gif\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u767E\u5E74 \u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/06/frc-2bef5eb45056a72b7565d3b6c80d4a2f.gif\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5B89\u987A\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/AgMGk5cS11LXh_HeYSsBNQ\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\