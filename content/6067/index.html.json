{
  "id": "\u9A6C\u6765\u897F\u4E9A\u9996\u76F8\u65B0\u5EA7\u9A7E\u9009\u62E9\u4E2D\u56FD\u7535\u52A8\u8F66\u54C1\u724C",
  "slug": "\u9A6C\u6765\u897F\u4E9A\u9996\u76F8\u65B0\u5EA7\u9A7E\u9009\u62E9\u4E2D\u56FD\u7535\u52A8\u8F66\u54C1\u724C",
  "canonicalUrlKey": "\u9A6C\u6765\u897F\u4E9A\u9996\u76F8\u65B0\u5EA7\u9A7E\u9009\u62E9\u4E2D\u56FD\u7535\u52A8\u8F66\u54C1\u724C",
  "route": "/6067/",
  "title": "\u9A6C\u6765\u897F\u4E9A\u9996\u76F8\u65B0\u5EA7\u9A7E\u9009\u62E9\u4E2D\u56FD\u7535\u52A8\u8F66\u54C1\u724C",
  "summary": "\u636E\u9A6C\u6765\u897F\u4E9A\u5A92\u4F53\u62A5\u9053\uFF0C\u9A6C\u6765\u897F\u4E9A\u9996\u76F8\u5B89\u534E\u8FD1\u65E5\u9009\u62E9\u4E2D\u56FD\u6781\u6C2A\uFF08ZEEKR\uFF09009\u8C6A\u534EMPV\u4F5C\u4E3A\u65B0\u5EA7\u9A7E\u51FA\u5E2D\u5B98\u65B9\u6D3B\u52A8\uFF0C\u8F66\u724C\u4E13\u5C5E\u5316\u8BBE\u8BA1\u3002\u8BE5\u8F66\u4E3A\u9876\u914D\u53CC\u9A6C\u8FBE\u9A71\u52A8\u7248\u672C\uFF0C\u7EED\u822A\u8FBE582\u516C\u91CC\uFF0C\u914D\u5907\u6309\u6469\u5EA7\u6905\u53CA\u51B7\u6696\u8F66\u8F7D\u51B0\u7BB1\u7B49\u8C6A\u534E\u914D\u7F6E\u3002\u76EE\u524D\u5728\u9A6C\u6765\u897F\u4E9A\u552E\u4EF7\u4ECB\u4E8E29.98\u4E07\u81F334.98\u4E07\u9A6C\u5E01\uFF0C\u4F53\u73B0\u4E2D\u56FD\u54C1\u724C\u7535\u52A8\u8F66\u5728\u9A6C\u6765\u897F\u4E9A\u9AD8\u7AEF\u5E02\u573A\u7684\u8BA4\u53EF\u5EA6\u3002",
  "body": "\u003Cimg src=\u0022/assets/uploads/d32715c91d3dd70ee77ace732e0287b799b017018c3f8c174012c79aea76eb7c.jpg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u636E\u9A6C\u6765\u897F\u4E9A\u5A92\u4F53\u62A5\u9053\uFF0C\u9A6C\u6765\u897F\u4E9A\u9996\u76F8\u5B89\u534E\u8FD1\u65E5\u4E58\u5750\u4E00\u6B3E\u8C6A\u534E\u7535\u52A8\u8F66\u4F5C\u4E3A\u65B0\u5EA7\u9A7E\u51FA\u5E2D\u5B98\u65B9\u6D3B\u52A8\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/sz_mmbiz_jpg/N19Y8l3pGj5SeUWbUZzC8qwZHuicBewKkrPuWD4y3fZLc0cCClezgN6DpprGUwmpRSRwI1zQ6MuScAZ1kBFPZHyDDv6qON3lyhnkv3Mf3Z9w/640?wx_fmt=jpeg\u0026amp;from=appmsg#imgIndex=0\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5B89\u534E\u7684\u65B0\u5EA7\u9A7E\u54C1\u724C\u4E3A\u4E2D\u56FD\u6781\u6C2A\uFF08ZEEKR\uFF09009\uFF0C\u8F66\u724C\u4E3A\u201CVHY 1947\u201D\uFF0C\u5176\u4E2D\u201C1947\u201D\u6B63\u662F\u5B89\u534E\u7684\u51FA\u751F\u5E74\u4EFD\u3002\u5B89\u534E\u4E8E1947\u5E748\u670810\u65E5\u51FA\u751F\uFF0C\u5E76\u4E8E\u672C\u670810\u65E5\u521A\u5E86\u795D79\u5C81\u751F\u65E5\u3002\u003C/p\u003E\n\u003Cp\u003E\u636E\u4E86\u89E3\uFF0C\u5B89\u534E\u6240\u4E58\u5750\u7684\u6781\u6C2A009\u5C5E\u4E8E\u8C6A\u534EMPV\u8F66\u578B\uFF0C\u4E3A\u9876\u914D\u7248\u672C\uFF0C\u91C7\u7528\u53CC\u9A6C\u8FBE\u9A71\u52A8\uFF0C\u7EED\u822A\u91CC\u7A0B\u53EF\u8FBE582\u516C\u91CC\uFF0C\u52A8\u529B\u8868\u73B0\u5F3A\u52B2\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/sz_mmbiz_png/N19Y8l3pGj5aeaAHQpVOHh1GHRLvzFEeUdWvjkH8iay4la73HX6UKribhtYGMiaWqgZFxicZicbiaAIm4blNWicQcwlK3xibp1ibBvakNXrych0M2s80/640?wx_fmt=png\u0026amp;from=appmsg#imgIndex=1\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u9664\u4E86\u52A8\u529B\u4E0E\u7EED\u822A\u8868\u73B0\uFF0C\u8F66\u5185\u4E5F\u914D\u5907\u591A\u9879\u8C6A\u534E\u914D\u7F6E\uFF0C\u5305\u62EC\u5177\u6309\u6469\u529F\u80FD\u7684\u5EA7\u6905\uFF0C\u53CA\u53EF\u63D0\u4F9B\u5236\u51B7\u4E0E\u5236\u70ED\u529F\u80FD\u7684\u8F66\u8F7D\u51B0\u7BB1\uFF0C\u63D0\u5347\u4E58\u5750\u7684\u8212\u9002\u5EA6\u3002\u003C/p\u003E\n\u003Cp\u003E\u76EE\u524D\uFF0C\u9A6C\u6765\u897F\u4E9A\u5E02\u573A\u4E0A\u6781\u6C2A009\u552E\u4EF7\u4ECB\u4E8E299800\u9A6C\u5E01\u81F3349800\u9A6C\u5E01\u4E4B\u95F4\uFF0C\u89C6\u8F66\u578B\u53CA\u914D\u7F6E\u800C\u5B9A\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u4E1D\u8DEF\u5728\u7EBF \u7EFC\u5408\u62A5\u9053\u003C/p\u003E\n\u003Cp\u003E\u7F16\u8F91\uFF1A\u96EA\u73B2\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u70ED\u70B9\u6587\u7AE0\u56DE\u987E\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5927\u9A6C\u5BA3\u5E03\u5409\u9686\u5761\u7A7A\u57DF\u5C06\u5206\u6BB5\u7981\u98DE5\u5929, \u5927\u91CF\u822A\u73ED\u5C06\u53D7\u5F71\u54CD\u003C/strong\u003E\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/sz_mmbiz_jpg/N19Y8l3pGj5bJc3eWaKGKwEgtRETHNvjFEufgS4OWDwGjbJtCGTXAsr9Fk7aubAEqHt57z6ZdWGa6CbmYrpOqR8snzuMJov7suBVPhuJJrM/640?wx_fmt=jpeg#imgIndex=2\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E17\u540D\u4E2D\u56FD\u516C\u6C11\u56E0\u9884\u671F\u9017\u7559\u9A6C\u6765\u897F\u4E9A\u88AB\u5904\u7F5A\u003C/strong\u003E\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/mmbiz_jpg/N19Y8l3pGj7libL4iaHULfuTUPBCp5wcguD9SVEefh0BG2WKvyDbWXhOzbKSthVuVh6icgdX79s64zjQh9sukX90qzr8gBcKjVeQpVgRsaMwKo/640?wx_fmt=jpeg\u0026amp;from=appmsg#imgIndex=3\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u9646\u5146\u798F\u8D25\u9009\u6216\u5F15\u53D1\u8FDE\u9501\u6548\u5E94\uFF0C\u69DF\u57CE\u6216\u8FCE\u5DE8\u9707\u003C/strong\u003E\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/mmbiz_jpg/N19Y8l3pGj4MJARvpJsPE8kqFqByYnaueK8Z8z68euiabkYeBQBKMtQkqTj6g8VP6MSLRITpwg9WBL0JBUvPicicZqDWnyKgCdvJia3PxxxL4E4/640?wx_fmt=jpeg#imgIndex=4\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5927\u9A6C\u7834\u83B7\u5927\u89C4\u6A21\u7535\u8BC8\u6848, 309\u540D\u4E2D\u56FD\u4EBA\u88AB\u6355, \u4EE5\u68EE\u6797\u57CE\u5E02\u4E3A\u636E\u70B9\u003C/strong\u003E\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/sz_mmbiz_jpg/N19Y8l3pGj75OaDO3gfp0tibW6h1E8DbicG2YKTSccOLdo9WMuIXjnrcZB7dNuCpOvdyrwiaT0TfN1KQv6xTDI5CiaZ5lXNGqn41Yh55LegbXFY/640?wx_fmt=jpeg\u0026amp;from=appmsg#imgIndex=5\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u4E2D\u56FD\u9A7B\u9A6C\u6765\u897F\u4E9A\u5927\u4F7F\u9986\u53D1\u5E03\u6765\u9A6C\u5B89\u5168\u63D0\u9192\u003C/strong\u003E\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/sz_mmbiz_jpg/N19Y8l3pGj6Xvc5BAZDLstRhR9gXaGhSSo69xZt2QEWLU8RSsRwpwvxqDON7GSrgRALe8ichC8qibTlD3Xwl1rjabTtpeOo13U3Cw3d9ic383U/640?wx_fmt=jpeg#imgIndex=6\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u9A6C\u6765\u897F\u4E9ATNG\u7535\u5B50\u94B1\u5305\u5168\u9762\u6539\u7248\uFF0C\u5FEB\u6765\u4E86\u89E3\u7EC6\u8282\u2026\u2026\u003C/strong\u003E\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/mmbiz_jpg/N19Y8l3pGj6j24icgicljl3pkNV0BVLlkC2azcmH7uia0gxzfrMvRg0o3CYdp24aCVs73PtABtqJdhicxezBjKzwOFPhHz2fdvIrziamYgHv4szc/640?wx_fmt=jpeg#imgIndex=7\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u4E2D\u56FD\u4E00\u76F4\u98DE\u5409\u9686\u5761\u822A\u7EBF\u5C06\u822A\u73ED\u8C03\u6574\u4E3A\u767D\u5929\u6267\u98DE\u003C/strong\u003E\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/sz_mmbiz_jpg/N19Y8l3pGj4ia9sIyK1PPrSdenybo8icX1Bj1HlJUvM1b5bP0MRyqGbnDKGVhibyHHakoYZFmODToBk0BHTLssPg4kuKNfZfSEBiag3AM0zs14k/640?wx_fmt=jpeg#imgIndex=8\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E2026\u4E2D\u56FD\u5C71\u4E1C\u2014\u9A6C\u6765\u897F\u4E9A\u540D\u4F18\u4EA7\u54C1\u5C55\u9500\u4F1A\u5728\u9A6C\u5F00\u5E55\u003C/strong\u003E\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/mmbiz_jpg/N19Y8l3pGj7NMrwTEObK8sycgfTrpYiap5jbLYWcT7icbc41gOiaWLgS5Q9mibTZKic6NNzAWk5JrbicXYzRL252EKEtrAMjYCtHVFib0iclOjqTHf0/640?wx_fmt=jpeg#imgIndex=9\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u6D4E\u5357\u5E02\u59D4\u526F\u4E66\u8BB0\u6768\u5CF0\u7387\u56E2\u8BBF\u95EE\