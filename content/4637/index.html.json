  "id": "%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e5%86%85%e9%98%81%e8%ae%ae%e5%86%b3-%e7%bb%88%e6%ad%a2pjd-link%e5%8f%91%e5%b1%95%e9%a1%b9%e7%9b%ae",
  "slug": "%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e5%86%85%e9%98%81%e8%ae%ae%e5%86%b3-%e7%bb%88%e6%ad%a2pjd-link%e5%8f%91%e5%b1%95%e9%a1%b9%e7%9b%ae",
  "canonicalUrlKey": "%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e5%86%85%e9%98%81%e8%ae%ae%e5%86%b3-%e7%bb%88%e6%ad%a2pjd-link%e5%8f%91%e5%b1%95%e9%a1%b9%e7%9b%ae",
  "route": "/4637/",
  "title": "\u9A6C\u6765\u897F\u4E9A\u5185\u9601\u8BAE\u51B3 \u7EC8\u6B62PJD link\u53D1\u5C55\u9879\u76EE",
  "summary": "\uFF08\u5409\u9686\u576117\u65E5\u8BAF\uFF09\u901A\u8BAF\u90E8\u957F\u517C\u653F\u5E9C\u53D1\u8A00\u4EBA\u6CD5\u7C73\u62AB\u9732\uFF0C\u5185\u9601\u5DF2\u8BAE\u51B3\uFF0C\u7EC8\u6B62\u516B\u6253\u7075\u518D\u4E5F\u758F\u6563\u9AD8\u67B6\u5927\u9053\uFF08PJD link\uFF09\u53D1\u5C55\u9879\u76EE\u3002 \u4ED6\u8BF4\uFF0C\u57FA\u4E8E\u8BE5\u9879\u76EE\u7684\u7279\u8BB8\u7ECF\u8425\u516C\u53F8\u672A\u80FD\u6EE1\u8DB311\u9879\u6761\u4EF6\u4E2D\u7684\u5176\u4E2D6\u9879\uFF0C\u5185\u9601\u56E0\u6B64\u505A\u51FA\u8FD9\u9879\u51B3\u5B9A\u3002 \u6CD5\u7C73\u662F\u5728\u51FA\u5E2D\u5185\u9601\u4F1A\u8BAE\u540E\uFF0C\u5728\u65B0\u95FB\u53D1\u5E03\u4F1A\u4E0A\u5982\u662F\u8868\u793A\u3002 \u4ED6\u8BF4\uFF0C\u8BE5\u9879\u76EE\u7684\u7279\u8BB8\u7ECF\u8425\u516C\u53F8\u63D0\u51FA\u5EF6\u957F\u8BA1\u5212\u7684\u7533\u8BF7\uFF0C\u4EE5\u7B26\u5408\u591A\u9879\u5148\u51B3\u548C\u5FC5\u8981\u6761\u4EF6\uFF0C\u6B64\u4E3E\u906D\u5230\u653F\u5E9C\u62D2\u7EDD\u3002 \u201C\u5DE5\u7A0B\u90E8\u968F\u540E\u5C06\u5C31\u6B64\u4E8B\u4F5C\u8FDB\u4E00\u6B65\u58F0\u660E\uFF0C\u5A92\u4F53\u5C4A\u65F6\u53EF\u5411\u516C\u5171\u5DE5\u7A0B\u90E8\u957F\u8BE2\u95EE\u8BE6\u60C5\u3002\u201D \u6CD5\u7C73\u8865\u5145\uFF0C\u636E\u4ED6\u6240\u77E5\uFF0C\u5F53\u5C40\u6B64\u524D\u5DF23\u5EA6\u5EF6\u957F\u671F\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/04/frc-e4c6e667d93c9ae8f714c21b090bc55d.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\uFF08\u5409\u9686\u576117\u65E5\u8BAF\uFF09\u901A\u8BAF\u90E8\u957F\u517C\u653F\u5E9C\u53D1\u8A00\u4EBA\u6CD5\u7C73\u62AB\u9732\uFF0C\u5185\u9601\u5DF2\u8BAE\u51B3\uFF0C\u7EC8\u6B62\u516B\u6253\u7075\u518D\u4E5F\u758F\u6563\u9AD8\u67B6\u5927\u9053\uFF08PJD link\uFF09\u53D1\u5C55\u9879\u76EE\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u57FA\u4E8E\u8BE5\u9879\u76EE\u7684\u7279\u8BB8\u7ECF\u8425\u516C\u53F8\u672A\u80FD\u6EE1\u8DB311\u9879\u6761\u4EF6\u4E2D\u7684\u5176\u4E2D6\u9879\uFF0C\u5185\u9601\u56E0\u6B64\u505A\u51FA\u8FD9\u9879\u51B3\u5B9A\u3002\u003C/p\u003E\n\u003Cp\u003E\u6CD5\u7C73\u662F\u5728\u51FA\u5E2D\u5185\u9601\u4F1A\u8BAE\u540E\uFF0C\u5728\u65B0\u95FB\u53D1\u5E03\u4F1A\u4E0A\u5982\u662F\u8868\u793A\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u8BE5\u9879\u76EE\u7684\u7279\u8BB8\u7ECF\u8425\u516C\u53F8\u63D0\u51FA\u5EF6\u957F\u8BA1\u5212\u7684\u7533\u8BF7\uFF0C\u4EE5\u7B26\u5408\u591A\u9879\u5148\u51B3\u548C\u5FC5\u8981\u6761\u4EF6\uFF0C\u6B64\u4E3E\u906D\u5230\u653F\u5E9C\u62D2\u7EDD\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u5DE5\u7A0B\u90E8\u968F\u540E\u5C06\u5C31\u6B64\u4E8B\u4F5C\u8FDB\u4E00\u6B65\u58F0\u660E\uFF0C\u5A92\u4F53\u5C4A\u65F6\u53EF\u5411\u516C\u5171\u5DE5\u7A0B\u90E8\u957F\u8BE2\u95EE\u8BE6\u60C5\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u6CD5\u7C73\u8865\u5145\uFF0C\u636E\u4ED6\u6240\u77E5\uFF0C\u5F53\u5C40\u6B64\u524D\u5DF23\u5EA6\u5EF6\u957F\u671F\u9650\uFF0C\u4F9B\u8BE5\u9879\u76EE\u7684\u7279\u8BB8\u7ECF\u8425\u516C\u53F8\u6EE1\u8DB3\u6761\u4EF6\uFF0C\u7136\u800C\uFF0C\u8BE5\u516C\u53F8\u6700\u7EC8\u8FD8\u662F\u65E0\u6CD5\u5B8C\u6210\u3002\u003C/p\u003E\n\u003Cp\u003E\u6839\u636E\u62A5\u5BFC\uFF0C\u6B64\u9879\u76EE\u81EA\u5BA3\u5E03\u4EE5\u6765\uFF0C\u4E00\u76F4\u906D\u5230\u53CD\u5BF9\uFF0C\u6279\u8BC4\u8005\u6307\u5B83\u5C06\u5F71\u54CD\u516B\u6253\u7075\u518D\u4E5F\u4E00\u4E9B\u6700\u53E4\u8001\u7684\u793E\u533A\u3002\u003C/p\u003E\n\u003Cp\u003E\u800C\u96EA\u5DDE\u653F\u5E9C\u662F\u5728\u53BB\u5E747\u670831\u65E5\u5BA3\u5E03\u53D6\u6D88\u6B64\u9879\u76EE\u7684\u7533\u8BF7\uFF0C\u56E0\u4E3A\u5DDE\u653F\u5E9C\u4E0D\u6EE1\u610F\u5927\u9053\u53D1\u5C55\u5546\u63D0\u5448\u7684\u8BC4\u4F30\u62A5\u544A\uFF0C\u5C24\u5176\u662F\u793E\u4F1A\u8BC4\u4F30\u62A5\u544A\u672A\u80FD\u9075\u5B88\u5DDE\u653F\u5E9C\u7684\u6761\u4EF6\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E0D\u8FC7\uFF0C\u5728\u4ECA\u5E742\u670824\u65E5\uFF0C\u96EA\u5DDE\u5927\u81E3\u62FF\u7763\u65AF\u91CC\u963F\u7C73\u9C81\u4E01\u8981\u6C42\u5F00\u53D1\u5546\u4E0E\u4E2D\u592E\u653F\u5E9C\u91CD\u65B0\u8C08\u5224\u3002\u003C/p\u003E\n\u003Ch1\u003E\u53D6\u6D88\u516B\u6253\u7075\u518D\u4E5F\u758F\u6563\u9AD8\u67B6\u5927\u9053\u5DE5\u7A0B\u3000MUDA\uFF1A\u96EA\u5DDE\u5927\u81E3\u5BA3\u5E03\u65F6\u673A\u592A\u5DE7\u5408\u003C/h1\u003E\n\u003Cp\u003E\u53D1\u5E03\u4E8E 2023\u5E7407\u670831\u65E5\u003C/p\u003E\n\u003Cp\u003E\uFF08\u5409\u9686\u576131\u65E5\u8BAF\uFF09\u96EA\u5DDE\u770B\u5B88\u5927\u81E3\u62FF\u7763\u65AF\u91CC\u963F\u7C73\u9C81\u4E01\u5BA3\u5E03\u516B\u6253\u7075\u518D\u4E5F\u758F\u6563\u9AD8\u67B6\u5927\u9053\uFF08PJD Link Expressway\uFF09\u5DE5\u7A0B\u6401\u7F6E\uFF0C\u5927\u9A6C\u6C11\u4E3B\u8054\u5408\u9635\u7EBF\uFF08MUDA\uFF09\u6B66\u5409\u52A0\u661F\u5019\u9009\u4EBAVKK\u62C9\u8D3E\u8BA4\u706B\u4E3A\uFF0C\u963F\u7C73\u9C81\u4E01\u8FD9\u9879\u5BA3\u5E03\u65F6\u673A\u4E0D\u514D\u592A\u5DE7\u5408\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u5DDE\u52A1\u5927\u81E3\u5728\u7ADE\u9009\u671F\u95F4\u8868\u793A\uFF0C\u5728\u9605\u8BFB\u4E86\u73AF\u5883\u5F71\u54CD\u8BC4\u4F30\u62A5\u544A\uFF08EIA\uFF09\u548C\u793E\u4F1A\u5F71\u54CD\u8BC4\u4F30\u62A5\u544A\uFF08SIA\uFF09\u540E\uFF0C\u4ED6\u51B3\u5B9A\u53D6\u6D88\u8FD9\u4E2A\u9879\u76EE\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u201C\u8BA9\u6211\u63D0\u9192\u5927\u5BB6\uFF0C\u8FD9\u4E9B\u62A5\u544A\u63D0\u4F9B\u7ED9\u4ED6\u548C\u96EA\u5DDE\u653F\u5E9C\u5DF2\u65F6\u9694\u597D\u51E0\u4E2A\u6708\uFF0C\u4ED6\u4EEC\u6709\u5145\u5206\u65F6\u95F4\u53EF\u4EE5\u53D6\u6D88\uFF08\u5DE5\u7A0B\uFF09\uFF0C\u4F46\u4ED6\u4EEC\u6CA1\u6709\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u4EEC\u6000\u7591\u4ED6\u4EEC\u8FD9\u4E48\u505A\u662F\u56E0\u4E3A\u538B\u529B\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u5F3A\u8C03\uFF0C\u9664\u4E86\u5BF9\u96EA\u5DDE\u5E0C\u76DF\u653F\u5E9C\u611F\u5230\u5931\u671B\uFF0C\u66F4\u4EE4\u4EBA\u6CAE\u4E27\u7684\u662F\u5904\u4E8E\u53CD\u5BF9\u515A\u7684\u56FD\u76DF\u4F9D\u7136\u4FDD\u6301\u6C89\u9ED8\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u663E\u7136\u6211\u4EEC\u4E4B\u4E2D\u7684\u4E00\u4E9B\u4EBA\u5BF9\u96EA\u5DDE\u653F\u5E9C\u611F\u5230\u5931\u671B\uFF0C\u4F46\u66F4\u4EE4\u4EBA\u6CAE\u4E27\u7684\u662F\u56FD\u76DF\u53CD\u5BF9\u515A\u6C89\u9ED8\u7684\u53CD\u9988\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u201C\u4E5F\u8BB8\u662F\u4ED6\u4EEC\u76F2\u76EE\u4E8E\u63A5\u7BA1\u8054\u90A6\u653F\u5E9C\u7684\u4F4D\u5B50\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u201C\u6240\u4EE5\u6211\u4EEC\u5FC5\u987B\u4FDD\u6301\u8B66\u60D5\uFF0C\u4E0D\u8981\u5FD8\u8BB0\u516B\u6253\u7075\u518D\u4E5F\u758F\u6563\u5927\u9053\uFF08PJD Link\uFF09\u662F\u91D1\u92AE-\u767D\u6C99\u7F57\u5927\u9053\uFF08KIDEX\uFF09\u7684\u66F4\u540D\u7248\u672C\u3002\u5728\u6B64\u547C\u5401\u5927\u5BB6\u4FDD\u6301\u8FD9\u79CD\u538B\u529B\uFF0C\u5C24\u5176\u662F\u5728\u9009\u4E3E\u5B63\u8282\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u6B64\u5916\uFF0C\u5927\u9A6C\u6C11\u4E3B\u8054\u5408\u9635\u7EBF\u4E07\u8FBE\u9547\u5DDE\u8BAE\u5E2D\u5019\u9009\u4EBA\u6797\u6167\u5A34\uFF08Abe Lim\uFF09\u4E5F\u6566\u4FC3\u96EA\u5DDE\u5DDE\u52A1\u5927\u81E3\u963F\u7C73\u9C81\u4E01\u89E3\u5BC6\u534F\u8BAE\u6587\u4EF6\uFF0C\u5E76\u516C\u5F00\u73AF\u5883\u5F71\u54CD\u3001\u793E\u4F1A\u5F71\u54CD\u548C\u4EA4\u901A\u5F71\u54CD\u8BC4\u4F30\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u8981\u6C42\u96EA\u5170\u83AA\u5DDE\u653F\u5E9C\u89E3\u5BC6\u516C\u5F00\u516B\u6253\u7075\u518D\u4E5F\u758F\u6563\u5927\u9053\u534F\u8BAE\u5185\u5BB9\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u4E5F\u8981\u6C42\u516C\u5F00\u73AF\u5883\u5F71\u54CD\u3001\u793E\u4F1A\u5F71\u54CD\u548C\u4EA4\u901A\u5F71\u54CD\u8BC4\u4F30\u5F00\u53D1\u5546\u63D0\u4EA4\u7684\u62A5\u544A\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u5979\u8868\u793A\uFF0C\u4EBA\u6C11\u5E94\u8BE5\u77E5\u9053\u771F\u76F8\u3001\u4EE5\u786E\u4FDD\u8FD9\u6837\u7684\u4E8B\u60C5\u4E0D\u4F1A\u518D\u53D1\u751F\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u53CD\u5BF9\u4EFB\u4F55\u653F\u5E9C\u5229\u7528\u653F\u6CBB\u5671\u5934\u57286\u5DDE\u9009\u4E3E\u671F\u95F4\u83B7\u5F97\u9009\u7968\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u96EA\u5DDE\u770B\u5B88\u5927\u81E3\u62FF\u7763\u91CC\u65AF\u963F\u7C73\u9C81\u4E01\u4ECA\u65E5\u5BA3\u5E03\uFF0C\u5DDE\u653F\u5E9C\u6401\u7F6E\u6709\u5173\u516B\u6253\u7075\u518D\u4E5F\u758F\u6563\u9AD8\u67B6\u5927\u9053\uFF08PJD Link\uFF09\u7684\u5DE5\u7A0B\u9879\u76EE\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u900F\u9732\uFF0C\u57FA\u4E8E\u53D1\u5C55\u5546\u6240\u63D0\u4EA4\u7684\u5F71\u54CD\u8BC4\u4F30\u62A5\u544A\u5E76\u4E0D\u4EE4\u4EBA\u6EE1\u610F\uFF0C\u4E5F\u4E0D\u7B26\u5408\u5DDE\u653F\u5E9C\u8BBE\u5B9A\u7684\u67D0\u4E9B\u6761\u4EF6\uFF0C\u7279\u522B\u662F\u5176\u793E\u4F1A\u5F71\u54CD\u8BC4\u4F30\u62A5\u544A\u65B9\u9762\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6307\u51FA\uFF0C\u5DDE\u653F\u5E9C\u4E0D\u6253\u7B97\u7EE7\u7EED\u8BE5\u9879\u76EE\uFF0C\u5E76\u51B3\u5B9A\u62D2\u7EDD\u516B\u6253\u7075\u518D\u4E5F\u758F\u6563\u5927\u9053\uFF08PJD Link Expressway\uFF09\u5F00\u53D1\u5546\u7684\u9879\u76EE\u7533\u8BF7\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/Ms5cWryC3VaGYM8Gr1k0pg\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
