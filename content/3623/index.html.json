  "title": "\u5173\u4E39\u4E2D\u534E\u4E2D\u5B66\u4E0E\u4E1C\u94A2\u96C6\u56E2\u8FDB\u884C\u201C\u4EA7\u5B66\u5408\u4F5C\u201D  \u5C06\u5F15\u8FDB\u5317\u4EAC\u79D1\u6280\u5927\u5B66",
  "summary": "\uFF08\u5173\u4E3923\u65E5\u8BAF\uFF09\u5173\u4E39\u4E2D\u534E\u4E2D\u5B66\u4E0E\u4E1C\u94A2\u96C6\u56E2\u8FDB\u884C\u201C\u4EA7\u5B66\u5408\u4F5C\u201D\uFF0C\u53CC\u65B9\u4ECA\u65E5\u7B7E\u7F72\u201C\u57F9\u80B2\u4EBA\u624D\u5408\u4F5C\u201D\u5907\u5FD8\u5F55\uFF0C\u4E3A\u5B66\u751F\u5F00\u62D3\u4E00\u7247\u65B0\u7684\u672A\u6765\u53D1\u5C55\u7A7A\u95F4\u3002 \u4E1C\u94A2\u96C6\u56E2\u6709\u9650\u516C\u53F8\u8463\u4E8B\u90D1\u6625\u798F\u53D7\u8BBF\u65F6\u8868\u793A\uFF0C\u8BE5\u516C\u53F8\u9009\u62E9\u5173\u4E39\u4E2D\u534E\u4E2D\u5B66\u505A\u4E3A\u56FD\u5185\u7B2C\u4E00\u6240\u5408\u4F5C\u7684\u5B66\u6821\uFF0C\u9996\u5148\u9996\u91CD\u4E8E\u53CC\u65B9\u7406\u5FF5\u76F8\u540C\uFF0C\u4E14\u5173\u4E2D\u8FD1\u5E74\u6765\u79EF\u6781\u57F9\u517B\u4E2D\u5B66\u9636\u6BB5\u7684\u5B66\u672F\u4F18\u79C0\u4EBA\u624D\uFF0C\u4E5F\u6CE8\u91CD\u5B66\u751F\u81EA\u5F8B\u5F8B\u4EBA\u7684\u4F18\u826F\u6821\u98CE\u3002 \u4ED6\u8BF4\uFF0C\u5BF9\u4E8E\u4F01\u4E1A\uFF0C\u6B64\u9879\u6982\u5FF5\u63D0\u9AD8\u4E86\u4F01\u4E1A\u4EBA\u5458\u7D20\u8D28\uFF0C\u589E\u52A0\u4F01\u4E1A\u53D1\u5C55\u6F5C\u529B\uFF0C\u4EA7\u5B66\u5408\u4F5C\u7684\u6700\u5927\u76EE\u7684\u662F\u4E3A\u672C\u5730\u884C\u4E1A\u57F9\u80B2\u4E13\u79D1\u4EBA\u624D\uFF0C\u5C24\u5176\u662F\u56FD\u5185\u94A2\u94C1\u4E1A\u3002 \u51FA\u5E2D\u201C\u57F9\u80B2\u4EBA\u624D\u5408\u4F5C\u201D\u5907\u5FD8\u5F55\u7B7E\u7F72\u4EEA\u5F0F\u7684\u8D35\u5BBE\u2026",
  "body": "\u003Cp\u003E\uFF08\u5173\u4E3923\u65E5\u8BAF\uFF09\u5173\u4E39\u4E2D\u534E\u4E2D\u5B66\u4E0E\u4E1C\u94A2\u96C6\u56E2\u8FDB\u884C\u201C\u4EA7\u5B66\u5408\u4F5C\u201D\uFF0C\u53CC\u65B9\u4ECA\u65E5\u7B7E\u7F72\u201C\u57F9\u80B2\u4EBA\u624D\u5408\u4F5C\u201D\u5907\u5FD8\u5F55\uFF0C\u4E3A\u5B66\u751F\u5F00\u62D3\u4E00\u7247\u65B0\u7684\u672A\u6765\u53D1\u5C55\u7A7A\u95F4\u3002\n\n\u4E1C\u94A2\u96C6\u56E2\u6709\u9650\u516C\u53F8\u8463\u4E8B\u90D1\u6625\u798F\u53D7\u8BBF\u65F6\u8868\u793A\uFF0C\u8BE5\u516C\u53F8\u9009\u62E9\u5173\u4E39\u4E2D\u534E\u4E2D\u5B66\u505A\u4E3A\u56FD\u5185\u7B2C\u4E00\u6240\u5408\u4F5C\u7684\u5B66\u6821\uFF0C\u9996\u5148\u9996\u91CD\u4E8E\u53CC\u65B9\u7406\u5FF5\u76F8\u540C\uFF0C\u4E14\u5173\u4E2D\u8FD1\u5E74\u6765\u79EF\u6781\u57F9\u517B\u4E2D\u5B66\u9636\u6BB5\u7684\u5B66\u672F\u4F18\u79C0\u4EBA\u624D\uFF0C\u4E5F\u6CE8\u91CD\u5B66\u751F\u81EA\u5F8B\u5F8B\u4EBA\u7684\u4F18\u826F\u6821\u98CE\u3002\n\n\u4ED6\u8BF4\uFF0C\u5BF9\u4E8E\u4F01\u4E1A\uFF0C\u6B64\u9879\u6982\u5FF5\u63D0\u9AD8\u4E86\u4F01\u4E1A\u4EBA\u5458\u7D20\u8D28\uFF0C\u589E\u52A0\u4F01\u4E1A\u53D1\u5C55\u6F5C\u529B\uFF0C\u4EA7\u5B66\u5408\u4F5C\u7684\u6700\u5927\u76EE\u7684\u662F\u4E3A\u672C\u5730\u884C\u4E1A\u57F9\u80B2\u4E13\u79D1\u4EBA\u624D\uFF0C\u5C24\u5176\u662F\u56FD\u5185\u94A2\u94C1\u4E1A\u3002\n\n\u51FA\u5E2D\u201C\u57F9\u80B2\u4EBA\u624D\u5408\u4F5C\u201D\u5907\u5FD8\u5F55\u7B7E\u7F72\u4EEA\u5F0F\u7684\u8D35\u5BBE\u5305\u62EC\u4E1C\u94A2\u96C6\u56E2\u4EBA\u4E8B\u884C\u653F\u90E8\u526F\u90E8\u957F\u7504\u5927\u4F1F\u3001\u4EBA\u529B\u8D44\u6E90\u5BA4\u4E3B\u4EFB\u674E\u5A1C\u3001\u4EBA\u529B\u8D44\u6E90\u5BA4\u526F\u4E3B\u4EFB\u9ECE\u9F84\u851A\u3001\u5173\u4E39\u4E2D\u534E\u4E2D\u5B66\u526F\u6821\u957F\u53F6\u798F\u6C11\u53CA\u9EC4\u91D1\u8D35\u3001\u516C\u5173\u90E8\u4E3B\u4EFB\u9648\u6CBA\u83D8\u3001\u8F85\u5BFC\u5904\u4E3B\u4EFB\u9EC4\u7D20\u83C1\u7B49\uFF1B\u4E24\u540D\u6821\u53CB\u5510\u5BB6\u53CB\u53CA\u5510\u5BB6\u6607\u4E5F\u7533\u8BF7\u53C2\u4E0E\u4E1C\u94A2\u96C6\u56E2\u7684\u4FDD\u9001\u8BA1\u5212\u3002\n\n\u90D1\u6625\u798F\u8BF4\uFF0C\u901A\u8FC7\u8FD9\u9879\u8BA1\u5212\uFF0C\u5B66\u751F\u6BD5\u4E1A\u8FC7\u540E\uFF0C\u4E1C\u94A2\u96C6\u56E2\u4E5F\u4F1A\u63D0\u4F9B\u5C31\u4E1A\u673A\u4F1A\u53CA\u4F01\u4E1A\u798F\u5229\uFF0C\u4E3B\u8981\u662F\u53EF\u57F9\u80B2\u4E2D\u4E0A\u5C42\u7684\u884C\u653F\u4E0E\u6280\u672F\u4EBA\u624D\u3002\n\n\u4ED6\u4E5F\u8BF4\uFF0C\u4E1C\u94A2\u96C6\u56E2\u5C06\u5F15\u8FDB\u5317\u4EAC\u79D1\u6280\u5927\u5B66\uFF08https://www.ustb.edu.cn/xxgk/xxjj/index.htm\uFF09\uFF0C\u5E76\u6B63\u5728\u6781\u79EF\u4E0E\u672C\u5730\u4E24\u6240\u8457\u540D\u5927\u5B66\u63A5\u6D3D\u5408\u4F5C\u610F\u613F\u3002\n\n\u201C\u4E1C\u94A2\u96C6\u56E2\u4E0E\u5173\u4E2D\u4E5F\u5408\u4F5C\u63D0\u4F9B\u201C\u4FDD\u9001\u8BA1\u5212\u201D\uFF0C\u8BA9\u6709\u610F\u5728\u6B64\u8BA1\u5212\u4E0B\u53D7\u60E0\u7684\u5B66\u751F\u53EF\u4EE5\u901A\u8FC7\u4E1C\u94A2\u96C6\u56E2\u5230\u4FDD\u9001\u5927\u5B66\u6DF1\u9020\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u7EE7\u8BF4\uFF0C\u5408\u4F5C\u53CC\u65B9\u4E00\u81F4\u770B\u597D\u8FD9\u9879\u201C\u6821\u4F01\u5408\u4F5C\u201D\uFF0C\u8FD8\u6709\u671B\u4ECE\u4E24\u65B9\u9762\u5BF9\u56FD\u5185\u4EA7\u4E1A\u8F6C\u578B\u5347\u7EA7\u4E0E\u793E\u4F1A\u5065\u5EB7\u53D1\u5C55\u5E26\u6765\u91CD\u8981\u8D21\u732E\uFF0C\u5373\uFF1A\u7B2C\u4E00\uFF0C\u900F\u8FC7\u4E3A\u4E1C\u6D77\u5CB8\u65B0\u4E00\u4EE3\u7684\u5728\u7C4D\u5B66\u751F\u5236\u9020\u5C31\u4E1A\u548C\u4E0A\u5347\u589E\u503C\u6E20\u9053\uFF0C\u4EE5\u5E73\u8861\u548C\u7F29\u77ED\u4E1C\u3001\u897F\u6D77\u5CB8\u7684\u5DE5\u4E1A\u7ECF\u6D4E\u53D1\u5C55\u9E3F\u6C9F\uFF1B\u7B2C\u4E8C\uFF0C\u4E3A\u8D2B\u5BD2\u3001\u5F31\u52BF\u6216\u5355\u4EB2\u5BB6\u5EAD\u7684\u5B69\u5B50\u63D0\u4F9B\u5B66\u4EE5\u81F4\u7528\u548C\u4E0E\u4E16\u754C\u4EA7\u4E1A\u94FE\u63A5\u8F68\u7684\u5347\u9020\u673A\u4F1A\uFF0C\u63A8\u52A8\u4E1C\u6D77\u5CB8\u793E\u533A\u826F\u6027\u5EFA\u8BBE\uFF0C\u4FC3\u8FDB\u793E\u4F1A\u548C\u8C10\u53D1\u5C55\u3002\n\n\u201C\u56E0\u6B64\uFF0C\u5411\u6765\u5341\u5206\u91CD\u89C6\u4EBA\u624D\u57F9\u517B\u8D28\u91CF\u7684\u4E1C\u94A2\u96C6\u56E2\u770B\u597D\uFF0C\u672A\u6765\u5C06\u4F1A\u6709\u66F4\u591A\u5B66\u6821\u52A0\u5165\u5230\u201C\u6821\u4F01\u5408\u4F5C\u201D\u7684\u8BA1\u5212\u4E2D\uFF0C\u57F9\u80B2\u66F4\u591A\u56FD\u9645\u578B\u4EBA\u624D\uFF0C\u63A8\u8FDB\u56FD\u5185\u94A2\u94C1\u4E1A\u6280\u672F\u5F00\u53D1\u7684\u5FEB\u901F\u6539\u9769\u521B\u65B0\u3002\u201D\n\n\u5173\u4E39\u4E2D\u534E\u4E2D\u5B66\u6821\u957F\u8521\u82E5\u5CF0\u8BF4\uFF0C\u4EA7\u5B66\u5408\u4F5C\u4E5F\u88AB\u79F0\u4E4B\u4E3A\u201C\u6821\u4F01\u5408\u4F5C\u201D\uFF0C\u53CC\u65B9\u8FBE\u5230\u4E86\u5171\u8BC6\uFF0C\u4ECE\u5B66\u6821\u800C\u8A00\uFF0C\u4EA7\u5B66\u7ED3\u5408\u4EBA\u624D\u57F9\u517B\u6A21\u5F0F\u5DF2\u6210\u4E3A\u73B0\u4ECA\u804C\u6559\u754C\u516C\u8BA4\u7684\u5E94\u7528\u578B\u4EBA\u624D\u57F9\u517B\u7684\u7BA1\u9053\u4E4B\u4E00\u3002\n\n\u201C\u6211\u4EEC\u5FC5\u987B\u4E3A\u56FD\u5BB6\u50A8\u5907\u672A\u6765\u4E13\u79D1\u4EBA\u624D\uFF0C\u5F00\u62D3\u5B66\u751F\u5C06\u6765\u7684\u53D1\u5C55\u7A7A\u95F4\u3002\u201D\n\n\u4ED6\u8BF4\uFF0C\u4E1C\u94A2\u96C6\u56E2\u9AD8\u8D28\u91CF\u63A8\u8FDB\u9879\u76EE\u5B9E\u65BD\uFF0C\u4FC3\u8FDB\u56FD\u5185\u7ECF\u6D4E\u6548\u7387\uFF0C\u5F15\u8FDB\u5916\u56FD\u9AD8\u7AEF\u6280\u672F\uFF0C\u63D0\u5347\u672C\u5730\u6280\u672F\u5C42\u9762\u7684\u7D20\u8D28\u3002\n\n\u6B32\u77E5\u8BE6\u60C5\uFF0C\u53EF\u4EE5\u8BE2\u95EE\u5173\u4E2D\u8F85\u5BFC\u5904: 011-334 76432\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/03/frc-b977fe53e17c8437b30de5d543df3170.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\n\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/sRzBGTqpECbOjyQjl5VwRA\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
