  "id": "%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e7%be%8e%e9%87%8c%e8%ae%be%e6%b0%a2%e8%83%bd%e5%8f%91%e7%94%b5%e3%80%80%e4%b8%ba%e6%b2%99%e5%b7%b4%e5%8f%8a%e6%b1%b6%e8%8e%b1%e4%be%9b%e5%ba%94%e7%94%b5%e5%8a%9b",
  "slug": "%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e7%be%8e%e9%87%8c%e8%ae%be%e6%b0%a2%e8%83%bd%e5%8f%91%e7%94%b5%e3%80%80%e4%b8%ba%e6%b2%99%e5%b7%b4%e5%8f%8a%e6%b1%b6%e8%8e%b1%e4%be%9b%e5%ba%94%e7%94%b5%e5%8a%9b",
  "canonicalUrlKey": "%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e7%be%8e%e9%87%8c%e8%ae%be%e6%b0%a2%e8%83%bd%e5%8f%91%e7%94%b5%e3%80%80%e4%b8%ba%e6%b2%99%e5%b7%b4%e5%8f%8a%e6%b1%b6%e8%8e%b1%e4%be%9b%e5%ba%94%e7%94%b5%e5%8a%9b",
  "route": "/5485/",
  "title": "\u9A6C\u6765\u897F\u4E9A\u7F8E\u91CC\u8BBE\u6C22\u80FD\u53D1\u7535\u3000\u4E3A\u6C99\u5DF4\u53CA\u6C76\u83B1\u4F9B\u5E94\u7535\u529B",
  "summary": "\uFF08\u53E4\u664B13\u65E5\u8BAF\uFF09\u7802\u62C9\u8D8A\u603B\u7406\u62FF\u7763\u5DF4\u4E01\u5B9C\u4E39\u65AF\u91CC\u963F\u90A6\u4F50\u54C8\u91CC\u8868\u793A\uFF0C\u7802\u62C9\u8D8A\u5C06\u6210\u4E3A\u533A\u57DF\u80FD\u6E90\u4F9B\u5E94\u67A2\u7EBD\uFF0C\u9884\u8BA12027\u5E74\u6C22\u80FD\u517C\u5BB9\u8054\u5408\u5FAA\u73AF\u71C3\u6C14\u8F6E\u673A(CCGT)\u6B63\u5F0F\u542F\u7528\u3002 \u4ED6\u8BF4\uFF0C\u4F4D\u4E8E\u7F8E\u91CC\u7684\u6C22\u80FD\u517C\u5BB9\u8054\u5408\u5FAA\u73AF\u71C3\u6C14\u8F6E\u673A\u53D1\u7535\u8BBE\u65BD\u9884\u8BA1\u5C06\u4E8E2027\u5E74\u5B8C\u5DE5\uFF0C\u5C4A\u65F6\u5C06\u4E0D\u4EC5\u80FD\u6EE1\u8DB3\u7802\u62C9\u8D8A\u672C\u5730\u7684\u80FD\u6E90\u9700\u6C42\uFF0C\u8FD8\u53EF\u4E3A\u90BB\u8FD1\u5730\u533A\u5982\u6C99\u5DF4\u53CA\u6C76\u83B1\u4F9B\u5E94\u7535\u529B\u3002 \u4ED6\u4ECA\u65E9\u5728\u53E4\u664B\u5A46\u7F57\u6D32\u4F1A\u5C55\u4E2D\u5FC3\u4E3E\u884C\u7684\u201C2025\u5E74\u7802\u62C9\u8D8A\u9996\u8981\u81F4\u8BCD\u6D3B\u52A8\u201D\u540E\u63A5\u53D7\u5A92\u4F53\u8FFD\u95EE\u5982\u6B64\u8868\u793A\u3002 \u4ED6\u900F\u9732\uFF0C\u7802\u62C9\u8D8A\u5DF2\u4E0E\u6C99\u5DF4\u8FBE\u6210\u534F\u8BAE\uFF0C\u5C06\u4F9B\u5E9450\u5146\u74E6\u7684\u7535\u529B\u4E88\u6C99\u5DF4\uFF0C\u800C\u6C99\u5DF4\u6709\u610F\u5C06\u9700\u6C42\u63D0\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2025/01/frc-7bbd0d012414d3e2e19773acbe610230.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\uFF08\u53E4\u664B13\u65E5\u8BAF\uFF09\u7802\u62C9\u8D8A\u603B\u7406\u62FF\u7763\u5DF4\u4E01\u5B9C\u4E39\u65AF\u91CC\u963F\u90A6\u4F50\u54C8\u91CC\u8868\u793A\uFF0C\u7802\u62C9\u8D8A\u5C06\u6210\u4E3A\u533A\u57DF\u80FD\u6E90\u4F9B\u5E94\u67A2\u7EBD\uFF0C\u9884\u8BA12027\u5E74\u6C22\u80FD\u517C\u5BB9\u8054\u5408\u5FAA\u73AF\u71C3\u6C14\u8F6E\u673A(CCGT)\u6B63\u5F0F\u542F\u7528\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u4F4D\u4E8E\u7F8E\u91CC\u7684\u6C22\u80FD\u517C\u5BB9\u8054\u5408\u5FAA\u73AF\u71C3\u6C14\u8F6E\u673A\u53D1\u7535\u8BBE\u65BD\u9884\u8BA1\u5C06\u4E8E2027\u5E74\u5B8C\u5DE5\uFF0C\u5C4A\u65F6\u5C06\u4E0D\u4EC5\u80FD\u6EE1\u8DB3\u7802\u62C9\u8D8A\u672C\u5730\u7684\u80FD\u6E90\u9700\u6C42\uFF0C\u8FD8\u53EF\u4E3A\u90BB\u8FD1\u5730\u533A\u5982\u6C99\u5DF4\u53CA\u6C76\u83B1\u4F9B\u5E94\u7535\u529B\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u4ECA\u65E9\u5728\u53E4\u664B\u5A46\u7F57\u6D32\u4F1A\u5C55\u4E2D\u5FC3\u4E3E\u884C\u7684\u201C2025\u5E74\u7802\u62C9\u8D8A\u9996\u8981\u81F4\u8BCD\u6D3B\u52A8\u201D\u540E\u63A5\u53D7\u5A92\u4F53\u8FFD\u95EE\u5982\u6B64\u8868\u793A\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u900F\u9732\uFF0C\u7802\u62C9\u8D8A\u5DF2\u4E0E\u6C99\u5DF4\u8FBE\u6210\u534F\u8BAE\uFF0C\u5C06\u4F9B\u5E9450\u5146\u74E6\u7684\u7535\u529B\u4E88\u6C99\u5DF4\uFF0C\u800C\u6C99\u5DF4\u6709\u610F\u5C06\u9700\u6C42\u63D0\u9AD8\u81F3100\u5146\u74E6\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u8FD9\u663E\u793A\u4E86\u6211\u4EEC\u5BF9\u7535\u529B\u4F9B\u5E94\u7684\u627F\u8BFA\u3002\u4E0E\u6C76\u83B1\u7684\u5408\u4F5C\u76EE\u524D\u4E5F\u5728\u8BA8\u8BBA\u4E2D\uFF0C\u6211\u4EEC\u5E0C\u671B\u80FD\u591F\u8FDB\u4E00\u6B65\u4FC3\u8FDB\u533A\u57DF\u5408\u4F5C\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u963F\u90A6\u4F50\u54C8\u91CC\u63D0\u5230\uFF0C\u8FD9\u5C06\u91C7\u752830%\u7684\u6C22\u6C14\u4F5C\u4E3A\u71C3\u6599\uFF0C\u5E76\u8BA1\u5212\u9010\u6B65\u63D0\u5347\u81F350%\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u8BE5\u8BBE\u65BD\u5C06\u5177\u5907500\u5146\u74E6\u7684\u4F9B\u5E94\u80FD\u529B\uFF0C\u4E3B\u8981\u670D\u52A1\u7802\u62C9\u8D8A\u5317\u90E8\u5730\u533A\uFF0C\u540C\u65F6\u4E5F\u80FD\u4F9B\u5E94\u7ED9\u90BB\u8FD1\u7684\u6C99\u5DF4\u53CA\u6C76\u83B1\u3002\u6B64\u5916\uFF0C\u4F4D\u4E8E\u6C11\u90FD\u9C81\u7684\u4E09\u4E2A\u8054\u5408\u5FAA\u73AF\u8BBE\u65BD\u5C06\u63D0\u4F9B\u989D\u59161500\u5146\u74E6\u7684\u7535\u529B\uFF0C\u4F7F\u603B\u4F9B\u5E94\u91CF\u8FBE\u52302000\u5146\u74E6\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u8FD9\u4E9B\u8BBE\u65BD\u5C06\u5DE9\u56FA\u7802\u62C9\u8D8A\u5728\u80FD\u6E90\u9886\u57DF\u7684\u9886\u5BFC\u5730\u4F4D\uFF0C\u4E5F\u4E3A\u672A\u6765\u7684\u533A\u57DF\u7535\u7F51\u5EFA\u8BBE\u6253\u4E0B\u575A\u5B9E\u57FA\u7840\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u963F\u90A6\u4F50\u54C8\u91CC\u5F3A\u8C03\uFF0C\u7802\u62C9\u8D8A\u7684\u80FD\u6E90\u6218\u7565\u4E0D\u4EC5\u9650\u4E8E\u5929\u7136\u6C14\u548C\u6C22\u80FD\uFF0C\u8FD8\u5C06\u9010\u6B65\u5F15\u5165\u592A\u9633\u80FD\u53D1\u7535\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u9884\u8BA1\uFF0C\u52302030\u5E74\uFF0C\u7802\u62C9\u8D8A\u7684\u6E05\u6D01\u80FD\u6E90\u603B\u4EA7\u80FD\u5C06\u8FBE\u523010\u5409\u74E6\uFF0810,000\u5146\u74E6\uFF09\uFF0C\u5E76\u4E3A\u7802\u62C9\u8D8A\u5438\u5F15\u66F4\u591A\u6295\u8D44\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u5728\u56DE\u5E94\u63D0\u95EE\u65F6\u4E5F\u8BF4\uFF0C\u7802\u62C9\u8D8A\u6B63\u5728\u4E0E\u4E1C\u52A0\u91CC\u66FC\u4E39\u5730\u533A\u5408\u4F5C\uFF0C\u5229\u7528\u5F53\u5730\u7684\u6C34\u529B\u8D44\u6E90\u751F\u4EA7\u6E05\u6D01\u80FD\u6E90\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u4EEC\u4E0E\u5370\u5C3C\u7684\u5408\u4F5C\u5DF2\u5C55\u5F00\uFF0C\u8BA1\u5212\u5C06\u4E1C\u5357\u4E9A\u5730\u533A\u8FDE\u7ED3\u4E3A\u4E00\u4E2A\u80FD\u6E90\u7F51\u7EDC\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u6B64\u5916\uFF0C\u4ED6\u63D0\u5230\u7802\u62C9\u8D8A\u6B63\u5728\u5173\u6CE8\u6700\u65B0\u7684\u80FD\u6E90\u6280\u672F\uFF0C\u5305\u62EC\u5C06\u6C22\u6C14\u8F6C\u5316\u4E3A\u7532\u57FA\u73AF\u5DF1\u70F7\u7684\u6280\u672F\uFF0C\u8FD9\u4E0D\u4EC5\u53EF\u4EE5\u66FF\u4EE3\u4F20\u7EDF\u80FD\u6E90\u5982\u77F3\u6CB9\u4E0E\u6DB2\u5316\u5929\u7136\u6C14\uFF0C\u8FD8\u80FD\u4F5C\u4E3A\u672A\u6765\u7684\u80FD\u6E90\u89E3\u51B3\u65B9\u6848\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u8FD9\u9879\u6280\u672F\u5C06\u4E3A\u6211\u4EEC\u6253\u5F00\u65B0\u7684\u6536\u5165\u6765\u6E90\uFF0C\u4E5F\u4F7F\u7802\u62C9\u8D8A\u6210\u4E3A\u8BE5\u9886\u57DF\u7684\u5168\u7403\u9886\u5BFC\u8005\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u8D22\u52A1\u900F\u660E\u4E0E\u672A\u6765\u534F\u8BAE\u7B7E\u7F72\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u5F53\u88AB\u95EE\u53CA\u7802\u62C9\u8D8A\u8FD1\u671F\u7684\u8D22\u52A1\u8868\u73B0\u65F6\uFF0C\u963F\u90A6\u4F50\u54C8\u91CC\u8868\u793A\uFF0C\u5C3D\u7BA1\u8BE6\u7EC6\u6570\u636E\u5C1A\u672A\u5B8C\u5168\u62AB\u9732\uFF0C\u4F46\u7802\u62C9\u8D8A\u7684\u6536\u5165\u5DF2\u8D85\u51FA\u9884\u671F\u3002\u4ED6\u5F3A\u8C03\uFF0C\u7802\u62C9\u8D8A\u653F\u5E9C\u5C06\u7EE7\u7EED\u4FDD\u6301\u900F\u660E\uFF0C\u5E76\u5728\u9002\u5F53\u65F6\u673A\u5BA3\u5E03\u65B0\u7684\u5408\u4F5C\u534F\u8BAE\u3002\u201C\u9884\u8BA1\u5728\u658B\u6212\u6708\u524D\u540E\u4F1A\u6709\u66F4\u591A\u7EC6\u8282\u516C\u5E03\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u963F\u90A6\u4F50\u54C8\u91CC\u6700\u540E\u8868\u793A\uFF0C\u7802\u62C9\u8D8A\u5C06\u6301\u7EED\u63A8\u52A8\u521B\u65B0\u548C\u5408\u4F5C\uFF0C\u5B9E\u73B0\u53EF\u6301\u7EED\u80FD\u6E90\u7684\u76EE\u6807\uFF0C\u540C\u65F6\u4E3A\u7802\u62C9\u8D8A\u4EBA\u5E26\u6765\u66F4\u591A\u7ECF\u6D4E\u6548\u76CA\u548C\u53D1\u5C55\u673A\u4F1A\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/mTRYStUmNWeW9kPpumPE0A\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
