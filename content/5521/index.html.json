{
  "id": "%e8%81%9a%e7%84%a6%e8%bf%9b%e5%8f%a3%e9%92%a2%e7%bb%93%e6%9e%84%e6%a0%87%e5%87%86%ef%bc%9a%e4%b8%8e%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a-cidb-%e4%ba%a4%e6%b5%81%e6%8e%a2%e8%ae%a8%e4%bc%9a%e8%ae%ae",
  "slug": "%e8%81%9a%e7%84%a6%e8%bf%9b%e5%8f%a3%e9%92%a2%e7%bb%93%e6%9e%84%e6%a0%87%e5%87%86%ef%bc%9a%e4%b8%8e%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a-cidb-%e4%ba%a4%e6%b5%81%e6%8e%a2%e8%ae%a8%e4%bc%9a%e8%ae%ae",
  "canonicalUrlKey": "%e8%81%9a%e7%84%a6%e8%bf%9b%e5%8f%a3%e9%92%a2%e7%bb%93%e6%9e%84%e6%a0%87%e5%87%86%ef%bc%9a%e4%b8%8e%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a-cidb-%e4%ba%a4%e6%b5%81%e6%8e%a2%e8%ae%a8%e4%bc%9a%e8%ae%ae",
  "route": "/5521/",
  "title": "\u805A\u7126\u8FDB\u53E3\u94A2\u7ED3\u6784\u6807\u51C6\uFF1A\u4E0E\u9A6C\u6765\u897F\u4E9A CIDB \u4EA4\u6D41\u63A2\u8BA8\u4F1A\u8BAE",
  "summary": "\u8FD1\u65E5\uFF0C\u5149\u78CA\u94A2\u7ED3\u6784\u9A6C\u6765\u897F\u4E9A\u5206\u516C\u53F8\u4E0E\u9A6C\u6765\u897F\u4E9A\u5EFA\u7B51\u4E1A\u53D1\u5C55\u5C40\uFF08CIDB\uFF09\u7684\u6280\u672F\u7814\u7A76\u9662\u4E3E\u884C\u4E86\u4E00\u573A\u6DF1\u5EA6\u4EA4\u6D41\u4F1A\u3002\u53CC\u65B9\u56F4\u7ED5\u9A6C\u6765\u897F\u4E9A\u8FDB\u53E3\u94A2\u7ED3\u6784\u7684\u5177\u4F53\u8981\u6C42\u3001\u6280\u672F\u6807\u51C6\u53CA\u884C\u4E1A\u53D1\u5C55\u8D8B\u52BF\u5C55\u5F00\u4E86\u70ED\u70C8\u8BA8\u8BBA\u3002\u6B64\u6B21\u4F1A\u8BAE\u65E8\u5728\u52A0\u5F3A\u5149\u78CA\u94A2\u7ED3\u6784\u5728\u9A6C\u6765\u897F\u4E9A\u5E02\u573A\u7684\u5408\u89C4\u5316\u8FD0\u8425\uFF0C\u540C\u65F6\u4E3A\u5F53\u5730\u5EFA\u7B51\u4E1A\u63D0\u4F9B\u66F4\u9AD8\u6548\u3001\u66F4\u5B89\u5168\u7684\u94A2\u7ED3\u6784\u89E3\u51B3\u65B9\u6848\u3002 \u9A6C\u6765\u897F\u4E9A\u4F5C\u4E3A\u4E1C\u5357\u4E9A\u5730\u533A\u7ECF\u6D4E\u53D1\u5C55\u8F83\u5FEB\u7684\u56FD\u5BB6\u4E4B\u4E00\uFF0C\u8FD1\u5E74\u6765\u5728\u57FA\u7840\u8BBE\u65BD\u5EFA\u8BBE\u3001\u5DE5\u4E1A\u5382\u623F\u3001\u5546\u4E1A\u5730\u4EA7\u7B49\u9886\u57DF\u6295\u5165\u5DE8\u5927\uFF0C\u5BF9\u94A2\u7ED3\u6784\u7684\u9700\u6C42\u6301\u7EED\u589E\u957F\u3002\u7136\u800C\uFF0C\u9A6C\u6765\u897F\u4E9A\u672C\u571F\u94A2\u7ED3\u6784\u4EA7\u80FD\u6709\u9650\uFF0C\u90E8\u5206\u9AD8\u7AEF\u94A2\u7ED3\u6784\u4EA7\u54C1\u4ECD\u9700\u4F9D\u8D56\u8FDB\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2025/02/frc-1c58decb1f0e78333603a1268877bbb1.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u8FD1\u65E5\uFF0C\u5149\u78CA\u94A2\u7ED3\u6784\u9A6C\u6765\u897F\u4E9A\u5206\u516C\u53F8\u4E0E\u9A6C\u6765\u897F\u4E9A\u5EFA\u7B51\u4E1A\u53D1\u5C55\u5C40\uFF08CIDB\uFF09\u7684\u6280\u672F\u7814\u7A76\u9662\u4E3E\u884C\u4E86\u4E00\u573A\u6DF1\u5EA6\u4EA4\u6D41\u4F1A\u3002\u53CC\u65B9\u56F4\u7ED5\u9A6C\u6765\u897F\u4E9A\u8FDB\u53E3\u94A2\u7ED3\u6784\u7684\u5177\u4F53\u8981\u6C42\u3001\u6280\u672F\u6807\u51C6\u53CA\u884C\u4E1A\u53D1\u5C55\u8D8B\u52BF\u5C55\u5F00\u4E86\u70ED\u70C8\u8BA8\u8BBA\u3002\u6B64\u6B21\u4F1A\u8BAE\u65E8\u5728\u52A0\u5F3A\u5149\u78CA\u94A2\u7ED3\u6784\u5728\u9A6C\u6765\u897F\u4E9A\u5E02\u573A\u7684\u5408\u89C4\u5316\u8FD0\u8425\uFF0C\u540C\u65F6\u4E3A\u5F53\u5730\u5EFA\u7B51\u4E1A\u63D0\u4F9B\u66F4\u9AD8\u6548\u3001\u66F4\u5B89\u5168\u7684\u94A2\u7ED3\u6784\u89E3\u51B3\u65B9\u6848\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2025/02/frc-0ed835fcb58f506705e1cecf649dd167.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u4F5C\u4E3A\u4E1C\u5357\u4E9A\u5730\u533A\u7ECF\u6D4E\u53D1\u5C55\u8F83\u5FEB\u7684\u56FD\u5BB6\u4E4B\u4E00\uFF0C\u8FD1\u5E74\u6765\u5728\u57FA\u7840\u8BBE\u65BD\u5EFA\u8BBE\u3001\u5DE5\u4E1A\u5382\u623F\u3001\u5546\u4E1A\u5730\u4EA7\u7B49\u9886\u57DF\u6295\u5165\u5DE8\u5927\uFF0C\u5BF9\u94A2\u7ED3\u6784\u7684\u9700\u6C42\u6301\u7EED\u589E\u957F\u3002\u7136\u800C\uFF0C\u9A6C\u6765\u897F\u4E9A\u672C\u571F\u94A2\u7ED3\u6784\u4EA7\u80FD\u6709\u9650\uFF0C\u90E8\u5206\u9AD8\u7AEF\u94A2\u7ED3\u6784\u4EA7\u54C1\u4ECD\u9700\u4F9D\u8D56\u8FDB\u53E3\u3002\u4E3A\u786E\u4FDD\u8FDB\u53E3\u94A2\u7ED3\u6784\u7684\u8D28\u91CF\u3001\u5B89\u5168\u6027\u548C\u53EF\u6301\u7EED\u6027\uFF0C\u9A6C\u6765\u897F\u4E9A\u5EFA\u7B51\u53D1\u5C55\u5C40\u5236\u5B9A\u4E86\u4E00\u7CFB\u5217\u4E25\u683C\u7684\u6280\u672F\u6807\u51C6\u548C\u8BA4\u8BC1\u8981\u6C42\u3002\u003C/p\u003E\n\u003Cp\u003E\u5149\u78CA\u94A2\u7ED3\u6784\u4F5C\u4E3A\u4E00\u5BB6\u56FD\u9645\u94A2\u7ED3\u6784\u5236\u9020\u548C\u4F9B\u5E94\u5546\uFF0C\u59CB\u7EC8\u81F4\u529B\u4E8E\u4E3A\u5168\u7403\u5BA2\u6237\u63D0\u4F9B\u9AD8\u8D28\u91CF\u7684\u94A2\u7ED3\u6784\u4EA7\u54C1\u548C\u670D\u52A1\u3002\u6B64\u6B21\u4E0ECIDB\u6280\u672F\u7814\u7A76\u9662\u7684\u4EA4\u6D41\uFF0C\u4E0D\u4EC5\u662F\u4E3A\u4E86\u786E\u4FDD\u5149\u78CA\u94A2\u7ED3\u6784\u7684\u8FDB\u53E3\u6D41\u7A0B\u5B8C\u5168\u7B26\u5408\u9A6C\u6765\u897F\u4E9A\u7684\u6CD5\u89C4\u8981\u6C42\uFF0C\u66F4\u662F\u4E3A\u4E86\u6DF1\u5165\u4E86\u89E3\u5F53\u5730\u5E02\u573A\u7684\u6280\u672F\u9700\u6C42\uFF0C\u8FDB\u4E00\u6B65\u63D0\u5347\u4EA7\u54C1\u7ADE\u4E89\u529B\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2025/02/frc-6d9fbc7c42ccac6902ce099d394c0932.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5728\u4F1A\u8BAE\u4E0A\uFF0CCIDB\u7684\u4E13\u5BB6\u8BE6\u7EC6\u4ECB\u7ECD\u4E86\u9A6C\u6765\u897F\u4E9A\u5BF9\u8FDB\u53E3\u94A2\u7ED3\u6784\u7684\u5177\u4F53\u8981\u6C42\uFF0C\u4E3B\u8981\u5305\u62EC\u4EE5\u4E0B\u51E0\u4E2A\u65B9\u9762\uFF1A\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E1.\u6750\u6599\u6807\u51C6\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u8FDB\u53E3\u94A2\u7ED3\u6784\u6240\u4F7F\u7528\u7684\u94A2\u6750\u5FC5\u987B\u7B26\u5408\u9A6C\u6765\u897F\u4E9A\u56FD\u5BB6\u6807\u51C6\uFF08MS\u6807\u51C6\uFF09\u6216\u56FD\u9645\u901A\u7528\u6807\u51C6\uFF08\u5982ASTM\u3001EN\u7B49\uFF09\u3002\u5149\u78CA\u94A2\u7ED3\u6784\u7684\u4EA7\u54C1\u5DF2\u901A\u8FC7\u591A\u9879\u56FD\u9645\u8BA4\u8BC1\uFF0C\u5B8C\u5168\u80FD\u591F\u6EE1\u8DB3\u8FD9\u4E9B\u6807\u51C6\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E2.\u8BBE\u8BA1\u4E0E\u5236\u9020\u89C4\u8303\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u94A2\u7ED3\u6784\u7684\u5236\u9020\u548C\u8BBE\u8BA1\u9700\u7B26\u5408CIDB\u5236\u5B9A\u7684\u6280\u672F\u89C4\u8303\uFF0C\u5305\u62EC\u8282\u70B9\u8BBE\u8BA1\u3001\u710A\u63A5\u5DE5\u827A\u3001\u9632\u8150\u5904\u7406\u7B49\u3002\u5149\u78CA\u94A2\u7ED3\u6784\u5728\u5236\u9020\u8FC7\u7A0B\u4E2D\u91C7\u7528\u5148\u8FDB\u7684\u81EA\u52A8\u5316\u751F\u4EA7\u7EBF\u548C\u4E25\u683C\u7684\u8D28\u91CF\u63A7\u5236\u4F53\u7CFB\uFF0C\u786E\u4FDD\u4EA7\u54C1\u7684\u9AD8\u7CBE\u5EA6\u548C\u53EF\u9760\u6027\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E3.\u68C0\u6D4B\u4E0E\u8BA4\u8BC1\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u8FDB\u53E3\u94A2\u7ED3\u6784\u9700\u8981\u63D0\u4F9B\u7B2C\u4E09\u65B9\u68C0\u6D4B\u673A\u6784\u51FA\u5177\u7684\u8D28\u91CF\u68C0\u6D4B\u62A5\u544A\uFF0C\u5305\u62EC\u6750\u6599\u6027\u80FD\u6D4B\u8BD5\u3001\u710A\u63A5\u8D28\u91CF\u68C0\u6D4B\u3001\u6D82\u5C42\u9644\u7740\u529B\u6D4B\u8BD5\u7B49\u3002CIDB\u4E13\u5BB6\u5EFA\u8BAE\u5149\u78CA\u94A2\u7ED3\u6784\u5728\u51FA\u53E3\u524D\u4E0E\u9A6C\u6765\u897F\u4E9A\u8BA4\u53EF\u7684\u68C0\u6D4B\u673A\u6784\u5408\u4F5C\uFF0C\u786E\u4FDD\u6587\u4EF6\u9F50\u5168\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E4.\u73AF\u4FDD\u4E0E\u53EF\u6301\u7EED\u6027\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003ECIDB\u4E13\u5BB6\u5F3A\u8C03\uFF0C\u9A6C\u6765\u897F\u4E9A\u653F\u5E9C\u8D8A\u6765\u8D8A\u91CD\u89C6\u5EFA\u7B51\u6750\u6599\u7684\u73AF\u4FDD\u6027\u80FD\u3002\u5149\u78CA\u94A2\u7ED3\u6784\u5728\u751F\u4EA7\u548C\u8FD0\u8F93\u8FC7\u7A0B\u4E2D\u91C7\u7528\u7684\u7EFF\u8272\u5DE5\u827A\u548C\u4F4E\u78B3\u6280\u672F\uFF0C\u5F97\u5230\u4E86\u4ED6\u4EEC\u7684\u9AD8\u5EA6\u8BA4\u53EF\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E5.\u5B89\u88C5\u4E0E\u65BD\u5DE5\u8981\u6C42\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u8FDB\u53E3\u94A2\u7ED3\u6784\u5728\u9A6C\u6765\u897F\u4E9A\u7684\u5B89\u88C5\u548C\u65BD\u5DE5\u9700\u7B26\u5408\u5F53\u5730\u7684\u5B89\u5168\u89C4\u8303\u3002\u5149\u78CA\u94A2\u7ED3\u6784\u8868\u793A\uFF0C\u5C06\u63D0\u4F9B\u4E13\u4E1A\u7684\u6280\u672F\u652F\u6301\u548C\u57F9\u8BAD\uFF0C\u534F\u52A9\u5F53\u5730\u5408\u4F5C\u4F19\u4F34\u5B8C\u6210\u9AD8\u8D28\u91CF\u7684\u5B89\u88C5\u5DE5\u4F5C\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2025/02/frc-3b6b05aeee1a01e653b430876833cb87.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u4F1A\u8BAE\u73B0\u573A\u2014\u2014\u62CD\u6444\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2025/02/frc-2718e82c846e690de5e37b9e0eb91b61.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u4F1A\u8BAE\u73B0\u573A\u2014\u2014\u62CD\u6444\u003C/p\u003E\n\u003Cp\u003E\u5149\u78CA\u94A2\u7ED3\u6784\u9A6C\u6765\u897F\u4E9A\u5206\u516C\u53F8\u8D1F\u8D23\u4EBA\u5728\u4F1A\u4E0A\u8868\u793A\uFF0C\u516C\u53F8\u59CB\u7EC8\u5C06\u6280\u672F\u521B\u65B0\u548C\u5BA2\u6237\u6EE1\u610F\u5EA6\u653E\u5728\u9996\u4F4D\u3002\u901A\u8FC7\u6B64\u6B21\u4EA4\u6D41\uFF0C\u5149\u78CA\u94A2\u7ED3\u6784\u5C06\u8FDB\u4E00\u6B65\u4F18\u5316\u4EA7\u54C1\u8BBE\u8BA1\u3001\u5236\u9020\u6D41\u7A0B\u548C\u552E\u540E\u670D\u52A1\uFF0C\u786E\u4FDD\u4E3A\u9A6C\u6765\u897F\u4E9A\u5BA2\u6237\u63D0\u4F9B\u7B26\u5408\u56FD\u9645\u6807\u51C6\u7684\u9AD8\u54C1\u8D28\u94A2\u7ED3\u6784\u4EA7\u54C1\u3002\u003C/p\u003E\n\u003Cp\u003E\u5149\u78CA\u94A2\u7ED3\u6784\u5C06\u7EE7\u7EED\u79C9\u6301\u201C\u575A\u5B88\u5320\u5FC3\u3001\u94F8\u9020\u7CBE\u54C1\u94A2\u6784\u201D\u7684\u7406\u5FF5\uFF0C\u4E3A\u9A6C\u6765\u897F\u4E9A\u4E43\u81F3\u5168\u7403\u5BA2\u6237\u63D0\u4F9B\u66F4\u4F18\u8D28\u7684\u4EA7\u54C1\u548C\u670D\u52A1\uFF0C\u52A9\u529B\u5EFA\u7B51\u884C\u4E1A\u8FC8\u5411\u66F4\u52A0\u7EFF\u8272\u3001\u667A\u80FD\u7684\u672A\u6765\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2025/02/frc-eaca2d71e8992fc6da53674ad5da06fd.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/-hrznLI6XN_5kITU1k5qfA\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
