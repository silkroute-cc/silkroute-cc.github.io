{
  "id": "30%e4%bd%9b%e5%b1%b1%e4%bc%81%e4%b8%9a%e6%9d%a5%e9%a9%ac%e4%ba%a4%e6%b5%81%e3%80%80%e7%a7%af%e6%9e%81%e4%b8%8e%e5%a4%a7%e9%a9%ac%e4%bc%81%e4%b8%9a%e5%85%b1%e8%a7%85%e6%96%b0%e5%95%86%e6%9c%ba",
  "slug": "30%e4%bd%9b%e5%b1%b1%e4%bc%81%e4%b8%9a%e6%9d%a5%e9%a9%ac%e4%ba%a4%e6%b5%81%e3%80%80%e7%a7%af%e6%9e%81%e4%b8%8e%e5%a4%a7%e9%a9%ac%e4%bc%81%e4%b8%9a%e5%85%b1%e8%a7%85%e6%96%b0%e5%95%86%e6%9c%ba",
  "canonicalUrlKey": "30%e4%bd%9b%e5%b1%b1%e4%bc%81%e4%b8%9a%e6%9d%a5%e9%a9%ac%e4%ba%a4%e6%b5%81%e3%80%80%e7%a7%af%e6%9e%81%e4%b8%8e%e5%a4%a7%e9%a9%ac%e4%bc%81%e4%b8%9a%e5%85%b1%e8%a7%85%e6%96%b0%e5%95%86%e6%9c%ba",
  "route": "/4253/",
  "title": "30\u4F5B\u5C71\u4F01\u4E1A\u6765\u9A6C\u4EA4\u6D41\u3000\u79EF\u6781\u4E0E\u5927\u9A6C\u4F01\u4E1A\u5171\u89C5\u65B0\u5546\u673A",
  "summary": "\uFF08\u6C5D\u676530\u65E5\u8BAF \uFF09\u4F5B\u5C71\u5E02\u653F\u534F\u5E26\u988630\u540D\u4F5B\u5C71\u4F01\u4E1A\u5BB6\u6765\u9A6C\uFF0C\u53C2\u4E0E\u7531\u5728\u9A6C\u6765\u897F\u4E9A\u4F5B\u5C71\u603B\u5546\u4F1A\u4E3E\u529E\u7684\u201C\u4E2D\u56FD\uFF08\u4F5B\u5C71\uFF09\u2014\u9A6C\u6765\u897F\u4E9A\u7ECF\u8D38\u4EA4\u6D41\u6D3D\u8C08\u4F1A\u201D\uFF0C\u4E0E\u6211\u56FD\u4F01\u4E1A\u5BB6\u5171\u89C5\u65B0\u5546\u673A\u3002 \u5728\u4EA4\u6D41\u6D3D\u8C08\u4F1A\u4E0A\uFF0C\u6765\u81EA\u4F5B\u5C71\u7684\u4F01\u4E1A\u4E5F\u4E0E\u6211\u56FD\u4F01\u4E1A\u7B7E\u7F72\u610F3\u4EFD\u610F\u5411\u4E66\uFF0C\u5305\u62EC\u300A\u8FDB\u53E3\u9A6C\u6765\u897F\u4E9A\u732B\u5C71\u738B\u69B4\u68BF\u300B\u610F\u5411\u4E66\u3001\u300A\u51FA\u53E3\u4F5B\u5C71\u5EFA\u7B51\u6750\u6599\u300B\u610F\u5411\u4E66\uFF0C\u4EE5\u53CA\u4E0E\u9A6C\u6765\u897F\u4E9A\u4F76\u5E1D\u96C6\u56E2\u7B7E\u7F72\u7684\u300A\u9A6C\u6765\u897F\u4E9A\u2014\u4F5B\u5C71\u4EA7\u4E1A\u56ED\u5171\u540C\u53D1\u5C55\u9879\u76EE\u300B\u610F\u5411\u4E66\u3002 \u9A6C\u6765\u897F\u4E9A\u2014\u4F5B\u5C71\u603B\u5546\u4F1A\u603B\u4F1A\u957F\u53F6\u7ECD\u5168\u6307\u51FA\uFF0C\u672A\u6765\u5728\u5BFB\u627E\u65B0\u5546\u673A\u4E0A\uFF0C\u5C06\u4F1A\u7531\u5408\u4F5C\u53D6\u4EE3\u7ADE\u4E89\uFF0C\u5373\u62B1\u56E2\u8D70\u5411\u4E16\u754C\uFF0C\u6240\u4EE5\u5E0C\u671B\u6709\u66F4\u591A\u5927\u9A6C\u4F01\u4E1A\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/12/frc-0229ffd2bca4bb55ff74ea24a6a377b2.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\uFF08\u6C5D\u676530\u65E5\u8BAF \uFF09\u4F5B\u5C71\u5E02\u653F\u534F\u5E26\u988630\u540D\u4F5B\u5C71\u4F01\u4E1A\u5BB6\u6765\u9A6C\uFF0C\u53C2\u4E0E\u7531\u5728\u9A6C\u6765\u897F\u4E9A\u4F5B\u5C71\u603B\u5546\u4F1A\u4E3E\u529E\u7684\u201C\u4E2D\u56FD\uFF08\u4F5B\u5C71\uFF09\u2014\u9A6C\u6765\u897F\u4E9A\u7ECF\u8D38\u4EA4\u6D41\u6D3D\u8C08\u4F1A\u201D\uFF0C\u4E0E\u6211\u56FD\u4F01\u4E1A\u5BB6\u5171\u89C5\u65B0\u5546\u673A\u3002\u003C/p\u003E\n\u003Cp\u003E\u5728\u4EA4\u6D41\u6D3D\u8C08\u4F1A\u4E0A\uFF0C\u6765\u81EA\u4F5B\u5C71\u7684\u4F01\u4E1A\u4E5F\u4E0E\u6211\u56FD\u4F01\u4E1A\u7B7E\u7F72\u610F3\u4EFD\u610F\u5411\u4E66\uFF0C\u5305\u62EC\u300A\u8FDB\u53E3\u9A6C\u6765\u897F\u4E9A\u732B\u5C71\u738B\u69B4\u68BF\u300B\u610F\u5411\u4E66\u3001\u300A\u51FA\u53E3\u4F5B\u5C71\u5EFA\u7B51\u6750\u6599\u300B\u610F\u5411\u4E66\uFF0C\u4EE5\u53CA\u4E0E\u9A6C\u6765\u897F\u4E9A\u4F76\u5E1D\u96C6\u56E2\u7B7E\u7F72\u7684\u300A\u9A6C\u6765\u897F\u4E9A\u2014\u4F5B\u5C71\u4EA7\u4E1A\u56ED\u5171\u540C\u53D1\u5C55\u9879\u76EE\u300B\u610F\u5411\u4E66\u3002\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u2014\u4F5B\u5C71\u603B\u5546\u4F1A\u603B\u4F1A\u957F\u53F6\u7ECD\u5168\u6307\u51FA\uFF0C\u672A\u6765\u5728\u5BFB\u627E\u65B0\u5546\u673A\u4E0A\uFF0C\u5C06\u4F1A\u7531\u5408\u4F5C\u53D6\u4EE3\u7ADE\u4E89\uFF0C\u5373\u62B1\u56E2\u8D70\u5411\u4E16\u754C\uFF0C\u6240\u4EE5\u5E0C\u671B\u6709\u66F4\u591A\u5927\u9A6C\u4F01\u4E1A\u8D70\u8FDB\u4E2D\u56FD\uFF0C\u540C\u65F6\u6709\u66F4\u591A\u4E2D\u56FD\u4F01\u4E1A\u8D70\u51FA\u4E16\u754C\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6628\u65E5\u4E3A\u4EA4\u6D41\u6D3D\u8C08\u4F1A\u81F4\u8BCD\u65F6\u6307\u51FA\uFF0C\u672A\u6765\u54EA\u6015\u662F\u4E16\u754C\u7B2C\u4E00\u6216\u7B2C\u4E8C\u5927\u5F3A\u56FD\uFF0C\u82E5\u5355\u6253\u72EC\u6597\u662F\u975E\u5E38\u8F9B\u82E6\uFF0C\u552F\u4E00\u7684\u65B9\u5F0F\u5C31\u662F\u5408\u4F5C\u8D70\u51FA\u6765\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u4F5B\u5C71\u5E02\u4E00\u4E2A\u4F5B\u5C71\u662F\u5236\u9020\u5927\u57CE\u5E02\uFF0C\u5EFA\u6750\u5728\u4E16\u754C\u5360\u6709\u7EA630%\u6BD4\u4F8B\uFF0C\u4F5B\u5C71\u751F\u4EA7\u603B\u503C\uFF08GDP\uFF09\u5C31\u8D85\u8FC71\u4E07\u4EBF\u4EBA\u6C11\u5E01\uFF08\u7EA66548\u4EBF9817\u4E07\u4EE4\u5409\uFF09\u3002\u800C\u9A6C\u6765\u897F\u4E9A\u6709\u5F88\u591A\u5546\u673A\uFF0C\u53EF\u4F9B\u4F5B\u5C71\u4F01\u4E1A\u53C2\u4E0E\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u4F5B\u5C71\u4F01\u4E1A\u5728\u75AB\u60C5\u548C\u8425\u5546\u73AF\u5883\u6539\u53D8\u540E\uFF0C\u90FD\u6709\u4E86\u4E0D\u80FD\u4EC5\u9760\u4E2D\u56FD\u56FD\u5185\u5E02\u573A\u7684\u60F3\u6CD5\uFF0C\u53CD\u4E4B\u662F\u8BBE\u6CD5\u8D70\u51FA\u4E16\u754C\u3002\u57FA\u4E8E\u4E2D\u56FD\u548C\u6D77\u5916\u7ECF\u8425\u6A21\u5F0F\u6709\u522B\uFF0C\u4F5B\u5C71\u4F01\u4E1A\u4E5F\u5180\u627E\u5230\u4E86\u89E3\u4E2D\u56FD\u6587\u5316\u548C\u4E16\u754C\u5E02\u573A\u7684\u4F01\u4E1A\u5408\u4F5C\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u5927\u9A6C\u6709\u8BB8\u591A\u4EBA\u90FD\u5E0C\u671B\u4E0E\u4E2D\u56FD\u5408\u4F5C\uFF0C\u56E0\u4E3A\u4E2D\u56FD\u4F01\u4E1A\u5F3A\u5728\u638C\u63E1\u4F4E\u6210\u672C\u548C\u7814\u53D1\uFF0C\u800C\u5927\u9A6C\u4F01\u4E1A\u5BB6\u5219\u662F\u4E16\u754C\u4E13\u624D\u80FD\u638C\u63E1\u591A\u79CD\u8BED\u8A00\u3002\u82E5\u53CC\u65B9\u7ED3\u5408\u4F18\u52BF\uFF0C\u6709\u52A9\u4E2D\u56FD\u8D70\u5411\u4E16\u754C\u3002\u201D\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/12/frc-cdd7fa22a3ab422e6f3f7e0af3485d75.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u53F6\u7ECD\u5168\u7EED\u8BF4\uFF0C\u5927\u9A6C\u662F\u552F\u4E00\u8BA9\u4E2D\u56FD\u514D\u7B7E\u7684\u4E9A\u6D32\u56FD\u5BB6\uFF0C\u56E0\u6B64\u5927\u9A6C\u5C06\u8FCE\u6765\u5E9E\u5927\u5546\u673A\uFF0C\u5927\u9A6C\u4F01\u4E1A\u5BB6\u8981\u505A\u597D\u51C6\u5907\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6307\u51FA\uFF0C\u4E2D\u7F8E\u8D38\u6613\u6218\u63D0\u9192\u4E2D\u56FD\u4F01\u4E1A\u4E0D\u8981\u628A\u9E21\u86CB\u653E\u5728\u4E00\u4E2A\u7BEE\u5B50\uFF0C\u56E0\u6B64\u624D\u6709\u5927\u91CF\u4E2D\u56FD\u4F01\u4E1A\u5728\u5176\u4ED6\u56FD\u5BB6\u8BBE\u6709\u57FA\u5730\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u800C\u5BF9\u4E8E\u4F5B\u5C71\u4F01\u4E1A\u800C\u8A00\uFF0C\u800C\u9A6C\u6765\u897F\u4E9A\u662F\u6700\u597D\u9009\u62E9\uFF0C\u9664\u53EF\u89E3\u51B3\u7F8E\u56FD\u53CD\u503E\u9500\uFF0C\u8FD8\u53EF\u628A\u5E02\u573A\u6269\u5C55\u81F357\u4E2A\u4F0A\u65AF\u5170\u56FD\u5BB6\uFF0C\u4EE5\u53CA\u8FDB\u5165\u5370\u5C3C\u548C\u5370\u5EA6\u4E24\u4E2A\u5E9E\u5927\u5E02\u573A\uFF0C\u5728\u5927\u9A6C\u4E5F\u66F4\u6613\u627E\u5230\u901A\u5F80\u4E16\u754C\u7684\u4EBA\u624D\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4F5B\u5C71\u5E02\u8FDB\u51FA\u53E3\u5546\u4F1A\u4F1A\u957F\u4E25\u56FD\u5C71\u5219\u8BF4\uFF0C\u5728\u4E1C\u76DF10\u56FD\u4E2D\uFF0C\u5927\u9A6C\u7684\u7279\u6B8A\u5730\u7406\u4F4D\u7F6E\u5BF9\u4E2D\u56FD\u6216\u4F5B\u5C71\u90FD\u6709\u91CD\u8981\u610F\u4E49\u3002\u53BB\u5E74\uFF0C\u4F5B\u5C71\u5728\u4E1C\u76DF\u8FDB\u51FA\u53E3\u603B\u989D\u8FBE 1400\u4EBF\u4EBA\u6C11\u5E01\uFF08\u7EA6915\u4EBF2879\u4E07\u4EE4\u5409\uFF09\uFF0C\u540C\u6BD4\u589E\u957F33%\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u4E1C\u76DF\u5DF2\u6210\u4E3A\u4F5B\u5C71\u8FDB\u51FA\u53E3\u7B2C\u4E00\u5927\u5E02\u573A\uFF0C\u800C\u53BB\u5E74\u4F5B\u5728\u9A6C\u6765\u897F\u4E9A\u7684\u8FDB\u51FA\u53E3\u603B\u989D\u8FBE\u5230\u903E300\u4EBF\u4EBA\u6C11\u5E01\uFF08\u7EA6196\u4EBF1421\u4E07\u4EE4\u5409\uFF09\uFF0C\u800C\u4ECA\u5E74\u81F39\u6708\u5219\u8FBE\u5230319\u4EBF\u4EBA\u6C11\u5E01\uFF08208\u4EBF4636\u4E07\u4EE4\u5409\uFF09\uFF0C\u5C1A\u672A\u52A0\u5165\u4ECA\u5E74\u9980\u4E0B\u7684\u6708\u4EFD\uFF0C\u6240\u4EE5\u53EF\u4EE5\u60F3\u50CF\u4ECA\u5E74\u7684\u589E\u957F\u662F\u6BD4\u8F83\u53EF\u89C2\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u9A6C\u4E2D\u4E92\u76F8\u514D\u7B7E\u8BC1\u5229\u597D\u7684\u53E0\u52A0\uFF0C\u672A\u6765\u4E24\u56FD\u7ECF\u8D38\u7684\u5408\u4F5C\u80AF\u5B9A\u80FD\u7FFB\u770B\u65B0\u4E00\u9875\uFF0C\u4F7F\u4E2D\u56FD\u5BF9\u5916\u8D38\u4F1A\u6709\u65B0\u63D0\u5347\uFF0C\u4EE5\u53CA\u9AD8\u8D28\u91CF\u5916\u8D38\u53D1\u5C55\u80FD\u8FBE\u5230\u9884\u671F\u76EE\u6807\u3002\u003C/p\u003E\n\u003Cp\u003E\u51FA\u5E2D\u4EA4\u6D41\u6D3D\u8C08\u4F1A\u7684\u8FD8\u6709\u4F5B\u5C71\u5E02\u653F\u534F\u526F\u4E3B\u5E2D\u5F20\u5175\u3001\u4F5B\u5C71\u5E02\u5546\u52A1\u5C40\u526F\u5C40\u957F\u9EC4\u94C1\u3001\u4F5B\u5C71\u5E02\u8FDB\u51FA\u53E3\u5546\u4F1A \u8363\u8A89\u4F1A\u957F\u9648\u8000\u7136\u3001\u6267\u884C\u4F1A\u957F\u517C\u79D8\u4E66\u957F\u8521\u4F1F\u751F\u3001\u68EE\u7F8E\u5170\u5DDE\u884C\u653F\u8BAE\u5458\u5F20\u8052\u7FD4\u3001\u68EE\u7F8E\u5170\u6295\u8D44\u673A\u6784\u603B\u6267\u884C\u957F\u62FF\u7763\u7EB3\u57FA\u6155\u4E01\u6C99\u91CC\u592B\u3001\u9A6C\u6765\u897F\u4E9A\u2014\u4F5B\u5C71\u603B\u5546\u4F1A\u526F\u603B\u4F1A\u957F\u62FF\u7763\u6C5F\u534E\u5F3A\u3001\u4E2D\u592E\u7406\u4E8B\u62FF\u7763\u9EC4\u5723\u680B\u003C/p\u003E\n\u003Cp\u003ENCM \u96C6\u56E2\u6267\u884C\u4E3B\u5E2D\u62FF\u7763\u6768\u5FE0\u826F\u4EE5\u53CA\u9A6C\u6765\u897F\u4E9A\u534E\u4EBA\u59D3\u6C0F\u603B\u4F1A\u8054\u5408\u4F1A\u521B\u4F1A\u8363\u8A89\u603B\u4F1A\u957F\u62FF\u7763\u65AF\u91CC\u6D2A\u6765\u559C\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/dM9BEBUMwk6agLYWJu8NjA\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
