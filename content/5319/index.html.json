  "canonicalUrlKey": "%e7%a0%94%e7%a9%b6%e6%a0%b8%e7%94%b5%e6%9b%bf%e4%bb%a3%e5%8f%af%e8%a1%8c%e6%80%a7-%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e6%94%bf%e5%ba%9c%e4%bf%9d%e8%af%81%e6%a0%b8%e7%94%b5%e5%86%b3%e7%ad%96%e4%bc%9a",
  "route": "/5319/",
  "title": "\u7814\u7A76\u6838\u7535\u66FF\u4EE3\u53EF\u884C\u6027 \u9A6C\u6765\u897F\u4E9A\u653F\u5E9C\u4FDD\u8BC1\u6838\u7535\u51B3\u7B56\u4F1A\u614E\u91CD\u8003\u8651",
  "summary": "\uFF08\u5409\u9686\u576111\u65E5\u8BAF\uFF09\u526F\u9996\u76F8\u517C\u80FD\u6E90\u53CA\u6C34\u52A1\u8F6C\u578B\u90E8\u957F\u62FF\u7763\u65AF\u91CC\u6CD5\u8FEA\u62C9\u4FDD\u8BC1\uFF0C\u653F\u5E9C\u5728\u505A\u51FA\u4EFB\u4F55\u6709\u5173\u6838\u7535\u53D1\u5C55\u51B3\u7B56\u524D\uFF0C\u90FD\u4F1A\u614E\u91CD\u8003\u8651\u3002 \u4ED6\u8BF4\uFF0C\u6838\u7535\u662F\u80FD\u591F\u6EE1\u8DB3\u9884\u671F\u7535\u529B\u9700\u6C42\u6FC0\u589E\u7684\u6E05\u6D01\u80FD\u6E90\u4E4B\u4E00\uFF0C\u5C24\u5176\u662F\u5DE5\u4E1A\u3001\u6570\u636E\u4E2D\u5FC3\u548C\u7535\u52A8\u6C7D\u8F66\u7684\u9700\u6C42\uFF0C\u8FD9\u4E9B\u9886\u57DF\u9700\u8981\u7A33\u5B9A\u4E14\u5177\u6709\u7ECF\u6D4E\u7ADE\u4E89\u529B\u7684\u7535\u529B\u4F9B\u5E94\uFF0C\u540C\u65F6\u9884\u8BA1\u52302035\u5E74\uFF0C\u7164\u70AD\u53D1\u7535\u7684\u57FA\u8377\u7535\u529B\u5C06\u5927\u5E45\u4E0B\u964D\u3002 \u4ED6\u5411\u9A6C\u65B0\u793E\u8BF4\uFF0C\u80FD\u6E90\u90E8\u901A\u8FC7\u5176\u7279\u6B8A\u76EE\u7684\u673A\u6784\u5927\u9A6C\u7535\u529B\u673A\u6784\uFF08MyPower Corp\uFF09\u5C55\u5F00\u4E00\u9879\u53EF\u884C\u6027\u7814\u7A76\uFF0C\u5176\u4E2D\u5305\u62EC\u5BA1\u67E5\u6700\u65B0\u7684\u6838\u6280\u672F\uFF0C\u5E76\u91CD\u65B0\u5BA1\u89C6\u5927\u9A6C\u6838\u80FD\u673A\u6784\uFF08MNPC\uFF09\u57282018\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/11/frc-594358d27f31d44e2203df2115d1091f.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\uFF08\u5409\u9686\u576111\u65E5\u8BAF\uFF09\u526F\u9996\u76F8\u517C\u80FD\u6E90\u53CA\u6C34\u52A1\u8F6C\u578B\u90E8\u957F\u62FF\u7763\u65AF\u91CC\u6CD5\u8FEA\u62C9\u4FDD\u8BC1\uFF0C\u653F\u5E9C\u5728\u505A\u51FA\u4EFB\u4F55\u6709\u5173\u6838\u7535\u53D1\u5C55\u51B3\u7B56\u524D\uFF0C\u90FD\u4F1A\u614E\u91CD\u8003\u8651\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u6838\u7535\u662F\u80FD\u591F\u6EE1\u8DB3\u9884\u671F\u7535\u529B\u9700\u6C42\u6FC0\u589E\u7684\u6E05\u6D01\u80FD\u6E90\u4E4B\u4E00\uFF0C\u5C24\u5176\u662F\u5DE5\u4E1A\u3001\u6570\u636E\u4E2D\u5FC3\u548C\u7535\u52A8\u6C7D\u8F66\u7684\u9700\u6C42\uFF0C\u8FD9\u4E9B\u9886\u57DF\u9700\u8981\u7A33\u5B9A\u4E14\u5177\u6709\u7ECF\u6D4E\u7ADE\u4E89\u529B\u7684\u7535\u529B\u4F9B\u5E94\uFF0C\u540C\u65F6\u9884\u8BA1\u52302035\u5E74\uFF0C\u7164\u70AD\u53D1\u7535\u7684\u57FA\u8377\u7535\u529B\u5C06\u5927\u5E45\u4E0B\u964D\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u5411\u9A6C\u65B0\u793E\u8BF4\uFF0C\u80FD\u6E90\u90E8\u901A\u8FC7\u5176\u7279\u6B8A\u76EE\u7684\u673A\u6784\u5927\u9A6C\u7535\u529B\u673A\u6784\uFF08MyPower Corp\uFF09\u5C55\u5F00\u4E00\u9879\u53EF\u884C\u6027\u7814\u7A76\uFF0C\u5176\u4E2D\u5305\u62EC\u5BA1\u67E5\u6700\u65B0\u7684\u6838\u6280\u672F\uFF0C\u5E76\u91CD\u65B0\u5BA1\u89C6\u5927\u9A6C\u6838\u80FD\u673A\u6784\uFF08MNPC\uFF09\u57282018\u5E74\u89E3\u6563\u524D\u5B8C\u6210\u7684\u7814\u7A76\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u4EEC\u4E5F\u7814\u7A76\u548C\u5E73\u5229\u7528\u6838\u80FD\u7684\u516C\u7EA6\u3001\u5B89\u5168\u3001\u4FDD\u969C\u6761\u4F8B\u53CA\u5229\u76CA\u76F8\u5173\u8005\u7684\u8003\u91CF\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u201C\u8FD9\u9879\u7814\u7A76\u5C06\u4E3A\u653F\u5E9C\u63D0\u4F9B\u6709\u5173\u6838\u7535\u4F5C\u4E3A\u53D1\u7535\u66FF\u4EE3\u71C3\u6599\u7684\u53EF\u884C\u6027\u5EFA\u8BAE\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u6CD5\u8FEA\u62C9\u63D0\u5230\uFF0C\u6709\u5173\u7814\u7A76\u5C06\u63A2\u8BA8\u9002\u5408\u9A6C\u6765\u897F\u4E9A\u7684\u6838\u6280\u672F\uFF0C\u5305\u62EC\u5C0F\u578B\u6A21\u5757\u5316\u53CD\u5E94\u5806\uFF08SMR\uFF09\uFF0C\u56E0\u4E3A\u521D\u6B21\u6D89\u8DB3\u6838\u80FD\u7684\u56FD\u5BB6\u901A\u5E38\u503E\u5411\u4E8E\u9009\u62E9\u7ECF\u8FC7\u9A8C\u8BC1\u7684\u6838\u7535\u6280\u672F\uFF0C\u8FD9\u4E9B\u6280\u672F\u5177\u6709\u4E0E\u56FD\u9645\u6700\u4F73\u5B9E\u8DF5\u76F8\u4E00\u81F4\u7684\u826F\u597D\u8FD0\u884C\u8BB0\u5F55\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u5C3D\u7BA1\u5982\u6B64\uFF0C\u6280\u672F\u8BC4\u4F30\u6D89\u53CA\u591A\u4E2A\u65B9\u9762\uFF0C\u5C24\u5176\u662F\u7535\u529B\u9700\u6C42\u7684\u89C4\u6A21\u548C\u7C7B\u578B\u3001\u5F00\u53D1\u8D44\u672C\u6210\u672C\u3001\u8FD0\u8425\u8003\u91CF\u3001\u98CE\u9669\u3001\u9009\u5740\u7B49\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u6CD5\u8FEA\u62C9\u6307\u51FA\uFF0C\u76EE\u524D\u5C1A\u672A\u8BBE\u5B9A\u6838\u7535\u5728\u80FD\u6E90\u7ED3\u6784\u4E2D\u6240\u5360\u6BD4\u4F8B\u7684\u5177\u4F53\u76EE\u6807\uFF0C\u56E0\u4E3A\u5FC5\u987B\u5148\u5236\u5B9A\u6838\u7535\u653F\u7B56\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u5C3D\u7BA1\u5982\u6B64\uFF0C\u7814\u7A76\u8303\u56F4\u4E4B\u4E00\u662F\u786E\u5B9A\u5728\u80FD\u6E90\u7ED3\u6784\u4E2D\u6838\u7535\u7684\u5408\u9002\u6570\u91CF\u3002\u8FD8\u6709\u6570\u4E2A\u56E0\u7D20\u9700\u8981\u8003\u8651\uFF0C\u5305\u62EC\u63D0\u4F9B\u57FA\u8377\u4F9B\u5E94\u3001\u53EF\u53D8\u53EF\u518D\u751F\u80FD\u6E90\u7684\u8865\u5145\u3001\u5DE5\u4E1A\u7528\u9014\u6216\u4F5C\u4E3A\u5FAE\u7535\u7F51\u6216\u519C\u6751\u7535\u6C14\u5316\u65B9\u6848\u7684\u4E00\u90E8\u5206\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8865\u5145\uFF0C\u80FD\u6E90\u7ED3\u6784\u7684\u591A\u6837\u5316\u53D6\u51B3\u4E8E\u5176\u4ED6\u80FD\u6E90\u7684\u53EF\u7528\u6027\u548C\u53EF\u9760\u6027\u3001\u5F00\u53D1\u65F6\u95F4\u6846\u67B6\u548C\u5404\u9009\u9879\u7684\u6210\u672C\u3002\u003C/p\u003E\n\u003Cp\u003E\u6CD5\u8FEA\u62C9\u89E3\u91CA\uFF0C\u8FD9\u4E9B\u56E0\u7D20\u5728\u7535\u529B\u89C4\u5212\u4E2D\u8FDB\u884C\u5168\u9762\u8BC4\u4F30\uFF0C\u4EE5\u786E\u5B9A\u9002\u5408\u9A6C\u6765\u897F\u4E9A\u9700\u6C42\u7684\u6700\u4F73\u80FD\u6E90\u7ED3\u6784\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u4F8B\u5982\u6CD5\u56FD\u7684\u6838\u7535\u5360\u5176\u80FD\u6E90\u7EC4\u5408\u7684\u7EA670%\uFF0C\u745E\u5178\u7EA6\u536030%\u3002\u76F8\u6BD4\u4E4B\u4E0B\uFF0C\u4E2D\u56FD\u7684\u6BD4\u4F8B\u4E3A5.0%\uFF0C\u8FD1\u671F\u76EE\u6807\u662F 10%\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u201C\u5728\u4E00\u4E9B\u65B0\u8FD1\u53D1\u5C55\u6838\u7535\u7684\u56FD\u5BB6\uFF0C\u5982\u963F\u8054\u914B\uFF0C\u6838\u7535\u5360\u8BE5\u56FD\u7535\u529B\u9700\u6C42\u768425%\uFF0C\u5B5F\u52A0\u62C9\u9884\u8BA1\u5176\u9996\u5EA7\u6838\u7535\u7AD9\u7684\u8D21\u732E\u4E3A12%\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u5728\u7F8E\u56FD\uFF0C\u8001\u65E7\u548C\u505C\u7528\u7684\u71C3\u7164\u7535\u5382\u6B63\u5728\u88AB\u6539\u9020\u4E3A\u592A\u9633\u80FD\u3001\u7535\u6C60\u53CA\u5176\u4ED6\u53EF\u518D\u751F\u80FD\u6E90\u9879\u76EE\uFF0C\u90E8\u5206\u539F\u56E0\u662F\u5176\u73B0\u6709\u7684\u7535\u7F51\u8FDE\u63A5\u5177\u6709\u91CD\u8981\u4EF7\u503C\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u9A6C\u6765\u897F\u4E9A\u5DF2\u7ECF\u5236\u5B9A\u4E86\u9010\u6B65\u6DD8\u6C70\u71C3\u7164\u7535\u5382\u7684\u8BA1\u5212\uFF0C\u76EE\u6807\u57282035\u5E74\u524D\u5C06\u5176\u4EFD\u989D\u51CF\u5C11\u81F350%\uFF0C\u5E76\u57282044\u5E74\u524D\u5B8C\u5168\u6DD8\u6C70\uFF0C\u4E0D\u8FC7\u4E00\u4E9B\u8BA1\u5212\u57282030\u5E74\u524D\u9000\u5F79\u7684\u71C3\u7164\u7535\u5382\uFF08CFPPs\uFF09\u53EF\u80FD\u4F1A\u901A\u8FC7\u6539\u7528\u5929\u7136\u6C14\uFF0C\u4EE5\u6EE1\u8DB3\u5FEB\u901F\u589E\u957F\u7684\u7535\u529B\u9700\u6C42\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u89E3\u91CA\uFF0C\u8FD9\u8FC7\u6E21\u63AA\u65BD\u5C06\u6539\u5584\u6574\u4F53\u6E29\u5BA4\u6C14\u4F53\u6392\u653E\u5F3A\u5EA6\uFF0C\u56E0\u4E3A\u71C3\u6C14\u7535\u5382\u6BD4\u71C3\u7164\u7535\u5382\u6548\u7387\u66F4\u9AD8\uFF0C\u6BCF\u5355\u4F4D\u53D1\u7535\u6240\u6392\u653E\u7684\u78B3\u7EA6\u4E3A\u71C3\u7164\u7535\u5382\u7684\u4E00\u534A\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u5F3A\u8C03\uFF0C\u76EE\u524D\u6CA1\u6709\u8BA1\u5212\u5C06\u9000\u5F79\u7684CFPPs\u6539\u5EFA\u4E3A\u6838\u7535\u5382\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u636E\u62A5\u544A\u663E\u793A\uFF0C\u65B0\u6838\u7535\u5382\u53EF\u4EE5\u8282\u7701\u9AD8\u8FBE35%\u5EFA\u8BBE\u6210\u672C\uFF0C\u5177\u4F53\u53D6\u51B3\u4E8E\u73B0\u6709\u573A\u5730\u8D44\u4EA7\u7684\u9002\u7528\u6027\uFF08\u5305\u62EC\u7535\u7F51\u8FDE\u63A5\uFF09\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u201C\u7136\u800C\uFF0C\u4F5C\u4E3A\u4E00\u822C\u89C4\u5219\uFF0C\u4EFB\u4F55CFPP\u7684\u6539\u5EFA\u5FC5\u987B\u5B8C\u5168\u7B26\u5408\u56FD\u5BB6\u6CD5\u89C4\u3001\u56FD\u9645\u6807\u51C6\u53CA\u5DE5\u4E1A\u6700\u4F73\u5B9E\u8DF5\uFF0C\u5C24\u5176\u662F\u5728\u5B89\u5168\u3001\u73AF\u5883\u4FDD\u62A4\u548C\u6838\u5B89\u5168\u65B9\u9762\uFF0C\u4EE5\u786E\u4FDD\u8D1F\u8D23\u4EFB\u4E14\u6709\u97E7\u6027\u7684\u80FD\u6E90\u8F6C\u578B\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u6CD5\u8FEA\u62C9\u8BF4\uFF0C\u6F5C\u5728\u7684\u6539\u5EFA\u573A\u5730\u8BC4\u4F30\u5C06\u662F\u6838\u7535\u5382\u9009\u5740\u7A0B\u5E8F\u7684\u4E00\u90E8\u5206\u3002\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u5728\u6838\u80FD\u4E13\u4E1A\u65B9\u9762\u6709\u575A\u5B9E\u57FA\u7840\uFF0C\u5B83\u5DF2\u5B89\u5168\u8FD0\u8425\u6838\u7814\u7A76\u53CD\u5E94\u5806\u8D85\u8FC740\u5E74\uFF0C\u62E5\u6709\u5927\u578B\u9AD8\u8F90\u5C04\u5DE5\u4E1A\u706D\u83CC\u8BBE\u65BD\uFF0C\u5E76\u6709\u6548\u7BA1\u7406\u4F4E\u6C34\u5E73\u653E\u5C04\u6027\u5E9F\u6599\u3002\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u539F\u5B50\u80FD\u5C40\u4E0E\u5927\u9A6C\u6838\u80FD\u673A\u6784\u7B49\u6280\u672F\u652F\u6301\u7EC4\u7EC7\u5728\u56FD\u9645\u4E0A\u88AB\u516C\u8BA4\u4E3A\u4E13\u4E1A\u673A\u6784\uFF0C\u5728\u4E16\u754C\u5404\u5730\u63D0\u4F9B\u6838\u80FD\u54A8\u8BE2\u3002\u003C/p\u003E\n\u003Cp\u003E\u6CD5\u8FEA\u62C9\u8BF4\uFF0C\u5982\u679C\u653F\u5E9C\u63A8\u8FDB\u6838\u7535\u9879\u76EE\uFF0C\u786E\u4FDD\u8DB3\u591F\u3001\u9AD8\u6280\u80FD\u4E14\u80DC\u4EFB\u7684\u52B3\u52A8\u529B\u624D\u5C06\u662F\u53D1\u5C55\u8BA1\u5212\u7684\u6838\u5FC3\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u5F3A\u8C03\uFF0C\u9A6C\u6765\u897F\u4E9A\u5728\u7535\u5382\u548C\u5DE5\u4E1A\u7CBE\u70BC\u5382\u65B9\u9762\u5DF2\u62E5\u6709\u6280\u672F\u719F\u7EC3\u7684\u52B3\u52A8\u529B\uFF0C\u53EF\u4EE5\u8FDB\u4E00\u6B65\u57F9\u8BAD\u4ED6\u4EEC\uFF0C\u4EE5\u652F\u6301\u6838\u7535\u5382\u7684\u7BA1\u7406\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6B64\u5916\uFF0C\u9A6C\u6765\u897F\u4E9A\u901A\u8FC7\u56FD\u9645\u539F\u5B50\u80FD\u673A\u6784\uFF08IAEA\uFF09\u7B49\u56FD\u9645\u5E73\u53F0\u4E0D\u65AD\u4E0E\u6709\u6838\u7535\u8FD0\u8425\u7ECF\u9A8C\u7684\u56FD\u5BB6\u4E92\u52A8\uFF0C\u786E\u4FDD\u548C\u5E73\u4F7F\u7528\u6838\u6280\u672F\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u5408\u4F5C\u4E0E\u4F19\u4F34\u5173\u7CFB\u5C06\u662F\u80FD\u529B\u5EFA\u8BBE\u548C\u57F9\u8BAD\u7684\u5173\u952E\uFF0C\u4EE5\u786E\u4FDD\u9A6C\u6765\u897F\u4E9A\u6210\u529F\u5B9E\u65BD\u6838\u80FD\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/I7SAakQXOo8UUYLoltGVtA\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
