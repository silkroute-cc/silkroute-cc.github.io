  "title": "51\u54C1\u724C\u767B\u9646\u9A6C\u6765\u897F\u4E9A \u4E2D\u56FD\u5360\u534A\u58C1\u6C5F\u5C71",
  "summary": "\uFF08\u5409\u9686\u576131\u65E5\u8BAF\uFF09\u8FD1\u5E74\u6765\uFF0C\u4E2D\u56FD\u54C1\u724C\u52A0\u901F\u5168\u7403\u6269\u5F20\u6B65\u4F10\uFF0C\u5927\u9A6C\u5DF2\u6210\u4E3A\u4E2D\u56FD\u4F01\u4E1A\u62D3\u5C55\u4E1C\u5357\u4E9A\u5E02\u573A\u7684\u91CD\u8981\u95E8\u6237\uFF0C\u7279\u522B\u662F\u5728\u9910\u996E\u548C\u65F6\u5C1A\u9886\u57DF\uFF0C\u53BB\u5E74\u767B\u9646\u5927\u9A6C\u7684\u81F3\u5C1151\u4E2A\u65B0\u54C1\u724C\u5F53\u4E2D\uFF0C\u4E2D\u56FD\u54C1\u724C\u5C31\u5360\u4E86\u201C\u534A\u58C1\u6C5F\u5C71\u201D\u3002 \u800C\u5728\u4ECA\u5E74\uFF0C\u795E\u5DDE\u54C1\u724C\u5728\u5927\u9A6C\u7684\u6269\u5145\u901F\u5EA6\u9884\u6599\u6709\u589E\u65E0\u51CF\uFF0C\u9664\u4E86\u65E5\u524D\u5DF2\u62A2\u5148\u8FDB\u9A7B\u7684\u745E\u5E78\u5496\u5561\uFF08Luckin Coffee\uFF09\uFF0C\u76EE\u524D\u9884\u8BA1\u4ECA\u5E74\u5185\u8FDB\u9A7B\u5927\u9A6C\u7684\u81F3\u5C115\u4E2A\u5916\u56FD\u65B0\u54C1\u724C\u5F53\u4E2D\uFF0C\u5C31\u67092\u4E2A\u662F\u4E2D\u56FD\u54C1\u724C\uFF1A\u5148\u542F\u534A\u6B65\u98A0\uFF08Xian Qi Ban Bu Dian\uFF09\u53CAMiao\u3002 \u53E63\u4E2A\u5916\u56FD\u65B0\u54C1\u724C\u5206\u522B\u662F\u6765\u81EA\u7F8E\u56FD\u7684\u8FDE\u9501\u51B0\u6DC7\u6DCB\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2025/02/frc-035fbeb77e31f158483cc576351700a2.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\uFF08\u5409\u9686\u576131\u65E5\u8BAF\uFF09\u8FD1\u5E74\u6765\uFF0C\u4E2D\u56FD\u54C1\u724C\u52A0\u901F\u5168\u7403\u6269\u5F20\u6B65\u4F10\uFF0C\u5927\u9A6C\u5DF2\u6210\u4E3A\u4E2D\u56FD\u4F01\u4E1A\u62D3\u5C55\u4E1C\u5357\u4E9A\u5E02\u573A\u7684\u91CD\u8981\u95E8\u6237\uFF0C\u7279\u522B\u662F\u5728\u9910\u996E\u548C\u65F6\u5C1A\u9886\u57DF\uFF0C\u53BB\u5E74\u767B\u9646\u5927\u9A6C\u7684\u81F3\u5C1151\u4E2A\u65B0\u54C1\u724C\u5F53\u4E2D\uFF0C\u4E2D\u56FD\u54C1\u724C\u5C31\u5360\u4E86\u201C\u534A\u58C1\u6C5F\u5C71\u201D\u3002\u003C/p\u003E\n\u003Cp\u003E\u800C\u5728\u4ECA\u5E74\uFF0C\u795E\u5DDE\u54C1\u724C\u5728\u5927\u9A6C\u7684\u6269\u5145\u901F\u5EA6\u9884\u6599\u6709\u589E\u65E0\u51CF\uFF0C\u9664\u4E86\u65E5\u524D\u5DF2\u62A2\u5148\u8FDB\u9A7B\u7684\u745E\u5E78\u5496\u5561\uFF08Luckin Coffee\uFF09\uFF0C\u76EE\u524D\u9884\u8BA1\u4ECA\u5E74\u5185\u8FDB\u9A7B\u5927\u9A6C\u7684\u81F3\u5C115\u4E2A\u5916\u56FD\u65B0\u54C1\u724C\u5F53\u4E2D\uFF0C\u5C31\u67092\u4E2A\u662F\u4E2D\u56FD\u54C1\u724C\uFF1A\u5148\u542F\u534A\u6B65\u98A0\uFF08Xian Qi Ban Bu Dian\uFF09\u53CAMiao\u3002\u003C/p\u003E\n\u003Cp\u003E\u53E63\u4E2A\u5916\u56FD\u65B0\u54C1\u724C\u5206\u522B\u662F\u6765\u81EA\u7F8E\u56FD\u7684\u8FDE\u9501\u51B0\u6DC7\u6DCB\u54C1\u724CDairy Queen\u3001\u6765\u81EA\u8FEA\u62DC\u7684\u670D\u88C5\u54C1\u724CBrands For Less\uFF0C\u4EE5\u53CA\u65E5\u672C\u77E5\u540D\u54C1\u724CKaraKu\u3002\u003C/p\u003E\n\u003Cp\u003E\u8457\u540D\u4EA7\u4E1A\u987E\u95EE\u516C\u53F8\u5927\u9A6C\u4EA8\u5229\u884C\u6307\u51FA\uFF0C\u5927\u9A6C\u7EE7\u7EED\u6210\u4E3A\u4E1C\u5357\u4E9A\u5730\u533A\u6700\u53D7\u5916\u56FD\u96F6\u552E\u54C1\u724C\u9752\u7750\u7684\u5E02\u573A\u4E4B\u4E00\uFF0C\u53BB\u5E74\u5171\u6709\u6765\u81EA11\u4E2A\u56FD\u5BB6\u4E14\u81F3\u5C1151\u4E2A\u65B0\u54C1\u724C\u8FDB\u9A7B\u6211\u56FD\u96F6\u552E\u9886\u57DF\uFF0C\u4ECA\u5E74\u9884\u8BA1\u5C06\u81F3\u5C11\u6709\u53E6\u7EA65\u5BB6\u5916\u56FD\u54C1\u724C\u767B\u9646\u62A2\u6EE9\u3002\u003C/p\u003E\n\u003Cp\u003E\u6839\u636E\u5927\u9A6C\u4EA8\u5229\u884C\u7684\u6700\u65B0\u7814\u7A76\u62A5\u544A\uFF0C\u5728\u8FD9\u6279\u65B0\u8FDB\u9A7B\u7684\u5916\u56FD\u54C1\u724C\u4E2D\uFF0C\u4E2D\u56FD\u54C1\u724C\u51E0\u4E4E\u5360\u4E86\u201C\u534A\u58C1\u6C5F\u5C71\u201D\uFF0C\u5360\u6BD4\u9AD8\u8FBE45%\u3002\u003C/p\u003E\n\u003Cp\u003E\u6B64\u5916\uFF0C\u9910\u996E\u4E1A\u4ECD\u662F\u6700\u591A\u5916\u56FD\u65B0\u54C1\u724C\u8FDB\u9A7B\u7684\u96F6\u552E\u6B21\u9886\u57DF\uFF0C\u536047%\uFF1B\u5176\u6B21\u662F\u65F6\u5C1A\u914D\u9970\u884C\u4E1A\uFF0C\u536029%\u3002 \u003C/p\u003E\n\u003Cp\u003E\u5728\u8FDB\u9A7B\u5927\u9A6C\u7684\u5916\u56FD\u54C1\u724C\u4E2D\uFF0C\u5176\u4E2D\u8D85\u8FC790%\u9009\u62E9\u8FDB\u9A7B\u5DF4\u751F\u8C37\uFF0C\u800C\u5409\u9686\u5761\u66F4\u5360\u636E\u4E86\u5DF4\u751F\u8C37\u603B\u4F9B\u5E94\u91CF\u768482%\u3002\u003C/p\u003E\n\u003Cp\u003E\u4EA8\u5229\u884C\u6307\u51FA\uFF0C\u4E2D\u56FD\u54C1\u724C\u51ED\u501F\u4EF7\u683C\u7ADE\u4E89\u529B\u3001\u521B\u65B0\u4EA7\u54C1\u53CA\u6709\u6548\u7684\u5E02\u573A\u7B56\u7565\uFF0C\u8FC5\u901F\u83B7\u5F97\u672C\u5730\u6D88\u8D39\u8005\u7684\u9752\u7750\u3002\u003C/p\u003E\n\u003Cp\u003E\u5C55\u671B\u672A\u6765\uFF0C\u968F\u7740\u66F4\u591A\u5916\u56FD\u96F6\u552E\u54C1\u724C\u8FDB\u9A7B\uFF0C\u5DF4\u751F\u8C37\u7684\u96F6\u552E\u5E02\u573A\u7ADE\u4E89\u5C06\u8FDB\u4E00\u6B65\u52A0\u5267\u3002\u672C\u5730\u96F6\u552E\u5546\u4E5F\u9700\u8981\u4E0D\u65AD\u521B\u65B0\uFF0C\u4EE5\u5E94\u5BF9\u5916\u56FD\u54C1\u724C\u5E26\u6765\u7684\u6311\u6218\uFF0C\u540C\u65F6\u4E3A\u6D88\u8D39\u8005\u63D0\u4F9B\u66F4\u4E30\u5BCC\u7684\u9009\u62E9\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2025/02/frc-875faabdca1a3a45c583a6a3941043d3.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5148\u542F\u534A\u6B65\u98A0\u003C/p\u003E\n\u003Cp\u003E\u66F4\u6362\u7ECF\u8425\u8005\u6216\u5173\u95ED\u95E8\u5E97\n\u5DF4\u751F\u8C37\u96F6\u552E\u5E02\u573A\u5927\u89C4\u6A21\u8C03\u6574\u003C/p\u003E\n\u003Cp\u003E\u6240\u8C13\u6709\u4EBA\u6B22\u559C\u6709\u4EBA\u6101\uFF0C\u53BB\u5E74\u8D85\u8FC750\u4E2A\u5916\u56FD\u65B0\u54C1\u724C\u8FDB\u9A7B\u5927\u9A6C\uFF0C\u4F46\u540C\u65F6\u4E5F\u6709\u5927\u6279\u539F\u6709\u56FD\u5185\u5916\u54C1\u724C\u201C\u9000\u5802\u6C42\u53BB\u201D\u3002\u003C/p\u003E\n\u003Cp\u003E\u5927\u9A6C\u4EA8\u5229\u884C\u6307\u51FA\uFF0C\u5DF4\u751F\u8C37\u96F6\u552E\u5E02\u573A\u53BB\u5E74\u7ECF\u5386\u5927\u89C4\u6A21\u8C03\u6574\uFF0C\u591A\u5BB6\u8D85\u5E02\u3001\u7535\u5F71\u9662\u53CA\u96F6\u552E\u54C1\u724C\u66F4\u6362\u7ECF\u8425\u8005\u6216\u5173\u95ED\u95E8\u5E97\uFF0C\u663E\u793A\u5E02\u573A\u7ADE\u4E89\u65E5\u8D8B\u6FC0\u70C8\u3002\u003C/p\u003E\n\u003Cp\u003E\u53BB\u5E74\u521D\uFF0C\u8FDE\u9501\u8D85\u5E02Jaya Grocer\u53D6\u4EE3\u5DE8\u4EBA\u9738\u5E02\uFF08Giant\uFF09\u8FDB\u9A7B\u838E\u963F\u5357Plaza\u8D2D\u7269\u4E2D\u5FC3\uFF0C\u8D85\u5E02Ben\u2019s Independent Grocer\u8FDB\u9A7B\u73CD\u73E0\u8D2D\u7269\u4E2D\u5FC3\uFF08Pearl Shopping Gallery\uFF09\u3002\u003C/p\u003E\n\u003Cp\u003E\u5927\u9A6C\u9886\u5148\u8D85\u5E02\u4E4B\u4E00NSK Grocer\u53D6\u4EE3\u5DE8\u4EBA\u9738\u5E02\u5165\u9A7BAmcorp\u8D2D\u7269\u4E2D\u5FC3\uFF0C\u800C\u6C38\u65FAAEON\u8FDB\u9A7B\u5B9E\u8FBE\u57CE\u8D2D\u7269\u4E2D\u5FC3\uFF08Setia City Mall\uFF09\u53D6\u4EE3Lulu\u8D85\u5E02\u3002\u003C/p\u003E\n\u003Cp\u003E\u6B64\u5916\uFF0C\u672C\u5730\u7535\u5F71\u9662\u5E02\u573A\u4E5F\u540C\u6837\u9762\u4E34\u6311\u6218\uFF0C\u5609\u901A\u9662\u7EBF\u5173\u95ED\u4F4D\u4E8E3 Damansara\u3001\u5DF4\u751F\u767E\u5229\u5E7F\u573A\uFF08Klang Parade\uFF09\u548C\u897F\u5854\u8D2D\u7269\u4E2D\u5FC3\uFF08Citta Mall\uFF09\u7684\u7535\u5F71\u9662\uFF0CMBO\u7535\u5F71\u9662\u4E5F\u9000\u51FAAtria \u8D2D\u7269\u4E2D\u5FC3\u3002\u003C/p\u003E\n\u003Cp\u003EmmCineplexes\u53D6\u4EE3\u5609\u901A\u9662\u7EBF\uFF08GSC\uFF