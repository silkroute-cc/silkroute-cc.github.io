{
  "id": "%e5%95%86%e4%bc%9a%e6%96%b0%e9%97%bb-%e5%8f%97%e9%82%80%e5%8f%82%e5%8a%a0%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e5%ad%a6%e6%9c%af%e8%b5%84%e6%a0%bc%e9%89%b4%e5%ae%9a%e6%9c%ba%e6%9e%84%e5%9b%bd",
  "slug": "%e5%95%86%e4%bc%9a%e6%96%b0%e9%97%bb-%e5%8f%97%e9%82%80%e5%8f%82%e5%8a%a0%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e5%ad%a6%e6%9c%af%e8%b5%84%e6%a0%bc%e9%89%b4%e5%ae%9a%e6%9c%ba%e6%9e%84%e5%9b%bd",
  "canonicalUrlKey": "%e5%95%86%e4%bc%9a%e6%96%b0%e9%97%bb-%e5%8f%97%e9%82%80%e5%8f%82%e5%8a%a0%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e5%ad%a6%e6%9c%af%e8%b5%84%e6%a0%bc%e9%89%b4%e5%ae%9a%e6%9c%ba%e6%9e%84%e5%9b%bd",
  "route": "/5326/",
  "title": "\u5546\u4F1A\u65B0\u95FB | \u53D7\u9080\u53C2\u52A0\u9A6C\u6765\u897F\u4E9A\u5B66\u672F\u8D44\u683C\u9274\u5B9A\u673A\u6784\u56FD\u9645\u4F1A\u8BAE(MQAIC 2024\uFF09",
  "summary": "\u4E2D\u56FD\u9A6C\u6765\u897F\u4E9A\u5546\u4F1A\u897F\u5B89\u00B7\u529E\u4E8B\u5904\u4E8E2024\u5E7411\u670811\u65E5\u81F312\u65E5\u53D7\u9080\u53C2\u52A0\u4E8E\u9A6C\u6765\u897F\u4E9A\u7802\u62C9\u8D8A\u53E4\u664B\u4E3E\u529E\u76842024\u5E74\u9A6C\u6765\u897F\u4E9A\u5B66\u672F\u8D44\u683C\u9274\u5B9A\u673A\u6784\u56FD\u9645\u4F1A\u8BAE(MQAIC 2024\uFF09\u3002 \u6B64\u6B21\u6D3B\u52A8\uFF0C\u4E2D\u56FD\u9A6C\u6765\u897F\u4E9A\u5546\u4F1A\u00B7\u897F\u5B89\u529E\u4E8B\u5904\u8FD8\u7279\u522B\u9080\u8BF7\u4E86\u6986\u6797\u5B66\u9662\u548C\u897F\u5B89\u5916\u56FD\u8BED\u5927\u5B66\u7684\u4EE3\u8868\u5171\u540C\u53C2\u4E0E\u3002 \u4E24\u6821\u4EE3\u8868\u5728\u5927\u4F1A\u671F\u95F4\u53C2\u4E0E\u4E86\u591A\u573A\u91CD\u8981\u4F1A\u8BAE\u548C\u8BBA\u575B\uFF0C\u5E76\u5728\u5927\u4F1A\u4E0A\u4E2D\u53D1\u8A00\u4E0E\u5C55\u793A\u3002 \u6B64\u6B21\u5927\u4F1A\u4EE5\u201C\u5168\u7403\u9AD8\u8D28\u91CF\u9AD8\u7B49\u6559\u80B2\u201D\u4E3A\u4E3B\u9898\uFF0C\u5438\u5F15\u4E86\u8D85\u8FC7300\u540D\u6765\u81EA\u5168\u7403\u7684\u9AD8\u7B49\u6559\u80B2\u673A\u6784\u4EE3\u8868\u3001\u653F\u7B56\u5236\u5B9A\u8005\u3001\u884C\u4E1A\u9886\u8896\u4EE5\u53CA\u5404\u56FD\u5927\u4F7F\u9986\u7684\u6559\u80B2\u53C2\u8D5E\uFF0C\u5171\u540C\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/11/frc-c5490754e487b9d696de4b5d28125959.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/11/frc-56ddd50e49d08701c8be6c4278a0b520.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/11/frc-052817c17f987af202d196d85f21f331.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u4E2D\u56FD\u9A6C\u6765\u897F\u4E9A\u5546\u4F1A\u897F\u5B89\u0026#183;\u529E\u4E8B\u5904\u4E8E2024\u5E7411\u670811\u65E5\u81F312\u65E5\u53D7\u9080\u53C2\u52A0\u4E8E\u9A6C\u6765\u897F\u4E9A\u7802\u62C9\u8D8A\u53E4\u664B\u4E3E\u529E\u76842024\u5E74\u9A6C\u6765\u897F\u4E9A\u5B66\u672F\u8D44\u683C\u9274\u5B9A\u673A\u6784\u56FD\u9645\u4F1A\u8BAE(MQAIC 2024\uFF09\u3002\u003C/p\u003E\n\u003Cp\u003E\u6B64\u6B21\u6D3B\u52A8\uFF0C\u4E2D\u56FD\u9A6C\u6765\u897F\u4E9A\u5546\u4F1A\u0026#183;\u897F\u5B89\u529E\u4E8B\u5904\u8FD8\u7279\u522B\u9080\u8BF7\u4E86\u6986\u6797\u5B66\u9662\u548C\u897F\u5B89\u5916\u56FD\u8BED\u5927\u5B66\u7684\u4EE3\u8868\u5171\u540C\u53C2\u4E0E\u3002\u4E24\u6821\u4EE3\u8868\u5728\u5927\u4F1A\u671F\u95F4\u53C2\u4E0E\u4E86\u591A\u573A\u91CD\u8981\u4F1A\u8BAE\u548C\u8BBA\u575B\uFF0C\u5E76\u5728\u5927\u4F1A\u4E0A\u4E2D\u53D1\u8A00\u4E0E\u5C55\u793A\u3002\u003C/p\u003E\n\u003Cp\u003E\u6B64\u6B21\u5927\u4F1A\u4EE5\u201C\u5168\u7403\u9AD8\u8D28\u91CF\u9AD8\u7B49\u6559\u80B2\u201D\u4E3A\u4E3B\u9898\uFF0C\u5438\u5F15\u4E86\u8D85\u8FC7300\u540D\u6765\u81EA\u5168\u7403\u7684\u9AD8\u7B49\u6559\u80B2\u673A\u6784\u4EE3\u8868\u3001\u653F\u7B56\u5236\u5B9A\u8005\u3001\u884C\u4E1A\u9886\u8896\u4EE5\u53CA\u5404\u56FD\u5927\u4F7F\u9986\u7684\u6559\u80B2\u53C2\u8D5E\uFF0C\u5171\u540C\u63A2\u8BA8\u9AD8\u7B49\u6559\u80B2\u8D28\u91CF\u4FDD\u969C\u4E0E\u56FD\u9645\u5408\u4F5C\u7684\u521B\u65B0\u8DEF\u5F84\u3002\u003C/p\u003E\n\u003Cp\u003E\u4F1A\u8BAE\u548C\u8BBA\u575B\u8BBE\u7F6E\u4E86\u591A\u4E2A\u6838\u5FC3\u8BAE\u9898\uFF0C\u5305\u62EC\u9AD8\u7B49\u6559\u80B2\u53D8\u9769\u3001\u6280\u672F\u9002\u5E94\u3001\u534F\u4F5C\u4F19\u4F34\u5173\u7CFB\u53CA\u6280\u672F\u4E0E\u804C\u4E1A\u6559\u80B2\u57F9\u8BAD\uFF08TVET\uFF09\u7684\u5C31\u4E1A\u80FD\u529B\u63D0\u5347\u3002\u901A\u8FC7\u4E13\u9898\u8BA8\u8BBA\u4E0E\u5B9E\u8DF5\u5206\u4EAB\uFF0C\u4E0E\u4F1A\u4EE3\u8868\u6DF1\u5165\u4EA4\u6D41\u5982\u4F55\u5E94\u5BF9\u5168\u7403\u5316\u3001\u6570\u5B57\u5316\u65F6\u4EE3\u5BF9\u6559\u80B2\u4F53\u7CFB\u7684\u6311\u6218\uFF0C\u540C\u65F6\u63A2\u8BA8\u63A8\u52A8\u56FD\u9645\u6559\u80B2\u6807\u51C6\u5BF9\u63A5\u7684\u65B0\u6A21\u5F0F\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/11/frc-ae6799c343bbe0cda9b6b2d94ceb905c.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5728MQAIC 2024\u671F\u95F4\uFF0C\u9A6C\u6765\u897F\u4E9A\u9AD8\u7B49\u6559\u80B2\u90E8\u957F\u62FF\u7763\u65AF\u91CC\u8D5E\u6BD4\u91CC\u963F\u90FD\u5361\u8FEA\u4E0E\u5168\u7403\u5404\u8D44\u683C\u673A\u6784\u4E3E\u884C\u4E86\u4E3B\u5E2D\u8BBA\u575B\uFF08President\u0026#39;s Forum\uFF09\u6DF1\u5165\u63A2\u8BA8\u4E86\u9AD8\u7B49\u6559\u80B2\u56FD\u9645\u5316\u3001\u8D28\u91CF\u4FDD\u969C\u5B9E\u8DF5\u3001\u8BFE\u7A0B\u521B\u65B0\u4E0E\u7EC8\u8EAB\u5B66\u4E60\u7B49\u91CD\u8981\u8BAE\u9898\uFF0C\u540C\u65F6\u4E5F\u8BA8\u8BBA\u4E86\u5F53\u524D\u9AD8\u7B49\u6559\u80B2\u9762\u4E34\u7684\u6311\u6218\u3002\u6986\u6797\u5B66\u9662\u7684\u4EE3\u8868\u5728\u4F1A\u8BAE\u4E2D\u79EF\u6781\u53C2\u4E0E\uFF0C\u5E76\u9488\u5BF9\u4F1A\u8BAE\u4E3B\u9898\u63D0\u51FA\u4E86\u76F8\u5173\u95EE\u9898\uFF0C\u4E0E\u5609\u5BBE\u5171\u540C\u63A2\u8BA8\u4E2D\u9A6C\u4E24\u56FD\u9AD8\u7B49\u6559\u80B2\u8BFE\u9898\u3002\u003C/p\u003E\n\u003Cp\u003E\u6B64\u5916\uFF0C\u5728\u5546\u4F1A\u7684\u534F\u8C03\u4E0E\u5B89\u6392\u4E0B\uFF0C\u897F\u5B89\u5916\u56FD\u8BED\u5927\u5B66\u548C\u6986\u6797\u5B66\u9662\u7684\u4EE3\u8868\u5206\u522B\u4E0E\u9A6C\u6765\u897F\u4E9A\u9AD8\u7B49\u6559\u80B2\u90E8\u957F\u62FF\u7763\u65AF\u91CC\u8D5E\u6BD4\u91CC\u963F\u90FD\u5361\u8FEA\u8FDB\u884C\u4E86\u4F1A\u9762\u548C\u4F1A\u8C08\u3002\u4F1A\u8C08\u4E2D\uFF0C\u53CC\u65B9\u56F4\u7ED5\u9AD8\u7B49\u6559\u80B2\u56FD\u9645\u5316\u3001\u5B66\u672F\u4EA4\u6D41\u4E0E\u5408\u4F5C\u9879\u76EE\u5C55\u5F00\u4E86\u4EA4\u6D41\u3002\u8FD9\u4E00\u4E92\u52A8\u8FDB\u4E00\u6B65\u51F8\u663E\u4E86\u4E2D\u9A6C\u9AD8\u6821\u5408\u4F5C\u7684\u5E7F\u9614\u524D\u666F\uFF0C\u4E3A\u6DF1\u5316\u4E24\u56FD\u9AD8\u7B49\u6559\u80B2\u8054\u7CFB\u5960\u5B9A\u4E86\u826F\u597D\u7684\u57FA\u7840\u3002\u003C/p\u003E\n\u003Cp\u003EMQAIC 2024\u4F5C\u4E3A\u4E00\u4E2A\u56FD\u9645\u5316\u3001\u9AD8\u6C34\u5E73\u7684\u6559\u80B2\u4EA4\u6D41\u5E73\u53F0\uFF0C\u4E0D\u4EC5\u4FC3\u8FDB\u4E86\u9AD8\u7B49\u6559\u80B2\u754C\u7684\u5BF9\u8BDD\u4E0E\u5408\u4F5C\uFF0C\u4E5F\u4E3A\u8FDB\u4E00\u6B65\u52A0\u5F3A\u4E24\u56FD\u9AD8\u6821\u5728\u6559\u80B2\u7814\u7A76\u3001\u5B66\u672F\u6587\u5316\u4EA4\u6D41\u7B49\u65B9\u9762\u7684\u4E92\u52A8\u5960\u5B9A\u4E86\u57FA\u7840\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/11/frc-25c221627dcbfca32068f3255b8020bf.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/11/frc-da60cb7913b5d4d021c7e10e4a6c2d1d.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/11/frc-452e6b6e8791e3de96f009d246b3b862.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u671F\u95F4\uFF0C\u897F\u5B89\u5916\u56FD\u8BED\u5927\u5B66\u548C\u6986\u6797\u5B66\u9662\u7684\u4EE3\u8868\u5206\u522B\u5728\u5927\u4F1A\u4E0A\u8FDB\u884C\u7CBE\u5F69\u53D1\u8A00\u548C\u8BBE\u7ACB\u5C55\u4F4D\uFF0C\u5C55\u793A\u4E86\u5404\u81EA\u7684\u529E\u5B66\u7279\u8272\u3001\u6559\u80B2\u9879\u76EE\u4EE5\u53CA\u4E0E\u56FD\u9645\u9AD8\u6821\u7684\u5408\u4F5C\u6210\u679C\u3002\u003C/p\u003E\n\u003Cp\u003E\u897F\u5B89\u5916\u56FD\u8BED\u5927\u5B66\u7684\u4EE3\u8868\u91CD\u70B9\u5206\u4EAB\u4E86\u5B66\u6821\u5728\u5916\u8BED\u6559\u5B66\u3001\u56FD\u9645\u5316\u529E\u5B66\u53CA\u8DE8\u6587\u5316\u4EA4\u6D41\u65B9\u9762\u7684\u63A2\u7D22\u3002\u800C\u6986\u6797\u5B66\u9662\u7684\u4EE3\u8868\u5219\u91CD\u70B9\u4ECB\u7ECD\u4E86\u80FD\u6E90\u5DE5\u7A0B\u5B66\u9662\u7684\u53D1\u5C55\u60C5\u51B5\uFF0C\u5E76\u63A2\u8BA8\u4E86\u4E0E\u9A6C\u6765\u897F\u4E9A\u9AD8\u6821\u5728\u65B0\u80FD\u6E90\u6280\u672F\u3002\u003C/p\u003E\n\u003Cp\u003E\u76EE\u524D\uFF0C\u897F\u5B89\u5916\u56FD\u8BED\u5927\u5B66\u548C\u6986\u6797\u5B66\u9662\u5206\u522B\u4E0E\u9A6C\u6765\u897F\u4E9A\u516C\u7ACB\u5927\u5B66\u5C31\u5177\u4F53\u5408\u4F5C\u4E8B\u5B9C\u8FDB\u884C\u79EF\u6781\u6D3D\u8C08\uFF0C\u5408\u4F5C\u65B9\u5411\u6DB5\u76D6\u4E2D\u9A6C\u4E24\u56FD\u8054\u5408\u79D1\u7814\u3001\u5B66\u672F\u4EA4\u6D41\u7B49\u591A\u4E2A\u9886\u57DF\u3002\u5408\u4F5C\u4E8B\u5B9C\u73B0\u5DF2\u9010\u6B65\u63A8\u8FDB\uFF0C\u8FDB\u5C55\u987A\u5229\u3002\u8FD9\u4E00\u5408\u4F5C\u6807\u5FD7\u7740\u4E24\u6821\u4E0E\u9A6C\u6765\u897F\u4E9A\u9AD8\u6821\u7684\u5173\u7CFB\u4E0D\u65AD\u6DF1\u5316\uFF0C\u4E3A\u672A\u6765\u4E2D\u9A6C\u9AD8\u7B49\u6559\u80B2\u9886\u57DF\u7684\u957F\u671F\u5408\u4F5C\u5960\u5B9A\u4E86\u575A\u5B9E\u57FA\u7840\u3002\u003C/p\u003E\n\u003Cp\u003EEND\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/11/frc-d164d9f563bcff16268d6e1639021322.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u7F16\u8F91 | \u4E2D\u56FD\u9A6C\u6765\u897F\u4E9A\u5546\u4F1A\u0026#183;\u897F\u5B89\u529E\u4E8B\u5904\u003C/p\u003E\n\u003Cp\u003E\u6587\u6848\u6765\u6E90 | \u4E2D\u56FD\u9A6C\u6765\u897F\u4E9A\u5546\u4F1A\u0026#183;\u897F\u5B89\u529E\u4E8B\u5904\u003C/p\u003E\n\u003Cp\u003E\u7167\u7247\u6765\u6E90 | \u4E2D\u56FD\u9A6C\u6765\u897F\u4E9A\u5546\u4F1A\u0026#183;\u897F\u5B89\u529E\u4E8B\u5904\u003C/p\u003E\n\u003Cp\u003E\u5165\u4F1A\u54A8\u8BE2 | \u8054\u7CFB\u540E\u53F0\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/GXUnWN6q390Qq42w8Uq7Jw\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
