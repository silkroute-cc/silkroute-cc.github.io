{
  "id": "%e9%87%91%e6%99%b6%e7%a7%91%e6%8a%80%e6%8a%95%e8%ba%ab%e4%b8%80%e5%b8%a6%e4%b8%80%e8%b7%af%e5%85%b1%e5%bb%ba-%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e5%85%89%e4%bc%8f%e9%a1%b9%e7%9b%ae",
  "slug": "%e9%87%91%e6%99%b6%e7%a7%91%e6%8a%80%e6%8a%95%e8%ba%ab%e4%b8%80%e5%b8%a6%e4%b8%80%e8%b7%af%e5%85%b1%e5%bb%ba-%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e5%85%89%e4%bc%8f%e9%a1%b9%e7%9b%ae",
  "canonicalUrlKey": "%e9%87%91%e6%99%b6%e7%a7%91%e6%8a%80%e6%8a%95%e8%ba%ab%e4%b8%80%e5%b8%a6%e4%b8%80%e8%b7%af%e5%85%b1%e5%bb%ba-%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e5%85%89%e4%bc%8f%e9%a1%b9%e7%9b%ae",
  "route": "/4118/",
  "title": "\u91D1\u6676\u79D1\u6280\u6295\u8EAB\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u5171\u5EFA \u9A6C\u6765\u897F\u4E9A\u5149\u4F0F\u9879\u76EE\u5171\u521B\u7EFF\u8272\u53D1\u5C55",
  "summary": "10\u670818\u65E5\uFF0C\u7B2C\u4E09\u5C4A\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u56FD\u9645\u5408\u4F5C\u9AD8\u5CF0\u8BBA\u575B\u5728\u5317\u4EAC\u5F00\u5E55\u3002\u5728\u5F00\u5E55\u5F0F\u4E0A\uFF0C\u4E2D\u56FD\u5BA3\u5E03\u201C\u516B\u9879\u884C\u52A8\u201D\u9AD8\u8D28\u91CF\u5171\u5EFA\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u3002\u5728\u201C\u4FC3\u8FDB\u7EFF\u8272\u53D1\u5C55\u201D\u65B9\u9762\uFF0C\u4E2D\u65B9\u5C06\u6301\u7EED\u6DF1\u5316\u7EFF\u8272\u57FA\u5EFA\u3001\u7EFF\u8272\u80FD\u6E90\u3001\u7EFF\u8272\u4EA4\u901A\u7B49\u9886\u57DF\u5408\u4F5C\uFF0C\u52A0\u5927\u5BF9\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u7EFF\u8272\u53D1\u5C55\u56FD\u9645\u8054\u76DF\u7684\u652F\u6301\uFF0C\u7EE7\u7EED\u4E3E\u529E\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u7EFF\u8272\u521B\u65B0\u5927\u4F1A\uFF0C\u5EFA\u8BBE\u5149\u4F0F\u4EA7\u4E1A\u5BF9\u8BDD\u4EA4\u6D41\u673A\u5236\u548C\u7EFF\u8272\u4F4E\u78B3\u4E13\u5BB6\u7F51\u7EDC\u3002\u843D\u5B9E\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u7EFF\u8272\u6295\u8D44\u539F\u5219\uFF0C\u52302030\u5E74\u4E3A\u4F19\u4F34\u56FD\u5F00\u5C5510\u4E07\u4EBA\u6B21\u57F9\u8BAD\u3002 \u8FC7\u53BB10\u5E74\uFF0C\u6211\u56FD\u5149\u4F0F\u3001\u9502\u7535\u7B49\u7EFF\u8272\u80FD\u6E90\u4EA7\u4E1A\u5728\u5168\u7403\u5E02\u573A\u5360\u6709\u7387\u6301\u7EED\u6500\u5347\uFF0C\u7EFF\u8272\u4F4E\u78B3\u76F8\u5173\u4E0A\u5E02\u516C\u53F8\u6301\u2026",
  "body": "\u003Cp\u003E10\u670818\u65E5\uFF0C\u7B2C\u4E09\u5C4A\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u56FD\u9645\u5408\u4F5C\u9AD8\u5CF0\u8BBA\u575B\u5728\u5317\u4EAC\u5F00\u5E55\u3002\u5728\u5F00\u5E55\u5F0F\u4E0A\uFF0C\u4E2D\u56FD\u5BA3\u5E03\u201C\u516B\u9879\u884C\u52A8\u201D\u9AD8\u8D28\u91CF\u5171\u5EFA\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u3002\u5728\u201C\u4FC3\u8FDB\u7EFF\u8272\u53D1\u5C55\u201D\u65B9\u9762\uFF0C\u4E2D\u65B9\u5C06\u6301\u7EED\u6DF1\u5316\u7EFF\u8272\u57FA\u5EFA\u3001\u7EFF\u8272\u80FD\u6E90\u3001\u7EFF\u8272\u4EA4\u901A\u7B49\u9886\u57DF\u5408\u4F5C\uFF0C\u52A0\u5927\u5BF9\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u7EFF\u8272\u53D1\u5C55\u56FD\u9645\u8054\u76DF\u7684\u652F\u6301\uFF0C\u7EE7\u7EED\u4E3E\u529E\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u7EFF\u8272\u521B\u65B0\u5927\u4F1A\uFF0C\u5EFA\u8BBE\u5149\u4F0F\u4EA7\u4E1A\u5BF9\u8BDD\u4EA4\u6D41\u673A\u5236\u548C\u7EFF\u8272\u4F4E\u78B3\u4E13\u5BB6\u7F51\u7EDC\u3002\u843D\u5B9E\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u7EFF\u8272\u6295\u8D44\u539F\u5219\uFF0C\u52302030\u5E74\u4E3A\u4F19\u4F34\u56FD\u5F00\u5C5510\u4E07\u4EBA\u6B21\u57F9\u8BAD\u3002\u003C/p\u003E\n\u003Cp\u003E\u8FC7\u53BB10\u5E74\uFF0C\u6211\u56FD\u5149\u4F0F\u3001\u9502\u7535\u7B49\u7EFF\u8272\u80FD\u6E90\u4EA7\u4E1A\u5728\u5168\u7403\u5E02\u573A\u5360\u6709\u7387\u6301\u7EED\u6500\u5347\uFF0C\u7EFF\u8272\u4F4E\u78B3\u76F8\u5173\u4E0A\u5E02\u516C\u53F8\u6301\u7EED\u6295\u8EAB\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u5EFA\u8BBE\uFF0C\u52A0\u5927\u5BF9\u4E1C\u5357\u4E9A\u7684\u6295\u8D44\u3002\u6570\u636E\u663E\u793A\uFF0C\u8FD1\u5E74\u6765\u6211\u56FD\u5DF2\u6709\u91D1\u6676\u79D1\u6280\uFF08600586.SH\uFF09\u7B49\u8FD120\u5BB6\u5149\u4F0F\u884C\u4E1A\u4E0A\u5E02\u516C\u53F8\u5148\u540E\u5728\u4E1C\u5357\u4E9A\u6295\u8D44\u8BBE\u5382\u3002\u003C/p\u003E\n\u003Cp\u003E\u636E\u6089\uFF0C\u91D1\u6676\u79D1\u6280\u4F5C\u4E3A\u56FD\u5185\u8D85\u767D\u73BB\u7483\u9F99\u5934\u548C\u56FD\u5185\u5916\u4E3A\u6570\u4E0D\u591A\u638C\u63E1TCO\u73BB\u7483\u6280\u672F\u4E14\u80FD\u5B9E\u73B0\u91CF\u4EA7\u7684\u4F01\u4E1A\u4E4B\u4E00\uFF0C\u662F\u56FD\u5BB6\u201C\u53CC\u78B3\u201D\u53CA\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u6218\u7565\u7684\u5FE0\u5B9E\u62E5\u6234\u8005\u548C\u5B9E\u8DF5\u8005\u3002\u8FD1\u5E74\u6765\uFF0C\u91D1\u6676\u79D1\u6280\u5728\u201C\u53CC\u78B3\u201D\u76EE\u6807\u80CC\u666F\u4E0B\u660E\u786E\u7814\u53D1\u65B9\u5411\uFF0C\u6DF1\u8015\u7EFF\u8272\u80FD\u6E90\u548C\u7EFF\u8272\u5EFA\u7B51\u4E24\u6761\u8D5B\u9053\uFF0C\u5E76\u501F\u529B\u56FD\u5BB6\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u6218\u7565\u7684\u63A8\u8FDB\uFF0C\u4E8E2018\u5E74\u5728\u9A6C\u6765\u897F\u4E9A\u6210\u7ACB\u6D77\u5916\u516C\u53F8\uFF0C\u4EA7\u54C1\u5B9A\u4F4D\u4E8E\u8584\u819C\u592A\u9633\u80FD\u5149\u4F0F\u7EC4\u4EF6\u7684\u4E3B\u8981\u8F85\u4EF6\uFF0C\u6210\u529F\u8FC8\u51FA\u6D77\u5916\u5E03\u5C40\u7B2C\u4E00\u6B65\u3002\u003C/p\u003E\n\u003Cp\u003E2021\u5E747\u6708\uFF0C\u91D1\u6676\u9A6C\u6765\u897F\u4E9A5\u6761\u6DF1\u52A0\u5DE5\u7EBF\u6295\u4EA7\uFF1B2022\u5E741\u6708\uFF0C\u91D1\u6676\u9A6C\u6765\u897F\u4E9A\u4E00\u671F\u5EFA\u8BBE\u76841\u6761500t/d\u80CC\u677F\u73BB\u7483\u751F\u4EA7\u7EBF\u6210\u529F\u70B9\u706B\uFF0C\u76EE\u524D\u4EA7\u54C1\u5DF2\u7ECF\u6210\u529F\u4E0B\u7EBF\u5E76\u7A33\u5B9A\u4F9B\u8D27\uFF0C\u81F3\u6B64\u8BE5\u9879\u76EE\u5728\u751F\u4EA7\u73AF\u8282\u5B9E\u73B0\u4E86\u5168\u7EBF\u8D2F\u901A\u3002\u8FD9\u662F\u9A6C\u6765\u897F\u4E9A\u7B2C\u4E00\u4E2A\u5927\u89C4\u6A21\u751F\u4EA7\u8D85\u8584\u548C\u8D85\u767D\u592A\u9633\u80FD\u73BB\u7483\u7684\u516C\u53F8\uFF0C\u6BCF\u5E74\u53EF\u4EE5\u63D0\u4F9B\u8FD12500\u4E07\u5E73\u65B9\u7C73\u7684\u592A\u9633\u80FD\u73BB\u7483\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/10/frc-83ed713bcb14fd78a13778b531e29101.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E2023\u5E746\u6708\uFF0C\u91D1\u6676\u9A6C\u6765\u897F\u4E9A\u4E8C\u671F\u5EFA\u8BBE\u76841\u6761600t/d\u5149\u4F0F\u73BB\u7483\u751F\u4EA7\u7EBF\u6210\u529F\u70B9\u706B\uFF0C\u5E76\u4E8E\u4E0A\u534A\u5E74\u5B9E\u73B0\u4EA7\u54C1\u6210\u529F\u4E0B\u7EBF\uFF0C\u6BCF\u5E74\u53EF\u4EE5\u63D0\u4F9B\u8FD13000\u4E07\u5E73\u65B9\u7C73\u7684\u592A\u9633\u80FD\u73BB\u7483\u3002\u76EE\u524D\u516C\u53F8\u5DF2\u914D\u5408\u56FD\u5916\u8584\u819C\u5149\u4F0F\u4F01\u4E1A\u8FDB\u884C\u524D\u671F\u4EA7\u54C1\u9A8C\u8BC1\u53CA\u5BFC\u5165\u5DE5\u4F5C\u3002\u91D1\u6676\u79D1\u6280\u9A6C\u6765\u897F\u4E9A\u7684\u4E13\u6709\u73BB\u7483\uFF0C\u5C06\u4E3A\u5404\u79CD\u592A\u9633\u80FD\u7EC4\u4EF6\u63D0\u4F9B\u4FDD\u62A4\u4F5C\u7528\uFF0C\u4E14\u5927\u5E45\u51CF\u8F7B\u592A\u9633\u80FD\u7EC4\u4EF6\u7684\u91CD\u91CF\uFF0C\u63D0\u9AD8\u7075\u6D3B\u6027\u548C\u9002\u9500\u5BF9\u8DEF\uFF0C\u4ECE\u800C\u4E3A\u7EC4\u4EF6\u5236\u9020\u5546\u548C\u5B89\u88C5\u5546\u8282\u7EA6\u6210\u672C\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/10/frc-aee8e9ab1e8fd9c83ddd5838e38636ee.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u534E\u897F\u8BC1\u5238\u7814\u62A5\u6307\u51FA\uFF0C\u9A6C\u6765\u91D1\u667623H1\u5B9E\u73B0\u6536\u51652.63\u4EBF\u5143\uFF0C\u5B9E\u73B0\u51C0\u5229\u6DA62524\u4E07\u5143\uFF0C\u51C0\u5229\u7387\u4E3A9.59%\uFF0C\u76C8\u5229\u80FD\u529B\u660E\u663E\u9AD8\u4E8E\u56FD\u5185\u5149\u4F0F\u4E1A\u52A1\u3002\u4ECA\u5E745\u6708\uFF0C\u9A6C\u6765\u91D1\u6676\u8584\u819C\u5149\u4F0F\u7EC4\u4EF6\u73BB\u7483\u80CC\u677F\u4E8C\u7EBF\u70B9\u706B\uFF0C\u4EA7\u91CF600t/d\u3002\u622A\u81F323M6\uFF0C\u516C\u53F8\u9A6C\u6765\u57FA\u5730\u5149\u4F0F\u73BB\u7483\u751F\u4EA7\u7EBF\u5EFA\u8BBE\u8FDB\u5EA6\u5DF2\u8FBE96.12%\uFF0C\u4E0B\u534A\u5E74\u53CC\u7EBF\u5F00\u59CB\u8FD0\u884C\u4E1A\u7EE9\u8D21\u732E\u6709\u671B\u66F4\u52A0\u660E\u663E\u3002\u003C/p\u003E\n\u003Cp\u003E\u76EE\u524D\uFF0C\u91D1\u6676\u79D1\u6280\u9A6C\u6765\u897F\u4E9A\u516C\u53F8\u73B0\u6709\u5458\u5DE5740\u4EBA\uFF0C\u4E2D\u56FD\u5916\u6D3E\u5458\u5DE5\u536010%\uFF0C\u751F\u4EA7\u57FA\u672C\u5B9E\u73B0\u5C5E\u5730\u5316\u3002\u91D1\u6676\u79D1\u6280\u9A6C\u6765\u516C\u53F8\u79EF\u6781\u53C2\u4E0E\u5F53\u5730\u7684\u516C\u76CA\u4E8B\u4E1A\uFF0C\u53D7\u5230\u516C\u53F8\u6240\u5728\u5DDE\u653F\u5E9C\u7684\u9AD8\u5EA6\u80AF\u5B9A\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/10/frc-51153964426ecf142ebbc6a24e47b36a.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u91D1\u6676\u79D1\u6280\u8868\u793A\uFF0C\u91D1\u6676\u9A6C\u6765\u897F\u4E9A\u4E00\u671F\u3001\u4E8C\u671F\u9879\u76EE\u7684\u987A\u5229\u63A8\u8FDB\u6807\u5FD7\u7740\u516C\u53F8\u7EFF\u8272\u80FD\u6E90\u6218\u7565\u4E0E\u4E2D\u56FD\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u5021\u8BAE\u7684\u53CC\u5411\u5954\u8D74\u3002\u9A6C\u6765\u897F\u4E9A\u57FA\u5730\u7684\u5EFA\u6210\u4E0D\u4EC5\u5E26\u52A8\u5F53\u5730\u5C45\u6C11\u7684\u5C31\u4E1A\uFF0C\u4FC3\u8FDB\u5F53\u5730\u7ECF\u6D4E\u7EFF\u8272\u53EF\u6301\u7EED\u53D1\u5C55\uFF0C\u540C\u65F6\u4E5F\u5C06\u4E2D\u56FD\u5148\u8FDB\u7684\u5149\u4F0F\u6280\u672F\u5E26\u5230\u5171\u5EFA\u56FD\u5BB6\uFF0C\u63D0\u5347\u672C\u571F\u7684\u5149\u4F0F\u5E94\u7528\u6C34\u5E73\uFF0C\u63A8\u52A8\u5149\u4F0F\u4EA7\u4E1A\u7684\u4E92\u8054\u4E92\u901A\u3002\u51ED\u501F\u4E16\u754C\u7EA7\u7684\u751F\u4EA7\u5DE5\u5382\u3001\u667A\u80FD\u5316\u7684\u5236\u9020\u8BBE\u5907\u548C\u5168\u7403\u5316\u7684\u4F9B\u5E94\u94FE\u7CFB\u7EDF\uFF0C\u91D1\u6676\u9A6C\u6765\u897F\u4E9A\u5C06\u6210\u4E3A\u4E00\u5BB6\u9762\u5411\u672A\u6765\u7684\u56FD\u9645\u592A\u9633\u80FD\u73BB\u7483\u5353\u8D8A\u63D0\u4F9B\u5546\u3002\u003C/p\u003E\n\u003Cp\u003E\u672A\u6765\uFF0C\u516C\u53F8\u5C06\u79EF\u6781\u878D\u5165\u56FD\u5BB6\u7ECF\u6D4E\u53D1\u5C55\u5927\u5C40\uFF0C\u6C47\u805A\u5168\u7403\u529B\u91CF\uFF0C\u6DF1\u5316\u79D1\u6280\u521B\u65B0\u3001\u52A0\u5FEB\u6570\u5B57\u5316\u53CA\u667A\u80FD\u5316\u8F6C\u578B\u3001\u8DF5\u884C\u7EFF\u8272\u4F4E\u78B3\u53D1\u5C55\uFF0C\u52A9\u529B\u6784\u5EFA\u5BCC\u6709\u97E7\u6027\u7684\u5168\u7403\u5149\u4F0F\u4EA7\u4E1A\u94FE\uFF0C\u5171\u540C\u64D8\u753B\u5149\u4F0F\u4EA7\u4E1A\u9AD8\u8D28\u91CF\u53D1\u5C55\u84DD\u56FE\u3002\u003C/p\u003E\n\u003Cp\u003E\u672C\u6587\u6E90\u81EA\uFF1A\u91D1\u878D\u754C\u8D44\u8BAF\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/anOk49P6UF0nhs0h_eftGA\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
