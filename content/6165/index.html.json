{
  "id": "\u9A6C\u6765\u897F\u4E9A\u5143\u8001\u7EA7\u6253\u5361\u70B9\u5929\u7A7A\u4E4B\u955C",
  "slug": "\u9A6C\u6765\u897F\u4E9A\u5143\u8001\u7EA7\u6253\u5361\u70B9\u5929\u7A7A\u4E4B\u955C",
  "canonicalUrlKey": "\u9A6C\u6765\u897F\u4E9A\u5143\u8001\u7EA7\u6253\u5361\u70B9\u5929\u7A7A\u4E4B\u955C",
  "route": "/6165/",
  "title": "\uD83C\uDDF2\uD83C\uDDFE\u9A6C\u6765\u897F\u4E9A\u5143\u8001\u7EA7\u6253\u5361\u70B9\uFF5C\u5929\u7A7A\u4E4B\u955C\uD83C\uDF0A",
  "summary": "\u4F4D\u4E8E\u96EA\u5170\u83AA\u74DC\u62C9\u96EA\u5170\u83AA\u7684\u300C\u5929\u7A7A\u4E4B\u955C\u300D\uFF08Sky Mirror\uFF09\u88AB\u79F0\u4E3A\u9A6C\u6765\u897F\u4E9A\u7248\u7684\u4E4C\u5C24\u5C3C\u76D0\u6E56\u3002\u8FD9\u7247\u6D77\u5E8A\u53EA\u5728\u9000\u6F6E\u65F6\u9732\u51FA\u6C34\u9762\uFF0C\u5F62\u6210\u9762\u79EF\u76F8\u5F53\u4E8E\u4E0A\u767E\u4E2A\u8DB3\u7403\u573A\u7684\u8FBD\u9614\u6C99\u6EE9\uFF0C\u84DD\u5929\u767D\u4E91\u5012\u6620\u5176\u4E2D\uFF0C\u4EBA\u5982\u884C\u8D70\u4E8E\u53E6\u4E00\u7247\u5929\u7A7A\u3002\u5B83\u6BCF\u5929\u4EC5\u5728\u7279\u5B9A\u9000\u6F6E\u65F6\u6BB5\u51FA\u73B0\u7EA63\u81F34\u5C0F\u65F6\uFF0C\u4E14\u53EA\u5728\u519C\u5386\u521D\u4E00\u3001\u521D\u4E8C\u3001\u5341\u56DB\u3001\u5341\u4E94\u3001\u5341\u516D\u548C\u4E09\u5341\u624D\u6709\u673A\u4F1A\u89C2\u8D4F\u3002\u4ECE\u5409\u9686\u5761\u51FA\u53D1\u7EA61\u5C0F\u65F6\u8F66\u7A0B\uFF0C\u4ECE\u9002\u8015\u5E84\u51FA\u53D1\u7EA630\u5206\u949F\u53EF\u8FBE\u51FA\u6D77\u70B9\uFF0C\u884C\u7A0B\u4EF7\u683C\u4ECERM90\u8D77\uFF0C\u662F\u96EA\u5170\u83AA\u8FD1\u5E74\u6700\u53D7\u65C5\u5BA2\u6B22\u8FCE\u7684\u6253\u5361\u79D8\u5883\u4E4B\u4E00\u3002",
  "body": "\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u7ECF\u5178\u6253\u5361\u70B9\u003C/p\u003E\n\u003Cp\u003E\u300C\u5929\u7A7A\u4E4B\u955C Sky Mirror\u300D\u2601\uFE0F\u003C/p\u003E\n\u003Cp\u003E\u88AB\u620F\u79F0\u4E3A\u9A6C\u6765\u897F\u4E9A\u7684\u4E4C\u5C24\u5C3C\u76D0\u6E56\uFF0C\u003C/p\u003E\n\u003Cp\u003E\u56E0\u5176\u6709\u7740\u6D77\u5929\u76F8\u8FDE\u7684\u8FF7\u4EBA\u53CD\u5C04\u666F\u8C61\uFF0C\u003C/p\u003E\n\u003Cp\u003E\u4E5F\u56E0\u6B64\u6210\u4E3A\u4E0D\u5C11\u65C5\u5BA2\u4E89\u76F8\u6253\u5361\u7684\u68A6\u5E7B\u79D8\u5883\u0026#127775;\u003C/p\u003E\n\u003Cp\u003E\u0026#127965;\uFE0F\u8FD9\u5EA7\u795E\u79D8\u6D77\u5C9B\u80CC\u540E\u7684\u6545\u4E8B\u003C/p\u003E\n\u003Cp\u003E\u65E9\u57282016\u5E74\u521D\uFF0C\u300C\u5929\u7A7A\u4E4B\u955C\u300D\u8FD8\u9C9C\u4E3A\u4EBA\u77E5\uFF0C\u662F\u53EA\u6709\u5F53\u5730\u4EBA\u624D\u77E5\u9053\u7684\u79D8\u5883\u3002\u76F4\u5230\u4E00\u7FA4\u65C5\u6E38\u7231\u597D\u8005\u0026#129523;\uFF0C\u4ECE\u6E14\u592B\u53E3\u4E2D\u5F97\u77E5\u8FD9\u5EA7\u795E\u79D8\u5C0F\u5C9B\u7684\u5B58\u5728\uFF0C\u51B3\u5B9A\u4EB2\u81EA\u524D\u5F80\u4E00\u63A2\u7A76\u7ADF\uFF0C\u624D\u610F\u5916\u53D1\u73B0\u8FD9\u7247\u955C\u9762\u822C\u7684\u7F8E\u666F\u3002\u003C/p\u003E\n\u003Cp\u003E\u0026#127754;\u9000\u6F6E\u540E\u624D\u4F1A\u51FA\u73B0\u7684\u79D8\u5883\u003C/p\u003E\n\u003Cp\u003E\u5929\u7A7A\u4E4B\u955C\u5176\u5B9E\u662F\u4E00\u7247\u6D77\u5E8A\uFF01\u65E9\u6668\u9000\u6F6E\u65F6\uFF0C\u539F\u672C\u9690\u85CF\u5728\u6D77\u6C34\u4E0B\u7684\u6C99\u5730\u4FBF\u4F1A\u9010\u6E10\u9732\u51FA\u6C34\u9762\uFF0C\u5F62\u6210\u4E00\u7247\u8FBD\u9614\u7684\u6C99\u6EE9\uFF0C\u9762\u79EF\u751A\u81F3\u76F8\u5F53\u4E8E\u4E0A\u767E\u4E2A\u8DB3\u7403\u573A\uFF01\u26BD\u003C/p\u003E\n\u003Cp\u003E\u800C\u8FD9\u7247\u795E\u5947\u7684\u6C99\u5730\uFF0C\u6BCF\u5929\u53EA\u4F1A\u5728\u7279\u5B9A\u7684\u9000\u6F6E\u65F6\u6BB5\u51FA\u73B0\u7EA6 3-4\u5C0F\u65F6\u3002\u003C/p\u003E\n\u003Cp\u003E\u84DD\u5929\u767D\u4E91\u5012\u6620\u5176\u4E2D\uFF0C\u53CC\u811A\u4EFF\u4F5B\u8E29\u5728\u53E6\u4E00\u7247\u5929\u7A7A\u4E0A\uFF0C\u6B64\u65F6\u7684\u666F\u8C61\u7F8E\u5F97\u8BA9\u4EBA\u53F9\u4E3A\u89C2\u6B62\u0026#129321;\u003C/p\u003E\n\u003Cp\u003E\u0026#127769;\u4F9D\u636E\u7279\u5B9A\u89C4\u5F8B\u201C\u4E0A\u73ED\u201D\u7684\u795E\u79D8\u666F\u70B9\u003C/p\u003E\n\u003Cp\u003E\u539F\u6765\uFF0C\u5929\u7A7A\u4E4B\u955C\u51FA\u73B0\u7684\u65F6\u95F4\u0026#128338;\uFF0C\u8FD8\u85CF\u7740\u4E00\u4E2A\u7279\u522B\u7684\u89C4\u5F8B\uFF01\u003C/p\u003E\n\u003Cp\u003E\u6839\u636E\u519C\u5386\u0026#128197;\uFF0C\u53EA\u6709\u6BCF\u4E2A\u6708\u7684\u521D\u4E00\u3001\u521D\u4E8C\u3001\u5341\u56DB\u3001\u5341\u4E94\u3001\u5341\u516D\u548C\u4E09\u5341\uFF0C\u624D\u6709\u673A\u4F1A\u6B23\u8D4F\u5230\u6D77\u5929\u76F8\u8FDE\u7684\u7EDD\u7F8E\u666F\u81F4\u0026#127748;\u003C/p\u003E\n\u003Cp\u003E\u5982\u679C\u60F3\u8981\u4EB2\u773C\u89C1\u8BC1\u8FD9\u7247\u795E\u5947\u7684\u5883\u5730\uFF0C\u90A3\u5C31\u8BB0\u5F97\u89C4\u5212\u597D\u884C\u7A0B\u518D\u524D\u5F80\u5594\uFF01\u003C/p\u003E\n\u003Cp\u003E\u0026#128506;\uFE0F\u8F7B\u677E\u5C55\u5F00\u79D8\u5883\u63A2\u7D22\u4E4B\u65C5\u003C/p\u003E\n\u003Cp\u003E\u4F4D\u4E8E\u96EA\u5170\u83AA\u5DDE\u7684\u74DC\u62C9\u96EA\u5170\u83AA\uFF0C\u4ECE\u5409\u9686\u5761\u51FA\u53D1\u5927\u7EA6\u53EA\u9700 1\u5C0F\u65F6\u8F66\u7A0B\u0026#128663;\uFF0C\u5982\u679C\u4ECE\u9002\u8015\u5E84\u51FA\u53D1\uFF0C\u4E5F\u53EA\u9700\u7EA6 30\u5206\u949F\u5C31\u80FD\u62B5\u8FBE\u90BB\u8FD1\u7684\u51FA\u6D77\u5730\u70B9\uFF01\u003C/p\u003E\n\u003Cp\u003E\u5982\u679C\u662F\u4ECE\u5916\u5730\u98DE\u6765\u2708\uFE0F\uFF0C\u6700\u8FD1\u7684\u4E3B\u8981\u673A\u573A\u662F\u4F4D\u4E8E\u96EA\u90A6\u7684\u5409\u9686\u5761\u56FD\u9645\u673A\u573A\u3002\u003C/p\u003E\n\u003Cp\u003E\u2601\uFE0F\u5929\u7A7A\u4E4B\u955C Sky Mirror\u003C/p\u003E\n\u003Cp\u003E\u0026#128205;\u5730\u5740\uFF1AJalan Sultan Mahmud, 45000 Kuala Selangor, Selangor\u003C/p\u003E\n\u003Cp\u003E\u0026#128176;\u4EF7\u683C\uFF1A\u4ECERM90\u8D77\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/sz_mmbiz_jpg/p7Ria9Mp2k3pkYfDWZuImbBJOGVjjL2ww3y3pHpxEoFib3J3uyzKIkPLwHic8wlGN3G6bCp6LTC73FVBBndqhCnTbobbBY028ZmZIbXUNmfCOc/0?wx_fmt=jpeg\u0026amp;from=appmsg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/mmbiz_jpg/p7Ria9Mp2k3pib1bKG3tyvgEtbyW8Dr8dD7YNkzSTaWxR6G3ich8F3OiaiaxzeqBJLInqsZVclcaSpC7GasCcQ5RibCXia2n7pDlB93nRFsNXOyNpc/0?wx_fmt=jpeg\u0026amp;from=appmsg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/sz_mmbiz_jpg/p7Ria9Mp2k3oDIjm9ACtzexX0C92pAVaBIRicic2r1Ua4HcVIhBXib50JEiasycZp4R7k0FTUVBEbB4GUGbPR5ssPEpOlia7op6xP8jkcl2dXcJMU/0?wx_fmt=jpeg\u0026amp;from=appmsg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/sz_mmbiz_jpg/p7Ria9Mp2k3pmAHUypwN62cMibtE4W7ZDceWD9Mn7VEvAnZ1HQx4ibWoRDQy1xp71cattBuDZYI5zWT6iaEm4kia7g6MyrdYZ6JGTpIU7yEHcytY/0?wx_fmt=jpeg\u0026amp;from=appmsg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/mmbiz_jpg/p7Ria9Mp2k3quCUhnH7mFqoOho3xmoQ4k2DShCLJdqNCicib8ujV9ZmwHK0YSF1wXG3iafBBboFib88FFEpkHSev6u8D0nHtpeN724LzVic4Ba9Sc/0?wx_fmt=jpeg\u0026amp;from=appmsg\u0022 alt=\u0022\u0022 /\u003E\n",
