  "route": "/3628/",
  "title": "\u9A6C\u6765\u897F\u4E9A\u6606\u817E\u91D1\u5C5E\u96C6\u56E2\u4E0E\u6D77\u5357\u7701\u91D1\u4FC3\u4F1A\u7B7E\u7F72\u534F\u8BAE \u643A\u624B\u63A8\u52A8\u8D35\u91D1\u5C5E\u4EA4\u6613\u5E02\u573A\u5EFA\u8BBE",
  "summary": "\u65B0\u6D77\u5357\u5BA2\u6237\u7AEF\u3001\u5357\u6D77\u7F51\u3001\u5357\u56FD\u90FD\u5E02\u62A53\u670822\u65E5\u6D88\u606F\uFF08\u8BB0\u8005 \u4EFB\u6850 \u901A\u8BAF\u5458 \u738B\u5A77\uFF093\u670822\u65E5\uFF0C\u9A6C\u6765\u897F\u4E9A\u6606\u817E\u91D1\u5C5E\u96C6\u56E2\u4E0E\u6D77\u5357\u7701\u91D1\u878D\u53D1\u5C55\u4FC3\u8FDB\u4F1A\u7B7E\u8BA2\u5408\u4F5C\u6846\u67B6\u534F\u8BAE\u3002\u6839\u636E\u534F\u8BAE\uFF0C\u53CC\u65B9\u5C06\u5171\u540C\u63A8\u52A8\u6606\u817E\u91D1\u5C5E\u96C6\u56E2\u56FD\u9645\u8FD0\u8425\u603B\u90E8\u843D\u6237\u6D77\u5357\uFF0C\u5E76\u5C31\u6FB3\u5927\u5229\u4E9A\u91D1\u94F6\u94F6\u884C\u8BBE\u7ACB\u6D77\u5357\u5206\u884C\u7B49\u9879\u76EE\u5C55\u5F00\u6DF1\u5165\u5408\u4F5C\uFF0C\u63A8\u52A8RCEP\u80CC\u666F\u4E0B\u6D77\u5357\u81EA\u8D38\u6E2F\u8D35\u91D1\u5C5E\u4EA4\u6613\u5E02\u573A\u5EFA\u8BBE\u3002 3\u670822\u65E5\uFF0C\u9A6C\u6765\u897F\u4E9A\u6606\u817E\u91D1\u5C5E\u96C6\u56E2\u4E0E\u6D77\u5357\u7701\u91D1\u878D\u53D1\u5C55\u4FC3\u8FDB\u4F1A\u7B7E\u8BA2\u5408\u4F5C\u6846\u67B6\u534F\u8BAE\u3002\u8BB0\u8005 \u4EFB\u6850 \u6444 \u636E\u6089\uFF0C\u9A6C\u6765\u897F\u4E9A\u6606\u817E\u91D1\u5C5E\u6709\u9650\u516C\u53F8\u662FRCEP\u67B6\u6784\u4E0B\u8D35\u91D1\u5C5E\u9886\u57DF\u7684\u5934\u90E8\u4F01\u4E1A\uFF0C\u662F\u4E1C\u2026",
  "body": "\u003Cp\u003E\u65B0\u6D77\u5357\u5BA2\u6237\u7AEF\u3001\u5357\u6D77\u7F51\u3001\u5357\u56FD\u90FD\u5E02\u62A53\u670822\u65E5\u6D88\u606F\uFF08\u8BB0\u8005 \u4EFB\u6850 \u901A\u8BAF\u5458 \u738B\u5A77\uFF093\u670822\u65E5\uFF0C\u9A6C\u6765\u897F\u4E9A\u6606\u817E\u91D1\u5C5E\u96C6\u56E2\u4E0E\u6D77\u5357\u7701\u91D1\u878D\u53D1\u5C55\u4FC3\u8FDB\u4F1A\u7B7E\u8BA2\u5408\u4F5C\u6846\u67B6\u534F\u8BAE\u3002\u6839\u636E\u534F\u8BAE\uFF0C\u53CC\u65B9\u5C06\u5171\u540C\u63A8\u52A8\u6606\u817E\u91D1\u5C5E\u96C6\u56E2\u56FD\u9645\u8FD0\u8425\u603B\u90E8\u843D\u6237\u6D77\u5357\uFF0C\u5E76\u5C31\u6FB3\u5927\u5229\u4E9A\u91D1\u94F6\u94F6\u884C\u8BBE\u7ACB\u6D77\u5357\u5206\u884C\u7B49\u9879\u76EE\u5C55\u5F00\u6DF1\u5165\u5408\u4F5C\uFF0C\u63A8\u52A8RCEP\u80CC\u666F\u4E0B\u6D77\u5357\u81EA\u8D38\u6E2F\u8D35\u91D1\u5C5E\u4EA4\u6613\u5E02\u573A\u5EFA\u8BBE\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/03/frc-4ac40e51e748b2b2da5e120bc67f87eb.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E3\u670822\u65E5\uFF0C\u9A6C\u6765\u897F\u4E9A\u6606\u817E\u91D1\u5C5E\u96C6\u56E2\u4E0E\u6D77\u5357\u7701\u91D1\u878D\u53D1\u5C55\u4FC3\u8FDB\u4F1A\u7B7E\u8BA2\u5408\u4F5C\u6846\u67B6\u534F\u8BAE\u3002\u8BB0\u8005 \u4EFB\u6850 \u6444\u003C/p\u003E\n\u003Cp\u003E\u636E\u6089\uFF0C\u9A6C\u6765\u897F\u4E9A\u6606\u817E\u91D1\u5C5E\u6709\u9650\u516C\u53F8\u662FRCEP\u67B6\u6784\u4E0B\u8D35\u91D1\u5C5E\u9886\u57DF\u7684\u5934\u90E8\u4F01\u4E1A\uFF0C\u662F\u4E1C\u76DF\u5408\u4F5C\u7EC4\u7EC7\u9A6C\u6765\u897F\u4E9A\u5408\u4F5C\u793E\u6210\u5458\uFF0C\u662F\u9996\u5BB6\u5728\u5168\u7403\u8303\u56F4\u5185\u5B9E\u73B0\u4E86\u901A\u8FC7\u94F6\u884C\u7684\u5BA2\u6237\u7F51\u7EDC\u5C06\u91D1\u6761\u4EE5\u53CA\u7535\u5B50\u9EC4\u91D1\u4EA7\u54C1\u9500\u552E\u7ED9\u9A6C\u6765\u897F\u4E9A\u4E43\u81F3RCEP\u5408\u4F5C\u67B6\u6784\u4E0B\u56FD\u9645\u96F6\u552E\u5E02\u573A\u7684\u9EC4\u91D1\u8FD0\u8425\u5546\u3002\u003C/p\u003E\n\u003Cp\u003E\u6606\u817E\u91D1\u5C5E\u96C6\u56E2\u521B\u59CB\u4EBA\u517C\u6267\u884C\u603B\u88C1\u3001\u62FF\u7763\u6797\u5EC9\u987A\u8868\u793A\uFF0C\u901A\u8FC7\u63A8\u52A8\u6606\u817E\u91D1\u5C5E\u56FD\u9645\u8FD0\u8425\u603B\u90E8\u57FA\u5730\u4E0E\u91D1\u94F6\u94F6\u884C\u6D77\u5357\u5206\u884C\u7684\u843D\u5730\uFF0C\u5C06\u6709\u6548\u76D8\u6D3BRECP\u6210\u5458\u533A\u57DF\u5185\u8D35\u91D1\u5C5E\u4EA4\u6613\u4E13\u4E1A\u4EBA\u624D\u8D44\u6E90\uFF0C\u6FC0\u53D1\u4EBA\u624D\u6D3B\u529B\uFF0C\u4FC3\u8FDB\u76F8\u5173\u9886\u57DF\u7684\u670D\u52A1\u8D38\u6613\uFF0C\u52A0\u5FEB\u9EC4\u91D1\u7EBF\u4E0A\u4EA4\u6613\u4E0E\u9EC4\u91D1\u6570\u5B57\u5316\u53D1\u5C55\u8FDB\u7A0B\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/03/frc-4f28d3f6932e649557c4e172ea6905c5.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E3\u670822\u65E5\uFF0C\u9A6C\u6765\u897F\u4E9A\u6606\u817E\u91D1\u5C5E\u96C6\u56E2\u4E0E\u6D77\u5357\u7701\u91D1\u878D\u53D1\u5C55\u4FC3\u8FDB\u4F1A\u7B7E\u8BA2\u5408\u4F5C\u6846\u67B6\u534F\u8BAE\u3002\u8BB0\u8005 \u4EFB\u6850\u6444\u003C/p\u003E\n\u003Cp\u003E\u6D77\u5357\u7701\u91D1\u878D\u53D1\u5C55\u4FC3\u8FDB\u4F1A\u526F\u4F1A\u957F\u738B\u4E3D\u5A05\u8868\u793A\uFF0C\u4F5C\u4E3A\u6D77\u5357\u91D1\u878D\u53D1\u5C55\u7684\u884C\u4E1A\u534F\u4F1A\uFF0C\u7701\u91D1\u4FC3\u4F1A\u4E00\u76F4\u79C9\u627F\u7740\u670D\u52A1\u653F\u5E9C\u3001\u670D\u52A1\u4F01\u4E1A\u3001\u670D\u52A1\u6295\u8D44\u8005\u7684\u5B97\u65E8\u3002\u4E0B\u4E00\u6B65\uFF0C\u7701\u91D1\u4FC3\u4F1A\u5C06\u6839\u636E\u9A6C\u6765\u897F\u4E9A\u6606\u817E\u91D1\u5C5E\u96C6\u56E2\u7684\u5B9E\u9645\u9700\u6C42\uFF0C\u5BF9\u63A5\u5404\u6709\u5173\u90E8\u95E8\uFF0C\u4E3A\u4ED6\u4EEC\u63D0\u4F9B\u76F8\u5173\u670D\u52A1\uFF0C\u4E89\u53D6\u5C3D\u5FEB\u4FC3\u6210\u8BE5\u96C6\u56E2\u843D\u6237\u6D77\u5357\uFF0C\u4ECE\u800C\u4FC3\u8FDB\u5168\u7701\u91D1\u878D\u4E1A\u53D1\u5C55\u3002\uFF08\u4EFB\u6850 \u738B\u5A77\uFF09\u003C/p\u003E\n\u003Cp\u003E\n\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/l6AjgRWZsnNd_BfTe0vXrw\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
