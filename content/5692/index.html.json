  "title": "\u6295\u8D443.8\u4EBF\u4EE4\u5409 \u6C90\u80F6\u5EFA\u592A\u9633\u80FD\u53D1\u7535\u5382",
  "summary": "\uFF08\u53E4\u664B3\u65E5\u8BAF\uFF09\u533A\u57DF\u6E05\u6D01\u80FD\u6E90\u4F01\u4E1ASolarvest\u63A7\u80A1\u6709\u9650\u516C\u53F8\u4ECA\u65E5\u5BA3\u5E03\uFF0C\u5176\u4E0EPress Metal\u6709\u9650\u516C\u53F8\u5408\u4F5C\u6210\u7ACB\u7684\u7279\u522B\u9879\u76EE\u516C\u53F8\u201C\u6C90\u80F6\u592A\u9633\u80FD\u79C1\u4EBA\u6709\u9650\u516C\u53F8\u201C\uFF08Mukah Solar Powerplant Sdn. Bhd\uFF09\u5DF2\u4E0E\u7802\u62C9\u8D8A\u80FD\u6E90\u6709\u9650\u516C\u53F8\u5168\u8D44\u5B50\u516C\u53F8\u7802\u62C9\u8D8A\u7535\u529B\u6709\u9650\u516C\u53F8\u7B7E\u7F72\u8D2D\u7535\u534F\u8BAE\uFF0C\u5C06\u5728\u7802\u62C9\u8D8A\u6C90\u80F6\u5174\u5EFA\u4E00\u5EA7100\u5146\u74E6\u4EA4\u6D41\u592A\u9633\u80FD\u53D1\u7535\u5382\u3002 \u6839\u636E\u534F\u8BAE\uFF0C\u6C90\u80F6\u592A\u9633\u80FD\u79C1\u4EBA\u6709\u9650\u516C\u53F8\u5C06\u8D1F\u8D23\u8BE5\u592A\u9633\u80FD\u7535\u7AD9\u7684\u8BBE\u8BA1\u3001\u5EFA\u8BBE\u3001\u62E5\u6709\u3001\u8FD0\u8425\u4E0E\u7EF4\u62A4\uFF0C\u9884\u8BA1\u4E8E2027\u5E7411\u670830\u65E5\u6B63\u5F0F\u6295\u5165\u5546\u4E1A\u8FD0\u4F5C\u3002\u9879\u2026",
  "body": "\u003Cp\u003E\uFF08\u53E4\u664B3\u65E5\u8BAF\uFF09\u533A\u57DF\u6E05\u6D01\u80FD\u6E90\u4F01\u4E1ASolarvest\u63A7\u80A1\u6709\u9650\u516C\u53F8\u4ECA\u65E5\u5BA3\u5E03\uFF0C\u5176\u4E0EPress Metal\u6709\u9650\u516C\u53F8\u5408\u4F5C\u6210\u7ACB\u7684\u7279\u522B\u9879\u76EE\u516C\u53F8\u201C\u6C90\u80F6\u592A\u9633\u80FD\u79C1\u4EBA\u6709\u9650\u516C\u53F8\u201C\uFF08Mukah Solar Powerplant Sdn. Bhd\uFF09\u5DF2\u4E0E\u7802\u62C9\u8D8A\u80FD\u6E90\u6709\u9650\u516C\u53F8\u5168\u8D44\u5B50\u516C\u53F8\u7802\u62C9\u8D8A\u7535\u529B\u6709\u9650\u516C\u53F8\u7B7E\u7F72\u8D2D\u7535\u534F\u8BAE\uFF0C\u5C06\u5728\u7802\u62C9\u8D8A\u6C90\u80F6\u5174\u5EFA\u4E00\u5EA7100\u5146\u74E6\u4EA4\u6D41\u592A\u9633\u80FD\u53D1\u7535\u5382\u3002\u003C/p\u003E\n\u003Cp\u003E\u6839\u636E\u534F\u8BAE\uFF0C\u6C90\u80F6\u592A\u9633\u80FD\u79C1\u4EBA\u6709\u9650\u516C\u53F8\u5C06\u8D1F\u8D23\u8BE5\u592A\u9633\u80FD\u7535\u7AD9\u7684\u8BBE\u8BA1\u3001\u5EFA\u8BBE\u3001\u62E5\u6709\u3001\u8FD0\u8425\u4E0E\u7EF4\u62A4\uFF0C\u9884\u8BA1\u4E8E2027\u5E7411\u670830\u65E5\u6B63\u5F0F\u6295\u5165\u5546\u4E1A\u8FD0\u4F5C\u3002\u9879\u76EE\u6295\u8D44\u989D\u7EA63\u4EBF8000\u4E07\u4EE4\u5409\uFF0C\u4E3B\u8981\u901A\u8FC7\u94F6\u884C\u878D\u8D44\uFF0CSolarvest\u5219\u4EE5\u5185\u90E8\u8D44\u91D1\u627F\u62C5\u81EA\u6709\u80A1\u6743\u90E8\u5206\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/sz_mmbiz_png/uKucKpKOlXKDvZClSrAuWOE7MDTIPvXvvicXXicLIWlmODbtrAF8H1b1LPpKDBXicKVETHlNrqlNxAAgTy5ru2vDg/640?wx_fmt=png\u0026amp;from=appmsg\u0026amp;tp=webp\u0026amp;wxfrom=5\u0026amp;wx_lazy=1#imgIndex=7\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u6C90\u80F6\u592A\u9633\u80FD\u79C1\u4EBA\u6709\u9650\u516C\u53F8\u7684\u80A1\u6743\u7ED3\u6784\u4E3ASolarvest\u95F4\u63A5\u5168\u8D44\u5B50\u516C\u53F8Solarvest\u8D44\u4EA7\u7BA1\u7406\uFF08\u5A46\u7F57\u6D32\uFF09\u79C1\u4EBA\u6709\u9650\u516C\u53F8\u6301\u670960%\u80A1\u6743\uFF0CPress Metal\u94DD\u63A7\u80A1\u6709\u9650\u516C\u53F8\u95F4\u63A5\u5168\u8D44\u5B50\u516C\u53F8Press Metal\u6709\u9650\u516C\u53F8\u6301\u670940%\u80A1\u6743\u3002\u003C/p\u003E\n\u003Cp\u003ESolarvest\u6267\u884C\u8463\u4E8B\u517C\u96C6\u56E2\u9996\u5E2D\u6218\u7565\u5458\u5218\u9A90\u82F1\u8868\u793A\uFF0C\u8FD9\u4E00\u9879\u76EE\u662F\u7802\u62C9\u8D8A\u518D\u751F\u80FD\u6E90\u53D1\u5C55\u7684\u91CD\u8981\u91CC\u7A0B\u7891\uFF0C\u4E5F\u662F\u7802\u62C9\u8D8A\u6700\u5927\u89C4\u6A21\u7684\u6E05\u6D01\u80FD\u6E90\u5DE5\u7A0B\u4E4B\u4E00\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6307\u51FA\uFF0C\u6C90\u80F6\u592A\u9633\u80FD\u7535\u5382\u5EFA\u6210\u540E\uFF0C\u6BCF\u5E74\u9884\u8BA1\u53EF\u51CF\u5C11\u7EA64\u4E076000\u5428\u4E8C\u6C27\u5316\u78B3\u6392\u653E\uFF0C\u63A8\u52A8\u9A6C\u6765\u897F\u4E9A\u8FC8\u5411\u4F4E\u78B3\u7ECF\u6D4E\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8865\u5145\uFF0C\u8BE5\u9879\u76EE\u4E0E\u7802\u62C9\u8D8A\u80FD\u6E90\u8F6C\u578B\u7B56\u7565\u53CA\u7802\u62C9\u8D8A2030\u5E74\u540E\u75AB\u60C5\u53D1\u5C55\u7B56\u7565\u9AD8\u5EA6\u5951\u5408\uFF0C\u4E24\u5927\u6846\u67B6\u76EE\u6807\u662F2030\u5E74\u5B9E\u73B010\u5409\u74E6\uFF08GW\uFF09\u88C5\u673A\u5BB9\u91CF\uFF0C2035\u5E74\u63D0\u5347\u81F315\u5409\u74E6\uFF0C\u5E76\u786E\u4FDD\u81F3\u5C11\u516D\u6210\u80FD\u6E90\u6765\u81EA\u53EF\u518D\u751F\u80FD\u6E90\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u6C90\u80F6\u592A\u9633\u80FD\u53D1\u7535\u5382\u4E0D\u4EC5\u662F\u4E00\u9879\u53D1\u7535\u5DE5\u7A0B\uFF0C\u66F4\u662F\u52A9\u529B\u7802\u62C9\u8D8A\u6210\u4E3A\u533A\u57DF\u518D\u751F\u80FD\u6E90\u67A2\u7EBD\u7684\u91CD\u8981\u50AC\u5316\u5242\u3002\u003C/p\u003E\n\u003Cp\u003ESolarvest\u9884\u8BA1\uFF0C\u8BE5\u9879\u76EE\u5C06\u5728\u65BD\u5DE5\u53CA\u8425\u8FD0\u9636\u6BB5\u521B\u90201500\u81F32000\u4E2A\u76F4\u63A5\u548C\u95F4\u63A5\u5C31\u4E1A\u673A\u4F1A\uFF0C\u4E3A\u5F53\u5730\u793E\u533A\u5E26\u6765\u7ECF\u6D4E\u6548\u76CA\uFF0C\u5E76\u63A8\u52A8\u4E61\u533A\u5728\u6E05\u6D01\u80FD\u6E90\u8F6C\u578B\u4E2D\u7684\u79EF\u6781\u89D2\u8272\u3002\u003C/p\u003E\n\u003Cp\u003E\u6B64\u5916\uFF0CSolarvest\u4E5F\u901A\u8FC7\u7EFF\u8272\u80FD\u6E90\u6295\u8D44\u3001\u6280\u672F\u5408\u4F5C\u53CA\u5C31\u4E1A\u673A\u4F1A\uFF0C\u4E3A\u7802\u62C9\u8D8A\u7ECF\u6D4E\u6CE8\u5165\u65B0\u52A8\u529B\u3002\u4E0E\u7802\u62C9\u8D8A\u79D1\u6280\u5353\u8D8A\u4E2D\u5FC3\u53CA\u534E\u4E3A\uFF08\u9A6C\u6765\u897F\u4E9A\uFF09\u5408\u4F5C\u7684\u7EFF\u8272\u80FD\u6E90\u5B9E\u9A8C\u5BA4\uFF0C\u81EA2023\u5E74\u542F\u52A8\u4EE5\u6765\uFF0C\u8BA1\u5212\u57285\u5E74\u5185\u57F9\u8BAD\u8D85\u8FC71000\u540D\u7802\u62C9\u8D8A\u4EBA\uFF0C\u638C\u63E1\u592A\u9633\u80FD\u53CA\u7EFF\u8272\u80FD\u6E90\u6280\u672F\u6280\u80FD\uFF0C\u4E3A\u80FD\u6E90\u8F6C\u578B\u57F9\u517B\u66F4\u591A\u4EBA\u624D\u3002\u003C/p\u003E\n\u003Cp\u003E\u5218\u9A90\u82F1\u5F3A\u8C03\uFF0C\u6C90\u80F6\u9879\u76EE\u4E0D\u4EC5\u5C06\u63A8\u52A8Solarvest\u5728\u7802\u62C9\u8D8A\u8BBE\u8BA1\u3001\u91C7\u8D2D\u3001\u65BD\u5DE5\u53CA\u8C03\u8BD5\u5E02\u573A\u7684\u62D3\u5C55\uFF0C\u4E5F\u9884\u8BA1\u5E26\u52A8\u96C6\u56E2\u8BA2\u5355\u603B\u989D\u5728\u672C\u8D22\u5E74\u672B\u7A81\u783430\u4EBF\u4EE4\u5409\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u4EEC\u5C06\u6301\u7EED\u6DF1\u8015\u7802\u62C9\u8D8A\uFF0C\u643A\u624B\u6210\u4E3A\u63A8\u52A8\u6E05\u6D01\u80FD\u6E90\u4E0E\u53EF\u6301\u7EED\u7ECF\u6D4E\u53D1\u5C55\u7684\u957F\u671F\u5408\u4F5C\u4F19\u4F34\u3002\u201D\u003C/p\u003E\n",
