  "slug": "\u96EA\u5170\u83AA\u7F8E\u98DF\u5730\u56FE\u4E0A\u7EBF\u7528\u5473\u857E\u63A2\u7D22\u8FD9\u5EA7\u57CE",
  "canonicalUrlKey": "\u96EA\u5170\u83AA\u7F8E\u98DF\u5730\u56FE\u4E0A\u7EBF\u7528\u5473\u857E\u63A2\u7D22\u8FD9\u5EA7\u57CE",
  "route": "/6156/",
  "title": "\u96EA\u5170\u83AA\u7F8E\u98DF\u5730\u56FE\u4E0A\u7EBF\uFF5E\u7528\u5473\u857E\u63A2\u7D22\u8FD9\u5EA7\u57CE\uFF01",
  "summary": "\u96EA\u5170\u83AA\u7F8E\u98DF\u5730\u56FE\u4E0A\u7EBF\uFF0C\u9080\u8BF7\u8BFB\u8005\u7528\u5473\u857E\u63A2\u7D22\u8FD9\u5EA7\u57CE\u3002\u5E16\u6587\u5199\u9053\uFF1A\u5F53\u4F20\u7EDF\u5E95\u8574\u9047\u4E0A\u73B0\u4EE3\u521B\u610F\uFF0C\u96EA\u5170\u83AA\u7684\u6BCF\u4E00\u79CD\u98CE\u5473\u90FD\u627F\u8F7D\u7740\u4E00\u6BB5\u503C\u5F97\u63A2\u7D22\u7684\u6545\u4E8B\uFF1B\u4ECE\u8857\u5934\u5DF7\u5C3E\u7684\u5730\u9053\u98CE\u5473\u5230\u7CBE\u81F4\u4F18\u96C5\u7684\u820C\u5C16\u76DB\u5BB4\uFF0C\u8FD9\u4E00\u6B21\u7528\u5473\u857E\u91CD\u65B0\u8BA4\u8BC6\u96EA\u5170\u83AA\u3002\u6587\u672B\u63D0\u5230\u300CSignature Selangor\u300D\u5B8C\u6574\u7248\u4F53\u9A8C\u5DF2\u4E0A\u7EBF\uFF0C\u9080\u8BF7\u8BFB\u8005\u8DDF\u968F\u89C6\u9891\u5F00\u542F\u4E13\u5C5E\u96EA\u5170\u83AA\u7684\u5BFB\u5473\u4E4B\u65C5\uFF0C\u5E76\u9644\u4E0A#\u9B45\u529B\u96EA\u5170\u83AA\u3001#VisitSelangor2026 \u7B49\u8BDD\u9898\u6807\u7B7E\u3002",
  "body": "\u003Cp\u003E\u5F53\u4F20\u7EDF\u5E95\u8574\u9047\u4E0A\u73B0\u4EE3\u521B\u610F\u003C/p\u003E\n\u003Cp\u003E\u96EA\u5170\u83AA\u7684\u6BCF\u4E00\u79CD\u98CE\u5473\u0026#127881;\u003C/p\u003E\n\u003Cp\u003E\u90FD\u627F\u8F7D\u7740\u4E00\u6BB5\u503C\u5F97\u63A2\u7D22\u7684\u6545\u4E8B\u003C/p\u003E\n\u003Cp\u003E\u4ECE\u8857\u5934\u5DF7\u5C3E\u7684\u5730\u9053\u98CE\u5473\u003C/p\u003E\n\u003Cp\u003E\u5230\u7CBE\u81F4\u4F18\u96C5\u7684\u820C\u5C16\u76DB\u5BB4\u0026#128523;\u003C/p\u003E\n\u003Cp\u003E\u8FD9\u4E00\u6B21\uFF0C\u8BA9\u6211\u4EEC\u7528\u5473\u857E\u91CD\u65B0\u8BA4\u8BC6\u96EA\u5170\u83AA\u003C/p\u003E\n\u003Cp\u003E\u4E3A\u6ECB\u5473\u800C\u6765\uFF0C\u4E3A\u4F53\u9A8C\u800C\u7559\u003C/p\u003E\n\u003Cp\u003E\u8FD9\u4E0D\u4EC5\u662F\u4E00\u573A\u7F8E\u98DF\u7684\u5DE1\u793C\u2708\uFE0F\u003C/p\u003E\n\u003Cp\u003E\u66F4\u662F\u4E00\u573A\u89E6\u52A8\u5FC3\u7075\u7684\u611F\u5B98\u65C5\u7A0B\u2728\u003C/p\u003E\n\u003Cp\u003E\u0026#127916;\u300CSignature Selangor\u300D\u5B8C\u6574\u7248\u4F53\u9A8C\u73B0\u5DF2\u4E0A\u7EBF\uFF01\u003C/p\u003E\n\u003Cp\u003E\u8DDF\u7740\u6211\u4EEC\u4E00\u8D77\u5F00\u542F\u8FD9\u573A\u4E13\u5C5E\u96EA\u5170\u83AA\u7684\u5BFB\u5473\u4E4B\u65C5\u5427 \uFF01\u003C/p\u003E\n\u003Cp\u003E#\u9B45\u529B\u96EA\u5170\u83AA #\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38 #\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38\u653B\u7565 #\u9A6C\u6765\u897F\u4E9A\u96EA\u5170\u83AA #VisitSelangor2026 #\u96EA\u5170\u83AA\u60CA\u559C\u8FDE\u8FDE #\u96EA\u5170\u83AA\u65C5\u6E38\u003C/p\u003E\n",
