  "title": "\u9A6C\u4E2D\u4F01\u4E1A\u7B7E\u7F724\u9879\u76EE\u534F\u8BAE \u6295\u8D44\u603B\u989D\u8D8570\u4EBF",
  "summary": "\uFF08\u5409\u9686\u576129\u65E5\u8BAF\uFF09\u4E2D\u56FD\u4F01\u4E1A\u5468\u56DB\uFF0825\u65E5\uFF09\u4E0E\u5927\u9A6C\u4F01\u4E1A\u9488\u5BF94\u9879\u53D1\u5C55\u9879\u76EE\u7B7E\u7F72\u534F\u8BAE\uFF0C\u4EE5\u5171\u540C\u5728\u9A6C\u63A8\u52A8\u8FD9\u4E9B\u9879\u76EE\u7684\u53D1\u5C55\uFF0C\u6295\u8D44\u603B\u989D\u6599\u9AD8\u8FBE70\u4EBF1200\u4E07\u5143\u4EBA\u6C11\u5E01\uFF08\u7EA646\u4EBF2300\u4E07\u4EE4\u5409\uFF09\u3002 \u8FD9\u4E9B\u9879\u76EE\u5305\u62EC\u9F99\u7535\u534E\u946B\u5173\u4E39\u4E2D\u9A6C\u4EA7\u4E1A\u56ED\u9502\u7535\u94DC\u7B94\uFF1B\u4E2D\u9A6C\u6C34\u52A1\u4E0E\u73AF\u4FDD\u4E1A\u52A1\u5408\u4F5C\uFF1B\u54EA\u5412\u6C7D\u8F66\u5927\u9A6C\u672C\u5730\u5316\u751F\u4EA7\uFF1B\u4EE5\u53CA\u201C\u4E00\u7801\u901A\u57CE\u201D\u5927\u9A6C\u667A\u6167\u51FA\u884C\u548C\u666F\u533A\u8D2D\u7968\u7B49\u573A\u666F\u5E94\u7528\u9879\u76EE\u3002 \u6B64\u5916\uFF0C\u9879\u76EE\u5408\u4F5C\u7684\u9886\u57DF\u5C06\u6D89\u53CA\u65B0\u80FD\u6E90\u6C7D\u8F66\u53CA\u96F6\u90E8\u4EF6\u3001\u8282\u80FD\u73AF\u4FDD\u4E0E\u6570\u7801\u7ECF\u6D4E\u3002 \u4E2D\u56FD\u4E0E\u5927\u9A6C\u4F01\u4E1A\u4EE3\u8868\u9488\u5BF94\u9879\u53D1\u5C55\u9879\u76EE\u7B7E\u7F72\u534F\u8BAE \u4E2D\u56FD\u4F01\u4E1A\u4E0E\u5927\u9A6C\u4F01\u4E1A\u662F\u5728\u5357\u5B81\u5E02\u2026",
  "body": "\u003Cp\u003E\uFF08\u5409\u9686\u576129\u65E5\u8BAF\uFF09\u4E2D\u56FD\u4F01\u4E1A\u5468\u56DB\uFF0825\u65E5\uFF09\u4E0E\u5927\u9A6C\u4F01\u4E1A\u9488\u5BF94\u9879\u53D1\u5C55\u9879\u76EE\u7B7E\u7F72\u534F\u8BAE\uFF0C\u4EE5\u5171\u540C\u5728\u9A6C\u63A8\u52A8\u8FD9\u4E9B\u9879\u76EE\u7684\u53D1\u5C55\uFF0C\u6295\u8D44\u603B\u989D\u6599\u9AD8\u8FBE70\u4EBF1200\u4E07\u5143\u4EBA\u6C11\u5E01\uFF08\u7EA646\u4EBF2300\u4E07\u4EE4\u5409\uFF09\u3002\u003C/p\u003E\n\u003Cp\u003E\u8FD9\u4E9B\u9879\u76EE\u5305\u62EC\u9F99\u7535\u534E\u946B\u5173\u4E39\u4E2D\u9A6C\u4EA7\u4E1A\u56ED\u9502\u7535\u94DC\u7B94\uFF1B\u4E2D\u9A6C\u6C34\u52A1\u4E0E\u73AF\u4FDD\u4E1A\u52A1\u5408\u4F5C\uFF1B\u54EA\u5412\u6C7D\u8F66\u5927\u9A6C\u672C\u5730\u5316\u751F\u4EA7\uFF1B\u4EE5\u53CA\u201C\u4E00\u7801\u901A\u57CE\u201D\u5927\u9A6C\u667A\u6167\u51FA\u884C\u548C\u666F\u533A\u8D2D\u7968\u7B49\u573A\u666F\u5E94\u7528\u9879\u76EE\u3002\u003C/p\u003E\n\u003Cp\u003E\u6B64\u5916\uFF0C\u9879\u76EE\u5408\u4F5C\u7684\u9886\u57DF\u5C06\u6D89\u53CA\u65B0\u80FD\u6E90\u6C7D\u8F66\u53CA\u96F6\u90E8\u4EF6\u3001\u8282\u80FD\u73AF\u4FDD\u4E0E\u6570\u7801\u7ECF\u6D4E\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/05/frc-d10fb3ac97c403e85b3c4dc5d0a1e902.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u4E2D\u56FD\u4E0E\u5927\u9A6C\u4F01\u4E1A\u4EE3\u8868\u9488\u5BF94\u9879\u53D1\u5C55\u9879\u76EE\u7B7E\u7F72\u534F\u8BAE\u003C/p\u003E\n\u003Cp\u003E\u4E2D\u56FD\u4F01\u4E1A\u4E0E\u5927\u9A6C\u4F01\u4E1A\u662F\u5728\u5357\u5B81\u5E02\u4EBA\u6C11\u653F\u5E9C\u4E3B\u529E\u7684\u4E2D\u56FD\u5357\u5B81\u5E02\u6295\u8D44\u73AF\u5883\u63A8\u4ECB\u66A8\u7ECF\u8D38\u5408\u4F5C\u4EA4\u6D41\u4F1A\u4E0A\u7B7E\u7F72\u8FD94\u9879\u534F\u8BAE\u3002\u81F3\u4E8E\u627F\u529E\u5355\u4F4D\u4E3A\u5357\u5B81\u5E02\u6295\u8D44\u4FC3\u8FDB\u5C40\u3001\u5357\u5B81\u5E02\u5916\u4E8B\u529E\u516C\u5BA4\uFF0C\u652F\u6301\u5355\u4F4D\u5219\u5305\u62EC\u9A6C\u4E2D\u534E\u603B\u5546\u4F1A\u4E0E\u5927\u9A6C\u6842\u5546\u603B\u4F1A\u3002\u003C/p\u003E\n\u003Cp\u003E\u89C1\u8BC1\u8FD9\u4E00\u6B21\u9A6C\u4E2D\u4F01\u4E1A\u5408\u4F5C\u4E0E\u4EA4\u6D41\u7684\u4E9A\u6C99\u56FD\u4F1A\u8BAE\u5458\u8C22\u742A\u6E05\u6307\u51FA\uFF0C\u9A6C\u4E2D\u5EFA\u4EA4\u5DF2\u8FC8\u516510\u5468\u5E74\uFF0C\u53CC\u8FB9\u5728\u5404\u9886\u57DF\u5408\u4F5C\u4E0A\uFF0C\u5E76\u4E0D\u53EA\u5C40\u9650\u4E8E\u653F\u5E9C\u5BF9\u653F\u5E9C\uFF0C\u4E5F\u5305\u62EC\u6C11\u95F4\u56E2\u4F53\uFF0C\u5546\u8D38\u7EC4\u7EC7\u4E0E\u5404\u884C\u5404\u4E1A\u7684\u4EA4\u6D41\u548C\u6765\u5F80\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u76F8\u4FE1\uFF0C\u901A\u8FC7\u8FD9\u4E00\u6B21\u7684\u4EA4\u6D41\uFF0C\u5927\u9A6C\u4F01\u4E1A\u4E0E\u4E2D\u56FD\u5E7F\u897F\uFF0C\u5C24\u5176\u662F\u6765\u81EA\u5357\u5B81\u7684\u5546\u5BB6\u5C06\u80FD\u6709\u66F4\u597D\u7684\u8054\u7CFB\uFF0C\u5171\u540C\u5728\u5404\u9886\u57DF\u53D1\u9762\u53D6\u5F97\u63D0\u5347\u3002\u003C/p\u003E\n\u003Cp\u003E\u51FA\u5E2D\u63A8\u4ECB\u793C\u4E0E\u4EA4\u6D41\u4F1A\u8005\uFF0C\u5305\u62EC\u62C9\u676D\u533A\u5DDE\u8BAE\u5458\u8427\u5999\u5149\u3001\u53F2\u91CC\u80AF\u90A6\u5B89\u533A\u5DDE\u8BAE\u5458\u738B\u8BD7\u68CB\u3001\u4E2D\u56FD\u9A7B\u9A6C\u5927\u4F7F\u9986\u7ECF\u5546\u5904\u5B59\u6DD1\u5F3A\u516C\u53C2\u3001\u9A6C\u4E2D\u534E\u603B\u5546\u4F1A\u7F72\u7406\u603B\u4F1A\u957F\u517C\u591A\u7F8E\uFF08TOMEI\uFF0C7230\uFF0C\u4E3B\u8981\u677F\u6D88\u8D39\uFF09\u8463\u4E8B\u7ECF\u7406\u62FF\u7763\u5434\u9038\u5E73\u3001\u9A6C\u4E2D\u603B\u5546\u4F1A\u4E2D\u592E\u7406\u4E8B\u5085\u5E86\u9686\u5F8B\u5E08\u3001\u5927\u9A6C\u6842\u5546\u603B\u4F1A\u603B\u4F1A\u957F\u62FF\u7763\u5415\u6D77\u5EAD\u5C40\u7EC5\u3001\u4E2D\u56FD\u5E7F\u897F\u58EE\u65CF\u81EA\u6CBB\u533A\u515A\u59D4\u5E38\u59D4\u517C\u5357\u5B81\u5E02\u59D4\u4E66\u8BB0\u519C\u751F\u6587\u3001\u5357\u5B81\u5E02\u5E38\u59D4\u517C\u526F\u5E02\u957F\u8303\u6653\u654F\u3001\u5357\u5B81\u4E94\u8C61\u65B0\u533A\u53D1\u5C55\u6539\u9769\u5C40\u5C40\u957F\u9EC4\u7ACB\u57FA\u7B49\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/05/frc-eb4b172bf4cff629a2374ec233e121d2.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5434\u9038\u5E73\uFF08\u5DE6\u8D77\uFF09\u3001\u5B59\u6DD1\u5F3A\u3001\u519C\u751F\u6587\u3001\u5415\u6D77\u5EAD\u3001\u5085\u5E86\u9686\u548C\u8C22\u742A\u6E05\u5728\u4E2D\u56FD\u5357\u5B81\u5E02\u6295\u8D44\u73AF\u5883\u63A8\u4ECB\u66A8\u7ECF\u8D38\u5408\u4F5C\u4EA4\u6D41\u4F1A\u62DB\u5F85\u665A\u5BB4\u4E0A\u5408\u5F71\u3002\u003C/p\u003E\n\u003Ch2\u003E\u003Cstrong\u003E\u653E\u773C\u5EFA\u7ACB\u66F4\u7D27\u5BC6\u5173\u7CFB\u003C/strong\u003E\u003C/h2\u003E\n\u003Cp\u003E\u5434\u9038\u5E73\u6307\u51FA\uFF0C\u5357\u5B81\u5E02\u7684\u53D1\u5C55\u6F5C\u529B\u5DE8\u5927\uFF0C\u5E02\u653F\u5E9C\u4E3A\u4F01\u4E1A\u63D0\u4F9B\u4E86\u826F\u597D\u7684\u53D1\u5C55\u73AF\u5883\u548C\u653F\u7B56\u652F\u6301\uFF0C\u4F7F\u5F97\u5357\u5B81\u5E02\u6210\u4E3A\u4E86\u6211\u56FD\u4F01\u4E1A\u5BFB\u6C42\u5408\u4F5C\u548C\u53D1\u5C55\u7684\u7406\u60F3\u4E4B\u5730\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u4EEC\u4E5F\u653E\u773C\u80FD\u591F\u4E0E\u5357\u5B81\u5E02\u7684\u4F01\u4E1A\u5EFA\u7ACB\u66F4\u7D27\u5BC6\u7684\u5408\u4F5C\u5173\u7CFB\uFF0C\u5171\u540C\u5F00\u62D3\u5E02\u573A\uFF0C\u63A8\u52A8\u53CC\u65B9\u5728\u7ECF\u8D38\u3001\u6587\u5316\u3001\u6559\u80B2\u7B49\u9886\u57DF\u7684\u5408\u4F5C\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u519C\u751F\u6587\u6307\u51FA\uFF0C\u5357\u5B81\u53D1\u5C55\u5B9A\u4F4D\u4E0E\u9A6C\u6765\u897F\u4E9A\u4EA7\u4E1A\u94FE\u4F9B\u5E94\u94FE\u7D27\u5BC6\u5173\u8054\u3001\u6DF1\u5EA6\u878D\u5408\uFF0C\u53CC\u65B9\u5728\u4EA7\u4E1A\u3001\u6280\u672F\u3001\u4EBA\u624D\u7B49\u9886\u57DF\u5177\u6709\u8F83\u5F3A\u7684\u4E92\u8865\u6027\u548C\u5408\u4F5C\u6F5C\u529B\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u4E5F\u63D0\u51FA3\u4E2A\u5408\u4F5C\u5EFA\u8BAE\uFF0C\u5305\u62EC\u56F4\u7ED5\u91CD\u70B9\u53D1\u5C55\u9886\u57DF\uFF0C\u589E\u8FDB\u53CC\u5411\u6295\u8D44\u548C\u7ECF\u8D38\u5F80\u6765\u80FD\u7EA7\uFF1B\u4E8C\u662F\u5171\u5EFA\u9646\u6D77\u65B0\u901A\u9053\uFF0C\u63D0\u5347\u4E92\u8054\u4E92\u901A\u4FBF\u5229\u6C34\u5E73\uFF1B\u4EE5\u53CA\u7528\u597D\u5408\u4F5C\u4EA4\u6D41\u5E73\u53F0\uFF0C\u6DF1\u5316\u62D3\u5C55\u5404\u9886\u57DF\u6295\u8D44\u5408\u4F5C\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/1hQqpQRd5UYM188yi-d6mA\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
