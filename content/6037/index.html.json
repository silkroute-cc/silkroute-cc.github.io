  "canonicalUrlKey": "\u8282\u5E86\u5047\u671F\u6380\u51FA\u6E38\u6F6E\u5927\u9A6C\u56FD\u5185\u65C5\u6E382025\u5E74\u8FCE\u6765\u5927\u7206\u53D1",
  "route": "/6037/",
  "title": "\u8282\u5E86\u5047\u671F\u6380\u51FA\u6E38\u6F6E\uFF01\u5927\u9A6C\u56FD\u5185\u65C5\u6E382025\u5E74\u8FCE\u6765\u5927\u7206\u53D1",
  "summary": "2025\u5E74\u5927\u9A6C\u56FD\u5185\u65C5\u6E38\u4EA4\u51FA\u4EAE\u773C\u6210\u7EE9\uFF0C\u6E38\u5BA2\u4EBA\u6B21\u8FBE2\u4EBF9010\u4E07\uFF0C\u6309\u5E74\u589E\u957F11.5%\uFF0C\u6D88\u8D39\u603B\u989D\u51B2\u4E0A1213\u4EBF\u4EE4\u5409\uFF0C\u53CC\u53CC\u5237\u65B0\u7EAA\u5F55\u3002\u96EA\u5170\u83AA\u4EE53640\u4E07\u8BBF\u5BA2\u5C45\u9996\uFF0C\u5409\u9686\u57613510\u4E07\u7D27\u968F\u5176\u540E\u3002\u7EDF\u8BA1\u5C40\u6307\u51FA\uFF0C\u5F3A\u52B2\u590D\u82CF\u53D7\u60E0\u4E8E\u8282\u5E86\u5047\u671F\u53CA\u5DDE\u89C2\u5149\u5E74\u6D3B\u52A8\u5E26\u52A8\uFF0C\u8FC7\u591C\u6E38\u5BA2\u5360\u6D88\u8D39\u8FD1\u516D\u6210\u3002",
  "body": "\u003Cp\u003E\u5927\u9A6C\u56FD\u5185\u65C5\u6E38\u5E02\u573A\u7EE7\u7EED\u706B\u70ED\uFF0C2025\u5E74\u4EA4\u51FA\u4EAE\u773C\u6210\u7EE9\uFF0C\u6E38\u5BA2\u4EBA\u6B21\u63A5\u8FD13\u4EBF\u4EBA\u6B21\uFF0C\u6309\u5E74\u589E\u957F11.5%\uFF0C\u6D88\u8D39\u603B\u989D\u66F4\u51B2\u4E0A1213\u4EBF\u4EE4\u5409\uFF0C\u53CC\u53CC\u5237\u65B0\u7EAA\u5F55\uFF01\u003C/p\u003E\n\u003Cp\u003E\u96EA\u5170\u83AA\u7EE7\u7EED\u7A33\u5750\u5168\u56FD\u65C5\u6E38\u6700\u70ED\u95E8\u76EE\u7684\u5730\u699C\u9996\uFF0C\u53BB\u5E74\u5438\u5F153640\u4E07\u540D\u8BBF\u5BA2\uFF1B\u5409\u9686\u5761\u4EE53510\u4E07\u4EBA\u6B21\u4F4D\u5C45\u7B2C\u4E8C\uFF0C\u9739\u96F3\u5219\u4EE52360\u4E07\u4EBA\u6B21\u7D27\u968F\u5176\u540E\u3002\u003C/p\u003E\n\u003Cp\u003E\u5927\u9A6C\u7EDF\u8BA1\u5C40\u603B\u76D1\u4E4C\u5179\u5C14\u8868\u793A\uFF0C\u6839\u636E\u300A2025\u5E74\u56FD\u5185\u65C5\u6E38\u8C03\u67E5\u62A5\u544A\u300B\uFF0C\u53BB\u5E74\u56FD\u5185\u6E38\u5BA2\u4EBA\u6570\u4ECE2024\u5E74\u76842\u4EBF6010\u4E07\u4EBA\u6B21\uFF0C\u589E\u81F32\u4EBF9010\u4E07\u4EBA\u6B21\uFF1B\u540C\u65F6\uFF0C\u56FD\u5185\u65C5\u6E38\u6D88\u8D39\u4E5F\u75311067\u4EBF\u4EE4\u5409\u4E0A\u6DA8\u81F31213\u4EBF\u4EE4\u5409\uFF0C\u589E\u957F13.6%\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u56FD\u5185\u65C5\u6E38\u5E02\u573A\u5F3A\u52B2\u590D\u82CF\uFF0C\u4E3B\u8981\u53D7\u60E0\u4E8E\u5168\u5E74\u591A\u4E2A\u8282\u5E86\u5047\u671F\u53CA\u65C5\u6E38\u6D3B\u52A8\u5E26\u52A8\uFF0C\u5305\u62EC\u519C\u5386\u65B0\u5E74\u3001\u5F00\u658B\u8282\u3001\u5C60\u5996\u8282\u3001\u5723\u8BDE\u8282\u53CA\u5B66\u6821\u5047\u671F\uFF0C\u523A\u6FC0\u56FD\u4EBA\u51FA\u6E38\u9700\u6C42\u3002\u003C/p\u003E\n\u003Cp\u003E\u5404\u5DDE\u653F\u5E9C\u63A8\u52A8\u7684\u5DDE\u89C2\u5149\u5E74\u5BA3\u4F20\u6D3B\u52A8\uFF0C\u52A0\u4E0A\u5927\u578B\u6587\u5316\u5E86\u5178\u3001\u6F14\u5531\u4F1A\u3001\u5C55\u89C8\u53CA\u4F53\u80B2\u8D5B\u4E8B\uFF0C\u4E5F\u6210\u4E3A\u5E26\u52A8\u8DE8\u5DDE\u65C5\u6E38\u7684\u91CD\u8981\u56E0\u7D20\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E0D\u4EC5\u5982\u6B64\uFF0C\u8FC7\u591C\u6E38\u5BA2\u4E5F\u662F\u65C5\u6E38\u6D88\u8D39\u4E3B\u529B\uFF0C\u5360\u6574\u4F53\u65C5\u6E38\u5F00\u9500\u768459.5%\uFF0C\u76F8\u5173\u6D88\u8D39\u6309\u5E74\u589E\u957F14.6%\uFF1B\u5355\u65E5\u77ED\u9014\u6E38\u5BA2\u6D88\u8D39\u4E5F\u589E\u957F12.2%\u3002\u003C/p\u003E\n\u003Cp\u003E\u6B64\u5916\uFF0C\u6E38\u5BA2\u5E73\u5747\u7559\u5BBF\u65F6\u95F4\u4ECE2024\u5E74\u76842.49\u665A\u63D0\u5347\u81F32.56\u665A\uFF0C\u663E\u793A\u56FD\u4EBA\u4E0D\u4EC5\u66F4\u79EF\u6781\u56FD\u5185\u65C5\u6E38\uFF0C\u4E5F\u613F\u610F\u5EF6\u957F\u505C\u7559\u65F6\u95F4\u3002\u003C/p\u003E\n\u003Cp\u003E\u6E38\u5BA2\u4EBA\u6B21\u3001\u6D88\u8D39\u53CA\u9017\u7559\u65F6\u95F4\u7684\u5168\u9762\u589E\u957F\uFF0C\u5145\u5206\u5370\u8BC1\u4E86\u56FD\u5185\u65C5\u6E38\u4E1A\u5728\u652F\u6491\u56FD\u5BB6\u7ECF\u6D4E\u589E\u957F\u53CA\u5E26\u52A8\u5730\u65B9\u53D1\u5C55\u4E0A\uFF0C\u6301\u7EED\u626E\u6F14\u7740\u4E3E\u8DB3\u8F7B\u91CD\u7684\u6838\u5FC3\u89D2\u8272\u3002\u003C/p\u003E\n",
