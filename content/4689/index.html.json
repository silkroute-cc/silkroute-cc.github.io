{
  "id": "%e5%ae%89%e5%8d%8e%e6%b8%b8%e8%af%b4%e5%a4%96%e4%bc%81%e6%8a%95%e8%b5%84-%e6%b2%99%e5%9c%b0-acwa-power%e6%8b%9f%e6%8a%95%e8%b5%84%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a100%e4%ba%bf%e7%be%8e%e9%87%91",
  "slug": "%e5%ae%89%e5%8d%8e%e6%b8%b8%e8%af%b4%e5%a4%96%e4%bc%81%e6%8a%95%e8%b5%84-%e6%b2%99%e5%9c%b0-acwa-power%e6%8b%9f%e6%8a%95%e8%b5%84%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a100%e4%ba%bf%e7%be%8e%e9%87%91",
  "canonicalUrlKey": "%e5%ae%89%e5%8d%8e%e6%b8%b8%e8%af%b4%e5%a4%96%e4%bc%81%e6%8a%95%e8%b5%84-%e6%b2%99%e5%9c%b0-acwa-power%e6%8b%9f%e6%8a%95%e8%b5%84%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a100%e4%ba%bf%e7%be%8e%e9%87%91",
  "route": "/4689/",
  "title": "\u5B89\u534E\u6E38\u8BF4\u5916\u4F01\u6295\u8D44  \u6C99\u5730 ACWA Power\u62DF\u6295\u8D44\u9A6C\u6765\u897F\u4E9A100\u4EBF\u7F8E\u91D1",
  "summary": "\u6C99\u5730\u53EF\u518D\u751F\u80FD\u6E90\u5DE8\u5934 ACWA Power\u62DF\u6295\u8D44\u5927\u9A6C475\u4EBF \uFF08\u5229\u96C5\u5F9729\u65E5\u8BAF\uFF09\u6C99\u5730\u963F\u62C9\u4F2F\u7684\u53EF\u518D\u751F\u80FD\u6E90\u5DE8\u5934\u56FD\u9645\u7535\u529B\u4E0E\u6C34\u52A1\u516C\u53F8\uFF08ACWA Power\uFF09\u6709\u610F\u901A\u8FC7\u4E0ECypark\u8D44\u6E90\uFF08CYPARK\uFF0C5184\uFF0C\u4E3B\u677F\u5DE5\u4E1A\u80A1\uFF09\u5408\u4F5C\uFF0C10\u5E74\u5185\u5728\u9A6C\u6295\u8D44\u8D85\u8FC7100\u4EBF\u7F8E\u5143\uFF08\u7EA6475\u4EBF\u4EE4\u5409\uFF09\u3002 \u8BE5\u516C\u53F8\u4E3B\u5E2D\u7A46\u7F55\u9ED8\u5FB7\u963F\u5E03\u7EB3\u592E\u4ECA\u5929\u5728\u4E16\u754C\u7ECF\u6D4E\u8BBA\u575B\u7279\u522B\u4F1A\u8BAE\u5916\uFF0C\u793C\u8282\u6027\u62DC\u4F1A\u6211\u56FD\u9996\u76F8\u62FF\u7763\u65AF\u91CC\u5B89\u534E\u65F6\u901A\u62A5\u6B64\u4E8B\u3002 \u53C2\u4E0E\u4F1A\u8BAE\u8005\u5305\u62EC\u6295\u8D44\u3001\u8D38\u6613\u53CA\u5DE5\u4E1A\u90E8\u957F\u4E1C\u59D1\u624E\u592B\u9C81\u3001Cypark\u8D44\u6E90\u548C\u5176\u4E3B\u8981\u80A1\u4E1CJakel\u2026",
  "body": "\u003Ch1\u003E\u6C99\u5730\u53EF\u518D\u751F\u80FD\u6E90\u5DE8\u5934 ACWA Power\u62DF\u6295\u8D44\u5927\u9A6C475\u4EBF\u003C/h1\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/05/frc-26033e8854438c92f9e3efade7e03b0a.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\uFF08\u5229\u96C5\u5F9729\u65E5\u8BAF\uFF09\u6C99\u5730\u963F\u62C9\u4F2F\u7684\u53EF\u518D\u751F\u80FD\u6E90\u5DE8\u5934\u56FD\u9645\u7535\u529B\u4E0E\u6C34\u52A1\u516C\u53F8\uFF08ACWA Power\uFF09\u6709\u610F\u901A\u8FC7\u4E0ECypark\u8D44\u6E90\uFF08CYPARK\uFF0C5184\uFF0C\u4E3B\u677F\u5DE5\u4E1A\u80A1\uFF09\u5408\u4F5C\uFF0C10\u5E74\u5185\u5728\u9A6C\u6295\u8D44\u8D85\u8FC7100\u4EBF\u7F8E\u5143\uFF08\u7EA6475\u4EBF\u4EE4\u5409\uFF09\u3002 \u003C/p\u003E\n\u003Cp\u003E\u8BE5\u516C\u53F8\u4E3B\u5E2D\u7A46\u7F55\u9ED8\u5FB7\u963F\u5E03\u7EB3\u592E\u4ECA\u5929\u5728\u4E16\u754C\u7ECF\u6D4E\u8BBA\u575B\u7279\u522B\u4F1A\u8BAE\u5916\uFF0C\u793C\u8282\u6027\u62DC\u4F1A\u6211\u56FD\u9996\u76F8\u62FF\u7763\u65AF\u91CC\u5B89\u534E\u65F6\u901A\u62A5\u6B64\u4E8B\u3002 \u003C/p\u003E\n\u003Cp\u003E\u53C2\u4E0E\u4F1A\u8BAE\u8005\u5305\u62EC\u6295\u8D44\u3001\u8D38\u6613\u53CA\u5DE5\u4E1A\u90E8\u957F\u4E1C\u59D1\u624E\u592B\u9C81\u3001Cypark\u8D44\u6E90\u548C\u5176\u4E3B\u8981\u80A1\u4E1CJakel\u96C6\u56E2\u9AD8\u7BA1\u3002 \u003C/p\u003E\n\u003Cp\u003ECypark\u8D44\u6E90\u6267\u884C\u4E3B\u5E2D\u62FF\u7763\u4E9A\u7F8E\u83AB\u91CC\u65AF\u5728\u4F1A\u540E\u8868\u793A\uFF0C\u8BE5\u5408\u4F5C\u76EE\u524D\u6B63\u5904\u4E8E\u6700\u540E\u8BA8\u8BBA\u9636\u6BB5\uFF0C\u9884\u8BA1\u5C06\u5728\u4ECA\u5E74\u5E95\u6572\u5B9A\u3002 \u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0CACWA Power\u6709\u5174\u8DA3\u5728\u5927\u9A6C\u6295\u8D44\uFF0C\u4E3A\u9A6C\u516D\u7532\u91CE\u65B0\u548C\u9739\u96F3\u5409\u8F87\u5DE5\u4E1A\u56ED\u533A\u7684\u7EFF\u8272\u6570\u636E\u4E2D\u5FC3\u5EFA\u8BBE\uFF0C\u5B9E\u65BD\u6280\u672F\u8F6C\u79FB\u548C\u5206\u4EAB\u4E13\u4E1A\u77E5\u8BC6\u3002 \u003C/p\u003E\n\u003Cp\u003E\u4E0E\u6B64\u540C\u65F6\uFF0CJakel\u96C6\u56E2\u8463\u4E8B\u7ECF\u7406\u62FF\u7763\u65AF\u91CC\u83AB\u54C8\u672B\u6CD5\u9C81\u65AF\u8868\u793A\uFF0CJakel\u8D44\u672C\u4F5C\u4E3ACypark\u8D44\u6E90\u4E3B\u8981\u80A1\u4E1C\uFF0C\u4E5F\u53C2\u4E0E\u8BE5\u9879\u76EE\u3002 \u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u4EEC\u5728\u5229\u96C5\u5F97\u8BA8\u8BBA\u8FD9\u9879\u5408\u4F5C\uFF0CJakel\u8FD8\u62E5\u6709\u4E00\u4E9B\u571F\u5730\uFF0C\u53EF\u4EE5\u7528\u4F5C\u592A\u9633\u80FD\u53D1\u7535\u573A\uFF0C\u4E3ACypark\u8D44\u6E90\u63D0\u4F9B\u80FD\u6E90\u3002\u201D \u003C/p\u003E\n\u003Cp\u003E\u5728\u4F1A\u8BAE\u7684\u6700\u540E\u4E00\u5929\uFF0C\u9996\u76F8\u8BA1\u5212\u4E0E\u5DF4\u57FA\u65AF\u5766\u9996\u76F8\u590F\u5DF4\u5179\u548C\u5361\u5854\u5C14\u9996\u76F8\u7A46\u7F55\u9ED8\u5FB7\u4E3E\u884C\u53CC\u8FB9\u4F1A\u8BAE\u3002 \u003C/p\u003E\n\u003Cp\u003E\u5B89\u534E\u4E5F\u63A5\u5F85\u571F\u8033\u5176\u5916\u4EA4\u90E8\u957F\u54C8\u574E\u83F2\u4E39\u793C\u8282\u6027\u62DC\u8BBF\u3002 \u003C/p\u003E\n\u003Ch1\u003E\u4E0E\u5168\u7403\u903E50\u5DE5\u5546\u9886\u8896\u4F1A\u8C08 \u5B89\u534E\u6E38\u8BF4\u5916\u4F01\u6765\u9A6C\u6295\u8D44\u003C/h1\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/05/frc-f605179415b8191096d4d5a497e0d85f.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\uFF08\u5409\u9686\u576129\u65E5\u8BAF\uFF09\u9996\u76F8\u517C\u8D22\u957F\u62FF\u7763\u65AF\u91CC\u5B89\u534E\u6307\u51FA\uFF0C\u4ED6\u548C\u9A6C\u6765\u897F\u4E9A\u4EE3\u8868\u56E2\u5728\u4E16\u754C\u7ECF\u6D4E\u8BBA\u575B\u7279\u522B\u4F1A\u8BAE\u671F\u95F4\uFF0C\u4E0E\u6765\u81EA\u4E16\u754C\u5404\u5730\u7684\u903E50\u540D\u5DE5\u5546\u754C\u9886\u8896\u4E3E\u884C\u5706\u684C\u4F1A\u8BAE\uFF0C\u5E76\u8BF4\u670D\u4ED6\u4EEC\u6765\u9A6C\u6295\u8D44\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u5584\u7528\u8FD9\u7A7A\u95F4\u5C55\u793A\u4F18\u5148\u4E8B\u9879\u3001\u7B56\u7565\u4E3E\u63AA\u3001\u56FD\u5BB6\u7ECF\u6D4E\u548C\u8D22\u653F\u589E\u957F\u7387\uFF0C\u4EE5\u53CA\u8D38\u6613\u4E0E\u6295\u8D44\u673A\u4F1A\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u8FD9\u6B21\u4F1A\u8BAE\u5BF9\u6211\u548C\u540C\u4F34\u4EEC\u662F\u975E\u5E38\u91CD\u8981\uFF0C\u53EF\u4EE5\u8BF4\u670D\u4E1A\u754C\u9886\u8896\u6765\u9A6C\u6295\u8D44\uFF0C\u4ECE\u800C\u63A8\u52A8\u56FD\u5BB6\u7ECF\u6D4E\u589E\u957F\uFF0C\u4E3A\u56FD\u4EBA\u521B\u9020\u9AD8\u6280\u80FD\u7684\u5C31\u4E1A\u673A\u4F1A\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u5B89\u534E\u5728\u8138\u4E66\u53D1\u6587\u65F6\uFF0C\u8FD9\u4E48\u8BF4\u3002\u51FA\u5E2D\u4F1A\u8BAE\u8005\u5305\u62EC\u5916\u4EA4\u90E8\u957F\u62FF\u7763\u65AF\u91CC\u83AB\u54C8\u672B\u54C8\u5C71\u548C\u6295\u8D44\u3001\u8D38\u6613\u53CA\u5DE5\u4E1A\u90E8\u957F\u4E1C\u59D1\u624E\u592B\u9C81\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/05/frc-dd09d583387bdbe6260574ed25cb82b2.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u53C2\u4E0E\u4F1A\u8BAE\u7684\u516C\u53F8\u5305\u62EC\u4E09\u661F\u3001\u96EA\u4F5B\u5170\u3001BrainBox AI\u3001\u601D\u79D1\u7CFB\u7EDF\u3001\u9053\u8FBE\u5C14\u80FD\u6E90\u3001\u9732\u9732\u56FD\u9645\u96C6\u56E2\u3001\u5FB7\u610F\u5FD7\u94F6\u884C\u548C\u6C99\u5730\u5DE5\u4E1A\u53D1\u5C55\u57FA\u91D1\u3002\u003C/p\u003E\n\u003Cp\u003E\u5B89\u534E\u63D0\u5230\uFF0C\u8BB8\u591A\u5DE5\u5546\u754C\u9886\u8896\u8868\u8FBE\u5BF9\u5927\u9A6C\u5404\u9886\u57DF\u6295\u8D44\u7684\u5174\u8DA3\uFF0C\u8FD9\u663E\u793A\u4ED6\u4EEC\u5BF9\u56FD\u5BB6\u7ECF\u6D4E\u589E\u957F\u524D\u666F\u548C\u653F\u6CBB\u7A33\u5B9A\u6709\u4FE1\u5FC3\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u4FDD\u8BC1\uFF0C\u4ED6\u4EEC\u7684\u6295\u8D44\u4E8B\u52A1\u5C06\u7B80\u5316\u53CA\u52A0\u901F\uFF0C\u5C24\u5176\u662F\u5728\u653F\u5E9C\u6210\u529F\u89E3\u51B3\u957F\u671F\u4EE5\u6765\u5B58\u5728\u7684\u5B98\u50DA\u7E41\u6587\u7F1B\u8282\u7B49\u8BFE\u9898\u4E4B\u540E\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u76F8\u4FE1\u4F1A\u6709\u66F4\u591A\u9AD8\u4EF7\u503C\u6295\u8D44\u8005\uFF0C\u8DDF\u968F\u7279\u65AF\u62C9\u3001AWS\u3001\u82F1\u98DE\u51CC\u548C\u82F1\u4F1F\u8FBE\u7B49\u5DE8\u5934\u516C\u53F8\u6B65\u4F10\uFF0C\u9009\u62E9\u5927\u9A6C\u4F5C\u4E3A\u6295\u8D44\u76EE\u7684\u5730\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/ERlcREceOCYDskzovwVuzA\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
