  "title": "\u666F\u5174\u7EB8\u4E1A\uFF1A\u9A6C\u6765\u897F\u4E9A\u9879\u76EE\u90E8\u5206\u8BBE\u5907\u5DF2\u7ECF\u5F00\u59CB\u8FDB\u884C\u5355\u673A\u8C03\u8BD5",
  "summary": "\u6709\u6295\u8D44\u8005\u5728\u6295\u8D44\u8005\u4E92\u52A8\u5E73\u53F0\u63D0\u95EE\uFF1A\u8BF7\u95EE\u9A6C\u6765\u897F\u4E9A\u5DE5\u7A0B\u7AE3\u5DE5\u9A8C\u6536\u6D41\u7A0B\u8D70\u5B8C\u4E86\u5417\uFF0C\u4F55\u65F6\u53EF\u4EE5\u8BD5\u4EA7\uFF1F \u666F\u5174\u7EB8\u4E1A\uFF08002067.SZ\uFF092\u670823\u65E5\u5728\u6295\u8D44\u8005\u4E92\u52A8\u5E73\u53F0\u8868\u793A\uFF0C \u516C\u53F8\u9A6C\u6765\u897F\u4E9A\u9879\u76EE\u76EE\u524D\u5C1A\u5728\u7B49\u5F85\u9A6C\u6765\u653F\u5E9C\u5BF9\u5DE5\u4E1A\u56ED\u533A\u7684\u9A8C\u6536\u3002\u9879\u76EE\u7684\u90E8\u5206\u8BBE\u5907\u5DF2\u7ECF\u5F00\u59CB\u8FDB\u884C\u5355\u673A\u8C03\u8BD5\uFF0C\u5177\u4F53\u6295\u4EA7\u65F6\u95F4\u9700\u8981\u6839\u636E\u8BBE\u5907\u8C03\u8BD5\u60C5\u51B5\u4EE5\u53CA\u9A6C\u6765\u653F\u5E9C\u5BF9\u9879\u76EE\u7684\u9A8C\u6536\u60C5\u51B5\u6765\u51B3\u5B9A\u3002 \u6765\u6E90\uFF1A \u9605\u8BFB\u539F\u6587",
  "body": "\u003Cp\u003E\u6709\u6295\u8D44\u8005\u5728\u6295\u8D44\u8005\u4E92\u52A8\u5E73\u53F0\u63D0\u95EE\uFF1A\u8BF7\u95EE\u9A6C\u6765\u897F\u4E9A\u5DE5\u7A0B\u7AE3\u5DE5\u9A8C\u6536\u6D41\u7A0B\u8D70\u5B8C\u4E86\u5417\uFF0C\u4F55\u65F6\u53EF\u4EE5\u8BD5\u4EA7\uFF1F\u003C/p\u003E\n\u003Cp\u003E\u666F\u5174\u7EB8\u4E1A\uFF08002067.SZ\uFF092\u670823\u65E5\u5728\u6295\u8D44\u8005\u4E92\u52A8\u5E73\u53F0\u8868\u793A\uFF0C \u516C\u53F8\u9A6C\u6765\u897F\u4E9A\u9879\u76EE\u76EE\u524D\u5C1A\u5728\u7B49\u5F85\u9A6C\u6765\u653F\u5E9C\u5BF9\u5DE5\u4E1A\u56ED\u533A\u7684\u9A8C\u6536\u3002\u9879\u76EE\u7684\u90E8\u5206\u8BBE\u5907\u5DF2\u7ECF\u5F00\u59CB\u8FDB\u884C\u5355\u673A\u8C03\u8BD5\uFF0C\u5177\u4F53\u6295\u4EA7\u65F6\u95F4\u9700\u8981\u6839\u636E\u8BBE\u5907\u8C03\u8BD5\u60C5\u51B5\u4EE5\u53CA\u9A6C\u6765\u653F\u5E9C\u5BF9\u9879\u76EE\u7684\u9A8C\u6536\u60C5\u51B5\u6765\u51B3\u5B9A\u3002\u003C/p\u003E\n\u003Cp\u003E\n\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/ny1FKxu0z2vAmIrc8kmhjg\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
