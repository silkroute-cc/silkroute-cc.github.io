  "canonicalUrlKey": "%e9%99%86%e5%85%86%e7%a6%8f%e6%ac%a2%e8%bf%8e%e4%b8%ad%e4%bc%81%e6%8a%95%e8%b5%84-%e6%89%93%e9%80%a0%e5%a4%a7%e9%a9%ac%e6%88%90%e9%93%81%e8%b7%af%e4%ba%a7%e4%b8%9a%e4%b8%ad%e5%bf%83",
  "route": "/4808/",
  "title": "\u9646\u5146\u798F:\u6B22\u8FCE\u4E2D\u4F01\u6295\u8D44 \u6253\u9020\u5927\u9A6C\u6210\u94C1\u8DEF\u4EA7\u4E1A\u4E2D\u5FC3",
  "summary": "\u9646\u5146\u798F\uFF08\u5DE6\u516D\uFF09\u89C1\u8BC1ETS3\u4E0B\u7EBF\u4EEA\u5F0F\u3002\u5DE6\u8D77\u4E3A\u62C9\u7F8E\u65AF\u74E6\u5170\u3001\u738B\u950B\u3001\u9648\u6062\u6E05\u3001\u963F\u5179\u54C8\u3001\u9A6C\u4E91\u53CC\u3002\u53F3\u8D77\u4E3A\u738B\u5DE7\u6797\u3001\u5085\u6210\u9A8F\u3001\u83AB\u54C8\u672B\u62C9\u5C3C\u53CA\u5F20\u5251\u98DE\u3002\uFF08\u4EA4\u901A\u90E8\u63D0\u4F9B\uFF09 \uFF08\u682A\u6D328 \u65E5\u8BAF\uFF09\u4EA4\u901A\u90E8\u6B63\u79EF\u6781\u91C7\u53D6\u884C\u52A8\uFF0C\u529B\u56FE\u5C06\u9A6C\u6765\u897F\u4E9A\u6253\u9020\u6210\u4E1C\u76DF\u94C1\u8DEF\u4EA7\u4E1A\u4E2D\u5FC3\uFF0C\u4E14\u6B22\u8FCE\u4E2D\u56FD\u4F01\u4E1A\u6765\u9A6C\u6295\u8D44\u3002 \u4EA4\u901A\u90E8\u957F\u9646\u5146\u798F\u8BF4\uFF0C\u4EA4\u901A\u90E8\u56E0\u6B64\u7279\u522B\u671F\u5F85\u4E2D\u56FD\u4E2D\u8F66\u682A\u6D32\u7535\u529B\u673A\u8F66\u6709\u9650\u516C\u53F8\uFF08CRRC\uFF09\u53EF\u4EE5\u52A0\u5927\u5728\u9A6C\u6295\u8D44\uFF0C\u4EE5\u65B0\u9020\u3001\u5927\u4FEE\u7B49\u672A\u6765\u9879\u76EE\u4E3A\u8F7D\u4F53\uFF0C\u7EE7\u7EED\u79EF\u6781\u5F00\u5C55\u672C\u5730\u5408\u4F5C\u3001\u7EE7\u7EED\u52A0\u5F3A\u6280\u672F\u8F6C\u79FB\u3001\u4F9B\u5E94\u94FE\u5EFA\u7ACB\u548C\u4EBA\u624D\u57F9\u8BAD\uFF0C\u63A8\u52A8\u5927\u9A6C\u6210\u4E3A\u6574\u4E2A\u4E1C\u76DF\u8F68\u9053\u4EA4\u901A\u9886\u57DF\u7684\u5236\u9020\u4E2D\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/06/frc-3c75bb08c0e65c7ac3ea0ce8d104c8b8.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u9646\u5146\u798F\uFF08\u5DE6\u516D\uFF09\u89C1\u8BC1ETS3\u4E0B\u7EBF\u4EEA\u5F0F\u3002\u5DE6\u8D77\u4E3A\u62C9\u7F8E\u65AF\u74E6\u5170\u3001\u738B\u950B\u3001\u9648\u6062\u6E05\u3001\u963F\u5179\u54C8\u3001\u9A6C\u4E91\u53CC\u3002\u53F3\u8D77\u4E3A\u738B\u5DE7\u6797\u3001\u5085\u6210\u9A8F\u3001\u83AB\u54C8\u672B\u62C9\u5C3C\u53CA\u5F20\u5251\u98DE\u3002\uFF08\u4EA4\u901A\u90E8\u63D0\u4F9B\uFF09\u003C/p\u003E\n\u003Cp\u003E\uFF08\u682A\u6D328 \u65E5\u8BAF\uFF09\u4EA4\u901A\u90E8\u6B63\u79EF\u6781\u91C7\u53D6\u884C\u52A8\uFF0C\u529B\u56FE\u5C06\u9A6C\u6765\u897F\u4E9A\u6253\u9020\u6210\u4E1C\u76DF\u94C1\u8DEF\u4EA7\u4E1A\u4E2D\u5FC3\uFF0C\u4E14\u6B22\u8FCE\u4E2D\u56FD\u4F01\u4E1A\u6765\u9A6C\u6295\u8D44\u3002\u003C/p\u003E\n\u003Cp\u003E\u4EA4\u901A\u90E8\u957F\u9646\u5146\u798F\u8BF4\uFF0C\u4EA4\u901A\u90E8\u56E0\u6B64\u7279\u522B\u671F\u5F85\u4E2D\u56FD\u4E2D\u8F66\u682A\u6D32\u7535\u529B\u673A\u8F66\u6709\u9650\u516C\u53F8\uFF08CRRC\uFF09\u53EF\u4EE5\u52A0\u5927\u5728\u9A6C\u6295\u8D44\uFF0C\u4EE5\u65B0\u9020\u3001\u5927\u4FEE\u7B49\u672A\u6765\u9879\u76EE\u4E3A\u8F7D\u4F53\uFF0C\u7EE7\u7EED\u79EF\u6781\u5F00\u5C55\u672C\u5730\u5408\u4F5C\u3001\u7EE7\u7EED\u52A0\u5F3A\u6280\u672F\u8F6C\u79FB\u3001\u4F9B\u5E94\u94FE\u5EFA\u7ACB\u548C\u4EBA\u624D\u57F9\u8BAD\uFF0C\u63A8\u52A8\u5927\u9A6C\u6210\u4E3A\u6574\u4E2A\u4E1C\u76DF\u8F68\u9053\u4EA4\u901A\u9886\u57DF\u7684\u5236\u9020\u4E2D\u5FC3\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6628\u65E5\u51FA\u5E2D\u4E2D\u56FD\u6E56\u5357\u7701\u201C\u5927\u9A6C\u7B2C\u4E09\u4EE3\u65B0\u578B\u53CC\u8F68\u7535\u52A8\u706B\u8F66\uFF08ETS3\uFF09\u65B0\u578B\u7C73\u8F68\u52A8\u8F66\u7EC4\u4E0B\u7EBF\u4EEA\u5F0F\u201D\u81F4\u8BCD\u65F6\uFF0C\u8FD9\u4E48\u8BF4\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6307\u51FA\uFF0C\u8FC7\u53BB15\u5E74\uFF0C\u4EA4\u901A\u90E8\u4E0E\u4EE5\u682A\u673A\u516C\u53F8\u4E3A\u4EE3\u8868\u7684\u4E2D\u56FD\u4E2D\u8F66\uFF0C\u6709\u7740\u5E7F\u6CDB\u6DF1\u5165\u7684\u5B9E\u8D28\u6027\u5408\u4F5C\uFF0C\u53CC\u65B9\u5B9E\u73B0\u4E86\u5408\u4F5C\u5171\u8D62\uFF0C\u53D6\u5F97\u4E86\u4E3E\u4E16\u77A9\u76EE\u7684\u6210\u5C31\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u5728\u672A\u6765\uFF0C\u6211\u4F9D\u65E7\u671F\u5F85\u682A\u673A\u516C\u53F8\u5728\u5927\u9A6C\u6709\u4F5C\u4E3A\u3001\u6709\u5360\u4F4D\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u8F68\u9053\u4EA4\u901A\u4EE5\u7EFF\u8272\u3001\u9AD8\u6548\u7B49\u7279\u70B9\u5C06\u6210\u4E3A\u672A\u6765\u516C\u5171\u4EA4\u901A\u7684\u4E3B\u8981\u8FD0\u8F93\u65B9\u5F0F\uFF0C\u8FD9\u4E00\u89C2\u70B9\u5DF2\u7ECF\u662F\u4E1C\u76DF\u533A\u57DF\u5404\u56FD\u7684\u5171\u8BC6\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6307\u51FA\uFF0C\u6E56\u5357\u7701\u8F68\u9053\u4EA4\u901A\u4EA7\u4E1A\u96C6\u7FA4\u662F\u4E2D\u56FD\u9996\u4E2A\u5343\u4EBF\u8F68\u9053\u4EA4\u901A\u88C5\u5907\u4EA7\u4E1A\u96C6\u7FA4\uFF0C\u62E5\u6709\u5F3A\u5927\u7684\u7814\u53D1\u80FD\u529B\u3001\u6700\u5168\u9762\u7684\u4EA7\u4E1A\u94FE\u53CA\u6700\u5E7F\u6CDB\u7684\u4EA7\u54C1\u7EC4\u5408\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u682A\u673A\u516C\u53F8\u4F5C\u4E3A\u4E2D\u56FD\u4E2D\u8F66\u65D7\u4E0B\u6838\u5FC3\u5B50\u516C\u53F8\uFF0C\u662F\u6E56\u5357\u5343\u4EBF\u8F68\u9053\u4EA4\u901A\u4EA7\u4E1A\u96C6\u7FA4\u9F99\u5934\u4F01\u4E1A\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u4E5F\u5E0C\u671B\u6E56\u5357\u7701\u653F\u5E9C\u548C\u4E2D\u8F66\u96C6\u56E2\u7EE7\u7EED\u652F\u6301\u682A\u673A\u516C\u53F8\u5728\u5927\u9A6C\u7684\u53D1\u5C55\u3002\u4E1C\u76DF\u5236\u9020\u4E2D\u5FC3\u65E2\u662F\u4E2D\u8F66\u7684\uFF0C\u4E5F\u662F\u5927\u9A6C\u7684\uFF01\u201D\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/06/frc-eb13829d452355c877bf2d7af980498b.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u9646\u5146\u798F\u8BF4\uFF0CETS3\u5171\u670910\u7EC4\u5217\u8F66\uFF0C\u5176\u4E2D8\u5217\u5C06\u5728\u5927\u9A6C\u672C\u5730\u7EC4\u88C5\uFF0C2\u5217\u8F66\u5C06\u4ECE\u4E2D\u56FD\u53D1\u8FD0\uFF0C\u800C\u5F53\u4E2D\u7684\u4E00\u5217\u5DF2\u4E0B\u7EBF\u3002\uFF08\u4EA4\u901A\u90E8\u63D0\u4F9B\uFF09\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EETS3\u660E\u5E748\u6708\u5B8C\u6210\u4EA4\u4ED8\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u968F\u774010\u5217\u7B2C\u4E09\u4EE3\u65B0\u578B\u53CC\u8F68\u7535\u52A8\u706B\u8F66\uFF08ETS3\uFF09\u5C06\u5728\u660E\u5E748\u6708\u5B8C\u6210\u4EA4\u4ED8\uFF0C\u610F\u5473\u7740\u8054\u901A\u73BB\u7483\u5E02\u5DF4\u4E1C\u52FF\u5239\u5230\u67D4\u4F5B\u65B0\u5C71\u7684ETS3\u8DEF\u7EBF\u5373\u5C06\u5F00\u901A\u3002\u003C/p\u003E\n\u003Cp\u003E\u9646\u5146\u798F\u8BF4\uFF0CETS3\u5171\u670910\u7EC4\u5217\u8F66\uFF0C\u5176\u4E2D8\u5217\u5C06\u5728\u5927\u9A6C\u672C\u5730\u7EC4\u88C5\uFF0C2\u5217\u8F66\u5C06\u4ECE\u4E2D\u56FD\u53D1\u8FD0\uFF0C\u800C\u5F53\u4E2D\u7684\u4E00\u5217\u5DF2\u4E0B\u7EBF\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6307\u51FA\uFF0C\u8FD910\u5217\u5C06\u7528\u4E8E\u5F00\u901A\u91D1\u9A6C\u58EB\u67D4\u4F5B\u8DEF\u7EBF\u7684ETS3\u8F66\u53A2\uFF0C\u5C06\u5728\u660E\u5E748\u6708\u5B8C\u6210\u4EA4\u4ED8\uFF0C\u968F\u5373\u5C06\u8054\u901A\u5927\u9A6C\u5317\u90E8\u7684\u73BB\u7483\u5E02\u5DF4\u4E1C\u52FF\u5239\u81F3\u5357\u90E8\u7684\u67D4\u4F5B\u65B0\u5C71\u3002\u003C/p\u003E\n\u003Cp\u003E\u6211\u56FD\u662F\u5728\u6628\u5929\u6536\u5230\u91D1\u9A6C\u58EB\u81F3\u65B0\u5C71\u53CC\u8F68\u7535\u52A8\u706B\u8F66\u7684\u7B2C\u4E00\u7EC4\u7535\u52A8\u5217\u8F66\uFF08ETS3\uFF09\u3002\u003C/p\u003E\n\u003Cp\u003E\u636E\u9646\u5146\u798F\u5206\u4EAB\u7684\u89C6\u9891\uFF0C\u4ED6\u5F88\u9AD8\u5174ETS3\u9879\u76EE\u8FDB\u5C55\u987A\u5229\uFF0C\u5E76\u5E0C\u671B\u4E0B\u4E00\u7EC4\u5217\u8F66\u80FD\u6309\u65F6\u5B8C\u6210\u548C\u4EA4\u4ED8\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6307\u51FA\uFF0C\u65B0\u7684ETS3\u5217\u8F66\u7684\u5EA7\u4F4D\u6570\u4E3A312\u4E2A\uFF0C\u5176\u4E2D\u5546\u52A1\u5EA736\u4E2A\uFF0C\u6807\u51C6\u5EA7276\u4E2A\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u65B0\u5217\u8F66\u5C06\u6539\u53D8\u6211\u56FD\u7684\u51FA\u884C\u65B9\u5F0F\uFF0C\u56E0\u4E3A\u5409\u9686\u5761\u4E0E\u65B0\u5C71\u4E4B\u95F4\u7684\u65C5\u7A0B\u65F6\u95F4\u5C06\u5927\u5E45\u7F29\u77ED\uFF0C\u4EA4\u901A\u53EF\u9760\u6027\u548C\u5B89\u5168\u6027\u4E5F\u5C06\u663E\u8457\u63D0\u9AD8\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u4ECA\u5929\uFF087 \u65E5\uFF09\u4E0B\u7EBF\u7684ETS3\u52A8\u8F66\u7EC4\u662F\u7531\u534E\u90FD\u7259\u4E5F\u4E2D\u8F66\u4E1C\u76DF\u5236\u9020\u4E2D\u5FC3\u672C\u5730\u5C65\u7EA6\uFF0C\u6211\u5BF9\u5176\u751F\u4EA7\u8FDB\u5EA6\u611F\u5230\u6B23\u6170\uFF1B\u540C\u6837\u8BA9\u6211\u611F\u5230\u6B23\u6170\u7684\uFF0C\u662F\u8BE5\u9879\u76EE\u7684\u6B63\u5411\u6EA2\u51FA\u6548\u5E94\uFF0C\u9A6C\u6765\u897F\u4E9A\u7684\u672C\u5730\u5236\u9020\u5546\u90FD\u56E0\u6B64\u53D7\u76CA\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6307\u51FA\uFF0C\u5168\u90E8\u8F66\u8F86\u4E8E2025\u5E748\u6708\u4EA4\u4ED8\u5B8C\u6210\uFF0C\u5C06\u88AB\u7528\u5728\u5373\u5C06\u5F00\u901A\u7684\u91D1\u9A6C\u58EB\u67D4\u4F5B\u7EBF\u8DEF\uFF0C\u8054\u901A\u5317\u90E8\u7684\u73BB\u7483\u5E02\u5DF4\u4E1C\u52FF\u5239\u5230\u5357\u90E8\u7684\u67D4\u4F5B\u65B0\u5C71\u3002\u003C/p\u003E\n\u003Cp\u003E\u9646\u5146\u798F\u8BF4\uFF0C\u4E1C\u6D77\u5CB8\u94C1\u8DEF\u9879\u76EE\u3001\u897F\u9A6C\u5357\u90E8\u94C1\u8DEF\u53CC\u8F68\u7535\u6C14\u5316\u6539\u9020\u9879\u76EE\u6B63\u5982\u706B\u5982\u837C\u63A8\u8FDB\uFF1B\u9686\u65B0\u9AD8\u94C1\u5408\u4F5C\u5EFA\u8BBE\u548C\u8425\u8FD0\u65B9\u6848\u5F81\u96C6\u83B7\u5F97\u4E86\u884C\u4E1A\u4F01\u4E1A\u79EF\u6781\u56DE\u5E94\uFF1B\u5E02\u533A\u8F68\u9053\u4EA4\u901A\u9886\u57DF\u7684\u5F00\u53D1\u5EFA\u8BBE\u3001\u6539\u9020\u5347\u7EA7\u9646\u7EED\u5F00\u542F\uFF1B\u7EFF\u8272\u8F68\u9053\u4EA4\u901A\u89E3\u51B3\u65B9\u6848\u3001\u521B\u65B0\u6027\u8F68\u9053\u4EA4\u901A\u79DF\u8D41\u5546\u52A1\u6A21\u5F0F\u5DF2\u8D8A\u6765\u8D8A\u53D7\u5230\u653F\u5E9C\u91CD\u89C6\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5171\u5EFA\u9AD8\u8D28\u91CF\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u9646\u5146\u798F\u8BF4\uFF0C\u4ECA\u5E74\u662F\u9A6C\u4E2D\u5EFA\u4EA450\u5468\u5E74\uFF0C\u9A6C\u4E2D\u4E24\u56FD\u8FC7\u53BB\u534A\u4E2A\u4E16\u7EAA\u5728\u5404\u65B9\u9762\u90FD\u4E92\u76F8\u6276\u6301\uFF0C\u5171\u540C\u53D1\u5C55\u524D\u8FDB\uFF0C\u800C\u9996\u76F8\u62FF\u7763\u65AF\u91CC\u5B89\u534E\u4EFB\u76F8\u540E\u4E24\u5E74\u51852\u6B21\u8BBF\u95EE\u4E2D\u56FD\uFF0C\u53CC\u65B9\u627F\u8BFA\u7EE7\u7EED\u81F4\u529B\u5171\u5EFA\u9AD8\u8D28\u91CF\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\uFF0C\u4EE5\u5411\u4E16\u754C\u5C55\u793A\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u7684\u4E30\u76DB\u6210\u679C\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6307\u51FA\uFF0C2023\u5E74\u4E24\u56FD\u5BA3\u5E03\u5171\u5EFA\u9A6C\u4E2D\u547D\u8FD0\u5171\u540C\u4F53\u4EE5\u6765\uFF0C\u4E24\u56FD\u5728\u5165\u5883\u5B8C\u5168\u514D\u7B7E\u3001\u6269\u5927\u8D27\u5E01\u4E92\u6362\u7B49\u591A\u4E2A\u9886\u57DF\u5B9E\u73B0\u4E86\u6DF1\u5165\u5408\u4F5C\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u672C\u6708\uFF0C\u4E2D\u56FD\u603B\u7406\u674E\u5F3A\u4E5F\u5C06\u8BBF\u95EE\u5927\u9A6C\uFF0C\u53CC\u8FB9\u653F\u5546\u6C11\u95F4\u65E0\u4E0D\u7FD8\u9996\u4EE5\u76FC\uFF0C\u671F\u5F85\u4E24\u56FD\u5B9E\u73B0\u533A\u57DF\u5408\u4F5C\u3001\u5171\u540C\u53D1\u5C55\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u51FA\u5E2D\u6D3B\u52A8\u7684\u5305\u62EC\u5927\u9A6C\u94C1\u9053\u8D44\u4EA7\u673A\u6784\u9996\u5E2D\u6267\u884C\u5458\u62FF\u7763\u963F\u5179\u54C8\u3001\u9879\u76EE\u7ECF\u5386\u62C9\u7F8E\u65AF\u74E6\u5170\u3001\u5927\u9A6C\u94C1\u9053\u516C\u53F8\u603B\u6267\u884C\u957F\u83AB\u54C8\u672B\u62C9\u5C3C\u3001\u6E56\u5357\u7701\u4EBA\u5927\u5E38\u59D4\u4F1A\u526F\u4E3B\u4EFB\u5F20\u5251\u98DE\u3001\u682A\u6D32\u5E02\u957F\u9648\u6062\u6E05\u3001\u4E2D\u8F66\u96C6\u56E2\u603B\u88C1\u9A6C\u4E91\u53CC\u3001\u526F\u9996\u5E2D\u6267\u884C\u5458\u738B\u950B\u3001\u4E2D\u8F66\u682A\u673A\u516C\u53F8\u8463\u4E8B\u957F\u5085\u6210\u9A8F\u53CA\u603B\u7ECF\u7406\u738B\u5DE7\u6797\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/_Z9yJikXac0bfb6huTxhzA\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
