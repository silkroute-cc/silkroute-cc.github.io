  "route": "/3087/",
  "title": "IJM\u83B7\u8FD110\u4EBF\u4EE4\u5409\u5408\u7EA6  \u5EFA\u533B\u9662\u4E0E\u7A0E\u6536\u5C40\u5927\u697C",
  "summary": "\uFF08\u5409\u9686\u576118\u65E5\u8BAF\uFF09IJM\uFF08IJM\uFF0C3336\uFF0C\u4E3B\u677F\u5EFA\u7B51\u80A1\uFF09\u5BA3\u5E03\uFF0C\u83B7\u4E24\u9879\u603B\u503C9\u4EBF8180\u4E07\u4EE4\u5409\u5408\u7EA6\uFF0C\u4E3B\u8981\u8D1F\u8D23\u5EFA\u9020\u4F4D\u4E8E\u96EA\u5DDE\u52A0\u57D4\u7684\u653F\u5E9C\u533B\u9662\uFF0C\u4EE5\u53CA\u4F4D\u4E8E\u838E\u963F\u5357\u5185\u9646\u7A0E\u6536\u5C40\u7684\u529E\u516C\u5927\u697C\u3002 \u8BE5\u516C\u53F8\u5468\u4E8C\u53D1\u6587\u544A\u6307\u51FA\uFF0C\u4E24\u9879\u5408\u7EA6\u4E3B\u8981\u7531\u5B50\u516C\u53F8IJM\u5EFA\u7B51\u79C1\u4EBA\u6709\u9650\u516C\u53F8\u83B7\u5F97\u3002 \u8BE5\u516C\u53F8\u8868\u793A\uFF0C\u533B\u9662\u5408\u7EA6\u4E3B\u8981\u4ECE\u5DE5\u7A0B\u90E8\u624B\u4E2D\u83B7\u5F97\uFF0C\u5408\u7EA6\u4EF7\u503C\u4E3A8\u4EBF3100\u4E07\u4EE4\u5409\uFF0C\u52A8\u5DE5\u65F6\u95F4\u843D\u572811\u6708\u4EFD\uFF0C\u9884\u8BA1\u5C06\u8017\u65F648\u4E2A\u6708\u5B8C\u6210\u3002 \u8BE5\u533B\u9662\u5C06\u8BBE\u7ACB\u6210\u4E3A\u4E13\u79D1\u533B\u9662\uFF0C\u800C\u9879\u76EE\u5C06\u4EE5\u8054\u8425\u7684\u65B9\u5F0F\u8FDB\u884C\uFF0CIJM\u5EFA\u7B51\u630160%\uFF0C\u5269\u4F59\u768440%\u5219\u5F52Ganda Im\u2026",
  "body": "\u003Cp\u003E\uFF08\u5409\u9686\u576118\u65E5\u8BAF\uFF09IJM\uFF08IJM\uFF0C3336\uFF0C\u4E3B\u677F\u5EFA\u7B51\u80A1\uFF09\u5BA3\u5E03\uFF0C\u83B7\u4E24\u9879\u603B\u503C9\u4EBF8180\u4E07\u4EE4\u5409\u5408\u7EA6\uFF0C\u4E3B\u8981\u8D1F\u8D23\u5EFA\u9020\u4F4D\u4E8E\u96EA\u5DDE\u52A0\u57D4\u7684\u653F\u5E9C\u533B\u9662\uFF0C\u4EE5\u53CA\u4F4D\u4E8E\u838E\u963F\u5357\u5185\u9646\u7A0E\u6536\u5C40\u7684\u529E\u516C\u5927\u697C\u3002\u003C/p\u003E\n\u003Cp\u003E\u8BE5\u516C\u53F8\u5468\u4E8C\u53D1\u6587\u544A\u6307\u51FA\uFF0C\u4E24\u9879\u5408\u7EA6\u4E3B\u8981\u7531\u5B50\u516C\u53F8IJM\u5EFA\u7B51\u79C1\u4EBA\u6709\u9650\u516C\u53F8\u83B7\u5F97\u3002\u003C/p\u003E\n\u003Cp\u003E\u8BE5\u516C\u53F8\u8868\u793A\uFF0C\u533B\u9662\u5408\u7EA6\u4E3B\u8981\u4ECE\u5DE5\u7A0B\u90E8\u624B\u4E2D\u83B7\u5F97\uFF0C\u5408\u7EA6\u4EF7\u503C\u4E3A8\u4EBF3100\u4E07\u4EE4\u5409\uFF0C\u52A8\u5DE5\u65F6\u95F4\u843D\u572811\u6708\u4EFD\uFF0C\u9884\u8BA1\u5C06\u8017\u65F648\u4E2A\u6708\u5B8C\u6210\u3002\u003C/p\u003E\n\u003Cp\u003E\u8BE5\u533B\u9662\u5C06\u8BBE\u7ACB\u6210\u4E3A\u4E13\u79D1\u533B\u9662\uFF0C\u800C\u9879\u76EE\u5C06\u4EE5\u8054\u8425\u7684\u65B9\u5F0F\u8FDB\u884C\uFF0CIJM\u5EFA\u7B51\u630160%\uFF0C\u5269\u4F59\u768440%\u5219\u5F52Ganda Imbuhan\u79C1\u4EBA\u6709\u9650\u516C\u53F8\u6240\u6709\u3002\u003C/p\u003E\n\u003Cp\u003EIJM\u8463\u4E8B\u7ECF\u7406\u517C\u603B\u6267\u884C\u957F\u5ED6\u6548\u8FC5\u8868\u793A\uFF0C\u5F88\u8363\u5E78\u80FD\u83B7\u5F97\u8FD9\u9879\u533B\u9662\u5DE5\u7A0B\uFF0C\u800C\u5B9E\u9645\u4E0A\uFF0C\u516C\u53F8\u8FD14\u5E74\u6765\u4E00\u76F4\u5728\u5168\u56FD\u5404\u5730\u63D0\u4F9B\u91CD\u8981\u57FA\u7840\u8BBE\u65BD\uFF0C\u5176\u4E2D\u5305\u62EC\u4E0E\u533B\u7597\u4FDD\u5065\u76F8\u5173\u7684\u8BBE\u65BD\u3002\u003C/p\u003E\n\u003Cp\u003E\u6839\u636E\u5408\u7EA6\uFF0C\u516C\u53F8\u9700\u8981\u8D1F\u8D23\u571F\u65B9\u5DE5\u7A0B\u3001\u5730\u9762\u5904\u7406\u5DE5\u7A0B\u3001\u6253\u6869\u548C\u57FA\u7840\u5DE5\u7A0B\u3001\u533B\u9662\u4E3B\u8981\u533A\u57DF\u7684\u5BA4\u5185\u8BBE\u8BA1\u3001\u673A\u7535\u670D\u52A1\uFF08\u5305\u62EC\u76F8\u5173\u533B\u7597\u8BBE\u5907\uFF09\uFF0C\u4EE5\u53CA\u4FE1\u606F\u548C\u6280\u672F\u5DE5\u7A0B\u7B49\u3002\u003C/p\u003E\n\u003Cp\u003E\u81F3\u4E8E\u53E6\u4E00\u9879\u5408\u7EA6\uFF0C\u4E3B\u8981\u8D1F\u8D23\u63D0\u4F9B18\u5C42\u697C\u9AD8\u7684\u529E\u516C\u5927\u697C\uFF0C\u540C\u6837\u572811\u6708\u4EFD\u52A8\u5DE5\uFF0C\u9884\u8BA1\u5C06\u8017\u65F636\u4E2A\u6708\u5B8C\u6210\uFF0C\u800C\u5408\u7EA6\u4EF7\u503C\u4E3A1\u4EBF5080\u4E07\u4EE4\u5409\u3002\u003C/p\u003E\n\u003Cp\u003E\u6587\u544A\u70B9\u51FA\uFF0C\u5728\u7EB3\u5165\u8FD9\u4E24\u9879\u5408\u7EA6\u540E\uFF0C\u516C\u53F8\u7684\u672A\u5B8C\u6210\u8BA2\u5355\u5904\u572846\u4EBF\u4EE4\u5409\u7684\u5065\u5EB7\u6C34\u5E73\u4E0A\uFF0C\u76F8\u4FE1\u80FD\u63D0\u632F\u51C0\u5229\u8868\u73B0\u3002\u003C/p\u003E\n\u003Cp\u003E\n\u6765\u6E90\uFF1Ahttps://mp.weixin.qq.com/s/oQ3YQqJTAxp7GaH6XbTG4A\u003C/p\u003E\n",
