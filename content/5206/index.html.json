  "route": "/5206/",
  "title": "\u9646\u5146\u798F:\u63D0\u9AD8\u6574\u4F53\u6548\u7387 \u9686\u673A\u573A\u6253\u9020\u4E1C\u76DF\u7269\u6D41\u67A2\u7EBD",
  "summary": "\uFF08\u96EA\u90A64\u65E5\u8BAF\uFF09\u4EA4\u901A\u90E8\u957F\u9646\u5146\u798F\u6307\u51FA\uFF0C\u653F\u5E9C\u81F4\u529B\u4E8E\u5C06\u9A6C\u6765\u897F\u4E9A\u5409\u9686\u5761\u56FD\u9645\u673A\u573A\u6253\u9020\u6210\u4E1C\u76DF\u7269\u6D41\u67A2\u7EBD\u4E2D\u5FC3\u3002 \u4ED6\u8BF4\uFF0C\u8D27\u8FD0\u4EE3\u7406\u548C\u8D27\u7269\u88C5\u5378\u7B49\u8F85\u52A9\u670D\u52A1\u5728\u63D0\u9AD8\u7269\u6D41\u751F\u6001\u7CFB\u7EDF\u6574\u4F53\u6548\u7387\u65B9\u9762\u53D1\u6325\u7740\u81F3\u5173\u91CD\u8981\u7684\u4F5C\u7528\uFF0C\u800C\u653F\u5E9C\u81F4\u529B\u4E8E\u901A\u8FC7\u6FC0\u52B1\u63AA\u65BD\u3001\u8865\u52A9\u91D1\u548C\u7B80\u5316\u6CD5\u89C4\u6765\u9F13\u52B1\u6295\u8D44\u548C\u521B\u65B0\uFF0C\u652F\u6301\u76F8\u5173\u670D\u52A1\u7684\u53D1\u5C55\u3002 \u4ED6\u8BF4\uFF0C\u57282019-2030\u5E74\u56FD\u5BB6\u4EA4\u901A\u653F\u7B56\u4E0B\uFF0C\u653F\u5E9C\u5C06\u4EE5\u52A0\u5F3A\u7BA1\u7406\u548C\u6253\u9020\u9002\u5E94\u7269\u6D41\u4E1A\u5FEB\u901F\u53D8\u5316\u9700\u6C42\u7684\u5236\u5EA6\u4E0E\u6846\u67B6\uFF0C\u4E3A\u4F18\u5148\u4E8B\u9879\u3002 \u9646\u5146\u798F\u4ECA\u5929\u5728\u96EA\u90A6\u963F\u91CC\u5DF4\u5DF4\u83DC\u9E1F\u822A\u7A7A\u57CE\u89C1\u8BC1MMAG \u63A7\u80A1\u65D7\u4E0B\u822A\u7A7A\u81C2\u8180MMAG \u822A\u7A7A\u8D22\u56E2\u79C1\u4EBA\u6709\u2026",
  "body": "\u003Cp\u003E\uFF08\u96EA\u90A64\u65E5\u8BAF\uFF09\u4EA4\u901A\u90E8\u957F\u9646\u5146\u798F\u6307\u51FA\uFF0C\u653F\u5E9C\u81F4\u529B\u4E8E\u5C06\u9A6C\u6765\u897F\u4E9A\u5409\u9686\u5761\u56FD\u9645\u673A\u573A\u6253\u9020\u6210\u4E1C\u76DF\u7269\u6D41\u67A2\u7EBD\u4E2D\u5FC3\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u8D27\u8FD0\u4EE3\u7406\u548C\u8D27\u7269\u88C5\u5378\u7B49\u8F85\u52A9\u670D\u52A1\u5728\u63D0\u9AD8\u7269\u6D41\u751F\u6001\u7CFB\u7EDF\u6574\u4F53\u6548\u7387\u65B9\u9762\u53D1\u6325\u7740\u81F3\u5173\u91CD\u8981\u7684\u4F5C\u7528\uFF0C\u800C\u653F\u5E9C\u81F4\u529B\u4E8E\u901A\u8FC7\u6FC0\u52B1\u63AA\u65BD\u3001\u8865\u52A9\u91D1\u548C\u7B80\u5316\u6CD5\u89C4\u6765\u9F13\u52B1\u6295\u8D44\u548C\u521B\u65B0\uFF0C\u652F\u6301\u76F8\u5173\u670D\u52A1\u7684\u53D1\u5C55\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u57282019-2030\u5E74\u56FD\u5BB6\u4EA4\u901A\u653F\u7B56\u4E0B\uFF0C\u653F\u5E9C\u5C06\u4EE5\u52A0\u5F3A\u7BA1\u7406\u548C\u6253\u9020\u9002\u5E94\u7269\u6D41\u4E1A\u5FEB\u901F\u53D8\u5316\u9700\u6C42\u7684\u5236\u5EA6\u4E0E\u6846\u67B6\uFF0C\u4E3A\u4F18\u5148\u4E8B\u9879\u3002\u003C/p\u003E\n\u003Cp\u003E\u9646\u5146\u798F\u4ECA\u5929\u5728\u96EA\u90A6\u963F\u91CC\u5DF4\u5DF4\u83DC\u9E1F\u822A\u7A7A\u57CE\u89C1\u8BC1MMAG \u63A7\u80A1\u65D7\u4E0B\u822A\u7A7A\u81C2\u8180MMAG \u822A\u7A7A\u8D22\u56E2\u79C1\u4EBA\u6709\u9650\u516C\u53F8\uFF08MAC\uFF09\u4E0EUnilode \u822A\u7A7A\u65B9\u6848\u7F14\u7ED3\u5408\u4F5C\u4F19\u4F34\u5173\u7CFB\u3002\u003C/p\u003E\n\u003Cp\u003E\u5728\u573A\u5305\u62ECMMAG\u63A7\u80A1\uFF08MMAG\uFF0C0034\uFF0C\u521B\u4E1A\u677F\uFF09\u4E3B\u5E2D\u4E39\u65AF\u91CC\u83AB\u54C8\u672B\u51EF\u9C81\u548CUnilode Aviation Solutions \u603B\u6267\u884C\u957F\u7F57\u65AF\u9A6C\u91CC\u8BFA\u3002\u003C/p\u003E\n\u003Cp\u003E\u5728\u8FD9\u9879\u5408\u4F5C\u4F19\u4F34\u5173\u7CFB\u4E0B\uFF0CUnilode \u5C06\u7387\u5148\u4E3AMAC \u65D7\u4E0B\u7684\u5546\u52A1\u7A7A\u8FD0\u5B50\u516C\u53F8MJets Air \u79C1\u4EBA\u6709\u9650\u516C\u53F8\u63D0\u4F9B\u5168\u7403\u5355\u4F4D\u8D1F\u8F7D\u88C5\u7F6E (ULD )\u7BA1\u7406\u670D\u52A1\u3002\u003C/p\u003E\n\u003Cp\u003EMAC\u5180\u4E3A\u5BA2\u6237\u63D0\u4F9B\u66F4\u4F18\u8D28\u670D\u52A1\uFF0C\u5E76\u4E14\u4E3A\u6F5C\u5728\u7684\u672A\u6765\u5408\u4F5C\u53D1\u5C55\u94FA\u8DEF\uFF0C\u5176\u4E2D\u5305\u62EC\u4E3A\u516C\u53F8\u65D7\u4E0B\u8FD0\u901A\u8D27\u8FD0\u7AD9\uFF08Xpress Cargo Terminal\uFF09\u8BBE\u7ACBULD \u7BA1\u7406\u4E2D\u5FC3\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/10/frc-3949b839d092e576340be8f10a171157.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u9646\u5146\u798F\uFF08\u4E2D\uFF09\u89C1\u8BC1\u83AB\u54C8\u672B\u51EF\u9C81\uFF08\u5DE6\uFF09\u79FB\u4EA4\u7EAA\u5FF5\u54C1\u7ED9\u7F57\u65AF\u9A6C\u91CC\u8BFA\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EUnilode\u4E0EMJets Air\u5408\u4F5C\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u63D0\u4F9B\u5355\u4F4D\u8D1F\u8F7D\u88C5\u7F6E\u7BA1\u7406\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003EMJets Air \u5C06\u62E5\u6709\u8D85\u8FC717\u4E072000\u4E2A\u5355\u4F4D\u8D1F\u8F7D\u88C5\u7F6E\u7684\u4F7F\u7528\u6743\u9650\uFF0C\u8FD9\u4E5F\u662F\u5168\u4E16\u754C\u6700\u5927\u7684\u6C47\u96C6\u7F51\u7EDC\u3002\u003C/p\u003E\n\u003Cp\u003EUnilode\u5219\u5C06\u63D0\u4F9B\u76F8\u5173\u7BA1\u7406\u548C\u89C4\u5212\uFF0C\u53EF\u4F7F\u7528\u8D85\u8FC750\u4E2A\u56FD\u9645\u673A\u573A\u7684ULD \u7EF4\u4FEE\u4E2D\u5FC3\uFF0C\u4EE5\u53CA\u5176\u6570\u5B57\u5316\u670D\u52A1\u65B9\u6848\u3002\u003C/p\u003E\n\u003Cp\u003E\u8FD9\u9879\u5408\u4F5C\u5173\u7CFB\u4E5F\u6709\u673A\u4F1A\u4FC3\u6210\u4E0E\u8FD0\u901A\u8D27\u8FD0\u7AD9(XCT)\u822A\u7A7A\u7684\u5408\u4F5C\uFF0C\u5728\u5185\u90E8\u8BBE\u4E13\u95E8\u7684ULD \u7BA1\u7406\u4E2D\u5FC3\uFF0C\u670D\u52A1\u80FD\u529B\u8303\u56F4\u5C06\u6269\u5C55\u81F3\u672C\u533A\u57DF\u5176\u4ED6\u5730\u533A\u3002\u003C/p\u003E\n\u003Cp\u003EMAC \u4E3B\u5E2D\u80E1\u9526\u8363\u5F3A\u8C03\u8FD9\u9879\u63AA\u65BD\u7684\u6218\u7565\u6027\u610F\u4E49\u65F6\u8BF4\uFF1A\u201C\u4E0EUnilode\u822A\u7A7A\u65B9\u6848\u7684\u5408\u4F5C\u5173\u7CFB\uFF0C\u5BF9MAC \u6765\u8BF4\u662F\u8FC8\u5411\u8F6C\u578B\u4E4B\u8DEF\uFF0C\u52A0\u5F3A\u7269\u6D41\u4E1A\u52A1\uFF0C\u4E5F\u534F\u52A9\u6211\u4EEC\u8D70\u5728\u4E1C\u5357\u4E9A\u822A\u7A7A\u4E1A\u7684\u524D\u6CBF\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u201C\u53E6\u5916\uFF0CMMAG \u63A7\u80A1\u4E0EMenzies Aviation \u7684\u7B56\u7565\u4F19\u4F34\u5173\u7CFB\u4E5F\u52A0\u5F3A\u4E86\u5730\u52E4\u670D\u52A1\uFF0C\u8FDB\u4E00\u6B65\u5151\u73B0\u63D0\u4F9B\u5168\u9762\u822A\u7A7A\u65B9\u6848\u670D\u52A1\u7684\u627F\u8BFA\u3002\u201D\u003C/p\u003E\n\u003Cp\u003EUnilode \u603B\u6267\u884C\u957F\u7F57\u65AF\u9A6C\u91CC\u8BFA\u8BF4\uFF1A\u201C\u6211\u4EEC\u5F88\u5174\u594B\u4E5F\u5F88\u8363\u5E78\u80FD\u591F\u4E0EMAC \u548C\u5176\u5B50\u516C\u53F8MJets Air \u5408\u4F5C\uFF0C\u6211\u4EEC\u5BF9\u81EA\u5DF1\u7684ULD \u7BA1\u7406\u65B9\u6848\u548C\u4E13\u4E1A\u77E5\u8BC6\u5F88\u6709\u4FE1\u5FC3\uFF0C\u76F8\u4FE1\u4F1A\u4E3AMAC \u5E26\u6765\u4EF7\u503C\u5E76\u534F\u52A9\u5176\u5B8C\u6210\u53D1\u5C55\u5927\u8BA1\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u4EEC\u4E5F\u5F88\u9AD8\u5174MAC \u9009\u62E9\u4E0EUnilode \u5408\u4F5C\uFF0C\u4EE5\u8FCE\u5408\u4ED6\u4EEC\u5BF9ULD \u7684\u9700\u6C42\uFF0C\u63A5\u4E0B\u6765\u4F1A\u91CD\u70B9\u5173\u6CE8\u4F18\u5316ULD \u7684\u4F7F\u7528\u7387\uFF0C\u81F4\u529B\u4E8E\u63D0\u9AD8\u6210\u672C\u6548\u7387\uFF0C\u4EE5\u53CA\u51CF\u5C11\u4E8C\u6C27\u5316\u78B3\u6392\u653E\u91CF\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/I_LqLnCSDgmD_2FmEIDyAQ\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
