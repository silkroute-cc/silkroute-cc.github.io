{
  "id": "\u96EA\u5170\u83AA5\u5927\u5BA4\u5185\u905B\u5A03\u597D\u53BB\u5904\u9644\u95E8\u7968\u6574\u7406",
  "slug": "\u96EA\u5170\u83AA5\u5927\u5BA4\u5185\u905B\u5A03\u597D\u53BB\u5904\u9644\u95E8\u7968\u6574\u7406",
  "canonicalUrlKey": "\u96EA\u5170\u83AA5\u5927\u5BA4\u5185\u905B\u5A03\u597D\u53BB\u5904\u9644\u95E8\u7968\u6574\u7406",
  "route": "/6177/",
  "title": "\u96EA\u5170\u83AA\uFF5C5\u5927\u5BA4\u5185\u905B\u5A03\u597D\u53BB\u5904\uFF5E\u9644\u95E8\u7968\u6574\u7406\uFF01",
  "summary": "\u9A6C\u6765\u897F\u4E9A\u8FDB\u5165\u4E1C\u5317\u5B63\u5019\u98CE\u5B63\u8282\uFF0C\u5BA4\u5185\u4EB2\u5B50\u51FA\u6E38\u6210\u4E3A\u4E0D\u5C11\u5BB6\u5EAD\u7684\u9009\u62E9\u3002\u672C\u6587\u6574\u7406\u96EA\u5170\u83AA5\u4E2A\u5BA4\u5185\u4EB2\u5B50\u597D\u53BB\u5904\uFF1ABeryl\u2019s\u5DE7\u514B\u529B\u535A\u7269\u9986\u514D\u8D39\u5165\u573A\uFF0CAI\u4E16\u754C\u4F53\u9A8C\u4E2D\u5FC3\u53EF\u4E0E\u4EBA\u5F62\u673A\u5668\u4EBA\u4E92\u52A8\uFF0CKidfornia\u5BA4\u5185\u6E38\u4E50\u573A\u8BBE\u6709\u6500\u722C\u5899\u4E0E\u7403\u6C60\u6ED1\u68AF\uFF0C\u82CF\u4E39\u963F\u5357\u6C99\u535A\u7269\u9986\u95E8\u79682\u81F35\u9A6C\u5E01\uFF0CIOI\u57CE\u5E02\u519C\u573A\u53EF\u89C2\u5BDF\u52A8\u690D\u7269\uFF0C\u5E76\u9644\u5F00\u653E\u65F6\u95F4\u4E0E\u7968\u4EF7\u53C2\u8003\u3002",
  "body": "\u003Cp\u003E\u0026#127783;\uFE0F\u9A6C\u6765\u897F\u4E9A\u8FDB\u5165\u4E1C\u5317\u5B63\u5019\u98CE\u5B63\u8282\uFF0C\u003C/p\u003E\n\u003Cp\u003E\u96E8\u5929\u5E26\u5A03\u51FA\u6E38\u4E5F\u4E0D\u6015\uFF01\u003C/p\u003E\n\u003Cp\u003E\u8FD9\u6B21\u6574\u7406\u4E86\u0026#127474;\u0026#127486;\u9A6C\u6765\u897F\u4E9A\u96EA\u5170\u83AA\u003C/p\u003E\n\u003Cp\u003E5\uFE0F\u20E3\u4E2A\u5BA4\u5185\u4EB2\u5B50\u597D\u53BB\u5904\uFF0C\u003C/p\u003E\n\u003Cp\u003E\u8BA9\u5C0F\u670B\u53CB\u8FB9\u73A9\u8FB9\u5B66\u4E60\uFF0C\u003C/p\u003E\n\u003Cp\u003E\u5927\u4EBA\u5C0F\u5B69\u90FD\u80FD\u627E\u5230\u5404\u81EA\u7684\u4E50\u8DA3\uFF01\u003C/p\u003E\n\u003Cp\u003E1\uFE0F\u20E3Beryl\u2019s \u5DE7\u514B\u529B\u535A\u7269\u9986\u003C/p\u003E\n\u003Cp\u003E\u23F0830AM-11.15AM\uFF5C130PM-330PM\uFF08\u5468\u4E00\u81F3\u5468\u516D\uFF09\u003C/p\u003E\n\u003Cp\u003E\u0026#127903;\uFE0F\u514D\u8D39\u5165\u573A\u003C/p\u003E\n\u003Cp\u003E\u5E26\u5C0F\u670B\u53CB\u8D70\u8FDB\u5DE7\u514B\u529B\u7684\u4E16\u754C\u0026#127851; \u901A\u8FC7\u5BFC\u89C8\u4E86\u89E3\u53EF\u53EF\u7684\u6765\u6E90\u4E0E\u5DE7\u514B\u529B\u7684\u5236\u4F5C\u8FC7\u7A0B\uFF0C\u8FD8\u80FD\u53C2\u89C2\u5C55\u793A\u590D\u53E4\u673A\u5668\u548C\u5404\u5F0F\u5DE7\u514B\u529B\u5305\u88C5\u7684\u5C55\u9986\u3002\u53C2\u89C2\u7ED3\u675F\u540E\uFF0C\u522B\u5FD8\u4E86\u5230\u5E97\u5185\u901B\u901B\uFF0C\u5404\u5F0F\u5DE7\u514B\u529B\u7433\u7405\u6EE1\u76EE\uFF0C\u8BA9\u4EBA\u5FCD\u4E0D\u4F4F\u60F3\u5E26\u51E0\u76D2\u56DE\u5BB6\uFF01\u0026#128525;\u003C/p\u003E\n\u003Cp\u003E2\uFE0F\u20E3AI \u4E16\u754C\u4F53\u9A8C\u4E2D\u5FC3\u003C/p\u003E\n\u003Cp\u003E\u23F0\u6BCF\u65E510AM-10PM\u003C/p\u003E\n\u003Cp\u003E\u0026#127903;\uFE0FRM25~RM40\u003C/p\u003E\n\u003Cp\u003E\u8D70\u8FDB AI \u79D1\u6280\u4E16\u754C\uFF01 \u0026#129302;\u8FD9\u91CC\u4E0D\u4EC5\u80FD\u8BA4\u8BC6\u4EBA\u5DE5\u667A\u80FD\uFF0C\u8FD8\u80FD\u4E0E\u4EBA\u5F62\u673A\u5668\u4EBA\u4E92\u52A8\uFF0C\u4F53\u9A8C\u5404\u79CD\u8DA3\u5473\u79D1\u6280\u6E38\u620F\uFF0C\u8BA9\u5B69\u5B50\u5728\u73A9\u4E50\u4E2D\u63A2\u7D22\u65B0\u79D1\u6280\uFF0C\u8FB9\u73A9\u8FB9\u5B66\u4E60\uFF0C\u5F00\u542F\u4E0D\u4E00\u6837\u7684\u4EB2\u5B50\u4F53\u9A8C\uFF01\u2728\u003C/p\u003E\n\u003Cp\u003E3\uFE0F\u20E3Kidfornia \u5BA4\u5185\u6E38\u4E50\u573A\u003C/p\u003E\n\u003Cp\u003E\u23F012PM-9PM\uFF08\u5468\u4E8C\u81F3\u5468\u4E94\uFF09\uFF5C11AM-10PM\uFF08\u5468\u672B/\u516C\u5047\uFF09\u003C/p\u003E\n\u003Cp\u003E\u0026#127903;\uFE0FRM10~RM45\u003C/p\u003E\n\u003Cp\u003E\u74DC\u62C9\u96EA\u5170\u83AA\u7B2C\u4E00\u4E2A\u5BA4\u5185\u513F\u7AE5\u6E38\u4E50\u573A\uFF0C\u8BBE\u6709\u6500\u722C\u5899\u3001\u969C\u788D\u8BBE\u65BD\u3001\u7403\u6C60\u6ED1\u68AF\uFF0C\u8FD8\u6709\u6A21\u62DF\u8D85\u5E02\u3001\u53A8\u623F\u53CA\u5EFA\u7B51\u6E38\u620F\u533A\uFF0C\u8BA9\u5B69\u5B50\u5728\u73A9\u4E50\u4E2D\u953B\u70BC\u534F\u8C03\u80FD\u529B\u4E0E\u521B\u9020\u529B\uFF01\u53E6\u5916\u4E5F\u8BBE\u6709\u9002\u5408\u5E7C\u513F\u7684 Babyland\uFF0C\u5927\u5C0F\u670B\u53CB\u90FD\u80FD\u73A9\u5F97\u5C3D\u5FC3\uFF01\u0026#128525;\u003C/p\u003E\n\u003Cp\u003E4\uFE0F\u20E3\u82CF\u4E39\u963F\u5357\u6C99\u535A\u7269\u9986\u003C/p\u003E\n\u003Cp\u003E\u23F0930AM-430PM\uFF08\u5468\u4E8C\u81F3\u5468\u56DB\uFF09\u003C/p\u003E\n\u003Cp\u003E\u23F0930AM-1230PM\uFF5C245PM-430PM\uFF08\u5468\u4E94\uFF09\u003C/p\u003E\n\u003Cp\u003E\u0026#127903;\uFE0FRM2~RM5\u003C/p\u003E\n\u003Cp\u003E\u60F3\u8BA9\u5B69\u5B50\u8BA4\u8BC6\u96EA\u5170\u83AA\u7684\u5386\u53F2\u6587\u5316\uFF0C\u4E0D\u59A8\u5B89\u6392\u4E00\u8D9F\u535A\u7269\u9986\u4E4B\u65C5\uFF01\u9986\u5185\u8BBE\u6709\u5386\u53F2\u3001\u591A\u5143\u6587\u5316\u3001\u81EA\u7136\u751F\u6001\u53CA\u9A6C\u6765\u6587\u5316\u7B49\u5C55\u533A\uFF0C\u4ECE\u73CD\u8D35\u6587\u7269\u3001\u52A8\u7269\u6807\u672C\u5230\u4F20\u7EDF\u751F\u6D3B\u573A\u666F\u6A21\u578B\u90FD\u80FD\u770B\u5230\uFF5E\u9986\u5916\u8FD8\u6709\u65E7\u706B\u8F66\u5934\u4E0E\u5386\u53F2\u8F66\u8F86\u7B49\u5C55\u54C1\u53EF\u6253\u5361\u62CD\u7167\u0026#128247;\u2728\u003C/p\u003E\n\u003Cp\u003E5\uFE0F\u20E3IOI \u57CE\u5E02\u519C\u573A\u003C/p\u003E\n\u003Cp\u003E\u23F0\u6BCF\u65E510AM-9PM\u003C/p\u003E\n\u003Cp\u003E\u0026#127903;\uFE0FRM32~RM215\u003C/p\u003E\n\u003Cp\u003E\u4E0D\u7528\u5230\u6237\u5916\u519C\u573A\uFF0C\u4E5F\u80FD\u5E26\u5B69\u5B50\u8BA4\u8BC6\u52A8\u690D\u7269\uFF01\u8FD9\u91CC\u8BBE\u6709\u7EFF\u8272\u690D\u7269\u4E0E\u6606\u866B\u5C55\u533A\u3001\u53EF\u8FD1\u8DDD\u79BB\u89C2\u5BDF\u5C0F\u52A8\u7269\u7684 Little Rimba\uFF0C\u4EE5\u53CA\u62E5\u6709\u8D85\u8FC7 50 \u79CD\u9C7C\u7C7B\u548C\u6C34\u751F\u751F\u7269\u7684 Fresh Water World\uFF0C\u9002\u5408\u4EB2\u5B50\u4E00\u8D77\u63A2\u7D22\u5927\u81EA\u7136\u7684\u5965\u5999\uFF5E\u0026#128032;\u003C/p\u003E\n\u003Cp\u003E\u56FE\u6E90\uFF1A Tourism Selangor\u3001Kidfornia Kuala Selangor\u3001Muzium Sultan Alam Shah\u3001IOI City Farm\u003C/p\u003E\n",
