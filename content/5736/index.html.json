  "id": "%e8%8b%8f%e5%b7%9e%e6%a1%a6%e6%b1%89%e7%a7%91%e6%8a%80%e8%8b%8f%e5%b7%9e%e6%a1%a6%e5%8f%af%e8%a7%86%e4%b8%8e%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e9%9c%b9%e9%9b%b3%e5%b7%9e%e5%8f%91%e5%b1%95%e7%ad%be",
  "slug": "%e8%8b%8f%e5%b7%9e%e6%a1%a6%e6%b1%89%e7%a7%91%e6%8a%80%e8%8b%8f%e5%b7%9e%e6%a1%a6%e5%8f%af%e8%a7%86%e4%b8%8e%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e9%9c%b9%e9%9b%b3%e5%b7%9e%e5%8f%91%e5%b1%95%e7%ad%be",
  "canonicalUrlKey": "%e8%8b%8f%e5%b7%9e%e6%a1%a6%e6%b1%89%e7%a7%91%e6%8a%80%e8%8b%8f%e5%b7%9e%e6%a1%a6%e5%8f%af%e8%a7%86%e4%b8%8e%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e9%9c%b9%e9%9b%b3%e5%b7%9e%e5%8f%91%e5%b1%95%e7%ad%be",
  "route": "/5736/",
  "title": "\u82CF\u5DDE\u6866\u6C49\u79D1\u6280\u82CF\u5DDE\u6866\u53EF\u89C6\u4E0E\u9A6C\u6765\u897F\u4E9A\u9739\u96F3\u5DDE\u53D1\u5C55\u7B7E\u7EA6\u6021\u4FDD\u5927\u6570\u636E\u4E2D\u5FC3\u3001\u91D1\u5B9D\u592A\u9633\u80FD\u53D1\u7535EPC\u3001\u667A\u6167\u6C34\u8868\u53CA\u6570\u5B57\u5316\u6C34\u52A1\u7CFB\u7EDF\u5EFA\u8BBE\u4E09\u5927\u9879\u76EE",
  "summary": "11\u670815\u65E5\uFF0C\u9A6C\u6765\u897F\u4E9A CSS\u96C6\u56E2\u9996\u5E2D\u6267\u884C\u5B98\u738B\u5EF7\u6587\u3001 \u8463\u4E8B\u62FF\u7763\u82CF\u54C8\u5179\u739B\u00B7\u5BBE\u8482\u00B7\u624E\u624E\u91CC\u7B49\u4E00\u884C17\u4EBA\u8385\u4E34\u82CF\u5DDE\u6866\u6C49\u79D1\u6280\u3002\u53CC\u65B9\u56F4\u7ED5\u7B97\u529B\u3001\u5927\u6570\u636E\u4E0E\u7EFF\u8272\u80FD\u6E90\u7B49\u524D\u6CBF\u9886\u57DF\u5C55\u5F00\u6DF1\u5EA6\u4EA4\u6D41\uFF0C\u5728\u5DE9\u56FA\u65E2\u6709\u5408\u4F5C\u6210\u679C\u7684\u540C\u65F6\uFF0C\u5171\u540C\u63A2\u7D22\u6570\u5B57\u672A\u6765\u53D1\u5C55\u65B9\u5411\u3002 \u5728\u82CF\u5DDE\u6866\u6C49\u79D1\u6280\u526F\u603B\u7ECF\u7406\u66FE\u5409\u5FD7\u7684\u966A\u540C\u4E0B\uFF0C\u8BBF\u95EE\u56E2\u9996\u5148\u53C2\u89C2\u4E86\u6866\u6C49\u667A\u80FD\u5C55\u5385\u3002\u53CC\u65B9\u91CD\u70B9\u4EA4\u6D41\u4E86\u7B97\u529B\u4E2D\u5FC3\u4E0E\u5927\u6570\u636E\u6280\u672F\u7B49\u4EA7\u4E1A\u6838\u5FC3\u9A71\u52A8\u529B\u3002\u8BBF\u95EE\u56E2\u5BF9\u6866\u6C49\u5728\u667A\u6167\u89E3\u51B3\u65B9\u6848\u3001\u6570\u636E\u4EF7\u503C\u6316\u6398\u53CA\u884C\u4E1A\u8D4B\u80FD\u5E94\u7528\u7B49\u9886\u57DF\u6240\u5C55\u73B0\u51FA\u7684\u521B\u65B0\u5B9E\u529B\u4E0E\u524D\u77BB\u5E03\u5C40\u8868\u73B0\u51FA\u6D53\u539A\u5174\u8DA3\uFF0C\u5E76\u7ED9\u4E88\u9AD8\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2025/11/image-94-1024x576.webp\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E11\u670815\u65E5\uFF0C\u9A6C\u6765\u897F\u4E9A\u003Cstrong\u003ECSS\u96C6\u56E2\u9996\u5E2D\u6267\u884C\u5B98\u738B\u5EF7\u6587\u3001\u003C/strong\u003E\u8463\u4E8B\u62FF\u7763\u82CF\u54C8\u5179\u739B\u0026#183;\u5BBE\u8482\u0026#183;\u624E\u624E\u91CC\u7B49\u4E00\u884C17\u4EBA\u8385\u4E34\u82CF\u5DDE\u6866\u6C49\u79D1\u6280\u3002\u53CC\u65B9\u56F4\u7ED5\u7B97\u529B\u3001\u5927\u6570\u636E\u4E0E\u7EFF\u8272\u80FD\u6E90\u7B49\u524D\u6CBF\u9886\u57DF\u5C55\u5F00\u6DF1\u5EA6\u4EA4\u6D41\uFF0C\u5728\u5DE9\u56FA\u65E2\u6709\u5408\u4F5C\u6210\u679C\u7684\u540C\u65F6\uFF0C\u5171\u540C\u63A2\u7D22\u6570\u5B57\u672A\u6765\u53D1\u5C55\u65B9\u5411\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2025/11/image-95-1024x576.webp\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5728\u82CF\u5DDE\u6866\u6C49\u79D1\u6280\u526F\u603B\u7ECF\u7406\u66FE\u5409\u5FD7\u7684\u966A\u540C\u4E0B\uFF0C\u8BBF\u95EE\u56E2\u9996\u5148\u53C2\u89C2\u4E86\u6866\u6C49\u667A\u80FD\u5C55\u5385\u3002\u53CC\u65B9\u91CD\u70B9\u4EA4\u6D41\u4E86\u7B97\u529B\u4E2D\u5FC3\u4E0E\u5927\u6570\u636E\u6280\u672F\u7B49\u4EA7\u4E1A\u6838\u5FC3\u9A71\u52A8\u529B\u3002\u8BBF\u95EE\u56E2\u5BF9\u6866\u6C49\u5728\u667A\u6167\u89E3\u51B3\u65B9\u6848\u3001\u6570\u636E\u4EF7\u503C\u6316\u6398\u53CA\u884C\u4E1A\u8D4B\u80FD\u5E94\u7528\u7B49\u9886\u57DF\u6240\u5C55\u73B0\u51FA\u7684\u521B\u65B0\u5B9E\u529B\u4E0E\u524D\u77BB\u5E03\u5C40\u8868\u73B0\u51FA\u6D53\u539A\u5174\u8DA3\uFF0C\u5E76\u7ED9\u4E88\u9AD8\u5EA6\u8BC4\u4EF7\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2025/11/image-96.webp\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2025/11/image-97.webp\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u968F\u540E\uFF0C\u4E00\u884C\u4EBA\u524D\u5F80\u6866\u6C49\u667A\u80FD\u5DE5\u5382\u5B9E\u5730\u8003\u5BDF\uFF0C\u82CF\u5DDE\u6866\u6C49\u79D1\u6280\u526F\u603B\u7ECF\u7406\u82CF\u5F00\u6587\u966A\u540C\u63A5\u5F85\u3002\u9AD8\u5EA6\u81EA\u52A8\u5316\u3001\u6570\u5B57\u5316\u7684\u751F\u4EA7\u6D41\u7A0B\uFF0C\u4EE5\u53CA\u8D2F\u7A7F\u59CB\u7EC8\u7684\u7CBE\u76CA\u7BA1\u7406\u4F53\u7CFB\uFF0C\u751F\u52A8\u5448\u73B0\u4E86\u6866\u6C49\u79D1\u6280\u5C06\u524D\u6CBF\u6280\u672F\u8F6C\u5316\u4E3A\u9AD8\u7AEF\u5236\u9020\u786C\u6838\u5B9E\u529B\u7684\u5353\u8D8A\u80FD\u529B\uFF0C\u4E3A\u6DF1\u5316\u5408\u4F5C\u63D0\u4F9B\u4E86\u6709\u529B\u652F\u6491\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2025/11/image-98-1024x630.webp\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\uFF08\u6021\u4FDD\u5927\u6570\u636E\u4E2D\u5FC3\u3001\u91D1\u5B9D\u592A\u9633\u80FD\u53D1\u7535EPC\u9879\u76EE\u7B7E\u7EA6\uFF09\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2025/11/image-99-1024x551.webp\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\uFF08\u667A\u6167\u6C34\u8868\u53CA\u6570\u5B57\u5316\u6C34\u52A1\u7CFB\u7EDF\u5EFA\u8BBE\u9879\u76EE\u7B7E\u7EA6\uFF09\u003C/p\u003E\n\u003Cp\u003E\u884C\u7A0B\u7684\u538B\u8F74\u73AF\u8282\uFF0C\u662F\u82CF\u5DDE\u6866\u6C49\u79D1\u6280\u3001\u82CF\u5DDE\u6866\u53EF\u89C6\u4E0E\u9A6C\u6765\u897F\u4E9A\u9739\u96F3\u5DDE\u53D1\u5C55\u516C\u53F8\u5C31\u9A6C\u6765\u897F\u4E9A\u6021\u4FDD\u5927\u6570\u636E\u4E2D\u5FC3\u3001\u91D1\u5B9D\u592A\u9633\u80FD\u53D1\u7535EPC\u3001\u667A\u6167\u6C34\u8868\u53CA\u6570\u5B57\u5316\u6C34\u52A1\u7CFB\u7EDF\u5EFA\u8BBE\u4E09\u5927\u9879\u76EE\u4E3E\u884C\u7B7E\u7EA6\u3002\u6B64\u6B21\u5408\u4F5C\u65E8\u5728\u901A\u8FC7\u5EFA\u8BBE\u5148\u8FDB\u8282\u80FD\u7684\u6570\u636E\u4E2D\u5FC3\uFF0C\u63A8\u52A8\u9A6C\u6765\u897F\u4E9A\u6210\u4E3A\u533A\u57DFAI\u4E0E\u9AD8\u6027\u80FD\u8BA1\u7B97\u67A2\u7EBD\uFF1B\u5F00\u53D1\u53EF\u6269\u5C55\u7684\u592A\u9633\u80FD\u751F\u6001\u7CFB\u7EDF\uFF0C\u6574\u5408\u519C\u4E1A\u5149\u4F0F\u4E0E\u7EFF\u8272\u79D1\u6280\u6295\u8D44\uFF1B\u5E76\u501F\u52A9\u7269\u8054\u7F51\u667A\u80FD\u6C34\u8868\u4E0E\u5B9E\u65F6\u6570\u636E\u5206\u6790\uFF0C\u4F18\u5316\u9739\u96F3\u5DDE\u6C34\u52A1\u7BA1\u7406\u6548\u7387\u4E0E\u670D\u52A1\u54C1\u8D28\uFF0C\u5171\u540C\u6253\u9020\u4EE5\u7EFF\u8272\u80FD\u6E90\u8D4B\u80FD\u6570\u5B57\u57FA\u5EFA\u7684\u4E2D\u9A6C\u5408\u4F5C\u5178\u8303\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2025/11/image-100-1024x495.webp\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u6866\u6C49\u79D1\u6280Ennoconn\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2025/11/image-101-1024x393.webp\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003EPerak Corp Bhd\uFF08\u9739\u96F3\u5DDE\u53D1\u5C55\u516C\u53F8\uFF09\u662F\u4E00\u5BB6\u5728\u9A6C\u6765\u897F\u4E9A\u6CE8\u518C\u7684\u591A\u5143\u5316\u516C\u53F8\uFF0C\u5176\u6838\u5FC3\u4E1A\u52A1\u6DB5\u76D6\u6E2F\u53E3\u548C\u7269\u6D41\u3001\u623F\u5730\u4EA7\u5F00\u53D1\u3001\u9152\u5E97\u548C\u65C5\u6E38\u4EE5\u53CA\u7BA1\u7406\u670D\u52A1\u3002\u516C\u53F8\u4E3B\u8981\u6536\u5165\u6765\u6E90\u4E8E\u6E2F\u53E3\u548C\u7269\u6D41\u90E8\u95E8\uFF0C\u8BE5\u90E8\u95E8\u5728\u9739\u96F3\u5DDE\u7684\u65AF\u91CC\u66FC\u7ED2\u7BA1\u7406\u7740\u4E00\u4E2A\u4E13\u95E8\u7684\u7164\u70AD\u7801\u5934\uFF0C\u63D0\u4F9B\u62D6\u8239\u3001\u8D27\u7269\u88C5\u5378\u3001\u4ED3\u50A8\u7B49\u7EFC\u5408\u670D\u52A1\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E1A\u52A1\u6982\u8FF0\u003C/p\u003E\n\u003Cp\u003E\u6E2F\u53E3\u548C\u7269\u6D41: \u8FD9\u662F\u516C\u53F8\u7684\u4E3B\u8981\u6536\u5165\u6765\u6E90\uFF0C\u8D1F\u8D23\u8FD0\u8425\u548C\u7BA1\u7406\u4F4D\u4E8E\u9739\u96F3\u5DDE\u65AF\u91CC\u66FC\u7ED2\u7684Janakuasa Sultan Azlan Shah\u7801\u5934\uFF0C\u5E76\u63D0\u4F9B\u4E00\u7CFB\u5217\u6E2F\u53E3\u548C\u7269\u6D41\u670D\u52A1\uFF0C\u5305\u62EC\u62D6\u8239\u3001\u8D27\u7269\u88C5\u5378\u548C\u4ED3\u50A8\u3002\u003C/p\u003E\n\u003Cp\u003E\u623F\u5730\u4EA7\u5F00\u53D1: \u516C\u53F8\u53C2\u4E0E\u5404\u79CD\u623F\u5730\u4EA7\u9879\u76EE\u7684\u5F00\u53D1\u4E1A\u52A1\u3002\u003C/p\u003E\n\u003Cp\u003E\u9152\u5E97\u548C\u65C5\u6E38: \u6D89\u8DB3\u9152\u5E97\u548C\u65C5\u6E38\u4E1A\u76F8\u5173\u4E1A\u52A1\u3002\u003C/p\u003E\n\u003Cp\u003E\u7BA1\u7406\u670D\u52A1: \u63D0\u4F9B\u5404\u7C7B\u7BA1\u7406\u670D\u52A1\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2025/11/image-102-1024x218.webp\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003EPerak Corporation Berhad (Perak Corp), listed in the main board of Bursa Saham Malaysia, is a subsidiary of Perbadanan Kemajuan Negeri Perak Group (PKNPk Group) and was established in 1991 with paid-up capital of RM100 million.\u003C/p\u003E\n\u003Cp\u003EPerak Corp\u2019s main activities are streamlined into four (4) core businesses: Land \u0026amp; Property, Port \u0026amp; Logistics, Hospitality \u0026amp; Tourism and Management Services.\u003C/p\u003E\n\u003Cp\u003EPerak Corp has 17 subsidiaries and 2 associate companies as an investment holding company with four (4) core businesses in key growth sectors; Perak Corp continues to deliver sustainable communities and value to the region\u2019s economy.\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2025/11/image-103-1024x198.webp\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u82CF\u5DDE\u6866\u6C49\u79D1\u6280\u6709\u9650\u516C\u53F8\u6210\u7ACB\u4E8E2017\u5E746\u670829\u65E5\uFF0C\u662F\u6866\u6C49\u79D1\u6280\u5728\u4E2D\u56FD\u5927\u9646\u7684\u603B\u90E8\u3002\u516C\u53F8\u4E13\u6CE8\u4E8E\u5DE5\u4E1A\u63A7\u5236\u8BA1\u7B97\u673A\u53CA\u7CFB\u7EDF\u5236\u9020\uFF0C\u4E3B\u8425\u4E1A\u52A1\u6DB5\u76D6\u667A\u80FD\u4EA4\u901A\u3001\u667A\u80FD\u5236\u9020\u3001\u667A\u80FD\u96F6\u552E\u7B49\u9886\u57DF \u3002\u901A\u8FC7\u5168\u7403\u6218\u7565\u5E03\u5C40\uFF0C\u5148\u540E\u4E0E\u5BCC\u58EB\u5EB7\u3001\u5965\u5730\u5229S\u0026amp;T\u7B49\u4F01\u4E1A\u5EFA\u7ACB\u5408\u4F5C\u30022007\u5E74\u4E0E\u5BCC\u58EB\u5EB7\u5408\u4F5C\uFF0C2016\u5E74\u5165\u80A1\u5965\u5730\u5229S\u0026amp;T\uFF0C\u63A8\u52A8\u5DE5\u4E1A4.0\u4EA7\u4E1A\u5347\u7EA7\u3002\u516C\u53F8\u62E5\u6709\u7701\u7EA7\u4E13\u7CBE\u7279\u65B0\u4F01\u4E1A\u3001\u9AD8\u65B0\u4F01\u4E1A\u7B49\u8D44\u8D28\uFF0C2024\u5E74\u4E2D\u6807\u65B0\u80FD\u6E90\u6C7D\u8F66\u5145\u7535\u6869\u751F\u4EA7\u9879\u76EE\uFF0C\u5E76\u591A\u6B21\u53C2\u4E0E\u56FD\u9645\u5C55\u4F1A\u5C55\u793A\u6280\u672F\u6210\u679C\u3002\u003C/p\u003E\n\u003Cp\u003E\u6866\u6C49\u79D1\u6280\uFF0C\u81EA2014\u5E74\u4E0A\u5E02\u4EE5\u6765\uFF0C\u59CB\u7EC8\u9886\u822A\u6280\u672F\u9769\u65B0\u7684\u6D6A\u6F6E\u3002\u516C\u53F8\u4E13\u6CE8\u4E8E\u4EBA\u5DE5\u667A\u6167\u4E0E\u7269\u8054\u7F51\uFF08AIoT\uFF09\u3001\u4E91\u7AEF\u7BA1\u7406\u3001\u751F\u6210\u5F0FAI\u3001\u673A\u5668\u89C6\u89C9\u7B49\u524D\u6CBF\u6280\u672F\uFF0C\u4E3A\u5168\u7403\u667A\u6167\u5236\u9020\u3001\u667A\u6167\u80FD\u6E90\u3001\u667A\u6167\u96F6\u552E\u3001\u667A\u6167\u91D1\u878D\u3001\u667A\u6167\u5BB6\u5C45\u7B49\u884C\u4E1A\u63D0\u4F9B\u5353\u8D8A\u7684\u4EA7\u54C1\u4E0E\u89E3\u51B3\u65B9\u6848\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E3A\u6DF1\u5EA6\u62D3\u5C55\u5185\u5730\u5E02\u573A\uFF0C\u4E8E2017\u5E74\u6210\u7ACB\u82CF\u5DDE\u6866\u6C49\u79D1\u6280\u6709\u9650\u516C\u53F8\uFF0C\u6253\u9020\u4E1A\u754C\u9886\u5148\u7684\u7814\u53D1\u3001\u4E1A\u52A1\u4E0E\u5236\u9020\u4E2D\u5FC3\u3002\u82CF\u5DDE\u6866\u6C49\u7684\u4EA7\u54C1\u4E0E\u670D\u52A1\u8986\u76D6\u5DE5\u4E1A\u7535\u8111\u3001\u5DE5\u4E1A\u4E92\u8054\u7F51\u3001\u6C7D\u8F66\u7535\u5B50\u3001\u65B0\u80FD\u6E90\u3001\u667A\u6167\u57CE\u5E02\u53CA\u667A\u6167\u533B\u7597\u7B49\u6838\u5FC3\u9886\u57DF\uFF0C\u5145\u5206\u5C55\u73B0\u4E86\u6866\u6C49\u79D1\u6280\u5728\u6280\u672F\u521B\u65B0\u548C\u5E02\u573A\u5E94\u7528\u65B9\u9762\u7684\u5353\u8D8A\u5B9E\u529B\u3002\u003C/p\u003E\n\u003Cp\u003E\u6866\u6C49\u79D1\u6280\u901A\u8FC7\u6570\u4F4D\u5316\u8F6C\u578B\uFF0C\u5F15\u9886\u667A\u6167\u89E3\u51B3\u65B9\u6848\u5373\u670D\u52A1ESaaS(Ennoconn Solution as a Service)\u7684\u65B0\u6A21\u5F0F\uFF0C\u6301\u7EED\u63A8\u52A8\u667A\u80FD\u89E3\u51B3\u65B9\u6848\u4E0E\u670D\u52A1\u7684\u521B\u65B0\u4E0E\u5347\u7EA7\uFF0C\u4E3A\u5168\u7403\u5BA2\u6237\u5E26\u6765\u66F4\u9AD8\u6548\u3001\u66F4\u667A\u80FD\u3001\u66F4\u524D\u6CBF\u7684\u79D1\u6280\u4F53\u9A8C\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2025/11/image-104.webp\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Ca href=\u0022https://mp.weixin.qq.com/s?__biz=Mzg5ODU3MTE5OA%3D%3D\u0026amp;mid=2247603144\u0026amp;idx=1\u0026amp;sn=c53ba86a51972d1b19e716e8759e95b8\u0026amp;chksm=c1b9d01f29641d4f474b72886de1234adc77cddbec6482d836c5a696052cc1846a789e15ceba\u0026amp;forbs=1\u0026amp;scene=126\u0026amp;subscene=91\u0026amp;sessionid=1763267825\u0026amp;flutter_pos=0\u0026amp;clicktime=1763267996\u0026amp;enterid=1763267996\u0026amp;finder_biz_enter_id=5\u0026amp;jumppath=20020_1763267910571%2CWebViewStubProxyUI_1763267911342%2C20020_1763267911454%2C50094_1763267977425\u0026amp;jumppathdepth=4\u0026amp;ascene=56\u0026amp;fasttmpl_type=0\u0026amp;fasttmpl_fullversion=7997301-zh_CN-zip\u0026amp;fasttmpl_flag=0\u0026amp;realreporttime=1763267996897\u0026amp;devicetype=android-36\u0026amp;version=28003e41\u0026amp;nettype=WIFI\u0026amp;abtest_cookie=AAACAA%3D%3D\u0026amp;lang=zh_CN\u0026amp;session_us=gh_5592ee75bd2e\u0026amp;countrycode=MY\u0026amp;exportkey=n_ChQIAhIQSvDtajQMLumPJ7G%2FuqHTQBLoAQIE97dBBAEAAAAAAOk9JueuinUAAAAOpnltbLcz9gKNyK89dVj0E2aMtfkrVkxCvfISaFJusfbCJUccmWjqmKcbfDJpX10xrAxwz4MTqC1YXbD6bmMZCSY6xUC2OBVqiOtTEyiz8%2BBff6UCR8i0%2F2tb9C3AK1zPjZidxb9OR0RxjcY8R8L%2BWSnDyRyEW%2FzeREBFBv1%2FvndV%2BGHPr%2BO5HOFHLozAhN7EowvWDpAG3UlOB0K5RUO6eqtrdZc2cw0DS2dA5UqLqLJ6RjOmCGoQ4Ummvh0JvmR%2BaiBEyK%2Fl%2FHzdmsUYIMRqvuE%3D\u0026amp;pass_ticket=NWGYRpZpAW6shcXZoYQTHN7wcW7J9lTxc25dIfpwWZ9gKiGJQ36CWyZJvGKY0z%2Bg\u0026amp;wx_header=3\u0022 rel=\u0022noopener noreferrer\u0022\u