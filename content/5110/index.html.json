  "title": "KLIA\u63A5\u9A73\u8F66\u7EC4\u88C5\u8BD5\u8DD1 \u65992025\u5E741\u6708\u5E95\u91CD\u65B0\u8FD0\u4F5C",
  "summary": "\u5168\u65B0\u7684\u673A\u573A\u63A5\u9A73\u7535\u8F66\u5DF2\u8FD0\u62B5\u5409\u9686\u5761\u56FD\u9645\u673A\u573A\u5217\u8F66\u5E93\u3002 \uFF08\u5409\u9686\u57612\u65E5\u8BAF\uFF09\u4EA4\u901A\u90E8\u957F\u9646\u5146\u798F\u62AB\u9732\uFF0C\u5409\u9686\u5761\u56FD\u9645\u673A\u573A\u7684\u63A5\u9A73\u7535\u8F66\uFF08KLIA Aerotrain\uFF09\u9884\u6599\u5C06\u5728\u660E\u5E741\u670831\u65E5\u91CD\u65B0\u6295\u5165\u8FD0\u4F5C\u3002 \u4ED6\u8BF4\uFF0C\u5D2D\u65B0\u7684\u4E24\u5217\u673A\u573A\u63A5\u9A73\u7535\u8F66\u5DF2\u4E8E\u65E5\u524D\u8FD0\u62B5\u5409\u9686\u5761\u56FD\u9645\u673A\u573A\u5217\u8F66\u5E93\uFF0C\u63A5\u4E0B\u6765\u7535\u8F66\u5C06\u8FDB\u5165\u7EC4\u88C5\u548C\u8BD5\u8DD1\u9636\u6BB5\u3002 \u201C\u4E24\u5217\u7535\u8F66\u5C06\u8FDB\u5165\u957F\u8FBE4\u81F35\u4E2A\u6708\u7684\u6D4B\u8BD5\uFF0C\u9884\u659910\u6708\u5DE6\u53F3\u5C31\u4F1A\u5F00\u59CB\u8BD5\u8DD1\u81F3\u660E\u5E741\u6708\u4E2D\uFF0C\u82E5\u4E00\u5207\u987A\u5229\uFF0C\u4E24\u5217\u63A5\u9A73\u7535\u8F66\u53EF\u5728\u660E\u5E741\u670831\u65E5\u6B63\u5F0F\u6295\u5165\u8FD0\u4F5C\u3002\u201D \u9646\u5146\u798F\u4ECA\u65E9\u5230\u5409\u9686\u5761\u56FD\u9645\u673A\u573A\u5DE1\u89C6\u63A5\u9A73\u7535\u8F66\u7684\u5B89\u88C5\u5DE5\u7A0B\u540E\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/09/frc-ed5dc02724ec260a4b63c4a13261268a.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5168\u65B0\u7684\u673A\u573A\u63A5\u9A73\u7535\u8F66\u5DF2\u8FD0\u62B5\u5409\u9686\u5761\u56FD\u9645\u673A\u573A\u5217\u8F66\u5E93\u3002\u003C/p\u003E\n\u003Cp\u003E\uFF08\u5409\u9686\u57612\u65E5\u8BAF\uFF09\u4EA4\u901A\u90E8\u957F\u9646\u5146\u798F\u62AB\u9732\uFF0C\u5409\u9686\u5761\u56FD\u9645\u673A\u573A\u7684\u63A5\u9A73\u7535\u8F66\uFF08KLIA Aerotrain\uFF09\u9884\u6599\u5C06\u5728\u660E\u5E741\u670831\u65E5\u91CD\u65B0\u6295\u5165\u8FD0\u4F5C\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u5D2D\u65B0\u7684\u4E24\u5217\u673A\u573A\u63A5\u9A73\u7535\u8F66\u5DF2\u4E8E\u65E5\u524D\u8FD0\u62B5\u5409\u9686\u5761\u56FD\u9645\u673A\u573A\u5217\u8F66\u5E93\uFF0C\u63A5\u4E0B\u6765\u7535\u8F66\u5C06\u8FDB\u5165\u7EC4\u88C5\u548C\u8BD5\u8DD1\u9636\u6BB5\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u4E24\u5217\u7535\u8F66\u5C06\u8FDB\u5165\u957F\u8FBE4\u81F35\u4E2A\u6708\u7684\u6D4B\u8BD5\uFF0C\u9884\u659910\u6708\u5DE6\u53F3\u5C31\u4F1A\u5F00\u59CB\u8BD5\u8DD1\u81F3\u660E\u5E741\u6708\u4E2D\uFF0C\u82E5\u4E00\u5207\u987A\u5229\uFF0C\u4E24\u5217\u63A5\u9A73\u7535\u8F66\u53EF\u5728\u660E\u5E741\u670831\u65E5\u6B63\u5F0F\u6295\u5165\u8FD0\u4F5C\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u9646\u5146\u798F\u4ECA\u65E9\u5230\u5409\u9686\u5761\u56FD\u9645\u673A\u573A\u5DE1\u89C6\u63A5\u9A73\u7535\u8F66\u7684\u5B89\u88C5\u5DE5\u7A0B\u540E\u5728\u8BB0\u8005\u4F1A\u4E0A\u6307\u51FA\uFF0C\u7B2C3\u5217\u9A73\u7535\u8F66\u9884\u8BA1\u5C06\u4E8E\u4ECA\u5E7410\u6708\u8FD0\u62B5\u6211\u56FD\uFF0C\u8FD93\u5217\u63A5\u9A73\u7535\u8F66\u5206\u522B\u5177\u59073\u4E2A\u8F66\u53A2\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u5728\u5B8C\u6210\u6574\u5408\u548C\u6D4B\u8BD5\u540E\uFF0C\u7535\u8F66\u6700\u7EC8\u5C06\u4EA4\u7531\u9646\u8DEF\u516C\u5171\u4EA4\u901A\u673A\u6784\uFF08APAD\uFF09\u5BA1\u6838\u53CA\u6279\u51C6\uFF0C\u4E00\u65E6\u6295\u5165\u8FD0\u4F5C\uFF0C\u6B63\u5F0F\u8FD0\u884C\u7684\u7535\u8F66\u67092\u5217\uFF0C1\u5217\u5C06\u4F5C\u4E3A\u5907\u7528\u8F66\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u6BCF\u5217\u63A5\u9A73\u7535\u8F66\u76843\u4E2A\u8F66\u53A2\u6700\u591A\u53EF\u5BB9\u7EB3270\u540D\u4E58\u5BA2\uFF0C\u6BCF\u8D9F\u7535\u8F66\u53EA\u4F1A\u95F4\u9694\u51E0\u5206\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6700\u8FD1\u7684\u51E0\u4E2A\u6708\uFF0C\u82E5\u6E38\u5BA2\u770B\u5230\u63A5\u9A73\u7535\u8F66\u7A7A\u8F66\u8FD0\u884C\u5374\u4E0D\u8F7D\u5BA2\uFF0C\u8BF7\u4E0D\u8981\u611F\u5230\u5947\u602A\uFF0C\u56E0\u4E3A\u76EE\u524D\u4ECD\u5904\u4E8E\u6D4B\u8BD5\u9636\u6BB5\u3002\u201D\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/09/frc-e59388c4032a22322dee6f3569ecc794.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u9646\u5146\u798F\uFF08\u5DE6\u4E8C\uFF09\u5230\u5409\u9686\u5761\u56FD\u9645\u673A\u573A\u5DE1\u89C6\u63A5\u9A73\u7535\u8F66\u7684\u5B89\u88C5\u5DE5\u7A0B\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u6BCF\u5217\u7535\u8F66\u53EF\u4F7F\u752830\u5E74\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u9488\u5BF9\u8BB0\u8005\u8BE2\u95EE\u63A5\u9A73\u5217\u8F66\u7684\u5BFF\u547D\uFF0C\u9646\u5146\u798F\u8868\u793A\uFF0C\u53EA\u8981\u4FDD\u517B\u4E0E\u7EF4\u4FEE\u5F97\u5F53\uFF0C\u901A\u5E38\u4E00\u5217\u7535\u8F66\u53EF\u4F7F\u752830\u5E74\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u63A5\u9A73\u5217\u8F66\u662F\u5927\u9A6C\u673A\u573A\u63A7\u80A1\u516C\u53F8\u7684\u8D44\u4EA7\uFF0C\u8BE5\u516C\u53F8\u5C06\u786E\u4FDD\u5217\u8F66\u4FDD\u6301\u5728\u826F\u597D\u7684\u8FD0\u884C\u72B6\u6001\uFF0C\u9884\u9632\u6B64\u524D\u5E38\u53D1\u751F\u7684\u95EE\u9898\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u4EEC\u5E0C\u671B\uFF0C\u8FD9\u9879\u8BBE\u5907\u80FD\u66F4\u5B8C\u5584\u5730\u8FCE\u63A5\u6240\u6709\u56FD\u5185\u5916\u7684\u65C5\u5BA2\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u9646\u5146\u798F\u4E5F\u900F\u9732\uFF0C\u63A5\u9A73\u7535\u8F66\u7684\u5916\u89C2\u8BBE\u8BA1\u5DE5\u4F5C\u5C06\u5728\u8BD5\u884C\u7ED3\u675F\u540E\u8FDB\u884C\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u76EE\u524D\u4E24\u5217\u7535\u8F66\u4ECD\u662F\u7EAF\u767D\u8272\u7684\uFF0C\u5728\u6B63\u5F0F\u8FD0\u884C\u65F6\uFF0C\u7535\u8F66\u5C06\u4EE5\u5168\u65B0\u59FF\u6001\u4E0E\u65C5\u5BA2\u89C1\u9762\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u56FD\u660E\u5E74\u5C06\u6210\u4E3A\u4E1C\u76DF\u4E3B\u5E2D\u56FD\uFF0C\u5C4A\u65F6\u5FC5\u4F1A\u8FCE\u6765\u5404\u56FD\u7684\u8D35\u5BBE\u548C\u6E38\u5BA2\uFF0C\u7535\u8F66\u7684\u5916\u89C2\u5C06\u5177\u5907\u7279\u70B9\uFF0C\u4EE5\u4FBF\u4E3A\u5916\u56FD\u6E38\u5BA2\u5E26\u6765\u826F\u597D\u7684\u5370\u8C61\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u53E6\u4E00\u65B9\u9762\uFF0C\u9646\u5146\u798F\u6307\u51FA\uFF0C\u5F85\u63A5\u9A73\u7535\u8F66\u6B63\u5F0F\u6295\u5165\u670D\u52A1\u540E\uFF0C\u5F53\u5C40\u5C06\u7EE7\u7EED\u4FDD\u7559\u63A5\u9A73\u5DF4\u58EB\u670D\u52A1\uFF0C\u4F9B\u6E38\u5BA2\u81EA\u884C\u9009\u62E9\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u4E00\u65E6\u6E38\u5BA2\u91CF\u589E\u591A\uFF0C\u76F8\u4FE1\u63A5\u9A73\u5DF4\u58EB\u5C31\u80FD\u4E3A\u6E38\u5BA2\u5E26\u6765\u4FBF\u5229\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/f9JROa9BCPb3iuW0onToSw\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
