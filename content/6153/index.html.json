{
  "id": "\u5DF4\u751F\u7279\u8272\u5496\u5561\u521B\u610F\u7A7A\u95F4\u6587\u827A\u63A2\u5E97\u5FC5\u8BBF",
  "slug": "\u5DF4\u751F\u7279\u8272\u5496\u5561\u521B\u610F\u7A7A\u95F4\u6587\u827A\u63A2\u5E97\u5FC5\u8BBF",
  "canonicalUrlKey": "\u5DF4\u751F\u7279\u8272\u5496\u5561\u521B\u610F\u7A7A\u95F4\u6587\u827A\u63A2\u5E97\u5FC5\u8BBF",
  "route": "/6153/",
  "title": "\uD83C\uDDF2\uD83C\uDDFE\u5DF4\u751F\u7279\u8272\u5496\u5561\u521B\u610F\u7A7A\u95F4\uFF5C\u6587\u827A\u63A2\u5E97\u5FC5\u8BBF\uD83D\uDCD6",
  "summary": "\u5E16\u6587\u4ECB\u7ECD\u9A6C\u6765\u897F\u4E9A\u5DF4\u751F\u7684\u7279\u8272\u5496\u5561\u4E0E\u521B\u610F\u7A7A\u95F4Play Klang\u5DF4\u751F\u6545\u4E8B\u9986\uFF0C\u79F0\u8FD9\u91CC\u4E0D\u53EA\u662F\u559D\u5496\u5561\u7684\u5730\u65B9\uFF0C\u8FD8\u7ED3\u5408\u4E86\u6587\u5316\u3001\u827A\u672F\u4E0E\u5386\u53F2\u3002\u9986\u5185\u8BBE\u6709\u4E92\u52A8\u827A\u672F\u89D2\u843D\uFF0C\u6E38\u5BA2\u53EF\u5728\u590D\u53E4\u7A7A\u95F4\u4E2D\u4E86\u89E3\u5DF4\u751F\u7684\u6545\u4E8B\uFF0C\u4E5F\u53EF\u54C1\u5C1D\u7279\u8272\u996E\u54C1\u3001\u9759\u4EAB\u60EC\u610F\u6C1B\u56F4\u3002\u6587\u4E2D\u5EFA\u8BAE\u6B63\u5728\u8BA1\u5212\u5DF4\u751F\u65C5\u884C\u7684\u4EBA\u628A\u8FD9\u91CC\u52A0\u5165\u884C\u7A0B\u6E05\u5355\uFF0C\u5E76\u9644\u4E0A\u5730\u574028, Jalan Raya Timur, Klang\u4E0E\u8425\u4E1A\u65F6\u95F410.30am-6pm\uFF0C\u540C\u65F6\u63D0\u5230\u5230\u5DF4\u751F\u9664\u54C1\u5C1D\u8089\u9AA8\u8336\u5916\uFF0C\u4E5F\u503C\u5F97\u63A2\u7D22\u5F53\u5730\u5496\u5561\u9986\u4E0E\u521B\u610F\u7A7A\u95F4\u3002",
  "body": "\u003Cp\u003E\u6765\u5230\u9A6C\u6765\u897F\u4E9A\u5DF4\u751F\u4E0D\u6B62\u8981\u5C1D\u904D\u6D53\u90C1\u9C9C\u9999\u7684\u8089\u9AA8\u8336\uFF0C\u66F4\u522B\u5FD8\u4E86\u63A2\u7D22\u5F53\u5730\u6781\u5177\u7279\u8272\u7684\u5496\u5561\u9986\u4E0E\u521B\u610F\u7A7A\u95F4\uFF0C\u5176\u4E2D\u4E00\u5BB6\u503C\u5F97\u6253\u5361\u7684\u5730\u65B9\u5C31\u662F\u003C/p\u003E\n\u003Cp\u003E\u0026#128205;Play Klang \u5DF4\u751F\u6545\u4E8B\u9986\u003C/p\u003E\n\u003Cp\u003E\u8FD9\u91CC\u4E0D\u53EA\u662F\u559D\u5496\u5561\u7684\u5730\u65B9\uFF0C\u8FD8\u7ED3\u5408\u4E86\u6587\u5316\u3001\u827A\u672F\u4E0E\u5386\u53F2\u0026#128218;\u003C/p\u003E\n\u003Cp\u003E\u0026#127912;\u4E92\u52A8\u827A\u672F\u89D2\u843D\uFF0C\u8BA9\u4F60\u8FB9\u901B\u8FB9\u53D1\u6398\u521B\u610F\u7684\u4E8B\u7269\u003C/p\u003E\n\u003Cp\u003E\u0026#128269;\u8D70\u8FDB\u590D\u53E4\u7A7A\u95F4\uFF0C\u4E86\u89E3\u5173\u4E8E\u5DF4\u751F\u7684\u6545\u4E8B\u003C/p\u003E\n\u003Cp\u003E\u2615\uFE0F\u54C1\u5C1D\u7279\u8272\u996E\u54C1\uFF0C\u9759\u4EAB\u60EC\u610F\u6C1B\u56F4\u003C/p\u003E\n\u003Cp\u003E\u5982\u679C\u4F60\u6B63\u5728\u8BA1\u5212\u5230\u5DF4\u751F\u65C5\u884C\uFF0C\u003C/p\u003E\n\u003Cp\u003E\u4E0D\u59A8\u628A Play Klang \u5DF4\u751F\u6545\u4E8B\u9986\u003C/p\u003E\n\u003Cp\u003E\u4E5F\u52A0\u5165\u4F60\u7684\u884C\u7A0B\u6E05\u5355\u4E2D\u0026#129534;\u2728\u003C/p\u003E\n\u003Cp\u003E\u0026#128214;Play Klang \u5DF4\u751F\u6545\u4E8B\u9986\u003C/p\u003E\n\u003Cp\u003E\u0026#128205;\u5730\u5740\uFF1A28, Jalan Raya Timur, Klang, Malaysia\u003C/p\u003E\n\u003Cp\u003E\u0026#128338;\u8425\u4E1A\u65F6\u95F4\uFF1A10.30am-6pm\u003C/p\u003E\n\u003Cp\u003E#\u9B45\u529B\u96EA\u5170\u83AA   #\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38   #\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38\u653B\u7565   #\u9A6C\u6765\u897F\u4E9A\u96EA\u5170\u83AA   #VisitSelangor2026   #\u96EA\u5170\u83AA\u60CA\u559C\u8FDE\u8FDE   #\u96EA\u5170\u83AA\u65C5\u6E38   #\u96EA\u5170\u83AA\u65C5\u6E38\u653B\u7565   #\u5DF4\u751F\u6545\u4E8B\u9986\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/sz_mmbiz_jpg/p7Ria9Mp2k3rYzc44hZ0KK9zolCCFx92oiazr6ML2PvjOw2hka3xneaAXdNaibFfibjIpbYia4ygsuERSEO5Wg59icgJEw9G6GqLRvv9YibzibUTTvw/0?wx_fmt=jpeg\u0026amp;from=appmsg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/sz_mmbiz_jpg/p7Ria9Mp2k3pM5vpic2BfXT1Yzhkicl96dthCYtziaicas2xFiaONGkr2sPh4jxVicHzmlLOJH9Gz1icxsJzrThWyxlx7IdiaDiaXibOcQibBXwU8Bp0TyE/0?wx_fmt=jpeg\u0026amp;from=appmsg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/sz_mmbiz_jpg/p7Ria9Mp2k3rASM6IgudWSTh7Y857Z0L7tzAKWW4Fq3ribibricfwH1xrqahBNWDyCSIVAXia3XcQc4OCSbWtD3mpJQxo6nhRbibv3w0ibgOf8Btlk/0?wx_fmt=jpeg\u0026amp;from=appmsg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/sz_mmbiz_jpg/p7Ria9Mp2k3pRBUJBLPj8NLl5V5j3rNoXkOpkTB4iafZF9kZfIDfR3q3NXvmgT4uLAcHEvrIPTZskunzHceM33LzAXcS7pk3YEv0699hlVYXA/0?wx_fmt=jpeg\u0026amp;from=appmsg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/sz_mmbiz_jpg/p7Ria9Mp2k3q7JIlkvZLqHiaia9y5vaeWtI7s2rga2o3SLkKAolrMI0c1sEuxiayDSPaibqQcjYbKZaCPc6icmgfr0tlBhTg0BhdlI5WQlwez6d18/0?wx_fmt=jpeg\u0026amp;from=appmsg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/sz_mmbiz_jpg/p7Ria9Mp2k3rmmOpFh7bDrzjpAjgWK54vyavMx62oHs09Ou2Pcd62kycYtFnZq8uLSm3Y3CejbrcfVgdaPseXMdZwZUBvDiahahepS80ibA4Qw/0?wx_fmt=jpeg\u0026amp;from=appmsg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/sz_mmbiz_jpg/p7Ria9Mp2k3oicomq1SMudFmAnhqviaicyMVCCr6YFwhpWfLibVXiaEE4Xajo8oo7VqlKMXstConQ6HGoVGfALBfaLF3Tpa2nZKK3wHCX1VIvlJlA/0?wx_fmt=jpeg\u0026amp;from=appmsg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/sz_mmbiz_jpg/p7Ria9Mp2k3rJuic4g7uGTn3KhqiaAhkibY1MUlU2qJof40yksVqtq0aqu9Jy3ZU1vW14ezVWKYibibibuv8SvuvekzU0yM7Eg12u7Dp7xfRaBfmas/0?wx_fmt=jpeg\u0026amp;from=appmsg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/mmbiz_jpg/p7Ria9Mp2k3r7Gj1xeYZdj2nkFO9zyn4DfhM5Yu