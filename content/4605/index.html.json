{
  "id": "%e6%b8%af%e5%8a%a1%e5%a7%94%e4%bc%9a%e6%9c%aa%e6%9d%a530%e5%b9%b4%e5%a4%a7%e6%96%b9%e5%90%91-%e6%a7%9f%e6%8e%a8%e6%b8%af%e5%8f%a3%e5%8f%91%e5%b1%95%e8%93%9d%e5%9b%be",
  "slug": "%e6%b8%af%e5%8a%a1%e5%a7%94%e4%bc%9a%e6%9c%aa%e6%9d%a530%e5%b9%b4%e5%a4%a7%e6%96%b9%e5%90%91-%e6%a7%9f%e6%8e%a8%e6%b8%af%e5%8f%a3%e5%8f%91%e5%b1%95%e8%93%9d%e5%9b%be",
  "canonicalUrlKey": "%e6%b8%af%e5%8a%a1%e5%a7%94%e4%bc%9a%e6%9c%aa%e6%9d%a530%e5%b9%b4%e5%a4%a7%e6%96%b9%e5%90%91-%e6%a7%9f%e6%8e%a8%e6%b8%af%e5%8f%a3%e5%8f%91%e5%b1%95%e8%93%9d%e5%9b%be",
  "route": "/4605/",
  "title": "\u6E2F\u52A1\u59D4\u4F1A:\u672A\u676530\u5E74\u5927\u65B9\u5411 \u69DF\u63A8\u6E2F\u53E3\u53D1\u5C55\u84DD\u56FE",
  "summary": "\u62A5\u9053:\u738B\u8FDE\u8D1E \uFF08\u69DF\u57CE26\u65E5\u8BAF\uFF09\u4E3A\u4E86\u914D\u5408\u4EA4\u901A\u90E8\u5927\u65B9\u5411\uFF0C\u69DF\u57CE\u6E2F\u52A1\u59D4\u5458\u4F1A\u4ECA\u65E5\u63A8\u4ECB\u69DF\u57CE\u6E2F\u53E3\u672A\u676530\u5E74\u53D1\u5C55\u5927\u84DD\u56FE\uFF082024\u5E74\u81F32053\u5E74\uFF09\u3002 \u603B\u6982\u8FF04\u65B9\u5411\u4E0E\u7B56\u7565 \u65B0\u5B98\u4E0A\u4EFB\u752B1\u4E2A\u6708\u7684\u69DF\u57CE\u6E2F\u52A1\u59D4\u5458\u4F1A\u4E3B\u5E2D\u62FF\u7763\u6768\u987A\u5174\u8BF4\uFF0C\u69DF\u6E2F\u53E3\u672A\u676530\u5E74\u5927\u84DD\u56FE\u603B\u6982\u8FF0\u4E86\u56DB\u4E2A\u65B9\u5411\u4E0E\u7B56\u7565\uFF1A \uFF08\u4E00\uFF09\u5B9A\u4F4D\u4E3A\u5317\u9A6C\u533A\u4E0E\u6CF0\u5357\u7ECF\u6D4E\u53D1\u5C55\u50AC\u5316\u5242\uFF1B \uFF08\u4E8C\uFF09\u6210\u4E3A\u5317\u9A6C\u533A\u4E0E\u6CF0\u5357\u533A\u57DF\u53EF\u6301\u7EED\u53D1\u5C55\u8D21\u732E\u8005\uFF1B \uFF08\u4E09\uFF09\u6210\u4E3A\u4E1C\u5357\u4E9A\u4E0E\u5357\u4E9A\u7269\u6D41\u67A2\u7EBD\uFF1B \uFF08\u56DB\uFF09\u5B9A\u4F4D\u4E3A\u4E9A\u6D32\u90AE\u8F6E\u65C5\u6E38\u67A2\u7EBD\u3002 \u4ED6\u8BF4\uFF0C\u4E3A\u4E86\u5B9E\u73B0\u4EE5\u4E0A\u76EE\u6807\uFF0C\u5FC5\u987B\u63D0\u5347\u6E2F\u53E3\u57FA\u5EFA\u4EE5\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/04/frc-8edfb7a7c1062468da37697028fcc5d6.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u62A5\u9053:\u738B\u8FDE\u8D1E\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\uFF08\u69DF\u57CE26\u65E5\u8BAF\uFF09\u4E3A\u4E86\u914D\u5408\u4EA4\u901A\u90E8\u5927\u65B9\u5411\uFF0C\u69DF\u57CE\u6E2F\u52A1\u59D4\u5458\u4F1A\u4ECA\u65E5\u63A8\u4ECB\u69DF\u57CE\u6E2F\u53E3\u672A\u676530\u5E74\u53D1\u5C55\u5927\u84DD\u56FE\uFF082024\u5E74\u81F32053\u5E74\uFF09\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u603B\u6982\u8FF04\u65B9\u5411\u4E0E\u7B56\u7565\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u65B0\u5B98\u4E0A\u4EFB\u752B1\u4E2A\u6708\u7684\u69DF\u57CE\u6E2F\u52A1\u59D4\u5458\u4F1A\u4E3B\u5E2D\u62FF\u7763\u6768\u987A\u5174\u8BF4\uFF0C\u69DF\u6E2F\u53E3\u672A\u676530\u5E74\u5927\u84DD\u56FE\u603B\u6982\u8FF0\u4E86\u56DB\u4E2A\u65B9\u5411\u4E0E\u7B56\u7565\uFF1A\u003C/p\u003E\n\u003Cp\u003E\uFF08\u4E00\uFF09\u5B9A\u4F4D\u4E3A\u5317\u9A6C\u533A\u4E0E\u6CF0\u5357\u7ECF\u6D4E\u53D1\u5C55\u50AC\u5316\u5242\uFF1B\u003C/p\u003E\n\u003Cp\u003E\uFF08\u4E8C\uFF09\u6210\u4E3A\u5317\u9A6C\u533A\u4E0E\u6CF0\u5357\u533A\u57DF\u53EF\u6301\u7EED\u53D1\u5C55\u8D21\u732E\u8005\uFF1B\u003C/p\u003E\n\u003Cp\u003E\uFF08\u4E09\uFF09\u6210\u4E3A\u4E1C\u5357\u4E9A\u4E0E\u5357\u4E9A\u7269\u6D41\u67A2\u7EBD\uFF1B\u003C/p\u003E\n\u003Cp\u003E\uFF08\u56DB\uFF09\u5B9A\u4F4D\u4E3A\u4E9A\u6D32\u90AE\u8F6E\u65C5\u6E38\u67A2\u7EBD\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u4E3A\u4E86\u5B9E\u73B0\u4EE5\u4E0A\u76EE\u6807\uFF0C\u5FC5\u987B\u63D0\u5347\u6E2F\u53E3\u57FA\u5EFA\u4EE5\u6EE1\u8DB3\u6D77\u8FD0\u7269\u6D41\u7684\u4E0D\u65AD\u589E\u957F\u9700\u6C42\uFF0C\u5E76\u63D0\u9AD8\u69DF\u57CE\u6E2F\u53E3\u7684\u6548\u7387\u548C\u5BB9\u91CF\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u5229\u7528\u73B0\u6709\u7684\u5317\u6D77\u5317\u5CB8\u7BB1\u8FD0\u7801\u5934\uFF08NBCT\uFF09\u571F\u5730\u4F5C\u4E3A\u6E2F\u53E3\u7684\u4E2D\u5FC3\u7126\u70B9\u3002\u5EFA\u8BAE\u5411\u5317\u6269\u5C55\u73B0\u6709\u8BBE\u65BD\u548C\u57FA\u7840\u8BBE\u65BD\uFF0C\u4EE5\u4F18\u5316\u571F\u5730\u5229\u7528\uFF0C\u5E76\u6700\u5927\u9650\u5EA6\u5730\u5229\u7528\u73B0\u6709\u7684\u4EA4\u901A\u8FDE\u63A5\u548C\u57FA\u7840\u8BBE\u65BD\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u4ECA\u5348\u5728\u69DF\u57CE\u745E\u5178\u54B8\u7801\u5934\u8BE5\u4F1A\u529E\u4E8B\u5904\u63A5\u53D7\u4E2D\u6587\u62A5\u8054\u8BBF\u65F6\u76F4\u8A00\uFF0C\u53D1\u5C55\u8BA1\u5212\u9762\u5BF9\u6700\u5927\u7684\u6311\u6218\uFF0C\u662F\u571F\u5730\u7F3A\u4E4F\u7684\u95EE\u9898\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u9700\u83B7\u989D\u5916\u571F\u5730\u5206\u914D\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u201C\u4E3A\u4E86\u786E\u4FDD\u672A\u6765\u53D1\u5C55\u548C\u6269\u5BB9\u7684\u8DB3\u591F\u7A7A\u95F4\uFF0C\u69DF\u6E2F\u59D4\u4F1A\u9700\u83B7\u989D\u5916\u7684\u571F\u5730\u5206\u914D\uFF0C\u5305\u62EC\u5317\u6D77\u96F7\u987F\uFF08Rayston Consortium\uFF09\u516C\u53F8\u571F\u5730\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u6768\u987A\u5174\u8BF4\uFF0C\u69DF\u57CE\u6E2F\u53E3\u5730\u7406\u4F4D\u7F6E\u6781\u5177\u6218\u7565\u6027\uFF0C\u6269\u5145\u5317\u5CB8\u7801\u5934\u4E3B\u8981\u662F\u5E94\u5BF9\u672A\u6765\u53D1\u5C55\u548C\u9700\u6C42\u8D8B\u52BF\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u5317\u6D77\u5317\u5CB8\u7801\u5934\u8D1F\u8D23\u8D27\u8FD0\u6D3B\u8DC3\u6765\u5F80\u533A\u57DF\u9664\u4E86\u672C\u5730\u5317\u9A6C\u533A\u5916\uFF0C\u4E5F\u5305\u62EC\u6CF0\u5357\u3001\u5370\u5C3C\u548C\u82CF\u95E8\u7B54\u814A\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u8BE5\u4F1A\u8BA1\u5212\u6269\u5EFA\u8D27\u67DC\u548C\u6563\u8D27\u7801\u5934\uFF0C\u4EE5\u589E\u52A0\u8D27\u67DC\u548C\u6563\u8D27\u7801\u5934\u7684\u5BB9\u91CF\u548C\u541E\u5410\u91CF\uFF0C\u4EE5\u9002\u5E94\u9884\u8BA1\u7684\u8D38\u6613\u91CF\u589E\u957F\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u8FD9\u5305\u62EC\u57FA\u7840\u8BBE\u65BD\u5347\u7EA7\uFF0C\u5982\u589E\u52A0\u6CCA\u4F4D\u3001\u8D77\u91CD\u673A\u548C\u4ED3\u5E93\u50A8\u5B58\u8BBE\u65BD\u7B49\u3002\u201D\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/04/frc-4a4229afc9547bfbfa73858bc9efa606.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u4E89\u53D6\u745E\u5178\u54B8\u7801\u5934\n\u6253\u9020\u6210\u90AE\u8F6E\u6BCD\u6E2F\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u4E5F\u662F\u5927\u9A6C\u65C5\u6E38\u5C40\u526F\u4E3B\u5E2D\u7684\u6768\u987A\u5174\u8BF4\uFF0C\u8BE5\u4F1A\u5C06\u4E89\u53D6\u6253\u9020\u69DF\u57CE\u745E\u5178\u54B8\u7801\u5934\u4E3A\u90AE\u8F6E\u6BCD\u6E2F\uFF0C\u4E89\u53D6\u8BA9\u5927\u578B\u90AE\u8F6E\u8FDB\u9A7B\uFF0C\u4E3A\u69DF\u57CE\u65C5\u6E38\u4E1A\u53D1\u5C55\u52A9\u529B\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u968F\u7740\u4E9A\u592A\u5730\u533A\u6E38\u8F6E\u5E02\u573A\u8FC5\u901F\u589E\u957F\uFF0C\u69DF\u57CE\u6E2F\u53E3\u5229\u7528\u8FD9\u4E00\u8D8B\u52BF\uFF0C\u63D0\u5347\u6E38\u8F6E\u8BBE\u65BD\u548C\u670D\u52A1\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u8FD9\u5305\u62EC\u5347\u7EA7\u6E38\u8F6E\u7801\u5934\u3001\u6269\u5927\u505C\u9760\u80FD\u529B\uFF0C\u4EE5\u5438\u5F15\u66F4\u591A\u7684\u90AE\u8F6E\u548C\u6E38\u5BA2\u505C\u9760\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u6FC0\u8D77\u672C\u5730\u7ECF\u6D4E\u6548\u76CA\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u7EC8\u6781\u76EE\u6807\uFF0C\u6253\u9020\u69DF\u57CE\u745E\u5178\u54B8\u90AE\u8F6E\u7801\u5934\u4F5C\u4E3A\u6BCD\u6E2F\uFF0C\u5DE5\u4F5C\u5305\u62EC\u534F\u8C03\u7A7A\u6E2F\u4E0E\u6D77\u6E2F\u8854\u63A5\u8F6F\u786C\u8BBE\u5907\uFF0C\u822A\u7A7A\u516C\u53F8\u3001\u90AE\u8F6E\u516C\u53F8\u3001\u65C5\u6E38\u4E1A\u8005\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u745E\u5178\u54B8\u7801\u5934\u6253\u9020\u4E3A\u90AE\u8F6E\u6BCD\u6E2F\u5C06\u6FC0\u8D77\u672C\u5730\u7ECF\u6D4E\u6548\u76CA\uFF0C\u4E3A\u69DF\u57CE\u670D\u52A1\u4E1A\uFF0C\u5C24\u5176\u662F\u9152\u5E97\u4E1A\u548C\u4F11\u95F2\u996E\u98DF\u4E1A\u7B49\uFF0C\u5E26\u6765\u5546\u673A\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u4E3A\u4E86\u5B9E\u73B0\u6B64\u76EE\u6807\uFF0C\u8BE5\u4F1A\u5C06\u52AA\u529B\u53BB\u56FD\u5916\u62DB\u5546(\u90AE\u8F6E)\uFF0C\u901A\u8FC7\u4F01\u4E1A\u5BF9\u4F01\u4E1A\u914D\u5BF9\u6D3B\u52A8\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u4E5F\u5C06\u5EFA\u8BAE\u69DF\u57CE\u56FD\u9645\u673A\u573A\u63D0\u5347\u884C\u674E\u8F6C\u8FD0\u7684\u670D\u52A1\u8BBE\u5907\uFF0C\u4F8B\u5982\uFF0C\u8BA9\u90AE\u8F6E\u5BA2\u6237\u7684\u98DE\u673A\u4E58\u5BA2\u5728\u51FA\u5883\u65F6\uFF0C\u5176\u884C\u674E\u81EA\u52A8\u88C5\u8FD0\u5230\u90AE\u8F6E\uFF0C\u4E58\u5BA2\u65E0\u9700\u8017\u65F6\u9886\u53D6\u884C\u674E\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6307\u51FA\uFF0C\u745E\u5178\u54B8\u7801\u5934\u65E7\u4ED3\u5E93\u4FEE\u590D\u53CA\u7FFB\u65B0\u8BA1\u5212\u5C06\u4F1A\u5EF6\u7EED\uFF0C\u4EE5\u5C06\u4E4B\u6253\u9020\u4E3A\u56FD\u5916\u65C5\u5BA2\u53CA\u672C\u5730\u7FA4\u4F17\u7684\u5FC5\u6E38\u70ED\u70B9\u3002\u0026quot;\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u6570\u5B57\u5316\u6253\u9020\u667A\u80FD\u6E2F\u53E3\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u201C\u6570\u5B57\u5316\u4E3E\u63AA\u5C06\u628A\u69DF\u57CE\u6E2F\u53E3\u8F6C\u53D8\u4E3A\u667A\u80FD\u6E2F\u53E3\uFF0C\u5229\u7528\u6280\u672F\u4F18\u5316\u8FD0\u8425\uFF0C\u63D0\u9AD8\u6548\u7387\uFF0C\u589E\u5F3A\u5BA2\u6237\u4F53\u9A8C\u3002\u8FD9\u53EF\u80FD\u5305\u62EC\u8D27\u7269\u8DDF\u8E2A\u7684\u6570\u5B57\u5E73\u53F0\u3001\u5728\u7EBF\u8BA2\u8231\u7CFB\u7EDF\u548C\u5B9E\u65F6\u6570\u636E\u5206\u6790\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u6768\u987A\u5174\u8BF4\uFF0C\u53EF\u6301\u7EED\u53D1\u5C55\u4E3E\u63AA\u5C06\u91CD\u70B9\u653E\u5728\u51CF\u5C11\u6E2F\u53E3\u7684\u73AF\u5883\u8DB3\u8FF9\u548C\u4FC3\u8FDB\u73AF\u4FDD\u5B9E\u8DF5\u4E0A\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u8FD9\u53EF\u80FD\u6D89\u53CA\u6295\u8D44\u4E8E\u53EF\u518D\u751F\u80FD\u6E90\u3001\u5B9E\u65BD\u8282\u80FD\u63AA\u65BD\u548C\u91C7\u7528\u7EFF\u8272\u6280\u672F\uFF0C\u4EE5\u51CF\u5C11\u6C61\u67D3\u548C\u4FDD\u62A4\u81EA\u7136\u8D44\u6E90\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u8BE5\u4F1A\u5B9E\u65BD\u6570\u5B57\u5316\u4E3E\u63AA\uFF0C\u7B80\u5316\u6E2F\u53E3\u8FD0\u8425\uFF0C\u63D0\u9AD8\u4F9B\u5E94\u94FE\u53EF\u89C1\u6027\uFF0C\u5E76\u6539\u5584\u5BA2\u6237\u670D\u52A1\u3002\u8FD9\u53EF\u80FD\u5305\u62EC\u91C7\u7528\u7269\u8054\u7F51\u6280\u672F\u3001\u6570\u636E\u5206\u6790\u548C\u81EA\u52A8\u5316\u6D41\u7A0B\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u5E76\u901A\u8FC7\u80FD\u6E90\u6548\u7387\u6539\u5584\u3001\u51CF\u5C11\u5E9F\u7269\u3001\u8282\u7EA6\u7528\u6C34\u548C\u91C7\u7528\u53EF\u518D\u751F\u80FD\u6E90\u7B49\u63AA\u65BD\uFF0C\u5C06\u53EF\u6301\u7EED\u53D1\u5C55\u878D\u5165\u6E2F\u53E3\u8FD0\u8425\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u5305\u62EC\u5B89\u88C5\u592A\u9633\u80FD\u7535\u6C60\u677F\u3001\u96E8\u6C34\u6536\u96C6\u7CFB\u7EDF\u548C\u5E9F\u7269\u56DE\u6536\u8BBE\u65BD\u7B49\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/h7hRv9-rYWPxPpYHRAdTqg\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
