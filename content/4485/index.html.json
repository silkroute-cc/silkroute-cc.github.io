{
  "id": "%e9%a9%ac%e4%b8%ad%e5%be%80%e8%bf%94%e6%af%8f%e5%91%a8%e5%a2%9e17%e8%b6%9f%e8%88%aa%e7%8f%ad%e3%80%80%e6%96%b0%e5%b1%b1%e5%be%80%e8%bf%94%e6%b5%b7%e5%8f%a34%e6%9c%8824%e6%97%a5%e5%bc%80%e8%b7%91",
  "slug": "%e9%a9%ac%e4%b8%ad%e5%be%80%e8%bf%94%e6%af%8f%e5%91%a8%e5%a2%9e17%e8%b6%9f%e8%88%aa%e7%8f%ad%e3%80%80%e6%96%b0%e5%b1%b1%e5%be%80%e8%bf%94%e6%b5%b7%e5%8f%a34%e6%9c%8824%e6%97%a5%e5%bc%80%e8%b7%91",
  "canonicalUrlKey": "%e9%a9%ac%e4%b8%ad%e5%be%80%e8%bf%94%e6%af%8f%e5%91%a8%e5%a2%9e17%e8%b6%9f%e8%88%aa%e7%8f%ad%e3%80%80%e6%96%b0%e5%b1%b1%e5%be%80%e8%bf%94%e6%b5%b7%e5%8f%a34%e6%9c%8824%e6%97%a5%e5%bc%80%e8%b7%91",
  "route": "/4485/",
  "title": "\u9A6C\u4E2D\u5F80\u8FD4\u6BCF\u5468\u589E17\u8D9F\u822A\u73ED\u3000\u65B0\u5C71\u5F80\u8FD4\u6D77\u53E34\u670824\u65E5\u5F00\u8DD1",
  "summary": "\uFF08\u65B0\u5C7127\u65E5\u8BAF\uFF09 \u5728\u9A6C\u4E2D\u4E24\u56FD\u65C5\u884C\u793E\u548C\u822A\u7A7A\u516C\u53F8\u5408\u4F5C\u4E0B\uFF0C\u4E2D\u56FD\u5F80\u8FD4\u9A6C\u6765\u897F\u4E9A\u6BCF\u5468\u5C06\u589E\u52A017\u8D9F\u822A\u73ED\uFF0C\u5E76\u5C06\u4ECE3\u6708\u5E95\u5F00\u8DD1\u3002 \u9A6C\u6765\u897F\u4E9A\u534E\u4EBA\u65C5\u6E38\u516C\u4F1A\u4F1A\u957F\u5305\u4E00\u96C4\u6307\u51FA\uFF0C\u968F\u8457\u9A6C\u4E2D\u76F8\u4E92\u514D\u7B7E\uFF0C\u65C5\u6E38\u3001\u827A\u672F\u53CA\u6587\u5316\u90E8\u957F\u62FF\u7763\u65AF\u91CC\u5F20\u5E86\u4FE1\u4E3A\u4ECA\u5E74\u4E2D\u56FD\u6E38\u5BA2\u4EBA\u6570\u5B9A\u4E0B700\u4E07\u4EBA\u6B21\u7684\u76EE\u6807\u3002 \u201C\u672C\u6765\u6211\u4EEC\u7684\u9884\u4F30\u662F500\u4E07\u6E38\u5BA2\u4EBA\u6B21\uFF0C\u4F46\u5728\u6211\u4EEC\u589E\u52A0\u5F80\u8FD4\u4E2D\u56FD\u7684\u822A\u73ED\u4E4B\u4E0B\uFF0C\u6211\u76F8\u4FE1\uFF0C\u6211\u4EEC\u80FD\u8FBE\u6210\u6B64\u76EE\u6807\u3002\u201D \u5305\u4E00\u96C4\u4ECA\u65E5\u4E0A\u5348\u51FA\u5E2D\u201C\u9F99\u817E\u56DB\u6D77\uFF0C\u900D\u9065\u4E2D\u56FD\u201D\u65C5\u6E38\u4EA7\u54C1\u65B0\u5C71\u7AD9\u53D1\u5E03\u4F1A\u540E\uFF0C\u53EC\u5F00\u65B0\u95FB\u53D1\u5E03\u8005\u4F1A\u4E0A\uFF0C\u53D1\u5E03\u8FD9\u9879\u6D88\u606F\u3002 \u51FA\u5E2D\u4E0A\u8FF0\u6D3B\u52A8\u8005\u5305\u62EC\u67D4\u5DDE\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/03/frc-ee096bf451efa0e4c5a3d10800e7cd92.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\uFF08\u65B0\u5C7127\u65E5\u8BAF\uFF09\u3000\u5728\u9A6C\u4E2D\u4E24\u56FD\u65C5\u884C\u793E\u548C\u822A\u7A7A\u516C\u53F8\u5408\u4F5C\u4E0B\uFF0C\u4E2D\u56FD\u5F80\u8FD4\u9A6C\u6765\u897F\u4E9A\u6BCF\u5468\u5C06\u589E\u52A017\u8D9F\u822A\u73ED\uFF0C\u5E76\u5C06\u4ECE3\u6708\u5E95\u5F00\u8DD1\u3002\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u534E\u4EBA\u65C5\u6E38\u516C\u4F1A\u4F1A\u957F\u5305\u4E00\u96C4\u6307\u51FA\uFF0C\u968F\u8457\u9A6C\u4E2D\u76F8\u4E92\u514D\u7B7E\uFF0C\u65C5\u6E38\u3001\u827A\u672F\u53CA\u6587\u5316\u90E8\u957F\u62FF\u7763\u65AF\u91CC\u5F20\u5E86\u4FE1\u4E3A\u4ECA\u5E74\u4E2D\u56FD\u6E38\u5BA2\u4EBA\u6570\u5B9A\u4E0B700\u4E07\u4EBA\u6B21\u7684\u76EE\u6807\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u672C\u6765\u6211\u4EEC\u7684\u9884\u4F30\u662F500\u4E07\u6E38\u5BA2\u4EBA\u6B21\uFF0C\u4F46\u5728\u6211\u4EEC\u589E\u52A0\u5F80\u8FD4\u4E2D\u56FD\u7684\u822A\u73ED\u4E4B\u4E0B\uFF0C\u6211\u76F8\u4FE1\uFF0C\u6211\u4EEC\u80FD\u8FBE\u6210\u6B64\u76EE\u6807\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u5305\u4E00\u96C4\u4ECA\u65E5\u4E0A\u5348\u51FA\u5E2D\u201C\u9F99\u817E\u56DB\u6D77\uFF0C\u900D\u9065\u4E2D\u56FD\u201D\u65C5\u6E38\u4EA7\u54C1\u65B0\u5C71\u7AD9\u53D1\u5E03\u4F1A\u540E\uFF0C\u53EC\u5F00\u65B0\u95FB\u53D1\u5E03\u8005\u4F1A\u4E0A\uFF0C\u53D1\u5E03\u8FD9\u9879\u6D88\u606F\u3002\u003C/p\u003E\n\u003Cp\u003E\u51FA\u5E2D\u4E0A\u8FF0\u6D3B\u52A8\u8005\u5305\u62EC\u67D4\u5DDE\u534E\u4EBA\u65C5\u6E38\u516C\u4F1A\u4F1A\u957F\u90D1\u5EFA\u5168\u3001\u67D4\u4F5B\u65C5\u6E38\u5C40\u526F\u5C40\u957F\u83AB\u54C8\u672B\u963F\u654F\u3001\u5CC7\u8FEA\u822A\u7A7A\uFF08Batik Air\uFF09\u65B0\u5C71\u4E3B\u7BA1\u83AB\u54C8\u672B\u8D5B\u592B\u4E01\u3001\u4E2D\u56FD\u56DB\u5DDD\u822A\u7A7A\u80A1\u4EFD\u6709\u9650\u516C\u53F8\u5546\u52A1\u59D4\u5458\u4F1A\u603B\u7ECF\u7406\u5434\u5FB7\u6600\u3001\u56FD\u9645\u7BA1\u7406\u90E8\u603B\u7ECF\u7406\u90D1\u6D0B\u3001\u5E7F\u5DDE\u5A01\u8D5E\u822A\u7A7A\u670D\u52A1\u6709\u9650\u516C\u53F8\u8463\u4E8B\u6881\u5174\u82B8\u3001\u6D77\u5357\u592E\u65C5\u822A\u7A7A\u96C6\u56E2\u6709\u9650\u516C\u53F8\u6267\u884C\u8463\u4E8B\u674E\u5F3A\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/03/frc-c2cb8ace8e4e644d031935de8b97b3a4.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u53D1\u5E03\u4F1A\u4E0A\u63A8\u4ECB4\u4E2A\u5F80\u8FD4\u6211\u56FD\u4E0E\u4E2D\u56FD\u7684\u65B0\u822A\u73ED\uFF0C\u5305\u62EC\u5409\u9686\u5761\u5F80\u8FD4\u6210\u90FD\u7684\u8054\u8425\u6B63\u89C4\u822A\u73ED\uFF0C\u4EE5\u53CA3\u9879\u5305\u673A\u670D\u52A1\u5305\u62EC\u5409\u9686\u5761\u5F80\u8FD4\u5357\u660C\u3001\u5409\u9686\u5761\u5F80\u8FD4\u592A\u539F\u548C\u65B0\u5C71\u5F80\u8FD4\u6D77\u53E3\u3002\u003C/p\u003E\n\u003Cp\u003E3\u9879\u5305\u673A\u670D\u52A1\u662F\u5E7F\u5DDE\u5A01\u8D5E\u822A\u7A7A\u670D\u52A1\u6709\u9650\u516C\u53F8\u4E0E\u5CC7\u8FEA\u822A\u7A7A\u5408\u4F5C\uFF0C\u5409\u9686\u5761\u5F80\u8FD4\u6210\u90FD\u7684\u6B63\u89C4\u822A\u73ED\u662F\u7531\u56DB\u5DDD\u822A\u7A7A\u63D0\u4F9B\u3002\u003C/p\u003E\n\u003Cp\u003E\u5409\u9686\u5761\u5F80\u8FD4\u6210\u90FD\u822A\u73ED\u5C06\u4E8E3\u670831\u65E5\u542F\u822A\uFF0C\u6BCF\u5929\u90FD\u6709\u822A\u73ED\u3002\u003C/p\u003E\n\u003Cp\u003E3\u9879\u5305\u673A\u670D\u52A1\u5219\u4ECE4\u670824\u65E5\u5F00\u59CB\u542F\u52A8\uFF0C\u5176\u4E2D\uFF0C\u65B0\u5C71\u5F80\u8FD4\u6D77\u53E3\u7684\u822A\u73ED\u662F\u6BCF\u9022\u5468\u4E09\u548C\u5468\u516D\uFF0C\u5409\u9686\u5761\u5F80\u8FD4\u592A\u539F\u7684\u822A\u73ED\u662F\u662F\u6BCF\u9022\u5468\u4E09\u548C\u5468\u65E5\uFF0C\u5409\u9686\u5761\u98DE\u5357\u660C\u7684\u73ED\u673A\u5219\u662F\u6BCF\u5468\u4E00\u3001\u4E09\u3001\u4E94\u548C\u5468\u65E5\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/03/frc-d19f15c5039c5852f3705c1eef5dc541.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5434\u5FB7\u6600\u8868\u793A\uFF0C\u57FA\u4E8E\u4E2D\u56FD\u7ECF\u6D4E\u653F\u7B56\u7684\u52A8\u5411\uFF0C\u56DB\u5DDD\u822A\u7A7A\u6B63\u5728\u6269\u5927\u56FD\u9645\u822A\u73ED\u7684\u8FDB\u7A0B\uFF0C\u53BB\u5E74\u5DF2\u5F00\u901A\u5409\u9686\u5761\u81F3\u6D77\u53E3\u7684\u822A\u73ED\uFF0C\u4ECA\u5E74\u5C06\u4F1A\u589E\u8BBE\u5F80\u8FD4\u6210\u90FD\u7684\u822A\u73ED\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8868\u793A\uFF0C\u8BE5\u516C\u53F8\u5728\u8BA1\u5212\u6709\u5173\u822A\u73ED\u65F6\u4E5F\u8003\u8651\u5230\u4E2D\u8F6C\u822A\u7EBF\u65F6\u95F4\uFF0C\u65B9\u4FBF\u4ECE\u4E2D\u56FD\u5404\u5730\u800C\u6765\u7684\u6E38\u5BA2\u4E58\u642D\u4E2D\u56FD\u56FD\u5185\u822A\u73ED\u81F3\u6210\u90FD\uFF0C\u518D\u4E58\u642D\u56FD\u9645\u822A\u73ED\u524D\u6765\u5409\u9686\u5761\uFF0C\u540C\u65F6\u4E5F\u8BA9\u4E58\u5750\u73ED\u673A\u524D\u5F80\u6210\u90FD\u7684\u6E38\u5BA2\u4E5F\u80FD\u4FBF\u5229\u5730\u8854\u63A5\u516C\u4EA4\u524D\u5F80\u76EE\u7684\u5730\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u4E3E\u4F8B\uFF0C\u5409\u9686\u5761\u98DE\u6210\u90FD\u822A\u73ED\u843D\u5730\u6210\u90FD\u7684\u65F6\u95F4\u4E3A\u6E05\u66685\u65F6\uFF0C\u591A\u4E2A\u4E2D\u8F6C\u822A\u73ED\u8D77\u98DE\u65F6\u95F4\u7EA6\u5728\u4E0A\u53488\u65F6\u5DE6\u53F3\uFF0C\u8FD9\u4E5F\u610F\u5473\u8457\u82E5\u4E58\u5BA2\u8981\u8F6C\u4E58\u98DE\u673A\u53BB\u5176\u4ED6\u57CE\u5E02\uFF0C\u65E0\u987B\u5728\u673A\u573A\u7B49\u5F85\u8FC7\u957F\u7684\u65F6\u95F4\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u7531\u4E8E\u4EE4\u5409\u548C\u65B0\u5143\u5E01\u503C\u843D\u5DEE\u7684\u5173\u7CFB\uFF0C\u4EE5\u53CA\u65C5\u6E38\u4E0E\u5546\u52A1\u987E\u5BA2\u7684\u9700\u6C42\uFF0C\u6211\u4EEC\u4E0D\u6392\u9664\u672A\u6765\u5C06\u5728\u65B0\u5C71\u589E\u8BBE\u76F4\u98DE\u4E2D\u56FD\u57CE\u5E02\u7684\u822A\u73ED\u670D\u52A1\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u5305\u4E00\u96C4\u8865\u5145\uFF0C\u6210\u90FD\u662F\u4E00\u4E2A\u4EA4\u901A\u67A2\u7EBD\u5730\u6BB5\uFF0C\u901A\u8FC7\u56DB\u5DDD\u822A\u7A7A\u7684\u6210\u90FD\u822A\u73ED\uFF0C\u53EF\u4EE5\u5FEB\u901F\u8854\u63A5\u524D\u5F80\u5176\u4ED6\u5730\u533A\uFF0C\u8FD9\u4E5F\u662F\u6709\u5173\u822A\u73ED\u7684\u4F18\u52BF\u6240\u5728\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/3ybj8_vuoycU42m1bi4t_w\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
