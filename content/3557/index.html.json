{
  "id": "%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e9%a9%bb%e5%8d%8e%e4%bd%bf%e9%a6%86%e7%94%98%e6%95%99%e5%9b%bd%e9%99%85%e4%b8%be%e8%a1%8c%e4%ba%91%e7%ab%af%e4%ba%a4%e6%b5%81%e4%bc%9a",
  "slug": "%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e9%a9%bb%e5%8d%8e%e4%bd%bf%e9%a6%86%e7%94%98%e6%95%99%e5%9b%bd%e9%99%85%e4%b8%be%e8%a1%8c%e4%ba%91%e7%ab%af%e4%ba%a4%e6%b5%81%e4%bc%9a",
  "canonicalUrlKey": "%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e9%a9%bb%e5%8d%8e%e4%bd%bf%e9%a6%86%e7%94%98%e6%95%99%e5%9b%bd%e9%99%85%e4%b8%be%e8%a1%8c%e4%ba%91%e7%ab%af%e4%ba%a4%e6%b5%81%e4%bc%9a",
  "route": "/3557/",
  "title": "\u9A6C\u6765\u897F\u4E9A\u9A7B\u534E\u4F7F\u9986\u7518\u6559\u56FD\u9645\u4E3E\u884C\u4E91\u7AEF\u4EA4\u6D41\u4F1A",
  "summary": "\u70B9\u51FB\u84DD\u5B57 \u5173\u6CE8\u6211\u4EEC \u9A6C\u6765\u897F\u4E9A\u9A7B\u534E\u4F7F\u9986\u7518\u6559\u56FD\u9645\u4E3E\u884C\u4E91\u7AEF\u4EA4\u6D41\u4F1A 3\u67082\u65E5\uFF0C\u9A6C\u6765\u897F\u4E9A\u9A7B\u534E\u5927\u4F7F\u9986\u6559\u80B2\u5904\u4E0E\u7518\u8083\u7701\u6559\u80B2\u56FD\u9645\u4EA4\u6D41\u4E0E\u5408\u4F5C\u670D\u52A1\u4E2D\u5FC3\uFF08\u7518\u6559\u56FD\u9645\uFF09\u4E3E\u884C\u4E86\u4E91\u7AEF\u5EA7\u8C08\u4F1A\uFF0C\u53CC\u65B9\u56F4\u7ED5\u81EA\u8D39\u7559\u5B66\u3001\u6821\u9645\u5408\u4F5C\u3001\u4EBA\u6587\u4EA4\u6D41\u7B49\u4E8B\u5B9C\u8FDB\u884C\u4E86\u5145\u5206\u4EA4\u6D41\u3002 \u4F1A\u8BAE\u7531\u9A6C\u6765\u897F\u4E9A\u9A7B\u534E\u5927\u4F7F\u9986\u6559\u80B2\u5904\u4E00\u7B49\u79D8\u4E66\u8521\u660E\u5347\u4E3B\u6301\uFF0C\u9A6C\u6765\u897F\u4E9A\u9A7B\u897F\u5B89\u5546\u4F1A\u6559\u80B2\u4E0E\u6587\u5316\u603B\u76D1\u5FD7\u5F3A\u3001\u83B1\u4F5B\u58EB\u5927\u5B66Teresa Liu\u3001\u4E2D\u56FD\u4E1C\u76DF\u73AF\u7403\u56FD\u9645\u6559\u80B2\u4E0E\u79D1\u6280\u987E\u95EE\u536B\u5C0F\u4E91\u535A\u58EB\u3001\u7518\u6559\u56FD\u9645\u4E2D\u5FC3\u4E3B\u4EFB\u6881\u7FD4\u3001\u529E\u516C\u5BA4\u4E3B\u4EFB\u674E\u971E\u53CA\u76F8\u5173\u4EBA\u5458\u53C2\u52A0\u4F1A\u8BAE\u3002 \u8521\u660E\u5347\u7B80\u2026",
  "body": "\u003Cp\u003E\u003Cstrong\u003E\u70B9\u51FB\u84DD\u5B57 \u5173\u6CE8\u6211\u4EEC\u003C/strong\u003E\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/03/frc-c7cd8b36241515c2063a499fa6c51458.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/03/frc-92ab41a2d26f060c23ac033caa6386ea.jpg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u9A7B\u534E\u4F7F\u9986\u7518\u6559\u56FD\u9645\u4E3E\u884C\u4E91\u7AEF\u4EA4\u6D41\u4F1A\u003C/p\u003E\n\u003Cp\u003E3\u67082\u65E5\uFF0C\u9A6C\u6765\u897F\u4E9A\u9A7B\u534E\u5927\u4F7F\u9986\u6559\u80B2\u5904\u4E0E\u7518\u8083\u7701\u6559\u80B2\u56FD\u9645\u4EA4\u6D41\u4E0E\u5408\u4F5C\u670D\u52A1\u4E2D\u5FC3\uFF08\u7518\u6559\u56FD\u9645\uFF09\u4E3E\u884C\u4E86\u4E91\u7AEF\u5EA7\u8C08\u4F1A\uFF0C\u53CC\u65B9\u56F4\u7ED5\u81EA\u8D39\u7559\u5B66\u3001\u6821\u9645\u5408\u4F5C\u3001\u4EBA\u6587\u4EA4\u6D41\u7B49\u4E8B\u5B9C\u8FDB\u884C\u4E86\u5145\u5206\u4EA4\u6D41\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/03/frc-bd2985baafe299513228a5bc00f6ab74.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E \u4F1A\u8BAE\u7531\u9A6C\u6765\u897F\u4E9A\u9A7B\u534E\u5927\u4F7F\u9986\u6559\u80B2\u5904\u4E00\u7B49\u79D8\u4E66\u8521\u660E\u5347\u4E3B\u6301\uFF0C\u9A6C\u6765\u897F\u4E9A\u9A7B\u897F\u5B89\u5546\u4F1A\u6559\u80B2\u4E0E\u6587\u5316\u603B\u76D1\u5FD7\u5F3A\u3001\u83B1\u4F5B\u58EB\u5927\u5B66Teresa Liu\u3001\u4E2D\u56FD\u4E1C\u76DF\u73AF\u7403\u56FD\u9645\u6559\u80B2\u4E0E\u79D1\u6280\u987E\u95EE\u536B\u5C0F\u4E91\u535A\u58EB\u3001\u7518\u6559\u56FD\u9645\u4E2D\u5FC3\u4E3B\u4EFB\u6881\u7FD4\u3001\u529E\u516C\u5BA4\u4E3B\u4EFB\u674E\u971E\u53CA\u76F8\u5173\u4EBA\u5458\u53C2\u52A0\u4F1A\u8BAE\u3002\u003C/p\u003E\n\u003Cp\u003E \u8521\u660E\u5347\u7B80\u8981\u4ECB\u7ECD\u4E86\u9A6C\u6765\u897F\u4E9A\u7684\u9AD8\u7B49\u6559\u80B2\u60C5\u51B5\u3002\u4ED6\u8868\u793A\uFF0C\u76EE\u524D\u5728\u9A6C\u6765\u897F\u4E9A\u7684\u4E2D\u56FD\u7559\u5B66\u4EBA\u6570\u8FBE\u5230\u4E8633000\u4EBA\uFF0C\u5360\u56FD\u9645\u5B66\u751F\u768434.5%\u3002\u4ED6\u5E0C\u671B\u901A\u8FC7\u6B64\u6B21\u7EBF\u4E0A\u5EA7\u8C08\uFF0C\u5E2E\u52A9\u642D\u5EFA\u5408\u4F5C\u4EA4\u6D41\u5E73\u53F0\uFF0C\u4E0D\u65AD\u5B8C\u5584\u5408\u4F5C\u4EA4\u6D41\u673A\u5236\uFF0C\u53D1\u6325\u53CC\u8FB9\u4F18\u52BF\uFF0C\u6293\u7D27\u843D\u5B9E\u9879\u76EE\u5408\u4F5C\uFF0C\u4FC3\u8FDB\u53CC\u65B9\u6559\u80B2\u56FD\u9645\u4EA4\u6D41\u7EB5\u6DF1\u53D1\u5C55\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/03/frc-ab4f776ab027a26159700c426a8c0b79.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u6881\u7FD4\u8868\u793A\uFF0C\u4E2D\u56FD\u4E0E\u9A6C\u6765\u897F\u4E9A\u8840\u8109\u76F8\u4EB2\uFF0C\u53CB\u597D\u5173\u7CFB\u6E90\u8FDC\u6D41\u957F\u3002\u8FD1\u5E74\u6765\uFF0C\u7518\u8083\u4E0E\u9A6C\u6765\u897F\u4E9A\u5728\u6559\u80B2\u9886\u57DF\u4EA4\u6D41\u65E5\u76CA\u9891\u7E41\uFF0C\u7518\u6559\u56FD\u9645\u63A8\u51FA\u7684\u9A6C\u6765\u897F\u4E9A\u56FD\u7ACB\u5E08\u8303\u5927\u5B66\u201C\u535A\u58EB\u5B9A\u5236\u57F9\u517B\u9879\u76EE\u201D\u6DF1\u53D7\u5B66\u5458\u9752\u7750\uFF0C\u5DF2\u6709\u8FD120\u540D\u9AD8\u6821\u6559\u5E08\u548C\u793E\u4F1A\u4EBA\u58EB\u8D74\u9A6C\u6DF1\u9020\u3002\u5927\u5BB6\u8D5E\u8D4F\u9A6C\u6765\u897F\u4E9A\u7684\u591A\u5143\u6587\u5316\uFF0C\u4ED6\u4EEC\u5F88\u4E50\u610F\u5728\u9A6C\u6765\u897F\u4E9A\u5B66\u4E60\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/03/frc-b7c45cd20a7672dc151fb744a938282b.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E \u6881\u7FD4\u5411\u9A6C\u65B9\u4EBA\u5458\u4ECB\u7ECD\u4E86\u7518\u8083\u77012023\u5E74\u6559\u80B2\u5DE5\u4F5C\u91CD\u70B9\uFF0C2023\u5E74\u7518\u8083\u6559\u80B2\u8981\u7740\u529B\u6253\u9020\u201C\u4E00\u4E2A\u5148\u884C\u533A\u3001\u4E24\u4E2A\u793A\u8303\u533A\u201D\uFF0C\u63A8\u8FDB\u201C\u4E94\u5927\u884C\u52A8\u201D\uFF0C\u5B9E\u65BD\u201C\u5341\u5927\u5DE5\u7A0B\u201D\u3002\u5176\u4E2D\u63A8\u8FDB\u6559\u80B2\u9AD8\u6C34\u5E73\u5BF9\u5916\u5F00\u653E\u884C\u52A8\u3001\u7701\u5C5E\u9AD8\u6821\u201C\u53CC\u4E00\u6D41\u201D\u7A81\u7834\u5DE5\u7A0B\u4E3A\u53CC\u65B9\u52A0\u5F3A\u6559\u80B2\u9886\u57DF\u5408\u4F5C\u63D0\u4F9B\u4E86\u6709\u529B\u7684\u653F\u7B56\u652F\u6491\u548C\u76EE\u6807\u5BFC\u5411\u3002\u5E0C\u671B\u901A\u8FC7\u6B64\u6B21\u7EBF\u4E0A\u5EA7\u8C08\u4F1A\uFF0C\u8FDB\u4E00\u6B65\u52A0\u5F3A\u53CC\u65B9\u5728\u5E08\u751F\u4E92\u8BBF\u3001\u6821\u9645\u4EA4\u6D41\u3001\u5408\u4F5C\u529E\u5B66\u7B49\u9886\u57DF\u7684\u52A1\u5B9E\u5408\u4F5C\uFF0C\u56F4\u7ED5\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u5021\u8BAE\u505A\u51FA\u66F4\u591A\u8D21\u732E\u3002\u7518\u6559\u56FD\u9645\u613F\u505A\u53CC\u65B9\u4EA4\u6D41\u7684\u6865\u6881\u7EBD\u5E26\uFF0C\u7275\u7EBF\u642D\u6865\uFF0C\u5171\u8C0B\u53D1\u5C55\uFF0C\u5B9E\u73B0\u5171\u8D62\u3002\u003C/p\u003E\n\u003Cp\u003E \u5FD7\u5F3A\u7B80\u8981\u4ECB\u7ECD\u4E86\u9A6C\u6765\u897F\u4E9A\u9A7B\u897F\u5B89\u5546\u4F1A\u7684\u60C5\u51B5\uFF0C\u8868\u8FBE\u4E86\u5408\u4F5C\u613F\u671B\u3002\u5FD7\u5F3A\u5148\u751F\u8FD8\u4ECB\u7ECD\u4E86\u6821\u53CB\u4F1A\u5728\u53CC\u8FB9\u6559\u80B2\u4EA4\u6D41\u4E2D\u53D1\u6325\u7684\u79EF\u6781\u4F5C\u7528\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/03/frc-87f32ad027d1bd1935f7a9bc0b31aeb7.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003ETeresa Liu\u4ECB\u7ECD\u4E86\u83B1\u4F5B\u58EB\u5927\u5B66\u57FA\u672C\u60C5\u51B5\uFF0C\u7518\u8083\u5B66\u751F\u8D74\u83B1\u4F5B\u58EB\u5927\u5B66\u6DF1\u9020\u7855\u535A\u5DE5\u5546\u7BA1\u7406\u76F8\u5173\u9879\u76EE\u7684\u8BFE\u7A0B\u8BBE\u7F6E\u3001\u5165\u5B66\u8981\u6C42\u7B49\uFF0C\u540C\u65F6\u5BF9\u5BB6\u957F\u5B66\u751F\u5173\u5FC3\u7684\u5B66\u8D39\u3001\u4F4F\u5BBF\u7B49\u95EE\u9898\u4E00\u4E00\u6C9F\u901A\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/03/frc-c4220834c3ba739cb191aa11424556b1.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u536B\u5C0F\u4E91\u4ECB\u7ECD\u4E86\u4E2D\u56FD\u4E1C\u76DF\u73AF\u7403\u56FD\u9645\u6559\u80B2\u4E0E\u79D1\u6280\u5728\u6587\u5316\u3001\u6559\u80B2\u3001\u670D\u52A1\u3001\u7ECF\u6D4E\u6295\u8D44\u7B49\u9886\u57DF\u53D6\u5F97\u7684\u6210\u5C31\u548C\u7ECF\u9A8C\uFF0C\u7279\u522B\u662F\u4E3A\u53CC\u8FB9\u6559\u80B2\u5408\u4F5C\u642D\u5EFA\u6865\u6881\uFF0C\u4FC3\u8FDB\u53CC\u8FB9\u6559\u80B2\u4EBA\u5458\u4EA4\u6D41\uFF0C\u5F00\u5C55\u6559\u5E08\u8BBA\u575B\u3001\u5B66\u751F\u538B\u529B\u7BA1\u7406\u8BB2\u5EA7\u3001\u6559\u5E08\u5B66\u672F\u63D0\u5347\u3001\u9752\u5C11\u5E74\u4EA4\u6D41\u7B49\u4E3B\u9898\u9879\u76EE\u7684\u60C5\u51B5\u3002\u536B\u5C0F\u4E91\u8868\u793A\uFF0C\u968F\u7740\u75AB\u60C5\u7684\u7ED3\u675F\uFF0C\u7518\u8083\u4E0E\u9A6C\u6765\u897F\u4E9A\u7684\u6559\u80B2\u5408\u4F5C\u5C06\u8FCE\u6765\u65B0\u673A\u9047\uFF0C\u5E0C\u671B\u53CC\u65B9\u80FD\u591F\u8FDB\u4E00\u6B65\u52A0\u5F3A\u6559\u80B2\u4EA4\u6D41\u6D3B\u52A8\uFF0C\u4EE5\u6B64\u6B21\u7EBF\u4E0A\u5EA7\u8C08\u4F1A\u4E3A\u5951\u673A\uFF0C\u4E3A\u540E\u7EED\u53CC\u65B9\u52A1\u5B9E\u5408\u4F5C\u5960\u5B9A\u826F\u597D\u57FA\u7840\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/03/frc-0954f021a6ba7595d1ffa64b0a9bd97d.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E \u6881\u7FD4\u8FD8\u8868\u793A\uFF0C\u6559\u80B2\u5408\u4F5C\u59CB\u4E8E\u4EBA\u5FC3\u76F8\u901A\uFF0C\u8F90\u5C04\u81F3\u5176\u4ED6\u9886\u57DF\uFF0C\u4EE5\u6559\u80B2\u4EA4\u6D41\u4E3A\u5951\u673A\uFF0C\u4EE5\u201C\u767E\u6821\u7ED3\u597D\u201D\u9879\u76EE\u4E3A\u7A81\u7834\uFF0C\u4EE5\u9009\u6D3E\u9AD8\u4E2D\u751F\u8D74\u9A6C\u7559\u5B66\u4E3A\u7740\u529B\u70B9\uFF0C\u901A\u8FC7\u4E3E\u529E\u5170\u5DDE\u725B\u8089\u9762\u8BAD\u7EC3\u8425\u3001\u6566\u714C\u83AB\u9AD8\u7A9F\u7814\u5B66\u65C5\u884C\u7B49\u6D3B\u52A8\uFF0C\u4F53\u9A8C\u4E1C\u897F\u6587\u5316\u78B0\u649E\u4E4B\u7F8E\uFF0C\u611F\u53D7\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u5EFA\u8BBE\u7684\u6210\u679C\uFF0C\u8FDB\u4E00\u6B65\u4FC3\u8FDB\u53CC\u65B9\u4EBA\u6587\u53CA\u6C11\u95F4\u4EA4\u6D41\uFF0C\u6DF1\u5316\u4E0E\u4E1C\u5357\u4E9A\u5730\u533A\u4F18\u52BF\u8D44\u6E90\u7684\u4EA4\u6D41\u878D\u5408\u3002\u003C/p\u003E\n\u003Cp\u003E \u9A6C\u6765\u897F\u4E9A\u9A7B\u534E\u4F7F\u9986\u6559\u80B2\u5904\u8868\u793A\uFF0C\u6B22\u8FCE\u9A6C\u6765\u897F\u4E9A\u548C\u4E2D\u56FD\u7684\u6559\u80B2\u673A\u6784\u5F00\u542F\u66F4\u591A\u53CC\u8D62\u5408\u4F5C\uFF0C\u5728\u6559\u80B2\u9886\u57DF\u6536\u83B7\u66F4\u591A\u4E30\u7855\u6210\u679C\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u539F\u6587\u94FE\u63A5\u003C/strong\u003E\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/03/frc-c7cd8b36241515c2063a499fa6c51458.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u7518\u6559\u56FD\u9645\n\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/03/frc-23db69da87eb83ed5b24734b0a25861e.gif\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/03/frc-3a9c9d7f90fe8708d899c6eb651989cb.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u9A6C\u6765\u897F\u4E9A\u9A7B\u534E\u5927\u4F7F\u9986\u6559\u80B2\u5904\u003C/strong\u003E\n\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u6700\u53CA\u65F6\u7684\u7559\u5B66\u54A8\u8BE2\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u6700\u70ED\u60C5\u7684\u6587\u5316\u4EA4\u6D41\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u6700\u4EB2\u5207\u7684\u65F6\u523B\u966A\u4F34\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u6B22\u8FCE\u5173\u6CE8\u9A6C\u6765\u897F\u4E9A\u9A7B\u534E\u5927\u4F7F\u9986\u6559\u80B2\u5904\uFF0C\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u4E86\u89E3\u66F4\u591A\u9AD8\u6821\u4FE1\u606F\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u9A6C\u6765\u897F\u4E9A\u7559\u5B66\u6B22\u8FCE\u60A8\uFF5E\u003C/strong\u003