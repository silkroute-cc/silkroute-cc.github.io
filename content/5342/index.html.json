{
  "id": "%e6%a3%ae%e7%be%8e%e5%85%b0%e6%96%b0%e9%82%a3%e6%97%ba%e7%a7%91%e6%8a%80%e5%b7%a5%e4%b8%9a%e5%9b%ad",
  "slug": "%e6%a3%ae%e7%be%8e%e5%85%b0%e6%96%b0%e9%82%a3%e6%97%ba%e7%a7%91%e6%8a%80%e5%b7%a5%e4%b8%9a%e5%9b%ad",
  "canonicalUrlKey": "%e6%a3%ae%e7%be%8e%e5%85%b0%e6%96%b0%e9%82%a3%e6%97%ba%e7%a7%91%e6%8a%80%e5%b7%a5%e4%b8%9a%e5%9b%ad",
  "route": "/5342/",
  "title": "\u68EE\u7F8E\u5170\u65B0\u90A3\u65FA\u79D1\u6280\u5DE5\u4E1A\u56ED",
  "summary": "\u68EE\u7F8E\u5170\u5DDE\u4F5C\u4E3A\u9A6C\u6765\u897F\u4E9A\u4E2D\u5FC3\u7684\u5730\u7406\u73E0\u5B9D\uFF0C\u6B63\u5FEB\u901F\u6210\u4E3A\u56FD\u9645\u548C\u672C\u5730\u4F01\u4E1A\u7684\u6295\u8D44\u70ED\u70B9\u3002\u65B0\u90A3\u65FA\u79D1\u6280\u5DE5\u4E1A\u56ED\u4F5C\u4E3A\u4E1C\u5357\u4E9A\u9996\u4E2A\u83B7\u5F97LEED\u91D1\u7EA7\u9884\u8BA4\u8BC1\u7684\u5DE5\u4E1A\u56ED\u533A\uFF0C\u8FDB\u4E00\u6B65\u5DE9\u56FA\u4E86\u68EE\u7F8E\u5170\u5DDE\u5728\u5168\u7403\u53EF\u6301\u7EED\u53D1\u5C55\u9886\u57DF\u7684\u9886\u5148\u5730\u4F4D\u3002 \u5730\u7406\u4E0E\u6218\u7565\u4F18\u52BF \u4F4D\u4E8E\u9A6C\u6765\u897F\u4E9A\u5FC3\u810F\u5730\u5E26\u7684\u68EE\u5DDE\u62E5\u6709\u5F97\u5929\u72EC\u539A\u7684\u5730\u7406\u4F18\u52BF\uFF0C\u4E0D\u4EC5\u8DDD\u79BB\u5409\u9686\u5761\u56FD\u9645\u673A\u573A\u4EC545\u5206\u949F\u8DEF\u7A0B\uFF0C\u524D\u5F80\u5DF4\u751F\u6E2F\u4E5F\u53EA\u970090\u5206\u949F\u8DEF\u7A0B\uFF0C\u751A\u81F3\u5230\u65B0\u52A0\u5761\u4E5F\u53EA\u97003\u5C0F\u65F6\u8DEF\u7A0B\u3002\u6B64\u5916\uFF0C\u8BE5\u533A\u57DF\u7684\u4F4E\u81EA\u7136\u707E\u5BB3\u98CE\u9669\u4F7F\u5176\u6210\u4E3A\u7A33\u5B9A\u5B89\u5168\u7684\u6295\u8D44\u4E4B\u9009\uFF0C\u8FDB\u4E00\u6B65\u5438\u5F15\u56FD\u9645\u6295\u8D44\u8005\u3002 \u5B8F\u613F\u8C372.0\u4E0E\u7ECF\u6D4E\u589E\u957F\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/11/frc-ddf01d05901ffd1ee05146d78eef9649.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u68EE\u7F8E\u5170\u5DDE\u4F5C\u4E3A\u9A6C\u6765\u897F\u4E9A\u4E2D\u5FC3\u7684\u5730\u7406\u73E0\u5B9D\uFF0C\u6B63\u5FEB\u901F\u6210\u4E3A\u56FD\u9645\u548C\u672C\u5730\u4F01\u4E1A\u7684\u6295\u8D44\u70ED\u70B9\u3002\u65B0\u90A3\u65FA\u79D1\u6280\u5DE5\u4E1A\u56ED\u4F5C\u4E3A\u4E1C\u5357\u4E9A\u9996\u4E2A\u83B7\u5F97LEED\u91D1\u7EA7\u9884\u8BA4\u8BC1\u7684\u5DE5\u4E1A\u56ED\u533A\uFF0C\u8FDB\u4E00\u6B65\u5DE9\u56FA\u4E86\u68EE\u7F8E\u5170\u5DDE\u5728\u5168\u7403\u53EF\u6301\u7EED\u53D1\u5C55\u9886\u57DF\u7684\u9886\u5148\u5730\u4F4D\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5730\u7406\u4E0E\u6218\u7565\u4F18\u52BF\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u4F4D\u4E8E\u9A6C\u6765\u897F\u4E9A\u5FC3\u810F\u5730\u5E26\u7684\u68EE\u5DDE\u62E5\u6709\u5F97\u5929\u72EC\u539A\u7684\u5730\u7406\u4F18\u52BF\uFF0C\u4E0D\u4EC5\u8DDD\u79BB\u5409\u9686\u5761\u56FD\u9645\u673A\u573A\u4EC545\u5206\u949F\u8DEF\u7A0B\uFF0C\u524D\u5F80\u5DF4\u751F\u6E2F\u4E5F\u53EA\u970090\u5206\u949F\u8DEF\u7A0B\uFF0C\u751A\u81F3\u5230\u65B0\u52A0\u5761\u4E5F\u53EA\u97003\u5C0F\u65F6\u8DEF\u7A0B\u3002\u6B64\u5916\uFF0C\u8BE5\u533A\u57DF\u7684\u4F4E\u81EA\u7136\u707E\u5BB3\u98CE\u9669\u4F7F\u5176\u6210\u4E3A\u7A33\u5B9A\u5B89\u5168\u7684\u6295\u8D44\u4E4B\u9009\uFF0C\u8FDB\u4E00\u6B65\u5438\u5F15\u56FD\u9645\u6295\u8D44\u8005\u3002\n\n\u003Cstrong\u003E\u5B8F\u613F\u8C372.0\u4E0E\u7ECF\u6D4E\u589E\u957F\u003C/strong\u003E\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/11/frc-a229dd7c66c184b013f5187f486b729e.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5B8F\u613F\u8C372.0\u8BA1\u5212\u4E3A\u68EE\u7F8E\u5170\u5DDE\u7ECF\u6D4E\u6CE8\u5165\u65B0\u7684\u589E\u957F\u52A8\u529B\uFF0C\u8986\u76D6\u9AD8\u79D1\u6280\u5DE5\u4E1A\u3001\u65E0\u4EBA\u673A\u3001\u7535\u52A8\u8F66\u7B49\u524D\u6CBF\u9886\u57DF\u3002\u6570\u636E\u663E\u793A\uFF0C\u5B8F\u613F\u8C372.0\u9879\u76EE\u6709\u671B\u5728\u672A\u676510\u5E74\u5185\u4E3A\u68EE\u7F8E\u5170\u5DDE\u5E26\u6765\u8D85\u8FC7100\u4EBF\u9A6C\u5E01\u7684\u76F4\u63A5\u6295\u8D44\uFF0C\u521B\u9020\u8D85\u8FC75\u4E07\u4E2A\u5C31\u4E1A\u673A\u4F1A\uFF0C\u5E76\u901A\u8FC7\u667A\u80FD\u57FA\u7840\u8BBE\u65BD\u4E0E\u7EFF\u8272\u80FD\u6E90\u5E94\u7528\uFF0C\u4F7F\u68EE\u7F8E\u5170\u5DDE\u5728\u56FD\u9645\u5E02\u573A\u4E0A\u5177\u5907\u66F4\u5F3A\u7684\u7ADE\u4E89\u529B\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u65B0\u90A3\u65FA\u79D1\u6280\u5DE5\u4E1A\u56ED\u2014\u2014\u7EFF\u8272\u5DE5\u4E1A\u7684\u5178\u8303\u003C/strong\u003E\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/11/frc-00f16c1079868ce202d71e49ad5482b7.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u4F5C\u4E3A\u4E1C\u5357\u4E9A\u9996\u4E2A\u83B7\u5F97LEED\u91D1\u7EA7\u8BA4\u8BC1\u7684\u5DE5\u4E1A\u56ED\u533A\uFF0C\u65B0\u90A3\u65FA\u79D1\u6280\u5DE5\u4E1A\u56ED\u5728\u7EFF\u8272\u5EFA\u7B51\u3001\u667A\u80FD\u7BA1\u7406\u548C\u53EF\u6301\u7EED\u8BBE\u8BA1\u65B9\u9762\u5C55\u73B0\u4E86\u5353\u8D8A\u7684\u6210\u5C31\u3002\u56ED\u533A\u62E5\u670979.95\u82F1\u4EA9\u7684\u7EFF\u5730\uFF0C\u5360\u5730\u5757\u603B\u9762\u79EF\u768415.3%\uFF0C\u901A\u8FC7\u96E8\u6C34\u6536\u96C6\u5B9E\u73B0\u4E86100%\u7684\u666F\u89C2\u704C\u6E89\u9700\u6C42\uFF0C\u6709\u6548\u51CF\u5C11\u6C34\u8D44\u6E90\u6D88\u8017\u3002\u5EFA\u7B51\u8BBE\u8BA1\u901A\u8FC7\u9AD8\u6548\u8282\u80FD\u65B9\u6848\u4F7F\u603B\u80FD\u8017\u9884\u8BA1\u964D\u4F4E15%\uFF0C\u5E76\u81F4\u529B\u4E8E\u51CF\u5C1150%\u7684\u6E29\u5BA4\u6C14\u4F53\u6392\u653E\u3002\u56ED\u533A\u4E5F\u9884\u8BA1\u4F7F\u752864MW\u7684\u592A\u9633\u80FD\u4F9B\u7535\uFF0C\u901A\u8FC7\u73B0\u573A\u53EF\u518D\u751F\u80FD\u6E90\u5B9E\u73B0\u9AD8\u8FBE15%\u7684\u80FD\u6E90\u8D39\u7528\u8282\u7701\u3002\u6B64\u5916\uFF0C\u65B0\u90A3\u65FA\u79D1\u6280\u5DE5\u4E1A\u56ED\u7684\u7EFF\u8272\u8BA4\u8BC1\u8BBE\u65BD\u8FD8\u4EAB\u6709\u4F18\u60E0\u5229\u7387\u7684\u7EFF\u8272\u8D37\u6B3E\uFF0C\u8FDB\u4E00\u6B65\u4E3A\u4F01\u4E1A\u63D0\u4F9B\u4E86\u8D22\u52A1\u4E0A\u7684\u652F\u6301\u4E0E\u6FC0\u52B1\u3002\n\n\u003Cstrong\u003E\u5168\u7403\u5316\u89C6\u91CE\u4E0B\u7684\u6295\u8D44\u4F18\u52BF\u003C/strong\u003E\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/11/frc-61a69eb4e3d662dd7c43836054220ed4.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u68EE\u7F8E\u5170\u5DDE\u4EE5\u5176\u4E16\u754C\u7EA7\u57FA\u7840\u8BBE\u65BD\u548C\u5168\u9762\u7684\u653F\u7B56\u652F\u6301\uFF0C\u5DF2\u6210\u4E3A\u5168\u7403\u4F01\u4E1A\u7684\u7406\u60F3\u6269\u5C55\u5E73\u53F0\u30022023\u5E74\uFF0C\u68EE\u7F8E\u5170\u5DDE\u5438\u5F15\u4E86\u603B\u8BA160.4\u4EBF\u9A6C\u5E01\u7684\u5916\u5546\u76F4\u63A5\u6295\u8D44\uFF08FDI\uFF09\uFF0C\u521B\u4E0B\u8BE5\u5DDE\u5386\u53F2\u4E0A\u7684\u6700\u9AD8\u6295\u8D44\u8BB0\u5F55\uFF0C\u8FDC\u8D857\u4EBF\u9A6C\u5E01\u7684\u539F\u5B9A\u76EE\u6807\u3002\u5176\u4E2D\uFF0C\u745E\u5178\u3001\u4E2D\u56FD\u548C\u65E5\u672C\u662F\u4E3B\u8981\u6295\u8D44\u6765\u6E90\u56FD\u3002\u003C/p\u003E\n\u003Cp\u003E\u9664\u4E86\u5916\u5546\u6295\u8D44\uFF0C\u68EE\u7F8E\u5170\u5DDE\u57282023\u5E74\u4E5F\u53D6\u5F97\u4E86\u521B\u7EAA\u5F55\u768440.5\u4EBF\u9A6C\u5E01\u56FD\u5185\u6295\u8D44\uFF0C\u6DB5\u76D6\u5236\u9020\u548C\u670D\u52A1\u4E1A\uFF0C\u4E3A\u8BE5\u5730\u533A\u7684\u7ECF\u6D4E\u5E26\u6765\u4E86\u5F3A\u52B2\u589E\u957F\u3002\u5F53\u4E2D\uFF0C\u5236\u9020\u4E1A\u7684\u603B\u6295\u8D44\u8FBE\u5230\u4E8676\u4EBF\u9A6C\u5E01\uFF0C\u5176\u4E2D60\u4EBF\u6765\u81EA\u5916\u8D44\uFF0C16\u4EBF\u6765\u81EA\u56FD\u5185\u6295\u8D44\u3002\u901A\u8FC7\u4E0D\u65AD\u53D1\u5C55\u65B0\u7684\u5DE5\u4E1A\u533A\u57DF\u5E76\u6539\u8FDB\u73B0\u6709\u8BBE\u65BD\uFF0C\u68EE\u7F8E\u5170\u5DDE\u4E3A\u4F01\u4E1A\u63D0\u4F9B\u4E86\u66F4\u591A\u7684\u6269\u5C55\u673A\u4F1A\u3002\u003C/p\u003E\n\u003Cp\u003E\u8FD9\u4E9B\u6295\u8D44\u4E0D\u4EC5\u589E\u5F3A\u4E86\u68EE\u7F8E\u5170\u5DDE\u5728\u56FD\u9645\u5E02\u573A\u4E0A\u7684\u7ADE\u4E89\u529B\uFF0C\u8FD8\u9884\u8BA1\u57282023\u5E74\u521B\u90203250\u4E2A\u65B0\u5DE5\u4F5C\u5C97\u4F4D\u3002\u51ED\u501F\u4E16\u754C\u7EA7\u7684\u57FA\u7840\u8BBE\u65BD\u3001\u4FBF\u6377\u7684\u4EA4\u901A\u7F51\u7EDC\u4EE5\u53CA\u5BF9\u9AD8\u79D1\u6280\u4EA7\u4E1A\u7684\u6295\u8D44\u5438\u5F15\u529B\uFF0C\u68EE\u7F8E\u5170\u5DDE\u6B63\u5728\u6210\u4E3A\u4F01\u4E1A\u8FDB\u5165\u4E1C\u5357\u4E9A\u5E02\u573A\u3001\u5B9E\u73B0\u957F\u671F\u589E\u957F\u7684\u7406\u60F3\u4E4B\u9009\u3002\u003C/p\u003E\n\u003Cp\u003E\u68EE\u7F8E\u5170\u5DDE\u4EE5\u5176\u4E16\u754C\u7EA7\u57FA\u7840\u8BBE\u65BD\u548C\u5168\u9762\u7684\u653F\u7B56\u652F\u6301\uFF0C\u5DF2\u6210\u4E3A\u5168\u7403\u4F01\u4E1A\u7684\u7406\u60F3\u6269\u5C55\u5E73\u53F0\u30022023\u5E74\uFF0C\u68EE\u7F8E\u5170\u5DDE\u5438\u5F15\u4E86\u603B\u8BA160.4\u4EBF\u9A6C\u5E01\u7684\u5916\u5546\u76F4\u63A5\u6295\u8D44\uFF08FDI\uFF09\uFF0C\u521B\u4E0B\u8BE5\u5DDE\u5386\u53F2\u4E0A\u7684\u6700\u9AD8\u6295\u8D44\u8BB0\u5F55\uFF0C\u8FDC\u8D857\u4EBF\u9A6C\u5E01\u7684\u539F\u5B9A\u76EE\u6807\u3002\u5176\u4E2D\uFF0C\u745E\u5178\u3001\u4E2D\u56FD\u548C\u65E5\u672C\u662F\u4E3B\u8981\u6295\u8D44\u6765\u6E90\u56FD\u3002\u003C/p\u003E\n\u003Cp\u003E\u9664\u4E86\u5916\u5546\u6295\u8D44\uFF0C\u68EE\u7F8E\u5170\u5DDE\u57282023\u5E74\u4E5F\u53D6\u5F97\u4E86\u521B\u7EAA\u5F55\u768440.5\u4EBF\u9A6C\u5E01\u56FD\u5185\u6295\u8D44\uFF0C\u6DB5\u76D6\u5236\u9020\u548C\u670D\u52A1\u4E1A\uFF0C\u4E3A\u8BE5\u5730\u533A\u7684\u7ECF\u6D4E\u5E26\u6765\u4E86\u5F3A\u52B2\u589E\u957F\u3002\u5F53\u4E2D\uFF0C\u5236\u9020\u4E1A\u7684\u603B\u6295\u8D44\u8FBE\u5230\u4E8676\u4EBF\u9A6C\u5E01\uFF0C\u5176\u4E2D60\u4EBF\u6765\u81EA\u5916\u8D44\uFF0C16\u4EBF\u6765\u81EA\u56FD\u5185\u6295\u8D44\u3002\u901A\u8FC7\u4E0D\u65AD\u53D1\u5C55\u65B0\u7684\u5DE5\u4E1A\u533A\u57DF\u5E76\u6539\u8FDB\u73B0\u6709\u8BBE\u65BD\uFF0C\u68EE\u7F8E\u5170\u5DDE\u4E3A\u4F01\u4E1A\u63D0\u4F9B\u4E86\u66F4\u591A\u7684\u6269\u5C55\u673A\u4F1A\u3002\u003C/p\u003E\n\u003Cp\u003E\u8FD9\u4E9B\u6295\u8D44\u4E0D\u4EC5\u589E\u5F3A\u4E86\u68EE\u7F8E\u5170\u5DDE\u5728\u56FD\u9645\u5E02\u573A\u4E0A\u7684\u7ADE\u4E89\u529B\uFF0C\u8FD8\u9884\u8BA1\u57282023\u5E74\u521B\u90203250\u4E2A\u65B0\u5DE5\u4F5C\u5C97\u4F4D\u3002\u51ED\u501F\u4E16\u754C\u7EA7\u7684\u57FA\u7840\u8BBE\u65BD\u3001\u4FBF\u6377\u7684\u4EA4\u901A\u7F51\u7EDC\u4EE5\u53CA\u5BF9\u9AD8\u79D1\u6280\u4EA7\u4E1A\u7684\u6295\u8D44\u5438\u5F15\u529B\uFF0C\u68EE\u7F8E\u5170\u5DDE\u6B63\u5728\u6210\u4E3A\u4F01\u4E1A\u8FDB\u5165\u4E1C\u5357\u4E9A\u5E02\u573A\u3001\u5B9E\u73B0\u957F\u671F\u589E\u957F\u7684\u7406\u60F3\u4E4B\u9009\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/AfS9sPeEgMpx9vivaJJEfw\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
