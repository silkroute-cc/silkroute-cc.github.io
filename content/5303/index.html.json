  "route": "/5303/",
  "title": "\u8FBE\u6210\u521D\u6B65\u5408\u4F5C\u610F\u5411\uFF0C\u9A6C\u6765\u897F\u4E9A\u8FD9\u6240\u5927\u5B66\u6765\u8BBF\u6E56\u5357\u673A\u7535\u804C\u9662",
  "summary": "\u6E56\u5357\u65E5\u62A510\u670831\u65E5\u8BAF\uFF08\u901A\u8BAF\u5458 \u82AE\u677E \u5468\u8BD7\u5C27\uFF09\u8FD1\u65E5\uFF0C\u9A6C\u6765\u897F\u4E9A\u73BB\u7483\u5E02\u5927\u5B66\u526F\u6821\u957F\u83AB\u54C8\u672B\u00B7\u8212\u514B\u91CC\u00B7\u963F\u535C\u675C\u00B7\u9A6C\u5409\u5FB7\uFF08Prof. Dr. Mohd Shukry Abd Majid\uFF09\u7387\u9886\u516D\u4EBA\u4EE3\u8868\u56E2\u6765\u5230\u6E56\u5357\u673A\u7535\u804C\u4E1A\u6280\u672F\u5B66\u9662\u8FDB\u884C\u53CB\u597D\u8BBF\u95EE\u3002\u5728\u6DF1\u5165\u7684\u4EA4\u6D41\u63A2\u8BA8\u4E2D\uFF0C\u9A6C\u6765\u897F\u4E9A\u73BB\u7483\u5E02\u5927\u5B66\u4E0E\u5B66\u6821\u56FD\u9645\u4EA4\u6D41\u5904\u3001\u5B9E\u4E60\u57F9\u8BAD\u4E2D\u5FC3\u8FBE\u6210\u4E86\u521D\u6B65\u5408\u4F5C\u610F\u5411\u3002 \u5EA7\u8C08\u4F1A\u4E0A\uFF0C\u5B66\u6821\u526F\u6821\u957F\u5468\u4EAE\u8868\u793A\uFF0C\u4F5C\u4E3A\u6E56\u5357\u7701\u695A\u6021\u9AD8\u6C34\u5E73\u9AD8\u804C\u5B66\u6821A\u6863\u5EFA\u8BBE\u5355\u4F4D\uFF0C\u5B66\u6821\u4E00\u76F4\u690D\u6839\u4E8E\u88C5\u5907\u5236\u9020\u4EA7\u4E1A\uFF0C\u81F4\u529B\u4E8E\u57F9\u80B2\u9002\u5E94\u65B0\u65F6\u4EE3\u9700\u6C42\u7684\u9AD8\u7D20\u8D28\u6280\u672F\u6280\u80FD\u4EBA\u624D\u3002\u540C\u65F6\uFF0C\u5B66\u6821\u2026",
  "body": "\u003Cp\u003E\u6E56\u5357\u65E5\u62A510\u670831\u65E5\u8BAF\uFF08\u901A\u8BAF\u5458 \u82AE\u677E \u5468\u8BD7\u5C27\uFF09\u8FD1\u65E5\uFF0C\u9A6C\u6765\u897F\u4E9A\u73BB\u7483\u5E02\u5927\u5B66\u526F\u6821\u957F\u83AB\u54C8\u672B\u0026#183;\u8212\u514B\u91CC\u0026#183;\u963F\u535C\u675C\u0026#183;\u9A6C\u5409\u5FB7\uFF08Prof. Dr. Mohd Shukry Abd Majid\uFF09\u7387\u9886\u516D\u4EBA\u4EE3\u8868\u56E2\u6765\u5230\u6E56\u5357\u673A\u7535\u804C\u4E1A\u6280\u672F\u5B66\u9662\u8FDB\u884C\u53CB\u597D\u8BBF\u95EE\u3002\u5728\u6DF1\u5165\u7684\u4EA4\u6D41\u63A2\u8BA8\u4E2D\uFF0C\u9A6C\u6765\u897F\u4E9A\u73BB\u7483\u5E02\u5927\u5B66\u4E0E\u5B66\u6821\u56FD\u9645\u4EA4\u6D41\u5904\u3001\u5B9E\u4E60\u57F9\u8BAD\u4E2D\u5FC3\u8FBE\u6210\u4E86\u521D\u6B65\u5408\u4F5C\u610F\u5411\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/11/frc-568f21821c721bc6ee50cd3e9d24a4ee.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5EA7\u8C08\u4F1A\u4E0A\uFF0C\u5B66\u6821\u526F\u6821\u957F\u5468\u4EAE\u8868\u793A\uFF0C\u4F5C\u4E3A\u6E56\u5357\u7701\u695A\u6021\u9AD8\u6C34\u5E73\u9AD8\u804C\u5B66\u6821A\u6863\u5EFA\u8BBE\u5355\u4F4D\uFF0C\u5B66\u6821\u4E00\u76F4\u690D\u6839\u4E8E\u88C5\u5907\u5236\u9020\u4EA7\u4E1A\uFF0C\u81F4\u529B\u4E8E\u57F9\u80B2\u9002\u5E94\u65B0\u65F6\u4EE3\u9700\u6C42\u7684\u9AD8\u7D20\u8D28\u6280\u672F\u6280\u80FD\u4EBA\u624D\u3002\u540C\u65F6\uFF0C\u5B66\u6821\u4E5F\u79EF\u6781\u63A8\u52A8\u56FD\u9645\u6559\u80B2\u4EA4\u6D41\u4E0E\u5408\u4F5C\uFF0C\u5E0C\u671B\u901A\u8FC7\u6B64\u6B21\u4EA4\u6D41\uFF0C\u53CC\u65B9\u80FD\u591F\u63A2\u7D22\u66F4\u591A\u5408\u4F5C\u673A\u4F1A\uFF0C\u5171\u540C\u57F9\u517B\u5177\u6709\u56FD\u9645\u89C6\u91CE\u7684\u9AD8\u7D20\u8D28\u4EBA\u624D\u3002\u003C/p\u003E\n\u003Cp\u003E\u83AB\u54C8\u672B\u0026#183;\u8212\u514B\u91CC\u0026#183;\u963F\u535C\u675C\u0026#183;\u9A6C\u5409\u5FB7\u8BE6\u7EC6\u4ECB\u7ECD\u4E86\u73BB\u7483\u5E02\u5927\u5B66\u4F5C\u4E3A\u9A6C\u6765\u897F\u4E9A\u7B2C17\u6240\u516C\u7ACB\u5927\u5B66\u7684\u57FA\u672C\u60C5\u51B5\uFF0C\u5305\u62EC\u5176\u4E0B\u8BBE\u76842\u4E2A\u7814\u7A76\u5B66\u9662\u548C6\u4E2A\u5DE5\u7A0B\u5B66\u9662\u3002\u4ED6\u6307\u51FA\uFF0C\u4E24\u6821\u5728\u4E13\u4E1A\u4E0A\u5B58\u5728\u9AD8\u5EA6\u5339\u914D\u6027\uFF0C\u4E2D\u9A6C\u4E24\u56FD\u5728\u6559\u80B2\u9886\u57DF\u6709\u7740\u5E7F\u6CDB\u7684\u5408\u4F5C\u7A7A\u95F4\u3002\u4ED6\u5E0C\u671B\u901A\u8FC7\u6B64\u6B21\u8BBF\u95EE\uFF0C\u80FD\u591F\u52A0\u6DF1\u53CC\u65B9\u7684\u4E86\u89E3\uFF0C\u5E76\u5B9E\u8D28\u6027\u63A8\u52A8\u804C\u4E1A\u6280\u80FD\u57F9\u8BAD\u9879\u76EE\u53CA\u4EA4\u6D41\u751F\u9879\u76EE\u5728\u5B66\u6821\u843D\u5730\uFF0C\u4E3A\u4E24\u6821\u6559\u80B2\u4E8B\u4E1A\u7684\u53D1\u5C55\u8D21\u732E\u529B\u91CF\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/iOwbsPa3C7fvOZ5SOmOBiw\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
