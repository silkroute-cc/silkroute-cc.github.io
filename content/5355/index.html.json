{
  "id": "%e9%87%91%e8%9e%8d%e5%8f%8a%e7%89%a9%e6%b5%81%e4%bc%81%e4%b8%9a%e4%ba%89%e7%9b%b8%e8%bf%9b%e9%a9%bb-%e6%a3%ae%e6%9e%97%e5%9f%8e%e5%b8%82%e9%87%91%e8%9e%8d%e7%89%b9%e5%8c%ba%e5%8a%bf%e5%a4%b4%e5%bc%ba",
  "slug": "%e9%87%91%e8%9e%8d%e5%8f%8a%e7%89%a9%e6%b5%81%e4%bc%81%e4%b8%9a%e4%ba%89%e7%9b%b8%e8%bf%9b%e9%a9%bb-%e6%a3%ae%e6%9e%97%e5%9f%8e%e5%b8%82%e9%87%91%e8%9e%8d%e7%89%b9%e5%8c%ba%e5%8a%bf%e5%a4%b4%e5%bc%ba",
  "canonicalUrlKey": "%e9%87%91%e8%9e%8d%e5%8f%8a%e7%89%a9%e6%b5%81%e4%bc%81%e4%b8%9a%e4%ba%89%e7%9b%b8%e8%bf%9b%e9%a9%bb-%e6%a3%ae%e6%9e%97%e5%9f%8e%e5%b8%82%e9%87%91%e8%9e%8d%e7%89%b9%e5%8c%ba%e5%8a%bf%e5%a4%b4%e5%bc%ba",
  "route": "/5355/",
  "title": "\u91D1\u878D\u53CA\u7269\u6D41\u4F01\u4E1A\u4E89\u76F8\u8FDB\u9A7B \u68EE\u6797\u57CE\u5E02\u91D1\u878D\u7279\u533A\u52BF\u5934\u5F3A\u52B2",
  "summary": "\u653F\u5E9C\u4E3A\u68EE\u6797\u57CE\u5E02\u91D1\u878D\u7279\u533A\u63D0\u4F9B4\u5927\u5956\u6396\u63AA\u65BD\u5438\u5F15\u5916\u8D44\u3002 \uFF08\u65B0\u5C7127\u65E5\u8BAF\uFF09\u968F\u7740\u591A\u9879\u6709\u5173\u68EE\u6797\u57CE\u5E02\u91D1\u878D\u7279\u533A\u7684\u5956\u6396\u516C\u5E03\u540E\uFF0C\u5DF2\u6709\u591A\u5BB6\u672C\u5730\u53CA\u56FD\u9645\u91D1\u878D\u673A\u6784\uFF0C\u5BB6\u65CF\u529E\u516C\u5BA4\u8D44\u4EA7\u7BA1\u7406\u516C\u53F8\u548C\u7269\u6D41\u4F01\u4E1A\uFF0C\u6709\u610F\u5728\u68EE\u6797\u57CE\u5E02\u91D1\u878D\u7279\u533A\u8BBE\u7ACB\u4E1A\u52A1\u3002 \u67D4\u4F5B\u5DDE\u52A1\u5927\u81E3\u62FF\u7763\u7FC1\u54C8\u83F2\u5179\u6307\u51FA\uFF0C\u8FD9\u4E9B\u91D1\u878D\u673A\u6784\u5305\u62EC\u62EC\u9A6C\u94F6\u884C\uFF08MAYBANK,1155,\u4E3B\u677F\u91D1\u878D\u670D\u52A1\u7EC4\uFF09\u3001\u5927\u4F17\u94F6\u884C\uFF08PBBANK\uFF0C1295\uFF0C\u4E3B\u677F\u91D1\u878D\u80A1\uFF09\u3001\u5927\u534E\u94F6\u884C\u3001\u91CC\u6602\u8BC1\u5238\uFF08CLSA\uFF09\u7B49\u3002 \u4ED6\u5468\u4E09\u5728\u67D4\u5DDE\u8BAE\u4F1A\u4E0A\u900F\u9732\uFF0C\u4E5F\u67098\u5BB6\u5BB6\u65CF\u529E\u516C\u5BA4\u30012\u5BB6\u8D44\u4EA7\u7BA1\u7406\u516C\u53F8\u548C\u4E00\u5BB6\u7269\u6D41\u4F01\u4E1A\u6709\u610F\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/12/frc-e32dc56b9eaa758b3f6064afc83ef6a6.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u653F\u5E9C\u4E3A\u68EE\u6797\u57CE\u5E02\u91D1\u878D\u7279\u533A\u63D0\u4F9B4\u5927\u5956\u6396\u63AA\u65BD\u5438\u5F15\u5916\u8D44\u3002\u003C/p\u003E\n\u003Cp\u003E\uFF08\u65B0\u5C7127\u65E5\u8BAF\uFF09\u968F\u7740\u591A\u9879\u6709\u5173\u68EE\u6797\u57CE\u5E02\u91D1\u878D\u7279\u533A\u7684\u5956\u6396\u516C\u5E03\u540E\uFF0C\u5DF2\u6709\u591A\u5BB6\u672C\u5730\u53CA\u56FD\u9645\u91D1\u878D\u673A\u6784\uFF0C\u5BB6\u65CF\u529E\u516C\u5BA4\u8D44\u4EA7\u7BA1\u7406\u516C\u53F8\u548C\u7269\u6D41\u4F01\u4E1A\uFF0C\u6709\u610F\u5728\u68EE\u6797\u57CE\u5E02\u91D1\u878D\u7279\u533A\u8BBE\u7ACB\u4E1A\u52A1\u3002\u003C/p\u003E\n\u003Cp\u003E\u67D4\u4F5B\u5DDE\u52A1\u5927\u81E3\u62FF\u7763\u7FC1\u54C8\u83F2\u5179\u6307\u51FA\uFF0C\u8FD9\u4E9B\u91D1\u878D\u673A\u6784\u5305\u62EC\u62EC\u9A6C\u94F6\u884C\uFF08MAYBANK,1155,\u4E3B\u677F\u91D1\u878D\u670D\u52A1\u7EC4\uFF09\u3001\u5927\u4F17\u94F6\u884C\uFF08PBBANK\uFF0C1295\uFF0C\u4E3B\u677F\u91D1\u878D\u80A1\uFF09\u3001\u5927\u534E\u94F6\u884C\u3001\u91CC\u6602\u8BC1\u5238\uFF08CLSA\uFF09\u7B49\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u5468\u4E09\u5728\u67D4\u5DDE\u8BAE\u4F1A\u4E0A\u900F\u9732\uFF0C\u4E5F\u67098\u5BB6\u5BB6\u65CF\u529E\u516C\u5BA4\u30012\u5BB6\u8D44\u4EA7\u7BA1\u7406\u516C\u53F8\u548C\u4E00\u5BB6\u7269\u6D41\u4F01\u4E1A\u6709\u610F\u8FDB\u9A7B\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C8\u5BB6\u5BB6\u65CF\u529E\u516C\u5BA4\u4E2D\uFF0C\u6709\u4E00\u5BB6\u6765\u81EA\u5370\u5C3C\uFF0C\u4E24\u5BB6\u6765\u81EA\u53F0\u6E7E\u3002\u6B64\u5916\uFF0C\u8FD8\u6709\u4E24\u5BB6\u8D44\u4EA7\u7BA1\u7406\u516C\u53F8\uFF0C\u5373\u8054\u660C\u56FD\u9645\u94F6\u884C\u548C\u4E2D\u56FD\u94F6\u6CB3\u8BC1\u5238\u6709\u9650\u516C\u53F8\uFF0C\u4E5F\u8BA1\u5212\u5728\u8BE5\u533A\u8BBE\u7ACB\u4E1A\u52A1\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u8FD9\u4E9B\u5BB6\u65CF\u529E\u516C\u5BA4\u6DB5\u76D6\u591A\u4E2A\u9886\u57DF\uFF0C\u5305\u62EC\u4E1C\u5357\u7269\u6D41\uFF08TNLOGIS\uFF0C8397\uFF0C\u4E3B\u677F\u4EA4\u901A\u4E0E\u7269\u6D41\u80A1\uFF09\u3001\u5F00\u53D1\u4E0E\u5DE5\u7A0B\u670D\u52A1\u5546\u817E\u5B87\u96C6\u56E2\uFF08AME\uFF0C5293\uFF0C\u4E3B\u677F\u5EFA\u7B51\u80A1\uFF09\u4EE5\u53CA\u6295\u8D44\u516C\u53F8\u4E07\u5229\u63A7\u80A1\uFF08Wan Li Holdings\uFF09\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u662F\u5728\u56DE\u7B54\u6B66\u5409\u5CC7\u90FD\u5DDE\u8BAE\u5458\u5F20\u5584\u6DF1\u548C\u672C\u90A3\u54C7\u5DDE\u8BAE\u5458\u6CD5\u5179\u4E9A\u5BC6\u65AF\u91CC\uFF0C\u6709\u5173\u91D1\u878D\u7279\u533A\u8FDB\u5C55\u7684\u95EE\u9898\u65F6\u8FD9\u4E48\u56DE\u5E94\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u805A\u71262\u6838\u5FC3\u9886\u57DF\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u53E6\u4E00\u65B9\u9762\uFF0C\u7FC1\u54C8\u83F2\u5179\u4E5F\u8868\u793A\uFF0C\u68EE\u6797\u57CE\u5E02\u91D1\u878D\u7279\u533A\u5C06\u805A\u7126\u53D1\u5C55\u4E24\u5927\u6838\u5FC3\u9886\u57DF\uFF0C\u5373\u94F6\u884C\u4E0E\u91D1\u878D\u670D\u52A1\uFF0C\u4EE5\u53CA\u7269\u6D41\u670D\u52A1\u3001\u5168\u7403\u670D\u52A1\u4E2D\u5FC3\u548C\u8F6C\u79FB\u670D\u52A1\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6307\u51FA\uFF0C\u7B2C\u4E00\u4E2A\u9886\u57DF\u7684\u670D\u52A1\u5C06\u8BBE\u5728\u7B2C\u4E00\u5C9B\uFF0C\u7B2C\u4E8C\u4E2A\u9886\u57DF\u7684\u670D\u52A1\u5219\u5C06\u5728\u68EE\u6797\u57CE\u5E02\u7684\u9646\u5730\u533A\u57DF\u53D1\u5C55\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u68EE\u6797\u57CE\u5E02\u4F5C\u4E3A\u7279\u533A\u5185\u7684\u514D\u7A0E\u5C9B\uFF0C\u5177\u6709\u72EC\u7279\u4F18\u52BF\uFF0C\u5305\u62EC\u7B2C\u4E00\u5C9B\u548C\u9646\u5730\u533A\u57DF\u3002\u6BCF\u4E2A\u533A\u57DF\u90FD\u6839\u636E\u7279\u5B9A\u884C\u4E1A\u63D0\u4F9B\u6761\u4EF6\u6027\u5956\u6396\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u7B2C\u4E00\u4E2A\u9886\u57DF\u6D89\u53CA\u7B2C\u4E00\u5C9B\u7684\u94F6\u884C\u4E0E\u91D1\u878D\u670D\u52A1\uFF0C\u800C\u9646\u5730\u533A\u57DF\u5C06\u63D0\u4F9B\u7269\u6D41\u670D\u52A1\u3001\u5168\u7403\u670D\u52A1\u4E2D\u5FC3\u4EE5\u53CA\u8F6C\u79FB\u670D\u52A1\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6307\u51FA\uFF0C\u7B2C\u4E00\u5C9B\u63D0\u4F9B\u5305\u62EC\u96F6\u81F35%\u7684\u4F18\u60E0\u4F01\u4E1A\u7A0E\u7387\uFF08\u76F8\u6BD4\u76EE\u524D\u768424%\u7A0E\u7387\uFF09\u5728\u5185\u76849\u9879\u5956\u6396\u63AA\u65BD\uFF0C\u540C\u65F6\u6210\u4E3A\u5168\u9A6C\u9996\u4E2A\u4E3A\u5BB6\u65CF\u529E\u516C\u5BA4\u63D0\u4F9B0%\u7A0E\u7387\u7684\u5730\u70B9\u3002\u003C/p\u003E\n\u003Cp\u003E\u6B64\u533A\u7684\u7ECF\u6D4E\u6D3B\u52A8\u80FD\u6EE1\u8DB3\u5546\u4E1A\u53CA\u793E\u533A\u9700\u6C42\uFF0C\u4F8B\u5982\u6295\u8D44\u3001\u4FDD\u9669\u3001\u91D1\u878D\u79D1\u6280\u3001\u76D1\u7BA1\u79D1\u6280\u548C\u4FDD\u9669\u79D1\u6280\uFF0C\u4E5F\u5305\u62EC\u4F20\u7EDF\u53CA\u56DE\u6559\u94F6\u884C\u7684\u670D\u52A1\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u6B64\u5916\uFF0C\u9646\u5730\u533A\u57DF\u5C06\u63D0\u4F9B\u4E24\u9879\u6FC0\u52B1\u63AA\u65BD\uFF1A\u9488\u5BF9\u7269\u6D41\u670D\u52A1\u9886\u57DF\u76845\u5E74\u671F100%\u6295\u8D44\u7A0E\u51CF\u514D\uFF0C\u5141\u8BB8\u6263\u9664100%\u7684\u6CD5\u5B9A\u6536\u5165\uFF1B\u4EE5\u53CA\u9488\u5BF9\u5168\u7403\u670D\u52A1\u4E2D\u5FC3\u548C\u8F6C\u79FB\u670D\u52A1\u7684\u957F\u8FBE20\u5E74\u76845%\u7A0E\u7387\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u653F\u5E9C\u5C06\u5168\u529B\u652F\u6301\u68EE\u6797\u57CE\u5E02\u91D1\u878D\u7279\u533A\u7684\u5EFA\u8BBE\uFF0C\u8FD9\u5C06\u80FD\u52A9\u529B\u63A8\u52A8\u67D4\u4F5B\u7684\u7ECF\u6D4E\u589E\u957F\uFF0C\u5E76\u4E3A\u5F53\u5730\u5C45\u6C11\u521B\u9020\u9AD8\u6536\u5165\u7684\u5C31\u4E1A\u673A\u4F1A\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u9488\u5BF9\u63D0\u51FA\u7684\u9632\u6B62\u5047\u5192\u4EA7\u54C1\u8FDB\u5165\u91D1\u878D\u7279\u533A\u7269\u6D41\u9886\u57DF\u7684\u63D0\u95EE\uFF0C\u7FC1\u54C8\u83F2\u5179\u8868\u793A\uFF0C\u5F53\u5C40\u5C06\u901A\u8FC7\u591A\u9879\u63AA\u65BD\u63D0\u5347\u76D1\u7BA1\u80FD\u529B\uFF0C\u5305\u62EC\u5728\u68EE\u6797\u57CE\u5E02\u5EFA\u7ACB\u5168\u65B0\u5173\u7A0E\u5C40\u7EFC\u5408\u4F53\uFF0C\u914D\u5907\u4EBA\u5DE5\u667A\u80FD\u884C\u674E\u626B\u63CF\u548C\u9762\u90E8\u8BC6\u522B\u7B49\u5148\u8FDB\u6280\u672F\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/lpyS3iU26bbmGiuTmMZUHg\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
