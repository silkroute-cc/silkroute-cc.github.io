  "title": "\u201C\u4E66\u6CD5\u6709\u6CD5\uFF0C\u4E0E\u53E4\u4E3A\u65B0\u201D\u4E2D\u9A6C\u4E66\u6CD5\u827A\u672F\u5EA7\u8C08\u4F1A\u5728\u5409\u9686\u5761\u4E3E\u529E",
  "summary": "6\u670830\u65E5\uFF0C\u7531\u4E2D\u56FD\u4E66\u6CD5\u5BB6\u534F\u4F1A\u3001\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u3001\u9A6C\u6765\u897F\u4E9A\u4E66\u827A\u603B\u4F1A\u8054\u5408\u4E3B\u529E\u7684\u201C\u4E66\u6CD5\u6709\u6CD5\uFF0C\u4E0E\u53E4\u4E3A\u65B0\u201D\u4E2D\u9A6C\u4E66\u6CD5\u827A\u672F\u5EA7\u8C08\u4F1A\u5728\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u6210\u529F\u4E3E\u884C\u3002\u4E2D\u56FD\u4E66\u6CD5\u5BB6\u534F\u4F1A\u4E3B\u5E2D\u5B59\u6653\u4E91\uFF0C\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u4E3B\u4EFB\u97E9\u5B81\uFF0C\u9A6C\u6765\u897F\u4E9A\u4E66\u827A\u603B\u4F1A\u4F1A\u957F\u9EC4\u745E\u5E86\uFF0C\u4E2D\u56FD\u4E66\u6CD5\u5BB6\u534F\u4F1A\u526F\u79D8\u4E66\u957F\u5F20\u6F47\u7FBD\uFF0C\u4EE5\u53CA\u6765\u81EA\u4E2D\u9A6C\u6587\u5316\u3001\u4E66\u6CD5\u3001\u6559\u80B2\u754C\u768440\u4F59\u4F4D\u5609\u5BBE\u51FA\u5E2D\u6D3B\u52A8\u3002 \u5B59\u6653\u4E91\u4E3B\u5E2D\u505A\u4E3B\u65E8\u53D1\u8A00 \u5EA7\u8C08\u4F1A\u4E0A\uFF0C\u4E2D\u56FD\u4E66\u6CD5\u5BB6\u534F\u4F1A\u4E3B\u5E2D\u5B59\u6653\u4E91\u6307\u51FA\uFF0C\u201C\u4E66\u6CD5\u6709\u6CD5\u201D\u5F3A\u8C03\u5BF9\u4F20\u7EDF\u7B14\u6CD5\u3001\u6280\u6CD5\u4E0E\u6CD5\u5EA6\u7684\u606A\u5B88\uFF0C\u662F\u4E66\u6CD5\u827A\u672F\u7ACB\u6839\u94F8\u9B42\u4E4B\u6240\u5728\uFF1B\u201C\u2026",
  "body": "\u003Cp\u003E6\u670830\u65E5\uFF0C\u7531\u4E2D\u56FD\u4E66\u6CD5\u5BB6\u534F\u4F1A\u3001\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u3001\u9A6C\u6765\u897F\u4E9A\u4E66\u827A\u603B\u4F1A\u8054\u5408\u4E3B\u529E\u7684\u201C\u4E66\u6CD5\u6709\u6CD5\uFF0C\u4E0E\u53E4\u4E3A\u65B0\u201D\u4E2D\u9A6C\u4E66\u6CD5\u827A\u672F\u5EA7\u8C08\u4F1A\u5728\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u6210\u529F\u4E3E\u884C\u3002\u4E2D\u56FD\u4E66\u6CD5\u5BB6\u534F\u4F1A\u4E3B\u5E2D\u5B59\u6653\u4E91\uFF0C\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u4E3B\u4EFB\u97E9\u5B81\uFF0C\u9A6C\u6765\u897F\u4E9A\u4E66\u827A\u603B\u4F1A\u4F1A\u957F\u9EC4\u745E\u5E86\uFF0C\u4E2D\u56FD\u4E66\u6CD5\u5BB6\u534F\u4F1A\u526F\u79D8\u4E66\u957F\u5F20\u6F47\u7FBD\uFF0C\u4EE5\u53CA\u6765\u81EA\u4E2D\u9A6C\u6587\u5316\u3001\u4E66\u6CD5\u3001\u6559\u80B2\u754C\u768440\u4F59\u4F4D\u5609\u5BBE\u51FA\u5E2D\u6D3B\u52A8\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/sz_mmbiz_jpg/KzZqvMiaRfUw1KjsrW7jAfgNex5JWJuY3cEnVkgfKjwn2W7fNyjLSJVCAJzFa5d4TBYZX50vEGxLFmVVqcBwPibQ/640?wx_fmt=jpeg\u0026amp;from=appmsg\u0026amp;tp=webp\u0026amp;wxfrom=5\u0026amp;wx_lazy=1\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5B59\u6653\u4E91\u4E3B\u5E2D\u505A\u4E3B\u65E8\u53D1\u8A00\u003C/p\u003E\n\u003Cp\u003E\u5EA7\u8C08\u4F1A\u4E0A\uFF0C\u4E2D\u56FD\u4E66\u6CD5\u5BB6\u534F\u4F1A\u4E3B\u5E2D\u5B59\u6653\u4E91\u6307\u51FA\uFF0C\u201C\u4E66\u6CD5\u6709\u6CD5\u201D\u5F3A\u8C03\u5BF9\u4F20\u7EDF\u7B14\u6CD5\u3001\u6280\u6CD5\u4E0E\u6CD5\u5EA6\u7684\u606A\u5B88\uFF0C\u662F\u4E66\u6CD5\u827A\u672F\u7ACB\u6839\u94F8\u9B42\u4E4B\u6240\u5728\uFF1B\u201C\u4E0E\u53E4\u4E3A\u65B0\u201D\u5219\u4E3B\u5F20\u5728\u4F20\u627F\u7ECF\u5178\u7684\u57FA\u7840\u4E0A\u878D\u5165\u65F6\u4EE3\u7CBE\u795E\u4E0E\u4E2A\u4EBA\u98CE\u683C\uFF0C\u5B9E\u73B0\u827A\u672F\u4E0A\u7684\u521B\u65B0\u7A81\u7834\u3002\u4E8C\u8005\u76F8\u8F85\u76F8\u6210\uFF0C\u8FA9\u8BC1\u7EDF\u4E00\uFF0C\u751F\u52A8\u8BE0\u91CA\u4E86\u4E66\u6CD5\u827A\u672F\u5728\u4F20\u627F\u4E2D\u6C42\u65B0\u3001\u5728\u521B\u65B0\u4E2D\u5B88\u672C\u7684\u6838\u5FC3\u7406\u5FF5\u3002\u5B59\u6653\u4E91\u4E3B\u5E2D\u201C\u4EE5\u4F20\u7EDF\u4E3A\u57FA\u3001\u4EE5\u521B\u65B0\u4E3A\u9B42\u201D\u7684\u827A\u672F\u667A\u6167\uFF0C\u53CA\u5176\u201C\u5B88\u6B63\u4E0D\u5B88\u65E7\u3001\u521B\u65B0\u4E0D\u79BB\u6839\u201D\u7684\u521B\u4F5C\u7406\u5FF5\uFF0C\u4E3A\u5F53\u4EE3\u4E66\u6CD5\u53D1\u5C55\u63D0\u4F9B\u4E86\u53EF\u8D44\u501F\u9274\u7684\u5B9E\u8DF5\u8303\u5F0F\u3002\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u4E66\u827A\u603B\u4F1A\u4F1A\u957F\u9EC4\u745E\u5E86\u5728\u53D1\u8A00\u4E2D\u4ECB\u7ECD\u4E86\u9A6C\u6765\u897F\u4E9A\u4E66\u6CD5\u827A\u672F\u7684\u84EC\u52C3\u53D1\u5C55\u3002\u4ED6\u8868\u793A\uFF0C\u4E66\u827A\u603B\u4F1A\u81EA\u6210\u7ACB\u56DB\u5341\u5E74\u6765\uFF0C\u59CB\u7EC8\u81F4\u529B\u4E8E\u5728\u672C\u5730\u5F18\u626C\u4E66\u6CD5\u827A\u672F\u3001\u4F20\u627F\u4E2D\u534E\u6587\u5316\u3002\u672A\u6765\uFF0C\u4E66\u827A\u603B\u4F1A\u5C06\u6301\u7EED\u52A0\u5F3A\u4E0E\u4E2D\u56FD\u4E66\u6CD5\u754C\u7684\u4EA4\u6D41\u5408\u4F5C\uFF0C\u63A8\u52A8\u9A6C\u6765\u897F\u4E9A\u4E66\u6CD5\u827A\u672F\u7684\u8FDB\u4E00\u6B65\u53D1\u5C55\uFF0C\u5E76\u52AA\u529B\u5C06\u9A6C\u6765\u897F\u4E9A\u6253\u9020\u4E3A\u4E1C\u5357\u4E9A\u4E66\u6CD5\u6559\u80B2\u7684\u91CD\u8981\u4E2D\u5FC3\u3002\u003C/p\u003E\n\u003Cp\u003E\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u4E3B\u4EFB\u97E9\u5B81\u8868\u793A\uFF0C\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u81EA\u6210\u7ACB\u4EE5\u6765\u6301\u7EED\u63A8\u52A8\u672C\u5730\u4E66\u6CD5\u666E\u53CA\u4E0E\u4E2D\u9A6C\u4EA4\u6D41\u3002\u4E2D\u5FC3\u8BBE\u7ACB\u4E66\u6CD5\u57F9\u8BAD\u8BFE\u7A0B\uFF0C\u81F3\u4ECA\u7D2F\u8BA1\u57F9\u8BAD\u5B66\u5458\u903E200\u4EBA\uFF1B\u63A8\u52A8\u201C\u6C34\u58A8\u4E66\u6CD5\u8FDB\u6821\u56ED\u201D\uFF0C\u5DF2\u4E3A\u8FD1300\u540D\u5B66\u751F\u8FDB\u884C\u4E66\u6CD5\u4F53\u9A8C\u8BFE\u7A0B\uFF1B\u5728\u6625\u8282\u3001\u7AEF\u5348\u7B49\u8282\u5E86\u671F\u95F4\u8BBE\u7F6E\u4E66\u6CD5\u5C55\u533A\u548C\u4E92\u52A8\u4F53\u9A8C\uFF0C\u7D2F\u8BA1\u5438\u5F15\u5343\u4EBA\u53C2\u4E0E\uFF1B\u540C\u65F6\u8054\u5408\u9A6C\u6765\u897F\u4E9A\u4E66\u827A\u603B\u4F1A\u5171\u540C\u4E3E\u529E\u5C55\u89C8\u4E0E\u8BB2\u5EA7\uFF0C\u63A8\u52A8\u8D44\u6E90\u5171\u4EAB\u4E0E\u7406\u5FF5\u4EA4\u6D41\u3002\u6BCF\u5E744\u6708\u4E3E\u529E\u201C\u5170\u4EAD\u96C5\u96C6\u201D\u6D3B\u52A8\uFF0C\u9080\u8BF7\u4E2D\u9A6C\u4E66\u6CD5\u5BB6\u5171\u540C\u5C55\u6F14\u4E0E\u7814\u8BA8\uFF0C\u6253\u9020\u9AD8\u6C34\u5E73\u5B66\u672F\u5E73\u53F0\u3002\u5979\u8868\u793A\uFF0C\u672A\u6765\u5C06\u5728\u4E2D\u56FD\u4E66\u534F\u7684\u6307\u5BFC\u4E0E\u652F\u6301\u4E0B\uFF0C\u7EE7\u7EED\u6DF1\u5316\u9A6C\u6765\u897F\u4E9A\u4E66\u827A\u603B\u4F1A\u7B49\u5F53\u5730\u827A\u672F\u673A\u6784\u7684\u5408\u4F5C\uFF0C\u8BA9\u4E66\u6CD5\u771F\u6B63\u201C\u5199\u8FDB\u751F\u6D3B\u3001\u8D70\u5165\u4EBA\u5FC3\u201D\uFF0C\u6210\u4E3A\u8FDE\u63A5\u4E24\u56FD\u4EBA\u6C11\u7684\u91CD\u8981\u6587\u5316\u7EBD\u5E26\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/sz_mmbiz_png/KzZqvMiaRfUw1KjsrW7jAfgNex5JWJuY3O1Gn13aqe9A35je4vHUmE51MD1h72fMd8qtwKkpYH2ff00ZnWFWv4w/640?from=appmsg\u0026amp;tp=webp\u0026amp;wxfrom=5\u0026amp;wx_lazy=1\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5B59\u6653\u4E91\u4E3B\u5E2D\u7ED9\u4E2D\u5FC3\u4E24\u4F4D\u4E66\u6CD5\u8001\u5E08\u738B\u96C5\u3001\u90D1\u53C8\u7855\u8D60\u4E66\u003C/p\u003E\n\u003Cp\u003E\u5EA7\u8C08\u4F1A\u73B0\u573A\u8FD8\u8BBE\u6709\u4EA4\u6D41\u73AF\u8282\uFF0C\u4E2D\u9A6C\u4E66\u6CD5\u827A\u672F\u5BB6\u56F4\u7ED5\u201C\u4E66\u6CD5\u7684\u4F20\u7EDF\u7CBE\u795E\u4E0E\u5F53\u4EE3\u521B\u65B0\u201D\u7B49\u8BDD\u9898\u5C55\u5F00\u6DF1\u5165\u8BA8\u8BBA\uFF0C\u5206\u4EAB\u521B\u4F5C\u4F53\u4F1A\u4E0E\u6559\u5B66\u7ECF\u9A8C\uFF0C\u6C14\u6C1B\u70ED\u70C8\uFF0C\u4E92\u52A8\u9891\u7E41\u3002\u4E0E\u4F1A\u5609\u5BBE\u4E00\u81F4\u8BA4\u4E3A\uFF0C\u672C\u6B21\u6D3B\u52A8\u4E0D\u4EC5\u52A0\u6DF1\u4E86\u4E2D\u9A6C\u4E66\u6CD5\u754C\u7684\u76F8\u4E92\u4E86\u89E3\uFF0C\u4E5F\u4E3A\u4E24\u56FD\u4E66\u6CD5\u827A\u672F\u7684\u4EA4\u6D41\u5408\u4F5C\u6CE8\u5165\u4E86\u65B0\u7684\u6D3B\u529B\u3002\u003C/p\u003E\n\u003Cp\u003E\u6D3B\u52A8\u4E2D\uFF0C\u4E2D\u56FD\u4E66\u6CD5\u5BB6\u534F\u4F1A\u4E3B\u5E2D\u5B59\u6653\u4E91\u5C06\u5176\u4E13\u8457\u300A\u4E66\u6CD5\u6709\u6CD5\u300B\u8D60\u9001\u4E88\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u53CA\u4E24\u4F4D\u4E2D\u5FC3\u4E66\u6CD5\u6559\u5E08\u738B\u96C5\u3001\u90D1\u53C8\u7855\uFF0C\u4F5C\u4E3A\u4E2D\u9A6C\u4E66\u6CD5\u6587\u5316\u4EA4\u6D41\u7684\u53CB\u597D\u89C1\u8BC1\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/sz_mmbiz_png/KzZqvMiaRfUw1KjsrW7jAfgNex5JWJuY3iaWFgQ4aoJoAf5Z6q9Uy8Zk8Jib0KGY7vGmNRyibpuBNU7ianqrzKITgiaw/640?wx_fmt=png\u0026amp;from=appmsg\u0026amp;tp=webp\u0026amp;wxfrom=5\u0026amp;wx_lazy=1\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/sz_mmbiz_jpg/KzZqvMiaRfUw1KjsrW7jAfgNex5JWJuY30WCBjvXPrYsJB0KPHxYricg7t2qoLATNHdFBuldKqoicxhm5tq2WCGcA/640?wx_fmt=jpeg\u0026amp;from=appmsg\u0026amp;tp=webp\u0026amp;wxfrom=5\u0026amp;wx_lazy=1\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u4E2D\u56FD\u4E66\u534F\u4EE3\u8868\u56E2\u548C\u5609\u5BBE\u5408\u5F71\u003C/p\u003E\n\u003Cp\u003E\u66F4\u591A\u7CBE\u5F69\uFF0C\u656C\u8BF7\u5173\u6CE8\uFF1A\u003C/p\u003E\n\u003Cp\u003E \u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5B98\u7F51\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\nhttps://www.chinaculturalcentre.my\n\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EFacebook\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u201CChina Cultural Centre in Kuala Lumpur\u201D\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u516C\u4F17\u53F7\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u201C\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u201D\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u00