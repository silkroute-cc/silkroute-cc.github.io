  "canonicalUrlKey": "%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e5%9b%bd%e4%bc%9a%e4%b8%89%e8%af%bb%e9%80%9a%e8%bf%87%c2%b7%e5%88%a9%e6%97%85%e6%b8%b8%e6%88%bf%e5%9c%b0%e4%ba%a7-%e6%a3%ae%e6%9e%97%e5%9f%8e%e5%b8%82%e7%ac%ac",
  "route": "/4955/",
  "title": "\u9A6C\u6765\u897F\u4E9A\u56FD\u4F1A\u4E09\u8BFB\u901A\u8FC7\u00B7\u5229\u65C5\u6E38\u623F\u5730\u4EA7 \u68EE\u6797\u57CE\u5E02\u7B2C\u4E00\u5C9B\u5217\u514D\u7A0E\u533A",
  "summary": "\u9A6C\u65B0\u793E \u62A5\u9053\uFF1A\u738B\u8FDE\u8D1E \uFF08\u5409\u9686\u576117\u65E5\u8BAF\uFF09\u56FD\u4F1A\u4E0B\u8BAE\u9662\u4ECA\u65E5\u901A\u8FC7\u628A\u67D4\u4F5B\u78A7\u6842\u56ED\u68EE\u6797\u57CE\u5E02\u7B2C\u4E00\u5C9B\uFF08Pulau Satu\uFF09\u5217\u4E3A\u514D\u7A0E\u5C9B\uFF0C\u623F\u5730\u4EA7\u4E1A\u754C\u4EBA\u58EB\u9884\u8BA1\u8FD9\u6709\u52A9\u4FC3\u8FDB\u65C5\u6E38\u4E1A\uFF0C\u5E76\u521B\u9020\u6EA2\u51FA\u6548\u5E94\uFF0C\u8FDB\u800C\u60E0\u53CA\u67D4\u4F5B\u5DDE\u623F\u5730\u4EA7\u5E02\u573A\u3002 \u56FD\u4F1A\u4E0B\u8BAE\u9662\u662F\u4E09\u8BFB\u901A\u8FC7\u8D22\u653F\u90E8\u76845\u9879\u6CD5\u6848\uFF0C\u4EE5\u628A\u68EE\u6797\u57CE\u5E02\u7B2C\u4E00\u5C9B\u4ECE\u4E3B\u8981\u5173\u7A0E\u5C9B\u540D\u5355\u4E2D\u79FB\u9664\uFF0C\u5E76\u6B63\u5F0F\u6210\u4E3A\u514D\u7A0E\u5C9B\u3002 \u8FD95\u9879\u6CD5\u6848\u5206\u522B\u4E3A2024\u5E74\u5173\u7A0E\u4FEE\u6B63\u6CD5\u6848\u30012024\u5E74\u9500\u552E\u7A0E\u6CD5\u6848\u30012024\u5E74\u670D\u52A1\u7A0E\u6CD5\u6848\u30012024\u5E74\u81EA\u7531\u533A\u4FEE\u6B63\u6CD5\u6848\u53CA2024\u5E74\u6D88\u8D39\u7A0E\u6CD5\u6848\u3002 \u5927\u9A6C\u623F\u5730\u4EA7\u53D1\u5C55\u5546\u4F1A\uFF08RE\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/07/frc-2b79915131e15115a946406406e03d67.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u9A6C\u65B0\u793E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u62A5\u9053\uFF1A\u738B\u8FDE\u8D1E\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\uFF08\u5409\u9686\u576117\u65E5\u8BAF\uFF09\u56FD\u4F1A\u4E0B\u8BAE\u9662\u4ECA\u65E5\u901A\u8FC7\u628A\u67D4\u4F5B\u78A7\u6842\u56ED\u68EE\u6797\u57CE\u5E02\u7B2C\u4E00\u5C9B\uFF08Pulau Satu\uFF09\u5217\u4E3A\u514D\u7A0E\u5C9B\uFF0C\u623F\u5730\u4EA7\u4E1A\u754C\u4EBA\u58EB\u9884\u8BA1\u8FD9\u6709\u52A9\u4FC3\u8FDB\u65C5\u6E38\u4E1A\uFF0C\u5E76\u521B\u9020\u6EA2\u51FA\u6548\u5E94\uFF0C\u8FDB\u800C\u60E0\u53CA\u67D4\u4F5B\u5DDE\u623F\u5730\u4EA7\u5E02\u573A\u3002\u003C/p\u003E\n\u003Cp\u003E\u56FD\u4F1A\u4E0B\u8BAE\u9662\u662F\u4E09\u8BFB\u901A\u8FC7\u8D22\u653F\u90E8\u76845\u9879\u6CD5\u6848\uFF0C\u4EE5\u628A\u68EE\u6797\u57CE\u5E02\u7B2C\u4E00\u5C9B\u4ECE\u4E3B\u8981\u5173\u7A0E\u5C9B\u540D\u5355\u4E2D\u79FB\u9664\uFF0C\u5E76\u6B63\u5F0F\u6210\u4E3A\u514D\u7A0E\u5C9B\u3002\u003C/p\u003E\n\u003Cp\u003E\u8FD95\u9879\u6CD5\u6848\u5206\u522B\u4E3A2024\u5E74\u5173\u7A0E\u4FEE\u6B63\u6CD5\u6848\u30012024\u5E74\u9500\u552E\u7A0E\u6CD5\u6848\u30012024\u5E74\u670D\u52A1\u7A0E\u6CD5\u6848\u30012024\u5E74\u81EA\u7531\u533A\u4FEE\u6B63\u6CD5\u6848\u53CA2024\u5E74\u6D88\u8D39\u7A0E\u6CD5\u6848\u3002\u003C/p\u003E\n\u003Cp\u003E\u5927\u9A6C\u623F\u5730\u4EA7\u53D1\u5C55\u5546\u4F1A\uFF08REHDA\uFF09\u67D4\u4F5B\u5DDE\u4E3B\u5E2D\u9648\u4F36\u4FD0\u4E3A\u6B64\u63A5\u53D7\u300A\u5357\u6D0B\u5546\u62A5\u300B\u8BBF\u95EE\u65F6\u8BF4\uFF0C\u8BE5\u7B2C\u4E00\u5C9B\u7684\u53D1\u5C55\u53EF\u5BF9\u67D4\u4F5B\u5468\u8FB9\u5730\u533A\u4EA7\u751F\u6EA2\u51FA\u6548\u5E94\uFF0C\u523A\u6FC0\u5168\u5DDE\u8303\u56F4\u5185\u7684\u7269\u4E1A\u9700\u6C42\uFF0C\u4E3A\u5F53\u5730\u623F\u5730\u4EA7\u5E02\u573A\u521B\u9020\u5F3A\u52B2\u800C\u79EF\u6781\u7684\u524D\u666F\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E00\u822C\u9884\u8BA1\uFF0C\u6B64\u4E3E\u6709\u52A9\u68EE\u6797\u57CE\u5E02\u6446\u8131\u88AB\u6307\u4E3A\u201C\u9B3C\u57CE\u201D\u7684\u6076\u540D\uFF0C\u540C\u65F6\u523A\u6FC0\u5F53\u5730\u7ECF\u6D4E\u6D3B\u52A8\uFF0C\u800C\u5728\u4ECA\u5E749\u6708\u67D4\u4F5B\u65B0\u52A0\u5761\u7ECF\u6D4E\u7279\u533A\uFF08SEZ\uFF09\u548C\u91D1\u878D\u7279\u533A\uFF08SFZ\uFF09\u534F\u8BAE\u7684\u7B7E\u7EA6\u7EC6\u8282\u51FA\u7089\u540E\uFF0C\u9884\u8BA1\u66F4\u591A\u597D\u6D88\u606F\u4F1A\u63A5\u8E35\u800C\u6765\uFF0C\u8FDB\u4E00\u6B65\u63D0\u5347\u67D4\u4F5B\u5BF9\u4F01\u4E1A\u548C\u6295\u8D44\u8005\u7684\u5438\u5F15\u529B\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/07/frc-a1f0b36a2031170e751acb3bfb6ac631.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/07/frc-1d6a15c0129cecca47f54ea7916b1519.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u9648\u4F36\u4FD0\uFF08\u672C\u62A5\u6863\u6848\u7167\uFF09\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u9648\u4F36\u4FD0\uFF1A\u5E26\u52A8\u533A\u57DF\u623F\u4EA7\u9700\u6C42\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u5927\u9A6C\u623F\u5730\u4EA7\u53D1\u5C55\u5546\u4F1A\u67D4\u4F5B\u5DDE\u4E3B\u5E2D\u9648\u4F36\u4FD0\u9884\u8BA1\uFF0C\u68EE\u6797\u57CE\u5E02\u7B2C\u4E00\u5C9B\u514D\u7A0E\u5730\u4F4D\u6700\u5148\u80FD\u5E26\u52A8\u7684\u662F\u68EE\u6797\u57CE\u5E02\u7684\u4F01\u4E1A\u6D3B\u52A8\uFF0C\u518D\u6765\u662F\u65C5\u6E38\u4E1A\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u8FD9\u65E0\u7591\u5C06\u901A\u8FC7\u5438\u5F15\u66F4\u591A\u6E38\u5BA2\u3001\u6295\u8D44\u8005\u548C\u4F01\u4E1A\uFF0C\u8FDB\u4E00\u6B65\u4FC3\u8FDB\u5F53\u5730\u7ECF\u6D4E\u53D1\u5C55\uFF0C\u5E76\u5E26\u52A8\u533A\u57DF\u5185\u623F\u4EA7\u9700\u6C42\u2026\u2026\u7B2C\u4E00\u5C9B\u7684\u4F4D\u7F6E\u4E5F\u6BD4\u8F83\u9760\u8FD1\u67D4\u4F5B\uFF0C\u5C06\u4F1A\u5E26\u52A8\u5468\u8FB9\u7ECF\u6D4E\u6D3B\u52A8\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u5979\u5411\u300A\u5357\u6D0B\u5546\u62A5\u300B\u6307\u51FA\uFF0C\u66F4\u591A\u7684\u514D\u7A0E\u533A\u5C06\u53EF\u5E26\u52A8\u672C\u5730\u7ECF\u6D4E\u52A8\u8109\uFF0C\u5982\u65C5\u6E38\u4E1A\u3001\u5546\u8D38\u6D3B\u52A8\u7B49\uFF0C\u6574\u4F53\u6765\u770B\u662F\u826F\u597D\u53D1\u5C55\u8D8B\u52BF\u3002\u4F5C\u4E3A\u53D1\u5C55\u5546\uFF0C\u5979\u4EE5\u6B63\u9762\u89D2\u5EA6\u770B\u5F85\u6B64\u4E8B\u3002\u003C/p\u003E\n\u003Cp\u003E\u9648\u4F36\u4FD0\u6307\u76EE\u524D\u8FD8\u6CA1\u770B\u5230\u6709\u5173\u7684\u623F\u5730\u4EA7\u653F\u7B56\uFF0C\u8BE5\u516C\u4F1A\u8FD8\u5728\u7B49\u5F85\u653F\u5E9C\u91CA\u653E\u66F4\u591A\u6D88\u606F\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/07/frc-03530b4999e0af906a97fd9552426e5b.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u674E\u5EF7\u6C49\uFF08\u672C\u62A5\u6863\u6848\u7167\uFF09\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u674E\u5EF7\u6C49\u6599\u5E74\u676A\u516C\u5E03\u8BE6\u60C5\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u8D1F\u8D23\u67D4\u5DDE\u6295\u8D44\u3001\u5546\u8D38\u4E0E\u6D88\u8D39\u4EBA\u4E8B\u52A1\u7684\u884C\u653F\u8BAE\u5458\u674E\u5EF7\u6C49\u9884\u8BA1\uFF0C\u5F53\u5C40\u4F1A\u5728\u4ECA\u5E74\u676A\u516C\u5E03\u68EE\u6797\u57CE\u5E02\u6210\u4E3A\u91D1\u878D\u7279\u533A\u7684\u8BE6\u60C5\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u67D4\u4F5B\u5DDE\u653F\u5E9C\u5728\u8FC7\u53BB\u4E00\u5E74\u79EF\u6781\u4E0E\u8054\u90A6\u653F\u5E9C\u78CB\u5546\u6709\u5173\u9996\u76F8\u62FF\u7763\u65AF\u91CC\u5B89\u534E\u5BA3\u5E03\u68EE\u6797\u57CE\u5E02\u6210\u4E3A\u91D1\u878D\u7279\u533A\u7684\u4E8B\u9879\uFF0C\u800C\u6210\u4E3A\u514D\u7A0E\u5C9B\u4E5F\u662F\u534F\u52A9\u5B9E\u73B0\u91D1\u878D\u7279\u533A\u653F\u7B56\u7684\u4E00\u90E8\u5206\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6307\u51FA\uFF0C\u68EE\u6797\u57CE\u5E02\u4E8E2016\u5E74\u5F00\u5E55\u65F6\uFF0C\u5C31\u5DF2\u88AB\u653F\u5E9C\u89C4\u5212\u4E3A\u514D\u7A0E\u5C9B\uFF0C\u4EE5\u52A0\u5F3A\u5176\u5728\u5438\u5F15\u5305\u62EC\u533B\u7597\u3001\u65C5\u6E38\u3001\u56FD\u9645\u6559\u80B2\u7B49\u65B9\u9762\u7684\u6295\u8D44\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u68EE\u6797\u57CE\u5E02\u76EE\u524D\u4E5F\u5728\u52A0\u5FEB\u4FEE\u5EFA\u76F8\u5173\u5173\u5361\u8BBE\u65BD\uFF0C\u9884\u8BA1\u4E0B\u4E2A\u6708\u5B8C\u5DE5\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u76F8\u4FE1\u672C\u6B21\u4FEE\u6B63\u6848\uFF0C\u53EF\u589E\u52A0\u68EE\u6797\u57CE\u5E02\u7684\u7ADE\u4E89\u529B\uFF0C\u8BA9\u5B83\u4E0D\u4EC5\u662F\u4E00\u4E2A\u623F\u5730\u4EA7\u5F00\u53D1\u9879\u76EE\uFF0C\u800C\u662F\u534F\u52A9\u5168\u65B9\u4F4D\u7684\u53D1\u5C55\u65B9\u5411\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u6797\u6167\u82F1\uFF1A\u4E3A\u5927\u9A6C\u9020\u65B0\u5438\u5F15\u529B\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u8D22\u653F\u90E8\u526F\u90E8\u957F\u6797\u6167\u82F1\u4ECA\u65E5\u5728\u56FD\u4F1A\u4E0B\u8BAE\u9662\u4E3A2024\u5E74\u5173\u7A0E\u4FEE\u6B63\u6CD5\u6848\u8FDB\u884C\u603B\u7ED3\u65F6\u5F3A\u8C03\uFF0C\u8FD9\u4FEE\u6B63\u6848\u65E8\u5728\u4FC3\u8FDB\u68EE\u6797\u57CE\u5E02\u7B2C\u4E00\u5C9B\u7684\u7ECF\u6D4E\u53D1\u5C55\uFF0C\u540C\u65F6\u5584\u7528\u65B0\u52A0\u5761\u7ECF\u6D4E\u6EA2\u51FA\u7684\u673A\u4F1A\uFF0C\u4E3A\u5927\u9A6C\u548C\u56FD\u9645\u793E\u4F1A\u521B\u9020\u65B0\u7684\u5438\u5F15\u529B\u3002\u003C/p\u003E\n\u003Cp\u003E\u968F\u7740\u901A\u8FC7\u76F8\u5173\u6CD5\u6848\uFF0C\u68EE\u6797\u57CE\u5E02\u7B2C\u4E00\u5C9B\u5C06\u4E0D\u518D\u5C5E\u4E8E\u4E3B\u8981\u5173\u7A0E\u533A\uFF0C\u800C\u662F\u4E0E\u6D6E\u7F57\u4EA4\u6021\u3001\u7EB3\u95FD\u3001\u5201\u66FC\u5C9B\u548C\u90A6\u54AF\u5C9B\u5E76\u5217\u4E3A\u514D\u7A0E\u5C9B\u3002\u003C/p\u003E\n\u003Cp\u003E\u53E64\u9879\u6CD5\u6848\u5219\u65E8\u5728\u4E3A\u534F\u8C032024\u5E74\u5173\u7A0E\u4FEE\u6B63\u6CD5\u6848\uFF0C\u628A\u68EE\u6797\u57CE\u5E02\u7B2C\u4E00\u5C9B\u4ECE\u4E3B\u8981\u5173\u7A0E\u5C9B\u540D\u5355\u4E2D\u79FB\u9664\u800C\u5C55\u5F00\u4FEE\u6B63\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u9996\u76F8\u53BB\u5E74\u5BA3\u5E03\u5217\u91D1\u878D\u7279\u533A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u9996\u76F8\u62FF\u7763\u65AF\u91CC\u5B89\u534E\u662F\u4E8E\u53BB\u5E748\u670825\u65E5\u5BA3\u5E03\u628A\u68EE\u6797\u57CE\u5E02\u5217\u4E3A\u91D1\u878D\u7279\u533A\uFF0C\u4EE5\u52A0\u5F3A\u7ADE\u4E89\u529B\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ECA\u5E744\u670824\u65E5\uFF0C\u68EE\u6797\u57CE\u5E02\u7ECF\u5178\u7403\u573A\u518D\u5165\u9009\u201C\u4E9A\u6D32\u767E\u4F73\u7403\u573A\u201D\uFF0C\u662F\u7EE72020\u5E74\u6765\u8FDE\u7EED5\u5E74\u5165\u9009\uFF0C\u88AB\u67D4\u4F5B\u65C5\u6E38\u5C40\u8BC4\u9009\u4E3A\u201C\u67D4\u4F5B\u5DDE\u6700\u4F73\u9AD8\u5C14\u592B\u65C5\u6E38\u76EE\u7684\u201D\u3002\u003C/p\u003E\n\u003Cp\u003E\u636E\u8D44\u6599\uFF0C\u4F4D\u4E8E\u67D4\u4F5B\u4F9D\u65AF\u5E72\u8FBE\u7ECF\u6D4E\u7279\u533A\u7684\u68EE\u6797\u57CE\u5E02\uFF0C\u4E0E\u65B0\u52A0\u5761\u76F4\u7EBF\u8DDD\u79BB\u4EC52\u516C\u91CC\uFF0C\u80CC\u9760\u4E9A\u6D32\u6700\u65E9\u6210\u7ACB\u7684\u5DE5\u4E1A\u533A-\u65B0\u52A0\u5761\u88D5\u5ECA\u5DE5\u4E1A\u533A\uFF0C\u662F\u6700\u63A5\u8FD1\u65B0\u52A0\u5761\u7684\u5927\u9A6C\u5730\u6BB5\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E5F\u6709\u62A5\u9053\u5F15\u8FF0\u6D88\u606F\u6307\u4E2D\u56FD\u53D1\u5C55\u5546\u78A7\u6842\u56ED\u56E0\u503A\u52A1\u5371\u673A\u52A0\u5267\uFF0C\u5BFC\u81F4\u68EE\u6797\u57CE\u5E02\u9677\u5165\u505C\u6EDE\u4E0D\u524D\u7684\u72B6\u6001\u3002\u003C/p\u003E\n\u003Cp\u003E\u636E\u62A5\u9053\uFF0C\u78A7\u6842\u56ED\u66FE\u88AB\u89C6\u4E3A\u4E2D\u56FD\u623F\u5730\u4EA7\u5E02\u573A\u7684\u7A33\u5B9A\u53C2\u4E0E\u8005\uFF0C\u4F46\u622A\u81F32022\u5E74\u5E95\u8D1F\u503A2000\u4EBF\u7F8E\u5143\uFF0C\u53BB\u5E7410\u6708\u5728\u79BB\u5CB8\u503A\u52A1\u652F\u4ED8\u4E0A\u6D89\u5ACC\u8FDD\u7EA6\uFF0C\u4ECA\u5E74\u9762\u4E34\u5728\u9999\u6E2F\u7684\u6E05\u76D8\u7533\u8BF7\u3002\u76EE\u524D\u5DF2\u5EF6\u671F\u81F37\u6708\u5E95\u91CD\u7EC4\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\