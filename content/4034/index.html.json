  "title": "\u4E2D\u56FD\u534E\u897F\u7B7E\u8BA2\u9A6C\u6765\u897F\u4E9A\u65B0\u5C71\u666E\u5E73\u6570\u636E\u4E2D\u5FC3\u4E00\u671F\u9879\u76EE\u5408\u540C",
  "summary": "\u666E\u5E73\u6570\u636E\u96C6\u56E2\uFF08PDG\uFF09\u662F\u4E9A\u6D32\u9886\u5148\u6570\u636E\u4E2D\u5FC3\u63D0\u4F9B\u5546\uFF0C\u57285\u4E2A\u56FD\u5BB6\u5EFA\u7ACB\u4E8620\u4E2A\u6570\u636E\u4E2D\u5FC3\u3002\u5728\u5BF9\u63A5\u4F1A\u524D\uFF0C\u4E2D\u56FD\u534E\u897F\u515A\u59D4\u4E66\u8BB0\u8463\u4E8B\u957F\u5218\u56FD\u5448\u4E0E\u666E\u5E73\u6570\u636E\u96C6\u56E2\u4E1A\u4E3B\u4EE3\u8868\u6797\u4E2D\u6770\u8FDB\u884C\u4E86\u53CB\u597D\u4EA4\u8C08\uFF0C\u5218\u56FD\u5448\u8463\u4E8B\u957F\u8868\u793A\uFF1A\u4E2D\u56FD\u534E\u897F\u6BCD\u516C\u53F8\u56DB\u5DDD\u534E\u897F\u96C6\u56E2\u5728 \u65B0\u578B\u57FA\u7840\u8BBE\u65BD\u5EFA\u8BBE\u3001\u673A\u573A\u5EFA\u8BBE\u3001\u8D85\u9AD8\u6784\u7B51\u7269\u3001\u5DE5\u4E1A\u5382\u623F\u3001\u8BBE\u5907\u5B89\u88C5\u7B49 \u591A\u4E2A\u9886\u57DF\u4F18\u52BF\u7A81\u51FA\u3001\u6A21\u5F0F\u9886\u5148\uFF0C\u53CC\u65B9\u53EF\u5728\u591A\u9886\u57DF\u591A\u73AF\u8282\u8FBE\u6210\u5408\u4F5C\uFF1B\u4E2D\u56FD\u534E\u897F\u4E0E\u666E\u5E73\u6570\u636E\u96C6\u56E2\u662F\u547D\u8FD0\u5408\u4F5C\u5171\u540C\u4F53\uFF0C\u53CC\u65B9\u8981\u771F\u8BDA\u5408\u4F5C\uFF0C\u643A\u624B\u5171\u521B\u4E92\u60E0\u4E92\u5229\u5408\u4F5C\u5171\u8D62\u7684\u7F8E\u597D\u672A\u6765\u3002\u666E\u5E73\u6570\u636E\u96C6\u56E2\u4E1A\u4E3B\u4EE3\u8868\u6797\u4E2D\u6770\u8868\u793A\uFF1A\u666E\u5E73\u6570\u636E\u96C6\u56E2\u4F1A\u548C\u4E2D\u56FD\u534E\u2026",
