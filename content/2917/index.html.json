  "title": "\u96EA\u5170\u83AA\u7684\u5E03\u7F57\u52A0\u5C71",
  "summary": "\u5E03\u7F57\u52A0\u5C71\u662F\u8FDC\u8DB3\u8005\u975E\u5E38\u63A8\u5D07\u7684\u5730\u65B9\uFF0C\u662F\u4E0E\u670B\u53CB\u4E00\u8D77\u4EAB\u53D7\u5468\u672B\u8FDC\u8DB3\u65C5\u884C\u5E76\u8FDC\u79BB\u57CE\u5E02\u55A7\u56A3\u7684\u597D\u5730\u65B9\u3002400 \u7C73\u9AD8\u7684\u5E03\u7F57\u52A0\u5C71\u4E3A\u5F92\u6B65\u65C5\u884C\u8005\u63D0\u4F9B\u4E86\u4E00\u6B21\u4F18\u96C5\u7684\u5192\u9669\u4E4B\u65C5\uFF0C\u53EF\u4EE5\u5728\u5C71\u9876\u4FEF\u77B0\u5929\u9645\u7EBF\u7684\u7F8E\u4E3D\u3002 \u76EE\u524D\u6709\u4E24\u6761\u5C0F\u5F84\u5411\u516C\u4F17\u5F00\u653E\uFF0C\u5176\u4E2D\u4E00\u6761\u9700\u8981\u5F92\u6B65\u65C5\u884C\u8005\u6500\u767B\u66F4\u9661\u5CED\u7684\u8DEF\u5F84\uFF0C\u4F46\u957F\u5EA6\u6BD4\u53E6\u4E00\u6761\u77ED\u3002\u6709\u4E09\u4E2A\u89C2\u666F\u70B9\uFF1A880 \u82F1\u5C3A\u30011150 \u82F1\u5C3A\u548C1312 \u82F1\u5C3A\u5904\u3002\u5927\u591A\u6570\u5F92\u6B65\u65C5\u884C\u8005\u4F1A\u5728\u6E05\u6668\u5F00\u59CB\u5F92\u6B65\u65C5\u884C\uFF0C\u4EE5\u4FBF\u4ECE\u5C71\u9876\u6B23\u8D4F\u7F8E\u4E3D\u7684\u65E5\u51FA\u666F\u8272\u3002\u4E0D\u8981\u5FD8\u8BB0\u643A\u5E26\u624B\u7535\u7B52\u548C\u767B\u5C71\u978B\u4EE5\u786E\u4FDD\u8212\u9002\u7684\u5F92\u6B65\u65C5\u884C\u3002 \u4E00\u65E6\u5F92\u6B65\u65C5\u884C\u8005\u2026",
  "body": "\u003Cp\u003E\u5E03\u7F57\u52A0\u5C71\u662F\u8FDC\u8DB3\u8005\u975E\u5E38\u63A8\u5D07\u7684\u5730\u65B9\uFF0C\u662F\u4E0E\u670B\u53CB\u4E00\u8D77\u4EAB\u53D7\u5468\u672B\u8FDC\u8DB3\u65C5\u884C\u5E76\u8FDC\u79BB\u57CE\u5E02\u55A7\u56A3\u7684\u597D\u5730\u65B9\u3002400 \u7C73\u9AD8\u7684\u5E03\u7F57\u52A0\u5C71\u4E3A\u5F92\u6B65\u65C5\u884C\u8005\u63D0\u4F9B\u4E86\u4E00\u6B21\u4F18\u96C5\u7684\u5192\u9669\u4E4B\u65C5\uFF0C\u53EF\u4EE5\u5728\u5C71\u9876\u4FEF\u77B0\u5929\u9645\u7EBF\u7684\u7F8E\u4E3D\u3002\n\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/mmbiz_jpg/JsSxkvuj1TEzCZlmfqkwhFfKREhZN3fUhj4VrqnQcn4LxTjW6rDvlzqTp2mFyWvx07fOP1tGlsfqTttJDyMuNA/640?wx_fmt=jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u76EE\u524D\u6709\u4E24\u6761\u5C0F\u5F84\u5411\u516C\u4F17\u5F00\u653E\uFF0C\u5176\u4E2D\u4E00\u6761\u9700\u8981\u5F92\u6B65\u65C5\u884C\u8005\u6500\u767B\u66F4\u9661\u5CED\u7684\u8DEF\u5F84\uFF0C\u4F46\u957F\u5EA6\u6BD4\u53E6\u4E00\u6761\u77ED\u3002\u6709\u4E09\u4E2A\u89C2\u666F\u70B9\uFF1A880 \u82F1\u5C3A\u30011150 \u82F1\u5C3A\u548C1312 \u82F1\u5C3A\u5904\u3002\u5927\u591A\u6570\u5F92\u6B65\u65C5\u884C\u8005\u4F1A\u5728\u6E05\u6668\u5F00\u59CB\u5F92\u6B65\u65C5\u884C\uFF0C\u4EE5\u4FBF\u4ECE\u5C71\u9876\u6B23\u8D4F\u7F8E\u4E3D\u7684\u65E5\u51FA\u666F\u8272\u3002\u4E0D\u8981\u5FD8\u8BB0\u643A\u5E26\u624B\u7535\u7B52\u548C\u767B\u5C71\u978B\u4EE5\u786E\u4FDD\u8212\u9002\u7684\u5F92\u6B65\u65C5\u884C\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E00\u65E6\u5F92\u6B65\u65C5\u884C\u8005\u5230\u8FBE\u5C71\u9876\uFF0C\u8FD9\u5EA7\u5C71\u5C31\u4F1A\u4E3A\u4F60\u5C55\u73B0\u72EC\u7279\u7684\u98CE\u666F\u3002\u5E03\u7F57\u52A0\u5C71\u7684\u5C71\u9876\u957F\u6EE1\u4E86\u957F\u8349\uFF0C\u770B\u4E0D\u5230\u9AD8\u5927\u7684\u6811\u836B\u3002\u5E7F\u9614\u7684\u7EFF\u8272\u5C71\u9876\u548C\u6E29\u548C\u7684\u98CE\u4E3A\u6240\u6709\u5F81\u670D\u8005\u63D0\u4F9B\u4E86\u4E00\u79CD\u795E\u5947\u7684\u611F\u89C9\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/mmbiz_jpg/JsSxkvuj1TEzCZlmfqkwhFfKREhZN3fUwGicDiaIuDyWtFsiadsLt0uydfS2VdsZpA6Ax6WiaibCQVQ1ejts88xDOOA/640?wx_fmt=jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5982\u679C\u60F3\u8FC7\u591C\uFF0C\u53EF\u4EE5\u53BB\u9644\u8FD1\u7684\u5929\u5802\u8C37\u5EA6\u5047\u6751\u3002\u7F6E\u8EAB\u4E8E\u51C9\u723D\u5B81\u9759\u7684\u5E03\u7F57\u52A0\u5C71\uFF0C\u6E38\u5BA2\u53EF\u4EE5\u5728\u90A3\u91CC\u4EAB\u53D7\u5404\u79CD\u4EE4\u4EBA\u632F\u594B\u7684\u4F11\u95F2\u6D3B\u52A8\u548C\u6E38\u620F\uFF0C\u5982\u9732\u8425\u3001\u7EF3\u964D\u3001\u76AE\u5212\u8247\u3001\u81EA\u884C\u8F66\u548C\u6500\u5CA9\u7B49\u7B49\u3002\u003C/p\u003E\n\u003Cp\u003E\u8FD8\u6709\u6C34\u679C\u519C\u573A\u4F9B\u6E38\u5BA2\u4EAB\u7528\u70ED\u5E26\u6C34\u679C\uFF0C\u5305\u62EC\u83E0\u841D\u871C\u548C\u767E\u9999\u679C\u7B49\u3002\u5929\u5802\u8C37\u5EA6\u5047\u6751\u7EDD\u5BF9\u662F\u4E0E\u5BB6\u4EBA\u548C\u670B\u53CB\u4E00\u8D77\u4EAB\u53D7\u5145\u6EE1\u4E50\u8DA3\u7684\u5047\u671F\uFF0C\u6216\u4EAB\u53D7\u6D6A\u6F2B\u871C\u6708\uFF0C\u751A\u81F3\u4E3E\u529E\u4F01\u4E1A\u56E2\u961F\u5EFA\u8BBE\u548C\u751F\u65E5\u5E86\u795D\u6D3B\u52A8\u7684\u597D\u5730\u65B9\u3002 \u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/mmbiz_jpg/JsSxkvuj1TGsZq0JlhqhS2DjfYFdHKdKIkQiaEUMI6CwfJX2s9wcP1uDPPA7n03YNWMpYwQQPhFNric7RS8M7zbA/640?wx_fmt=jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u66F4\u591A\u8D44\u8BAF\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u56FD\u5BB6\u65C5\u6E38\u5C40\u5B98\u65B9\u7F51\u7AD9\uFF1A\u003C/p\u003E\n\u003Cp\u003Ewww.tourism.gov.my\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u56FD\u5BB6\u65C5\u6E38\u5C40\u5B98\u65B9\u5FAE\u535A\uFF1A\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38\u5C40\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u56FD\u5BB6\u65C5\u6E38\u5C40\u5B98\u65B9\u5FAE\u4FE1\u516C\u4F17\u53F7\uFF1A\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38\u5C40\u003C/