{
  "id": "%e6%b7%b1%e5%9c%b3%e6%9c%ba%e5%9c%ba%e5%bc%80%e9%80%9a%e8%87%b3%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e8%b4%a7%e8%bf%90%e8%88%aa%e7%ba%bf",
  "slug": "%e6%b7%b1%e5%9c%b3%e6%9c%ba%e5%9c%ba%e5%bc%80%e9%80%9a%e8%87%b3%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e8%b4%a7%e8%bf%90%e8%88%aa%e7%ba%bf",
  "canonicalUrlKey": "%e6%b7%b1%e5%9c%b3%e6%9c%ba%e5%9c%ba%e5%bc%80%e9%80%9a%e8%87%b3%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e8%b4%a7%e8%bf%90%e8%88%aa%e7%ba%bf",
  "route": "/4638/",
  "title": "\u6DF1\u5733\u673A\u573A\u5F00\u901A\u81F3\u9A6C\u6765\u897F\u4E9A\u8D27\u8FD0\u822A\u7EBF",
  "summary": "\uFF08\u8BB0\u8005 \u9648\u53D1\u6E05 \u901A\u8BAF\u5458 \u8096\u96E8\u8587 \u8A79\u7490\u534E \u6587/\u56FE\uFF09\u8FD1\u65E5\uFF0C\u9A6C\u6765\u897F\u4E9A\u4E16\u754C\u8D27\u8FD0\u822A\u7A7A\u4E00\u67B6B738\u5168\u8D27\u673A\u4ECE\u6DF1\u5733\u673A\u573A\u98DE\u5F80\u53E4\u664B\uFF0C\u8FD9\u662F\u7EE7\u6DF1\u5733\u2014\u5E03\u8FBE\u4F69\u65AF\u5B9A\u671F\u8D27\u8FD0\u822A\u7EBF\u540E\uFF0C\u6DF1\u5733\u673A\u573A\u4ECA\u5E74\u65B0\u5F00\u7684\u7B2C\u4E8C\u6761\u56FD\u9645\u8D27\u8FD0\u822A\u7EBF\u3002\u8BE5\u822A\u7EBF\u5F00\u901A\u540E\uFF0C\u6DF1\u5733\u673A\u573A\u56FD\u5185\u5916\u8D27\u8FD0\u822A\u7EBF\u901A\u822A\u70B9\u8FBE\u523060\u4E2A\uFF0C\u201C\u5168\u7403123\u5FEB\u8D27\u7269\u6D41\u5708\u201D\u6253\u9020\u521D\u89C1\u89C4\u6A21\uFF0C\u5C06\u4E3A\u6DF1\u5733\u52A0\u5FEB\u5EFA\u8BBE\u5177\u6709\u5168\u7403\u91CD\u8981\u5F71\u54CD\u529B\u7684\u7269\u6D41\u4E2D\u5FC3\u548C\u5730\u533A\u7ECF\u6D4E\u793E\u4F1A\u53D1\u5C55\u63D0\u4F9B\u652F\u6491\u548C\u52A8\u529B\u3002 \u636E\u4E86\u89E3\uFF0C\u53E4\u664B\u662F\u9A6C\u6765\u897F\u4E9A\u7802\u62C9\u8D8A\u5DDE\u9996\u5E9C\uFF0C\u4E5F\u662F\u4E1C\u9A6C\u6765\u897F\u4E9A\u6700\u5927\u7684\u57CE\u5E02\u3002\u8BE5\u822A\u7EBF\u6BCF\u5468\u51FA\u6E2F3\u73ED\uFF0C\u6BCF\u5468\u51FA\u6E2F\u8FD0\u529B60\u5428\u4EE5\u4E0A\uFF0C\u4E3B\u8981\u627F\u2026",
  "body": "\u003Cp\u003E\u3000\u3000\uFF08\u8BB0\u8005 \u9648\u53D1\u6E05 \u901A\u8BAF\u5458 \u8096\u96E8\u8587 \u8A79\u7490\u534E \u6587/\u56FE\uFF09\u8FD1\u65E5\uFF0C\u9A6C\u6765\u897F\u4E9A\u4E16\u754C\u8D27\u8FD0\u822A\u7A7A\u4E00\u67B6B738\u5168\u8D27\u673A\u4ECE\u6DF1\u5733\u673A\u573A\u98DE\u5F80\u53E4\u664B\uFF0C\u8FD9\u662F\u7EE7\u6DF1\u5733\u2014\u5E03\u8FBE\u4F69\u65AF\u5B9A\u671F\u8D27\u8FD0\u822A\u7EBF\u540E\uFF0C\u6DF1\u5733\u673A\u573A\u4ECA\u5E74\u65B0\u5F00\u7684\u7B2C\u4E8C\u6761\u56FD\u9645\u8D27\u8FD0\u822A\u7EBF\u3002\u8BE5\u822A\u7EBF\u5F00\u901A\u540E\uFF0C\u6DF1\u5733\u673A\u573A\u56FD\u5185\u5916\u8D27\u8FD0\u822A\u7EBF\u901A\u822A\u70B9\u8FBE\u523060\u4E2A\uFF0C\u201C\u5168\u7403123\u5FEB\u8D27\u7269\u6D41\u5708\u201D\u6253\u9020\u521D\u89C1\u89C4\u6A21\uFF0C\u5C06\u4E3A\u6DF1\u5733\u52A0\u5FEB\u5EFA\u8BBE\u5177\u6709\u5168\u7403\u91CD\u8981\u5F71\u54CD\u529B\u7684\u7269\u6D41\u4E2D\u5FC3\u548C\u5730\u533A\u7ECF\u6D4E\u793E\u4F1A\u53D1\u5C55\u63D0\u4F9B\u652F\u6491\u548C\u52A8\u529B\u3002\u003C/p\u003E\n\u003Cp\u003E\u3000\u3000\u636E\u4E86\u89E3\uFF0C\u53E4\u664B\u662F\u9A6C\u6765\u897F\u4E9A\u7802\u62C9\u8D8A\u5DDE\u9996\u5E9C\uFF0C\u4E5F\u662F\u4E1C\u9A6C\u6765\u897F\u4E9A\u6700\u5927\u7684\u57CE\u5E02\u3002\u8BE5\u822A\u7EBF\u6BCF\u5468\u51FA\u6E2F3\u73ED\uFF0C\u6BCF\u5468\u51FA\u6E2F\u8FD0\u529B60\u5428\u4EE5\u4E0A\uFF0C\u4E3B\u8981\u627F\u8FD0\u7684\u8D27\u7269\u4E3A\u7535\u5546\u3001\u4E00\u822C\u8D38\u6613\u4EE5\u53CA\u5FEB\u4EF6\u7C7B\u8D27\u7269\u3002\u4ECA\u5E74\u662F\u4E2D\u9A6C\u5EFA\u4EA450\u5468\u5E74\uFF0C\u968F\u7740\u4E2D\u56FD\u548C\u9A6C\u6765\u897F\u4E9A\u5404\u9886\u57DF\u5408\u4F5C\u65E5\u76CA\u6DF1\u5316\uFF0C\u4E2D\u56FD\u5DF2\u8FDE\u7EED15\u5E74\u6210\u4E3A\u9A6C\u6765\u897F\u4E9A\u6700\u5927\u8D38\u6613\u4F19\u4F34\u3002\u8BE5\u822A\u7EBF\u7684\u5F00\u901A\uFF0C\u5C06\u6709\u529B\u4FC3\u8FDB\u6DF1\u5733\u4E0E\u9A6C\u6765\u897F\u4E9A\u7684\u7ECF\u8D38\u5F80\u6765\uFF0C\u540C\u65F6\u8FDB\u4E00\u6B65\u52A0\u5F3A\u7CA4\u6E2F\u6FB3\u5927\u6E7E\u533A\u4E0E\u4E1C\u76DF\u56FD\u5BB6\u3001RCEP\u56FD\u5BB6\u4EE5\u53CA\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u5171\u5EFA\u56FD\u5BB6\u7684\u4E92\u8054\u4E92\u901A\u3002\u76EE\u524D\uFF0C\u6DF1\u5733\u673A\u573A\u8D27\u8FD0\u822A\u7EBF\u5DF2\u901A\u8FBE5\u4E2A\u4E1C\u5357\u4E9A\u56FD\u5BB69\u4E2A\u57CE\u5E02\uFF0C\u6BCF\u5468\u8FDB\u51FA\u6E2F\u8D27\u8FD0\u822A\u73ED\u8D85\u8FC7100\u67B6\u6B21\u3002\u003C/p\u003E\n\u003Cp\u003E\u3000\u3000\u968F\u7740\u6B64\u6B21\u6DF1\u5733\u81F3\u53E4\u664B\u7684\u8D27\u8FD0\u822A\u7EBF\u5F00\u901A\uFF0C\u6DF1\u5733\u673A\u573A\u56FD\u5185\u5916\u8D27\u8FD0\u822A\u7EBF\u901A\u822A\u70B9\u8FBE\u523060\u4E2A\u3002\u5176\u4E2D\u56FD\u9645\u53CA\u5730\u533A\u8D27\u8FD0\u822A\u7EBF\u901A\u822A\u70B9\u8FBE\u523038\u4E2A\uFF0C\u8986\u76D6\u6D1B\u6749\u77F6\u3001\u829D\u52A0\u54E5\u3001\u6CD5\u5170\u514B\u798F\u3001\u5DF4\u9ECE\u3001\u4F26\u6566\u3001\u5217\u65E5\u3001\u5E03\u8FBE\u4F69\u65AF\u7B49\u5168\u7403\u4E3B\u8981\u822A\u7A7A\u8D27\u8FD0\u67A2\u7EBD\uFF0C\u5B9E\u73B0\u4E0E\u5168\u7403\u767E\u4E07\u5428\u7EA7\u5927\u578B\u67A2\u7EBD\u673A\u573A\u7684\u8054\u901A\uFF0C\u8986\u76D6\u5168\u74035\u5927\u6D32\u300126\u4E2A\u56FD\u5BB6\u548C\u5730\u533A\uFF0C\u822A\u7A7A\u7F51\u7EDC\u66F4\u52A0\u5B8C\u5584\u3001\u67A2\u7EBD\u8F90\u5C04\u80FD\u529B\u7A33\u6B65\u589E\u5F3A\uFF0C\u6301\u7EED\u4E3A\u7CA4\u6E2F\u6FB3\u5927\u6E7E\u533A\u4E0E\u5168\u7403\u7ECF\u8D38\u5F80\u6765\u201C\u62D3\u901A\u9053\u3001\u63D0\u901F\u5EA6\u201D\uFF0C\u52A9\u529B\u6DF1\u5733\u5916\u8D38\u9AD8\u8D28\u91CF\u53D1\u5C55\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/cKb13w52kGDUpjKiMCiH-g\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
