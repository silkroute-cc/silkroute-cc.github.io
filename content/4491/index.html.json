  "canonicalUrlKey": "pjd%e5%a4%a7%e9%81%93%e8%ae%a1%e5%88%92%e9%9d%a2%e5%af%b9%e5%a4%a7%e5%a4%9a%e6%95%b0%e4%ba%ba%e5%8f%8d%e5%af%b9%e3%80%80%e9%9b%aa%e5%a4%a7%e8%87%a3%ef%bc%9a%e5%bc%80%e5%8f%91%e5%95%86%e9%9c%80",
  "route": "/4491/",
  "title": "PJD\u5927\u9053\u8BA1\u5212\u9762\u5BF9\u5927\u591A\u6570\u4EBA\u53CD\u5BF9\u3000\u96EA\u5927\u81E3\uFF1A\u5F00\u53D1\u5546\u9700\u91CD\u65B0\u4E0E\u653F\u5E9C\u8C08\u5224",
  "summary": "\uFF08\u838E\u963F\u535724\u65E5\u8BAF\uFF09\u57FA\u4E8E\u8BB8\u591A\u6D89\u53CA\u4F4F\u5B85\u533A\u7684\u53CD\u5BF9\u548C\u6297\u62D2\uFF0C\u96EA\u5170\u83AA\u5DDE\u52A1\u5927\u81E3\u62FF\u7763\u65AF\u91CC\u963F\u7C73\u9C81\u4E01\u8BA4\u4E3A\uFF0C\u516B\u6253\u7075\u518D\u4E5F\u758F\u6563\u9AD8\u67B6\u5927\u9053\u8BA1\u5212\uFF08PJD Link\uFF09\u7684\u5F00\u53D1\u5546\uFF0C\u6709\u5FC5\u8981\u4E0E\u8054\u90A6\u653F\u5E9C\u91CD\u65B0\u8C08\u5224\u3002 \u4ED6\u6307\uFF0C2023\u5E748\u6708\u5DDE\u9009\u4E3E\u540E\uFF0C\u96EA\u5DDE\u653F\u5E9C\u6536\u5230\u4E86\u758F\u6563\u5927\u9053\uFF08\u5927\u9A6C\uFF09\u79C1\u4EBA\u6709\u9650\u516C\u53F8\u7684\u793E\u4F1A\u5F71\u54CD\u8BC4\u4F30\u62A5\u544A\uFF0C\u5176\u4E2D\u6307\u9664\u4E86\u7F8E\u4E39\u82B1\u56ED\u548C\u91D1\u92AE\u533A\uFF0C\u5176\u4ED6\u533A\u7684\u5C45\u6C11\u90FD\u62D2\u7EDD\u4E86\u8FD9\u9879\u8BA1\u5212\u3002 \u201C\u6211\u4EEC\u544A\u8BC9\uFF08\u5F00\u53D1\u5546\uFF09\uFF0C\u4ED6\u4EEC\u4E5F\u8BB8\u53EF\u4EE5\u63A5\u7EB3\u90A3\u4E9B\u63A5\u53D7\uFF08\u8FD9\u8BA1\u5212\uFF09\u7684\u4EBA\uFF0C\u5E76\u56DE\u907F\u6297\u62D2\u7684\u4EBA\u3002\u201D \u4ED6\u8868\u793A\uFF0C\u82E5\u8C03\u6574\u8DEF\u7EBF\uFF0C\u5F00\u53D1\u5546\u5C06\u4E0D\u5F97\u4E0D\u4ECE\u5934\u5F00\u59CB\uFF0C\u5305\u62EC\u4E0E\u653F\u5E9C\u91CD\u65B0\u8C08\u5224\u2026",
  "body": "\u003Cp\u003E\uFF08\u838E\u963F\u535724\u65E5\u8BAF\uFF09\u57FA\u4E8E\u8BB8\u591A\u6D89\u53CA\u4F4F\u5B85\u533A\u7684\u53CD\u5BF9\u548C\u6297\u62D2\uFF0C\u96EA\u5170\u83AA\u5DDE\u52A1\u5927\u81E3\u62FF\u7763\u65AF\u91CC\u963F\u7C73\u9C81\u4E01\u8BA4\u4E3A\uFF0C\u516B\u6253\u7075\u518D\u4E5F\u758F\u6563\u9AD8\u67B6\u5927\u9053\u8BA1\u5212\uFF08PJD Link\uFF09\u7684\u5F00\u53D1\u5546\uFF0C\u6709\u5FC5\u8981\u4E0E\u8054\u90A6\u653F\u5E9C\u91CD\u65B0\u8C08\u5224\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6307\uFF0C2023\u5E748\u6708\u5DDE\u9009\u4E3E\u540E\uFF0C\u96EA\u5DDE\u653F\u5E9C\u6536\u5230\u4E86\u758F\u6563\u5927\u9053\uFF08\u5927\u9A6C\uFF09\u79C1\u4EBA\u6709\u9650\u516C\u53F8\u7684\u793E\u4F1A\u5F71\u54CD\u8BC4\u4F30\u62A5\u544A\uFF0C\u5176\u4E2D\u6307\u9664\u4E86\u7F8E\u4E39\u82B1\u56ED\u548C\u91D1\u92AE\u533A\uFF0C\u5176\u4ED6\u533A\u7684\u5C45\u6C11\u90FD\u62D2\u7EDD\u4E86\u8FD9\u9879\u8BA1\u5212\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u4EEC\u544A\u8BC9\uFF08\u5F00\u53D1\u5546\uFF09\uFF0C\u4ED6\u4EEC\u4E5F\u8BB8\u53EF\u4EE5\u63A5\u7EB3\u90A3\u4E9B\u63A5\u53D7\uFF08\u8FD9\u8BA1\u5212\uFF09\u7684\u4EBA\uFF0C\u5E76\u56DE\u907F\u6297\u62D2\u7684\u4EBA\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8868\u793A\uFF0C\u82E5\u8C03\u6574\u8DEF\u7EBF\uFF0C\u5F00\u53D1\u5546\u5C06\u4E0D\u5F97\u4E0D\u4ECE\u5934\u5F00\u59CB\uFF0C\u5305\u62EC\u4E0E\u653F\u5E9C\u91CD\u65B0\u8C08\u5224\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u8054\u90A6\u653F\u5E9C\u7ED9\u4E88\u7684\u8BB8\u53EF\u662F\u57FA\u4E8E\u5F53\u524D\u7684\u8C03\u6574\u3002\u82E5\u4ED6\u4EEC\u60F3\u6539\u53D8\uFF0C\u5C31\u5FC5\u987B\u4ECE\u5934\u5230\u5C3E\u63D0\u5448\u7ED9\u653F\u5E9C\u3002\u7136\u800C\u4ED6\u4EEC\u613F\u610F\u8FD9\u4E48\u505A\u5417\uFF1F\u201D\u003C/p\u003E\n\u003Cp\u003E\u9488\u5BF9\u6B64\u524D\u51FA\u5E2D\u6D3B\u52A8\u65F6\uFF0C\u73B0\u573A\u6709\u4EBA\u58EB\u62C9\u8D77\u53CD\u5BF9\u758F\u6563\u5927\u9053\u7684\u6A2A\u5E45\uFF0C\u4E5F\u662F\u9E45\u551B\u56FD\u4F1A\u8BAE\u5458\u7684\u963F\u7C73\u9C81\u4E01\u8868\u793A\uFF0C\u4ED6\u53BB\u5E74\u66FE\u5728\u56FD\u4F1A\u4E0B\u8BAE\u9662\u4E0E\u8FD9\u4E9B\u4EBA\u89C1\u8FC7\u9762\uFF0C\u5F53\u65F6\u5305\u62EC\u884C\u52A8\u515A\u96EA\u5DDE\u4E3B\u5E2D\u517C\u767D\u6C99\u7F57\u56FD\u4F1A\u8BAE\u5458\u54E5\u5BBE\u661F\u4EE5\u53CA\u58EB\u62C9\u592E\u56FD\u4F1A\u8BAE\u5458\u6881\u81EA\u575A\u4E5F\u5728\u573A\u3002\u003C/p\u003E\n\u003Cp\u003E\u5728\u6D3B\u52A8\u73B0\u573A\u62C9\u6A2A\u5E45\u4EBA\u58EB\u58F0\u79F0\uFF0C\u5DF2\u7ECF\u9488\u5BF9\u8BE5\u8BA1\u5212\u5411\u96EA\u5DDE\u5927\u81E3\u7684\u529E\u516C\u5BA4\u63D0\u4EA4\u4E864\u6B21\u53CD\u5BF9\u5907\u5FD8\u5F55\uFF0C\u5374\u59CB\u7EC8\u6CA1\u6709\u5F97\u5230\u96EA\u5DDE\u653F\u5E9C\u7684\u56DE\u5E94\u3002\u003C/p\u003E\n\u003Cp\u003E\u800C\u6839\u636E\u62A5\u5BFC\uFF0C\u963F\u7C73\u9C81\u4E01\u53BB\u5E74\u66FE\u8868\u793A\uFF0C\u96EA\u5DDE\u653F\u5E9C\u5DF2\u51B3\u5B9A\u5E9F\u9664\u8BE5\u8BA1\u5212\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6307\uFF0C\u5F00\u53D1\u5546\u63D0\u4EA4\u7684\u5F71\u54CD\u8BC4\u4F30\u62A5\u544A\uFF0C\u5C24\u5176\u662F\u793E\u533A\u5F71\u54CD\u8BC4\u4F30\u62A5\u544A\u5E76\u4E0D\u4EE4\u4EBA\u6EE1\u610F\uFF0C\u4E5F\u4E0D\u7B26\u5408\u5DDE\u653F\u5E9C\u8BBE\u5B9A\u7684\u7279\u5B9A\u6761\u4EF6\u3002\u003C/p\u003E\n\u003Cp\u003E\u516B\u6253\u7075\u518D\u4E5F\u758F\u6563\u9AD8\u67B6\u5927\u9053\u8FDE\u63A5\u516B\u6253\u7075\u518D\u4E5F\u7684\u5357\u5317\u90E8\uFF0C\u5176\u4E2D\u7ECF\u8FC7\u516B\u6253\u7075\u518D\u4E5F\u5317\u533A\u3001\u4E07\u8FBE\u9547\u3001\u6566\u4F9D\u65AF\u8FC8\u82B1\u56ED\u3001\u7075\u5E02\u4E2D\u5FC3\u3001\u62FF\u7763\u54C8\u4F26\u82B1\u56ED\u3001\u7F8E\u4E39\u5DF4\u9C81\u82B1\u56ED\u3001\u65AF\u91CC\u66FC\u52A0\u82B1\u56ED\u3001\u91D1\u92AE\u9547\u548C\u6B66\u5409\u52A0\u91CC\u5C14\u79D1\u6280\u56ED\u3002\u003C/p\u003E\n\u003Cp\u003E2017\u5E7411\u6708\uFF0C\u5185\u9601\u539F\u5219\u4E0A\u6279\u51C6\u6B64\u8BA1\u5212\u7684\u5EFA\u6848\uFF1B2020\u5E749\u6708\uFF0C\u96EA\u5DDE\u653F\u5E9C\u4E5F\u539F\u5219\u4E0A\u6279\u51C6\u4E86\u6B64\u8BA1\u5212\uFF0C\u4F46\u9700\u6536\u5230\u5F71\u54CD\u8BC4\u4F30\u62A5\u544A\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/m0ClzkizoHx9oQm2VHwsAg\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
