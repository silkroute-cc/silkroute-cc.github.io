  "slug": "17%e4%b8%ad%e5%9b%bd%e6%8a%80%e6%9c%af%e5%ad%a6%e9%99%a2%e5%8a%a9%e5%8a%9b%e5%a4%a7%e9%a9%ac-%e8%81%94%e8%ae%be%e6%8a%80%e8%81%8c%e6%95%99%e8%82%b2%e5%9f%b9%e8%ae%ad",
  "canonicalUrlKey": "17%e4%b8%ad%e5%9b%bd%e6%8a%80%e6%9c%af%e5%ad%a6%e9%99%a2%e5%8a%a9%e5%8a%9b%e5%a4%a7%e9%a9%ac-%e8%81%94%e8%ae%be%e6%8a%80%e8%81%8c%e6%95%99%e8%82%b2%e5%9f%b9%e8%ae%ad",
  "route": "/4363/",
  "title": "17\u4E2D\u56FD\u6280\u672F\u5B66\u9662\u52A9\u529B\u5927\u9A6C \u8054\u8BBE\u6280\u804C\u6559\u80B2\u57F9\u8BAD",
  "summary": "\uFF08\u5409\u9686\u576116\u65E5\u8BAF\uFF09\u5927\u9A6C\u548C\u4E2D\u56FD11\u6708\u53BB\u5E74\u540C\u610F\u6210\u7ACB\u6280\u804C\u6559\u80B2\u4E0E\u57F9\u8BAD\uFF08TVET\uFF09\u5B66\u9662\uFF0C17\u5BB6\u4E2D\u56FD\u9AD8\u7B49\u804C\u4E1A\u6280\u672F\u5B66\u9662\u5DF2\u540C\u610F\u53CA\u627F\u8BFA\u52A9\u529B\u8BE5\u5B66\u9662\u7684\u6210\u7ACB\u3002 17\u5BB6\u4E2D\u56FD\u6280\u672F\u5B66\u9662\u540C\u610F\u4ECA\u5E74\u5C06\u63D0\u4F9B2000\u4E2A\u540D\u989D\uFF0C\u4E3A\u6211\u56FD\u5B66\u751F\u63D0\u4F9B\u6280\u80FD\u57F9\u8BAD\uFF0C\u5305\u62EC\u7535\u52A8\u6C7D\u8F66\u3001\u7269\u8054\u7F51\u3001\u4EBA\u5DE5\u667A\u80FD\u3001\u592A\u9633\u80FD\u3001\u8D44\u8BAF\u5DE5\u827A\u53CA\u673A\u68B0\u52A0\u5DE5\u6280\u672F\u3002 \u5168\u56FD\u6280\u672F\u719F\u7EC3\u5458\u5DE5\u7EC4\u7EC7\uFF08PKPB\uFF09\u4E0E\u4E2D\u56FD\u5510\u98CE\u56FD\u9645\u6559\u80B2\u96C6\u56E2\u6628\u65E5\u5728\u4E2D\u56FD\u5317\u4EAC\u5F3A\u5F3A\u5317\u4EAC\u56FD\u9645\u5546\u52A1\u9152\u5E97\u8054\u5408\u4E3E\u529E\u201C\u9A6C\u4E2D\u56FD\u9645\u5B66\u9662\u201D\u5EFA\u8BBE\u53CA\u9A6C\u4E2D\u804C\u4E1A\u6559\u80B2\u5408\u4F5C\u7814\u8BA8\u4F1A\uFF0C\u5E76\u4F5C\u51FA\u5BA3\u5E03\u3002 \u9A6C\u4E2D\u8054\u5408\u8BBE\u7ACB\u7684\u6280\u804C\u5B66\u9662\u521D\u6B65\u540C\u610F\u547D\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/01/frc-8119906a5b1d61c80387f576a8c8773d.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\uFF08\u5409\u9686\u576116\u65E5\u8BAF\uFF09\u5927\u9A6C\u548C\u4E2D\u56FD11\u6708\u53BB\u5E74\u540C\u610F\u6210\u7ACB\u6280\u804C\u6559\u80B2\u4E0E\u57F9\u8BAD\uFF08TVET\uFF09\u5B66\u9662\uFF0C17\u5BB6\u4E2D\u56FD\u9AD8\u7B49\u804C\u4E1A\u6280\u672F\u5B66\u9662\u5DF2\u540C\u610F\u53CA\u627F\u8BFA\u52A9\u529B\u8BE5\u5B66\u9662\u7684\u6210\u7ACB\u3002\u003C/p\u003E\n\u003Cp\u003E17\u5BB6\u4E2D\u56FD\u6280\u672F\u5B66\u9662\u540C\u610F\u4ECA\u5E74\u5C06\u63D0\u4F9B2000\u4E2A\u540D\u989D\uFF0C\u4E3A\u6211\u56FD\u5B66\u751F\u63D0\u4F9B\u6280\u80FD\u57F9\u8BAD\uFF0C\u5305\u62EC\u7535\u52A8\u6C7D\u8F66\u3001\u7269\u8054\u7F51\u3001\u4EBA\u5DE5\u667A\u80FD\u3001\u592A\u9633\u80FD\u3001\u8D44\u8BAF\u5DE5\u827A\u53CA\u673A\u68B0\u52A0\u5DE5\u6280\u672F\u3002\u003C/p\u003E\n\u003Cp\u003E\u5168\u56FD\u6280\u672F\u719F\u7EC3\u5458\u5DE5\u7EC4\u7EC7\uFF08PKPB\uFF09\u4E0E\u4E2D\u56FD\u5510\u98CE\u56FD\u9645\u6559\u80B2\u96C6\u56E2\u6628\u65E5\u5728\u4E2D\u56FD\u5317\u4EAC\u5F3A\u5F3A\u5317\u4EAC\u56FD\u9645\u5546\u52A1\u9152\u5E97\u8054\u5408\u4E3E\u529E\u201C\u9A6C\u4E2D\u56FD\u9645\u5B66\u9662\u201D\u5EFA\u8BBE\u53CA\u9A6C\u4E2D\u804C\u4E1A\u6559\u80B2\u5408\u4F5C\u7814\u8BA8\u4F1A\uFF0C\u5E76\u4F5C\u51FA\u5BA3\u5E03\u3002\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u4E2D\u8054\u5408\u8BBE\u7ACB\u7684\u6280\u804C\u5B66\u9662\u521D\u6B65\u540C\u610F\u547D\u540D\u4E3A\u201C\u9A6C\u4E2D\u56FD\u9645\u5B66\u9662\u201D\uFF08Malaysia-China Institute\uFF0CMCI\uFF09\uFF0C\u6700\u7EC8\u540D\u79F0\u5F85\u786E\u5B9A\u540E\u4F1A\u5728\u6210\u7ACB\u4EEA\u5F0F\u4E0A\u516C\u5E03\u3002\u003C/p\u003E\n\u003Cp\u003EPKPB\u79D8\u4E66\u83AB\u54C8\u672B\u793C\u5360\u53D1\u6587\u544A\u8BF4\uFF0C\u53BB\u5E7411\u67089\u65E5\uFF0C\u526F\u9996\u76F8\u62FF\u7763\u65AF\u91CC\u963F\u672B\u624E\u5E0C\u535A\u58EB\u5728\u4F1A\u6664\u6765\u9A6C\u8BBF\u95EE\u7684\u4E2D\u56FD\u56FD\u5BB6\u526F\u4E3B\u5E2D\u97E9\u6B63\u540E\uFF0C\u5BA3\u5E03\u9A6C\u4E2D\u5408\u4F5C\u8BBE\u7ACB\u6280\u804C\u673A\u6784\uFF0C\u800CPKPB\u968F\u540E\u4E3B\u52A8\u79EF\u6781\u63A5\u89E6\u4E2D\u56FD\u7684\u6280\u804C\u5B66\u9662\uFF0C\u63A2\u8BA8\u53EF\u8BA9\u5927\u9A6C\u4EBA\u62A5\u8BFB\u7684\u6280\u804C\u8BFE\u7A0B\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u900F\u9732\uFF0C\u5927\u9A6C\u4EE3\u8868\u56E2\u7531\u8BE5\u7EC4\u7EC7\u987E\u95EE\u517C\u6A61\u80F6\u4E1A\u5C0F\u56ED\u4E3B\u53D1\u5C55\u5C40\uFF08RISDA\uFF09\u4E3B\u5E2D\u66FC\u5179\u91CC\u5E26\u9886\u524D\u5F80\u5317\u4EAC\uFF0C\u4ED6\u672C\u4EBA\u6C47\u62A5\u4E86\u8BBE\u7ACBMCI\u7684\u6846\u67B6\u6982\u5FF5\uFF0C\u66FC\u5179\u91CC\u5219\u83B7\u4EE3\u886817\u5BB6\u4E2D\u56FD\u6280\u804C\u5B66\u9662\u7684\u4E2D\u56FD\u5510\u98CE\u56FD\u9645\u6559\u80B2\u59D4\u4EFB\u4E3AMCI\u7684\u9996\u5E2D\u534F\u8C03\u5458\u3002\u003C/p\u003E\n\u003Cp\u003E\u66FC\u5179\u91CC\u8868\u793A\uFF0C\u80FD\u83B7\u4E2D\u56FD\u6280\u804C\u5B66\u9662\u627F\u8BFA\u5408\u4F5C\u63D0\u4F9B\u6280\u804C\u8BFE\u7A0B\uFF0C\u662F\u9A6C\u4E2D\u4ECA\u5E74\u5EFA\u4EA450\u5468\u5E74\u7EAA\u5FF5\u7684\u793C\u7269\uFF0C\u9A6C\u4E2D\u5173\u7CFB\u4E5F\u5C06\u901A\u8FC7\u5404\u79CD\u5F62\u5F0F\u7684\u5408\u4F5C\u8BA1\u5212\uFF0C\u5305\u62EC\u653F\u6CBB\u3001\u6295\u8D44\u3001\u7ECF\u6D4E\u3001\u65C5\u6E38\u3001\u519C\u4E1A\u3001\u8BED\u8A00\u548C\u6587\u5316\u6559\u80B2\u7B49\u9886\u57DF\uFF0C\u66F4\u52A0\u5DE9\u56FA\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u9A6C\u4E2D\u4E92\u60E0\u4E92\u5229\uFF0C\u5728\u5404\u9886\u57DF\u52A1\u5B9E\u5408\u4F5C\uFF0C\u5E0C\u671B\u8D38\u6613\u548C\u6295\u8D44\u7B49\u50AC\u5316\u5242\u56E0\u7D20\u80FD\u901A\u8FC7\u4E24\u56FD\u57F9\u80B2\u4E13\u5BB6\u548C\u719F\u7EC3\u7684\u4EBA\u529B\u8D44\u672C\u76F8\u5E73\u8861\uFF0C\u6301\u7EED\u63A8\u8FDB\u957F\u671F\u5408\u4F5C\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E17\u5BB6\u4E2D\u56FD\u9AD8\u7B49\u804C\u4E1A\u6280\u672F\u5B66\u9662\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E1.\u91CD\u5E86\u6C34\u5229\u7535\u529B\u804C\u4E1A\u6280\u672F\u5B66\u9662\u003C/p\u003E\n\u003Cp\u003E2.\u6CB3\u5317\u8F6F\u4EF6\u804C\u4E1A\u6280\u672F\u5B66\u9662\u003C/p\u003E\n\u003Cp\u003E3.\u6B66\u6C49\u4EA4\u901A\u804C\u4E1A\u5B66\u9662\u003C/p\u003E\n\u003Cp\u003E4.\u5408\u80A5\u804C\u4E1A\u6280\u672F\u5B66\u9662\u003C/p\u003E\n\u003Cp\u003E5.\u798F\u5EFA\u4FE1\u606F\u804C\u4E1A\u6280\u672F\u5B66\u9662\u003C/p\u003E\n\u003Cp\u003E6.\u6CB3\u5317\u673A\u7535\u804C\u4E1A\u6280\u672F\u5B66\u9662\u003C/p\u003E\n\u003Cp\u003E7.\u5510\u5C71\u5DE5\u4E1A\u804C\u4E1A\u6280\u672F\u5B66\u9662\u003C/p\u003E\n\u003Cp\u003E8.\u5B89\u5FBD\u804C\u4E1A\u6280\u672F\u5B66\u9662\u003C/p\u003E\n\u003Cp\u003E9.\u9752\u6D77\u4EA4\u901A\u804C\u4E1A\u6280\u672F\u5B66\u9662\u003C/p\u003E\n\u003Cp\u003E10.\u5F90\u5DDE\u5DE5\u4E1A\u804C\u4E1A\u6280\u672F\u5B66\u9662\u003C/p\u003E\n\u003Cp\u003E11.\u9ED1\u9F99\u6C5F\u4EA4\u901A\u804C\u4E1A\u6280\u672F\u5B66\u9662\u003C/p\u003E\n\u003Cp\u003E12.\u7518\u8083\u4EA4\u901A\u804C\u4E1A\u6280\u672F\u5B66\u9662\u003C/p\u003E\n\u003Cp\u003E13.\u70DF\u53F0\u804C\u4E1A\u5B66\u9662\u003C/p\u003E\n\u003Cp\u003E14.\u9655\u897F\u56FD\u9632\u5DE5\u4E1A\u804C\u4E1A\u6280\u672F\u5B66\u9662\u003C/p\u003E\n\u003Cp\u003E15.\u5317\u4EAC\u5E02\u5546\u4E1A\u5B66\u6821\u003C/p\u003E\n\u003Cp\u003E16.\u54C8\u5C14\u6EE8\u804C\u4E1A\u6280\u672F\u5B66\u9662\u003C/p\u003E\n\u003Cp\u003E17.\u8944\u9633\u804C\u4E1A\u6280\u672F\u5B66\u9662\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/EZyAidKnWShJAb3XREBImw\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
