  "route": "/2603/",
  "title": "\u590F\u95E8\u5927\u5B66\u4E3A\u4E00\u5E26\u4E00\u8DEF\u683D\u57F9\u66F4\u591A\u8DE8\u6587\u5316\u7684\u56FD\u9645\u4EBA\u624D",
  "summary": "\u53A6\u95E8\u5927\u5B66\u4E3A\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u57F9\u80B2\u8DE8\u6587\u5316\u7684\u56FD\u9645\u578B\u4EBA\u624D2013\u5E74\uFF0C\u4E2D\u56FD\u56FD\u5BB6\u4E3B\u5E2D\u4E60\u8FD1\u5E73\u5728\u56FD\u9645\u8BBA\u575B\u4E0A\u63D0\u51FA\u4E86\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u7684\u5021\u8BAE\u3002\u540C\u5E74\uFF0C\u53A6\u95E8\u5927\u5B66\u9A6C\u6765\u897F\u4E9A\u5206\u6821\u9879\u76EE\u6B63\u5F0F\u843D\u5730\uFF0C\u4E3A\u9A6C\u6765\u897F\u4E9A\u57F9\u517B\u672A\u6765\u6240\u9700\u7684\u4EBA\u624D\u3002 \u53A6\u95E8\u5927\u5B66\u9A6C\u6765\u897F\u4E9A\u5206\u6821\u7814\u7A76\u4E0E\u521B\u65B0\u4E3B\u4EFB\u738B\u60E0\u743C\u6559\u6388\u8868\u793A\uFF0C\u201C\u4E2D\u8D44\u4F01\u4E1A\u5728\u8D70\u51FA\u6765\u4E2D\u56FD\u4E4B\u524D\u5176\u5B9E\u5F88\u591A\u5728\u56FD\u5167\u5DF2\u7ECF\u505A\u5F97\u5F88\u597D\u4E86\u3002\u8D70\u51FA\u6765\u7684\u7B2C\u4E00\u65B9\u9762\u662F\u4E3A\u4E86\u54CD\u5E94\u6211\u4EEC\u4E60\u4E3B\u5E2D\u8BF4\u7684\u4E00\u5E26\u4E00\u8DEF\u5021\u8BAE\uFF0C \u7136\u540E\u628A\u4E00\u4E9B\u4E2D\u56FD\u7684\u6280\u672F\u5E26\u5230\u4E00\u5E26\u4E00\u8DEF\u7684\u8FD9\u4E9B\u56FD\u5BB6\u6765\u3002 \u800C\u53E6\u5916\u4E00\u65B9\u9762\u662F\u4E2D\u8D44\u4F01\u4E1A\u5728\u4E1C\u5357\u4E9A\u8FD9\u8FB9\u4F1A\u6709\u4ED6\u81EA\u5DF1\u7279\u6709\u7684\u4E00\u4E9B\u5E02\u573A\uFF0C\u4ED6\u4EEC\u53EF\u80FD\u89C9\u2026",
  "body": "\u003Cp\u003E\u53A6\u95E8\u5927\u5B66\u4E3A\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u57F9\u80B2\u8DE8\u6587\u5316\u7684\u56FD\u9645\u578B\u4EBA\u624D2013\u5E74\uFF0C\u4E2D\u56FD\u56FD\u5BB6\u4E3B\u5E2D\u4E60\u8FD1\u5E73\u5728\u56FD\u9645\u8BBA\u575B\u4E0A\u63D0\u51FA\u4E86\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u7684\u5021\u8BAE\u3002\u540C\u5E74\uFF0C\u53A6\u95E8\u5927\u5B66\u9A6C\u6765\u897F\u4E9A\u5206\u6821\u9879\u76EE\u6B63\u5F0F\u843D\u5730\uFF0C\u4E3A\u9A6C\u6765\u897F\u4E9A\u57F9\u517B\u672A\u6765\u6240\u9700\u7684\u4EBA\u624D\u3002\u003C/p\u003E\n\u003Cp\u003E\u53A6\u95E8\u5927\u5B66\u9A6C\u6765\u897F\u4E9A\u5206\u6821\u7814\u7A76\u4E0E\u521B\u65B0\u4E3B\u4EFB\u738B\u60E0\u743C\u6559\u6388\u8868\u793A\uFF0C\u201C\u4E2D\u8D44\u4F01\u4E1A\u5728\u8D70\u51FA\u6765\u4E2D\u56FD\u4E4B\u524D\u5176\u5B9E\u5F88\u591A\u5728\u56FD\u5167\u5DF2\u7ECF\u505A\u5F97\u5F88\u597D\u4E86\u3002\u8D70\u51FA\u6765\u7684\u7B2C\u4E00\u65B9\u9762\u662F\u4E3A\u4E86\u54CD\u5E94\u6211\u4EEC\u4E60\u4E3B\u5E2D\u8BF4\u7684\u4E00\u5E26\u4E00\u8DEF\u5021\u8BAE\uFF0C \u7136\u540E\u628A\u4E00\u4E9B\u4E2D\u56FD\u7684\u6280\u672F\u5E26\u5230\u4E00\u5E26\u4E00\u8DEF\u7684\u8FD9\u4E9B\u56FD\u5BB6\u6765\u3002\n\u800C\u53E6\u5916\u4E00\u65B9\u9762\u662F\u4E2D\u8D44\u4F01\u4E1A\u5728\u4E1C\u5357\u4E9A\u8FD9\u8FB9\u4F1A\u6709\u4ED6\u81EA\u5DF1\u7279\u6709\u7684\u4E00\u4E9B\u5E02\u573A\uFF0C\u4ED6\u4EEC\u53EF\u80FD\u89C9\u5F97\u53EF\u4EE5\u5728\u9A6C\u6765\u897F\u4E9A\u8FD9\u8FB9\u5F97\u5230\u66F4\u597D\u7684\u62D3\u5C55\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E \u201C\u6BD4\u5982\u8BF4\u6DD8\u5B9D\u521B\u529E\u4EBA\uFF0C\u9A6C\u4E91\uFF0C\u4ED6\u5728\u56FD\u5185\u5DF2\u7ECF\u662F\u975E\u5E38\u6210\u529F\uFF0C \u4F46\u4E3B\u8981\u662F\u4ED6\u4E0D\u6EE1\u8DB3\u4E8E\u4E2D\u56FD\u5E02\u573A\uFF0C\u6240\u4EE5\u4ED6\u8981\u8D70\u5411\u5168\u4E16\u754C\u3002\u800C\u4E14\u6211\u4EEC\u4E1C\u5357\u4E9A\u534E\u4EBA\u5C45\u591A\u4E5F\u6BD4\u8F83\u5BB9\u6613\u63A5\u53D7\u4E2D\u56FD\u7684\u65B9\u5F0F\uFF0C \u6240\u4EE5\u4ED6\u53EF\u4EE5\u4ECE\u8FD9\u8FB9\u505A\u4E00\u4E2A\u5B9E\u9A8C\u3002\u76F8\u4FE1\u5728\u901A\u8FC7\u963F\u91CC\u5DF4\u5DF4\u7684\u5F71\u54CD\u4E0B\uFF0C\u7535\u5B50\u5546\u52A1\u8FD9\u4E00\u4E2A\u9886\u57DF\u5728\u9A6C\u6765\u897F\u4E9A\u4F1A\u6709\u5F88\u597D\u7684\u53D1\u5C55\u201D \u3002\u003C/p\u003E\n\u003Cp\u003E\u5979\u8BF4\uFF0C\u5728\u8FD9\u4E9B\u65B0\u5174\u7684\u9AD8\u79D1\u6280\u4E2D\uFF0C\u4EBA\u5DE5\u667A\u80FD\u5C06\u662F\u5E02\u573A\u6240\u9700\u6C42\u7684\u6280\u672F\u4E4B\u4E00\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u53E6\u5916\u5C31\u662F\u4E2D\u56FD\u672C\u6821\u7684\u4E00\u4E9B\u6821\u53CB\u4F01\u4E1A\u5BB6\u4E5F\u8D8A\u6765\u8D8A\u770B\u91CD\u4E1C\u5357\u4E9A\u7684\u5E02\u573A\uFF0C \u800C\u6211\u4EEC\u5206\u6821\u5C31\u63D0\u4F9B\u4E86\u4E00\u4E2A\u5F88\u597D\u7684\u5E73\u53F0\uFF0C\u8BA9\u4ED6\u4EEC\u501F\u52A9\u5206\u6821\u7684\u5173\u7CFB\uFF0C \u63A2\u8BA8\u5230\u9A6C\u6765\u897F\u4E9A\u5F00\u62D3\u4E1C\u5357\u4E9A\u5E02\u573A\u7684\u53EF\u80FD\u6027\u3002\u672C\u90E8\u7684\u6559\u5E08\u4E5F\u501F\u52A9\u5206\u6821\u7684\u5730\u7F18\u4F18\u52BF\uFF0C\n\u5F00\u5C55\u4EE5\u201C\u4E00\u5E26\u4E00\u8DEF\u201D \u4E3A\u4E3B\u9898\u6216\u8005\u4EE5\u4E1C\u5357\u4E9A\u4E3A\u4E3B\u9898\u7684\u7814\u7A76\u3002\u201C\u003C/p\u003E\n\u003Cp\u003E\u5E94\u5927\u9A6C\u653F\u5E9C\u57282012\u5E74\u53D1\u51FA\u7684\u9080\u8BF7\uFF0C\u4F5C\u4E3A\u4E2D\u56FD\u9AD8\u6821\u4E2D\u5728\u6D77\u5916\u8BBE\u7ACB\u7684\u9996\u5BB6\u5206\u6821\uFF0C\u53A6\u95E8\u5927\u5B66\u5168\u8D44\u8BBE\u7ACB\u4E86\u5177\u5907\u72EC\u7ACB\u6821\u56ED\u7684\u9A6C\u6765\u5206\u6821\u3002\u6821\u56ED\u4F4D\u4E8E\u90BB\u8FD1\u5409\u9686\u5761\u56FD\u9645\u673A\u573A\u7684\u96EA\u5DDE\u96EA\u90A6\uFF0C\u5360\u5730150\u82F1\u4EA9\u3002\u6821\u56ED\u5185\u5171\u5341\u4E09\u680B\u5927\u697C\uFF0C \u53EF\u5BB9\u7EB3\u4E00\u4E07\u540D\u5B66\u751F\u3002\u5927\u9A6C\u5206\u6821\u73B0\u6709\u5927\u7EA6\u56DB\u5343\u540D\u5B66\u751F\uFF0C\u8D85\u8FC7\u4E00\u534A\u4E3A\u5F53\u5730\u5B66\u751F\uFF0C \u4E09\u5206\u4E4B\u4E00\u662F\u4E2D\u56FD\u5B66\u751F\u3002\u9664\u4E2D\u533B\u5B66\u548C\u4E2D\u6587\u8BFE\u7A0B\u7528\u4E2D\u6587\u6559\u5B66\u5916\uFF0C \u5176\u4F59\u8BFE\u7A0B\u5747\u91C7\u7528\u82F1\u8BED\u6559\u5B66\u3002\u003C/p\u003E\n\u003Cp\u003E\u738B\u6559\u6388\u8BF4\uFF1A\u201C\u4E2D\u56FD\u6559\u80B2\u7684\u4F18\u70B9\u5728\u4E8E\u4ED6\u4EEC\u62E5\u6709\u6709\u7CFB\u7EDF\u7684\u5B66\u4E60\uFF0C\u6CE8\u91CD\u57FA\u7840\u6559\u80B2\uFF0C\n\u9F13\u52B1\u201C\u5FB7\u3001\u667A\u3001\u4F53\u201D \u5168\u9762\u53D1\u5C55\u3002\u5728\u5B66\u751F\u4F4F\u5BBF\u65B9\u9762\uFF0C \u53A6\u95E8\u5927\u5B66\u9A6C\u6765\u897F\u4E9A\u5206\u6821\u9075\u5FAA\u4E2D\u56FD\u5927\u5B66\u7684\u6A21\u5F0F\uFF0C\u4E3A\u6240\u6709\u7684\u5728\u6821\u751F\u63D0\u4F9B\u6574\u4E2A\u5B66\u4E60\u671F\u95F4\u7684\u4F4F\u5BBF\uFF0C\u6709\u5229\u4E8E\u5B66\u751F\u53D1\u5C55\u66F4\u591A\u7684\u793E\u56E2\u6D3B\u52A8\uFF0C \u53D1\u5C55\u66F4\u6DF1\u539A\u7684\u540C\u5B66\u60C5\u8C0A\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u201C\u5206\u6821\u7684\u7279\u8272\u4E4B\u4E00\u662F\u591A\u5143\u6587\u5316\u7684\u4EA4\u878D\u3002\u5F53\u5730\u5B66\u751F\u4ECE\u5177\u6709\u4E2D\u56FD\u5143\u7D20\u7684\u56FD\u9645\u5316\u6559\u5B66\u4E2D\u53D7\u76CA\uFF1B\u4ED6\u4EEC\u4E0D\u4EC5\u53D7\u5230\u4E2D\u56FD\u6559\u80B2\u7684\u5F71\u54CD\uFF0C\u540C\u65F6\uFF0C \u4ED6\u4EEC\u672C\u8EAB\u7684\u4F18\u70B9\u4E5F\u5F71\u54CD\u5176\u4ED6\u56FD\u5BB6\u7684\u5B66\u751F\u3002\u5F53\u5730\u7684\u5B66\u751F\u6CE8\u91CD\u793C\u4EEA\uFF0C\u82F1\u8BED\u597D\u3001\u52C7\u4E8E\u5229\u7528\u5404\u79CD\u673A\u4F1A\u53D1\u5C55\u81EA\u5DF1\u7684\u624D\u80FD\u3002\u6BD4\u5982\uFF0C\u5206\u6821\u6B63\u5F0F\u5F00\u8BFE\u4E4B\u65F6\uFF0C\u9996\u5C4A\u5B66\u751F\u51E0\u4E4E\u5168\u90E8\u662F\u5F53\u5730\u5B66\u751F\u3002\u4ED6\u4EEC\u4ECE\u65E0\u5230\u6709\u5730\u521B\u529E\u5404\u7C7B\u793E\u56E2\uFF0C\u4E89\u53D6\u7ECF\u8D39\u8D5E\u52A9\uFF0C\u4E3A\u4E4B\u540E\u5165\u5B66\u7684\u5B66\u751F\u7B56\u5212\u8FCE\u65B0\u6D3B\u52A8\u7B49\uFF0C\u8868\u73B0\u51FA\u4E00\u80A1\u79EF\u6781\u5411\u4E0A\u7684\u6D3B\u529B\u3002\u201C\u003C/p\u003E\n\u003Cp\u003E\u738B\u6559\u6388\u8868\u793A\uFF0C\u9A6C\u6765\u897F\u4E9A\u6559\u80B2\u90E8\u5BF9\u5206\u6821\u6709\u4E00\u4E2A\u201CMirror Policy\u201D \u7684\u8981\u6C42\uFF0C\u610F\u601D\u662F\u8BF4\u53A6\u95E8\u5927\u5B66\u9A6C\u6765\u897F\u4E9A\u5206\u6821\u7684\u5404\u4E2A\u4E13\u4E1A\u7684\u8BFE\u7A0B\uFF0C\u9996\u5148\u662F\u57FA\u4E8E\u5728\u4E2D\u56FD\u7684\u672C\u6821\u7684\u8BFE\u7A0B\u4F53\u7CFB\u3002\u540C\u65F6\uFF0C\u5206\u6821\u4F1A\u6839\u636E\u6559\u80B2\u90E8\u7684\u8981\u6C42\u52A0\u5165\u5176\u4ED6\u76F8\u5173\u7684\u5F53\u5730\u8BFE\u7A0B\uFF0C \u4F8B\u5982\u9A6C\u6765\u897F\u4E9A\u6587\u660E\u4E0E\u5386\u53F2, \u8054\u90A6\u5BAA\u6CD5\uFF0C\u548C\u9A6C\u6765\u6587\u8BFE\u3002\u6BCF\u4E00\u95E8\u8BFE\u90FD\u83B7\u5F97\u9A6C\u6765\u897F\u4E9A\u5B66\u672F\u8D44\u8D28\u9274\u5B9A\u673A\u6784 \uFF08MQA\uFF09\u548C\u6559\u80B2\u5C40\u7684\u8BA4\u8BC1\u3002\u53E6\u5916\uFF0C \u5DE5\u7A0B\u7C7B\u7684\u5B66\u79D1\u4E5F\u7533\u8BF7\u5230\u4E86\u9A6C\u6765\u897F\u4E9A\u5DE5\u7A0B\u5E08\u5B66\u4F1A\u7684\u8BA4\u8BC1\u3002\u003C/p\u003E\n\u003Cp\u003E\u738B\u6559\u6388\u8BF4\uFF0C\u5206\u6821\u548C\u4E2D\u56FD\u7684\u672C\u6821\u4FDD\u6301\u7740\u5BC6\u5207\u7684\u5173\u7CFB\uFF0C\n\u4EE5\u201C\u5171\u4EAB\u53CC\u8D62\u201C\u7684\u7406\u5FF5\u8FDB\u884C\u53CC\u8FB9\u5408\u4F5C\u3002\u5728\u6559\u5B66\u80B2\u4EBA\u65B9\u9762\uFF0C\u672C\u6821\u9009\u6D3E\u5404\u79D1\u4F18\u79C0\u7684\u6559\u5E08\u5230\u5206\u6821\u4E0A\u8BFE\uFF0C\u8FD9\u4E9B\u6559\u5E08\u5728\u5206\u6821\u7684\u73AF\u5883\u91CC\u4E5F\u63D0\u5347\u4E86\u5168\u82F1\u6587\u6559\u5B66\u7684\u80FD\u529B\u3001\u4E30\u5BCC\u4E86\u57F9\u517B\u56FD\u9645\u4EBA\u624D\u7684\u7ECF\u9A8C\u3002\u5B66\u672F\u79D1\u7814\u65B9\u9762\uFF0C\u5206\u6821\u7684\u6559\u5E08\u4F9D\u6258\u672C\u6821\u96C4\u539A\u7684\u79D1\u7814\u57FA\u7840\u548C\u5148\u8FDB\u7684\u79D1\u7814\u8BBE\u5907\u5F00\u5C55\u76F8\u5173\u9886\u57DF\u7684\u7814\u7A76\uFF1B\u5728\u521B\u65B0\u521B\u4E1A\u65B9\u9762\uFF0C\u5206\u6821\u7684\u5B66\u751F\u901A\u8FC7\u672C\u6821\u53C2\u52A0\u4E2D\u56FD\u5404\u7C7B\u7684\u5B66\u79D1\u7ADE\u8D5B\u548C\u521B\u65B0\u521B\u4E1A\u6BD4\u8D5B\uFF0C\u5E76\u53D6\u5F97\u7406\u60F3\u7684\u6210\u7EE9\u3002\u003C/p\u003E\n\u003Cp\u003E\u5979\u8868\u793A\uFF0C\u9A6C\u6765\u897F\u4E9A\u5F53\u5730\u5B66\u751F\u4E5F\u4ECE\u8FD9\u79CD\u53CC\u8FB9\u5408\u4F5C\u4E2D\u53D7\u76CA\u3002\u4ED6\u4EEC\u80FD\u591F\u63A5\u89E6\u5230\u672C\u6821\u6765\u5206\u6821\u4E0A\u8BFE\u7684\u4F18\u79C0\u6559\u5E08\uFF0C\u9664\u4E86\u5B66\u4E60\u8BFE\u7A0B\u77E5\u8BC6\uFF0C\u540C\u65F6\u8FD8\u6709\u673A\u4F1A\u63A5\u53D7\u79D1\u5B66\u7814\u7A76\u6216\u8005\u521B\u65B0\u521B\u4E1A\u65B9\u9762\u7684\u6307\u5BFC\u3002\u53A6\u95E8\u5927\u5B66\u672C\u6821\u5386\u6765\u9F13\u52B1\u6559\u5E08\u6307\u5BFC\u672C\u79D1\u751F\u8FDB\u884C\u79D1\u7814\uFF0C\u8FD9\u5BF9\u9A6C\u6765\u897F\u4E9A\u5B66\u751F\u4F86\u8BF4\u662F\u4E2A\u4F77\u597D\u7684\u653F\u7B56\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u56E0\u6B64\u6211\u4EEC\u76EE\u524D\u8FD8\u662F\u4EE5\u672C\u79D1\u6559\u80B2\u4E3A\u4E3B\uFF0C\u7855\u58EB\u548C\u535A\u58EB\u8BFE\u7A0B\u6B63\u5728\u9010\u6B65\u5730\u7B79\u5907\u4E4B\u4E2D\u3002\u53EF\u8CC0\u7684\u662F\uFF0C\u76EE\u524D\u5DF2\u7ECF\u6709\u5206\u6821\u7684\u672C\u79D1\u751F\u4F5C\u4E3A\u7B2C\u4E00\u4F5C\u8005\u6216\u8005\u5408\u4F5C\u8005\u5728\u56FD\u9645\u6709\u4E00\u5B9A\u5F71\u54CD\u529B\u7684\u5B66\u672F\u520A\u7269\u4E0A\u53D1\u8868\u8BBA\u6587\u3002\u5728\u521B\u65B0\u521B\u4E1A\u65B9\u9762\uFF0C\u4E5F\u5DF2\u7ECF\u6709\u5F53\u5730\u5B66\u751F\u9886\u961F\u7684\u56E2\u4F53\u83B7\u5F97\u4E2D\u56FD \u201D\u4E92\u8054\u7F51\u002B\u201C \u5927\u5B66\u751F\u521B\u65B0\u521B\u4E1A\u6BD4\u8D5B\u56FD\u9645\u8D5B\u9053\u7684\u94F6\u5956\u3002\u201C\u003C/p\u003E\n\u003Cp\u003E\u5185\u5BB9\u4F86\u6E90\uFF1A\u003Ca href=\u0022https://www.investkl.gov.my/Success_Stories-@-%