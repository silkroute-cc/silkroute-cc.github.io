  "route": "/3271/",
  "title": "CIDB\u603B\u6267\u884C\u957F: \u56FD\u884C\u5347\u606F\u5F71\u54CD\u5EFA\u7B51\u4E1A \u5EFA\u7B51\u4E1A\u7F3A40\u4E07\u5DE5\u4EBA",
  "summary": "\uFF08\u5409\u9686\u57617\u65E5\u8BAF\uFF09\u5C3D\u7BA1\u56FD\u5BB6\u7ECF\u6D4E\u5728\u5927\u6D41\u884C\u540E\u9010\u6E10\u590D\u82CF\uFF0C\u60DF\u57FA\u4E8E\u4EBA\u529B\u77ED\u7F3A\uFF0C\u539F\u6599\u6210\u672C\u4E0A\u6DA8\uFF0C\u5229\u7387\u4E0A\u626C\u53CA\u9A6C\u5E01\u8D70\u5F31\u800C\u51B2\u51FB\u672C\u5730\u5EFA\u7B51\u9886\u57DF\u3002 \u9A6C\u6765\u897F\u4E9A\u5EFA\u7B51\u5DE5\u4E1A\u53D1\u5C55\u5C40\uFF08CIDB\uFF09\u603B\u6267\u884C\u957F\u963F\u672B\u963F\u65AF\u91CC\u8BF4\uFF0C\u56FD\u5BB6\u94F6\u884C\u4E00\u7CFB\u5217\u7684\u4E0A\u8C03\u9694\u591C\u653F\u7B56\u5229\u7387\u5DF2\u5BF9\u5EFA\u7B51\u4E1A\u9020\u6210\u5F71\u54CD\u3002 \u201C\u66F4\u9AD8\u7684\u9694\u591C\u653F\u7B56\u5229\u7387\u610F\u5473\u7740\u6D88\u8D39\u4EBA\uFF0C\u5305\u62EC\u627F\u5305\u5546\u7684\u501F\u8D37\u6210\u672C\u53D8\u5F97\u66F4\u8D35\uFF1B\u968F\u7740\u56FD\u884C\u63D0\u9AD8\u9694\u591C\u653F\u7B56\u5229\u7387\uFF0C\u94F6\u884C\u5C06\u91CD\u65B0\u68C0\u8BA8\u6210\u672C\uFF0C\u5BFC\u81F4\u4F01\u4E1A\u9762\u5BF9\u66F4\u9AD8\u7684\u501F\u8D37\u5229\u606F\u3002\u201D \u963F\u672B\u963F\u65AF\u91CC\u63A5\u53D7\u9A6C\u65B0\u793E\u8BBF\u95EE\u65F6\u8BF4\uFF0C\u66F4\u9AD8\u7684\u6210\u672C\u4E5F\u9650\u5236\u4E86\u5546\u4E1A\u7684\u8D44\u672C\u6765\u6E90\u3002 \u5EFA\u7B51\u4E1A\u7F3A40\u4E07\u5DE5\u4EBA \u56FD\u2026",
  "body": "\u003Cp\u003E\uFF08\u5409\u9686\u57617\u65E5\u8BAF\uFF09\u5C3D\u7BA1\u56FD\u5BB6\u7ECF\u6D4E\u5728\u5927\u6D41\u884C\u540E\u9010\u6E10\u590D\u82CF\uFF0C\u60DF\u57FA\u4E8E\u4EBA\u529B\u77ED\u7F3A\uFF0C\u539F\u6599\u6210\u672C\u4E0A\u6DA8\uFF0C\u5229\u7387\u4E0A\u626C\u53CA\u9A6C\u5E01\u8D70\u5F31\u800C\u51B2\u51FB\u672C\u5730\u5EFA\u7B51\u9886\u57DF\u3002\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u5EFA\u7B51\u5DE5\u4E1A\u53D1\u5C55\u5C40\uFF08CIDB\uFF09\u603B\u6267\u884C\u957F\u963F\u672B\u963F\u65AF\u91CC\u8BF4\uFF0C\u56FD\u5BB6\u94F6\u884C\u4E00\u7CFB\u5217\u7684\u4E0A\u8C03\u9694\u591C\u653F\u7B56\u5229\u7387\u5DF2\u5BF9\u5EFA\u7B51\u4E1A\u9020\u6210\u5F71\u54CD\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u66F4\u9AD8\u7684\u9694\u591C\u653F\u7B56\u5229\u7387\u610F\u5473\u7740\u6D88\u8D39\u4EBA\uFF0C\u5305\u62EC\u627F\u5305\u5546\u7684\u501F\u8D37\u6210\u672C\u53D8\u5F97\u66F4\u8D35\uFF1B\u968F\u7740\u56FD\u884C\u63D0\u9AD8\u9694\u591C\u653F\u7B56\u5229\u7387\uFF0C\u94F6\u884C\u5C06\u91CD\u65B0\u68C0\u8BA8\u6210\u672C\uFF0C\u5BFC\u81F4\u4F01\u4E1A\u9762\u5BF9\u66F4\u9AD8\u7684\u501F\u8D37\u5229\u606F\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u963F\u672B\u963F\u65AF\u91CC\u63A5\u53D7\u9A6C\u65B0\u793E\u8BBF\u95EE\u65F6\u8BF4\uFF0C\u66F4\u9AD8\u7684\u6210\u672C\u4E5F\u9650\u5236\u4E86\u5546\u4E1A\u7684\u8D44\u672C\u6765\u6E90\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5EFA\u7B51\u4E1A\u7F3A40\u4E07\u5DE5\u4EBA\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u56FD\u884C\u4E8E11\u67084\u65E5\u5BA3\u5E03\u9694\u591C\u653F\u7B56\u5229\u7387\u4E0A\u8C0325\u4E2A\u57FA\u70B9\u81F32.75%\uFF0C\u8FD9\u4E5F\u662F\u81EA\u4ECA\u5E745\u6708\u8FDE\u7EED\u7B2C4\u6B21\u8C03\u9AD8\u9694\u591C\u653F\u7B56\u5229\u7387\u3002\u003C/p\u003E\n\u003Cp\u003E\u963F\u672B\u963F\u65AF\u91CC\u8BF4\uFF0C \u968F\u7740\u6211\u56FD\u75AB\u60C5\u8FDB\u5165\u5730\u65B9\u75C5\u9636\u6BB5\uFF0C\u6240\u6709\u5EFA\u7B51\u5DE5\u5730\u53EF\u4EE5\u5728\u6CA1\u6709\u4E25\u683C\u7684\u6807\u51C6\u4F5C\u4E1A\u7A0B\u5E8F\u4E0B\u8FD0\u4F5C\uFF0C\u8FD9\u4E5F\u5BFC\u81F4\u5EFA\u7B51\u6D3B\u52A8\u6FC0\u589E\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u81F3\u4ECA\u5EFA\u7B51\u4E1A\u4F30\u8BA1\u5C1A\u7F3A\u4E4F40\u4E07\u540D\u5DE5\u4EBA\uFF0C\u9A6C\u6765\u897F\u4E9A\u5EFA\u7B51\u53D1\u5C55\u5DE5\u4E1A\u5C40\u4E0E\u5EFA\u7B51\u4E1A\u516C\u4F1A\u53CA\u4EBA\u529B\u8D44\u6E90\u90E8\u5BC6\u5207\u5408\u4F5C\uFF0C\u4EE5\u89E3\u51B3\u8BE5\u95EE\u9898\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u901F\u89E3\u51B3\u5916\u52B3\u77ED\u7F3A\u95EE\u9898\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u56FD\u5BB6\u590D\u82CF\u7406\u4E8B\u4F1A\u65E5\u524D\u4FC3\u8BF7\u653F\u5E9C\u5C3D\u5FEB\u89E3\u51B3\u5916\u52B3\u77ED\u7F3A\u95EE\u9898\u3002\u003C/p\u003E\n\u003Cp\u003E\u56FD\u5BB6\u590D\u82CF\u7406\u4E8B\u4F1A\u603B\u6267\u884C\u957F\u4E39\u65AF\u91CC\u82CF\u83B1\u66FC\u8BF4\uFF0C\u622A\u81F3\u4ECA\u5E749\u670812\u65E5\uFF0C\u7F34\u4ED8\u4EBA\u5934\u7A0E\u6570\u636E\u4E0E\u6279\u51C6\u56FA\u6253\u663E\u793A\u6279\u51C646\u4E077223\u540D\u5916\u52B3\uFF0C\u4E0D\u8FC7\uFF0C\u4E0E\u6B64\u540C\u65F6\uFF0C\u7EAA\u5F55\u663E\u793A\u540C\u671F\u4EC5\u67097\u4E076000\u540D\u5916\u52B3\u62B5\u8FBE\u6211\u56FD\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u4EEC\u53D1\u73B0\uFF0C\u8BB8\u591A\u5916\u52B3\u63D0\u51FA\u7533\u8BF7\u53CA\u4ED8\u8D39\uFF0C\u60DF\u62B5\u6B65\u8005\u5374\u975E\u5E38\u5C11\uFF0C\u95EE\u9898\u662F\uFF0C\u4E3A\u4F55\u4ED6\u4EEC\u4E0D\u6765\u5DE5\u4F5C\uFF1F\u003C/p\u003E\n\u003Cp\u003E\u201C\u8FD9\u662F\u5426\u6D89\u53CA\u4ED6\u4EEC\u56FD\u5BB6\u7684\u95EE\u9898\u6216\u5176\u4ED6\u539F\u56E0\uFF1F\u5FC5\u987B\u5173\u6CE8\u8FD9\u9879\u8BFE\u9898\uFF0C\u5426\u5219\u519C\u4E1A\u9886\u57DF\uFF0C\u5C24\u5176\u662F\u6CB9\u68D5\u4E5F\u53D7\u5230\u76F4\u63A5\u5F71\u54CD\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u52B3\u5DE5\u5BC6\u96C6\u9886\u57DF\u5982\u5236\u9020\u4E1A\u3001\u65C5\u6E38\u3001\u96F6\u552E\u3001\u7535\u5668\u4E0E\u519C\u4E1A\u4E5F\u53D7\u5230\u4EBA\u529B\u77ED\u7F3A\u95EE\u9898\u6240\u5F71\u54CD\u3002\u003C/p\u003E\n\u003Cp\u003E\u963F\u672B\u963F\u65AF\u91CC\u6307\u51FA\uFF0C\u9A6C\u5E01\u5151\u7F8E\u5143\u81EA\u4ECA\u5E743\u6708\u5F00\u59CB\u8D70\u5F31\uFF0C1\u7F8E\u5143\u5151\u9A6C\u5E01\u4ECE4\u4EE4\u540920\u4ED9\u8C03\u5347\u81F310\u6708\u4EFD\u76844\u4EE4\u540972\u4ED9\uFF0C\u5BFC\u81F4\u7269\u4EF7\u53CA\u8236\u6765\u54C1\u4EF7\u683C\u66F4\u9AD8\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u4EEC\u5E0C\u671B\u672A\u6765\u53EF\u5DE9\u56FA\u9A6C\u5E01\uFF0C\u4F7F\u60C5\u51B5\u53D8\u597D\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u5728\u9762\u5411\u672A\u6765\uFF0C\u963F\u672B\u963F\u65AF\u91CC\u8BF4\uFF0C\u5EFA\u7B51\u4E1A\u5728\u672A\u6765\u4E24\u5E74\u7684\u8868\u73B0\u9884\u6599\u5C06\u6301\u7EED\u53D1\u5C55\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u5EFA\u7B51\u4E1A\u5C1A\u5904\u4E8E\u590D\u82CF\u8FC7\u7A0B\uFF0C\u627F\u5305\u5546\u9664\u4E86\u9762\u5BF9\u73B0\u91D1\u6D41\u53CA\u5458\u5DE5\u4F4F\u5BBF\u6210\u672C\u95EE\u9898\uFF0C\u5176\u4ED6\u4E3B\u8981\u6311\u6218\u4E3A\u591A\u79CD\u5EFA\u6750\u4EF7\u683C\u4E0A\u5347\u3001\u7F3A\u4E4F\u4EBA\u529B\u3001\u8C03\u9AD8\u6700\u4F4E\u85AA\u91D1\u5236\u7B49\u3002\u003C/p\u003E\n\u003Cp\u003E\n\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/s-3RIOgU2B5eoYKQxcGmDw\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
