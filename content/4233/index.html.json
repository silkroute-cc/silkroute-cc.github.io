  "id": "%e6%98%a5%e9%a3%8e%e5%8a%b2%e8%8d%89%e5%8d%97%e6%b4%8b%e5%b9%b4%e7%94%bb%e5%b1%95%e5%9c%a8%e5%90%89%e9%9a%86%e5%9d%a1%e4%b8%ad%e5%9b%bd%e6%96%87%e5%8c%96%e4%b8%ad%e5%bf%83%e5%bc%80",
  "slug": "%e6%98%a5%e9%a3%8e%e5%8a%b2%e8%8d%89%e5%8d%97%e6%b4%8b%e5%b9%b4%e7%94%bb%e5%b1%95%e5%9c%a8%e5%90%89%e9%9a%86%e5%9d%a1%e4%b8%ad%e5%9b%bd%e6%96%87%e5%8c%96%e4%b8%ad%e5%bf%83%e5%bc%80",
  "canonicalUrlKey": "%e6%98%a5%e9%a3%8e%e5%8a%b2%e8%8d%89%e5%8d%97%e6%b4%8b%e5%b9%b4%e7%94%bb%e5%b1%95%e5%9c%a8%e5%90%89%e9%9a%86%e5%9d%a1%e4%b8%ad%e5%9b%bd%e6%96%87%e5%8c%96%e4%b8%ad%e5%bf%83%e5%bc%80",
  "route": "/4233/",
  "title": "\u201C\u6625\u98CE\u52B2\u8349\u201D\u5357\u6D0B\u5E74\u753B\u5C55\u5728\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u5F00\u5E55",
  "summary": "11\u670829\u65E5\u4E0A\u5348\uFF0C\u201C\u6625\u98CE\u52B2\u8349\u201D\u5357\u6D0B\u5E74\u753B\u5C55\u5728\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u5F00\u5E55\u3002 \u6B64\u6B21\u5C55\u89C8\u5171\u5C55\u51FA31\u4F4D\u9A6C\u6765\u897F\u4E9A\u4E66\u753B\u5BB6\u768461\u5E45\u5E74\u753B\uFF0C\u4EE5\u201C\u6625\u98CE\u52B2\u8349\u201D\u4E3A\u4E3B\u9898\u65E8\u5728\u4F53\u73B0\u91CE\u8349\u987D\u5F3A\u822C\u7684\u827A\u672F\u7CBE\u795E\uFF0C\u5F18\u626C\u4E1C\u65B9\u4E4B\u4E66\u3001\u753B\u3001\u7BC6\u523B\u827A\u672F\uFF0C\u63A8\u52A8\u6380\u8D77\u201C\u5357\u6D0B\u5E74\u753B\u98CE\u201D\uFF0C\u79EF\u6781\u5F15\u9886\u201C\u5BB6\u5BB6\u8D34\u5E74\u753B\u201D\u7684\u65B0\u98CE\u5C1A\u3002 \u9A6C\u6765\u897F\u4E9A\u56FD\u4F1A\u8BAE\u5458\u3001\u524D\u539F\u4EA7\u4E1A\u90E8\u957F\u90ED\u7D20\u6C81\u3001\u8349\u5802\u95E8\u91D1\u77F3\u4E66\u753B\u4F1A\u4F1A\u957F\u8C22\u5FDD\u5B8B\u3001\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u4E3B\u4EFB\u5F20\u6770\u946B\u3001\u753B\u5C55\u5DE5\u59D4\u4F1A\u4E3B\u5E2D\u6797\u7ECF\u5E73\u3001\u987E\u95EE\u7F57\u7AE0\u6B66\uFF0C\u4EE5\u53CA\u8349\u5802\u95E8\u91D1\u77F3\u4E66\u753B\u4F1A\u7406\u4E8B\u3001\u53C2\u5C55\u827A\u672F\u5BB6\u3001\u5E74\u753B\u7231\u597D\u8005\u4E0E\u5A92\u4F53\u7B49\u8FD1\u767E\u4F4D\u6765\u81EA\u5404\u754C\u7684\u5609\u5BBE\u51FA\u5E2D\u5F00\u5E55\u6D3B\u52A8\u3002\u9A6C\u6765\u897F\u2026",
  "body": "\u003Cp\u003E11\u670829\u65E5\u4E0A\u5348\uFF0C\u201C\u6625\u98CE\u52B2\u8349\u201D\u5357\u6D0B\u5E74\u753B\u5C55\u5728\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u5F00\u5E55\u3002\u003C/p\u003E\n\u003Cp\u003E\u6B64\u6B21\u5C55\u89C8\u5171\u5C55\u51FA31\u4F4D\u9A6C\u6765\u897F\u4E9A\u4E66\u753B\u5BB6\u768461\u5E45\u5E74\u753B\uFF0C\u4EE5\u201C\u6625\u98CE\u52B2\u8349\u201D\u4E3A\u4E3B\u9898\u65E8\u5728\u4F53\u73B0\u91CE\u8349\u987D\u5F3A\u822C\u7684\u827A\u672F\u7CBE\u795E\uFF0C\u5F18\u626C\u4E1C\u65B9\u4E4B\u4E66\u3001\u753B\u3001\u7BC6\u523B\u827A\u672F\uFF0C\u63A8\u52A8\u6380\u8D77\u201C\u5357\u6D0B\u5E74\u753B\u98CE\u201D\uFF0C\u79EF\u6781\u5F15\u9886\u201C\u5BB6\u5BB6\u8D34\u5E74\u753B\u201D\u7684\u65B0\u98CE\u5C1A\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/11/frc-448cc567ee720b802bc001a088dbc462.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u56FD\u4F1A\u8BAE\u5458\u3001\u524D\u539F\u4EA7\u4E1A\u90E8\u957F\u90ED\u7D20\u6C81\u3001\u8349\u5802\u95E8\u91D1\u77F3\u4E66\u753B\u4F1A\u4F1A\u957F\u8C22\u5FDD\u5B8B\u3001\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u4E3B\u4EFB\u5F20\u6770\u946B\u3001\u753B\u5C55\u5DE5\u59D4\u4F1A\u4E3B\u5E2D\u6797\u7ECF\u5E73\u3001\u987E\u95EE\u7F57\u7AE0\u6B66\uFF0C\u4EE5\u53CA\u8349\u5802\u95E8\u91D1\u77F3\u4E66\u753B\u4F1A\u7406\u4E8B\u3001\u53C2\u5C55\u827A\u672F\u5BB6\u3001\u5E74\u753B\u7231\u597D\u8005\u4E0E\u5A92\u4F53\u7B49\u8FD1\u767E\u4F4D\u6765\u81EA\u5404\u754C\u7684\u5609\u5BBE\u51FA\u5E2D\u5F00\u5E55\u6D3B\u52A8\u3002\u9A6C\u6765\u897F\u4E9A\u901A\u8BAF\u4E0E\u6570\u5B57\u90E8\u526F\u90E8\u957F\u5F20\u5FF5\u7FA4\u4E3A\u5C55\u89C8\u53D1\u6765\u8D3A\u4FE1\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/11/frc-a9ea590ff691d10e118a15a284ea8403.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u90ED\u7D20\u6C81\u56FD\u4F1A\u8BAE\u5458\u81F4\u8F9E\u8868\u793A\uFF0C\u5E74\u753B\u662F\u5E74\u7684\u8C61\u5F81\uFF0C\u519C\u5386\u65B0\u5E74\u548C\u5176\u4ED6\u6C11\u65CF\u7684\u4F20\u7EDF\u4F73\u8282\u4E00\u6837\uFF0C\u4E0D\u4EC5\u662F\u9A6C\u6765\u897F\u4E9A\u6CD5\u5B9A\u5047\u65E5\uFF0C\u4E5F\u662F\u5404\u65CF\u88D4\u6C11\u4F17\u5171\u540C\u5E86\u795D\u7684\u8282\u65E5\u3002\u6B64\u6B21\u5357\u6D0B\u5E74\u753B\u5C55\u672C\u571F\u6587\u5316\u6C14\u606F\u6D53\u90C1\uFF0C\u5C55\u793A\u4E86\u5927\u9A6C\u534E\u4EBA\u4F20\u627F\u5E76\u5EF6\u7EED\u81F3\u4ECA\u7684\u8FCE\u6625\u4E60\u4FD7\uFF0C\u8FD9\u662F\u9A6C\u6765\u897F\u4E9A\u65CF\u7FA4\u548C\u7766\u76F8\u5904\u7684\u8C61\u5F81\uFF0C\u4E5F\u662F\u9A6C\u6765\u897F\u4E9A\u6587\u5316\u591A\u5143\u878D\u5408\u7684\u91CD\u8981\u4F53\u73B0\u3002\u5E0C\u671B\u901A\u8FC7\u672C\u6B21\u753B\u5C55\u7684\u4E3E\u529E\uFF0C\u8BA9\u4F20\u7EDF\u5E74\u753B\u827A\u672F\u8D70\u8FDB\u793E\u533A\uFF0C\u8BA9\u66F4\u591A\u5E74\u8F7B\u4EBA\u548C\u5404\u65CF\u88D4\u4E86\u89E3\u4E2D\u534E\u4F20\u7EDF\u6587\u5316\uFF0C\u4FC3\u8FDB\u7766\u90BB\u53CB\u597D\u548C\u8C10\uFF0C\u8425\u9020\u559C\u5E86\u548C\u8C10\u7684\u65B0\u6625\u8282\u65E5\u6C14\u6C1B\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/11/frc-e47994059d38e1b52dfcb48b27b2b1d2.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u8C22\u5FDD\u5B8B\u4F1A\u957F\u4ECB\u7ECD\u9053\uFF0C\u201C\u5357\u6D0B\u98CE\u683C\u201D\u662F\u7531\u4E00\u7FA4\u534E\u88D4\u79FB\u6C11\u753B\u5BB6\u81EA1929\u5E74\u521B\u529E\u7684\u201C\u5357\u6D0B\u4E66\u753B\u793E\u201D\u5F00\u59CB\uFF0C\u7EED\u800C1938\u5E74\u6210\u7ACB\u4E86\u201C\u5357\u6D0B\u7F8E\u672F\u4E13\u79D1\u5B66\u6821\u201D\uFF0C\u81F4\u529B\u4E2D\u897F\u7F8E\u672F\u6559\u80B2\u7684\u57F9\u517B\uFF0C\u5E76\u572850\u5E74\u4EE3\u8BDE\u751F\u7684\u65B0\u753B\u79CD\u3001\u65B0\u98CE\u683C\u3002\u672C\u6B21\u5C55\u89C8\u5C06\u4F20\u7EDF\u5E74\u753B\u4E1C\u65B9\u6587\u5316\u7CBE\u795E\u878D\u5165\u672C\u571F\u591A\u5143\u6587\u5316\u751F\u6D3B\uFF0C\u5180\u671B\u4EE5\u6B64\u542F\u53D1\u5404\u6C11\u65CF\u5728\u4EA4\u878D\u4E2D\u5171\u521B\u672A\u6765\uFF0C\u548C\u8C10\u5171\u5904\uFF0C\u517C\u6536\u5E76\u84C4\uFF0C\u4EE5\u5E26\u6765\u660C\u76DB\u7684\u53D1\u5C55\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/11/frc-f767ffcc4407794965aea0f5f9ede5ee.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5F20\u6770\u946B\u4E3B\u4EFB\u81F4\u8F9E\u8868\u793A\uFF0C\u201C\u4E0B\u5357\u6D0B\u201D\u4ECE\u660E\u4EE3\u4E2D\u53F6\u5F00\u59CB\uFF0C\u6301\u7EED\u8FD1300\u5E74\u3002\u8FD1\u4EE3\u4EE5\u6765\uFF0C\u5927\u91CF\u534E\u4EBA\u79FB\u5C45\u4E1C\u5357\u4E9A\uFF0C\u6781\u5927\u5730\u63A8\u52A8\u4E86\u4E1C\u5357\u4E9A\u5404\u56FD\u7684\u53D1\u5C55\u3002\u9A6C\u6765\u897F\u4E9A\u534E\u4EBA\u7F8E\u672F\u6B63\u662F\u5728\u8FD9\u6837\u7684\u6587\u5316\u571F\u58E4\u4E2D\u8301\u58EE\u6210\u957F\uFF0C\u5438\u6536\u4E86\u5357\u6D0B\u7684\u7075\u611F\uFF0C\u4EE5\u81EA\u5DF1\u72EC\u7279\u7684\u827A\u672F\u8BED\u8A00\uFF0C\u5C55\u793A\u51FA\u4E86\u6DF1\u539A\u7684\u827A\u672F\u9020\u8BE3\u3002\u5176\u53D1\u5C55\u5386\u7A0B\u5C31\u5982\u6625\u98CE\u52B2\u8349\uFF0C\u59CB\u7EC8\u6CA1\u6709\u8FDC\u79BB\u4E2D\u56FD\u4F20\u7EDF\uFF0C\u53C8\u4E0D\u5FD8\u521B\u65B0\uFF0C\u4E00\u76F4\u4FDD\u6301\u7740\u5BF9\u5357\u6D0B\u753B\u98CE\u7684\u8FFD\u6C42\uFF0C\u4F53\u73B0\u4E86\u5BF9\u4E2D\u534E\u6587\u5316\u4F20\u627F\u7684\u7684\u575A\u5B88\u548C\u7CBE\u795E\u8FFD\u6C42\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/11/frc-949daa7df1f3097cecd234f13550c86a.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u6797\u7ECF\u5E73\u4E3B\u5E2D\u8868\u793A\uFF0C\u5C55\u89C8\u662F\u4E00\u573A\u4F20\u7EDF\u65B0\u751F\u7684\u827A\u672F\u76DB\u5BB4\uFF0C\u65E8\u5728\u5411\u4E16\u754C\u5C55\u793A\u9A6C\u6765\u897F\u4E9A\u534E\u4EBA\u7F8E\u672F\u7684\u72EC\u7279\u9B45\u529B\u548C\u6770\u51FA\u6210\u5C31\uFF0C\u5E0C\u671B\u4EE5\u8FD9\u72EC\u7279\u7684\u4E1C\u65B9\u6587\u5316\u827A\u672F\u5F62\u5F0F\uFF0C\u7CBE\u6E5B\u5448\u73B0\u5357\u6D0B\u5730\u533A\u4E30\u5BCC\u7684\u591A\u5143\u6587\u5316\u548C\u5386\u53F2\u4F20\u7EDF\u5143\u7D20\u3002\u003C/p\u003E\n\u003Cp\u003E\u5F20\u5FF5\u7FA4\u526F\u90E8\u957F\u5728\u8D3A\u8BCD\u4E2D\u8D5E\u626C\u8349\u5802\u95E8\u4F1A\u5458\u5728\u9A6C\u6765\u897F\u4E9A\u591A\u5143\u6587\u5316\u793E\u4F1A\u7684\u56FD\u5EA6\u91CC\uFF0C\u5B5C\u5B5C\u4E0D\u5026\u4E13\u7814\u4E1C\u65B9\u827A\u672F\uFF0C\u9ED8\u9ED8\u8015\u8018\u5982\u8349\u6839\u6DF1\u624E\u6CE5\u5730\uFF0C\u91CE\u706B\u70E7\u4E0D\u5C3D\uFF0C\u6625\u98CE\u5439\u53C8\u751F\uFF0C\u5EF6\u7EED\u672C\u571F\u4F20\u7EDF\u6587\u5316\u3002\u6765\u5230\u591A\u5A92\u4F53\u65F6\u4EE3\uFF0C\u8349\u5802\u95E8\u63A8\u51FA\u5728\u7EBF\u9500\u552E\u5E73\u53F0\uFF0C\u76FC\u4E0E\u56FD\u9645\u94FE\u63A5\uFF0C\u6253\u5F00\u9A6C\u6765\u897F\u4E9A\u5357\u6D0B\u98CE\u683C\u827A\u672F\u5E02\u573A\uFF0C\u628A\u5927\u9A6C\u72EC\u7279\u7684\u5357\u6D0B\u753B\u98CE\u4ECB\u7ECD\u7ED9\u5168\u4E16\u754C\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/11/frc-6865b810d5df65c105f23226b72188d4.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u6B64\u5916\uFF0C\u4E3B\u529E\u65B9\u8FD8\u7279\u522B\u63A8\u51FA\u300A\u7CBE\u88C5\u7248\u5E74\u753B\u300B\u753B\u518C\uFF0C\u6309\u753B\u4F5C\u539F\u6BD4\u4F8B\u590D\u5236\u4EFF\u771F\u7CBE\u54C1\u5957\u88C5\uFF0C\u65E2\u662F\u65B0\u6625\u591A\u5143\u827A\u672FIP\u8D60\u54C1\uFF0C\u4E5F\u662F\u5927\u9A6C\u4F73\u8282\u5927\u793C\u5305\u3002\u003C/p\u003E\n\u003Cp\u003E\u5C55\u89C8\u7531\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u4E0E\u8349\u5802\u95E8\u91D1\u77F3\u4E66\u753B\u4F1A\u8054\u5408\u4E3B\u529E\uFF0C\u4F5C\u4E3A\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC32024\u201C\u6B22\u4E50\u6625\u8282\u201D\u7CFB\u5217\u6D3B\u52A8\u7684\u9996\u4E2A\u9879\u76EE\uFF0C\u5C55\u89C8\u5C06\u6301\u7EED\u52302024\u5E741\u67084\u65E5\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/11/frc-9cadad6504debcbc6c88793177429851.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u66F4\u591A\u7CBE\u5F69\uFF0C\u656C\u8BF7\u5173\u6CE8\uFF1A\u003C/p\u003E\n\u003Cp\u003E\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5B98\u7F51\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003Ehttps://www.chinaculturalcentre.my\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EFacebook\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u201CChina Cultural Centre in Kuala Lumpur\u201D\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u516C\u4F17\u53F7\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u201C\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u201D\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EYoutube\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u201CChina Cultural Centre in Kuala Lumpur\u201D\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003ETiktok\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u201CCCCKL\u201D\u003C/p\u003E\n\u003Chr /\u003E\n\u003Cp\u003E- End -\n\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u957F\u6309\u8BC6\u522B\u4E8C\u7EF4\u7801\n\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u83B7\u53D6\u66F4\u591A\u7CBE\u5F69\u5185\u5BB9\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u25BC\u003C/strong\u003E\n\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/11/frc-393d7a99f3f2b62d8101a4e46568d89f.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/11/frc-55a705354cac3bb838e283010202f339.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/11/frc-e592b6d7fcb0f17eb92480e99a800f61.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/11/frc-38bc8c97af1c04b93222b36dcb5bbbce.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/11/frc-66f61deeda48ac066eaadc74e0ff7ca