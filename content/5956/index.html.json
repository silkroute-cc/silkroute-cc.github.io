{
  "id": "\u963F\u672B\u624E\u5E0C\u5180\u9A6C\u4E2D\u5EF6\u4F38\u5408\u4F5C-\u5171\u5EFA\u7535\u52A8\u8F66\u4E0E\u65B0\u80FD\u6E90\u9886\u57DF",
  "slug": "\u963F\u672B\u624E\u5E0C\u5180\u9A6C\u4E2D\u5EF6\u4F38\u5408\u4F5C-\u5171\u5EFA\u7535\u52A8\u8F66\u4E0E\u65B0\u80FD\u6E90\u9886\u57DF",
  "canonicalUrlKey": "\u963F\u672B\u624E\u5E0C\u5180\u9A6C\u4E2D\u5EF6\u4F38\u5408\u4F5C-\u5171\u5EFA\u7535\u52A8\u8F66\u4E0E\u65B0\u80FD\u6E90\u9886\u57DF",
  "route": "/5956/",
  "title": "\u963F\u672B\u624E\u5E0C\u5180\u9A6C\u4E2D\u5EF6\u4F38\u5408\u4F5C \u5171\u5EFA\u7535\u52A8\u8F66\u4E0E\u65B0\u80FD\u6E90\u9886\u57DF",
  "summary": "\u526F\u9996\u76F8\u963F\u672B\u624E\u5E0C\u8868\u793A\uFF0C\u9A6C\u6765\u897F\u4E9A\u5DF2\u51C6\u5907\u6210\u4E3A\u4E2D\u56FD\u5728\u7535\u52A8\u8F66\u3001\u7535\u6C60\u6280\u672F\u3001\u53EF\u518D\u751F\u80FD\u6E90\u3001\u667A\u80FD\u5236\u9020\u548C\u4EBA\u624D\u57F9\u517B\u7B49\u5173\u952E\u9886\u57DF\u7684\u6218\u7565\u4F19\u4F34\u3002\u968F\u7740\u5168\u7403\u7535\u52A8\u8F66\u548C\u65B0\u80FD\u6E90\u7CFB\u7EDF\u52A0\u901F\u8F6C\u578B\uFF0C\u5927\u9A6C\u5E0C\u671B\u501F\u52A9\u4EA7\u4E1A\u5408\u4F5C\u3001\u6280\u804C\u6559\u80B2\u548C\u7EFF\u8272\u79FB\u52A8\u5E73\u53F0\uFF0C\u53C2\u4E0E\u533A\u57DF\u6E05\u6D01\u80FD\u6E90\u751F\u6001\u7CFB\u7EDF\u5EFA\u8BBE\u3002",
  "body": "\u003Cp\u003E\u526F\u9996\u76F8\u62FF\u7763\u65AF\u91CC\u963F\u672B\u624E\u5E0C\u535A\u58EB\u6307\u51FA\uFF0C\u9A6C\u6765\u897F\u4E9A\u5DF2\u505A\u597D\u51C6\u5907\u6210\u4E3A\u4E2D\u56FD\u5728\u591A\u4E2A\u5173\u952E\u884C\u4E1A\u9886\u57DF\u503C\u5F97\u4FE1\u8D56\u7684\u6218\u7565\u4F19\u4F34\uFF0C\u5305\u62EC\u7535\u52A8\u8F66\u3001\u7535\u6C60\u6280\u672F\u53CA\u53EF\u518D\u751F\u80FD\u6E90\uFF0C\u5E76\u5171\u540C\u6210\u4E3A\u672A\u6765\u589E\u957F\u7684\u771F\u6B63\u5F15\u64CE\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u6570\u5341\u5E74\u6765\u4E24\u56FD\u5173\u7CFB\u5DF2\u53D1\u5C55\u6210\u4E3A\u5F3A\u5927\u7684\u7ECF\u6D4E\u4F19\u4F34\u5173\u7CFB\uFF0C\u5E76\u7531\u8D38\u6613\u3001\u6295\u8D44\u3001\u5236\u9020\u4E1A\u3001\u57FA\u7840\u8BBE\u65BD\u3001\u79D1\u6280\u4EE5\u53CA\u6C11\u95F4\u4EA4\u6D41\u6240\u652F\u6491\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u5728\u9A6C\u6765\u897F\u4E9A-\u4E2D\u56FD\u7535\u52A8\u8F66\u3001\u7535\u6C60\u53CA\u65B0\u80FD\u6E90\u4EBA\u624D\u53D1\u5C55\u4E0E\u521B\u65B0\u8BBA\u575B\u4E0A\u81F4\u8BCD\u65F6\u8BF4\uFF0C\u968F\u7740\u4E16\u754C\u8FC8\u5165\u65B0\u5DE5\u4E1A\u65F6\u4EE3\uFF0C\u9A6C\u4E2D\u5FC5\u987B\u5F00\u59CB\u5171\u540C\u5EFA\u8BBE\u672A\u6765\u884C\u4E1A\uFF0C\u628A\u5408\u4F5C\u6269\u5C55\u5230\u7535\u52A8\u4EA4\u901A\u3001\u7535\u6C60\u6280\u672F\u3001\u53EF\u518D\u751F\u80FD\u6E90\u3001\u667A\u80FD\u5236\u9020\u3001\u6570\u5B57\u7CFB\u7EDF\u53CA\u4EBA\u624D\u57F9\u517B\u7B49\u9886\u57DF\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u53CC\u65B9\u5408\u4F5C\u6240\u5EFA\u7ACB\u7684\u4E0D\u4EC5\u662F\u53CC\u8FB9\u6210\u529F\uFF0C\u66F4\u80FD\u5F3A\u5316\u533A\u57DF\u4EF7\u503C\u94FE\u3001\u63A8\u52A8\u4E1C\u76DF\u5DE5\u4E1A\u8F6C\u578B\uFF0C\u5E76\u6253\u9020\u4E00\u4E2A\u5BF9\u9A6C\u4E2D\u53CA\u672C\u533A\u57DF\u672A\u6765\u5177\u6709\u6DF1\u8FDC\u610F\u4E49\u7684\u4F19\u4F34\u5173\u7CFB\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u963F\u672B\u624E\u5E0C\u8BF4\uFF0C\u5168\u7403\u6B63\u4EE5\u524D\u6240\u672A\u6709\u7684\u901F\u5EA6\u8FC8\u5411\u7535\u52A8\u8F66\u3001\u7535\u6C60\u6280\u672F\u4E0E\u65B0\u80FD\u6E90\u7CFB\u7EDF\u8F6C\u578B\uFF0C\u6210\u4E3A\u5F53\u4EE3\u6700\u91CD\u8981\u7684\u5DE5\u4E1A\u9769\u547D\u4E4B\u4E00\u3002\u4EC5\u57282025\u5E74\uFF0C\u5168\u7403\u7535\u52A8\u8F66\u9500\u91CF\u8FBE\u7EA62100\u4E07\u8F86\uFF0C\u5360\u5168\u7403\u65B0\u8F66\u9500\u91CF\u7684\u56DB\u5206\u4E4B\u4E00\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E2D\u56FD\u7EE7\u7EED\u5F15\u9886\u8FD9\u573A\u8F6C\u578B\uFF0C\u751F\u4EA7\u8D85\u8FC71600\u4E07\u8F86\u65B0\u80FD\u6E90\u6C7D\u8F66\uFF1B\u4E0E\u6B64\u540C\u65F6\uFF0C\u5728\u4E1C\u76DF\u516D\u56FD\uFF0C2025\u5E74\u99969\u4E2A\u6708\u7684\u7535\u52A8\u8F66\u53CA\u7535\u6C14\u5316\u8F66\u8F86\u9500\u91CF\u589E\u957F\u4E8662%\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6307\u51FA\uFF0C\u7535\u52A8\u8F66\u8F6C\u578B\u4E0D\u4EC5\u9650\u4E8E\u6C7D\u8F66\uFF0C\u8FD8\u6DB5\u76D6\u7535\u6C60\u3001\u5145\u7535\u57FA\u7840\u8BBE\u65BD\u3001\u534A\u5BFC\u4F53\u3001\u8F6F\u4EF6\u7CFB\u7EDF\u3001\u80FD\u6E90\u50A8\u5B58\u3001\u7535\u7F51\u51C6\u5907\u53CA\u5148\u8FDB\u5236\u9020\uFF0C\u662F\u5B8C\u6574\u7684\u751F\u6001\u7CFB\u7EDF\u3002\u003C/p\u003E\n\u003Cp\u003E\u5927\u9A6C\u5E0C\u671B\u6210\u4E3A\u533A\u57DF\u7535\u52A8\u8F66\u4E0E\u6E05\u6D01\u80FD\u6E90\u751F\u6001\u7CFB\u7EDF\u4E2D\u7684\u79EF\u6781\u53C2\u4E0E\u8005\u3002\u6839\u636E\u56FD\u5BB6\u4F4E\u78B3\u4EA4\u901A\u8BAE\u7A0B\uFF0C\u5927\u9A6C\u76EE\u6807\u662F\u57282030\u5E74\u524D\u8BA9\u7535\u52A8\u8F66\u5360\u6C7D\u8F66\u603B\u9500\u91CF\u768415%\uFF0C\u5E76\u57282050\u5E74\u8FBE\u523080%\u3002\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u6B63\u52A0\u5F3A\u6280\u804C\u6559\u80B2\u4E0E\u57F9\u8BAD\uFF08TVET\uFF09\uFF0C\u4EE5\u652F\u6301\u5148\u8FDB\u5236\u9020\u4E1A\u3001\u6570\u5B57\u7ECF\u6D4E\u3001\u7EFF\u8272\u79D1\u6280\u53CA\u80FD\u6E90\u8F6C\u578B\u4EA7\u4E1A\u3002\u963F\u672B\u624E\u5E0C\u8BF4\uFF0C\u9A6C\u6765\u897F\u4E9A\u8BA1\u5212\u521B\u902070\u4E07\u4E2A\u5236\u9020\u4E1A\u5C31\u4E1A\u673A\u4F1A\uFF0C\u4EE5\u53CA50\u4E07\u4E2A\u6570\u5B57\u7ECF\u6D4E\u9886\u57DF\u5C31\u4E1A\u673A\u4F1A\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u63D0\u53CA\uFF0C\u9A6C\u6765\u897F\u4E9A\u53BB\u5E74\u6279\u51C6\u7684\u6295\u8D44\u521B\u4E0B\u5386\u53F2\u65B0\u9AD8\uFF0C\u8FBE4267\u4EBF\u4EE4\u5409\uFF0C\u6D89\u53CA\u903E8000\u4E2A\u9879\u76EE\uFF0C\u9884\u8BA1\u521B\u9020\u7EA624\u4E075000\u4E2A\u5C31\u4E1A\u673A\u4F1A\uFF0C\u53CD\u6620\u5404\u754C\u5BF9\u5927\u9A6C\u7A33\u5B9A\u6027\u3001\u57FA\u7840\u8BBE\u65BD\u3001\u4EBA\u624D\u751F\u6001\u7CFB\u7EDF\u53CA\u957F\u671F\u653F\u7B56\u65B9\u5411\u7684\u4FE1\u5FC3\u65E5\u76CA\u589E\u5F3A\u3002\u003C/p\u003E\n\u003Cp\u003E\u963F\u672B\u624E\u5E0C\u4E5F\u6B22\u8FCE\u6210\u7ACB\u7EFF\u8272\u4E0E\u667A\u6167\u79FB\u52A8\u5408\u4F5C\u5E73\u53F0\uFF0C\u5E76\u5C06\u5176\u89C6\u4E3A\u6DF1\u5316\u7535\u52A8\u8F66\u3001\u7535\u6C60\u53CA\u65B0\u80FD\u6E90\u521B\u65B0\u7684\u91CD\u8981\u673A\u5236\u3002\u4ED6\u540C\u65F6\u8D5E\u626C\u63A8\u4ECB\u65D7\u8230\u7535\u52A8\u8F66\u4EBA\u624D\u8BA1\u5212\uFF0C\u8BE5\u8BA1\u5212\u76EE\u6807\u662F\u5728\u672A\u67655\u5E74\u57F9\u517B1\u4E07\u540D\u9AD8\u6280\u80FD\u4E13\u4E1A\u4EBA\u624D\u3002\u003C/p\u003E\n",
