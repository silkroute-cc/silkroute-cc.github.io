  "route": "/4227/",
  "title": "\u8521\u987A\u5E73\u5180\u5168\u5DDE\u6BCF\u6237\u4F4F\u5B85\u80FD\u5B89\u88C5\u592A\u9633\u80FD\u7535\u6C60\u677F\u6253\u9020\u6210\u5C0F\u578B\u72EC\u7ACB\u53D1\u7535\u7AD9\u7ECF\u4E0E\u9996\u957F\u54C8\u829D\u829D\u53CA\u51AF\u664B\u54F2\u7814\u7A76\u5EFA\u8BAE",
  "summary": "\u3010\u4E9E\u5E87\u5341\u4E94\u65E5\u8A0A\u3011\u6C99\u5DF4\u623F\u5730\u7522\u767C\u5C55\u5546\u516C\u6703\u5E0C\u671B\u6C99\u5DF4\u7684\u6BCF\u4E00\u6236\u4F4F\u5B85\u90FD\u80FD\u5B89\u88DD\u592A\u967D\u80FD\u96FB\u6C60\u677F\uFF0C\u6210\u70BA\u4E00\u500B\u5C0F\u578B\u7368\u7ACB\u767C\u96FB\u7AD9\u3002 \u8A72\u6703\u4E3B\u5E2D\u62FF\u7763\u8521\u9806\u5E73(\u5716)\u8868\u793A\uFF0C\u4ED6\u5DF2\u7D93\u8207\u9996\u5E2D\u90E8\u9577\u62FF\u7763\u65AF\u91CC\u54C8\u829D\u829D\u8AFE\u548C\u5DE5\u696D\u767C\u5C55\u548C\u4F01\u696D\u90E8\u9577\u62FF\u7763\u99AE\u6649\u54F2\u7814\u7A76\u6B64\u4E8B\u3002 \u4ED6\u8AAA\uFF1A\u201C\u57282024\u5E741\u6708\uFF0C\u6C99\u5DF4\u96FB\u529B\u6709\u9650\u516C\u53F8\u5C07\u4E0D\u518D\u5411\u5409\u9686\u5761\u5831\u544A\uFF0C\u800C\u662F\u8F49\u5411\u6C99\u5DF4\u80FD\u6E90\u59D4\u54E1\u6703\u3002\u6211\u5DF2\u7D93\u548C\u54C8\u829D\u829D\u53CA\u99AE\u6649\u54F2\u4EA4\u6D89\u3002\u6211\u5011\u6C99\u5DF4\u623F\u5730\u7522\u767C\u5C55\u5546\u516C\u6703\u5E0C\u671B\u6BCF\u4E00\u4F4D(\u623F\u5C4B)\u64C1\u6709\u8005\uFF0C\u5982\u679C\u53EF\u80FD\u7684\u8A71\uFF0C\u90FD\u5B89\u88DD\u592A\u967D\u80FD(\u96FB\u6C60\u677F)\u3002\u201D \u8521\u9806\u5E73\u8AAA\uFF0C\u5C0F\u578B\u7368\u7ACB\u767C\u96FB\u7AD9\u53EF\u4EE5\u5728\u767D\u5929\u5F9E\u967D\u5149\u4E2D\u6536\u96C6\u2026",
  "body": "\u003Cp\u003E\u3010\u4E9E\u5E87\u5341\u4E94\u65E5\u8A0A\u3011\u6C99\u5DF4\u623F\u5730\u7522\u767C\u5C55\u5546\u516C\u6703\u5E0C\u671B\u6C99\u5DF4\u7684\u6BCF\u4E00\u6236\u4F4F\u5B85\u90FD\u80FD\u5B89\u88DD\u592A\u967D\u80FD\u96FB\u6C60\u677F\uFF0C\u6210\u70BA\u4E00\u500B\u5C0F\u578B\u7368\u7ACB\u767C\u96FB\u7AD9\u3002\u8A72\u6703\u4E3B\u5E2D\u62FF\u7763\u8521\u9806\u5E73(\u5716)\u8868\u793A\uFF0C\u4ED6\u5DF2\u7D93\u8207\u9996\u5E2D\u90E8\u9577\u62FF\u7763\u65AF\u91CC\u54C8\u829D\u829D\u8AFE\u548C\u5DE5\u696D\u767C\u5C55\u548C\u4F01\u696D\u90E8\u9577\u62FF\u7763\u99AE\u6649\u54F2\u7814\u7A76\u6B64\u4E8B\u3002\u4ED6\u8AAA\uFF1A\u201C\u57282024\u5E741\u6708\uFF0C\u6C99\u5DF4\u96FB\u529B\u6709\u9650\u516C\u53F8\u5C07\u4E0D\u518D\u5411\u5409\u9686\u5761\u5831\u544A\uFF0C\u800C\u662F\u8F49\u5411\u6C99\u5DF4\u80FD\u6E90\u59D4\u54E1\u6703\u3002\u6211\u5DF2\u7D93\u548C\u54C8\u829D\u829D\u53CA\u99AE\u6649\u54F2\u4EA4\u6D89\u3002\u6211\u5011\u6C99\u5DF4\u623F\u5730\u7522\u767C\u5C55\u5546\u516C\u6703\u5E0C\u671B\u6BCF\u4E00\u4F4D(\u623F\u5C4B)\u64C1\u6709\u8005\uFF0C\u5982\u679C\u53EF\u80FD\u7684\u8A71\uFF0C\u90FD\u5B89\u88DD\u592A\u967D\u80FD(\u96FB\u6C60\u677F)\u3002\u201D\u8521\u9806\u5E73\u8AAA\uFF0C\u5C0F\u578B\u7368\u7ACB\u767C\u96FB\u7AD9\u53EF\u4EE5\u5728\u767D\u5929\u5F9E\u967D\u5149\u4E2D\u6536\u96C6\u80FD\u91CF\u4E26\u5C07\u5176\u50B3\u9001\u5230\u6C99\u5DF4\u7684\u4E3B\u96FB\u7DB2\uFF0C\u800C\u5728\u591C\u665A\uFF0C\u7576\u6C92\u6709\u967D\u5149\u6642\uFF0C\u5C4B\u4E3B\u53EF\u4EE5\u4F7F\u7528\u6C99\u96FB\u7684\u96FB\u529B\u3002\n\n\u4ED6\u8868\u793A\uFF0C\u9019\u5C07\u5E6B\u52A9\u5C4B\u4E3B\u7BC0\u7701\u96FB\u8CBB\u3002\u4ED6\u8AAA\uFF1A\u201C\u5982\u679C\u4EBA\u4EBA\u90FD\u9019\u6A23\u505A\uFF0C\u6211\u5011\u5C31\u4E0D\u9700\u8981\u7368\u7ACB\u767C\u96FB\u5EE0\u3002\u6211\u5011\u90FD\u6709\u5C0F\u578B\u7368\u7ACB\u767C\u96FB\u7AD9\u3002\u5C4B\u9802\u4E0A\u7684\u592A\u967D\u80FD(\u96FB\u6C60\u677F) - \u9019\u5C31\u662F\u4F60\u6240\u8B02\u7684\u5C0F\u578B\u7368\u7ACB\u767C\u96FB\u7AD9\u3002\u201D\u8521\u9806\u5E73\u4E5F\u8868\u793A\uFF0C\u9019\u5C07\u6D88\u9664\u6216\u6E1B\u5C11\u505C\u96FB\u7684\u767C\u751F\u3002\u4ED6\u8AAA\uFF1A\u201C\u6211\u5011\u8AC7\u8AD624\u5C0F\u6642\u7684\u6548\u7387\u548C\u5728\u5B89\u88DD\u592A\u967D\u80FD\u96FB\u6C60\u677F\u5354\u52A9\u6C99\u5DF4\u5C4B\u4E3B\u7BC0\u770120\uFF05\u7684\u8CBB\u7528\u3002\u201D\u8521\u9806\u5E73\u6628\u65E5\u5728\u8A72\u6703\u8209\u8FA6\u7684\u201C2024\u5E74\u570B\u5BB6\u8CA1\u653F\u9810\u7B97\u6848\u8207\u74B0\u5883\u3001\u793E\u6703\u8207\u76E3\u7BA1(ESG)\u8B1B\u5EA7\u6703\u201D\u65B0\u805E\u767C\u4F48\u6703\u4E0A\uFF0C\u9019\u9EBC\u6307\u51FA\u3002\u7136\u800C\uFF0C\u4ED6\u8072\u7A31\u6C99\u96FB\u4E26\u4E0D\u8D0A\u6210\u3002\u4ED6\u8AAA\uFF1A\u201C\u6C99\u96FB\u8868\u793A\u9019\u6A23\u505A\u6703\u2018\u8667\u640D\u2019\u3002\u201D\u6279\u6C99\u96FB\u975E\u5E38\u77ED\u8996\u4ED6\u5F62\u5BB9\u6C99\u96FB\u975E\u5E38\u77ED\u8996\uFF0C\u4E26\u6307\u6C99\u96FB\u5C07\u4E0D\u5141\u8A31\u592A\u967D\u80FD\u96FB\u6C60\u677F\u7684\u5B89\u88DD\u9023\u63A5\u5230\u4E3B\u96FB\u7DB2\u3002\u4ED6\u8AAA\uFF1A\u201C\u6211\u5011\u5BE6\u969B\u4E0A\u6B63\u5728\u5411\u6C99\u5DF4\u80FD\u6E90\u59D4\u54E1\u6703\u547C\u7C72\u5C0D\u4ED6\u5011(\u6C99\u96FB)\u9032\u884C\u5E72\u9810\uFF0C\u4EE5\u63A5\u53D7\u9019\u9805\u5EFA\u8B70\u3002\u201D\n\n\u4ED6\u8AAA\uFF1A\u201C\u5409\u9686\u5761\u63A5\u53D7\uFF0C\u70BA\u4EC0\u9EBC\u6C99\u5DF4\u4E0D\u80FD\u5462\uFF1F\u7802\u62C9\u8D8A\u4E5F\u63A5\u53D7\uFF0C\u9664\u4E86\u6C99\u5DF4\u3002\u201D\u4ED6\u8AAA\uFF1A\u201C\u5982\u679C\u9019\u6210\u771F\uFF0C\u9019\u5C07\u9F13\u52F5\u5F88\u591A\u6392\u5C4B\u6210\u70BA\u5C0F\u578B\u7368\u7ACB\u767C\u96FB\u7AD9\uFF0C\u9019\u5C07\u5141\u8A31\u592A\u967D\u80FD\u7522\u751F\u4E7E\u6DE8\u548C\u7DA0\u8272\u80FD\u6E90\u3002\u201D\u8521\u9806\u5E73\u4E5F\u8868\u793A\uFF0C\u4ED6\u5C07\u81F4\u51FD\u7D66\u9996\u5E2D\u90E8\u9577\uFF0C\u7136\u5F8C\u5C07\u524D\u5F80\u6C99\u5DF4\u80FD\u6E90\u59D4\u54E1\u6703\uFF0C\u63A5\u8457\u662F\u6C99\u96FB\u3002\u4ED6\u8AAA\uFF1A\u201C\u6211\u5011\u4E0D\u61C9\u8A72\u76EE\u5149\u77ED\u6DFA\u3002\u6211\u5011\u61C9\u8A72\u671D\u672A\u4F86\u767C\u5C55\u3002\u201D\u4ED6\u4E5F\u8AAA\uFF0C\u4E9E\u5E87\u5DE5\u696D\u5712\u5340\u6709\u4E00\u5BB6\u592A\u967D\u80FD\u96FB\u6C60\u677F\u5DE5\u5EE0\uFF0C\u5373Kibing Solar\u3002\u4ED6\u8AAA\uFF1A\u201C\u6C99\u5DF4\u623F\u5730\u7522\u767C\u5C55\u5546\u516C\u6703\u548C(\u6709\u8208\u8DA3\u7684)\u500B\u4EBA\u5C07\u4E0D\u9700\u8981\u5F9E\u5409\u9686\u5761\u9032\u53E3(\u9762\u677F)\u3002\u4E00\u5207\u90FD\u53EF\u4EE5\u5728\u6C99\u5DF4\u5B8C\u6210\u3002\u201D\u4ED6\u8AAA\uFF1A\u201C\u6211\u5DF2\u7D93\u8981\u6C42\u5DE5\u696D\u767C\u5C55\u90E8\u9577\u4E0D\u61C9\u8A72\u5C07\u6240\u6709\u6771\u897F\u90FD\u51FA\u53E3\u5230\u6D77\u5916\u3002\u8981\u6C42\u4ED6\u5011\u7D66\u4E88\u6C99\u5DF4\u4EBA\u7279\u6B8A\u50F9\u683C\u3002\u5206\u914D\u7D66\u6240\u6709\u5BB6\u5EAD\uFF0C\u8B93\u4ED6\u5011\u5728\u6574\u500B\u6C99\u5DF4\u90FD\u6210\u70BA\u5C0F\u578B\u7368\u7ACB\u767C\u96FB\u7AD9\u3002\u201D\u5728\u56DE\u7B54\u53E6\u4E00\u500B\u8A71\u984C\u6642\uFF0C\u8521\u9806\u5E73\u8868\u793A\uFF0C\u8A72\u6703\u5C07\u5354\u52A9\u5DDE\u653F\u5E9C\u5728\u6C99\u5DF4\u5927\u5B78\u99AC\u4F86\u897F\u4E9E\u548C1Borneo\u4E4B\u9593\u7684\u5BE6\u90A6\u52A0\u70BAB40\u548CM40\u7FA4\u9AD4\u5EFA\u8A2D\u53EF\u8CA0\u64D4\u623F\u5C4B\u3002\n\n\u4ED6\u8AAA\uFF1A\u201C\u6C99\u5DF4\u623F\u5730\u7522\u767C\u5C55\u5546\u516C\u6703\u5C07\u5E6B\u52A9\u5DDE\u653F\u5E9C\u84CB\u623F\u5B50\u3002\u6211\u60F3\u5927\u7D04\u67093,000\u68DF\u623F\u5B50\u3002\u201D\u4ED6\u8AAA\uFF0C\u9019\u584A\u5730\u662F\u7531\u5DDE\u653F\u5E9C\u6350\u8D08\u7684\uFF0C\u8A72\u6703\u6B63\u5728\u8207\u4ED6\u5011\u5408\u4F5C\u627E\u51FA\u5982\u4F55\u9032\u884C\u3002\u003C/p\u003E\n\u003Cp\u003E\n\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/J23jvbytLooeDuJtXcrGqg\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
