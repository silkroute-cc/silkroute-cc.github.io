{
  "id": "%e9%a9%ac%e6%96%b0%e4%b8%a4%e5%9b%bd%e9%a2%86%e5%af%bc%e4%ba%ba%e8%a7%81%e8%af%81-%e6%9f%94%e6%96%b0%e6%8d%b7%e8%bf%90%e8%bd%a8%e9%81%93%e8%a1%94%e6%8e%a5%e5%ae%8c%e5%b7%a5-%e5%ae%8c%e5%b7%a565",
  "slug": "%e9%a9%ac%e6%96%b0%e4%b8%a4%e5%9b%bd%e9%a2%86%e5%af%bc%e4%ba%ba%e8%a7%81%e8%af%81-%e6%9f%94%e6%96%b0%e6%8d%b7%e8%bf%90%e8%bd%a8%e9%81%93%e8%a1%94%e6%8e%a5%e5%ae%8c%e5%b7%a5-%e5%ae%8c%e5%b7%a565",
  "canonicalUrlKey": "%e9%a9%ac%e6%96%b0%e4%b8%a4%e5%9b%bd%e9%a2%86%e5%af%bc%e4%ba%ba%e8%a7%81%e8%af%81-%e6%9f%94%e6%96%b0%e6%8d%b7%e8%bf%90%e8%bd%a8%e9%81%93%e8%a1%94%e6%8e%a5%e5%ae%8c%e5%b7%a5-%e5%ae%8c%e5%b7%a565",
  "route": "/4340/",
  "title": "\u9A6C\u65B0\u4E24\u56FD\u9886\u5BFC\u4EBA\u89C1\u8BC1 \u67D4\u65B0\u6377\u8FD0\u8F68\u9053\u8854\u63A5\u5B8C\u5DE5  \u5B8C\u5DE565% \u6709\u671B2027\u5143\u65E6\u901A\u8F66",
  "summary": "\u9A6C\u65B0\u4E24\u56FD\u9886\u5BFC\u4EBA\u89C1\u8BC1 \u67D4\u65B0\u6377\u8FD0\u8F68\u9053\u8854\u63A5\u5B8C\u5DE5 \uFF08\u65B0\u5C7111\u65E5\u8BAF\uFF09\u67D4\u65B0\u6377\u8FD0\u7CFB\u7EDF\uFF08RTS\uFF09\u76EE\u524D\u5DF2\u5B8C\u6210\u7EA6\u4E09\u5206\u4E4B\u4E8C\u7684\u5EFA\u9020\u5DE5\u7A0B\uFF0C\u6211\u56FD\u8303\u56F4\u7684\u5DE5\u7A0B\u8FDB\u5EA6\u8FBE65%\u3002 RTS\u9884\u8BA1\u57282026\u5E7412\u6708\u5E95\u901A\u8F66\u540E\uFF0C\u5C06\u5927\u5927\u6539\u5584\u65B0\u52A0\u5761\u548C\u67D4\u4F5B\u7684\u8854\u63A5\u6027\uFF0C\u534F\u52A9\u8212\u7F13\u65B0\u67D4\u957F\u5824\u7684\u62E5\u5835\u60C5\u51B5\u3002 \u67D4\u65B0\u6377\u8FD0\u7CFB\u7EDF\u4E8E2021\u5E74\u52A8\u5DE5\u5174\u5EFA\uFF0C\u4ECA\u65E5\u5E86\u795D\u91CD\u8981\u91CC\u7A0B\u7891\uFF0C\u8854\u63A5\u9A6C\u65B0\u8DE8\u6D77\u9AD8\u67B6\u8F68\u9053\u7684\u94A2\u7B4B\u6DF7\u51DD\u571F\u7ED3\u6784\u5DF2\u5EFA\u597D\uFF0C\u628A\u4E24\u56FD\u5206\u522B\u8D1F\u8D23\u627F\u5EFA\u7684\u6865\u58A9\u6B63\u5F0F\u8854\u63A5\u8D77\u6765\u3002 \u65B0\u52A0\u5761\u603B\u7406\u674E\u663E\u9F99\u4E0E\u9996\u76F8\u62FF\u7763\u65AF\u91CC\u5B89\u534E\u4ECA\u65E9\u5728\u67D4\u4F5B\u6D77\u5CE1\u4E2D\u592E\u4F1A\u9762\uFF0C\u5171\u540C\u89C1\u8BC1RTS\u8DE8\u6D77\u9AD8\u2026",
  "body": "\u003Ch1\u003E\u9A6C\u65B0\u4E24\u56FD\u9886\u5BFC\u4EBA\u89C1\u8BC1 \u67D4\u65B0\u6377\u8FD0\u8F68\u9053\u8854\u63A5\u5B8C\u5DE5\u003C/h1\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/01/frc-4e897813dce0e4c29e2c9b92bfe5fb4a.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\uFF08\u65B0\u5C7111\u65E5\u8BAF\uFF09\u67D4\u65B0\u6377\u8FD0\u7CFB\u7EDF\uFF08RTS\uFF09\u76EE\u524D\u5DF2\u5B8C\u6210\u7EA6\u4E09\u5206\u4E4B\u4E8C\u7684\u5EFA\u9020\u5DE5\u7A0B\uFF0C\u6211\u56FD\u8303\u56F4\u7684\u5DE5\u7A0B\u8FDB\u5EA6\u8FBE65%\u3002\u003C/p\u003E\n\u003Cp\u003ERTS\u9884\u8BA1\u57282026\u5E7412\u6708\u5E95\u901A\u8F66\u540E\uFF0C\u5C06\u5927\u5927\u6539\u5584\u65B0\u52A0\u5761\u548C\u67D4\u4F5B\u7684\u8854\u63A5\u6027\uFF0C\u534F\u52A9\u8212\u7F13\u65B0\u67D4\u957F\u5824\u7684\u62E5\u5835\u60C5\u51B5\u3002\u003C/p\u003E\n\u003Cp\u003E\u67D4\u65B0\u6377\u8FD0\u7CFB\u7EDF\u4E8E2021\u5E74\u52A8\u5DE5\u5174\u5EFA\uFF0C\u4ECA\u65E5\u5E86\u795D\u91CD\u8981\u91CC\u7A0B\u7891\uFF0C\u8854\u63A5\u9A6C\u65B0\u8DE8\u6D77\u9AD8\u67B6\u8F68\u9053\u7684\u94A2\u7B4B\u6DF7\u51DD\u571F\u7ED3\u6784\u5DF2\u5EFA\u597D\uFF0C\u628A\u4E24\u56FD\u5206\u522B\u8D1F\u8D23\u627F\u5EFA\u7684\u6865\u58A9\u6B63\u5F0F\u8854\u63A5\u8D77\u6765\u3002\u003C/p\u003E\n\u003Cp\u003E\u65B0\u52A0\u5761\u603B\u7406\u674E\u663E\u9F99\u4E0E\u9996\u76F8\u62FF\u7763\u65AF\u91CC\u5B89\u534E\u4ECA\u65E9\u5728\u67D4\u4F5B\u6D77\u5CE1\u4E2D\u592E\u4F1A\u9762\uFF0C\u5171\u540C\u89C1\u8BC1RTS\u8DE8\u6D77\u9AD8\u67B6\u8F68\u9053\u5B8C\u6210\u8854\u63A5\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E24\u4EBA\u4E5F\u5728\u4EEA\u5F0F\u4E0A\u7B7E\u7F72\u7EAA\u5FF5\u724C\u533E\uFF0C\u8C61\u5F81\u4E24\u56FD\u5B8C\u6210\u8DE8\u5883\u5730\u94C1\u9879\u76EE\u7684\u5171\u540C\u627F\u8BFA\uFF0C\u8FDB\u4E00\u6B65\u6539\u5584\u65B0\u9A6C\u7684\u8854\u63A5\u6027\u3002\u003C/p\u003E\n\u003Cp\u003E\u67D4\u65B0\u6377\u8FD0\u7CFB\u7EDF\u5168\u957F4\u516C\u91CC\uFF0C\u7531\u5927\u9A6C\u8D1F\u8D23\u7684\u8303\u56F4\u7684\u5DE5\u7A0B\u622A\u81F3\u53BB\u5E74\u5E95\u5B8C\u6210\u7EA665\uFF05\uFF0C\u5728\u65B0\u52A0\u5761\u8303\u56F4\u5174\u5EFA\u7684\u90E8\u5206\u76EE\u524D\u5DF2\u5B8C\u6210\u7EA6\u4E09\u5206\u4E4B\u4E8C\u7684\u571F\u6728\u57FA\u7840\u8BBE\u65BD\u5DE5\u7A0B\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/01/frc-3ef4a7a11f0a3e15764dc355993a9494.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u4E24\u56FD\u591A\u540D\u653F\u8981\u51FA\u5E2D\u6D3B\u52A8\uFF0C\u5305\u62EC\u67D4\u4F5B\u5DDE\u52A1\u5927\u81E3\u62FF\u7763\u7FC1\u54C8\u83F2\u5179\u3001\u4EA4\u901A\u90E8\u957F\u9646\u5146\u798F\u3001\u7ECF\u6D4E\u90E8\u957F\u62C9\u83F2\u5179\u3001\u5185\u653F\u90E8\u957F\u8D5B\u5F17\u4E01\u3001\u5916\u4EA4\u90E8\u957F\u62FF\u7763\u65AF\u91CC\u83AB\u54C8\u672B\u54C8\u5C71\u3001\u4EE5\u53CA\u7B2C\u4E8C\u8D22\u653F\u90E8\u90E8\u957F\u62FF\u7763\u65AF\u91CC\u963F\u7C73\u5C14\u97E9\u67E5\u3002\u003C/p\u003E\n\u003Cp\u003E\u65B0\u52A0\u5761\u65B9\u9762\uFF0C\u4E0E\u4F1A\u7684\u5305\u62EC\u5916\u4EA4\u90E8\u957F\u7EF4\u6587\u533B\u751F\u3001\u8D38\u5DE5\u90E8\u957F\u989C\u91D1\u52C7\u3001\u56FD\u5BB6\u53D1\u5C55\u90E8\u957F\u674E\u667A\u965E\u3001\u4EE3\u4EA4\u901A\u90E8\u957F\u517C\u8D22\u653F\u90E8\u9AD8\u7EA7\u653F\u52A1\u90E8\u957F\u5F90\u82B3\u8FBE\uFF0C\u4EE5\u53CA\u5185\u653F\u90E8\u517C\u56FD\u5BB6\u53D1\u5C55\u90E8\u653F\u52A1\u90E8\u957F\u8D39\u7ECD\u5C14\u526F\u6559\u6388\u3002\u003C/p\u003E\n\u003Ch1\u003E\u5B8C\u5DE565% \u67D4\u65B0\u6377\u8FD0\u8FDB\u5EA6\u80DC\u9884\u671F\u003C/h1\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/01/frc-4540e048a08cf87eade36883883aff2c.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\uFF08\u65B0\u5C7111\u65E5\u8BAF\uFF09\u67D4\u65B0\u6377\u8FD0\u7CFB\u7EDF\uFF08RTS\uFF09\u7684\u5EFA\u8BBE\u5DE5\u7A0B\u8FDB\u5C55\u826F\u597D\uFF0C\u622A\u81F3\u53BB\u5E7412\u670831\u65E5\u5DF2\u5B8C\u6210\u7EA665%\uFF0C\u8D85\u8D8A\u539F\u5B9A\u8FDB\u5EA6\u76EE\u680757%\u3002\u003C/p\u003E\n\u003Cp\u003E\u6839\u636E\u6377\u8FD0\u516C\u53F8\uFF08MRT Corp\uFF09\uFF0C\u5728\u6211\u56FD\u8303\u56F4\u8D1F\u8D23\u5174\u5EFA\u7684RTS\u6574\u4F53\u5DE5\u7A0B\u5B8C\u6210\u4E8665%\uFF0C\u8FD9\u5305\u62EC\u5174\u5EFA\u5728\u65B0\u5C71\u74E6\u8FEA\u54C8\u90A3\u7684\u6377\u8FD0\u7EF4\u4FEE\u8FD0\u4F5C\u7AD9\uFF08Depot\uFF09\u3001\u6B66\u5409\u67E5\u5361\u7AD9\u548C\u9AD8\u67B6\u8F68\u9053\u3002\u003C/p\u003E\n\u003Cp\u003E\u8854\u63A5\u9A6C\u65B0\u7684\u8DE8\u6D77\u9AD8\u67B6\u8F68\u9053\u6DF7\u51DD\u571F\u7ED3\u6784\u5DF2\u4E8E\u53BB\u5E74\u5E95\u5B8C\u6210\uFF0C\u9996\u76F8\u62FF\u7763\u65AF\u91CC\u5B89\u534E\u548C\u65B0\u52A0\u5761\u603B\u7406\u674E\u663E\u9F99\u4ECA\u65E9\u51FA\u5E2D\u4EEA\u5F0F\uFF0C\u89C1\u8BC1\u8FD9\u4E2A\u91CC\u7A0B\u7891\u65F6\u523B\u3002\u003C/p\u003E\n\u003Cp\u003E\u6377\u8FD0\u516C\u53F8\u6307\u51FA\uFF0C\u9A6C\u65B0\u4E24\u56FD\u5728\u8FDE\u63A5\u65BD\u5DE5\u7684\u5404\u4E2A\u9636\u6BB5\uFF0C\u90FD\u8FDB\u884C\u4E86\u8054\u5408\u6280\u672F\u68C0\u67E5\u548C\u5BC6\u5207\u534F\u8C03\u3002\u67D4\u65B0\u6377\u8FD0\u7CFB\u7EDF\u5EFA\u9020\u5DE5\u7A0B\u76EE\u524D\u5982\u706B\u5982\u837C\u5730\u8FDB\u884C\u4E2D\uFF0C\u6A2A\u8DE8\u5730\u4E0D\u8001\u6D77\u5CE1\u7684\u6D77\u4E0A\u9AD8\u67B6\u8F68\u9053\u7684\u5DE5\u7A0B\u6309\u7167\u539F\u5B9A\u8BA1\u5212\u8FDB\u884C\uFF0C\u9884\u8BA1\u5C06\u5728\u4ECA\u5E74\u676A\u7AE3\u5DE5\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/01/frc-95d1cea4761812d38fe5b0471a55742f.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u9884\u8BA12026\u5E74\u5E95\u6295\u5165\u8FD0\u4F5C\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u7531\u9A6C\u65B0\u5171\u540C\u627F\u5EFA\u7684\u67D4\u65B0\u6377\u8FD0\u7CFB\u7EDF\u5168\u957F4\u516C\u91CC\uFF08\u6211\u56FD2.7\u516C\u91CC\uFF0C\u65B0\u52A0\u57611.3\u516C\u91CC\uFF09\uFF0C\u8854\u63A5\u65B0\u5C71\u6B66\u5409\u67E5\u5361\u7AD9\u548C\u65B0\u52A0\u5761\u5140\u5170\u5317\u7AD9\u3002\u4E24\u7AD9\u4E4B\u95F4\u7684\u8F66\u7A0B\u7EA65\u5206\u949F\uFF0C\u6BCF\u5C0F\u65F6\u5355\u5411\u53EF\u63A5\u8F7D1\u4E07\u4EBA\u6B21\uFF0C\u76F8\u4FE1\u5C06\u5927\u5E45\u6539\u5584\u65B0\u5C71\u4E0E\u65B0\u52A0\u5761\u7684\u8FDE\u63A5\u3002\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u65B0\u4E24\u56FD\u57282020\u5E747\u6708\u676A\u6572\u5B9A\u548C\u7B7E\u7F72\u67D4\u65B0\u6377\u8FD0\u7CFB\u7EDF\u53CC\u8FB9\u534F\u8BAE\uFF0C\u91CD\u542F\u67D4\u65B0\u6377\u8FD0\u8BA1\u5212\uFF0C\u4ECE\u5730\u94C1\uFF08MRT\uFF09\u6539\u4E3A\u8F7B\u5FEB\u94C1\uFF08LRT\uFF09\uFF0C2021\u81F32024\u5E74\u676A\u662F\u8FDB\u884C\u571F\u6728\u5DE5\u7A0B\uFF0C\u800C2025\u81F32026\u5E74\u676A\u662F\u8BA4\u8BC1\u548C\u7CFB\u7EDF\u6D4B\u8BD5\u9636\u6BB5\u3002\u003C/p\u003E\n\u003Cp\u003E\u67D4\u65B0\u6377\u8FD0\u9884\u8BA1\u57282026\u5E74\u5E95\u6295\u5165\u8FD0\u4F5C\uFF0C\u65B0\u5C71\u548C\u5140\u5170\u5317\u90FD\u91C7\u7528\u201C\u4E00\u5730\u4E24\u68C0\u201D\u7684\u6982\u5FF5\uFF0C\u4E58\u5BA2\u51FA\u53D1\u65F6\u53EF\u4E00\u6B21\u8FC7\u529E\u7406\u51FA\u53D1\u5730\u51FA\u5883\u548C\u76EE\u7684\u5730\u5165\u5883\u624B\u7EED\uFF0C\u4E0B\u8F66\u65F6\u65E0\u987B\u518D\u901A\u5173\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/01/frc-fb0cfb7257f347976fbba5a0e96acf39.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Ch3\u003E\u003Cstrong\u003E\u67D4\u65B0\u6377\u8FD0\u7CFB\u7EDF\u8BA1\u5212\u8FDB\u7A0B\u003C/strong\u003E\u003C/h3\u003E\n\u003Cp\u003E\u25CF2020\u5E747\u670830\u65E5\u003C/p\u003E\n\u003Cp\u003ERTS\u5DE5\u7A0B\u6B63\u5F0F\u6062\u590D\uFF0C\u9A6C\u65B0\u4E24\u56FD\u7B7E\u7F72\u4FEE\u8BA2\u7684\u53CC\u8FB9\u534F\u8BAE\u53CA\u7279\u8BB8\u7ECF\u8425\u534F\u8BAE\u003C/p\u003E\n\u003Cp\u003E\u25CF2021\u5E749\u67087\u65E5\u5730\u94C1\u8BA1\u5212\u6279\u51C6\u003C/p\u003E\n\u003Cp\u003E\u25CF2020\u5E7411\u670822\u65E5\u52A8\u571F\u4EEA\u5F0F\u003C/p\u003E\n\u003Cp\u003E\u25CF2020\u81F32025\u5E74\u003C/p\u003E\n\u003Cp\u003E\u8F68\u9053\u8BBE\u8BA1\u4E0E\u57FA\u7840\u8BBE\u65BD\u65BD\u5DE5\u003C/p\u003E\n\u003Cp