{
  "id": "%e6%b8%a9%e9%a6%a8%e6%8f%90%e9%86%92%e6%9d%a5%e9%a9%ac%e4%b8%ad%e5%9b%bd%e5%85%ac%e6%b0%91%e6%b3%a8%e6%84%8f%e6%97%85%e8%a1%8c%e5%ae%89%e5%85%a8",
  "slug": "%e6%b8%a9%e9%a6%a8%e6%8f%90%e9%86%92%e6%9d%a5%e9%a9%ac%e4%b8%ad%e5%9b%bd%e5%85%ac%e6%b0%91%e6%b3%a8%e6%84%8f%e6%97%85%e8%a1%8c%e5%ae%89%e5%85%a8",
  "canonicalUrlKey": "%e6%b8%a9%e9%a6%a8%e6%8f%90%e9%86%92%e6%9d%a5%e9%a9%ac%e4%b8%ad%e5%9b%bd%e5%85%ac%e6%b0%91%e6%b3%a8%e6%84%8f%e6%97%85%e8%a1%8c%e5%ae%89%e5%85%a8",
