  "canonicalUrlKey": "%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e7%a0%82%e6%8d%9e%e8%b6%8a%e6%80%bb%e7%90%86%ef%bc%9a%e7%a0%82%e8%83%bd%e6%ba%90%e8%bd%ac%e5%9e%8b-%e8%ae%be%e5%85%ac%e7%94%a8%e4%ba%8b%e4%b8%9a%e7%94%b5%e6%b1%a0",
  "route": "/5528/",
  "title": "\u9A6C\u6765\u897F\u4E9A\u7802\u635E\u8D8A\u603B\u7406\uFF1A\u7802\u80FD\u6E90\u8F6C\u578B \u8BBE\u516C\u7528\u4E8B\u4E1A\u7535\u6C60\u50A8\u80FD",
  "summary": "\u7802\u603B\u7406\u62FF\u7763\u5DF4\u4E01\u5B9C\u4E39\u65AF\u91CC\u963F\u90A6\u4F50\u54C8\u91CC\u8FDB\u884C\u5DE1\u89C6\u65F6\u6444\u3002 \uFF08\u53E4\u664B14\u65E5\u8BAF\uFF09\u7802\u62C9\u8D8A\u603B\u7406\u62FF\u7763\u5DF4\u4E01\u5B9C\u4E39\u65AF\u91CC\u963F\u90A6\u4F50\u54C8\u91CC\u8868\u793A\uFF0C\u516C\u7528\u4E8B\u4E1A\u7EA7\u7535\u6C60\u50A8\u80FD\u7CFB\u7EDF\u662F\u7802\u62C9\u8D8A\u80FD\u6E90\u8F6C\u578B\u7684\u91CD\u8981\u4E00\u6B65\uFF0C\u6807\u5FD7\u7740\u4ECE\u4F20\u7EDF\u7684\u7164\u70AD\u548C\u5316\u77F3\u71C3\u6599\u80FD\u6E90\u8F6C\u5411\u53EF\u518D\u751F\u80FD\u6E90\u7684\u8F6C\u53D8\u3002 \u4ED6\u6307\u51FA\uFF0C\u7802\u62C9\u8D8A\u80FD\u6E90\u516C\u53F8\u5DF2\u6295\u8D441.28\u4EBF\u4EE4\u5409\uFF0C\u7528\u4E8E\u5EFA\u8BBE22\u4E2A\u96C6\u88C5\u7BB1\u5F0F\u7535\u6C60\u50A8\u80FD\u5355\u5143\uFF0C\u8FD9\u4E9B\u5355\u5143\u80FD\u591F\u50A8\u5B58\u5E76\u91CA\u653E\u9AD8\u8FBE60\u5146\u74E6\u65F6\uFF08MWh\uFF09\u7684\u7535\u529B\u3002 \u7802\u62C9\u8D8A\u603B\u7406\u62FF\u7763\u5DF4\u4E01\u5B9C\u4E39\u65AF\u91CC\u963F\u90A6\u4F50\u54C8\u91CC\u4E8E\u4ECA\u65E5\u508D\u665A\u63A2\u8BBF\u4F4D\u4E8E\u7802\u62C9\u8D8A\u7684\u9A6C\u6765\u897F\u4E9A\u9996\u4E2A\u516C\u7528\u4E8B\u4E1A\u7EA7\u7535\u6C60\u50A8\u80FD\u7CFB\u7EDF\uFF0C\u5E76\u5728\u968F\u540E\u53EC\u5F00\u7684\u65B0\u95FB\u53D1\u5E03\u4F1A\u2026",
  "body": "\u003Cp\u003E\uFF08\u53E4\u664B14\u65E5\u8BAF\uFF09\u7802\u62C9\u8D8A\u603B\u7406\u62FF\u7763\u5DF4\u4E01\u5B9C\u4E39\u65AF\u91CC\u963F\u90A6\u4F50\u54C8\u91CC\u8868\u793A\uFF0C\u516C\u7528\u4E8B\u4E1A\u7EA7\u7535\u6C60\u50A8\u80FD\u7CFB\u7EDF\u662F\u7802\u62C9\u8D8A\u80FD\u6E90\u8F6C\u578B\u7684\u91CD\u8981\u4E00\u6B65\uFF0C\u6807\u5FD7\u7740\u4ECE\u4F20\u7EDF\u7684\u7164\u70AD\u548C\u5316\u77F3\u71C3\u6599\u80FD\u6E90\u8F6C\u5411\u53EF\u518D\u751F\u80FD\u6E90\u7684\u8F6C\u53D8\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6307\u51FA\uFF0C\u7802\u62C9\u8D8A\u80FD\u6E90\u516C\u53F8\u5DF2\u6295\u8D441.28\u4EBF\u4EE4\u5409\uFF0C\u7528\u4E8E\u5EFA\u8BBE22\u4E2A\u96C6\u88C5\u7BB1\u5F0F\u7535\u6C60\u50A8\u80FD\u5355\u5143\uFF0C\u8FD9\u4E9B\u5355\u5143\u80FD\u591F\u50A8\u5B58\u5E76\u91CA\u653E\u9AD8\u8FBE60\u5146\u74E6\u65F6\uFF08MWh\uFF09\u7684\u7535\u529B\u3002\u003C/p\u003E\n\u003Cp\u003E\u7802\u62C9\u8D8A\u603B\u7406\u62FF\u7763\u5DF4\u4E01\u5B9C\u4E39\u65AF\u91CC\u963F\u90A6\u4F50\u54C8\u91CC\u4E8E\u4ECA\u65E5\u508D\u665A\u63A2\u8BBF\u4F4D\u4E8E\u7802\u62C9\u8D8A\u7684\u9A6C\u6765\u897F\u4E9A\u9996\u4E2A\u516C\u7528\u4E8B\u4E1A\u7EA7\u7535\u6C60\u50A8\u80FD\u7CFB\u7EDF\uFF0C\u5E76\u5728\u968F\u540E\u53EC\u5F00\u7684\u65B0\u95FB\u53D1\u5E03\u4F1A\u4E0A\u8BE6\u7EC6\u4ECB\u7ECD\u8BE5\u9879\u76EE\u7684\u610F\u4E49\u53CA\u5176\u5BF9\u7802\u62C9\u8D8A\u80FD\u6E90\u8F6C\u578B\u7684\u8D21\u732E\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u6709\u5173\u7CFB\u7EDF\u662F\u9A6C\u6765\u897F\u4E9A\u9996\u4E2A\u516C\u7528\u4E8B\u4E1A\u7EA7\u7535\u6C60\u50A8\u80FD\u7CFB\u7EDF\uFF0C\u5B83\u4E0D\u4EC5\u80FD\u591F\u7A33\u5B9A\u7535\u7F51\uFF0C\u8FD8\u80FD\u5728\u7535\u529B\u9700\u6C42\u9AD8\u5CF0\u65F6\u63D0\u4F9B\u989D\u5916\u7684\u7535\u529B\u652F\u6301\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8FDB\u4E00\u6B65\u89E3\u91CA\uFF0C\u8BE5\u7CFB\u7EDF\u7684\u7075\u6D3B\u6027\u4F7F\u5176\u80FD\u591F\u4E0E\u5176\u4ED6\u53EF\u518D\u751F\u80FD\u6E90\u6280\u672F\u7ED3\u5408\u4F7F\u7528\uFF0C\u4F8B\u5982\u6C34\u529B\u53D1\u7535\u548C\u592A\u9633\u80FD\u53D1\u7535\uFF0C\u5F62\u6210\u6DF7\u5408\u80FD\u6E90\u7CFB\u7EDF\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8FD8\u63D0\u5230\uFF0C\u7535\u6C60\u50A8\u80FD\u6280\u672F\u7684\u5E94\u7528\u4E0D\u4EC5\u9650\u4E8E\u57CE\u5E02\u5730\u533A\uFF0C\u8FD8\u53EF\u4EE5\u63A8\u5E7F\u5230\u7802\u62C9\u8D8A\u7684\u504F\u8FDC\u5730\u533A\uFF0C\u5E2E\u52A9\u63D0\u5347\u8FD9\u4E9B\u5730\u533A\u7684\u7535\u529B\u4F9B\u5E94\u7A33\u5B9A\u6027\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u4E3E\u4F8B\u8BF4\uFF0C\u7C7B\u4F3C\u7684\u6280\u672F\u53EF\u4EE5\u7528\u4E8E\u7535\u52A8\u6469\u6258\u8F66\u7B49\u4EA4\u901A\u5DE5\u5177\uFF0C\u8FDB\u4E00\u6B65\u63A8\u52A8\u7802\u62C9\u8D8A\u7684\u7EFF\u8272\u80FD\u6E90\u53D1\u5C55\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u79F0\uFF0C\u7802\u653F\u5E9C\u5DF2\u7ECF\u5728\u7802\u62C9\u8D8A\u5EFA\u7ACB\u65B0\u7684\u57FA\u7840\u8BBE\u65BD\uFF0C\u8BC1\u660E\u7535\u6C60\u50A8\u80FD\u7CFB\u7EDF\u7684\u53EF\u884C\u6027\u3002\u672A\u6765\uFF0C\u53EF\u80FD\u4F1A\u5728\u5176\u4ED6\u5730\u533A\u63A8\u5E7F\u8FD9\u4E00\u6280\u672F\uFF0C\u7279\u522B\u662F\u5728\u6C34\u529B\u53D1\u7535\u548C\u592A\u9633\u80FD\u53D1\u7535\u8D44\u6E90\u4E30\u5BCC\u7684\u5730\u533A\u3002\u003C/p\u003E\n\u003Cp\u003E\u6B64\u5916\uFF0C\u4ED6\u8BF4\uFF0C\u7802\u62C9\u8D8A\u653F\u5E9C\u6B63\u5728\u79EF\u6781\u63A2\u7D22\u66F4\u591A\u53EF\u518D\u751F\u80FD\u6E90\u6280\u672F\uFF0C\u5305\u62EC\u751F\u7269\u8D28\u80FD\u548C\u6C22\u80FD\uFF0C\u4EE5\u51CF\u5C11\u5BF9\u78B3\u57FA\u80FD\u6E90\u7684\u4F9D\u8D56\uFF0C\u5B9E\u73B0\u7EFF\u8272\u80FD\u6E90\u76EE\u6807\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/KSgQBytzvYwcwyt037yMQw\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
