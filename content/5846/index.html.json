  "slug": "\u9A6C\u6765\u897F\u4E9A\u526F\u9996\u76F8\u89C1\u8BC1\u4EBF\u7EAC\u9502\u80FD\u50A8\u80FD\u7535\u6C60\u670D\u52A1\u5409\u9686\u5761\u673A\u573A",
  "canonicalUrlKey": "\u9A6C\u6765\u897F\u4E9A\u526F\u9996\u76F8\u89C1\u8BC1\u4EBF\u7EAC\u9502\u80FD\u50A8\u80FD\u7535\u6C60\u670D\u52A1\u5409\u9686\u5761\u673A\u573A",
  "route": "/5846/",
  "title": "\u9A6C\u6765\u897F\u4E9A\u526F\u9996\u76F8\u89C1\u8BC1\u4EBF\u7EAC\u9502\u80FD\u50A8\u80FD\u7535\u6C60\u670D\u52A1\u5409\u9686\u5761\u673A\u573A",
  "summary": "2026 \u5E74 1 \u6708 29 \u65E5\uFF0C\u9A6C\u6765\u897F\u4E9A\u5409\u9686\u5761\uFF0C\u4EBF\u7EAC\u9502\u80FD\u4E0E\u5408\u4F5C\u65B9\u5C31\u5409\u9686\u5761\u56FD\u9645\u673A\u573A\u5149\u50A8\u4E00\u4F53\u9879\u76EE\u4E3E\u884C\u7B7E\u7EA6\u4EEA\u5F0F\uFF0C\u9A6C\u6765\u897F\u4E9A\u526F\u9996\u76F8 Fadillah Yusof \u53D7\u9080\u51FA\u5E2D\u5E76\u89C1\u8BC1\u8FD9\u4E00\u91CD\u8981\u65F6\u523B\u3002\u8FD9\u6807\u5FD7\u7740\u4EBF\u7EAC\u9502\u80FD 628Ah \u50A8\u80FD\u5927\u7535\u6C60\u53CA 5MWh \u50A8\u80FD\u7CFB\u7EDF\u4EA7\u54C1\u6B63\u5F0F\u8FDB\u5165\u9A6C\u6765\u897F\u4E9A\u6838\u5FC3\u57FA\u7840\u8BBE\u65BD\u9886\u57DF\uFF0C\u4E3A\u8BE5\u56FD\u7684\u7EFF\u8272\u667A\u6167\u80FD\u6E90\u4F53\u7CFB\u5EFA\u8BBE\u63D0\u4F9B\u5173\u952E\u652F\u6491\u3002 \u4EBF\u7EAC\u9502\u80FD\u50A8\u80FD\u56FD\u9645\u9500\u552E\u90E8\u603B\u7ECF\u7406\u9648\u840C\u840C\u53CA Cenergi SEA \u603B\u88C1 En Harman \u5171\u540C\u5C55\u793A\u50A8\u80FD\u91C7\u8D2D\u5408\u540C\u2026",
  "body": "\u003Cp\u003E2026 \u5E74 1 \u6708 29 \u65E5\uFF0C\u9A6C\u6765\u897F\u4E9A\u5409\u9686\u5761\uFF0C\u4EBF\u7EAC\u9502\u80FD\u4E0E\u5408\u4F5C\u65B9\u5C31\u5409\u9686\u5761\u56FD\u9645\u673A\u573A\u5149\u50A8\u4E00\u4F53\u9879\u76EE\u4E3E\u884C\u7B7E\u7EA6\u4EEA\u5F0F\uFF0C\u9A6C\u6765\u897F\u4E9A\u526F\u9996\u76F8 Fadillah Yusof \u53D7\u9080\u51FA\u5E2D\u5E76\u89C1\u8BC1\u8FD9\u4E00\u91CD\u8981\u65F6\u523B\u3002\u8FD9\u6807\u5FD7\u7740\u4EBF\u7EAC\u9502\u80FD 628Ah \u50A8\u80FD\u5927\u7535\u6C60\u53CA 5MWh \u50A8\u80FD\u7CFB\u7EDF\u4EA7\u54C1\u6B63\u5F0F\u8FDB\u5165\u9A6C\u6765\u897F\u4E9A\u6838\u5FC3\u57FA\u7840\u8BBE\u65BD\u9886\u57DF\uFF0C\u4E3A\u8BE5\u56FD\u7684\u7EFF\u8272\u667A\u6167\u80FD\u6E90\u4F53\u7CFB\u5EFA\u8BBE\u63D0\u4F9B\u5173\u952E\u652F\u6491\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/sz_mmbiz_jpg/ww9jCzgoAcWsFiaRC4pbAcXSGHVx0ouPBknS2oYyUZbNARss77hAcChQ2zMENicPpyPibpiaD8LXG8ceFRYicUicl4hiabdTzEOCONBRmYhjef9G3c/640?wx_fmt=jpeg\u0026amp;wxfrom=5\u0026amp;wx_lazy=1\u0026amp;tp=webp\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u4EBF\u7EAC\u9502\u80FD\u50A8\u80FD\u56FD\u9645\u9500\u552E\u90E8\u603B\u7ECF\u7406\u9648\u840C\u840C\u53CA\u003C/p\u003E\n\u003Cp\u003ECenergi SEA \u603B\u88C1 En Harman \u5171\u540C\u5C55\u793A\u50A8\u80FD\u91C7\u8D2D\u5408\u540C\u003C/p\u003E\n\u003Cp\u003E\u6B64\u6B21\u4E2D\u6807\u7684\u5409\u9686\u5761\u56FD\u9645\u673A\u573A\u5927\u578B\u5730\u9762\u5149\u4F0F\u914D\u50A8\u80FD\u7CFB\u7EDF\u9879\u76EE\uFF0C\u662F\u4EBF\u7EAC\u9502\u80FD\u5728\u9A6C\u6765\u897F\u4E9A\u7684\u9996\u4E2A\u96C6\u6210\u4EA4\u76F4\u6D41\u4E00\u4F53\u50A8\u80FD\u9879\u76EE\uFF0C\u603B\u5BB9\u91CF\u8FBE 10MW/36MWh \uFF0C\u91C7\u7528 628Ah \u50A8\u80FD\u5927\u7535\u6C60\u4E0E\u9AD8\u5EA6\u96C6\u6210\u5316\u67B6\u6784\uFF0C\u89C4\u5212\u914D\u7F6E 5MWh \u50A8\u80FD\u7CFB\u7EDF\uFF0C\u53EF\u9002\u7528\u4E8E\u53EF\u518D\u751F\u80FD\u6E90\u5E76\u7F51\u3001\u524A\u5CF0\u586B\u8C37\u3001\u7535\u7F51\u8C03\u9891\u7B49\u591A\u79CD\u573A\u666F\uFF0C\u9879\u76EE\u5C06\u8054\u52A8 36MWp \u5149\u4F0F\u7535\u7AD9\uFF0C\u4E3A\u5409\u9686\u5761\u56FD\u9645\u673A\u573A\u4E3B\u822A\u7AD9\u697C\u7A33\u5B9A\u4F9B\u5E94\u7EFF\u8272\u7535\u529B\uFF0C\u8BA1\u5212\u4E8E 2027 \u5E74\u5E76\u7F51\u6295\u7528\u3002\u003C/p\u003E\n\u003Cp\u003E\u4EBF\u7EAC\u9502\u80FD\u50A8\u80FD\u56FD\u9645\u9500\u552E\u90E8\u603B\u7ECF\u7406\u9648\u840C\u840C\u8868\u793A\uFF1A\u201C\u5F88\u8363\u5E78\u80FD\u591F\u4E3A\u5409\u9686\u5761\u56FD\u9645\u673A\u573A\u8FD9\u6837\u4E16\u754C\u7EA7\u7684\u4EA4\u901A\u67A2\u7EBD\u63D0\u4F9B\u7EFF\u8272\u80FD\u6E90\u89E3\u51B3\u65B9\u6848\u3002\u6211\u4EEC\u5C06\u5145\u5206\u53D1\u6325\u5728\u50A8\u80FD\u9886\u57DF\u7684\u6280\u672F\u79EF\u7D2F\u548C\u9879\u76EE\u7ECF\u9A8C\uFF0C\u786E\u4FDD\u6B64\u9879\u76EE\u7684\u9AD8\u8D28\u91CF\u4EA4\u4ED8\u3002\u201D\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/sz_mmbiz_jpg/ww9jCzgoAcUKPaFrlfTWhmexCULOjyT7ib0wXmUwKmzWv5p2ibyrBvkxeKSufxSSTyPkWRYUvXFDvicwzXTxokkibe2A1AFzL5IYIbDAnpGuzhA/640?wx_fmt=jpeg\u0026amp;wxfrom=5\u0026amp;wx_lazy=1\u0026amp;tp=webp\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u4F5C\u4E3A\u4E16\u754C\u6392\u540D\u524D 10 \u3001\u5168\u7403\u8FDE\u901A\u6027\u6392\u540D\u7B2C 4 \u3001\u4E1C\u5357\u4E9A\u7B2C 2 \u7E41\u5FD9\u7684\u5927\u578B\u673A\u573A\uFF0C\u5409\u9686\u5761\u56FD\u9645\u673A\u573A\u5E74\u5EA6\u5BA2\u8FD0\u91CF\u9AD8\u8FBE 600 \u4E07\u4EBA\u6B21\u3002\u4EBF\u7EAC\u9502\u80FD\u79EF\u6781\u54CD\u5E94\u9A6C\u6765\u897F\u4E9A\u80FD\u6E90\u8F6C\u578B\u8BA1\u5212\uFF08NETR\uFF09\u53CA\u5F53\u5730\u51CF\u78B3\u6392\u653E\u76EE\u6807\uFF0C\u51ED\u501F\u50A8\u80FD\u9886\u57DF\u6280\u672F\u4F18\u52BF\uFF0C\u4E3A\u5409\u9686\u5761\u56FD\u9645\u673A\u573A\u63D0\u4F9B\u4E86\u6781\u81F4\u5B89\u5168\u3001\u66F4\u9AD8\u6548\u7387\u7684\u50A8\u80FD\u7CFB\u7EDF\u89E3\u51B3\u65B9\u6848\uFF0C\u5EFA\u6210\u540E\u9884\u8BA1\u5E74\u5747\u51CF\u78B3\u91CF\u7EA6 42,006 \u5428\uFF0C\u52A9\u529B\u673A\u573A\u5B9E\u73B0 2030 \u5E74\u53EF\u518D\u751F\u80FD\u6E90\u5360\u6BD4\u76EE\u6807\u4E0E\u96F6\u78B3\u613F\u666F\u3002\u003C/p\u003E\n\u003Cp\u003E\u672A\u6765\uFF0C\u4EBF\u7EAC\u9502\u80FD\u5C06\u7EE7\u7EED\u79C9\u6301\u201C\u5408\u4F5C\u5171\u8D62\u201D\u7684\u7406\u5FF5\uFF0C\u8FDB\u4E00\u6B65\u6DF1\u5316\u4E0E\u9A6C\u6765\u897F\u4E9A\u7B49\u4E1C\u5357\u4E9A\u5E02\u573A\u5BA2\u6237\u7684\u5408\u4F5C\uFF0C\u4E0E\u5168\u7403\u4F19\u4F34\u643A\u624B\u63A8\u52A8\u80FD\u6E90\u6E05\u6D01\u8F6C\u578B\u4E0E\u89C4\u6A21\u5316\u5E94\u7528\uFF0C\u4E3A\u6784\u5EFA\u53EF\u6301\u7EED\u53D1\u5C55\u7684\u9AD8\u8D28\u91CF\u80FD\u6E90\u4F53\u7CFB\u8D21\u732E\u66F4\u591A\u529B\u91CF\u3002\u003C/p\u003E\n",
