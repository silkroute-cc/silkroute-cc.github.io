{
  "id": "%e6%90%ba%e6%89%8b%e5%90%8c%e8%a1%8c%e4%b8%ad%e6%96%87%e8%b7%af-%e5%85%b1%e5%88%9b%e6%95%99%e8%82%b2%e6%96%b0%e5%a4%a9%e5%9c%b0",
  "slug": "%e6%90%ba%e6%89%8b%e5%90%8c%e8%a1%8c%e4%b8%ad%e6%96%87%e8%b7%af-%e5%85%b1%e5%88%9b%e6%95%99%e8%82%b2%e6%96%b0%e5%a4%a9%e5%9c%b0",
  "canonicalUrlKey": "%e6%90%ba%e6%89%8b%e5%90%8c%e8%a1%8c%e4%b8%ad%e6%96%87%e8%b7%af-%e5%85%b1%e5%88%9b%e6%95%99%e8%82%b2%e6%96%b0%e5%a4%a9%e5%9c%b0",
  "route": "/4183/",
  "title": "\u643A\u624B\u540C\u884C\u4E2D\u6587\u8DEF \u5171\u521B\u6559\u80B2\u65B0\u5929\u5730",
  "summary": "2023 \u5E74 3 \u6708\uFF0C\u901A\u8FC7\u4E2D\u56FD\u56FD\u9645\u4E2D\u6587\u6559\u80B2\u57FA\u91D1\u4F1A\u7EC4\u7EC7\u7684\u9762\u8BD5\uFF0C\u9009\u51FA\u4E86 8 \u4F4D\u5FD7\u613F\u8005\u6559\u5E08\u548C 1 \u4F4D\u516C\u6D3E\u6559\u5E08\uFF0C\u8BA1\u5212\u6D3E\u5F80\u9A6C\u6765\u897F\u4E9A\u7802\u62C9\u8D8A\u79D1\u6280\u5927\u5B66\u5B54\u5B50\u5B66\u9662\u4EFB\u6559\u3002\u7531\u4E8E\u7B7E\u8BC1\u529E\u7406\u5468\u671F\u957F\uFF0C\u52A0\u4E0A 2023 \u5E74\u9A6C\u6765\u897F\u4E9A\u6559\u80B2\u90E8\u95E8\u653F\u7B56\u7684\u53D8\u5316\uFF0C\u8981\u6C42\u6765\u9A6C\u4ECE\u6559\u4EBA\u5458\u5FC5\u987B\u5177\u6709\u9A6C\u6765\u897F\u4E9A\u6559\u80B2\u90E8\u95E8\u9881\u53D1\u7684\u6559\u5E08\u8D44\u683C\u8BC1\uFF0C\u56E0\u6B64\u7B7E\u8BC1\u529E\u7406\u65F6\u95F4\u6BD4\u4EE5\u5F80\u66F4\u957F\u4E86\u3002\u957F\u671F\u7684\u7B49\u5F85\u8BA9\u5FD7\u613F\u8005\u6559\u5E08\u4EEC\u611F\u5230\u7126\u8651\uFF0C\u6709\u7684\u751A\u81F3\u5F00\u59CB\u627E\u5DE5\u4F5C\uFF0C\u60F3\u653E\u5F03\u505A\u5FD7\u613F\u8005\u6559\u5E08\u7684\u521D\u8877\u3002 \u4E3A\u4E86\u7A33\u5B9A\u6559\u5E08\u961F\u4F0D\u5E76\u63D0\u5347\u6559\u5B66\u80DC\u4EFB\u529B\uFF0C\u534E\u5317\u6C34\u5229\u6C34\u7535\u5927\u5B66\u56FD\u9645\u4EA4\u6D41\u4E0E\u5408\u4F5C\u5904\u7EC4\u7EC7\u4E86\u5BF9\u5FD7\u613F\u8005\u6559\u5E08\u7684\u57F9\u8BAD\u2026",
  "body": "\u003Cp\u003E2023\u5E743\u6708\uFF0C\u901A\u8FC7\u4E2D\u56FD\u56FD\u9645\u4E2D\u6587\u6559\u80B2\u57FA\u91D1\u4F1A\u7EC4\u7EC7\u7684\u9762\u8BD5\uFF0C\u9009\u51FA\u4E868\u4F4D\u5FD7\u613F\u8005\u6559\u5E08\u548C1\u4F4D\u516C\u6D3E\u6559\u5E08\uFF0C\u8BA1\u5212\u6D3E\u5F80\u9A6C\u6765\u897F\u4E9A\u7802\u62C9\u8D8A\u79D1\u6280\u5927\u5B66\u5B54\u5B50\u5B66\u9662\u4EFB\u6559\u3002\u7531\u4E8E\u7B7E\u8BC1\u529E\u7406\u5468\u671F\u957F\uFF0C\u52A0\u4E0A2023\u5E74\u9A6C\u6765\u897F\u4E9A\u6559\u80B2\u90E8\u95E8\u653F\u7B56\u7684\u53D8\u5316\uFF0C\u8981\u6C42\u6765\u9A6C\u4ECE\u6559\u4EBA\u5458\u5FC5\u987B\u5177\u6709\u9A6C\u6765\u897F\u4E9A\u6559\u80B2\u90E8\u95E8\u9881\u53D1\u7684\u6559\u5E08\u8D44\u683C\u8BC1\uFF0C\u56E0\u6B64\u7B7E\u8BC1\u529E\u7406\u65F6\u95F4\u6BD4\u4EE5\u5F80\u66F4\u957F\u4E86\u3002\u957F\u671F\u7684\u7B49\u5F85\u8BA9\u5FD7\u613F\u8005\u6559\u5E08\u4EEC\u611F\u5230\u7126\u8651\uFF0C\u6709\u7684\u751A\u81F3\u5F00\u59CB\u627E\u5DE5\u4F5C\uFF0C\u60F3\u653E\u5F03\u505A\u5FD7\u613F\u8005\u6559\u5E08\u7684\u521D\u8877\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E3A\u4E86\u7A33\u5B9A\u6559\u5E08\u961F\u4F0D\u5E76\u63D0\u5347\u6559\u5B66\u80DC\u4EFB\u529B\uFF0C\u534E\u5317\u6C34\u5229\u6C34\u7535\u5927\u5B66\u56FD\u9645\u4EA4\u6D41\u4E0E\u5408\u4F5C\u5904\u7EC4\u7EC7\u4E86\u5BF9\u5FD7\u613F\u8005\u6559\u5E08\u7684\u57F9\u8BAD\u3002\u9996\u5148\uFF0C\u5B66\u6821\u4E8E2023\u5E747\u6708\u53EC\u5F00\u4E862023\u5E74\u56FD\u9645\u4E2D\u6587\u6559\u80B2\u5FD7\u613F\u8005\u7EBF\u4E0A\u884C\u524D\u5B89\u5168\u6559\u80B2\u66A8\u57F9\u8BAD\u4F1A\u3002\u526F\u6821\u957F\u5218\u96EA\u6885\u4EE3\u8868\u5B66\u6821\u5411\u5FD7\u613F\u8005\u4EEC\u63D0\u51FA\u4E86\u5177\u4F53\u8981\u6C42\uFF0C\u56FD\u9645\u4EA4\u6D41\u4E0E\u5408\u4F5C\u5904\u8FDB\u884C\u4E86\u884C\u524D\u5B89\u5168\u6559\u80B2\uFF0C\u4E2D\u65B9\u5019\u4EFB\u9662\u957F\u4E3A\u5FD7\u613F\u8005\u4EEC\u505A\u4E86\u9898\u4E3A\u201C\u56FD\u9645\u4E2D\u6587\u6559\u5B66\u80DC\u4EFB\u529B\u63D0\u5347\u9014\u5F84\u201D\u7684\u4E13\u9898\u57F9\u8BAD\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/11/frc-69a1c5d6be0314cb46175aacfa5d093b.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5176\u6B21\uFF0C\u7802\u62C9\u8D8A\u79D1\u6280\u5927\u5B66\u5B54\u9662\u5BF9\u5373\u5C06\u5165\u804C\u7684\u5FD7\u613F\u8005\u6559\u5E08\u8FDB\u884C\u4E86\u624B\u628A\u624B\u7684\u4F20\u5E2E\u5E26\u3002\u7B2C\u4E00\uFF0C\u63D0\u4F9B\u6559\u5B66\u8D44\u6E90\u3002\u5B54\u5B50\u5B66\u9662\u6559\u5B66\u56E2\u961F\u628A\u300AHSK\u6807\u51C6\u6559\u7A0B\u300B\u7684\u6559\u5B66\u8D44\u6E90\u6253\u5305\u53D1\u9001\u7ED9\u65B0\u624B\u6559\u5E08\uFF0C\u8BA9\u4ED6\u4EEC\u5728\u5236\u4F5C\u8BFE\u4EF6\u524D\u6709\u4E2A\u53EF\u4F9B\u53C2\u8003\u7684\u57FA\u672C\u7684\u6846\u67B6\uFF0C\u964D\u4F4E\u4E86\u5907\u8BFE\u96BE\u5EA6\uFF0C\u51CF\u5C11\u4E86\u5FC3\u7406\u7126\u8651\u3002\u8BFE\u4EF6\u5B8C\u6210\u540E\uFF0C\u5728\u4E0A\u8BFE\u524D\u4E24\u5230\u4E09\u5929\u53D1\u7ED9\u5B54\u5B50\u5B66\u9662\u3002\u7B2C\u4E8C\uFF0C\u9488\u5BF9\u8BFE\u4EF6\uFF0C\u6709\u884C\u4E1A\u7ECF\u9A8C\u7684\u6559\u5E08\u63D0\u51FA\u6539\u8FDB\u5EFA\u8BAE\uFF0C\u5982\uFF1A\uFF081\uFF09\u8BFE\u4EF6\u5448\u73B0\u8981\u540C\u65F6\u505A\u5230\u62FC\u97F3-\u6C49\u5B57-\u82F1\u6587\u89E3\u91CA\uFF1B\uFF082\uFF09\u6559\u5B66\u5185\u5BB9\u8D34\u8FD1\u5B66\u4E60\u8005\u7684\u73B0\u6709\u6C34\u5E73\uFF0C\u4E0D\u8981\u7528\u5B66\u751F\u6CA1\u6709\u5B66\u8FC7\u7684\u8BCD\u8BED\u6765\u89E3\u91CA\u8BFE\u7A0B\u8868\u91CC\u7684\u751F\u8BCD\u7B49\u3002\u7B2C\u4E09\uFF0C\u8981\u6C42\u5FD7\u613F\u8005\u6559\u5E08\u90FD\u53C2\u4E0E\u542C\u8BFE\uFF0C\u4E0B\u8BFE\u540E\u8981\u6C42\u6BCF\u4E2A\u5FD7\u613F\u8005\u5BF9\u672C\u8282\u8BFE\u7684\u4F18\u7F3A\u70B9\u5C55\u5F00\u8BA8\u8BBA\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/11/frc-0d32e76b569837081e644b7a431f92d5.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u8FD9\u6837\u7684\u5B89\u6392\u80FD\u591F\u8BA9\u5FD7\u613F\u8005\u6559\u5E08\u5728\u7B49\u5F85\u6D3E\u51FA\u7684\u8FC7\u7A0B\u4E2D\u719F\u6089\u4E1A\u52A1\uFF0C\u8FC5\u901F\u9002\u5E94\u6559\u5B66\u5DE5\u4F5C\u3002\u6700\u660E\u663E\u7684\u597D\u5904\u5C31\u662F\u5177\u6709\u591A\u5E74\u4ECE\u4E1A\u7ECF\u5386\u7684\u6559\u5E08\u628A\u5B9D\u8D35\u7684\u6559\u5B66\u7ECF\u9A8C\u4F20\u6388\u7ED9\u7EE7\u4EFB\u6559\u5E08\u3002\u901A\u8FC7\u57F9\u8BAD\uFF0C\u5FD7\u613F\u8005\u6559\u5E08\u5728\u4EE5\u4E0B\u51E0\u4E2A\u65B9\u9762\u6548\u679C\u663E\u8457\u3002\u4E00\u662F\u79EF\u7D2F\u4E86\u6559\u5B66\u7ECF\u9A8C\uFF0C\u514B\u670D\u4E86\u65B0\u6559\u5E08\u7684\u7D27\u5F20\u548C\u7126\u8651\u611F\uFF0C\u4E3A\u4EE5\u540E\u7684\u7EBF\u4E0B\u4E0A\u8BFE\u505A\u597D\u4E86\u5FC3\u7406\u51C6\u5907\uFF1B\u4E8C\u662F\u8BFE\u4EF6\u5236\u4F5C\u7684\u8D28\u91CF\u6709\u660E\u663E\u63D0\u9AD8\uFF0C\u5FD7\u613F\u8005\u6559\u5E08\u5B66\u4F1A\u628A\u4EBA\u5DE5\u667A\u80FD\uFF08AI\uFF09\u6280\u672F\u5E94\u7528\u5230\u8BFE\u4EF6\u5236\u4F5C\uFF0C\u63D0\u9AD8\u4E86\u5C55\u793A\u6548\u679C\u548C\u8868\u73B0\u529B\u3002\u4E09\u662F\u9010\u6E10\u627E\u5230\u9002\u5408\u81EA\u5DF1\u548C\u5B66\u751F\u7684\u6559\u5B66\u65B9\u6CD5\uFF1B\u56DB\u662F\u5728\u6559\u5B66\u5185\u5BB9\u7684\u9009\u62E9\u65B9\u9762\u80FD\u591F\u8003\u8651\u5B66\u751F\u7684\u63A5\u53D7\u5EA6\uFF0C\u505A\u5230\u56E0\u6750\u65BD\u6559\uFF1B\u4E94\u662F\u5728\u67E5\u9605\u8D44\u6599\u7684\u8FC7\u7A0B\u4E2D\uFF0C\u81EA\u5DF1\u7684\u67E5\u8BE2\u80FD\u529B\u660E\u663E\u63D0\u5347\uFF0C\u4E2D\u6587\u77E5\u8BC6\u6C34\u5E73\u4E5F\u9010\u6E10\u5F97\u5230\u63D0\u9AD8\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/11/frc-0bde3faa232ce1f71f19dcb6907d6cc2.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u6587\u7A3F\uFF1A\u5415\u632F\u534E\u003C/p\u003E\n\u003Cp\u003E\u5BA1\u6838\uFF1A\u9EC4\u58F0\u5FC3\u003C/p\u003E\n\u003Cp\u003E\u7B7E\u53D1\uFF1A\u97E9\u5B5F\u5947\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/11/frc-b7f7fd777a24991e576981a48f25135f.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/_2i8cTjDOTJ7a0z2Tu5YiQ\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
