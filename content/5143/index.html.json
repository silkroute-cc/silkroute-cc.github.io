{
  "id": "%e6%a3%ae%e6%94%bf%e5%ba%9c%e4%b8%8e%e4%b8%ad%e5%9b%bd%e5%ae%89%e5%be%bd-%e6%8e%a2%e8%ae%a8%e5%b7%9e%e7%9c%81%e5%90%88%e4%bd%9c%e6%a8%a1%e5%bc%8f",
  "slug": "%e6%a3%ae%e6%94%bf%e5%ba%9c%e4%b8%8e%e4%b8%ad%e5%9b%bd%e5%ae%89%e5%be%bd-%e6%8e%a2%e8%ae%a8%e5%b7%9e%e7%9c%81%e5%90%88%e4%bd%9c%e6%a8%a1%e5%bc%8f",
  "canonicalUrlKey": "%e6%a3%ae%e6%94%bf%e5%ba%9c%e4%b8%8e%e4%b8%ad%e5%9b%bd%e5%ae%89%e5%be%bd-%e6%8e%a2%e8%ae%a8%e5%b7%9e%e7%9c%81%e5%90%88%e4%bd%9c%e6%a8%a1%e5%bc%8f",
  "route": "/5143/",
  "title": "\u68EE\u653F\u5E9C\u4E0E\u4E2D\u56FD\u5B89\u5FBD \u63A2\u8BA8\u5DDE\u7701\u5408\u4F5C\u6A21\u5F0F",
  "summary": "\u738B\u7FE0\u51E4\uFF08\u524D\u6392\u53F3\u4E94\uFF09\u7387\u988616\u540D\u4EE3\u8868\u56E2\u6210\u5458\u524D\u6765\u62DC\u8BBF\u68EE\u5DDE\u653F\u5E9C\uFF0C\u7531\u5F20\u8052\u7FD4\uFF08\u5DE6\u56DB\uFF09\u63A5\u5F85\uFF0C\u524D\u6392\u5DE6\u4E3A\u674E\u5178\u548C\u3002 \uFF08\u8299\u84C99\u65E5\u8BAF\uFF09\u68EE\u5DDE\u653F\u5E9C\u5C06\u4E0E\u4E2D\u56FD\u5B89\u5FBD\u7701\u653F\u5E9C\u5168\u529B\u63A8\u52A8\u4E24\u5730\u5408\u4F5C\u4E0E\u4E92\u8865\uFF0C\u4FC3\u8FDB\u4E24\u5730\u6295\u8D44\u4E0E\u7ECF\u8D38\u5408\u4F5C\uFF0C\u4EE5\u62DB\u63FD\u66F4\u591A\u6295\u8D44\u4E0E\u5408\u4F5C\u4F19\u4F34\u3002 \u68EE\u5DDE\u884C\u653F\u8BAE\u5458\u5F20\u8052\u7FD4\u53BB\u5E74\u66FE\u7387\u56E2\u524D\u53BB\u5B98\u8BBF\u5B89\u5FBD\u7701\u653F\u5E9C\uFF0C\u6628\u65E5\u5B89\u5FBD\u7701\u4EBA\u5927\u5E38\u59D4\u4F1A\u526F\u4E3B\u4EFB\u517C\u7701\u5DE5\u5546\u8054\u4E3B\u5E2D\u738B\u7FE0\u51E4\u5C31\u7387\u56E2\u524D\u6765\u68EE\u5DDE\u56DE\u8BBF\uFF0C\u4E00\u8D77\u63A2\u8BA8\u7701\u5DDE\u5408\u4F5C\u6A21\u5F0F\u3002 \u5176\u6210\u5458\u56E2\u5305\u62EC\u5B89\u5FBD\u7701\u4EBA\u5927\u5E38\u59D4\u4F1A\u76D1\u5BDF\u548C\u53F8\u6CD5\u5DE5\u59D4\u4E3B\u4EFB\u6A0A\u52C7\u3001\u5B89\u5FBD\u7701\u4EBA\u5927\u5E38\u59D4\u4F1A\u5916\u4E8B\u5DE5\u59D4\u526F\u4E3B\u4EFB\u675C\u7389\u5C71\u3001\u5B89\u5FBD\u7701\u4EBA\u6C11\u653F\u5E9C\u5916\u4E8B\u529E\u516C\u5BA4\u526F\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/09/frc-e2526981f93d5695d6bb0b40f7d07f16.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u738B\u7FE0\u51E4\uFF08\u524D\u6392\u53F3\u4E94\uFF09\u7387\u988616\u540D\u4EE3\u8868\u56E2\u6210\u5458\u524D\u6765\u62DC\u8BBF\u68EE\u5DDE\u653F\u5E9C\uFF0C\u7531\u5F20\u8052\u7FD4\uFF08\u5DE6\u56DB\uFF09\u63A5\u5F85\uFF0C\u524D\u6392\u5DE6\u4E3A\u674E\u5178\u548C\u3002\u003C/p\u003E\n\u003Cp\u003E\uFF08\u8299\u84C99\u65E5\u8BAF\uFF09\u68EE\u5DDE\u653F\u5E9C\u5C06\u4E0E\u4E2D\u56FD\u5B89\u5FBD\u7701\u653F\u5E9C\u5168\u529B\u63A8\u52A8\u4E24\u5730\u5408\u4F5C\u4E0E\u4E92\u8865\uFF0C\u4FC3\u8FDB\u4E24\u5730\u6295\u8D44\u4E0E\u7ECF\u8D38\u5408\u4F5C\uFF0C\u4EE5\u62DB\u63FD\u66F4\u591A\u6295\u8D44\u4E0E\u5408\u4F5C\u4F19\u4F34\u3002\u003C/p\u003E\n\u003Cp\u003E\u68EE\u5DDE\u884C\u653F\u8BAE\u5458\u5F20\u8052\u7FD4\u53BB\u5E74\u66FE\u7387\u56E2\u524D\u53BB\u5B98\u8BBF\u5B89\u5FBD\u7701\u653F\u5E9C\uFF0C\u6628\u65E5\u5B89\u5FBD\u7701\u4EBA\u5927\u5E38\u59D4\u4F1A\u526F\u4E3B\u4EFB\u517C\u7701\u5DE5\u5546\u8054\u4E3B\u5E2D\u738B\u7FE0\u51E4\u5C31\u7387\u56E2\u524D\u6765\u68EE\u5DDE\u56DE\u8BBF\uFF0C\u4E00\u8D77\u63A2\u8BA8\u7701\u5DDE\u5408\u4F5C\u6A21\u5F0F\u3002\u003C/p\u003E\n\u003Cp\u003E\u5176\u6210\u5458\u56E2\u5305\u62EC\u5B89\u5FBD\u7701\u4EBA\u5927\u5E38\u59D4\u4F1A\u76D1\u5BDF\u548C\u53F8\u6CD5\u5DE5\u59D4\u4E3B\u4EFB\u6A0A\u52C7\u3001\u5B89\u5FBD\u7701\u4EBA\u5927\u5E38\u59D4\u4F1A\u5916\u4E8B\u5DE5\u59D4\u526F\u4E3B\u4EFB\u675C\u7389\u5C71\u3001\u5B89\u5FBD\u7701\u4EBA\u6C11\u653F\u5E9C\u5916\u4E8B\u529E\u516C\u5BA4\u526F\u4E3B\u4EFB\u6768\u5C0F\u7433\u3001\u5B89\u5FBD\u7701\u5DE5\u5546\u8054\u526F\u4E3B\u5E2D\u8042\u78CA\u7B49\u4EE3\u8868\u3002\u003C/p\u003E\n\u003Cp\u003E\u5F20\u8052\u7FD4\u6628\u65E5\u5728\u8FBE\u57CEd\u0026#39;Tempat\u4E61\u6751\u4FF1\u4E50\u90E8\uFF0C\u4E0E\u5B89\u5FBD\u7701\u4EBA\u5927\u5E38\u59D4\u4F1A\u4EE3\u8868\u56E2\u8FDB\u884C\u4EA4\u6D41\u65F6\u6307\u51FA\uFF0C\u73B0\u4ECA\u5DF2\u6709\u5B89\u5FBD\u4F01\u4E1A\u5BB6\u5728\u68EE\u5DDE\u8BBE\u5382\uFF0C\u5E76\u5F97\u5230\u5DDE\u653F\u5E9C\u548C\u5546\u4F1A\u7684\u5168\u529B\u652F\u6301\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6307\u51FA\uFF0C\u68EE\u5DDE\u4F4D\u4E8E\u9A6C\u6765\u897F\u4E9A\u4E2D\u90E8\uFF0C\u975E\u5E38\u9760\u8FD1\u9996\u90FD\u5409\u9686\u5761\uFF0C\u53EA\u9700\u8981\u5927\u69821\u5C0F\u65F6\u8F66\u7A0B\uFF0C\u800C\u4E14\u4E5F\u4F4D\u4E8E\u7B56\u7565\u6027\u5730\u7406\u4F4D\u7F6E\uFF0C\u65E0\u8BBA\u662F\u524D\u5F80\u5409\u9686\u5761\u56FD\u9645\u673A\u573A\u6216\u5DF4\u751F\u7801\u5934\u90FD\u975E\u5E38\u9760\u8FD1\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u8FD1\u51E0\u5E74\u9646\u7EED\u6709\u8BB8\u591A\u5916\u8D44\u5230\u68EE\u5DDE\u6295\u8D44\uFF0C\u5F53\u4E2D\u5305\u62EC\u5DF2\u6295\u8D448\u4EBF5000\u4E07\u4EE4\u5409\u7684\u4E2D\u56FD\u6C7D\u8F66\u54C1\u724C\u54EA\u54A4\uFF08Neta\uFF09\u3001\u5DF2\u6295\u8D442\u4EBF5000\u4E07\u4EE4\u5409\u7684\u674E\u9526\u8BB0\u548C\u5DF2\u6295\u8D445000\u4E07\u4EE4\u5409\u7684\u5510\u5174\u88C5\u5907\uFF08\u9A6C\uFF09\u6709\u9650\u516C\u53F8\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u9664\u4E86\u4EE5\u4E0A\u4F01\u4E1A\uFF0C\u4E5F\u6709\u65D7\u6EE8\u96C6\u56E2\uFF08\u9A6C\u6765\u897F\u4E9A\uFF09\u6709\u9650\u516C\u53F8\u548C\u6052\u6E90\u7CBE\u70BC\uFF08HENGYUAN\uFF09\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u6BCF\u6708\u6709\u5DE5\u5382\u52A8\u571F\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u900F\u9732\uFF0C\u73B0\u4ECA\u8FD1\u4E4E\u6BCF\u4E2A\u6708\u90FD\u4F1A\u6709\u4E00\u4E2A\u65B0\u5DE5\u5382\u8FDB\u884C\u52A8\u571F\u793C\uFF0C\u8FD9\u65E0\u5F62\u95F4\u5E26\u52A8\u68EE\u5DDE\u7ECF\u6D4E\uFF0C\u4E5F\u5236\u9020\u66F4\u591A\u5C31\u4E1A\u673A\u4F1A\u3002\u003C/p\u003E\n\u003Cp\u003E\u51FA\u5E2D\u8005\u5305\u62EC\u91D1\u7FA4\u5229\u96C6\u56E2\uFF08MATRIX\uFF0C5236\uFF0C\u4E3B\u677F\u4EA7\u4E1A\u80A1\uFF09\u521B\u59CB\u4EBA\u62FF\u7763\u65AF\u91CC\u674E\u5178\u548C\u3001\u91D1\u7FA4\u5229\u96C6\u56E2\u8463\u4E8B\u674E\u7FA4\u5DDD\u548CMN HOLDINGS BERHAD\u5E38\u52A1\u8463\u4E8B\u62FF\u7763\u675C\u82F1\u6770\u966A\u540C\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/09/frc-fccc26952dcaca0e285106a786409707.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5F20\u8052\u7FD4\uFF08\u4E2D\uFF09\u5728\u674E\u5178\u548C\uFF08\u5DE6\uFF09\u7684\u966A\u540C\u4E0B\uFF0C\u79FB\u4EA4\u7EAA\u5FF5\u54C1\u7ED9\u738B\u7FE0\u51E4\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5DDE\u653F\u5E9C\u5B98\u8054\u516C\u53F8\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u8D1F\u8D23\u5DE5\u4E1A\u56ED\u57FA\u5EFA\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u5F20\u8052\u7FD4\u6307\u51FA\uFF0C\u5DDE\u653F\u5E9C\u5982\u4ECA\u975E\u5E38\u6CE8\u91CD\u5DE5\u4E1A\u56ED\uFF0C\u4E00\u822C\u4E0A\uFF0C\u5DE5\u4E1A\u56ED\u90FD\u662F\u7531\u5730\u65B9\u653F\u5E9C\u8D1F\u8D23\u5EFA\u8BBE\u7EF4\u4FEE\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u7EED\u8BF4\uFF0C\u4E3A\u4E86\u8BA9\u73B0\u6709\u5DE5\u4E1A\u56ED\u4E1A\u8005\u6709\u66F4\u597D\u7684\u57FA\u672C\u5EFA\u8BBE\uFF0C\u5DDE\u653F\u5E9C\u51B3\u5B9A\u5DE5\u4E1A\u56ED\u7684\u57FA\u672C\u5EFA\u8BBE\u5C06\u5728\u65E5\u540E\u7531\u5DDE\u653F\u5E9C\u7684\u5B98\u8054\u516C\u53F8\u7279\u522B\u8D1F\u8D23\uFF0C\u5C06\u4F1A\u66F4\u6709\u6548\u7387\u63D0\u4F9B\u66F4\u4F73\u7684\u7ECF\u5546\u73AF\u5883\u7ED9\u6295\u8D44\u8005\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6307\u51FA\uFF0C\u68EE\u5DDE\u7684\u571F\u5730\u552E\u4EF7\u66F4\u5177\u7ADE\u4E89\u529B\uFF0C\u6BD4\u8D77\u90BB\u5DDE\u4E5F\u4FBF\u5B9C15%\u81F320%\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u68EE\u5DDE\u653F\u5E9C\u4E5F\u6709\u8BBE\u7ACB\u68EE\u5DDE\u6295\u8D44\u673A\u6784\uFF0C\u53EF\u4EE5\u63D0\u4F9B\u4E00\u7AD9\u5F0F\u670D\u52A1\uFF0C\u89E3\u51B3\u6295\u8D44\u8005\u6240\u9762\u5BF9\u7684\u95EE\u9898\uFF0C\u4E5F\u53EF\u4EE5\u8BA9\u6295\u8D44\u8005\u4E86\u89E3\u5728\u68EE\u5DDE\u7684\u6295\u8D44\u673A\u4F1A\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u5DDE\u653F\u5E9C\u8DDF\u5DDE\u5185\u5546\u4F1A\u7684\u5173\u7CFB\u4E5F\u975E\u5E38\u597D\uFF0C\u968F\u7740\u4E2D\u9A6C\u4E24\u56FD\u843D\u5B9E\u514D\u7B7E\u653F\u7B56\uFF0C\u51E0\u4E4E\u6BCF\u5468\u6211\u90FD\u4F1A\u63A5\u5F85\u6765\u81EA\u4E2D\u56FD\u7684\u6295\u8D44\u8005\u6216\u5B98\u5458\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u7531\u4E8E\u73B0\u4ECA\u5165\u5883\u4E24\u56FD\u5DF2\u6BD4\u8F83\u65B9\u4FBF\uFF0C\u6240\u4EE5\u4E24\u56FD\u4F01\u4E1A\u5BB6\u5FC5\u987B\u6349\u7D27\u673A\u4F1A\uFF0C\u4EE5\u6269\u5927\u81EA\u8EAB\u7684\u751F\u610F\u3002\u003C/p\u003E\n\u003Cp\u003E\u738B\u7FE0\u51E4\u8BF4\uFF0C\u9A6C\u6765\u897F\u4E9A\u4E0E\u4E2D\u56FD\u4E00\u76F4\u4EE5\u6765\u90FD\u4EE5\u8BDA\u76F8\u5F85\uFF0C\u5728\u591A\u91CD\u9886\u57DF\u4E5F\u6709\u5408\u4F5C\u548C\u4EA4\u6D41\uFF0C\u800C\u4E14\u4EBA\u6587\u4EA4\u6D41\u4E5F\u5728\u65E5\u6E10\u589E\u52A0\u3002\u003C/p\u003E\n\u003Cp\u003E\u5979\u8BF4\uFF0C2024\u5E74\u4E3A\u4E2D\u9A6C\u5EFA\u4EA450\u5468\u5E74\uFF0C\u4E2D\u9A6C\u4E24\u56FD\u90FD\u6709\u4E00\u4E9B\u671F\u8BB8\uFF0C\u5373\u4E00\u8D77\u643A\u624B\u5171\u8FDB\uFF0C\u4E00\u8D77\u521B\u9020\u7E41\u8363\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u4E16\u754C\u534E\u5546\u5927\u4F1A\u5C06\u5728\u5409\u9686\u5761\u8FDB\u884C\uFF0C\u6211\u76F8\u4FE1\u4E00\u5B9A\u4F1A\u52A0\u5F3A\u4E24\u56FD\u7684\u4EA4\u6D41\uFF0C\u6211\u4E5F\u5E0C\u671B\u80FD\u6709\u66F4\u591A\u4F01\u4E1A\u5BB6\u52A0\u5165\u53CC\u5411\u53D1\u5C55\u7684\u673A\u4F1A\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u5979\u900F\u9732\uFF0C\u4E2D\u56FD\u73B0\u4ECA\u975E\u5E38\u91CD\u89C6\u4EBA\u6587\u4EA4\u6D41\uFF0C\u6709\u4E00\u4E9B\u9AD8\u6821\u5DF2\u5F00\u59CB\u62DB\u6536\u5916\u56FD\u751F\uFF0C\u4E5F\u6709\u4E00\u4E9B\u5927\u5B66\u751A\u81F3\u63D0\u4F9B\u5956\u5B66\u91D1\uFF0C\u4EE5\u5438\u5F15\u66F4\u591A\u5916\u56FD\u751F\u524D\u53BB\u6DF1\u9020\u4EA4\u6D41\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/ALztqQFsPj6opRh6DyN_jQ\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
