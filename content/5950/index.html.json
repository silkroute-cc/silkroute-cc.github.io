{
  "id": "\u6D3B\u52A8\u9884\u544A\u5370\u523B\u76AE\u5F71\u7FFB\u9875\u6210\u620F\u6C34\u5370\u6728\u523B\u624B\u7FFB\u4E66\u521B\u4F5C\u8425\u5F00\u59CB\u62A5\u540D\u5566",
  "slug": "\u6D3B\u52A8\u9884\u544A\u5370\u523B\u76AE\u5F71\u7FFB\u9875\u6210\u620F\u6C34\u5370\u6728\u523B\u624B\u7FFB\u4E66\u521B\u4F5C\u8425\u5F00\u59CB\u62A5\u540D\u5566",
  "canonicalUrlKey": "\u6D3B\u52A8\u9884\u544A\u5370\u523B\u76AE\u5F71\u7FFB\u9875\u6210\u620F\u6C34\u5370\u6728\u523B\u624B\u7FFB\u4E66\u521B\u4F5C\u8425\u5F00\u59CB\u62A5\u540D\u5566",
  "route": "/5950/",
  "title": "\u6D3B\u52A8\u9884\u544A\uFF5C\u5370\u523B\u76AE\u5F71\u30FB\u7FFB\u9875\u6210\u620F\u2014\u2014\u6C34\u5370\u6728\u523B\u624B\u7FFB\u4E66\u521B\u4F5C\u8425\u5F00\u59CB\u62A5\u540D\u5566\uFF01",
  "summary": "\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u4E3B\u529E\u0022\u5370\u523B\u76AE\u5F71\u00B7\u7FFB\u9875\u6210\u620F\u2014\u2014\u6C34\u5370\u6728\u523B\u624B\u7FFB\u4E66\u521B\u4F5C\u8425\u0022\uFF0C\u5C06\u4E8E2026\u5E745\u670816\u65E5\u4E3E\u884C\u3002\u6D3B\u52A8\u4EE5\u76AE\u5F71\u620F\u4E0E\u6C34\u5370\u6728\u523B\u975E\u9057\u4E3A\u4E3B\u9898\uFF0C\u53C2\u4E0E\u8005\u53EF\u4EB2\u624B\u5236\u4F5C\u76AE\u5F71\u624B\u7FFB\u4E66\uFF0C\u4F53\u9A8C\u4E2D\u56FD\u975E\u9057\u521B\u610F\uFF0C\u540D\u989D40\u4F4D\uFF0C\u989D\u6EE1\u5373\u6B62\u3002",
  "body": "\u003Cimg src=\u0022https://mmbiz.qpic.cn/sz_mmbiz_png/KpBbR2xoyyqF3r5hmDWsAjAarCaylOIvlupgnrhB9ibIovibftQ8ymTNZFtvjwCN5VRPRwfYmeWSib7ebQz8c3NBG9fNEr9jE7sk3INv9WqjRg/640?wx_fmt=png\u0026amp;from=appmsg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u76AE\u5F71\u620F\u662F\u5343\u5E74\u5149\u5F71\u9B54\u6CD5\uFF0C\u6C34\u5370\u6728\u523B\u85CF\u7740\u201C\u5206\u7248\u5957\u5370\u201D\u7684\u667A\u6167\u5BC6\u7801\u3002\u003C/p\u003E\n\u003Cp\u003E\u6211\u4EEC\u53D1\u73B0\uFF1A\u76AE\u5F71\u9760\u201C\u5173\u8282\u62C6\u89E3\u201D\u52A8\u8D77\u6765\uFF0C\u6728\u523B\u9760\u201C\u5206\u7248\u5957\u5370\u201D\u5370\u51FA\u6765\u2014\u2014\u4E24\u8005\u7684\u903B\u8F91\u7ADF\u5947\u5999\u76F8\u901A\u3002\u003C/p\u003E\n\u003Cp\u003E\u5F88\u591A\u4EBA\u6216\u8BB8\u5E76\u4E0D\u4E86\u89E3\uFF0C\u9A6C\u6765\u897F\u4E9A\u4E5F\u6709\u7740\u5E95\u8574\u6DF1\u539A\u7684\u76AE\u5F71\u975E\u9057\u3002\u5F53\u5730\u7ECF\u5178Wayang Kulit\uFF08\u54C7\u626C\u76AE\u5F71\uFF09\u4E2D\uFF0C\u4EE5\u5409\u5170\u4E39\u54C7\u626C\u76AE\u5F71\u6700\u5177\u4EE3\u8868\u6027\uFF0C\u91C7\u7528\u725B\u76AE\u96D5\u9542\u5F69\u7ED8\uFF0C\u7531\u827A\u4EBA\u5E55\u540E\u64CD\u63A7\u8868\u6F14\u3001\u541F\u5531\u53D9\u8BF4\uFF0C\u914D\u5408\u4F20\u7EDF\u4E50\u97F5\u6F14\u7ECE\u6C11\u4FD7\u6545\u4E8B\uFF0C\u662F\u9A6C\u6765\u897F\u4E9A\u672C\u571F\u6587\u5316\u4E2D\u6781\u5177\u7279\u8272\u7684\u5149\u5F71\u827A\u672F\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E2D\u56FD\u76AE\u5F71\u6E90\u8FDC\u6D41\u957F\u3001\u4E16\u4EE3\u4F20\u627F\uFF0C\u5728\u957F\u671F\u6C11\u95F4\u53D1\u5C55\u4E2D\u9010\u6B65\u5F62\u6210\u6210\u719F\u7684\u9020\u578B\u89C4\u5236\u4E0E\u8868\u6F14\u4F53\u7CFB\uFF0C\u4EE5\u7CBE\u5DE7\u7684\u5173\u8282\u7ED3\u6784\u3001\u7EC6\u817B\u8003\u7A76\u7684\u96D5\u7ED8\u8BBE\u8272\uFF0C\u6F14\u7ECE\u6C11\u95F4\u4F20\u8BF4\u4E0E\u4E16\u4FD7\u6545\u4E8B\uFF0C\u5728\u4E1C\u65B9\u4F20\u7EDF\u5149\u5F71\u827A\u672F\u4E2D\uFF0C\u5F62\u6210\u4E86\u72EC\u6709\u7684\u6587\u5316\u6C14\u8D28\u4E0E\u827A\u672F\u98CE\u8C8C\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/mmbiz_png/KpBbR2xoyyryOeafXyShljbtW6byV9FrgtxibvvugdkP6ia5lnKYUHImGsJJ9ARUH3OpIPn6vnYSkM1aBuV7Q0H9O4432ON8NVVQVR5bbytbQ/640?wx_fmt=png\u0026amp;from=appmsg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u6211\u4EEC\u628A\u8FD9\u7EC4\u201C\u975E\u9057\u5BC6\u7801\u201D\u53D8\u6210\u4E86\u4E00\u573A\u4EBA\u4EBA\u90FD\u80FD\u73A9\u7684\u624B\u4F5C\u6E38\u620F\u3002\u4F60\u5C06\u7528\u7279\u5236\u7684\u76AE\u5F71\u6A61\u76AE\u7AE0\uFF0C\u4EB2\u624B\u5957\u5370\u3001\u88C5\u5E27\uFF0C\u505A\u4E00\u672C\u5C5E\u4E8E\u81EA\u5DF1\u7684\u76AE\u5F71\u624B\u7FFB\u4E66\u3002\u003C/p\u003E\n\u003Cp\u003E\u8F7B\u8F7B\u4E00\u7FFB\uFF0C\u89D2\u8272\u7ACB\u523B\u5728\u6307\u5C16\u201C\u6D3B\u201D\u4E86\u8FC7\u6765\uFF0C\u4E0A\u6F14\u4F60\u81EA\u5DF1\u7684\u8FF7\u4F60\u52A8\u753B\u3002\u003C/p\u003E\n\u003Cp\u003E\u5E26\u8D70\u4F60\u7684\u624B\u7FFB\u4E66\uFF0C\u4E5F\u5E26\u8D70\u4E00\u4EFD\u770B\u5F97\u89C1\u3001\u73A9\u5F97\u5230\u7684\u4E2D\u56FD\u975E\u9057\u521B\u610F\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/sz_mmbiz_png/KpBbR2xoyypMAatYRmplX8wStDkVbq2amhfbgEpwhDDeRmqvZzEnjnconrxhw8SxKKHnlUY2UQiaUlTX8tn4zcaP7EYcicVlI4GIcBYXZuxVU/640?wx_fmt=png\u0026amp;from=appmsg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u4E3A\u8FDB\u4E00\u6B65\u4FC3\u8FDB\u4E2D\u9A6C\u6587\u5316\u827A\u672F\u4EA4\u6D41\uFF0C\u63A8\u52A8\u4E2D\u534E\u4F18\u79C0\u4F20\u7EDF\u6587\u5316\u7684\u521B\u65B0\u4F20\u64AD\uFF0C\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u4E0E\u4E2D\u5916\u6587\u5316\u548C\u65C5\u6E38\u4EA4\u6D41\u4E2D\u5FC3\u4E3B\u529E\u3001\u6D59\u6C5F\u827A\u672F\u804C\u4E1A\u5B66\u9662\u627F\u529E\u7684\u201C\u5370\u523B\u76AE\u5F71\u0026#183;\u7FFB\u9875\u6210\u620F\u2014\u2014\u6C34\u5370\u6728\u523B\u624B\u7FFB\u4E66\u521B\u4F5C\u8425\u201D\uFF0C\u73B0\u5728\u5F00\u542F\u62DB\u52DF\u5566\uFF01\u003C/p\u003E\n\u003Cp\u003E\u0026#127775; \u6D3B\u52A8\u8BE6\u60C5\u003C/p\u003E\n\u003Cp\u003E\u0026#128197; \u65E5\u671F\uFF1A2026\u5E745\u670816\u65E5\uFF08\u661F\u671F\u516D\uFF09\u003C/p\u003E\n\u003Cp\u003E\u23F0 \u65F6\u95F4\uFF1A2:00PM - 4:00PM\u003C/p\u003E\n\u003Cp\u003E\u0026#128205; \u5730\u70B9\uFF1A\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u003C/p\u003E\n\u003Cp\u003E(Lot 1-2-1, Menara Bangkok Bank, Berjaya Central Park, Jalan Ampang, 50450 Kuala Lumpur)\u003C/p\u003E\n\u003Cp\u003E\u0026#128101; \u540D\u989D\uFF1A40\u4F4D\u003C/p\u003E\n\u003Cp\u003E\u0026#129490; \u5E74\u9F84\uFF1A12\u5C81\u6216\u4EE5\u4E0A\u003C/p\u003E\n\u003Cp\u003E\u0026#127873; \u6750\u6599\uFF1A\u4E3B\u529E\u65B9\u7EDF\u4E00\u63D0\u4F9B\uFF0C\u65E0\u9700\u81EA\u5907\u003C/p\u003E\n\u003Cp\u003E\u0026#128279; \u62A5\u540D\u94FE\u63A5\uFF1Ahttps://forms.gle/EtnMTTm4kBZXUAHF7\u003C/p\u003E\n\u003Cp\u003E\u0026#128161; \u5EA7\u4F4D\u6709\u9650\uFF0C\u989D\u6EE1\u5373\u6B62\uFF01\u003C/p\u003E\n\u003Cp\u003E\u2728 \u6D3B\u52A8\u4EAE\u70B9\u003C/p\u003E\n\u003Cul\u003E\n\u003Cli\u003E\u76AE\u5F71\u975E\u9057\u5BFC\u89C8\uFF1A\u6DF1\u5165\u4E86\u89E3\u76AE\u5F71\u620F\u4E0E\u6C34\u5370\u6728\u523B\u6587\u5316\u003C/li\u003E\n\u003C/ul\u003E\n\u003Cp\u003E\\- \u6C89\u6D78\u5F0F\u624B\u4F5C\u4F53\u9A8C\uFF1A\u4EB2\u624B\u5236\u4F5C\u76AE\u5F71\u624B\u7FFB\u4E66\u4E0E\u5C0F\u624B\u5377\u003C/p\u003E\n\u003Cp\u003E\\- \u4E92\u52A8\u8BC4\u9009\uFF1A\u73B0\u573A\u5C55\u793A\u4F5C\u54C1\uFF0C\u8D62\u53D6\u7CBE\u7F8E\u5C0F\u793C\u54C1\u003C/p\u003E\n\u003Cp\u003E\u0026#128222; \u6D3B\u52A8\u54A8\u8BE2\u003C/p\u003E\n\u003Cp\u003E\u7535\u8BDD\uFF1A\u002B6019-6271048 / \u002B603-21812456\u003C/p\u003E\n\u003Cp\u003E\u90AE\u7BB1\uFF1Aproject@chinaculturalcentre.my\u003C/p\u003E\n\u003Cp\u003E\u6B22\u8FCE\u611F\u5174\u8DA3\u8005\u8E0A\u8DC3\u53C2\u4E0E\uFF01\u003C/p\u003E\n\u003Cp\u003E\u606D\u5019\u8385\u4E34\uFF0C\u5171\u8D74\u975E\u9057\u5149\u5F71\u4E4B\u7EA6\uFF5E\u003C/p\u003E\n",
