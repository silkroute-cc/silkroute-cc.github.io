  "title": "\u5C55\u6210\u679C\uFF0C\u4FC3\u5408\u4F5C\uFF0C\u8C0B\u53D1\u5C55\u2014\u2014\u4E2D\u77F3\u5316\u70BC\u5316\u5DE5\u7A0B\u96C6\u56E2\u53C2\u52A0\u9A6C\u6765\u897F\u4E9A2022\u56FD\u9645\u9879\u76EE\u7BA1\u7406\u4F1A\u5C55",
  "summary": "12\u670812\u65E5\u81F3 13\u65E5\uFF0C\u4E2D\u77F3\u5316\u70BC\u5316\u5DE5\u7A0B\uFF08\u96C6\u56E2\uFF09\u80A1\u4EFD\u6709\u9650\u516C\u53F8\uFF08SEG\uFF09\u53C2\u52A0\u5728\u9A6C\u6765\u897F\u4E9A\u5409\u9686\u5761\u4E3E\u884C\u7684\u56FD\u9645\u9879\u76EE\u7BA1\u7406\u4F1A\u8BAE\u3002 \u4E2D\u77F3\u5316\u70BC\u5316\u5DE5\u7A0B\u96C6\u56E2\u9A6C\u6765\u897F\u4E9A\u516C\u53F8\u603B\u7ECF\u7406\u6D82\u52C7\u4E0ESEG\u5728\u9A6C\u6210\u5458\u5355\u4F4D\u4EE3\u8868\u51FA\u5E2D\u4F1A\u8BAE\uFF0C\u5E76\u9080\u8BF7\u5F53\u5730\u5408\u4F5C\u4F19\u4F34\u3001\u5404\u53CB\u597D\u673A\u6784\u53CA\u9A7B\u9A6C\u4E2D\u8D44\u5144\u5F1F\u5355\u4F4D\u53C2\u89C2\u4E86SEG\u7684\u76F8\u5173\u5C55\u89C8\u3002 \u8BE5\u4F1A\u8BAE\u7531\u9A6C\u6765\u897F\u4E9A\u56FD\u5BB6\u77F3\u6CB9\u516C\u53F8\uFF08\u4EE5\u4E0B\u7B80\u79F0\u201C\u9A6C\u56FD\u6CB9\u201D\uFF09\u4E3E\u529E\uFF0C\u4EE5\u201C\u98A0\u8986\u6027\u6280\u672F\u548C\u53EF\u6301\u7EED\u6027\u7684\u65F6\u4EE3\u201D\u4E3A\u4E3B\u9898\uFF0C\u805A\u96C6\u4E86\u6765\u81EA\u5305\u62EC\u77F3\u6CB9\u548C\u5929\u7136\u6C14\u3001\u65B0\u80FD\u6E90\u3001\u6D77\u4E8B\u548C\u822A\u8FD0\u3001 \u5EFA\u7B51\u548C\u57FA\u7840\u8BBE\u65BD\u4EE5\u53CA\u6570\u5B57\u5316\u7B49\u4E94\u4E2A\u884C\u4E1A\u9879\u76EE\u7BA1\u7406\u4ECE\u4E1A\u8005\uFF0C\u4F1A\u8BAE\u65E8\u5728\u8BA9\u9879\u76EE\u7BA1\u2026",
  "body": "\u003Cp\u003E12\u670812\u65E5\u81F313\u65E5\uFF0C\u4E2D\u77F3\u5316\u70BC\u5316\u5DE5\u7A0B\uFF08\u96C6\u56E2\uFF09\u80A1\u4EFD\u6709\u9650\u516C\u53F8\uFF08SEG\uFF09\u53C2\u52A0\u5728\u9A6C\u6765\u897F\u4E9A\u5409\u9686\u5761\u4E3E\u884C\u7684\u56FD\u9645\u9879\u76EE\u7BA1\u7406\u4F1A\u8BAE\u3002\u4E2D\u77F3\u5316\u70BC\u5316\u5DE5\u7A0B\u96C6\u56E2\u9A6C\u6765\u897F\u4E9A\u516C\u53F8\u603B\u7ECF\u7406\u6D82\u52C7\u4E0ESEG\u5728\u9A6C\u6210\u5458\u5355\u4F4D\u4EE3\u8868\u51FA\u5E2D\u4F1A\u8BAE\uFF0C\u5E76\u9080\u8BF7\u5F53\u5730\u5408\u4F5C\u4F19\u4F34\u3001\u5404\u53CB\u597D\u673A\u6784\u53CA\u9A7B\u9A6C\u4E2D\u8D44\u5144\u5F1F\u5355\u4F4D\u53C2\u89C2\u4E86SEG\u7684\u76F8\u5173\u5C55\u89C8\u3002\u003C/p\u003E\n\u003Cp\u003E\u8BE5\u4F1A\u8BAE\u7531\u9A6C\u6765\u897F\u4E9A\u56FD\u5BB6\u77F3\u6CB9\u516C\u53F8\uFF08\u4EE5\u4E0B\u7B80\u79F0\u201C\u9A6C\u56FD\u6CB9\u201D\uFF09\u4E3E\u529E\uFF0C\u4EE5\u201C\u98A0\u8986\u6027\u6280\u672F\u548C\u53EF\u6301\u7EED\u6027\u7684\u65F6\u4EE3\u201D\u4E3A\u4E3B\u9898\uFF0C\u805A\u96C6\u4E86\u6765\u81EA\u5305\u62EC\u77F3\u6CB9\u548C\u5929\u7136\u6C14\u3001\u65B0\u80FD\u6E90\u3001\u6D77\u4E8B\u548C\u822A\u8FD0\u3001 \u5EFA\u7B51\u548C\u57FA\u7840\u8BBE\u65BD\u4EE5\u53CA\u6570\u5B57\u5316\u7B49\u4E94\u4E2A\u884C\u4E1A\u9879\u76EE\u7BA1\u7406\u4ECE\u4E1A\u8005\uFF0C\u4F1A\u8BAE\u65E8\u5728\u8BA9\u9879\u76EE\u7BA1\u7406\u4ECE\u4E1A\u8005\u901A\u8FC7\u5206\u4EAB\u8DE8\u884C\u4E1A\u7684\u6700\u4F73\u5B9E\u8DF5\u3001\u7ECF\u9A8C\u6559\u8BAD\u3001\u5C16\u7AEF\u6280\u672F\u3001\u5DE5\u5177\u548C\u6D41\u7A0B\uFF0C\u4EE5\u9A7E\u9A6D\u8FD9\u4E2A\u98A0\u8986\u6027\u6280\u672F\u548C\u53EF\u6301\u7EED\u53D1\u5C55\u7684\u65B0\u65F6\u4EE3\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2022/12/frc-71915227bd171e553ac1d3522aa335fa.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\uFF08\u56FE\u5DE6\u4E8C\u4E3A\u9A6C\u6765\u897F\u4E9A\u5DE5\u7A0B\u90E8\u603B\u79D8\u4E66\u957F\uFF0C\u53F3\u4E00\u9A6C\u56FD\u6CB9\u9AD8\u7EA7\u526F\u603B\u88C1\uFF0C\u5DE6\u4E00\u4E3A\u9A6C\u56FD\u6CB9\u526F\u603B\u88C1\u53C2\u89C2\u6211\u516C\u53F8\u5C55\u5385\uFF09\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u53C2\u52A0\u6B64\u6B21\u76DB\u4F1A\u5E76\u4E3E\u529E\u63A8\u4ECB\u5C55\u89C8\uFF0CSEG\u5168\u9762\u5C55\u793A\u4E86\u5176\u5728\u70BC\u5316\u5DE5\u7A0B\u9886\u57DF\u7684\u9886\u5148\u6280\u672F\u3001\u4E00\u4F53\u5316\u5DE5\u7A0B\u670D\u52A1\u80FD\u529B\u3001\u5353\u8D8A\u7A81\u51FA\u7684\u5DE5\u7A0B\u4E1A\u7EE9\u3001\u52A1\u5B9E\u9AD8\u6548\u7684\u9879\u76EE\u7BA1\u7406\u7ECF\u9A8C\uFF0C\u5E76\u4EE5\u6B64\u4E3A\u5951\u673A\uFF0C\u8FDB\u4E00\u6B65\u52A0\u5F3A\u5728\u5168\u7403\u8303\u56F4\u5185\u7684\u884C\u4E1A\u5F71\u54CD\u529B\u3001\u8FDB\u4E00\u6B65\u4FC3\u8FDB\u4EA7\u4E1A\u94FE\u4E0A\u4E0B\u6E38\u66F4\u591A\u5408\u4F5C\uFF0C\u8FDB\u4E00\u6B65\u63D0\u5347\u65B0\u683C\u5C40\u548C\u65B0\u65F6\u4EE3\u4E0B\u7684\u6D77\u5916\u4E1A\u52A1\u53EF\u6301\u7EED\u53D1\u5C55\u52A8\u80FD\u3002\u003C/p\u003E\n\u003Cp\u003E\u4F1A\u5C55\u73B0\u573A\uFF0CSEG\u7684\u5C55\u4F4D\u5E03\u7F6E\u5F97\u7AEF\u5E84\u5927\u65B9\uFF0C\u4E95\u4E95\u6709\u6761\u3002\u4E2D\u77F3\u5316\u5168\u7403\u7EDF\u4E00\u7684\u54C1\u724C\u6807\u8BC6\u548CSEG\u4F01\u4E1A\u613F\u666F\u201C\u521B\u5EFA\u4E16\u754C\u9886\u5148\u6280\u672F\u5148\u5BFC\u578B\u5DE5\u7A0B\u516C\u53F8\u201D\u7684\u5B57\u6837\u5728\u4E3B\u677F\u4E2D\u592E\u9C9C\u660E\u593A\u76EE\uFF0CSEG\u5F62\u8C61\u63A8\u4ECB\u89C6\u9891\u753B\u9762\u6EDA\u52A8\u64AD\u51FA\uFF0C\u80CC\u666F\u5899\u4E0A\uFF0CSEG\u5728\u9A6C\u627F\u5EFA\u9879\u76EE\u8FC7\u7A0B\u91CC\u7A0B\u7891\u56FE\u7247\u548C\u6240\u83B7\u5404\u7C7B\u8363\u8A89\u5FAA\u73AF\u5C55\u793A\uFF0C\u5F15\u4EBA\u6CE8\u76EE\u3002\u003C/p\u003E\n\u003Cp\u003ESEG\u5728\u9A6C\u5171\u6267\u884C2\u4E2AEPC\u603B\u627F\u5305\u9879\u76EE\uFF0C\u5206\u522B\u662F\u9A6C\u56FD\u6CB9RAPID P2\u5305\u4EE5\u53CARAPID P12A\u5305\u9879\u76EE\uFF0C\u603B\u8BA1\u5408\u540C\u989D\u903E15\u4EBF\u7F8E\u5143\u3002\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u56FD\u6CB9RAPID\u9879\u76EE\u4F4D\u4E8E\u9A6C\u6765\u897F\u4E9A\u67D4\u4F5B\u5DDE\u8FB9\u52A0\u5170\u5730\u533A\uFF0C\u662F\u9A6C\u6765\u897F\u4E9A\u56FD\u5BB6\u77F3\u6CB9\u516C\u53F8\u6295\u8D44\u7684\u8D85\u5927\u578B\u70BC\u6CB9\u548C\u5316\u5DE5\u4E00\u4F53\u5316\u9879\u76EE\uFF0C\u9879\u76EE\u6574\u4F53\u6295\u8D44\u8FBE270\u4EBF\u7F8E\u5143\uFF0C\u662F\u9A6C\u6765\u897F\u4E9A\u8FD120\u5E74\u6295\u8D44\u89C4\u6A21\u6700\u5927\u7684\u5DE5\u7A0B\u9879\u76EE\u3002\u8BE5\u9879\u76EE\u7684\u5EFA\u6210\u6295\u4EA7\uFF0C\u5C06\u4FC3\u8FDB\u9A6C\u56FD\u6CB9\u4E30\u5BCC\u4EA7\u54C1\u79CD\u7C7B\u3001\u63D0\u5347\u4EA7\u54C1\u8D28\u91CF\uFF0C\u5E76\u6EE1\u8DB3\u4E1C\u5357\u4E9A\u5730\u533A\u4E0D\u65AD\u589E\u957F\u7684\u6210\u54C1\u6CB9\u548C\u5316\u5DE5\u539F\u6599\u9700\u6C42\u3002\u8BE5\u9879\u76EE\u7684\u6267\u884C\u662F\u4E2D\u56FD\u77F3\u5316\u5728\u54CD\u5E94\u56FD\u5BB6\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u5021\u8BAE\u7ED3\u51FA\u7684\u53C8\u4E00\u91CD\u5927\u6210\u679C\uFF0C\u5BF9\u6DF1\u5316\u4E2D\u9A6C\u53CB\u8C0A\u3001\u52A0\u5F3A\u4E2D\u9A6C\u53CC\u65B9\u957F\u671F\u80FD\u6E90\u5408\u4F5C\u3001\u6253\u9020\u4E2D\u56FD\u70BC\u5316\u5DE5\u7A0B\u6280\u672F\u56FD\u5BB6\u65B0\u540D\u7247\uFF0C\u52A9\u529B\u4E24\u56FD\u7ECF\u6D4E\u793E\u4F1A\u53D1\u5C55\u5177\u6709\u91CD\u8981\u610F\u4E49\u3002\u003C/p\u003E\n\u003Cp\u003E\u76EE\u524D\uFF0CSEG\u5728RAPID\u7684\u4E24\u4E2AEPCC\u603B\u627F\u5305\u9879\u76EE\u5747\u5DF2\u5148\u540E\u5B9E\u73B0\u9AD8\u6807\u51C6\u7AE3\u5DE5\uFF0C\u5E76\u8FDE\u7EED\u591A\u6B21\u88AB\u4E1A\u4E3B\u6388\u4E88\u6700\u4F73\u8D28\u91CF\u548C\u5B89\u5168\u627F\u5305\u5546\u8363\u8A89\u3002\u5176\u4E2DRAPID P2\u5305\u9879\u76EE\u66FE\u752815\u4E2A\u6708\u65F6\u95F4\u5B8C\u6210\u4E8623\u4E2A\u6708\u7684\u4EFB\u52A1\u91CF\uFF0C\u4EE5\u9AD8\u6548\u9AD8\u8D28\u91CF\u7684\u6210\u7EE9\u4E3A\u4E1A\u4E3B\u521B\u9020\u4E86\u8F83\u5927\u7ECF\u6D4E\u6548\u76CA\u548C\u4EF7\u503C\uFF0C\u5F97\u5230\u4E86\u4E1A\u4E3B\u9A6C\u56FD\u6CB9\u7684\u9AD8\u5EA6\u8D5E\u8A89\u3002\u9A6C\u56FD\u6CB9\u5148\u540E\u4E09\u6B21\u7EC4\u7EC7RAPID\u9879\u76EE\u5176\u5B83\u56FD\u9645\u77E5\u540D\u5DE5\u7A0B\u516C\u53F8\u627F\u5305\u5546\u5230SEG\u9879\u76EE\u73B0\u573A\u89C2\u6469\uFF0C\u5BF9SEG\u53C2\u5EFA\u5355\u4F4D\u5728\u9879\u76EE\u7EC4\u7EC7\u3001\u521B\u65B0\u7BA1\u7406\u3001\u89C4\u8303\u65BD\u5DE5\u7B49\u65B9\u9762\u7ED9\u4E88\u4E86\u5F88\u9AD8\u8BC4\u4EF7\uFF0C\u4E3B\u52A8\u8868\u8FBE\u4E86\u5C06\u4E0ESEG\u5F00\u5C55\u8FDB\u4E00\u6B65\u5408\u4F5C\u7684\u5F3A\u70C8\u610F\u613F\u3002\u003C/p\u003E\n\u003Cp\u003E\u5728RAPID\u9879\u76EE\u5B9E\u65BD\u8FC7\u7A0B\u4E2D\uFF0CSEG\u5145\u5206\u5C55\u793A\u4E86\u65B0\u65F6\u4EE3\u4E2D\u56FD\u77F3\u5316\u70BC\u5316\u5DE5\u7A0B\u4EBA\u7684\u826F\u597D\u5F62\u8C61\u548C\u7D20\u8D28\uFF0C\u589E\u8FDB\u4E86\u4E2D\u5916\u7C4D\u5458\u5DE5\u95F4\u7684\u6DF1\u539A\u53CB\u8C0A\uFF0C\u5E76\u5F3A\u5316\u4E86\u4E0E\u4E1A\u4E3B\u9A6C\u56FD\u6CB9\u7684\u6DF1\u5EA6\u5408\u4F5C\uFF0C\u4E3A\u4E2D\u56FD\u77F3\u5316\u5F00\u8F9F\u4E1C\u5357\u4E9A\u5E02\u573A\u5960\u5B9A\u4E86\u575A\u5B9E\u57FA\u7840\u3002\u53E6\u5916\uFF0CSEG\u5728\u9879\u76EE\u9AD8\u5CF0\u671F\u76F4\u63A5\u96C7\u4F63\u9A6C\u6765\u5F53\u5730\u5458\u5DE5\u53CA\u4E1C\u5357\u4E9A\u5468\u8FB9\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u56FD\u5BB6\u52B3\u5DE5\u4EBA\u6570\u8D85\u8FC72000\u4EBA\uFF0C\u5E76\u5728\u9A6C\u7F34\u7EB3\u5404\u7C7B\u7A0E\u8D39\u8D85\u8FC74300\u4E07\u7F8E\u5143\uFF0C\u4EE5\u5B9E\u9645\u884C\u52A8\u4E3A\u5F53\u5730\u7ECF\u6D4E\u53D1\u5C55\u548C\u4EBA\u5458\u5C31\u4E1A\u8D21\u732E\u529B\u91CF\uFF0C\u5F70\u663E\u4E86\u4E2D\u77F3\u5316\u7684\u4F01\u4E1A\u8D23\u4EFB\u4E0E\u62C5\u5F53\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2022/12/frc-b4535502ebb7d622335fb4c93d3fb50b.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E12\u670812\u65E5\u5C55\u4F1A\u5F00\u5E55\u5F53\u65E5\u4E0B\u5348\uFF0C\u4E2D\u56FD\u9A7B\u9A6C\u6765\u897F\u4E9A\u5927\u4F7F\u9986\u5F20\u4F69\u4E1C\u516C\u53C2\u7279\u610F\u8D74\u5409\u9686\u5761\u4F1A\u5C55\u4E2D\u5FC3\u5C55\u4F1A\u73B0\u573A\u53C2\u89C2\u4E86SINOPEC\u4E0E\u5176\u4ED6\u5728\u9A6C\u5144\u5F1F\u4E2D\u8D44\u4F01\u4E1A\u5C55\u53F0\uFF0C\u9AD8\u5EA6\u8BC4\u4EF7\u4E86\u4E2D\u56FD\u4F01\u4E1A\u5C24\u5176\u662F\u4E2D\u77F3\u5316\u70BC\u5316\u5DE5\u7A0B\u96C6\u56E2\u4F5C\u4E3A\u9886\u519B\u7684\u5DE5\u7A0B\u627F\u5305\u4F01\u4E1A\u5728\u9A6C\u6765\u897F\u4E9A\u5F00\u5C55\u7ECF\u8D38\u53CA\u5DE5\u7A0B\u5408\u4F5C\u53D6\u5F97\u7684\u4E00\u7CFB\u5217\u6210\u7EE9\uFF0C\u4EE5\u53CA\u4E3A\u8DF5\u884C\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u6218\u7565\u505A\u51FA\u7684\u5353\u8D8A\u8D21\u732E\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2022/12/frc-4e91bda8fac1084997b702ae956e4367.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003ERAPID\u9879\u76EE\u662FSEG\u79EF\u6781\u54CD\u5E94\u56FD\u5BB6\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u5021\u8BAE\u5728\u4E1C\u5357\u4E9A\u5B9E\u65BD\u7684\u5178\u578B\u4EE3\u8868\u6027\u9879\u76EE\u3002\u5728\u9879\u76EE\u6267\u884C\u8FC7\u7A0B\u4E2D\uFF0C\u589E\u8FDB\u4E86\u4E2D\u5916\u7C4D\u5458\u5DE5\u95F4\u7684\u6DF1\u539A\u53CB\u8C0A\uFF0C\u5E76\u52A0\u5F3A\u4E0E\u4E1A\u4E3B\u9A6C\u56FD\u6CB9\u6DF1\u5EA6\u5408\u4F5C\uFF0C\u4E3A\u4E2D\u56FD\u77F3\u5316\u5F00\u8F9F\u4E1C\u5357\u4E9A\u5E02\u573A\u5960\u5B9A\u4E86\u575A\u5B9E\u57FA\u7840\u3002\u003C/p\u003E\n\u003Cp\u003E\u53C2\u52A0\u6B64\u6B21\u56FD\u9645\u5C55\u4F1A\uFF0CSEG\u4E0D\u4EC5\u4EA4\u6D41\u4E86\u7ECF\u9A8C\u3001\u5C55\u793A\u4E86\u5B9E\u529B\u3001\u800C\u4E14\u52A0\u6DF1\u4E86\u5408\u4F5C\u3001\u521B\u9020\u4E86\u65B0\u673A\uFF0C\u53D6\u5F97\u4E86\u826F\u597D\u7684\u653F\u6CBB\u3001\u7ECF\u6D4E\u3001\u5E02\u573A\u548C\u793E\u4F1A\u6548\u5E94\u3002\u4ECA\u540E\uFF0CSEG\u5C06\u7EE7\u7EED\u53D1\u6325\u96C6\u56E2\u5316\u7EDF\u7B79\u534F\u8C03\u548C\u5927\u5175\u56E2\u4F5C\u6218\u4F18\u52BF\uFF0C\u6301\u7EED\u6DF1\u5316\u4E0E\u9A6C\u56FD\u6CB9\u7684\u5404\u9886\u57DF\u5408\u4F5C\uFF0C\u4E0D\u65AD\u52A0\u5F3A\u5883\u5916\u5E02\u573A\u5F00\u53D1\u548C\u9879\u76EE\u6267\u884C\u7684\u5168\u8FC7\u7A0B\u7BA1\u63A7\uFF0C\u6301\u7EED\u63D0\u5347\u516C\u53F8\u56FD\u9645\u5316\u7ECF\u8425\u80FD\u529B\uFF0C\u79EF\u6781\u8DF5\u884C\u56FD\u5BB6\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u6218\u7565\u90E8\u7F72\uFF0C\u52A0\u5927\u57F9\u80B2\u4E1C\u5357\u4E9A\u5730\u533A\u7684\u6295\u878D\u8D44\u9879\u76EE\u529B\u5EA6\uFF0C\u4EE5\u201C\u5E72\u597D\u4E00\u9879\u5DE5\u7A0B\uFF0C\u6811\u7ACB\u4E00\u9762\u54C1\u724C\uFF0C\u5360\u9886\u4E00\u65B9\u5E02\u573A\u201D\u4E3A\u76EE\u6807\uFF0C\u5B9E\u73B0SEG\u6D77\u5916\u4E1A\u52A1\u9AD8\u8D28\u91CF\u53EF\u6301\u7EED\u53D1\u5C55\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u4F9B\u7A3F\uFF1ASEG\u9A6C\u6765\u897F\u4E9A\u516C\u53F8\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\n\n\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/j7EdjV29a-JsqDOh8r-OVw\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
