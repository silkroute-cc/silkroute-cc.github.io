{
  "id": "%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e4%ba%a4%e9%80%9a%e9%83%a8%e4%b8%8e%e9%a9%ac%e8%b5%84%e6%ba%90%e5%90%88%e4%bd%9c-%e5%b9%b4%e5%86%85%e9%87%8d%e5%bb%ba%e5%90%89%e9%9a%86%e5%9d%a1%e4%b8%ad%e7%8e%af",
  "slug": "%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e4%ba%a4%e9%80%9a%e9%83%a8%e4%b8%8e%e9%a9%ac%e8%b5%84%e6%ba%90%e5%90%88%e4%bd%9c-%e5%b9%b4%e5%86%85%e9%87%8d%e5%bb%ba%e5%90%89%e9%9a%86%e5%9d%a1%e4%b8%ad%e7%8e%af",
  "canonicalUrlKey": "%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e4%ba%a4%e9%80%9a%e9%83%a8%e4%b8%8e%e9%a9%ac%e8%b5%84%e6%ba%90%e5%90%88%e4%bd%9c-%e5%b9%b4%e5%86%85%e9%87%8d%e5%bb%ba%e5%90%89%e9%9a%86%e5%9d%a1%e4%b8%ad%e7%8e%af",
  "route": "/4703/",
  "title": "\u9A6C\u6765\u897F\u4E9A\u4EA4\u901A\u90E8\u4E0E\u9A6C\u8D44\u6E90\u5408\u4F5C \u5E74\u5185\u91CD\u5EFA\u5409\u9686\u5761\u4E2D\u73AF\u8F66\u7AD9",
  "summary": "\u9646\u5146\u798F\uFF08\u524D\u6392\u4E2D\uFF09\u4E3A\u5927\u9A6C\u94C1\u9053\u8D44\u4EA7\u673A\u6784\u5927\u53A6\u526A\u5F69\u3002\u5DE6\u8D77\u54C8\u5BC6\u8FBE\u53CA\u62C9\u67E5\u91CC\uFF0C\u53F3\u4E09\u4E3A\u963F\u5179\u54C8\u3002 \u661F\u6D32\u65E5\u62A5 \uFF08\u5409\u9686\u576110\u65E5\u8BAF\uFF09\u4EA4\u901A\u90E8\u5C06\u4E0E\u9A6C\u8D44\u6E90\uFF08MRCB\uFF0C1651\uFF0C\u4E3B\u677F\u4EA7\u4E1A\u80A1\uFF09\u5408\u4F5C\uFF0C\u5728\u4ECA\u5E74\u5185\u91CD\u5EFA\u5409\u9686\u5761\u4E2D\u73AF\u8F66\u7AD9\uFF08KL Sentral\uFF09\u3002 \u90E8\u957F\u9646\u5146\u798F\u8BF4\uFF0C\u9A6C\u8D44\u6E90\u5C06\u4EE5\u903E10\u4EBF\u4EE4\u5409\u5C55\u5F00\u91CD\u5EFA\u9879\u76EE\uFF0C\u653F\u5E9C\u4E0D\u4F1A\u627F\u62C5\u4EFB\u4F55\u8D39\u7528\u3002 \u4ED6\u4ECA\u65E5\u4E3A\u5927\u9A6C\u94C1\u9053\u8D44\u4EA7\u673A\u6784\uFF08RAC\uFF09\u4E2D\u73AF\u5927\u53A6\u5F00\u5E55\u540E\u8BF4\uFF0C\u91CD\u5EFA\u9879\u76EE\u53BB\u5E748\u6708\u5DF2\u83B7\u5F97\u5185\u9601\u539F\u5219\u4E0A\u6279\u51C6\uFF0C\u901A\u8FC7\u516C\u79C1\u5408\u4F5C\u5021\u8BAE\uFF0C\u5BF9\u5409\u9686\u5761\u4E2D\u73AF\u8F66\u7AD9\u8FDB\u884C\u5F7B\u5E95\u6539\u9020\u3002 \u201C\u6B64\u8F66\u7AD9\u5C06\u8FDB\u884C\u63D0\u5347\uFF0C\u4F7F\u5176\u66F4\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/05/frc-0002b2be89759df5e1d2a5fa1553366c.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u9646\u5146\u798F\uFF08\u524D\u6392\u4E2D\uFF09\u4E3A\u5927\u9A6C\u94C1\u9053\u8D44\u4EA7\u673A\u6784\u5927\u53A6\u526A\u5F69\u3002\u5DE6\u8D77\u54C8\u5BC6\u8FBE\u53CA\u62C9\u67E5\u91CC\uFF0C\u53F3\u4E09\u4E3A\u963F\u5179\u54C8\u3002\u003C/p\u003E\n\u003Cp\u003E\u661F\u6D32\u65E5\u62A5\u003C/p\u003E\n\u003Cp\u003E\uFF08\u5409\u9686\u576110\u65E5\u8BAF\uFF09\u4EA4\u901A\u90E8\u5C06\u4E0E\u9A6C\u8D44\u6E90\uFF08MRCB\uFF0C1651\uFF0C\u4E3B\u677F\u4EA7\u4E1A\u80A1\uFF09\u5408\u4F5C\uFF0C\u5728\u4ECA\u5E74\u5185\u91CD\u5EFA\u5409\u9686\u5761\u4E2D\u73AF\u8F66\u7AD9\uFF08KL Sentral\uFF09\u3002\u003C/p\u003E\n\u003Cp\u003E\u90E8\u957F\u9646\u5146\u798F\u8BF4\uFF0C\u9A6C\u8D44\u6E90\u5C06\u4EE5\u903E10\u4EBF\u4EE4\u5409\u5C55\u5F00\u91CD\u5EFA\u9879\u76EE\uFF0C\u653F\u5E9C\u4E0D\u4F1A\u627F\u62C5\u4EFB\u4F55\u8D39\u7528\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u4ECA\u65E5\u4E3A\u5927\u9A6C\u94C1\u9053\u8D44\u4EA7\u673A\u6784\uFF08RAC\uFF09\u4E2D\u73AF\u5927\u53A6\u5F00\u5E55\u540E\u8BF4\uFF0C\u91CD\u5EFA\u9879\u76EE\u53BB\u5E748\u6708\u5DF2\u83B7\u5F97\u5185\u9601\u539F\u5219\u4E0A\u6279\u51C6\uFF0C\u901A\u8FC7\u516C\u79C1\u5408\u4F5C\u5021\u8BAE\uFF0C\u5BF9\u5409\u9686\u5761\u4E2D\u73AF\u8F66\u7AD9\u8FDB\u884C\u5F7B\u5E95\u6539\u9020\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6B64\u8F66\u7AD9\u5C06\u8FDB\u884C\u63D0\u5347\uFF0C\u4F7F\u5176\u66F4\u52A0\u73B0\u4EE3\u5316\u3001\u9AD8\u6548\uFF0C\u5E76\u4E0E\u5468\u8FB9\u5730\u533A\u65E0\u7F1D\u8FDE\u63A5\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u8FD9\u65B9\u9762\u7684\u63D0\u5347\u5C06\u6D89\u53CA\u5347\u7EA7\u3001\u91CD\u65B0\u8BBE\u8BA1\u3001\u91CD\u65B0\u5229\u7528\u548C\u91CD\u5EFA\u5DE5\u4F5C\uFF0C\u4EE5\u8BA9\u5B83\u66F4\u663E\u9AD8\u7AEF\u548C\u73B0\u4EE3\u5316\u3002\u201D\n\u9646\u5146\u798F\u8FD8\u6982\u8FF0\u4E86\u4ED6\u5BF9\u5409\u9686\u5761\u4E2D\u73AF\u8F66\u7AD9\u5730\u533A\u7684\u8BA1\u5212\uFF0C\u8BE6\u7EC6\u4ECB\u7ECD\u4E86\u4E00\u9879\u8FDE\u63A5\u6240\u6709\u5EFA\u7B51\u7269\u7684\u7EFC\u5408\u4E3E\u63AA\uFF0C\u4EE5\u6539\u5584\u516C\u5171\u4EA4\u901A\u548C\u901A\u884C\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF1A\u201C\u8FD9\u4E2A\u4E92\u8054\u7F51\u7EDC\u5C06\u4F7F\u8BE5\u5730\u533A\u4E0D\u540C\u5730\u70B9\u4E4B\u95F4\u80FD\u987A\u5229\u8FC7\u6E21\uFF0C\u6700\u7EC8\u4F7F\u516C\u4F17\u7684\u51FA\u884C\u66F4\u52A0\u65B9\u4FBF\u548C\u8F7B\u677E\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u4E0E\u9996\u76F8\u7F72\u4E0B\u5C5E\u516C\u79C1\u5408\u4F5C\u5355\u4F4D\uFF08Ukas\uFF09\u7684\u8BA8\u8BBA\u6B63\u5728\u8FDB\u884C\u4E2D\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003ERAC\u4E2D\u73AF\u5927\u53A60.18\u516C\u9877\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003ERAC\u4E2D\u73AF\u5927\u53A6\u5750\u843D\u5728\u5341\u4E94\u7891\u6566\u8F9B\u73ED\u4E39\u8DEF\uFF0C\u5360\u57300.18\u516C\u9877\uFF0C\u8017\u8D441\u4EBF2500\u4E07\u4EE4\u5409\u5174\u5EFA\u3002\u003C/p\u003E\n\u003Cp\u003E\n\u6839\u636E\u6587\u544A\uFF0C\u5B83\u6BCF\u5E74\u80FD\u901A\u8FC7\u51FA\u79DF\u529E\u516C\u5BA4\u3001\u5546\u4E1A\u548C\u9910\u996E\u7A7A\u95F4\uFF0C\u521B\u9020\u7EA6700\u4E07\u4EE4\u5409\u7684\u6536\u5165\u3002\u003C/p\u003E\n\u003Cp\u003E\u6587\u544A\u8BF4\uFF1A\u201C\u5728\u5EFA\u7B51\u8BBE\u8BA1\u548C\u5EFA\u9020\u65B9\u9762\uFF0C\u6B64\u5927\u53A6\u62E5\u6709\u73B0\u4EE3\u548C\u73AF\u4FDD\u7279\u70B9\uFF0C\u5E76\u83B7\u5F97\u7EFF\u8272\u5EFA\u7B51\u6307\u6570\uFF08GBI\uFF09\u7684\u8BA4\u8BC1\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\n\u003Cstrong\u003E\u9646\u5146\u798F\u5401\u5404\u9886\u57DF\u5408\u4F5C\n\u6539\u5584\u94C1\u8DEF\u670D\u52A1\u53CA\u57FA\u5EFA\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u9646\u5146\u798F\u547C\u5401\u516C\u5171\u548C\u79C1\u4EBA\u9886\u57DF\u63D0\u5347\u5408\u4F5C\uFF0C\u5C24\u5176\u9700\u8981\u643A\u624B\u53D1\u5C55\u548C\u6539\u9020\u56FD\u5BB6\u94C1\u8DEF\u670D\u52A1\u9886\u57DF\u7684\u57FA\u7840\u8BBE\u65BD\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u6B64\u4E3E\u8BC1\u660E\u594F\u6548\uFF0C\u5B83\u5728\u52A9\u529B\u63A8\u52A8\u56FD\u5BB6\u53D1\u5C55\u4E4B\u4F59\uFF0C\u4E5F\u60E0\u53CA\u4EBA\u6C11\u548C\u653F\u5E9C\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u4EE5RAC\u4E2D\u73AF\u5927\u53A6\u4E3A\u4F8B\u8BF4\uFF0C\u8FD9\u9879\u4E3E\u63AA\u6709\u52A9\u4E8E\u8282\u7701\u653F\u5E9C\u5F00\u652F\uFF0C\u5E76\u53EF\u5728\u66F4\u77ED\u7684\u65F6\u95F4\u5185\uFF0C\u5728\u94C1\u8DEF\u571F\u5730\u4E0A\u843D\u5B9E\u66F4\u597D\u7684\u53D1\u5C55\u548C\u8BBE\u65BD\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u7EE7\u7EED\u53D1\u5C55\u94C1\u8DEF\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u201C\u5BF9\u4E8E\u6211\u56FD\u7684\u94C1\u8DEF\u9886\u57DF\u6765\u8BF4\uFF0C\u8FD9\u4E5F\u662F\u4E00\u4E2A\u5386\u53F2\u6027\u65F6\u523B\uFF0C\u5C06\u80FD\u8BA9RAC\u66F4\u84EC\u52C3\u548C\u9AD8\u6548\u7684\u521B\u9020\u6C38\u7EED\u6536\u5165\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u901A\u8FC7\u8FD9\u6B21\u5408\u4F5C\uFF0C\u6211\u4EEC\u53EF\u4EE5\u5B9E\u73B0\u4E00\u4E2A\u68A6\u60F3\uFF0C\u4E5F\u5C31\u662F\u5C06\u6536\u5165\u91CD\u65B0\u7528\u4E8E\u5927\u9A6C\u94C1\u8DEF\u9886\u57DF\u7684\u53D1\u5C55\u3002\u201D\u003C/p\u003E\n\u003Cp\u003ERAC\u4E2D\u73AF\u5927\u53A6\u662FRAC\u4E0E\u6768\u5FE0\u793C\u673A\u6784\uFF08YTL\uFF0C4677\uFF0C\u4E3B\u677F\u516C\u7528\u4E8B\u4E1A\u80A1\uFF09\u72EC\u8D44\u5B50\u516C\u53F8Arah Asas\u79C1\u4EBA\u6709\u9650\u516C\u53F8\u7684\u8054\u8425\u9879\u76EE\u3002\u003C/p\u003E\n\u003Cp\u003E\u9646\u5146\u798F\u5E0C\u671B\u8FD9\u5EA7\u5927\u53A6\u53EF\u6FC0\u53D1RAC\u540C\u4EC1\u7684\u58EB\u6C14\uFF0C\u4EE5\u7EE7\u7EED\u4E3A\u56FD\u5BB6\u94C1\u8DEF\u5DE5\u4E1A\u53D1\u5C55\uFF0C\u52AA\u529B\u594B\u6597\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u5E94\u6839\u636ERAC\u4F5C\u4E3A\u94C1\u8DEF\u8D44\u4EA7\u7BA1\u7406\u8005\u548C\u6240\u6709\u8005\u7684\u529F\u80FD\uFF0C\u52A0\u5F3A\u8FD9\u7C7B\u7684\u8054\u8425\u9879\u76EE\u3002RAC\u9700\u66F4\u8FDB\u4E00\u6B65\uFF0C\u8D85\u8D8A\u5176\u65E5\u5E38\u4E1A\u52A1\u6D3B\u52A8\uFF0C\u5982\u51FA\u79DF\u548C\u79DF\u8D41\u73B0\u6709\u7684\u94C1\u8DEF\u571F\u5730\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u51FA\u5E2D\u8005\u5305\u62EC\u4EA4\u901A\u90E8\u79D8\u4E66\u957F\u517C\u5927\u9A6C\u94C1\u9053\u8D44\u4EA7\u673A\u6784\u4E3B\u5E2D\u62FF\u7763\u52A0\u7EB3\u5C71\u8482\u5170\u3001\u603B\u6267\u884C\u957F\u62FF\u7763\u963F\u5179\u54C8\u3001\u79C1\u4EBA\u754C\u53CA\u653F\u5E9C\u5408\u4F5C\u673A\u6784\u526F\u603B\u76D1\u62C9\u67E5\u91CC\uFF0C\u4EE5\u53CA\u5927\u697C\u53D1\u5C55\u5546Arah Asas\u6267\u884C\u8463\u4E8B\u62FF\u7763\u54C8\u7C73\u8FBE\u7B49\u3002\n\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/lNOx9aoXaIPgFPrmUO8eoA\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
