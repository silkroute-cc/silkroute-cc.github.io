  "route": "/4924/",
  "title": "\u9996\u76F8\u5DF2\u63A5\u83B7\u843D\u5B9E\u65B9\u6848\u3000\u9686\u65B0\u9AD8\u94C1\u91CD\u542F\u8BA1\u5212\u6709\u671B\uFF01",
  "summary": "\uFF08\u7EBD\u7EA6\u3001\u5409\u9686\u576111\u65E5\u8BAF\uFF09\u6469\u6839\u5927\u901A\u8868\u793A\uFF0C\u4EA4\u901A\u90E8\u5DF2\u5411\u9996\u76F8\u62FF\u7763\u65AF\u91CC\u5B89\u534E\u63D0\u4EA4\u6709\u5173\u9686\u65B0\u9AD8\u94C1\u91CD\u542F\u8BA1\u5212\u7684\u5EFA\u8BAE\uFF0C\u9884\u8BA1\u5728\u672A\u6765\u6570\u6708\u63D0\u4EA4\u4E88\u5185\u9601\u6279\u51C6\u3002 \u5728\u9996\u5C4A\u6469\u6839\u5927\u901A\u9A6C\u6765\u897F\u4E9A\u002B\u8BBA\u575B\u4E2D\uFF0C\u4EA4\u901A\u90E8\u957F\u9646\u5146\u798F\u5F3A\u8C03\uFF0C\u9686\u65B0\u9AD8\u94C1\u9879\u76EE\u7684\u63D0\u6848\u5DF2\u63D0\u4EA4\u7ED9\u5B89\u534E\uFF0C\u8BE5\u8BA1\u5212\u5C06\u5728\u672A\u6765\u6570\u6708\u5185\u63D0\u4EA4\u5185\u9601\u6279\u51C6\u3002 \u4ECA\u5E745\u6708\uFF0C\u9646\u5146\u798F\u8868\u793A\uFF0C\u53EA\u6709\u5728\u83B7\u5F97\u5185\u9601\u6279\u51C6\u540E\uFF0C\u624D\u4F1A\u5F00\u59CB\u4E0E\u65B0\u52A0\u5761\u5C31\u9686\u65B0\u9AD8\u94C1\u9879\u76EE\u8FDB\u884C\u8BA8\u8BBA\u3002 \u6469\u6839\u5927\u901A\u5728\u62A5\u544A\u4E2D\u8868\u793A\uFF0C\u9686\u65B0\u9AD8\u94C1\u9879\u76EE\u9884\u8BA1\u5C06\u7531\u79C1\u4EBA\u90E8\u95E8\u6240\u4E3B\u5BFC\uFF0C\u5927\u9A6C\u7684\u8D22\u56E2\u9884\u8BA1\u4F1A\u83B7\u5F97\u5728\u5927\u9A6C\u7684\u5206\u5305\u5DE5\u7A0B\u3002 \u300A\u65B0\u6D77\u5CE1\u65F6\u62A5\u300B\u4E8E\u4ECA\u5E744\u670819\u65E5\u2026",
  "body": "\u003Cp\u003E\uFF08\u7EBD\u7EA6\u3001\u5409\u9686\u576111\u65E5\u8BAF\uFF09\u6469\u6839\u5927\u901A\u8868\u793A\uFF0C\u4EA4\u901A\u90E8\u5DF2\u5411\u9996\u76F8\u62FF\u7763\u65AF\u91CC\u5B89\u534E\u63D0\u4EA4\u6709\u5173\u9686\u65B0\u9AD8\u94C1\u91CD\u542F\u8BA1\u5212\u7684\u5EFA\u8BAE\uFF0C\u9884\u8BA1\u5728\u672A\u6765\u6570\u6708\u63D0\u4EA4\u4E88\u5185\u9601\u6279\u51C6\u3002\u003C/p\u003E\n\u003Cp\u003E\u5728\u9996\u5C4A\u6469\u6839\u5927\u901A\u9A6C\u6765\u897F\u4E9A\u002B\u8BBA\u575B\u4E2D\uFF0C\u4EA4\u901A\u90E8\u957F\u9646\u5146\u798F\u5F3A\u8C03\uFF0C\u9686\u65B0\u9AD8\u94C1\u9879\u76EE\u7684\u63D0\u6848\u5DF2\u63D0\u4EA4\u7ED9\u5B89\u534E\uFF0C\u8BE5\u8BA1\u5212\u5C06\u5728\u672A\u6765\u6570\u6708\u5185\u63D0\u4EA4\u5185\u9601\u6279\u51C6\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ECA\u5E745\u6708\uFF0C\u9646\u5146\u798F\u8868\u793A\uFF0C\u53EA\u6709\u5728\u83B7\u5F97\u5185\u9601\u6279\u51C6\u540E\uFF0C\u624D\u4F1A\u5F00\u59CB\u4E0E\u65B0\u52A0\u5761\u5C31\u9686\u65B0\u9AD8\u94C1\u9879\u76EE\u8FDB\u884C\u8BA8\u8BBA\u3002\u003C/p\u003E\n\u003Cp\u003E\u6469\u6839\u5927\u901A\u5728\u62A5\u544A\u4E2D\u8868\u793A\uFF0C\u9686\u65B0\u9AD8\u94C1\u9879\u76EE\u9884\u8BA1\u5C06\u7531\u79C1\u4EBA\u90E8\u95E8\u6240\u4E3B\u5BFC\uFF0C\u5927\u9A6C\u7684\u8D22\u56E2\u9884\u8BA1\u4F1A\u83B7\u5F97\u5728\u5927\u9A6C\u7684\u5206\u5305\u5DE5\u7A0B\u3002\u003C/p\u003E\n\u003Cp\u003E\u300A\u65B0\u6D77\u5CE1\u65F6\u62A5\u300B\u4E8E\u4ECA\u5E744\u670819\u65E5\u5F15\u8FF0\u6D88\u606F\u4EBA\u58EB\u6307\u51FA\uFF0C\u9686\u65B0\u9AD8\u94C1\uFF08HSR\uFF09\u7684\u5EFA\u7B51\u6210\u672C\uFF0C\u5C06\u4ECE\u539F\u672C\u76841100\u4EBF\u4EE4\u5409\u5927\u780D\u81F3700\u4EBF\u4EE4\u5409\uFF0C\u76F8\u7B49\u4E8E36%\u964D\u5E45\u3002\u003C/p\u003E\n\u003Cp\u003E\u9686\u65B0\u9AD8\u94C1\u9879\u76EE\u5728\u5927\u9A6C\u9884\u8BA1\u67097\u4E2A\u8F66\u7AD9\uFF0C\u5305\u62EC\u5927\u9A6C\u57CE\u3001\u96EA\u90A6\u81F3\u5E03\u57CE\u3001\u8299\u84C9\u3001\u9A6C\u516D\u7532\u3001\u9EBB\u5761\u3001\u5CC7\u682A\u5DF4\u8F96\u548C\u4F9D\u65AF\u5E72\u8FBE\u516C\u4E3B\u57CE\uFF0C\u6700\u540E\u4E00\u4E2A\u7AD9\u70B9\u5219\u662F\u65B0\u52A0\u5761\u88D5\u5ECA\u4E1C\u3002\u003C/p\u003E\n\u003Cp\u003E\u9686\u65B0\u9AD8\u94C1\u9879\u76EE\u56E02018\u5E74\u6362\u653F\u5E9C\u800C\u957F\u671F\u505C\u5DE5\uFF0C\u5E76\u4E8E2021\u5E743\u6708\u88AB\u53D6\u6D88\uFF0C\u968F\u540E\u4E8E2023\u5E74\u5BA3\u5E03\u91CD\u542F\u3002\u003C/p\u003E\n\u003Cp\u003E\u5728\u6B64\u671F\u95F4\uFF0C\u5927\u9A6C\u4E00\u5171\u5411\u65B0\u52A0\u5761\u652F\u4ED8\u4E861\u4EBF\u96F628\u4E07\u65B0\u5143\uFF083\u4EBF2027\u4E07\u4EE4\u5409\uFF09\uFF0C\u4EE5\u652F\u4ED8\u8BE5\u9879\u76EE\u7EC8\u6B62\u540E\u4EA7\u751F\u7684\u76F8\u5173\u8D39\u7528\u3002\u003C/p\u003E\n\u003Cp\u003E\u5927\u9A6C\u9AD8\u94C1\u673A\u6784\uFF08MyHSR\uFF09\u8D1F\u8D23\u76D1\u7763\u8BE5\u9879\u76EE\u7684\u53D1\u5C55\u3002\u5927\u9A6C\u9AD8\u94C1\u673A\u6784\u53BB\u5E747\u6708\u53D1\u8D77\u8D44\u8BAF\u8BF7\u6C42\uFF08RFI \uFF09\uFF0C\u6700\u7EC8\u67097\u5BB6\u672C\u5730\u548C\u56FD\u9645\u516C\u53F8\u7EC4\u6210\u7684\u8D22\u56E2\uFF0C\u5411\u9AD8\u94C1\u673A\u6784\u5728\u4ECA\u5E741\u670815\u65E5\u63D0\u4EA4\u4E86\u9686\u65B0\u9AD8\u94C1\u7684\u6982\u5FF5\u4F01\u5212\u4E66\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/5UOLJ2w5qHzde1xZO8gAtw\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
