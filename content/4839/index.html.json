{
  "id": "%e9%99%86%e5%85%86%e7%a6%8f%e8%ae%bf%e5%8d%8e%e6%88%90%e6%9e%9c%e4%b8%b0%e7%a1%95%e3%80%80%e9%a9%ac%e4%b8%ad%e5%90%88%e4%bd%9c%e6%9b%b4%e4%b8%8a%e4%b8%80%e5%b1%82%e6%a5%bc",
  "slug": "%e9%99%86%e5%85%86%e7%a6%8f%e8%ae%bf%e5%8d%8e%e6%88%90%e6%9e%9c%e4%b8%b0%e7%a1%95%e3%80%80%e9%a9%ac%e4%b8%ad%e5%90%88%e4%bd%9c%e6%9b%b4%e4%b8%8a%e4%b8%80%e5%b1%82%e6%a5%bc",
  "canonicalUrlKey": "%e9%99%86%e5%85%86%e7%a6%8f%e8%ae%bf%e5%8d%8e%e6%88%90%e6%9e%9c%e4%b8%b0%e7%a1%95%e3%80%80%e9%a9%ac%e4%b8%ad%e5%90%88%e4%bd%9c%e6%9b%b4%e4%b8%8a%e4%b8%80%e5%b1%82%e6%a5%bc",
  "route": "/4839/",
  "title": "\u9646\u5146\u798F\u8BBF\u534E\u6210\u679C\u4E30\u7855\u3000\u9A6C\u4E2D\u5408\u4F5C\u66F4\u4E0A\u4E00\u5C42\u697C",
  "summary": "\u9646\u5146\u798F\uFF08\u53F36\uFF09\u4E0E\u4E2D\u56FD\u6CB3\u5357\u7701\u56FD\u4F01\u4E2D\u8C6B\u822A\u7A7A\u96C6\u56E2\u53CA\u5927\u9A6C\u673A\u573A\u63A7\u80A1\u516C\u53F8\u9886\u5BFC\uFF0C\u4E00\u540C\u63A5\u9886\u4ECE\u5409\u9686\u5761\u9996\u822A\u81F3\u90D1\u5DDE\u7684\u9A6C\u6765\u897F\u4E9A\u83E0\u841D\u871C\uFF0C\u6269\u5927\u9A6C\u6765\u897F\u4E9A\u519C\u4EA7\u54C1\u51FA\u53E3\u3002 \uFF08\u5409\u9686\u576110\u65E5\u8BAF\uFF09\u4EA4\u901A\u90E8\u957F\u9646\u5146\u798F\u4ECE\u4ECA\u5E746\u67086\u65E5\u81F36\u67089\u65E5\u4E00\u8FDE4\u5929\u8BBF\u534E\u884C\u7A0B\u5706\u6EE1\u7ED3\u675F\uFF0C\u4E8E\u4ECA\u65E5\u7AEF\u5348\u8282\u51CC\u6668\u4ECE\u6CB3\u5357\u90D1\u5DDE\u8FD4\u56DE\u5409\u9686\u5761\u3002 \u9646\u5146\u798F\u6240\u7387\u9886\u7684\u4EE3\u8868\u56E2\u884C\u7A0B\u7D27\u51D1\uFF0C\u9A6C\u4E0D\u505C\u8E44\u5730\u4ECE\u9999\u6E2F\u5230\u6E56\u5357\u957F\u6C99\uFF0C\u518D\u5317\u4E0A\u6CB3\u5357\u5230\u90D1\u5DDE\uFF0C\u62DC\u4F1A\u65E7\u96E8\u65B0\u77E5\uFF0C\u8D81\u9A6C\u4E2D\u5EFA\u4EA450\u5E74\u91D1\u79A7\uFF0C\u63A8\u52A8\u6DF1\u5316\u4E24\u56FD\u5728\u5404\u4EA4\u901A\u9886\u57DF\u7684\u5408\u4F5C\u3002 \u62DC\u4F1A\u6E58\u8C6B\u4E8C\u7701\u957F \u9646\u5146\u798F\u4E8E\u672C\u67087\u65E5\u548C8\u65E5\uFF0C\u5206\u522B\u62DC\u4F1A\u6E56\u5357\u7701\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/06/frc-cbe5fa190324031981db84af1e8d3ec1.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u9646\u5146\u798F\uFF08\u53F36\uFF09\u4E0E\u4E2D\u56FD\u6CB3\u5357\u7701\u56FD\u4F01\u4E2D\u8C6B\u822A\u7A7A\u96C6\u56E2\u53CA\u5927\u9A6C\u673A\u573A\u63A7\u80A1\u516C\u53F8\u9886\u5BFC\uFF0C\u4E00\u540C\u63A5\u9886\u4ECE\u5409\u9686\u5761\u9996\u822A\u81F3\u90D1\u5DDE\u7684\u9A6C\u6765\u897F\u4E9A\u83E0\u841D\u871C\uFF0C\u6269\u5927\u9A6C\u6765\u897F\u4E9A\u519C\u4EA7\u54C1\u51FA\u53E3\u3002\u003C/p\u003E\n\u003Cp\u003E\uFF08\u5409\u9686\u576110\u65E5\u8BAF\uFF09\u4EA4\u901A\u90E8\u957F\u9646\u5146\u798F\u4ECE\u4ECA\u5E746\u67086\u65E5\u81F36\u67089\u65E5\u4E00\u8FDE4\u5929\u8BBF\u534E\u884C\u7A0B\u5706\u6EE1\u7ED3\u675F\uFF0C\u4E8E\u4ECA\u65E5\u7AEF\u5348\u8282\u51CC\u6668\u4ECE\u6CB3\u5357\u90D1\u5DDE\u8FD4\u56DE\u5409\u9686\u5761\u3002\u003C/p\u003E\n\u003Cp\u003E\u9646\u5146\u798F\u6240\u7387\u9886\u7684\u4EE3\u8868\u56E2\u884C\u7A0B\u7D27\u51D1\uFF0C\u9A6C\u4E0D\u505C\u8E44\u5730\u4ECE\u9999\u6E2F\u5230\u6E56\u5357\u957F\u6C99\uFF0C\u518D\u5317\u4E0A\u6CB3\u5357\u5230\u90D1\u5DDE\uFF0C\u62DC\u4F1A\u65E7\u96E8\u65B0\u77E5\uFF0C\u8D81\u9A6C\u4E2D\u5EFA\u4EA450\u5E74\u91D1\u79A7\uFF0C\u63A8\u52A8\u6DF1\u5316\u4E24\u56FD\u5728\u5404\u4EA4\u901A\u9886\u57DF\u7684\u5408\u4F5C\u3002\u003C/p\u003E\n\u003Cp\u003E\u62DC\u4F1A\u6E58\u8C6B\u4E8C\u7701\u957F\u003C/p\u003E\n\u003Cp\u003E\u9646\u5146\u798F\u4E8E\u672C\u67087\u65E5\u548C8\u65E5\uFF0C\u5206\u522B\u62DC\u4F1A\u6E56\u5357\u7701\u957F\u6BDB\u4F1F\u660E\uFF0C\u4EE5\u53CA\u6CB3\u5357\u7701\u957F\u738B\u51EF\u3002\u4E24\u4F4D\u7701\u957F\u4E3A\u9A6C\u4E2D\u5EFA\u4EA450\u5468\u5E74\u8868\u8FBE\u795D\u8D3A\uFF0C\u4E5F\u540C\u65F6\u63D0\u70B9\u4E24\u7701\u4E0E\u9A6C\u6765\u897F\u4E9A\u672A\u6765\u7684\u57FA\u672C\u5408\u4F5C\u65B9\u5411\u3002\u003C/p\u003E\n\u003Cp\u003E\u53E6\u4E00\u65B9\u9762\uFF0C\u4ECE\u6E56\u5357\u7684\u81EA\u7136\u5947\u666F\u5F20\u5BB6\u754C\uFF0C\u5230\u6CB3\u5357\u7684\u5343\u5E74\u53E4\u90FD\u6D1B\u9633\u548C\u5D69\u5C71\u5C11\u6797\u5BFA\uFF0C\u90FD\u662F\u9A6C\u6765\u897F\u4E9A\u4EBA\u5FC3\u4E4B\u5411\u5F80\u7684\u65C5\u6E38\u666F\u70B9\u3002\u003C/p\u003E\n\u003Cp\u003E\u5BF9\u6B64\uFF0C\u5409\u9686\u5761\u2014\u2014\u957F\u6C99\u548C\u5409\u9686\u5761\u2014\u2014\u90D1\u5DDE\u5DF2\u7ECF\u6709\u76F4\u98DE\u822A\u73ED\uFF0C\u4E14\u5C06\u5728\u4E0B\u4E2A\u6708\u5F00\u59CB\u589E\u52A0\u9891\u7387\uFF0C\u5728\u5728\u4FC3\u8FDB\u4E24\u56FD\u7684\u65C5\u6E38\u4E1A\u548C\u7ECF\u8D38\u5F80\u6765\uFF0C\u4EE5\u53CA\u8DE8\u56FD\u7684\u4EBA\u6587\u548C\u4EA7\u4E1A\u4EA4\u6D41\u3002\u003C/p\u003E\n\u003Cp\u003E\u968F\u8457\u514D\u7B7E\u8BC1\u53CA\u591A\u9879\u4FBF\u5229\u63AA\u65BD\uFF0C\u4E2D\u56FD\u6E38\u5BA2\u6765\u9A6C\u4E5F\u540C\u6837\u663E\u8457\u4E0A\u5347\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/06/frc-3c1087492fa3229fb48d81317fdf9bc5.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u9646\u5146\u798F\uFF08\u5DE6\uFF09\u8D60\u9001\u7EAA\u5FF5\u54C1\u4E88\u4E2D\u56FD\u6E56\u5357\u7701\u957F\u6BDB\u4F1F\u660E\u3002\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u4E2D\u7ED3\u91D1\u559C \u94C1\u8DEF\u4F20\u60C5\u8C0A \u003C/p\u003E\n\u003Cp\u003E\u5728\u94C1\u8DEF\u65B9\u9762\uFF0C\u9646\u5146\u798F\u4E8E\u9996\u5EA6\u8BBF\u95EE\u6709\u201C\u73B0\u4EE3\u7535\u529B\u673A\u8F66\u6447\u7BEE\u201D\u4E4B\u79F0\u7684\u6E56\u5357\u7701\u682A\u6D32\u5E02\uFF0C\u62DC\u8BBF\u4E2D\u8F66\u682A\u6D32\u7535\u529B\u673A\u8F66\u516C\u53F8\uFF08\u682A\u673A\uFF09\u7684\u603B\u90E8\u548C\u751F\u4EA7\u57FA\u5730\u3002\u003C/p\u003E\n\u003Cp\u003E\u682A\u673A\u6765\u9A6C\u6295\u8D44\u751F\u4EA7\u57FA\u5730\u5DF2\u8FD110\u5E74\uFF0C\u6240\u7EC4\u88C5\u7684\u7535\u529B\u673A\u8F66\u548C\u52A8\u8F66\u7EC4\u4FF1\u4EE5\u6210\u4E3A\u5DF4\u751F\u8C37\u90FD\u4F1A\u533A\u53CA\u9A6C\u6765\u4E9A\u94C1\u9053\uFF08KTMB\uFF09\u57CE\u9645\u8F68\u9053\u4EA4\u901A\u7CFB\u7EDF\u8F66\u961F\u7684\u4E00\u5927\u90E8\u5206\u3002\u003C/p\u003E\n\u003Cp\u003E\u5C55\u671B\u672A\u6765\uFF0C\u9646\u5146\u798F\u548C\u4E2D\u8F66\u682A\u673A\u8463\u4E8B\u957F\u5085\u6210\u9A8F\u9488\u5BF9\u9739\u96F3\u534E\u90FD\u7259\u4E5F\uFF08Batu Gajah\uFF09\u4E2D\u8F66\u751F\u4EA7\u57FA\u5730\u6240\u9762\u5BF9\u7684\u6311\u6218\u505A\u51FA\u5766\u8BDA\u7684\u4EA4\u6D41\u548C\u6DF1\u5165\u8BA8\u8BBA\uFF0C\u4E3A\u4E0B\u4E00\u9636\u6BB5\u7684\u53D1\u5C55\u94FA\u8DEF\u3002\u53CC\u65B9\u5C06\u7D27\u5BC6\u5408\u4F5C\uFF0C\u542F\u52A8\u653F\u5E9C\u5BF9\u653F\u5E9C\u7684\u76F8\u5E94\u673A\u5236\uFF0C\u52A0\u901F\u6253\u9020\u534E\u90FD\u7259\u4E5F\u57FA\u5730\uFF0C\u6210\u4E3A\u4E1C\u76DF\u533A\u57DF\u7535\u529B\u673A\u8F66\u7684\u751F\u4EA7\u3001\u7EF4\u4FDD\u3001\u6280\u672F\u4E13\u624D\u57F9\u8BAD\u4E2D\u5FC3\u3002\u003C/p\u003E\n\u003Cp\u003E6\u67087\u65E5\u665A\u4E0A\uFF0C\u9646\u5146\u798F\u548C\u4E2D\u8F66\u96C6\u56E2\u603B\u88C1\u9A6C\u4E91\u53CC\u4E3AET3\u5217\u8F66\u4E3B\u6301\u4E86\u4E0B\u7EBF\u4EEA\u5F0F\uFF0C\u9686\u91CD\u7684\u573A\u9762\u632F\u594B\u4EBA\u5FC3\uFF0C\u4E5F\u4E3A\u9A6C\u4E2D\u4E24\u56FD\u5E86\u795D\u5EFA\u4EA450\u5E74\u5E26\u6765\u975E\u51E1\u7684\u610F\u4E49\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/06/frc-fb9ca4765313f1055a4cb31d5a422625.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u9646\u5146\u798F(\u5DE6)\u8D60\u9001\u7EAA\u5FF5\u54C1\u4E88\u4E2D\u56FD\u6CB3\u5357\u7701\u957F\u738B\u51EF\u3002\u003C/p\u003E\n\u003Cp\u003E\u6253\u5F00\u7A7A\u4E2D\u4E1D\u7EF8\u4E4B\u8DEF \u5E26\u52A8\u822A\u7A7A\u7269\u6D41\u003C/p\u003E\n\u003Cp\u003E\u5728\u822A\u7A7A\u65B9\u9762\uFF0C\u9646\u5146\u798F\u8054\u540C\u9A6C\u6765\u897F\u4E9A\u673A\u573A\u516C\u53F8\uFF08\u2018\u9A6C\u673A\u573A\u2019\uFF09\u4EE3\u8868\u4E00\u884C\u4EBA\u524D\u5F80\u6CB3\u5357\u65B0\u90D1\u56FD\u9645\u673A\u573A\u7684\u822A\u7A7A\u6E2F\u533A\uFF0C\u5305\u62EC\u822A\u7AD9\u5927\u697C\u3001\u5730\u9762\u4EA4\u901A\u4E2D\u5FC3\u8FD8\u6709\u5D2D\u65B0\u73B0\u4EE3\u5316\u7684\u5317\u8D27\u7AD9\u8FDB\u884C\u8C03\u7814\u3002\u003C/p\u003E\n\u003Cp\u003E\u540C\u65F6\uFF0C\u9A6C\u673A\u573A\u4E0E\u6CB3\u5357\u7701\u56FD\u6709\u4F01\u4E1A\u4E2D\u8C6B\u822A\u7A7A\u96C6\u56E2\u7B7E\u7F72\u8C05\u89E3\u5907\u5FD8\u5F55\uFF0C\u4E00\u540C\u5F00\u62D3\u5409\u9686\u5761\u56FD\u9645\u673A\u573A\u548C\u65B0\u90D1\u56FD\u9645\u673A\u573A\u4E24\u56FD\u53CC\u56ED\u53CC\u67A2\u7EBD\u7684\u5408\u4F5C\u6A21\u5F0F\uFF0C\u8BA9\u822A\u7A7A\u7269\u6D41\u6210\u4E3A\u5E26\u52A8\u4E24\u56FD\u7ECF\u8D38\u7684\u5F15\u64CE\u3002\u003C/p\u003E\n\u003Cp\u003E\u5409\u9686\u5761\u5728\u4E1C\u76DF\u5360\u6709\u4E2D\u5FC3\u7684\u5730\u7406\u4F4D\u7F6E\uFF0C\u6709\u4E0D\u5C11\u822A\u7A7A\u9886\u57DF\u7684\u4E13\u624D\uFF1B\u90D1\u5DDE\u4F4D\u5904\u4E2D\u56FD\u5927\u9646\u7684\u4E2D\u5FC3\uFF0C\u4EA4\u901A\u7F51\u7EDC\u56DB\u901A\u516B\u8FBE\uFF0C\u7A7A\u8FD0\u7B49\u57FA\u7840\u8BBE\u65BD\u5341\u5206\u5065\u5168\u3002\u4E24\u8005\u8054\u5408\uFF0C\u5EFA\u6784\u4E32\u8054\u4E2D\u3001\u897F\u3001\u4E1C\u5357\u4E9A\u7684\u7A7A\u4E2D\u4E1D\u7EF8\u4E4B\u8DEF\u3002\u003C/p\u003E\n\u003Cp\u003E\u8FD9\u6B21\u8BBF\u534E\u6536\u83B7\u4E30\u5BCC\u3001\u7855\u679C\u7D2F\u7D2F\u3002\u9664\u4E86\u5168\u9762\u52A0\u5F3A\u4EA4\u901A\u9886\u57DF\u7684\u5408\u4F5C\uFF0C\u4E5F\u5960\u5B9A\u672A\u6765\u7684\u4E3B\u8981\u5177\u4F53\u7684\u5408\u4F5C\u65B9\u3002\u9A6C\u4E2D\u4E24\u5730\u4F01\u4E1A\u548C\u6C11\u95F4\u7684\u5F80\u6765\u4E0D\u65AD\uFF0C\u4E92\u8054\u4E92\u901A\uFF0C\u9A6C\u4E2D\u5173\u7CFB\u8FC8\u5165\u4E0B\u4E00\u4E2A\u66F4\u8F89\u714C\u768450\u5E74\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/hcbMsDzMF5ie29PgGNVvYg\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
