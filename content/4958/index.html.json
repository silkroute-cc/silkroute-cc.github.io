{
  "id": "%e4%b8%ad%e5%9b%bd%e6%9c%80%e5%a4%a7%e5%9b%ba%e4%bd%93%e5%ba%9f%e6%96%99%e7%84%9a%e5%8c%96%e5%85%ac%e5%8f%b8%e7%ad%be%e7%bd%b2%e4%b8%80%e9%a1%b9%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e8%81%94%e5%90%88",
  "slug": "%e4%b8%ad%e5%9b%bd%e6%9c%80%e5%a4%a7%e5%9b%ba%e4%bd%93%e5%ba%9f%e6%96%99%e7%84%9a%e5%8c%96%e5%85%ac%e5%8f%b8%e7%ad%be%e7%bd%b2%e4%b8%80%e9%a1%b9%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e8%81%94%e5%90%88",
  "canonicalUrlKey": "%e4%b8%ad%e5%9b%bd%e6%9c%80%e5%a4%a7%e5%9b%ba%e4%bd%93%e5%ba%9f%e6%96%99%e7%84%9a%e5%8c%96%e5%85%ac%e5%8f%b8%e7%ad%be%e7%bd%b2%e4%b8%80%e9%a1%b9%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e8%81%94%e5%90%88",
  "route": "/4958/",
  "title": "\u4E2D\u56FD\u6700\u5927\u56FA\u4F53\u5E9F\u6599\u711A\u5316\u516C\u53F8\u7B7E\u7F72\u4E00\u9879\u9A6C\u6765\u897F\u4E9A\u8054\u5408\u5F00\u53D1\u6846\u67B6\u534F\u8BAE",
  "summary": "\uFF08\u5409\u9686\u576115\u65E5\u8BAF\uFF09\u5FD7\u8FBE\u73AF\u7403\uFF08CITAGLB\uFF0C7245\uFF0C\u4E3B\u677F\u5DE5\u4E1A\u80A1\uFF09\u5BA3\u5E03\uFF0C\u4E0ESUS\u63A7\u80A1\u7B7E\u7F72\u4E86\u4E00\u9879\u8054\u5408\u5F00\u53D1\u6846\u67B6\u534F\u8BAE\uFF08JDFA\uFF09\u3002 \u5FD7\u8FBE\u73AF\u7403\u901A\u8FC7\u6587\u544A\u6307\u51FA\uFF0CSUS\u63A7\u80A1\u4E3A\u4E2D\u56FD\u653F\u5E9C\u5B98\u8054\u4F01\u4E1A\uFF0C\u662F\u4E2D\u56FD\u6700\u5927\u7684\u56FA\u4F53\u5E9F\u6599\u711A\u5316\u4F9B\u5E94\u5546\u3001\u7EFC\u5408\u73AF\u5883\u89E3\u51B3\u65B9\u6848\u9886\u822A\u5F00\u53D1\u5546--\u4E0A\u6D77\u5EB7\u6052\u73AF\u5883\u516C\u53F8\u7684\u5B50\u516C\u53F8\u3002 SUS\u63A7\u80A1\u5728\u57CE\u5E02\u56FA\u4F53\u5E9F\u5F03\u7269\u5904\u7406\u3001\u751F\u6001\u5DE5\u4E1A\u56ED\u5EFA\u8BBE\u3001WtE\u5DE5\u7A0B\u3001\u91C7\u8D2D\u3001\u5EFA\u8BBE\u3001\u8FD0\u8425\u548C\u7EF4\u62A4\u3001\u519C\u6797\u5E9F\u5F03\u7269\u5904\u7406\u7B49\u9886\u57DF\u62E5\u6709\u4E30\u5BCC\u7684\u7ECF\u9A8C\uFF0C\u5DF2\u8FDE\u7EED\u591A\u5E74\u5165\u9009\u4E2D\u56FD\u56FA\u5E9F\u884C\u4E1A\u201C\u5341\u5927\u6700\u5177\u5F71\u54CD\u529B\u4F01\u4E1A\u201D\u3002 \u8BE5\u534F\u8BAE\u65E8\u5728\u4FC3\u8FDB\u5F6D\u4EA8\u5DDE\u7684\u5783\u573E\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/07/frc-0bce6d6c3b30f6e7aab7e5c9ec6326c0.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\uFF08\u5409\u9686\u576115\u65E5\u8BAF\uFF09\u5FD7\u8FBE\u73AF\u7403\uFF08CITAGLB\uFF0C7245\uFF0C\u4E3B\u677F\u5DE5\u4E1A\u80A1\uFF09\u5BA3\u5E03\uFF0C\u4E0ESUS\u63A7\u80A1\u7B7E\u7F72\u4E86\u4E00\u9879\u8054\u5408\u5F00\u53D1\u6846\u67B6\u534F\u8BAE\uFF08JDFA\uFF09\u3002\u003C/p\u003E\n\u003Cp\u003E\u5FD7\u8FBE\u73AF\u7403\u901A\u8FC7\u6587\u544A\u6307\u51FA\uFF0CSUS\u63A7\u80A1\u4E3A\u4E2D\u56FD\u653F\u5E9C\u5B98\u8054\u4F01\u4E1A\uFF0C\u662F\u4E2D\u56FD\u6700\u5927\u7684\u56FA\u4F53\u5E9F\u6599\u711A\u5316\u4F9B\u5E94\u5546\u3001\u7EFC\u5408\u73AF\u5883\u89E3\u51B3\u65B9\u6848\u9886\u822A\u5F00\u53D1\u5546--\u4E0A\u6D77\u5EB7\u6052\u73AF\u5883\u516C\u53F8\u7684\u5B50\u516C\u53F8\u3002\u003C/p\u003E\n\u003Cp\u003ESUS\u63A7\u80A1\u5728\u57CE\u5E02\u56FA\u4F53\u5E9F\u5F03\u7269\u5904\u7406\u3001\u751F\u6001\u5DE5\u4E1A\u56ED\u5EFA\u8BBE\u3001WtE\u5DE5\u7A0B\u3001\u91C7\u8D2D\u3001\u5EFA\u8BBE\u3001\u8FD0\u8425\u548C\u7EF4\u62A4\u3001\u519C\u6797\u5E9F\u5F03\u7269\u5904\u7406\u7B49\u9886\u57DF\u62E5\u6709\u4E30\u5BCC\u7684\u7ECF\u9A8C\uFF0C\u5DF2\u8FDE\u7EED\u591A\u5E74\u5165\u9009\u4E2D\u56FD\u56FA\u5E9F\u884C\u4E1A\u201C\u5341\u5927\u6700\u5177\u5F71\u54CD\u529B\u4F01\u4E1A\u201D\u3002\u003C/p\u003E\n\u003Cp\u003E\u8BE5\u534F\u8BAE\u65E8\u5728\u4FC3\u8FDB\u5F6D\u4EA8\u5DDE\u7684\u5783\u573E\u8F6C\u4E3A\u80FD\u6E90\uFF08WtE\uFF09\u9879\u76EE\uFF0C\u5C06\u57CE\u5E02\u5783\u573E\u8F6C\u5316\u4E3A\u7EFF\u8272\u80FD\u6E90\uFF0C\u5E76\u5728\u5927\u9A6C\u5F00\u53D1\u519C\u4E1A\u5E9F\u5F03\u7269\uFF0C\u4F8B\u5982\u7A7A\u679C\u4E32\uFF08EFB\uFF09\u548C\u68D5\u6CB9\u6C61\u6CE5\uFF0C\u8F6C\u5316\u4E3A\u751F\u7269\u8D28\u80FD\u6E90\u3002\u003C/p\u003E\n\u003Cp\u003E\u5FD7\u8FBE\u73AF\u7403\u6301SPV 49%\u80A1\u6743\u003C/p\u003E\n\u003Cp\u003E\u8FD9\u8FDB\u4E00\u6B65\u5DE9\u56FA\u4E862\u5BB6\u516C\u53F8\u81F4\u529B\u4E8E\u4E3A\u9A6C\u6765\u897F\u4E9A\u5E9F\u7269\u7BA1\u7406\u548C\u80FD\u6E90\u9700\u6C42\uFF0C\u63D0\u4F9B\u53EF\u6301\u7EED\u89E3\u51B3\u65B9\u6848\u7684\u627F\u8BFA\u3002\u003C/p\u003E\n\u003Cp\u003E\u6587\u544A\u7EED\u6307\uFF0C\u7B7E\u7F72\u534F\u8BAE\u6807\u5FD7\u8457\u5408\u4F5C\u5173\u7CFB\u7684\u4E00\u4E2A\u91CD\u8981\u91CC\u7A0B\u7891\uFF0C\u8FD92\u5BB6\u516C\u53F8\u5408\u4F5C\u6700\u521D\u662F\u5728\u53BB\u5E749\u670817\u65E5\u4E3E\u884C\u7684\u7B2C20\u5C4A\u4E2D\u56FD-\u4E1C\u76DF\u535A\u89C8\u4F1A\uFF0C\u548C\u4E2D\u56FD-\u4E1C\u76DF\u5546\u52A1\u4E0E\u6295\u8D44\u5CF0\u4F1A\u4E0A\u901A\u8FC7\u7B7E\u7F72\u8C05\u89E3\u5907\u5FD8\u5F55\uFF08MoU\uFF09\u3002\u003C/p\u003E\n\u003Cp\u003E\u8FD9\u9879\u534F\u8BAE\u5177\u6709\u6CD5\u5F8B\u7EA6\u675F\u529B\uFF0C\u4F5C\u4E3A\u80A1\u4E1C\u534F\u8BAE\u7684\u57FA\u7840\uFF0C\u7528\u4E8E\u6210\u7ACB\u7279\u6B8A\u7528\u9014\u516C\u53F8\uFF08SPV\uFF09\uFF0C\u800CSUS\u63A7\u80A1\u4E0E\u5FD7\u8FBE\u73AF\u7403\u5C06\u5206\u522B\u6301\u6709\u8BE5\u7279\u6B8A\u7528\u9014\u516C\u53F851%\u4E0E49%\u80A1\u6743\uFF0C\u5728\u7B7E\u7F72\u534F\u8BAE\u540E\u8D776\u4E2A\u6708\u5185\u6267\u884C\u3002\u003C/p\u003E\n\u003Cp\u003E\u6839\u636E\u534F\u8BAE\uFF0CSUS\u63A7\u80A1\u5C06\u63D0\u4F9B\u5FC5\u8981\u7684\u524D\u671F\u521D\u59CB\u6295\u8D44\u548C\u878D\u8D44\u4E88\u5DF2\u786E\u7ACB\u7684\u9879\u76EE\uFF0C\u540C\u65F6\u627F\u62C5\u8FD9\u4E9B\u9879\u76EE\u7684\u5DE5\u7A0B\u3001\u91C7\u8D2D\u3001\u65BD\u5DE5\u548C\u8C03\u8BD5\uFF08EPCC\uFF09\uFF0C\u5E76\u5728\u9879\u76EE\u5B8C\u6210\u540E\u8FDB\u884C\u5546\u4E1A\u8FD0\u8425\uFF1B\u5FD7\u8FBE\u73AF\u7403\u5219\u5C06\u8D1F\u8D23\u91C7\u8D2D\u5F6D\u4EA8\u5DDE\u7684\u57CE\u5E02\u5783\u573E\u4EE5\u53CA\u68D5\u6CB9\u7A7A\u679C\u4E32\u548C\u6C61\u6CE5\u5E9F\u6599\uFF0C\u8FD9\u4E9B\u5E9F\u6599\u6709\u53EF\u80FD\u8F6C\u5316\u4E3A\u7535\u80FD\uFF0C\u968F\u540E\u4F5C\u4E3A\u53EF\u518D\u751F\u80FD\u6E90\u8FDB\u884C\u8F6C\u552E\u3002\u003C/p\u003E\n\u003Cp\u003E\u6B64\u5916\uFF0C\u5FD7\u8FBE\u73AF\u7403\u8FD8\u5C06\u8D1F\u8D23\u53D6\u5F97\u5E76\u786E\u4FDD\u8FDB\u884C\u5FC5\u8981\u7684\u76D1\u7BA1\u5BA1\u6279\uFF0C\u4EE5\u53CA\u63D0\u4F9B\u5FC5\u8981\u534F\u52A9\u6216\u4E0E\u5730\u65B9\u5F53\u5C40\u534F\u5546\u3002\u003C/p\u003E\n\u003Cp\u003E\u7279\u6B8A\u7528\u9014\u516C\u53F8\u521D\u59CB\u5B9E\u7F34\u80A1\u672C\u4E3A100\u4E07\u4EE4\u5409\uFF0C\u5176\u4E2DSUS\u63A7\u80A1\u51FA\u8D4451\u4E07\u4EE4\u5409\uFF0C\u800C\u5FD7\u8FBE\u73AF\u7403\u51FA\u8D4449\u4E07\u4EE4\u5409\uFF0C\u5177\u4F53\u91D1\u989D\u9700\u6839\u636E\u53CC\u65B9\u540C\u610F\u7684\u4E1A\u52A1\u548C\u53D1\u5C55\u8BA1\u5212\u786E\u5B9A\u3002\u003C/p\u003E\n\u003Cp\u003E\u521D\u59CB\u6295\u8D44\u5C06\u4F5C\u4E3A\u8425\u8FD0\u8D44\u91D1\uFF0C\u7528\u4E8E\u5BF9\u5DF2\u786E\u7ACB\u7684\u9879\u76EE\u8FDB\u884C\u521D\u6B65\u8BC4\u4F30\u548C\u5F00\u53D1\u3002\u003C/p\u003E\n\u003Cp\u003E\u63A8\u8FDBWtE \u201C\u53D8\u5E9F\u4E3A\u5B9D\u201D\u003C/p\u003E\n\u003Cp\u003E\u5FD7\u8FBE\u73AF\u7403\u6267\u884C\u4E3B\u5E2D\u517C\u603B\u88C1\u4E39\u65AF\u91CC\u83AB\u54C8\u672B\u8BFA\u624E\u8868\u793A\uFF0C\u5E9F\u6599\u7BA1\u7406\u5173\u4E4E\u201C\u53D8\u5E9F\u4E3A\u5B9D\u201D\uFF0C\u5373\u610F\u8BC6\u5230\u5E9F\u6599\u5728\u5F97\u5230\u59A5\u5584\u7BA1\u7406\u7684\u60C5\u51B5\u4E0B\u53EF\u4EE5\u6210\u4E3A\u5B9D\u8D35\u7684\u8D44\u6E90\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u5982\u4ECA\u7684\u5E9F\u6599\u7BA1\u7406\u4E0D\u518D\u53EA\u662F\u662F\u5904\u7406\u5E9F\u6599\uFF0C\u66F4\u591A\u662F\u5173\u4E8E\u5982\u4F55\u9AD8\u6548\u5904\u7406\u5E9F\u6599\u3001\u5C06\u4E4B\u5BF9\u73AF\u5883\u7684\u5F71\u54CD\u6700\u5C0F\u5316\uFF0C\u540C\u65F6\u5C06\u8D44\u6E90\u5229\u7528\u6700\u5927\u5316\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u7EED\u6307\uFF0C\u516C\u53F8\u4E0ESUS\u63A7\u80A1\u7684\u5408\u4F5C\u5C06\u4E13\u6CE8\u4E8E\u51CF\u5C11\u5E9F\u6599\u7684\u4EA7\u751F\u3001\u4FC3\u8FDB\u5E9F\u6599\u7684\u5FAA\u73AF\u518D\u5229\u7528\uFF0C\u5E76\u786E\u4FDD\u9075\u5B88\u73AF\u5883\u6CD5\u89C4\uFF0C\u800C\u8FD9\u6B21\u7684\u5408\u4F5C\u662F\u5B9E\u73B0\u5728\u5927\u9A6C\u63A8\u5E7F\u53EF\u6301\u7EED\u5E9F\u7269\u7BA1\u7406\u5B9E\u8DF5\u7684\u5171\u540C\u613F\u666F\u7684\u91CD\u8981\u4E00\u6B65\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u5728\u9A6C\u6765\u897F\u4E9A\uFF0C\u6BCF\u5929\u67093\u4E078000\u5428\u56FA\u4F53\u5E9F\u6599\u88AB\u6536\u96C6\uFF0C\u5E76\u4E22\u5F03\u5728\u5360\u5730150\u82F1\u4EA9\u7684\u5783\u573E\u586B\u57CB\u573A\u3002\u9A6C\u6765\u897F\u4E9A\u653F\u5E9C\u5DF2\u7ECF\u610F\u8BC6\u5230\u6709\u5FC5\u8981\u5728\u6BCF\u4E2A\u5DDE\u5EFA\u7ACB\u4E00\u4E2AWtE\u5DE5\u5382\u3002\u5927\u9A6C\u6BCF\u5E74\u5E73\u5747\u4EA7\u751F1400\u4E07\u5428\u57CE\u5E02\u5783\u573E\u3002\u8FD9\u4E9B\u5783\u573E\u5B9E\u9645\u4E0A\u662F\u4E00\u79CD\u591A\u529F\u80FD\u6750\u6599\uFF0C\u53EF\u4EE5\u5728\u4F20\u7EDF\u7684\u71C3\u70E7\u3001\u6C14\u5316\u6216\u70ED\u89E3\u7CFB\u7EDF\u4E2D\u8F6C\u5316\u4E3A\u5B9D\u8D35\u7684\u7EFF\u8272\u53EF\u518D\u751F\u71C3\u6599\u4E4B\u539F\u6599\uFF0C\u7528\u4E8E\u4F9B\u70ED\u548C\u53D1\u7535\u3002\u901A\u8FC7\u4E0ESUS\u63A7\u80A1\u643A\u624B\u8FDB\u5165WtE\u884C\u4E1A\uFF0C\u5C06\u8FDB\u4E00\u6B65\u52A0\u5F3A\u6211\u4EEC\u5728\u53EF\u518D\u751F\u80FD\u6E90\u9886\u57DF\u4E2D\u7684\u80FD\u529B\uFF0C\u5E76\u6269\u5927\u6211\u4EEC\u5728\u8FD9\u5E02\u573A\u4E0A\u7684\u4E1A\u52A1\u8303\u56F4\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/F-H1qr55wYHQy4F9XpsiAQ\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
