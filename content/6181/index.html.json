{
  "id": "5\u5929\u8BC4\u4F30\u4E4B\u65C5\u5E26\u4F60\u8BA4\u8BC6\u96EA\u5170\u83AA\u5730\u8D28\u516C\u56ED",
  "slug": "5\u5929\u8BC4\u4F30\u4E4B\u65C5\u5E26\u4F60\u8BA4\u8BC6\u96EA\u5170\u83AA\u5730\u8D28\u516C\u56ED",
  "canonicalUrlKey": "5\u5929\u8BC4\u4F30\u4E4B\u65C5\u5E26\u4F60\u8BA4\u8BC6\u96EA\u5170\u83AA\u5730\u8D28\u516C\u56ED",
  "route": "/6181/",
  "title": "\uD83C\uDDF2\uD83C\uDDFE5\u5929\u8BC4\u4F30\u4E4B\u65C5\uFF01\u5E26\u4F60\u8BA4\u8BC6\u96EA\u5170\u83AA\u5730\u8D28\u516C\u56ED",
  "summary": "\u96EA\u5170\u83AA Gombak-Hulu Langat \u5730\u8D28\u516C\u56ED\uFF08GHLGP\uFF09\u6C47\u805A\u77F3\u82F1\u5C71\u810A\u3001\u7164\u77FF\u96A7\u9053\u3001\u7011\u5E03\u4E0E\u6E29\u6CC9\u7B49\u81EA\u7136\u666F\u89C2\u4E0E\u6587\u5316\u9057\u4EA7\u3002\u96EA\u5170\u83AA\u65C5\u6E38\u5C40\u4E0E\u5404\u5730\u65B9\u5E02\u8BAE\u4F1A\u6210\u5458\u7EC4\u6210\u8BC4\u4F30\u5C0F\u7EC4\uFF0C\u5C55\u5F00\u4E3A\u671F5\u5929\u76842026\u5E74\u56FD\u5BB6\u5730\u8D28\u516C\u56ED\u91CD\u65B0\u8BC4\u4F30\uFF0C\u8D70\u8BBF Bukit Tabur \u77F3\u82F1\u5C71\u810A\u3001\u9ED1\u98CE\u6D1E\u3001\u9A6C\u6765\u897F\u4E9A\u68EE\u6797\u7814\u7A76\u9662\u3001Batu Arang \u7164\u77FF\u96A7\u9053\u3001Sungai Tekala \u7011\u5E03\u4E0E Dusun Tua \u6E29\u6CC9\u7B49\u5730\u3002\u6D3B\u52A8\u671F\u95F4\u53D1\u5E03\u5B98\u65B9\u6B4C\u66F2\uFF0C\u96EA\u5170\u83AA\u65C5\u6E38\u5C40\u4E0E\u4F73\u80FD\u7B7E\u7F72\u5907\u5FD8\u5F55\uFF0C\u5E76\u4E3A2028\u5E74\u7533\u62A5 UNESCO \u5168\u7403\u5730\u8D28\u516C\u56ED\u505A\u51C6\u5907\u3002",
  "body": "\u003Cp\u003E\u539F\u6765\u8FD9\u4E9B\u719F\u6089\u7684\u0026#127474;\u0026#127486;\u9A6C\u6765\u897F\u4E9A\u4EBA\u6C14\u666F\u70B9\uFF0C\u90FD\u5C5E\u4E8E\u540C\u4E00\u4E2A\u5730\u8D28\u516C\u56ED\u8303\u56F4\uFF01\u0026#128064;\u003C/p\u003E\n\u003Cp\u003E\u4ECE\u58EE\u89C2\u7684\u77F3\u82F1\u5C71\u810A\u3001\u5386\u53F2\u60A0\u4E45\u7684\u7164\u77FF\u96A7\u9053\uFF0C\u5230\u7EFF\u610F\u76CE\u7136\u7684\u7011\u5E03\u4E0E\u6E29\u6CC9\uFF0C\u96EA\u5170\u83AA Gombak-Hulu Langat \u5730\u8D28\u516C\u56ED\uFF08GHLGP\uFF09\u6C47\u805A\u4E86\u4E30\u5BCC\u591A\u6837\u7684\u81EA\u7136\u666F\u89C2\u4E0E\u6587\u5316\u9057\u4EA7\u3002\u003C/p\u003E\n\u003Cp\u003E\u6B64\u6B21\uFF0C\u96EA\u5170\u83AA\u65C5\u6E38\u5C40\u3001\u5404\u5730\u65B9\u5E02\u8BAE\u4F1A\u6210\u5458\u4E0E\u76F8\u5173\u53C2\u4E0E\u5355\u4F4D\u7EC4\u6210\u8BC4\u4F30\u5C0F\u7EC4\uFF0C\u5C55\u5F005\uFE0F\u20E3\u5929\u7684\u300C2026\u5E74\u56FD\u5BB6\u5730\u8D28\u516C\u56ED\u91CD\u65B0\u8BC4\u4F30\u300D\u3002\u8BC4\u4F30\u671F\u95F4\uFF0C\u4ED6\u4EEC\u7279\u522B\u8D70\u8BBF\u4E86\u591A\u4E2A\u91CD\u8981\u5730\u8D28\u4E0E\u751F\u6001\u666F\u70B9\uFF0C\u5305\u62EC\uFF1A\u003C/p\u003E\n\u003Ch3\u003E\u0026#127748;Bukit Tabur \u77F3\u82F1\u5C71\u810A\u003C/h3\u003E\n\u003Ch3\u003E\u0026#128725;Batu Caves \u9ED1\u98CE\u6D1E\u003C/h3\u003E\n\u003Ch3\u003E\u0026#127795;\u9A6C\u6765\u897F\u4E9A\u68EE\u6797\u7814\u7A76\u9662\uFF08FRIM\uFF09\u003C/h3\u003E\n\u003Ch3\u003E\u26CF\uFE0FBatu Arang \u7164\u77FF\u96A7\u9053\u003C/h3\u003E\n\u003Ch3\u003E\u0026#128166;Sungai Tekala \u7011\u5E03\u003C/h3\u003E\n\u003Ch3\u003E\u2668\uFE0FDusun Tua \u6E29\u6CC9\u7EFC\u5408\u4E2D\u5FC3\u003C/h3\u003E\n\u003Cp\u003E\u9664\u4E86\u5B9E\u5730\u8003\u5BDF\uFF0C\u8BC4\u4F30\u5C0F\u7EC4\u4E5F\u900F\u8FC7\u4EA4\u6D41\u4F1A\u8BAE\u2728\u4E0E\u5F53\u5730\u673A\u6784\u3001\u793E\u533A\u53CA\u65C5\u6E38\u4E1A\u8005\u5C55\u5F00\u4EA4\u6D41\uFF0C\u8FDB\u4E00\u6B65\u4E86\u89E3\u5404\u65B9\u5728\u81EA\u7136\u4FDD\u80B2\u3001\u6559\u80B2\u63A8\u5E7F\u4E0E\u53EF\u6301\u7EED\u53D1\u5C55\u65B9\u9762\u7684\u53C2\u4E0E\u53CA\u6210\u679C\u3002\u003C/p\u003E\n\u003Cp\u003E\u66F4\u60CA\u559C\u7684\u662F\uFF01\u6D3B\u52A8\u671F\u95F4\u4E5F\u6B63\u5F0F\u53D1\u5E03 GHLGP \u5B98\u65B9\u6B4C\u66F2\u300APesona Gombak Hulu Langat Geopark\u300B\u0026#127925; \uFF0C\u5E76\u7531\u96EA\u5170\u83AA\u65C5\u6E38\u5C40\u4E0E\u9A6C\u6765\u897F\u4E9A\u300C\u4F73\u80FD Canon\u300D\u7B7E\u7F72 \u0026#129309;\u5907\u5FD8\u5F55\uFF0C\u643A\u624B\u900F\u8FC7\u521B\u610F\u5185\u5BB9\u4E0E\u5F71\u50CF\u8BB0\u5F55\uFF0C\u8FDB\u4E00\u6B65\u63A8\u5E7F\u53CA\u5B88\u62A4\u73CD\u8D35\u7684\u81EA\u7136\u9057\u4EA7\u3002\u003C/p\u003E\n\u003Cp\u003E\u2728\u4ECE\u81EA\u7136\u666F\u89C2\u5230\u6587\u5316\u9057\u4EA7\uFF0CGHLGP \u6301\u7EED\u63A8\u52A8\u5730\u8D28\u65C5\u6E38\u53D1\u5C55\uFF0C\u5E76\u79EF\u6781\u4E3A2028\u5E74\u7533\u62A5 UNESCO Global Geopark \u505A\u51C6\u5907\uFF0C\u671F\u5F85\u8BA9\u66F4\u591A\u4EBA\u8BA4\u8BC6\u96EA\u5170\u83AA\u4E30\u5BCC\u7684\u81EA\u7136\u4E0E\u6587\u5316\u9B45\u529B\uFF01\u003C/p\u003E\n",
