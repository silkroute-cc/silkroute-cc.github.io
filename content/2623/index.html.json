  "title": "\u4E13\u827A\u8D44\u6E90\u83B7\u5EF6\u957F\u5408\u7EA6\u503C8\u4EBF \u4F9B\u5E94\u7279\u5B9A\u539F\u6599\u7528\u4E8E\u751F\u4EA7\u592A\u9633\u80FD\u5149\u4F0F\u7EC4\u4EF6",
  "summary": "\uFF08\u5409\u9686\u576125\u65E5\u8BAF\uFF09\u4E13\u827A\u8D44\u6E90\uFF08PA\uFF0C7225\uFF0C\u4E3B\u677F\u5DE5\u4E1A\u80A1\uFF09\u5BA3\u5E03\uFF0C\u4E0E\u5927\u9A6C\u548C\u8D8A\u5357First Solar\u516C\u53F8\u7B7E\u7F72\u7684\u4F9B\u5E94\u5408\u7EA6\uFF0C\u83B7\u5F97\u8FDB\u4E00\u6B65\u5EF6\u957F2\u5E74\uFF0C\u4EF7\u503C\u7EA6\u4E3A8\u4EBF\u4EE4\u5409\u3002 \u8BE5\u516C\u53F8\u4ECA\u65E5\u5411\u4EA4\u6613\u6240\u62A5\u5907\uFF0C\u5B50\u516C\u53F8P.A.Extrusion\u5C06\u4F9B\u5E94\u7279\u5B9A\u539F\u6599\uFF0C\u7ED9First Solar\u7528\u4E8E\u751F\u4EA7\u592A\u9633\u80FD\u5149\u4F0F\u7EC4\u4EF6\u3002 \u6839\u636E\u6587\u544A\uFF0C\u8BE5\u5EF6\u957F\u5408\u7EA6\u5C06\u4ECE\u672C\u6708\u751F\u6548\u3002 \u4E13\u827A\u8D44\u6E90\u6700\u521D\u662F\u57282018\u5E741\u6708\u83B7\u5F97\u4F9B\u5E94\u5408\u7EA6\uFF0C\u4EE5\u5728\u672A\u67653\u5E74\u4F9B\u5E94\u76F8\u5173\u4EA7\u54C1\u3002 \u95ED\u5E02\u65F6\uFF0C\u4E13\u827A\u8D44\u6E90\u62A549.5\u4ED9\uFF0C\u8D773.\u2026",
  "body": "\u003Cp\u003E\uFF08\u5409\u9686\u576125\u65E5\u8BAF\uFF09\u4E13\u827A\u8D44\u6E90\uFF08PA\uFF0C7225\uFF0C\u4E3B\u677F\u5DE5\u4E1A\u80A1\uFF09\u5BA3\u5E03\uFF0C\u4E0E\u5927\u9A6C\u548C\u8D8A\u5357First Solar\u516C\u53F8\u7B7E\u7F72\u7684\u4F9B\u5E94\u5408\u7EA6\uFF0C\u83B7\u5F97\u8FDB\u4E00\u6B65\u5EF6\u957F2\u5E74\uFF0C\u4EF7\u503C\u7EA6\u4E3A8\u4EBF\u4EE4\u5409\u3002\u003C/p\u003E\n\u003Cp\u003E\u8BE5\u516C\u53F8\u4ECA\u65E5\u5411\u4EA4\u6613\u6240\u62A5\u5907\uFF0C\u5B50\u516C\u53F8P.A.Extrusion\u5C06\u4F9B\u5E94\u7279\u5B9A\u539F\u6599\uFF0C\u7ED9First Solar\u7528\u4E8E\u751F\u4EA7\u592A\u9633\u80FD\u5149\u4F0F\u7EC4\u4EF6\u3002\u003C/p\u003E\n\u003Cp\u003E\u6839\u636E\u6587\u544A\uFF0C\u8BE5\u5EF6\u957F\u5408\u7EA6\u5C06\u4ECE\u672C\u6708\u751F\u6548\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E13\u827A\u8D44\u6E90\u6700\u521D\u662F\u57282018\u5E741\u6708\u83B7\u5F97\u4F9B\u5E94\u5408\u7EA6\uFF0C\u4EE5\u5728\u672A\u67653\u5E74\u4F9B\u5E94\u76F8\u5173\u4EA7\u54C1\u3002\u003C/p\u003E\n\u003Cp\u003E\u95ED\u5E02\u65F6\uFF0C\u4E13\u827A\u8D44\u6E90\u62A549.5\u4ED9\uFF0C\u8D773.5\u4ED9\u62167.61%\uFF0C\u6210\u4EA4\u91CF2902\u4E073900\u80A1\u3002\u003C/p\u003E\n",
