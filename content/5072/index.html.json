{
  "id": "%e6%99%ae%e9%80%9a%e6%8a%a4%e7%85%a7%e6%8d%a2%e5%8f%91",
  "slug": "%e6%99%ae%e9%80%9a%e6%8a%a4%e7%85%a7%e6%8d%a2%e5%8f%91",
  "canonicalUrlKey": "%e6%99%ae%e9%80%9a%e6%8a%a4%e7%85%a7%e6%8d%a2%e5%8f%91",
  "route": "/5072/",
  "title": "\u666E\u901A\u62A4\u7167\u6362\u53D1",
  "summary": "\u4E00\u3001\u9002\u7528\u8303\u56F4 \u4E3B\u8981\u9002\u7528\u4E8E\u5728\u56FD\u5916\u7684\u4E2D\u56FD\u666E\u901A\u62A4\u7167\u6301\u6709\u4EBA\uFF0C\u5982\u62A4\u7167\u8FC7\u671F\u3001\u6709\u6548\u671F\u5373\u5C06\u5C4A\u6EE1\uFF08\u4E00\u822C\u6307\u4E0D\u8DB3\u4E00\u5E74\uFF09\u3001\u62A4\u7167\u7B7E\u8BC1\u9875\u5373\u5C06\u7528\u5B8C\uFF08\u4E00\u822C\u6307\u4E0D\u8DB34\u4E2A\u5355\u9875\uFF09\u3001\u5BB9\u8C8C\u53D8\u5316\u8F83\u5927\u3002\u5982\u62A4\u7167\u6709\u6548\u671F\u5269\u4F59\u4E00\u5E74\u4EE5\u4E0A\u6216\u7B7E\u8BC1\u9875\u5269\u4F594\u4E2A\u5355\u9875\u4EE5\u4E0A\uFF0C\u4F46\u56E0\u7533\u529E\u5F53\u5730\u5C45\u7559\u3001\u7B7E\u8BC1\u5EF6\u671F\u3001\u5DE5\u4F5C\u8BB8\u53EF\u6216\u56FD\u9645\u65C5\u884C\u786E\u6709\u9700\u8981\u7684\uFF0C\u53EF\u63D0\u524D\u6362\u53D1\u62A4\u7167\uFF1B\u6216\u56E0\u66F4\u6539\u59D3\u540D\uFF0C\u7533\u8BF7\u6362\u53D1\u62A4\u7167\u3002 \u4E8C\u3001\u7533\u8BF7\u65B9\u5F0F \uFF08\u4E00\uFF09\u7533\u8BF7\u4EBA\u5230\u624B\u673A\u5E94\u7528\u5546\u5E97\u4E0B\u8F7D\u6700\u65B0\u7248\u672C\u201C\u4E2D\u56FD\u9886\u4E8B\u201DAPP\uFF08V2.3.9\u7248\uFF09\uFF0C\u901A\u8FC7APP\u586B\u5199\u53CA\u63D0\u4EA4\u8BC1\u4EF6\u529E\u7406\u7533\u8BF7\uFF0C\u9009\u62E9\u201C\u5230\u9986\u529E\u7406\u201D--\u201C\u5230\u9986\u63D0\u4EA4\u201D\uFF0C\u5F85\u5BA1\u6838\u901A\u8FC7\u3001\u2026",
  "body": "\u003Cp\u003E\u4E00\u3001\u9002\u7528\u8303\u56F4\u003C/p\u003E\n\u003Cp\u003E\u4E3B\u8981\u9002\u7528\u4E8E\u5728\u56FD\u5916\u7684\u4E2D\u56FD\u666E\u901A\u62A4\u7167\u6301\u6709\u4EBA\uFF0C\u5982\u62A4\u7167\u8FC7\u671F\u3001\u6709\u6548\u671F\u5373\u5C06\u5C4A\u6EE1\uFF08\u4E00\u822C\u6307\u4E0D\u8DB3\u4E00\u5E74\uFF09\u3001\u62A4\u7167\u7B7E\u8BC1\u9875\u5373\u5C06\u7528\u5B8C\uFF08\u4E00\u822C\u6307\u4E0D\u8DB34\u4E2A\u5355\u9875\uFF09\u3001\u5BB9\u8C8C\u53D8\u5316\u8F83\u5927\u3002\u5982\u62A4\u7167\u6709\u6548\u671F\u5269\u4F59\u4E00\u5E74\u4EE5\u4E0A\u6216\u7B7E\u8BC1\u9875\u5269\u4F594\u4E2A\u5355\u9875\u4EE5\u4E0A\uFF0C\u4F46\u56E0\u7533\u529E\u5F53\u5730\u5C45\u7559\u3001\u7B7E\u8BC1\u5EF6\u671F\u3001\u5DE5\u4F5C\u8BB8\u53EF\u6216\u56FD\u9645\u65C5\u884C\u786E\u6709\u9700\u8981\u7684\uFF0C\u53EF\u63D0\u524D\u6362\u53D1\u62A4\u7167\uFF1B\u6216\u56E0\u66F4\u6539\u59D3\u540D\uFF0C\u7533\u8BF7\u6362\u53D1\u62A4\u7167\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E8C\u3001\u7533\u8BF7\u65B9\u5F0F\u003C/p\u003E\n\u003Cp\u003E\uFF08\u4E00\uFF09\u7533\u8BF7\u4EBA\u5230\u624B\u673A\u5E94\u7528\u5546\u5E97\u4E0B\u8F7D\u6700\u65B0\u7248\u672C\u201C\u4E2D\u56FD\u9886\u4E8B\u201DAPP\uFF08V2.3.9\u7248\uFF09\uFF0C\u901A\u8FC7APP\u586B\u5199\u53CA\u63D0\u4EA4\u8BC1\u4EF6\u529E\u7406\u7533\u8BF7\uFF0C\u9009\u62E9\u201C\u5230\u9986\u529E\u7406\u201D--\u201C\u5230\u9986\u63D0\u4EA4\u201D\uFF0C\u5F85\u5BA1\u6838\u901A\u8FC7\u3001\u201C\u4E2D\u56FD\u9886\u4E8B\u201DAPP\u72B6\u6001\u8F6C\u53D8\u4E3A\u201C\u590D\u5BA1\u4E2D\u201D\u540E\uFF0C\u65E0\u9700\u9884\u7EA6\uFF0C\u672C\u4EBA\u4E8E\u5DE5\u4F5C\u65E59:00-11:30\u76F4\u63A5\u524D\u5F80\u4F7F\u9986\u9886\u4E8B\u670D\u52A1\u5927\u5385\u9012\u4EA4\u62A4\u7167\u7533\u8BF7\u6750\u6599\u3001\u6838\u9A8C\u8EAB\u4EFD\u3001\u91C7\u96C6\u6307\u7EB9\u7B49\u3002\u003C/p\u003E\n\u003Cp\u003E\u7279\u522B\u63D0\u9192\uFF0C\u4EE5\u4E0B\u60C5\u51B5\u65E0\u9700\u5230\u9986\u91C7\u96C6\u6307\u7EB9\uFF1A\u003C/p\u003E\n\u003Cp\u003E1.\u7533\u8BF7\u4EBA\u5E74\u9F84\u5C0F\u4E8E16\u5468\u5C81\uFF08\u5982\u9009\u62E9\u5230\u9986\u529E\u7406\uFF0C\u9700\u81F3\u5C11\u4E00\u540D\u6CD5\u5B9A\u76D1\u62A4\u4EBA\u966A\u540C\uFF09\uFF1B\u003C/p\u003E\n\u003Cp\u003E2.\u56E0\u6307\u7EB9\u7F3A\u5931\u3001\u635F\u574F\u7B49\u539F\u56E0\u65E0\u6CD5\u91C7\u96C6\u7684\u4EBA\u5458\uFF0C\u8001\u3001\u5F31\u3001\u75C5\u3001\u6B8B\u4EBA\u5458\u53CA\u5176\u4ED6\u60C5\u51B5\u7279\u6B8A\u4EBA\u5458\uFF08\u4E0B\u5355\u65F6\u8BF7\u5728APP\u201C\u5176\u4ED6\u60F3\u5BF9\u4F7F\u9986\u8BF4\u7684\u8BDD\u201D\u6A21\u5757\u5185\u586B\u5199\u201C\u7533\u8BF7\u7EBF\u4E0A\u529E\u7406\u201D\uFF0C\u8BF4\u660E\u5177\u4F53\u539F\u56E0\u5E76\u4E0A\u4F20\u5FC5\u8981\u8BC1\u660E\u6750\u6599\u81F3\u201C\u5176\u4ED6\u6750\u6599\u201D\uFF09\u3002\u003C/p\u003E\n\u003Cp\u003E\uFF08\u4E8C\uFF09\u65E0\u9700\u5230\u9986\u529E\u7406\u7684\u7533\u8BF7\u4EBA\u9009\u62E9\u201C\u5728\u7EBF\u529E\u7406\u201D--\u201C\u90AE\u5BC4\u201D\uFF08\u5373\u90AE\u5BC4\u7533\u8BF7\u6750\u6599\u5230\u9986\uFF09\uFF0C\u901A\u8FC7\u521D\u5BA1\u540E\u987B\u6839\u636E\u7CFB\u7EDF\u63D0\u793A\u9884\u7EA6\u89C6\u9891\u9762\u5BA1\u3002\u9762\u5BA1\u901A\u8FC7\uFF0C\u201C\u4E2D\u56FD\u9886\u4E8B\u201DAPP\u663E\u793A\u201C\u5F85\u5236\u8BC1\u201D\u540E\u90AE\u5BC4\u7533\u8BF7\u6750\u6599\u5230\u9986\u3002\u003C/p\u003E\n\u003Cp\u003E\uFF08\u4E09\uFF09\u5F53\u201C\u4E2D\u56FD\u9886\u4E8B\u201DAPP\u8BA2\u5355\u72B6\u6001\u8F6C\u53D8\u4E3A\u201C\u5F85\u90AE\u5BC4/\u5F85\u53D6\u8BC1\u201D\u540E\uFF0C\u7533\u8BF7\u4EBA\u53EF\u5230\u4F7F\u9986\u9886\u4E8B\u670D\u52A1\u5927\u5385\u7F34\u8D39\u53CA\u9886\u53D6\u65B0\u8BC1\u4EF6\u3002\u53D6\u8BC1\u65F6\u95F4\u4E3A\u5DE5\u4F5C\u65E5\u4E0B\u534814:30-16:30\u3002\u7533\u8BF7\u4EBA\u4EA6\u53EF\u9009\u62E9\u90AE\u5BC4\u53D6\u8BC1\uFF0C\u8D39\u7528\u6C47\u81F3\u4F7F\u9986\u8D26\u6237\u3002\u5F85APP\u72B6\u6001\u66F4\u65B0\u4E3A\u201C\u5DF2\u53D6\u8BC1\u201D\uFF0C\u6211\u9986\u5C06\u4E8E2\u4E2A\u5DE5\u4F5C\u65E5\u5185\u53D1\u9001\u9884\u7EA6\u5FEB\u9012\u53D6\u4EF6\u901A\u77E5\u81F3\u7533\u8BF7\u4EBA\u7535\u5B50\u90AE\u7BB1\u3002\u003C/p\u003E\n\u003Cp\u003E\uFF08\u56DB\uFF09\u7279\u522B\u8BF4\u660E\uFF1A\u4E2D\u56FD\u9A7B\u9A6C\u6765\u897F\u4E9A\u5927\u4F7F\u9986\u4E3B\u8981\u53D7\u7406\u5C45\u4F4F\u5728\u897F\u9A6C\uFF08\u4EE5\u9A6C\u65B9\u7B7E\u8BC1\u7B7E\u53D1\u673A\u6784\u6240\u5728\u5730\u4E3A\u51C6\uFF09\u7684\u4E2D\u56FD\u516C\u6C11\u7533\u8BF7\u3002\u5C45\u4F4F\u4E1C\u9A6C\u7684\u7533\u8BF7\u4EBA\u53EF\u6839\u636E\u4E0D\u540C\u60C5\u51B5\u5206\u522B\u5411\u4E2D\u56FD\u9A7B\u53E4\u664B\u603B\u9886\u9986\u6216\u4E2D\u56FD\u9A7B\u54E5\u6253\u57FA\u7EB3\u5DF4\u5362\u603B\u9886\u9986\u7533\u8BF7\u3002\u003C/p\u003E\n\u003Cp\u003E\uFF08\u4E94\uFF09\u56E0\u516C\u62A4\u7167\u53CA\u6E2F\u6FB3\u53F0\u5C45\u6C11\u529E\u7406\u8BC1\u4EF6\u76EE\u524D\u4E0D\u901A\u8FC7APP\u529E\u7406\uFF0C\u8BF7\u53D1\u90AE\u4EF6\u81F3 kl_hz@csm.mfa.gov.cn\u54A8\u8BE2\u529E\u7406\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E09\u3001\u6240\u9700\u4E0A\u4F20\u7533\u8BF7\u6750\u6599\u003C/p\u003E\n\u003Cp\u003E1.\u7167\u7247\uFF1A\u8FD1\u671F\uFF086\u4E2A\u6708\u5185\uFF09\u6B63\u9762\u514D\u51A0\u5F69\u8272\u534A\u8EAB\u8BC1\u4EF6\u7167\u7247\uFF08\u7535\u5B50\u7248\uFF09\uFF0C\u7167\u7247\u5C3A\u5BF8\u4E3A48mmX33mm\uFF0C\u5934\u90E8\u5BBD15mm-22mm\u3001\u9AD8 28mm-33mm\uFF0C\u80CC\u666F\u4E3A\u767D\u8272\uFF0C\u4E0D\u5F97\u7740\u6D45\u8272\u8863\u670D\uFF0C\u8868\u60C5\u81EA\u7136\uFF0C\u53CC\u773C\u7741\u5F00\uFF0C\u53CC\u5507\u81EA\u7136\u95ED\u5408\uFF0C\u5934\u53D1\u52FF\u906E\u6321\u8033\u5ED3\uFF0C\u5168\u90E8\u9762\u90E8\u7279\u5F81\u6E05\u6670\u53EF\u89C1\uFF1B\u003C/p\u003E\n\u003Cp\u003E2.\u7533\u8BF7\u4EBA\u6709\u6548\u62A4\u7167\u8D44\u6599\u9875\uFF1B\u003C/p\u003E\n\u003Cp\u003E3.\u7533\u8BF7\u4EBA\u6765\u9A6C\u7B7E\u8BC1\u53CA\u6700\u65B0\u6765\u9A6C\u5165\u5883\u7AE0\uFF08\u5982\u6709\uFF09\uFF1B\u003C/p\u003E\n\u003Cp\u003E4.\u5982\u7533\u8BF7\u4EBA\u7CFB\u672A\u6EE116\u5468\u5C81\u672A\u6210\u5E74\u4EBA\uFF0C\u987B\u7531\u4E00\u4F4D\u6CD5\u5B9A\u76D1\u62A4\u4EBA\uFF08\u7236\u6216\u6BCD\u6216\u5176\u4ED6\u6CD5\u5B9A\u76D1\u62A4\u4EBA\uFF09\u51FA\u5177\u300A\u672A\u6210\u5E74\u4EBA\u529E\u7406\u62A4\u7167/\u65C5\u884C\u8BC1\u58F0\u660E\u4E66\u300B\uFF08\u53EF\u5728\u4E2D\u56FD\u9A7B\u9A6C\u6765\u897F\u4E9A\u5927\u4F7F\u9986\u5B98\u65B9\u7F51\u7AD9\u201C\u9996\u9875 \u0026gt; \u9886\u4E8B\u670D\u52A1 \u0026gt; \u9886\u4E8B\u8BC1\u4EF6 \u0026gt; \u62A4\u7167\u65C5\u884C\u8BC1 \u0026gt; \u8868\u683C\u4E0B\u8F7D\u201D\u4E2D\u4E0B\u8F7D\uFF09\uFF0C\u63D0\u4F9B\u6CD5\u5B9A\u76D1\u62A4\u4EBA\u672C\u4EBA\u8EAB\u4EFD\u8BC1\u660E\uFF08\u5982\u62A4\u7167\u3001\u65C5\u884C\u8BC1\uFF09\u4EE5\u53CA\u76D1\u62A4\u5173\u7CFB\u51ED\u8BC1\uFF08\u5982\u7533\u8BF7\u4EBA\u51FA\u751F\u8BC1\u660E\u3001\u8F7D\u660E\u4EB2\u5B50\u5173\u7CFB\u7684\u6237\u53E3\u7C3F\u3001\u6CD5\u5B9A\u76D1\u62A4\u5173\u7CFB\u516C\u8BC1\u4E66\u7B49\uFF09\uFF1B\u003C/p\u003E\n\u003Cp\u003E5.\u6362\u53D1\u62A4\u7167\u5E76\u66F4\u6539\u59D3\u540D\u8005\u987B\u63D0\u4F9B\u6709\u66F4\u6539\u59D3\u540D\u7684\u56FD\u5185\u6237\u53E3\u7C3F\uFF08\u987B\u7ECF\u56FD\u5185\u6237\u7C4D\u4E3B\u7BA1\u90E8\u95E8\u6838\u5B9E\uFF09\uFF1B\u5728\u56FD\u5916\u51FA\u751F\u4E14\u56FD\u5185\u65E0\u6237\u7C4D\u6210\u5E74\u4EBA\u9700\u66F4\u6539\u59D3\u540D\uFF0C\u987B\u63D0\u4F9B\u5C06\u627F\u62C5\u56E0\u66F4\u6539\u59D3\u540D\u800C\u4EA7\u751F\u7684\u4E00\u5207\u6CD5\u5F8B\u540E\u679C\u548C\u8D23\u4EFB\u58F0\u660E\u4E66\uFF1B\u5982\u7533\u8BF7\u4EBA\u672A\u6EE116\u5468\u5C81\uFF0C\u9700\u7236\u6BCD\u53CC\u65B9\u6216\u5176\u4ED6\u6CD5\u5B9A\u76D1\u62A4\u4EBA\u4E00\u81F4\u540C\u610F\u5E76\u4E66\u9762\u58F0\u660E\uFF1B\u003C/p\u003E\n\u003Cp\u003E6.\u4F7F\u9986\u8BA4\u4E3A\u9700\u8981\u63D0\u4EA4\u7684\u5176\u4ED6\u6750\u6599\u3002\u003C/p\u003E\n\u003Cp\u003E\u56DB\u3001\u529E\u7406\u65F6\u95F4\u003C/p\u003E\n\u003Cp\u003E1. \u62A4\u7167\u7531\u56FD\u5185\u5236\u8BC1\u4E2D\u5FC3\u7EDF\u4E00\u5236\u4F5C\uFF0C\u6B63\u5E38\u60C5\u51B5\u4E0B\uFF0C\u7533\u8BF7\u5B8C\u6210\u9884\u5BA1\u3001\u9762\u8C08\u3001\u6536\u5230\u6750\u6599\u540E\uFF0C\u4E00\u822C\u53E6\u970010\u4E2A\u5DE5\u4F5C\u65E5\u5B8C\u6210\u3002\u003C/p\u003E\n\u003Cp\u003E2. \u56E0\u9700\u5411\u56FD\u5185\u6838\u67E5\u7533\u8BF7\u4EBA\u8EAB\u4EFD\u548C\u62A4\u7167\u60C5\u51B5\uFF0C\u5982\u6838\u67E5\u7ED3\u679C\u672A\u80FD\u53CA\u65F6\u8FD4\u56DE\uFF0C\u529E\u8BC1\u65F6\u95F4\u53EF\u80FD\u76F8\u5E94\u5EF6\u957F\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E94\u3001\u8D39\u7528\u53CA\u4ED8\u6B3E\u65B9\u5F0F\u003C/p\u003E\n\u003Cp\u003E\uFF08\u4E00\uFF09\u62A4\u7167\u6362\u53D1\u8D39\u7528\u4E3A75\u9A6C\u5E01\uFF0C\u5728APP\u529E\u7406\u65F6\u9009\u62E9\u7EBF\u4E0B\u652F\u4ED8\uFF0C\u53EF\u94F6\u884C\u8F6C\u8D26\u6216\u5230\u9986\u652F\u4ED8\u3002\u003C/p\u003E\n\u003Cp\u003E\uFF08\u4E8C\uFF09\u5982\u5230\u9986\u652F\u4ED8\uFF0C\u53EF\u901A\u8FC7\u94F6\u8054\u501F\u8BB0\u5361\u3001\u652F\u4ED8\u5B9D\u6216\u9A6C\u6765\u897F\u4E9AMyDebit\u5361\u652F\u4ED8\u3002\u003C/p\u003E\n\u003Cp\u003E\uFF08\u4E09\uFF09\u5982\u901A\u8FC7\u94F6\u884C\u8F6C\u8D26\u652F\u4ED8\uFF0C\u8BF7\u5C06\u529E\u8BC1\u8D39\u7528\u6C47\u81F3\u4E2D\u56FD\u94F6\u884C\uFF08\u9A6C\u6765\u897F\u4E9A\uFF09BANK OF CHINA\uFF08MALAYSIA\uFF09\u8D26\u6237\uFF1A\u003C/p\u003E\n\u003Cp\u003E\u8D26\u6237\u53F7\u7801ACCOUNT NUMBER\uFF1A100000400147221\u003C/p\u003E\n\u003Cp\u003E\u8D26\u6237\u540D\u79F0ACCOUNT NAME\uFF1ACHINA EMBASSY VISA FEES COLLECTION\u003C/p\u003E\n\u003Cp\u003E\u8F6C\u8D26\u65B9\u5F0FTRANSFER MODE\uFF1ADUIT NOW/INTERBANK GIRO\u003C/p\u003E\n\u003Cp\u003E\u7528\u6237\u5907\u6CE8RECIPIENT\u2019S REFERENCE\uFF1AAPP\u751F\u6210\u7684\u8BA2\u5355\u53F7\u002B\u59D3\u540D\u62FC\u97F3\u003C/p\u003E\n\u003Cp\u003E\u6E29\u99A8\u63D0\u793A\uFF1A\u8BF7\u52FF\u591A\u4ED8\u6216\u5C11\u4ED8\uFF0C\u8BF7\u52FF\u591A\u540D\u7533\u8BF7\u4EBA\u5408\u5E76\u8F6C\u8D26\u3002\u003C/p\u003E\n\u003Cp\u003E\u516D\u3001\u201C\u4E2D\u56FD\u9886\u4E8B\u201DAPP\u5E38\u89C1\u95EE\u9898\u89E3\u7B54\uFF08\u5305\u62ECAPP\