  "canonicalUrlKey": "%e5%89%af%e9%a6%96%e7%9b%b8-%e7%a1%ae%e4%bf%9d%e5%90%88%e8%a7%84%e4%b8%8e%e6%b0%b8%e7%bb%ad-%e6%ad%a3%e6%8b%9f%e5%ae%9a%e6%95%b0%e6%8d%ae%e4%b8%ad%e5%bf%83%e6%8a%95%e8%b5%84%e6%8c%87%e5%8d%97",
  "route": "/5065/",
  "title": "\u526F\u9996\u76F8: \u786E\u4FDD\u5408\u89C4\u4E0E\u6C38\u7EED \u6B63\u62DF\u5B9A\u6570\u636E\u4E2D\u5FC3\u6295\u8D44\u6307\u5357  \u65B0\u80FD\u6E90\u5F00\u653E\u62DB\u6807",
  "summary": "\u6CD5\u8FEA\u62C9\u5C24\u7D22\u592B \uFF08\u5409\u9686\u576120\u65E5\u8BAF\uFF09\u6211\u56FD\u65E5\u6E10\u6210\u4E3A\u6D77\u5916\u6295\u8D44\u8005\u5C24\u5176\u662F\u6570\u636E\u4E2D\u5FC3\u4E1A\u8005\u7684\u70ED\u70B9\uFF0C\u76EE\u524D\uFF0C\u653F\u5E9C\u6B63\u5728\u4E3A\u6B64\u7814\u62DF\u6570\u636E\u4E2D\u5FC3\u8FDB\u9A7B\u6211\u56FD\u6240\u9700\u9075\u5FAA\u7684\u6807\u51C6\u4E0E\u6307\u5357\u3002 \u610F\u6B32\u8D74\u9A6C\u8BBE\u6570\u636E\u4E2D\u5FC3\u7684\u4E1A\u8005\u589E\u591A\uFF0C\u526F\u9996\u76F8\u517C\u80FD\u6E90\u53CA\u6C34\u52A1\u8F6C\u578B\u90E8\u957F\u62FF\u7763\u65AF\u91CC\u6CD5\u8FEA\u62C9\u5C24\u7D22\u592B\u4ECA\u5929\u900F\u9732\uFF0C\u5185\u9601\u5404\u90E8\u4F1A\u4EA6\u6B63\u5728\u63A2\u8BA8\uFF0C\u4F55\u79CD\u6295\u8D44\u7C7B\u578B\u624D\u771F\u6B63\u9002\u5408\u6211\u56FD\u3002 \u201C\u5168\u6570\u5185\u9601\u90E8\u95E8\u7686\u5728\u63A2\u8BA8\u6B64\u4E8B\uFF0C\u5F53\u4E2D\u5305\u62EC\u56FD\u9645\u8D38\u6613\u53CA\u6295\u8D44\u90E8\u3001\u6211\u638C\u7BA1\u7684\u80FD\u6E90\u53CA\u6C34\u52A1\u8F6C\u578B\u90E8\u3001\u623F\u5C4B\u53CA\u5730\u65B9\u653F\u7B56\u90E8\u3002\u201D \u201C\u6709\u5173\u90E8\u95E8\u662F\u4ECE\u5404\u81EA\u7684\u89D2\u5EA6\uFF0C\u63A2\u8BA8\u6D77\u5916\u5BF9\u6211\u56FD\u6295\u8D44\u7684\u4E8B\u5B9C\uFF0C\u7814\u7A76\u7684\u89D2\u5EA6\u6DB5\u76D6\u4E86\u7ACB\u6CD5\u89C4\u7BA1\u3001\u5BA1\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/08/frc-e5118c66a26065646ac63d953adcec83.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u6CD5\u8FEA\u62C9\u5C24\u7D22\u592B\u003C/p\u003E\n\u003Cp\u003E\uFF08\u5409\u9686\u576120\u65E5\u8BAF\uFF09\u6211\u56FD\u65E5\u6E10\u6210\u4E3A\u6D77\u5916\u6295\u8D44\u8005\u5C24\u5176\u662F\u6570\u636E\u4E2D\u5FC3\u4E1A\u8005\u7684\u70ED\u70B9\uFF0C\u76EE\u524D\uFF0C\u653F\u5E9C\u6B63\u5728\u4E3A\u6B64\u7814\u62DF\u6570\u636E\u4E2D\u5FC3\u8FDB\u9A7B\u6211\u56FD\u6240\u9700\u9075\u5FAA\u7684\u6807\u51C6\u4E0E\u6307\u5357\u3002\u003C/p\u003E\n\u003Cp\u003E\u610F\u6B32\u8D74\u9A6C\u8BBE\u6570\u636E\u4E2D\u5FC3\u7684\u4E1A\u8005\u589E\u591A\uFF0C\u526F\u9996\u76F8\u517C\u80FD\u6E90\u53CA\u6C34\u52A1\u8F6C\u578B\u90E8\u957F\u62FF\u7763\u65AF\u91CC\u6CD5\u8FEA\u62C9\u5C24\u7D22\u592B\u4ECA\u5929\u900F\u9732\uFF0C\u5185\u9601\u5404\u90E8\u4F1A\u4EA6\u6B63\u5728\u63A2\u8BA8\uFF0C\u4F55\u79CD\u6295\u8D44\u7C7B\u578B\u624D\u771F\u6B63\u9002\u5408\u6211\u56FD\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u5168\u6570\u5185\u9601\u90E8\u95E8\u7686\u5728\u63A2\u8BA8\u6B64\u4E8B\uFF0C\u5F53\u4E2D\u5305\u62EC\u56FD\u9645\u8D38\u6613\u53CA\u6295\u8D44\u90E8\u3001\u6211\u638C\u7BA1\u7684\u80FD\u6E90\u53CA\u6C34\u52A1\u8F6C\u578B\u90E8\u3001\u623F\u5C4B\u53CA\u5730\u65B9\u653F\u7B56\u90E8\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u201C\u6709\u5173\u90E8\u95E8\u662F\u4ECE\u5404\u81EA\u7684\u89D2\u5EA6\uFF0C\u63A2\u8BA8\u6D77\u5916\u5BF9\u6211\u56FD\u6295\u8D44\u7684\u4E8B\u5B9C\uFF0C\u7814\u7A76\u7684\u89D2\u5EA6\u6DB5\u76D6\u4E86\u7ACB\u6CD5\u89C4\u7BA1\u3001\u5BA1\u6838\u6279\u51C6\u3001\u7C7B\u578B\u7B5B\u9009\uFF0C\u4ECE\u800C\u51B3\u5B9A\u54EA\u4E00\u7C7B\u6D77\u5916\u6295\u8D44\u80FD\u591F\u8FDB\u9A7B\u6211\u56FD\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u8EAB\u517C\u80FD\u6E90\u53CA\u6C34\u52A1\u8F6C\u578B\u90E8\u957F\u7684\u526F\u63C6\uFF0C\u4ECA\u65E9\u5728\u5409\u9686\u5761\u4F1A\u5C55\u4E2D\u5FC3\uFF08KLCC\uFF09\u4E3B\u6301\u201C2024\u56FD\u9645\u6C38\u7EED\u80FD\u6E90\u5CF0\u4F1A\u201D\uFF08ISES\uFF09\u540E\uFF0C\u51FA\u5E2D\u8BB0\u8005\u4F1A\u56DE\u5E94\u63D0\u95EE\u65F6\uFF0C\u900F\u9732\u8FD9\u4E2A\u6D88\u606F\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF1A\u201C\u5C24\u5176\u662F\u5BF9\u6C34\u6E90\u3001\u80FD\u6E90\uFF0C\u6709\u7740\u9AD8\u6807\u51C6\u9700\u6C42\u7684\u4E1A\u8005\uFF0C\u6211\u4EEC\u4E5F\u5728\u63A2\u8BA8\u89E3\u51B3\u5E9F\u6C34\u4F7F\u7528\u548C\u5904\u7406\u95EE\u9898\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u503C\u5F97\u4E00\u63D0\u7684\u662F\uFF0C\u6570\u636E\u4E2D\u5FC3\u4ECE\u5EFA\u8BBE\u81F3\u8425\u8FD0\u8FC7\u7A0B\uFF0C\u7528\u6C34\u3001\u8017\u80FD\u7686\u76F8\u5F53\u5E9E\u5927\uFF0C\u56E0\u6B64\uFF0C\u5E02\u573A\u4E5F\u66FE\u5F15\u53D1\u6C38\u7EED\u53D1\u5C55\u7684\u7591\u8651\u3002\u003C/p\u003E\n\u003Cp\u003E\u5BF9\u6B64\uFF0C\u6CD5\u8FEA\u62C9\u5C1A\u672A\u660E\u786E\u8868\u793A\u653F\u5E9C\u5C06\u4F5C\u4F55\u4E3E\u63AA\uFF0C\u4EA6\u672A\u9610\u660E\u5C06\u63A8\u51FA\u600E\u6837\u7684\u6C38\u7EED\u6846\u67B6\uFF0C\u4EC5\u79F0\u6B63\u5728\u63A2\u8BA8\u76F8\u5173\u653F\u7B56\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u65B0\u80FD\u6E90\u5F00\u653E\u62DB\u6807\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u53E6\u4E00\u65B9\u9762\uFF0C\u6C38\u7EED\u80FD\u6E90\u53D1\u5C55\u5C40\uFF08SEDA\uFF09\u5C06\u4EE5\u7535\u5B50\u62DB\u6807\u7A0B\u5E8F\uFF0C\u5F00\u653E\u6CBC\u6C14\u3001\u751F\u7269\u8D28\u3001\u5C0F\u578B\u6C34\u529B\u53D1\u7535\u5EFA\u8BBE\uFF0C\u8D2D\u7535\u534F\u8BAE\uFF08Feed-in Tariff\uFF09\u8865\u8D34\u7684\u989D\u5EA6\u9AD8\u8FBE190\u5146\u74E6\u3002\u003C/p\u003E\n\u003Cp\u003E\u6CD5\u8FEA\u62C9\u4ECA\u65E9\u5728\u201C2024\u56FD\u9645\u6C38\u7EED\u80FD\u6E90\u5CF0\u4F1A\u201D\u81F4\u8F9E\u65F6\u79F0\uFF1A\u201C\u8FD9\u662F\u4E3A\u4E86\u4F7F\u6211\u56FD\u7684\u80FD\u6E90\u591A\u6837\u5316\uFF0C\u540C\u65F6\u786E\u4FDD\u80FD\u6E90\u7CFB\u7EDF\u5B89\u5168\u3001\u53EF\u9760\uFF0C\u5E76\u5728\u751F\u7269\u80FD\u6E90\u9886\u57DF\u53D1\u6398\u6F5C\u5728\u673A\u9047\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u6CD5\u8FEA\u62C9\u8865\u5145\uFF0C\u5F53\u5C40\u62DF\u5F00\u5C55\u7814\u7A76\u4E00\u9879\u751F\u7269\u80FD\u6E90\u96C6\u7FA4\uFF0C\u4EE5\u4ECE\u975E\u592A\u9633\u80FD\u7684\u518D\u751F\u80FD\u6E90\u5F00\u53D1\u5E76\u6C72\u53D6\u7535\u529B\uFF0C\u7814\u7A76\u5C06\u5728\u4F01\u4E1A\u518D\u751F\u80FD\u6E90\u4F9B\u5E94\u8BA1\u5212\uFF08CRESS\uFF09\u53D6\u5F97\u8BB8\u53EF\u3002\u003C/p\u003E\n\u003Cp\u003E\u968F\u540E\u7684\u8BB0\u8005\u4F1A\u4E0A\uFF0C\u6CD5\u8FEA\u62C9\u8FDB\u4E00\u6B65\u8BF4\u660E\uFF0C\u4E0A\u8FF0\u914D\u989D\u7684\u62DB\u6807\u6A21\u5F0F\uFF0C\u4E0E\u5927\u578B\u592A\u9633\u80FD\u8BA1\u5212\uFF08LSS\uFF09\u7C7B\u4F3C\uFF0C\u610F\u5728\u4FC3\u8FDB\u975E\u592A\u9633\u80FD\u7684\u518D\u751F\u80FD\u6E90\u90E8\u7F72\u3002\u003C/p\u003E\n\u003Cp\u003E\u76EE\u524D\uFF0C\u6C38\u7EED\u80FD\u6E90\u53D1\u5C55\u5C40\u5DF2\u6682\u505C\u53D1\u653E\u65B0\u578B\u8D2D\u7535\u534F\u8BAE\u914D\u989D\uFF0C\u4E0A\u4E00\u8F6E\u53D1\u653E\u53EF\u8FFD\u6EAF\u81F32023\u5E74\u768436.5\u5146\u74E6\u914D\u989D\uFF0C\u6D89\u53CA21\u4E2A\u6CBC\u6C14\u9879\u76EE\uFF0C\u8FD8\u67091\u4E2A\u751F\u7269\u8D28\u9879\u76EE\u3002\u003C/p\u003E\n\u003Cp\u003E\u8FC7\u5F803\u5E74\uFF0C\u5F53\u5C40\u5DF2\u57283\u7C7B\u65B0\u578B\u518D\u751F\u80FD\u6E90\u9886\u57DF\uFF0C\u53D1\u653E\u603B\u8BA1555\u5146\u74E6\u7684\u8D2D\u7535\u534F\u8BAE\u914D\u989D\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/nT2AgXqq-yiufxuW4h9OMw\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
