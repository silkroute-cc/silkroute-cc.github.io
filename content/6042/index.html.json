  "id": "\u9A6C\u6765\u897F\u4E9A\u96EA\u5DDE\u94C1\u8DEF\u8BA1\u5212\u660E\u5E74\u52A8\u5DE5-\u5357\u90E8\u8DEF\u7EBF\u7387\u5148\u5F00\u8DD1",
  "slug": "\u9A6C\u6765\u897F\u4E9A\u96EA\u5DDE\u94C1\u8DEF\u8BA1\u5212\u660E\u5E74\u52A8\u5DE5-\u5357\u90E8\u8DEF\u7EBF\u7387\u5148\u5F00\u8DD1",
  "canonicalUrlKey": "\u9A6C\u6765\u897F\u4E9A\u96EA\u5DDE\u94C1\u8DEF\u8BA1\u5212\u660E\u5E74\u52A8\u5DE5-\u5357\u90E8\u8DEF\u7EBF\u7387\u5148\u5F00\u8DD1",
  "route": "/6042/",
  "title": "\u9A6C\u6765\u897F\u4E9A\u96EA\u5DDE\u94C1\u8DEF\u8BA1\u5212\u660E\u5E74\u52A8\u5DE5 \u5357\u90E8\u8DEF\u7EBF\u7387\u5148\u5F00\u8DD1",
  "summary": "\uFF08\u53CC\u6EAA\u6BDB\u7CEF14\u65E5\u8BAF\uFF09\u8FDE\u63A5\u96EA\u5170\u83AA\u5DDE\u5357\u90E8\u5730\u533A\u7684\u201C\u6211\u4EEC\u7684\u96EA\u5170\u83AA\u94C1\u8DEF\u8BA1\u5212\u201D\uFF08Our Selangor Rail Line\uFF09\u9884\u8BA1\u6700\u5FEB\u5C06\u4E8E\u660E\u5E74\u542F\u52A8\u9996\u9636\u6BB5\u5DE5\u7A0B\uFF0C\u96EA\u5DDE\u653F\u5E9C\u76EE\u524D\u6B63\u4E0E\u8054\u90A6\u653F\u5E9C\u8FDB\u884C\u6700\u540E\u9636\u6BB5\u78CB\u5546\uFF0C\u6572\u5B9A\u8BA1\u5212\u7EC6\u8282\uFF0C\u4EE5\u63A8\u52A8\u9879\u76EE\u6B63\u5F0F\u843D\u5B9E\u3002 \u96EA\u5170\u83AA\u5DDE\u52A1\u5927\u81E3\u62FF\u7763\u65AF\u91CC\u963F\u7C73\u9C81\u4E01\u900F\u9732\uFF0C\u76EE\u524D\uFF0C\u5DDE\u653F\u5E9C\u4E0E\u4E2D\u592E\u653F\u5E9C\u5DF2\u8FDB\u5165\u6700\u540E\u78CB\u5546\u9636\u6BB5\uFF0C\u53CC\u65B9\u6B63\u6572\u5B9A\u8BA1\u5212\u7EC6\u8282\uFF0C\u4EE5\u63A8\u52A8\u9879\u76EE\u843D\u5B9E\u3002 \u4ED6\u6307\u51FA\uFF0C\u5DDE\u653F\u5E9C\u51B3\u5B9A\u7387\u5148\u5728\u96EA\u5DDE\u5357\u90E8\u5C55\u5F00\u9996\u9636\u6BB5\u8DEF\u7EBF\uFF0C\u4E3B\u8981\u662F\u56E0\u4E3A\u5F53\u5730\u5BF9\u516C\u5171\u4EA4\u901A\u670D\u52A1\u7684\u9700\u6C42\u8F83\u4E3A\u8FEB\u5207\u3002",
  "body": "\u003Cp\u003E\uFF08\u53CC\u6EAA\u6BDB\u7CEF14\u65E5\u8BAF\uFF09\u8FDE\u63A5\u96EA\u5170\u83AA\u5DDE\u5357\u90E8\u5730\u533A\u7684\u201C\u6211\u4EEC\u7684\u96EA\u5170\u83AA\u94C1\u8DEF\u8BA1\u5212\u201D\uFF08Our Selangor Rail Line\uFF09\u9884\u8BA1\u6700\u5FEB\u5C06\u4E8E\u660E\u5E74\u542F\u52A8\u9996\u9636\u6BB5\u5DE5\u7A0B\uFF0C\u96EA\u5DDE\u653F\u5E9C\u76EE\u524D\u6B63\u4E0E\u8054\u90A6\u653F\u5E9C\u8FDB\u884C\u6700\u540E\u9636\u6BB5\u78CB\u5546\uFF0C\u6572\u5B9A\u8BA1\u5212\u7EC6\u8282\uFF0C\u4EE5\u63A8\u52A8\u9879\u76EE\u6B63\u5F0F\u843D\u5B9E\u3002\u003C/p\u003E\n\u003Cp\u003E\u96EA\u5170\u83AA\u5DDE\u52A1\u5927\u81E3\u62FF\u7763\u65AF\u91CC\u963F\u7C73\u9C81\u4E01\u900F\u9732\uFF0C\u76EE\u524D\uFF0C\u5DDE\u653F\u5E9C\u4E0E\u4E2D\u592E\u653F\u5E9C\u5DF2\u8FDB\u5165\u6700\u540E\u78CB\u5546\u9636\u6BB5\uFF0C\u53CC\u65B9\u6B63\u6572\u5B9A\u8BA1\u5212\u7EC6\u8282\uFF0C\u4EE5\u63A8\u52A8\u9879\u76EE\u843D\u5B9E\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6307\u51FA\uFF0C\u5DDE\u653F\u5E9C\u51B3\u5B9A\u7387\u5148\u5728\u96EA\u5DDE\u5357\u90E8\u5C55\u5F00\u9996\u9636\u6BB5\u8DEF\u7EBF\uFF0C\u4E3B\u8981\u662F\u56E0\u4E3A\u5F53\u5730\u5BF9\u516C\u5171\u4EA4\u901A\u670D\u52A1\u7684\u9700\u6C42\u8F83\u4E3A\u8FEB\u5207\u3002\u003C/p\u003E\n\u003Cp\u003E\u6839\u636E\u201C\u96EA\u5170\u83AA\u5A92\u4F53\u201D\u62A5\u9053\uFF0C\u963F\u7C73\u9C81\u4E01\u4ECA\u65E5\u51FA\u5E2D\u4E07\u6320\u65AF\u91CC\u7164\u78B3\u57CE\uFF08Bandar Seri Coalfields\uFF09\u5764\u6210\u4E2D\u5B66\u4E8C\u6821\u65B0\u6821\u820D\u52A8\u571F\u4EEA\u5F0F\u540E\uFF0C\u53D7\u5A92\u4F53\u8BE2\u95EE\u65F6\u8FD9\u6837\u6307\u51FA\uFF1B\u4ED6\u76F8\u4FE1\u5728\u8054\u90A6\u653F\u5E9C\u914D\u5408\u4E0B\uFF0C\u660E\u5E74\u53EF\u7387\u5148\u542F\u52A8\u5176\u4E2D\u4E00\u6761\u8DEF\u7EBF\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/mmbiz_png/LRoqHEicY0htpUqaXTLueXyrGT9zpYKJfJeLGlQS44CujvYNYH86JEohytX3oElica7DzPtNGqm0oeMHm25bezctLl67puAChoAlatasR0Iy8/640?wx_fmt=png\u0026amp;from=appmsg\u0022 alt=\u0022\u0022 /\u003E\n\u003Ch3\u003E\u201C\u6211\u4EEC\u4F1A\u4ECE\u96EA\u5DDE\u5357\u90E8\u5F00\u59CB\uFF0C\u56E0\u4E3A\u5F53\u5730\u5BF9\u516C\u5171\u4EA4\u901A\u7684\u9700\u6C42\u8F83\u9AD8\u3002\u201D\u003C/h3\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u8FD9\u9879\u94C1\u8DEF\u8BA1\u5212\u4E0D\u4EC5\u662F\u5DDE\u5185\u8F68\u9053\u4EA4\u901A\u53D1\u5C55\u7684\u91CD\u70B9\u5DE5\u7A0B\uFF0C\u4E5F\u5C06\u6210\u4E3A\u672A\u6765\u957F\u671F\u94C1\u8DEF\u7F51\u7EDC\u89C4\u5212\u7684\u91CD\u8981\u84DD\u56FE\u3002\u003C/p\u003E\n\u003Ch3\u003E\u201C\u4E0D\u8FC7\uFF0C\u7531\u4E8E\u94C1\u8DEF\u5EFA\u8BBE\u6D89\u53CA\u5E9E\u5927\u8D44\u91D1\uFF0C\u6700\u7EC8\u4ECD\u9700\u7531\u653F\u5E9C\u627F\u62C5\uFF0C\u56E0\u6B64\u5FC5\u987B\u6301\u7EED\u4E0E\u8054\u90A6\u653F\u5E9C\u534F\u8C03\uFF0C\u89C4\u5212\u4E0B\u4E00\u9636\u6BB5\u53D1\u5C55\uFF0C\u9010\u6B65\u5B9E\u73B0\u94C1\u8DEF\u7F51\u7EDC\u7531\u96EA\u5DDE\u5357\u90E8\u5EF6\u4F38\u81F3\u5317\u90E8\u7684\u76EE\u6807\u3002\u201D\u003C/h3\u003E\n\u003Cp\u003E\u4ED6\u900F\u9732\uFF0C\u968F\u7740\u5DDE\u653F\u5E9C\u4E0E\u8054\u90A6\u653F\u5E9C\u5373\u5C06\u5B8C\u6210\u6700\u540E\u9636\u6BB5\u7684\u8BA8\u8BBA\uFF0C\u9884\u6599\u8BE5\u8BA1\u5212\u660E\u5E74\u5C06\u53D6\u5F97\u8FDB\u4E00\u6B65\u8FDB\u5C55\uFF0C\u5E76\u7387\u5148\u5C55\u5F00\u90E8\u5206\u5EFA\u8BBE\u5DE5\u7A0B\u3002\u003C/p\u003E\n\u003Cp\u003E\u9488\u5BF9\u94C1\u8DEF\u8DEF\u7EBF\u89C4\u5212\uFF0C\u4ED6\u8868\u793A\uFF0C\u6574\u4F53\u8DEF\u7EBF\u5DF2\u5927\u81F4\u786E\u5B9A\uFF0C\u60DF\u968F\u7740\u5DE5\u7A0B\u63A8\u8FDB\uFF0C\u5DDE\u653F\u5E9C\u4ECD\u4F1A\u4F9D\u636E\u5B9E\u9645\u9700\u6C42\uFF0C\u6301\u7EED\u68C0\u8BA8\u53CA\u4F18\u5316\u8DEF\u7EBF\u8BBE\u8BA1\u3002\u003C/p\u003E\n\u003Ch3\u003E\u201C\u8DEF\u7EBF\u89C4\u5212\u5DF2\u7ECF\u6572\u5B9A\uFF0C\u5F85\u5DE5\u7A0B\u5C55\u5F00\u540E\uFF0C\u6211\u4EEC\u4F1A\u6839\u636E\u5B9E\u9645\u60C5\u51B5\uFF0C\u63D0\u51FA\u65B0\u7684\u5EFA\u8BAE\uFF0C\u5E76\u6301\u7EED\u4F18\u5316\u76F8\u5173\u65B9\u6848\u3002\u201D\u003C/h3\u003E\n\u003Cp\u003E\u4ED6\u8865\u5145\uFF0C\u622A\u81F3\u76EE\u524D\uFF0C\u89C4\u5212\u4E2D\u7684\u5927\u90E8\u5206\u8DEF\u7EBF\u5747\u6D89\u53CA\u653F\u5E9C\u571F\u5730\uFF0C\u56E0\u6B64\u76F8\u4FE1\u8BA1\u5212\u5728\u63A8\u8FDB\u8FC7\u7A0B\u4E2D\u4E0D\u4F1A\u9762\u5BF9\u592A\u5927\u7684\u5F81\u5730\u969C\u788D\uFF0C\u6709\u52A9\u4E8E\u5DE5\u7A0B\u987A\u5229\u843D\u5B9E\u3002\u003C/p\u003E\n",
