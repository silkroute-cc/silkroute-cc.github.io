  "slug": "\u5927\u5BB6\u90FD\u53BB\u54EA\u4E86\u6211\u597D\u50CF\u8BEF\u95EF\u4E86\u96EA\u5170\u83AA\u79D8\u5883",
  "canonicalUrlKey": "\u5927\u5BB6\u90FD\u53BB\u54EA\u4E86\u6211\u597D\u50CF\u8BEF\u95EF\u4E86\u96EA\u5170\u83AA\u79D8\u5883",
  "route": "/6160/",
  "title": "\u5927\u5BB6\u90FD\u53BB\u54EA\u4E86\uFF1F\u6211\u597D\u50CF\u8BEF\u95EF\u4E86\u96EA\u5170\u83AA\u79D8\u5883\u3002\u3002",
  "summary": "\u96EA\u5170\u83AA\u9E45\u9EA6-\u4E4C\u9C81\u51B7\u5CB3\u5730\u8D28\u516C\u56ED\uFF08GHL Geopark\uFF09\u5C06\u4E8E2026\u5E7410\u670826\u65E5\u81F329\u65E5\u8FCE\u6765\u56FD\u5BB6\u7EA7\u91CD\u65B0\u8BC4\u4F30\u3002\u8BE5\u5E16\u4EE5\u201C\u8BEF\u95EF\u79D8\u5883\u201D\u7684\u63A2\u9669\u53E3\u543B\u5C55\u5F00\uFF1A\u672C\u4EE5\u4E3A\u53EA\u662F\u8F7B\u677E\u7684\u5468\u672B\u90CA\u6E38\uFF0C\u5374\u8BEF\u6253\u8BEF\u649E\u7A7F\u8FC7\u53E4\u8001\u6D1E\u7A74\u3001\u8D70\u5165\u8302\u5BC6\u68EE\u6797\uFF0C\u8033\u8FB9\u4F20\u6765\u7011\u5E03\u8F70\u9E23\uFF0C\u624B\u91CC\u8FD8\u63E1\u7740\u4E00\u5F20\u795E\u79D8\u5730\u56FE\u3002\u5E16\u6587\u4EE5\u201C\u5012\u65705\u5929\u201D\u5012\u6570\u8BA1\u65F6\uFF0C\u9080\u8BF7\u8BFB\u8005\u8DDF\u968F\u811A\u6B65\u5F00\u542F\u5BFB\u5B9D\u4E4B\u65C5\uFF0C\u4E00\u8D77\u770B\u770B\u8FD9\u7247\u571F\u5730\u7A76\u7ADF\u85CF\u7740\u591A\u5C11\u81EA\u7136\u5947\u89C2\u3002",
  "body": "\u003Cp\u003E\u0026#127811;\u672C\u4EE5\u4E3A\u53EA\u662F\u8F7B\u677E\u7684\u5468\u672B\u90CA\u6E38\u003C/p\u003E\n\u003Cp\u003E\u4E00\u8F6C\u773C\uFF0C\u670B\u53CB\u4EEC\u5168\u90FD\u4E0D\u89C1\u4E86\u0026#128561;\u003C/p\u003E\n\u003Cp\u003E\u8BEF\u6253\u8BEF\u649E\u7A7F\u8FC7\u53E4\u8001\u7684\u6D1E\u7A74\u3001\u8D70\u5165\u8302\u5BC6\u7684\u68EE\u6797\u003C/p\u003E\n\u003Cp\u003E\u8033\u8FB9\u8FD8\u9690\u7EA6\u4F20\u6765\u8F70\u9E23\u7684\u7011\u5E03\u58F0\u2026\u2026\u003C/p\u003E\n\u003Cp\u003E\u624B\u91CC\u7684\u8FD9\u5F20\u795E\u79D8\u5730\u56FE\u0026#128506;\uFE0F\u003C/p\u003E\n\u003Cp\u003E\u7A76\u7ADF\u85CF\u7740\u4EC0\u4E48\u4E0D\u4E3A\u4EBA\u77E5\u7684\u79D8\u5BC6\uFF1F\u003C/p\u003E\n\u003Cp\u003E\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u003C/p\u003E\n\u003Cp\u003E\u0026#128226;\u5012\u65705\u5929\uFF01\uFF01\u003C/p\u003E\n\u003Cp\u003E\u0026#128197; 2026\u5E7410\u670826\u65E5\uFF0D29\u65E5\u003C/p\u003E\n\u003Cp\u003E\u0026#127807;\u96EA\u5170\u83AA\u9E45\u9EA6-\u4E4C\u9C81\u51B7\u5CB3\u5730\u8D28\u516C\u56ED\uFF08GHL Geopark\uFF09\u003C/p\u003E\n\u003Cp\u003E\u0026#128154;\u5373\u5C06\u8FCE\u6765\u56FD\u5BB6\u7EA7\u91CD\u65B0\u8BC4\u4F30\uFF01\u003C/p\u003E\n\u003Cp\u003E\u8DDF\u7740\u6211\u4EEC\u7684\u811A\u6B65\uFF0C\u4E00\u8D77\u5F00\u542F\u5BFB\u5B9D\u4E4B\u65C5\uFF01\u003C/p\u003E\n\u003Cp\u003E\u770B\u770B\u8FD9\u7247\u571F\u5730\u7A76\u7ADF\u85CF\u7740\u591A\u5C11\u81EA\u7136\u5947\u89C2\uFF01\u003C/p\u003E\n",
