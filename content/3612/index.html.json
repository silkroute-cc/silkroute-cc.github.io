  "id": "%e5%94%90%e9%94%90%e5%85%ac%e4%bd%bf%e8%ae%bf%e9%97%ae%e6%b2%99%e5%b7%b4%e5%b7%9e%e3%80%81%e6%b2%99%e6%8d%9e%e8%b6%8a%e5%b7%9e",
  "slug": "%e5%94%90%e9%94%90%e5%85%ac%e4%bd%bf%e8%ae%bf%e9%97%ae%e6%b2%99%e5%b7%b4%e5%b7%9e%e3%80%81%e6%b2%99%e6%8d%9e%e8%b6%8a%e5%b7%9e",
  "canonicalUrlKey": "%e5%94%90%e9%94%90%e5%85%ac%e4%bd%bf%e8%ae%bf%e9%97%ae%e6%b2%99%e5%b7%b4%e5%b7%9e%e3%80%81%e6%b2%99%e6%8d%9e%e8%b6%8a%e5%b7%9e",
  "route": "/3612/",
  "title": "\u5510\u9510\u516C\u4F7F\u8BBF\u95EE\u6C99\u5DF4\u5DDE\u3001\u6C99\u635E\u8D8A\u5DDE",
  "summary": "3\u6708 19\u65E5\u81F323\u65E5\uFF0C\u5510\u9510\u516C\u4F7F\u4E00\u884C\u8BBF\u95EE\u6C99\u5DF4\u5DDE\u3001\u6C99\u635E\u8D8A\u5DDE\uFF0C\u4F1A\u89C1\u6C99\u5DF4\u5DDE\u526F\u9996\u5E2D\u90E8\u957F\u6770\u83F2\u91CC\u3001\u6C99\u635E\u8D8A\u5DDE\u526F\u603B\u7406\u6C88\u6842\u8D24\uFF0C\u5728\u53E4\u664B\u51FA\u5E2D\u4F0A\u65AF\u5170\u9769\u65B0\u7EC4\u7EC7\uFF08IKRAM\uFF09\u201C\u658B\u6708\u7948\u798F\u201D\u516C\u76CA\u6D3B\u52A8\u66A8\u7269\u8D44\u6350\u8D60\u4EEA\u5F0F\uFF0C\u540C\u4E24\u5DDE\u534E\u793E\u3001\u519B\u8B66\u3001\u65C5\u6E38\u4E1A\u3001\u5A92\u4F53\u4EE3\u8868\u4EA4\u6D41\uFF0C\u5B9E\u5730\u8C03\u7814\u4E2D\u8D44\u673A\u6784\u7B49\u3002\u9A7B\u54E5\u6253\u57FA\u7EB3\u5DF4\u5362\u603B\u9886\u4E8B\u9EC4\u4E16\u82B3\u3001\u9A7B\u53E4\u664B\u603B\u9886\u4E8B\u90A2\u4F1F\u5E73\u5206\u522B\u53C2\u52A0\u3002 \u4F1A\u89C1\u6C99\u5DF4\u5DDE\u526F\u9996\u5E2D\u90E8\u957F\u6770\u83F2\u91CC\u65F6\uFF0C\u5510\u516C\u4F7F\u8868\u793A\uFF0C\u65F6\u4EFB\u56FD\u52A1\u59D4\u5458\u517C\u5916\u4EA4\u90E8\u957F\u738B\u6BC5\u4E8E\u53BB\u5E746\u6708\u7ECF\u505C\u6C99\u5DF4\u5DDE\uFF0C\u90E8\u957F\u9601\u4E0B\u548C\u9A6C\u65B9\u4E3A\u6709\u5173\u63A5\u5F85\u505A\u4E86\u5927\u91CF\u5DE5\u4F5C\uFF0C\u6211\u8C28\u4EE3\u8868\u4E2D\u56FD\u4F7F\u9986\u5411\u4F60\u8868\u793A\u8BDA\u631A\u8C22\u610F\u3002\u4E2D\u9A6C\u4E24\u56FD\u662F\u7F14\u7ED3\u5343\u5E74\u2026",
  "body": "\u003Cp\u003E3\u670819\u65E5\u81F323\u65E5\uFF0C\u5510\u9510\u516C\u4F7F\u4E00\u884C\u8BBF\u95EE\u6C99\u5DF4\u5DDE\u3001\u6C99\u635E\u8D8A\u5DDE\uFF0C\u4F1A\u89C1\u6C99\u5DF4\u5DDE\u526F\u9996\u5E2D\u90E8\u957F\u6770\u83F2\u91CC\u3001\u6C99\u635E\u8D8A\u5DDE\u526F\u603B\u7406\u6C88\u6842\u8D24\uFF0C\u5728\u53E4\u664B\u51FA\u5E2D\u4F0A\u65AF\u5170\u9769\u65B0\u7EC4\u7EC7\uFF08IKRAM\uFF09\u201C\u658B\u6708\u7948\u798F\u201D\u516C\u76CA\u6D3B\u52A8\u66A8\u7269\u8D44\u6350\u8D60\u4EEA\u5F0F\uFF0C\u540C\u4E24\u5DDE\u534E\u793E\u3001\u519B\u8B66\u3001\u65C5\u6E38\u4E1A\u3001\u5A92\u4F53\u4EE3\u8868\u4EA4\u6D41\uFF0C\u5B9E\u5730\u8C03\u7814\u4E2D\u8D44\u673A\u6784\u7B49\u3002\u9A7B\u54E5\u6253\u57FA\u7EB3\u5DF4\u5362\u603B\u9886\u4E8B\u9EC4\u4E16\u82B3\u3001\u9A7B\u53E4\u664B\u603B\u9886\u4E8B\u90A2\u4F1F\u5E73\u5206\u522B\u53C2\u52A0\u3002\u003C/p\u003E\n\u003Cp\u003E\u4F1A\u89C1\u6C99\u5DF4\u5DDE\u526F\u9996\u5E2D\u90E8\u957F\u6770\u83F2\u91CC\u65F6\uFF0C\u5510\u516C\u4F7F\u8868\u793A\uFF0C\u65F6\u4EFB\u56FD\u52A1\u59D4\u5458\u517C\u5916\u4EA4\u90E8\u957F\u738B\u6BC5\u4E8E\u53BB\u5E746\u6708\u7ECF\u505C\u6C99\u5DF4\u5DDE\uFF0C\u90E8\u957F\u9601\u4E0B\u548C\u9A6C\u65B9\u4E3A\u6709\u5173\u63A5\u5F85\u505A\u4E86\u5927\u91CF\u5DE5\u4F5C\uFF0C\u6211\u8C28\u4EE3\u8868\u4E2D\u56FD\u4F7F\u9986\u5411\u4F60\u8868\u793A\u8BDA\u631A\u8C22\u610F\u3002\u4E2D\u9A6C\u4E24\u56FD\u662F\u7F14\u7ED3\u5343\u5E74\u53CB\u8C0A\u7684\u597D\u90BB\u5C45\uFF0C\u4E5F\u662F\u5408\u4F5C\u5171\u8D62\u7684\u597D\u4F19\u4F34\uFF0C\u6C99\u5DF4\u5DDE\u662F\u6D77\u4E0A\u4E1D\u7EF8\u4E4B\u8DEF\u91CD\u8981\u8282\u70B9\uFF0C\u5728\u5F00\u5C55\u5BF9\u534E\u52A1\u5B9E\u5408\u4F5C\u65B9\u9762\u6F5C\u529B\u5DE8\u5927\uFF0C\u4E2D\u56FD\u9A7B\u9A6C\u4F7F\u9986\u53CA\u603B\u9886\u9986\u613F\u5145\u5206\u53D1\u6325\u6865\u6881\u7EBD\u5E26\u4F5C\u7528\uFF0C\u8FDB\u4E00\u6B65\u63A8\u52A8\u4E24\u56FD\u3001\u4E24\u5730\u4E92\u5229\u5408\u4F5C\u4E0E\u6C11\u5FC3\u76F8\u901A\u3002\u9A6C\u65B9\u8868\u793A\uFF0C\u4E2D\u56FD\u662F\u9A6C\u6765\u897F\u4E9A\u7684\u8FD1\u90BB\uFF0C\u5404\u9886\u57DF\u53D1\u5C55\u53D6\u5F97\u4E3E\u4E16\u77A9\u76EE\u6210\u5C31\uFF0C\u6709\u8BB8\u591A\u5148\u8FDB\u7ECF\u9A8C\u503C\u5F97\u9A6C\u65B9\u5B66\u4E60\u501F\u9274\u3002\u6C99\u5DF4\u5DDE\u5E0C\u671B\u4E2D\u56FD\u52A0\u5927\u5BF9\u6C99\u6295\u8D44\uFF0C\u52A0\u5F3A\u5728\u7CAE\u98DF\u3001\u755C\u7267\u4E1A\u3001\u6E14\u4E1A\u3001\u70ED\u5E26\u6C34\u679C\u7B49\u9886\u57DF\u5408\u4F5C\uFF0C\u6B22\u8FCE\u66F4\u591A\u4E2D\u56FD\u6E38\u5BA2\u6765\u6C99\u65C5\u6E38\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/03/frc-768534d812b76999014304461d4c0b82.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u4F1A\u89C1\u6C99\u635E\u8D8A\u5DDE\u526F\u603B\u7406\u6C88\u6842\u8D24\u65F6\uFF0C\u5510\u516C\u4F7F\u8868\u793A\uFF0C\u4EE4\u5C0A\u6C88\u5E86\u9E3F\u5148\u751F\u66FE\u4E8E1974\u5E74\u968F\u6566\u62C9\u8428\u603B\u7406\u8BBF\u534E\uFF0C\u662F\u4E2D\u9A6C\u5EFA\u4EA4\u7684\u7834\u51B0\u8005\u4E4B\u4E00\u3002\u4F60\u672C\u4EBA\u66FE\u4E8E2014\u5E74\u8BBF\u534E\uFF0C\u53C2\u52A0\u4E2D\u9A6C\u5EFA\u4EA440\u5468\u5E74\u7CFB\u5217\u6D3B\u52A8\u3002\u6211\u8C28\u4EE3\u8868\u4F7F\u9986\u5411\u4F60\u4EEC\u7236\u5B50\u81F4\u529B\u4E8E\u63A8\u52A8\u4E2D\u9A6C\u53CB\u597D\u4EA4\u6D41\u5408\u4F5C\u8868\u793A\u656C\u610F\u3002\u4ECA\u5E74\u662F\u4E2D\u9A6C\u5EFA\u7ACB\u5168\u9762\u6218\u7565\u4F19\u4F34\u5173\u7CFB10\u5468\u5E74\uFF0C\u660E\u5E74\u662F\u4E24\u56FD\u5EFA\u4EA450\u5468\u5E74\u3002\u4E2D\u65B9\u613F\u540C\u9A6C\u65B9\u6293\u4F4F\u5386\u53F2\u5951\u673A\uFF0C\u4E0D\u65AD\u6DF1\u5316\u5404\u5C42\u7EA7\u4EA4\u5F80\uFF0C\u62D3\u5C55\u5404\u9886\u57DF\u52A1\u5B9E\u5408\u4F5C\uFF0C\u63A8\u52A8\u4E24\u56FD\u5173\u7CFB\u53D6\u5F97\u65B0\u7684\u66F4\u5927\u53D1\u5C55\u3002\u9A6C\u65B9\u8868\u793A\uFF0C\u6C99\u635E\u8D8A\u5DDE\u8FD1\u5E74\u6765\u653F\u6CBB\u7A33\u5B9A\uFF0C\u6B63\u52AA\u529B\u63A8\u8FDB\u4EA7\u4E1A\u8F6C\u578B\u5347\u7EA7\uFF0C\u81F4\u529B\u4E8E\u53D1\u5C55\u73AF\u4FDD\u3001\u7EFF\u8272\u7ECF\u6D4E\uFF0C\u5E0C\u540C\u4E2D\u65B9\u52A0\u5F3A\u4EA4\u6D41\u5BF9\u63A5\uFF0C\u62D3\u5C55\u5404\u9886\u57DF\u4E92\u5229\u5408\u4F5C\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/03/frc-5dbd64c63dc8d35ddcf462447c15eb29.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5510\u516C\u4F7F\u5728\u53E4\u664B\u51FA\u5E2D\u201C\u658B\u6708\u7948\u798F\u201D\u516C\u76CA\u6D3B\u52A8\u66A8\u7269\u8D44\u6350\u8D60\u4EEA\u5F0F\uFF0C\u5411\u5F53\u5730\u6751\u6C11\u53D1\u653E\u658B\u6708\u751F\u6D3B\u5FC5\u9700\u7528\u54C1\u3002\u5510\u516C\u4F7F\u795D\u7A46\u65AF\u6797\u670B\u53CB\u658B\u6708\u5E78\u798F\u5B89\u5EB7\uFF0C\u5E76\u8868\u793A\u6276\u5371\u6D4E\u56F0\u3001\u4E50\u5584\u597D\u65BD\u662F\u4E2D\u534E\u6587\u5316\u548C\u4F0A\u65AF\u5170\u6587\u5316\u7684\u5171\u540C\u8FFD\u6C42\uFF0C\u4E2D\u56FD\u9A7B\u9A6C\u4F7F\u9986\u4E00\u76F4\u81F4\u529B\u4E8E\u540C\u9A6C\u653F\u5E9C\u548C\u6C11\u95F4\u7EC4\u7EC7\u5F00\u5C55\u5404\u7C7B\u6148\u5584\u516C\u76CA\u6D3B\u52A8\uFF0C\u5411\u9A6C\u4EBA\u6C11\u4F20\u9012\u53CB\u597D\u60C5\u8C0A\u3002\u6B63\u5982\u9A6C\u6765\u8C1A\u8BED\u201Cbagai aur dengan tebing\u201D\uFF0C\u4E2D\u9A6C\u4E24\u56FD\u4EBA\u6C11\u59CB\u7EC8\u662F\u771F\u6B63\u7684\u597D\u670B\u53CB\u3001\u597D\u5144\u5F1F\uFF0C\u6211\u4EEC\u8981\u7EE7\u7EED\u643A\u624B\u5E76\u80A9\uFF0C\u4E3A\u4E2D\u9A6C\u53CB\u597D\u7684\u5171\u540C\u4E8B\u4E1A\u8D21\u732E\u529B\u91CF\u3002IKRAM\u6C99\u635E\u8D8A\u5DDE\u4E3B\u5E2D\u6C99\u8FEA\u4E9A\u548CIKRAM\u57FA\u91D1\u4F1A\u9996\u5E2D\u6267\u884C\u5B98\u5361\u8428\u5C3C\u8868\u793A\u613F\u7EE7\u7EED\u540C\u4E2D\u56FD\u4F7F\u9986\u52A0\u5F3A\u5408\u4F5C\uFF0C\u4E3A\u6709\u9700\u8981\u7684\u6C11\u4F17\u63D0\u4F9B\u5E2E\u52A9\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/03/frc-34a2ed755f7d6626e4ebc856449e425b.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5510\u516C\u4F7F\u540C\u4E24\u5DDE\u534E\u793E\u53CA\u534E\u4EBA\u653F\u8981\u4EE3\u8868\u4EA4\u6D41\uFF0C\u9AD8\u5EA6\u8D5E\u8D4F\u5E7F\u5927\u534E\u793E\u4E3A\u5F53\u5730\u7ECF\u6D4E\u7E41\u8363\u3001\u793E\u4F1A\u8FDB\u6B65\u3001\u79CD\u65CF\u548C\u7766\u4F5C\u51FA\u7684\u91CD\u8981\u8D21\u732E\uFF0C\u9F13\u52B1\u4ED6\u4EEC\u7EE7\u7EED\u53D1\u6325\u597D\u6865\u6881\u7EBD\u5E26\u4F5C\u7528\uFF0C\u4E3A\u4F20\u627F\u4E2D\u534E\u6587\u5316\u3001\u53D1\u5C55\u534E\u6587\u6559\u80B2\u3001\u63A8\u52A8\u4E2D\u9A6C\u5173\u7CFB\u5728\u65B0\u65F6\u4EE3\u53D6\u5F97\u66F4\u5927\u53D1\u5C55\u8D21\u732E\u667A\u6167\u548C\u529B\u91CF\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/03/frc-d429c3eec1cc2891709538d924c25335.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/03/frc-6d0f6919e46ff9c6684a71c972c19715.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5510\u516C\u4F7F\u4F1A\u89C1\u6C99\u5DF4\u4E1C\u90E8\u5B89\u5168\u6307\u6325\u533A\u8D1F\u8D23\u4EBA\u53CA\u8B66\u65B9\u3001\u65C5\u6E38\u4E1A\u4EE3\u8868\uFF0C\u8003\u5BDF\u6C99\u5DF4\u6D77\u8B66\u3001\u6D77\u6E2F\u5C40\u3001\u6D88\u9632\u5C40\u3001\u6E38\u5BA2\u7801\u5934\u7B49\u90E8\u95E8\uFF0C\u5171\u540C\u8C03\u7814\u5F53\u5730\u65C5\u6E38\u8BBE\u65BD\u5EFA\u8BBE\u548C\u5B89\u5168\u4FDD\u969C\u60C5\u51B5\u3002\u9A6C\u65B9\u8868\u793A\u6B22\u8FCE\u66F4\u591A\u4E2D\u56FD\u6E38\u5BA2\u6765\u6C99\u65C5\u6E38\uFF0C\u5C06\u505A\u597D\u76F8\u5E94\u5B89\u5168\u4FDD\u969C\u5DE5\u4F5C\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/03/frc-d4344e7e3df40569622df65235021412.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/03/frc-830fda03a3cdc32da57931fb45815579.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u8BBF\u95EE\u671F\u95F4\uFF0C\u5510\u516C\u4F7F\u8FD8\u8D74\u54E5\u6253\u57FA\u7EB3\u5DF4\u5362\u5DE5\u4E1A\u4EA7\u4E1A\u56ED\u5B9E\u5730\u8C03\u7814\u65D7\u6EE8\u5149\u4F0F\u9879\u76EE\u65BD\u5DE5\u73B0\u573A\uFF0C\u8003\u5BDF\u53E4\u664B\u4E2D\u56FD\u7B7E\u8BC1\u4E2D\u5FC3\u3001\u4E2D\u56FD\u94F6\u884C\u53E4\u664B\u5206\u884C\uFF0C\u53C2\u8BBF\u8BD7\u534E\u65E5\u62A5\u793E\u7B49\u673A\u6784\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/03/frc-bae7e6d4766f5af04f84bc8f9ac80dff.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/03/frc-35dc88d5b331797738d1db0e7ebc51d8.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/03/frc-887b28aacf4763eef6ff49d974d3974f.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/li65y0f1O2IttMnaZs8M9w\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
