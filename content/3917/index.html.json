{
  "id": "%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e7%8e%af%e5%a2%83%e9%83%a8%e9%95%bf-%e5%87%ba%e5%8f%a3%e5%86%8d%e7%94%9f%e8%83%bd%e6%ba%90-%e5%a4%a7%e9%a9%ac%e5%b0%86%e8%ae%be%e8%83%bd%e6%ba%90%e4%ba%a4",
  "slug": "%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e7%8e%af%e5%a2%83%e9%83%a8%e9%95%bf-%e5%87%ba%e5%8f%a3%e5%86%8d%e7%94%9f%e8%83%bd%e6%ba%90-%e5%a4%a7%e9%a9%ac%e5%b0%86%e8%ae%be%e8%83%bd%e6%ba%90%e4%ba%a4",
  "canonicalUrlKey": "%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e7%8e%af%e5%a2%83%e9%83%a8%e9%95%bf-%e5%87%ba%e5%8f%a3%e5%86%8d%e7%94%9f%e8%83%bd%e6%ba%90-%e5%a4%a7%e9%a9%ac%e5%b0%86%e8%ae%be%e8%83%bd%e6%ba%90%e4%ba%a4",
  "route": "/3917/",
  "title": "\u9A6C\u6765\u897F\u4E9A\u73AF\u5883\u90E8\u957F: \u51FA\u53E3\u518D\u751F\u80FD\u6E90 \u5927\u9A6C\u5C06\u8BBE\u80FD\u6E90\u4EA4\u6613\u6240",
  "summary": "\uFF08\u5409\u9686\u576120\u65E5\u8BAF\uFF09\u5929\u7136\u8D44\u6E90\u3001\u73AF\u5883\u548C\u6C14\u5019\u53D8\u5316\u90E8\u957F\u8042\u7EB3\u5179\u7C73\u8BF4\uFF0C\u5927\u9A6C\u5C06\u542F\u52A8\u80FD\u6E90\u4EA4\u6613\u6240\uFF0C\u4EE5\u4FBF\u51FA\u53E3\u53EF\u518D\u751F\u80FD\u6E90\u5230\u90BB\u56FD\u3002 \u4ED6\u8BF4\uFF0C\u80FD\u6E90\u59D4\u5458\u4F1A\u6B63\u8D77\u6709\u5173\u4EA4\u6613\u6240\u7684\u7EC6\u8282\uFF0C\u5E76\u5C06\u4E8E\u4ECA\u5E74\u5185\u516C\u5E03\u3002 \u201C\u6211\u4EEC\u5C06\u63A2\u8BA8\u53EF\u7528\u7684\u6A21\u5F0F\uFF0C\u9996\u5148\u987B\u5148\u786E\u4FDD\u53EF\u518D\u751F\u80FD\u6E90\u5728\u56FD\u5185\u4F9B\u5E94\u5145\u8DB3\uFF0C\u5176\u6B21\u662F\u786E\u4FDD\u6D77\u5916\u9500\u552E\u83B7\u5F97\u6700\u4F73\u4EF7\u503C\u540E\u5141\u8BB8\u518D\u6295\u8D44\uFF0C\u4EE5\u63A8\u52A8\u6211\u56FD\u53EF\u518D\u751F\u80FD\u6E90\u3002\u201D \u8042\u7EB3\u5179\u7C73\u4ECA\u65E5\u5728\u5927\u9A6C\u5DE5\u4E1A\u53D1\u5C55\u91D1\u878D\u673A\u6784\uFF08MIDF\uFF09\u9898\u4E3A\uFF1A\u201C\u56FD\u5BB6\u80FD\u6E90\u8F6C\u578B\u8DEF\u7EBF\u56FE\uFF1A\u80FD\u6E90\u8F6C\u578B\u5BFC\u822A\uFF0C\u5BF9\u4E8E\u5927\u9A6C\u4E0B\u4E00\u4E2A\u662F\u4EC0\u4E48\uFF1F\u201D\u7684\u5706\u684C\u4F1A\u8BAE\u4E0A\u8BF4\uFF0C\u4E3A\u4E86\u652F\u6301\u56FD\u5BB6\u7684\u80FD\u6E90\u8F6C\u578B\uFF0C\u5927\u9A6C\u5E94\u8003\u8651\u5176\u4ED6\u80FD\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/07/frc-00728ad69d84f48c43533e50e0f271d1.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\uFF08\u5409\u9686\u576120\u65E5\u8BAF\uFF09\u5929\u7136\u8D44\u6E90\u3001\u73AF\u5883\u548C\u6C14\u5019\u53D8\u5316\u90E8\u957F\u8042\u7EB3\u5179\u7C73\u8BF4\uFF0C\u5927\u9A6C\u5C06\u542F\u52A8\u80FD\u6E90\u4EA4\u6613\u6240\uFF0C\u4EE5\u4FBF\u51FA\u53E3\u53EF\u518D\u751F\u80FD\u6E90\u5230\u90BB\u56FD\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u80FD\u6E90\u59D4\u5458\u4F1A\u6B63\u8D77\u6709\u5173\u4EA4\u6613\u6240\u7684\u7EC6\u8282\uFF0C\u5E76\u5C06\u4E8E\u4ECA\u5E74\u5185\u516C\u5E03\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u4EEC\u5C06\u63A2\u8BA8\u53EF\u7528\u7684\u6A21\u5F0F\uFF0C\u9996\u5148\u987B\u5148\u786E\u4FDD\u53EF\u518D\u751F\u80FD\u6E90\u5728\u56FD\u5185\u4F9B\u5E94\u5145\u8DB3\uFF0C\u5176\u6B21\u662F\u786E\u4FDD\u6D77\u5916\u9500\u552E\u83B7\u5F97\u6700\u4F73\u4EF7\u503C\u540E\u5141\u8BB8\u518D\u6295\u8D44\uFF0C\u4EE5\u63A8\u52A8\u6211\u56FD\u53EF\u518D\u751F\u80FD\u6E90\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u8042\u7EB3\u5179\u7C73\u4ECA\u65E5\u5728\u5927\u9A6C\u5DE5\u4E1A\u53D1\u5C55\u91D1\u878D\u673A\u6784\uFF08MIDF\uFF09\u9898\u4E3A\uFF1A\u201C\u56FD\u5BB6\u80FD\u6E90\u8F6C\u578B\u8DEF\u7EBF\u56FE\uFF1A\u80FD\u6E90\u8F6C\u578B\u5BFC\u822A\uFF0C\u5BF9\u4E8E\u5927\u9A6C\u4E0B\u4E00\u4E2A\u662F\u4EC0\u4E48\uFF1F\u201D\u7684\u5706\u684C\u4F1A\u8BAE\u4E0A\u8BF4\uFF0C\u4E3A\u4E86\u652F\u6301\u56FD\u5BB6\u7684\u80FD\u6E90\u8F6C\u578B\uFF0C\u5927\u9A6C\u5E94\u8003\u8651\u5176\u4ED6\u80FD\u6E90\u53D1\u7535\uFF0C\u4F8B\u5982\u5C0F\u578B\u6C34\u529B\u53D1\u7535\uFF0C\u800C\u975E\u53EA\u8003\u8651\u5927\u89C4\u6A21\u6C34\u529B\u53D1\u7535\uFF0C\u4EE5\u81F4\u5728\u6267\u884C\u4E0A\u9762\u5BF9\u5927\u95EE\u9898\uFF0C\u56E0\u4E3A\u5927\u578B\u6C34\u529B\u53D1\u7535\u8BA1\u5212\u9700\u5904\u7406\u8BB8\u591A\u6743\u8861\u7684\u4E8B\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u5F3A\u8C03\uFF0C\u5927\u9A6C\u8FD8\u9700\u8981\u7814\u7A76\u7535\u6C60\u5B58\u50A8\u7CFB\u7EDF\uFF0C\u8FD9\u7CFB\u7EDF\u5728\u751F\u4EA7\u66F4\u5EC9\u5B9C\u4EF7\u683C\u7684\u53EF\u518D\u751F\u80FD\u6E90\u4E0A\uFF0C\u53D1\u6325\u91CD\u8981\u7684\u4F5C\u7528\u3002\u003C/p\u003E\n\u003Cp\u003E\u8C08\u5230\u653F\u5E9C\u6216\u5C06\u5F81\u6536\u78B3\u7A0E\uFF0C\u8042\u7EB3\u5179\u7C73\u8868\u793A\uFF0C\u6211\u56FD\u9700\u8981\u6539\u9769\u7A0E\u5236\uFF0C\u4EE5\u652F\u6301\u8BE5\u884C\u4E1A\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u8FD9\u65B9\u9762\u8D22\u653F\u90E8\u987B\u4E3B\u5BFC\uFF0C\u5F53\u653F\u5E9C\u8C08\u8BBA\u52302050\u5E74\u5B9E\u73B0\u96F6\u78B3\u6392\u76EE\u6807\u65F6\uFF0C\u7A0E\u6536\u5FC5\u987B\u53D1\u6325\u4F5C\u7528\uFF0C\u56E0\u4E3A\u78B3\u6392\u653E\u9700\u4ED8\u4E0A\u4EE3\u4EF7\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u65E0\u610F\u5EFA\u6838\u7535\u5382\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u5927\u9A6C\u7EF4\u6301\u201C\u65E0\u6838\u201D\u653F\u7B56\uFF0C\u66F4\u65E0\u610F\u5EFA\u6838\u7535\u5382\u3002\u003C/p\u003E\n\u003Cp\u003E\u8042\u7EB3\u5179\u7C73\u8BF4\uFF0C\u5C3D\u7BA1\u653F\u5E9C\u8BA4\u540C\u5C0F\u578B\u8F7B\u6C34\u6A21\u7EC4\u5316\u53CD\u5E94\u7089\uFF08SMR\uFF09\uFF0C\u4F46\u57FA\u4E8E\u5BF9\u73AF\u4FDD\u8BFE\u9898\u7684\u5173\u6CE8\uFF0C\u6CA1\u6709\u8BA1\u5212\u6269\u5C55\u81F3\u5174\u5EFA\u6838\u7535\u5382\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF1A\u201C\u5C0F\u578B\u8F7B\u6C34\u6A21\u7EC4\u5316\u53CD\u5E94\u7089\uFF0C\u548C\u65E5\u672C\u5E7F\u5C9B\u6216\u4E4C\u514B\u5170\u5207\u5C14\u8BFA\u8D1D\u5229\u6838\u53CD\u5E94\u7089\u662F\u4E0D\u540C\u7684\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u4EEC\u5FC5\u987B\u8BF4\u670D\u6C11\u4F17\uFF0C\u800C\u6211\u8BA4\u4E3A\u8FD9\u662F\u6211\u4EEC\u76EE\u524D\u8FD8\u672A\u505A\u5230\u7684\u3002\u6211\u4EEC\u4E0D\u4F1A\u5728\u8FD1\u671F\u5185\u5F00\u62D3\u6838\u80FD\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u4E0D\u68C0\u8BA8\u592A\u9633\u80FD\u8D2D\u7535\u534F\u8BAE\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u8042\u7EB3\u5179\u7C73\u8BF4\uFF0C\u653F\u5E9C\u4E0D\u8003\u8651\u68C0\u8BA8\u5927\u578B\u592A\u9633\u80FD\u8BA1\u5212\uFF08LLS\uFF09\u7684\u73B0\u6709\u8D2D\u7535\u534F\u8BAE\uFF0C\u4EE5\u8BA9\u5B83\u6765\u5E73\u8861\u8FD1\u671F\u4EF7\u683C\u4E0A\u8C03\u7684\u7EFF\u8272\u7535\u8D39\u8BA1\u5212\uFF08GET\uFF09\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u53D7\u8BE2\u53CA\u653F\u5E9C\u662F\u5426\u8003\u8651\u5BA1\u67E5\u5927\u578B\u592A\u9633\u80FD\u8BA1\u5212\u73B0\u6709\u7684\u8D2D\u7535\u534F\u8BAE\u65F6\u8BF4\uFF1A\u201C\u6211\u8BA4\u4E3A\u5927\u578B\u592A\u9633\u80FD\u8BA1\u5212\u8D2D\u7535\u534F\u8BAE\u548C\u7EFF\u8272\u7535\u8D39\u7684\u4E0A\u6DA8\u662F\u4E0D\u76F8\u5173\u7684\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u5927\u9A6C\u662F\u8981\u57282050\u5E74\u5B9E\u73B070%\u7684\u53EF\u518D\u751F\u80FD\u6E90\u5BB9\u91CF\u76EE\u6807\uFF0C\u56E0\u6B64\u5C06\u901A\u8FC7\u5E7F\u6CDB\u8BBE\u7F6E\u5C4B\u9876\u592A\u9633\u80FD\u8BA1\u5212\u6765\u5F00\u53D1\u592A\u9633\u80FD\u8D44\u6E90\u3002\u003C/p\u003E\n\u003Cp\u003E\u8042\u7EB3\u5179\u7C73\u63D0\u5230\uFF0C\u65E9\u524D\u7EFF\u8272\u7535\u8D39\u8BA1\u5212\u768430%\u8BA4\u8D2D\u989D\u9650\u5236\u5DF2\u4F5C\u5E9F\uFF0C\u76EE\u524D\u5219\u662F\u6279\u51C6100%\u8BA4\u8D2D\uFF0C\u8FD9\u5BF9\u4F01\u4E1A\u6765\u8BF4\u662F\u53EF\u5206\u62C5\u80FD\u6E90\u8F6C\u578B\u62C5\u5B50\u7684\u597D\u673A\u4F1A\u3002\u003C/p\u003E\n\u003Chr /\u003E\n\u003Chr /\u003E\n\u003Chr /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/07/frc-8e21c212d4c8ad886c07a78ab1c6343d.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Chr /\u003E\n\u003Cp\u003E\u58F0\u660E\uFF1A\u8F6C\u8F7D\u6B64\u6587\u662F\u51FA\u4E8E\u4F20\u9012\u66F4\u591A\u4FE1\u606F\u4E4B\u76EE\u7684\u3002\u82E5\u6709\u6765\u6E90\u6807\u6CE8\u9519\u8BEF\u6216\u4FB5\u72AF\u4E86\u60A8\u7684\u5408\u6CD5\u6743\u76CA\uFF0C\u8BF7\u4E0E\u6211\u4EEC\u8054\u7CFB\uFF0C\u6211\u4EEC\u5C06\u53CA\u65F6\u66F4\u6B63\u6216\u5220\u9664\uFF0C\u8054\u7CFB\u5FAE\u4FE1\u53F7myinfonews\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/HIh_3-jtQmymXDnnuNJFaQ\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
