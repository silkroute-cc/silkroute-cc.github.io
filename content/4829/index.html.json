{
  "id": "%e9%a6%964%e4%b8%aa%e6%9c%8896%e4%b8%87%e4%b8%ad%e5%9b%bd%e5%ae%a2%e8%ae%bf%e5%a4%a7%e9%a9%ac-%e5%bc%a0%e5%ba%86%e4%bf%a1%ef%bc%9a%e5%90%8c%e6%af%94%e6%9a%b4%e5%a2%9e232",
  "slug": "%e9%a6%964%e4%b8%aa%e6%9c%8896%e4%b8%87%e4%b8%ad%e5%9b%bd%e5%ae%a2%e8%ae%bf%e5%a4%a7%e9%a9%ac-%e5%bc%a0%e5%ba%86%e4%bf%a1%ef%bc%9a%e5%90%8c%e6%af%94%e6%9a%b4%e5%a2%9e232",
  "canonicalUrlKey": "%e9%a6%964%e4%b8%aa%e6%9c%8896%e4%b8%87%e4%b8%ad%e5%9b%bd%e5%ae%a2%e8%ae%bf%e5%a4%a7%e9%a9%ac-%e5%bc%a0%e5%ba%86%e4%bf%a1%ef%bc%9a%e5%90%8c%e6%af%94%e6%9a%b4%e5%a2%9e232",
  "route": "/4829/",
  "title": "\u99964\u4E2A\u670896\u4E07\u4E2D\u56FD\u5BA2\u8BBF\u5927\u9A6C \u5F20\u5E86\u4FE1\uFF1A\u540C\u6BD4\u66B4\u589E232%",
  "summary": "\uFF08\u5409\u9686\u576114\u65E5\u8BAF\uFF09\u65C5\u6E38\u3001\u827A\u672F\u53CA\u6587\u5316\u90E8\u957F\u62FF\u7763\u65AF\u91CC\u5F20\u5E86\u4FE1\u8868\u793A\uFF0C2024\u5E741\u6708\u81F34\u6708\u671F\u95F4\uFF0C\u4E2D\u56FD\u4E3A\u5927\u9A6C\u8D21\u732E95\u4E075696\u540D\u6E38\u5BA2\u3002\u8FD9\u610F\u5473\u7740\u4E0E2023\u5E74\u540C\u671F\u768428\u4E077910\u540D\u6E38\u5BA2\u76F8\u6BD4\uFF0C\u66B4\u589E\u4E86231.9%\u3002 \u4ED6\u8868\u793A\uFF0C\u4E2D\u56FD\u4F9D\u7136\u662F\u5927\u9A6C\u6700\u5927\u7684\u65C5\u5BA2\u6765\u6E90\u4E4B\u4E00\u3002 \u4ED6\u8BF4\uFF0C\u5C55\u671B\u672A\u6765\uFF0C\u5927\u9A6C\u7684\u76EE\u6807\u662F\u57282024\u5E74\u8FCE\u63A52730\u4E07\u56FD\u9645\u6E38\u5BA2\uFF0C\u65C5\u6E38\u6536\u5165\u8FBE\u81F31027\u4EBF\u4EE4\u5409\u3002 \u201C\u4E3A\u4E86\u5B9E\u73B0\u8FD9\u4E00\u76EE\u6807\uFF0C\u6211\u4EEC\u6B63\u52AA\u529B\u5F00\u62D3\u4E2D\u56FD\u5E02\u573A\uFF0C\u5B9E\u65BD\u7B56\u7565\uFF0C\u4EE5\u5438\u5F15\u66F4\u591A\u4E2D\u56FD\u6E38\u5BA2\u6765\u4F53\u9A8C\u5927\u9A6C\u72EC\u7279\u800C\u591A\u6837\u7684\u666F\u70B9\u3002\u201C \u4ED6\u6307\u51FA\uFF0C\u50CF\u201C\u4F60\u597D\uFF01\u4E2D\u56FD\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/06/frc-b83c48c0c865cb56e2a11e8e1c1573a7.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\uFF08\u5409\u9686\u576114\u65E5\u8BAF\uFF09\u65C5\u6E38\u3001\u827A\u672F\u53CA\u6587\u5316\u90E8\u957F\u62FF\u7763\u65AF\u91CC\u5F20\u5E86\u4FE1\u8868\u793A\uFF0C2024\u5E741\u6708\u81F34\u6708\u671F\u95F4\uFF0C\u4E2D\u56FD\u4E3A\u5927\u9A6C\u8D21\u732E95\u4E075696\u540D\u6E38\u5BA2\u3002\u8FD9\u610F\u5473\u7740\u4E0E2023\u5E74\u540C\u671F\u768428\u4E077910\u540D\u6E38\u5BA2\u76F8\u6BD4\uFF0C\u66B4\u589E\u4E86231.9%\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8868\u793A\uFF0C\u4E2D\u56FD\u4F9D\u7136\u662F\u5927\u9A6C\u6700\u5927\u7684\u65C5\u5BA2\u6765\u6E90\u4E4B\u4E00\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u5C55\u671B\u672A\u6765\uFF0C\u5927\u9A6C\u7684\u76EE\u6807\u662F\u57282024\u5E74\u8FCE\u63A52730\u4E07\u56FD\u9645\u6E38\u5BA2\uFF0C\u65C5\u6E38\u6536\u5165\u8FBE\u81F31027\u4EBF\u4EE4\u5409\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u4E3A\u4E86\u5B9E\u73B0\u8FD9\u4E00\u76EE\u6807\uFF0C\u6211\u4EEC\u6B63\u52AA\u529B\u5F00\u62D3\u4E2D\u56FD\u5E02\u573A\uFF0C\u5B9E\u65BD\u7B56\u7565\uFF0C\u4EE5\u5438\u5F15\u66F4\u591A\u4E2D\u56FD\u6E38\u5BA2\u6765\u4F53\u9A8C\u5927\u9A6C\u72EC\u7279\u800C\u591A\u6837\u7684\u666F\u70B9\u3002\u201C\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6307\u51FA\uFF0C\u50CF\u201C\u4F60\u597D\uFF01\u4E2D\u56FD\uFF01\u201D\u65C5\u6E38\u5C55\u8FD9\u6837\u7684\u5E73\u53F0\uFF0C\u5BF9\u4FC3\u8FDB\u5927\u9A6C\u548C\u4E2D\u56FD\u7684\u6587\u5316\u4EA4\u6D41\u548C\u65C5\u6E38\u5408\u4F5C\uFF0C\u5177\u6709\u91CD\u8981\u610F\u4E49\uFF1A\u201C\u5B83\u4EEC\u662F\u8FDE\u63A5\u6211\u4EEC\u4E24\u56FD\u7684\u6865\u6881\uFF0C\u901A\u8FC7\u65C5\u6E38\u548C\u63A2\u7D22\u7684\u89C6\u89D2\uFF0C\u4FC3\u8FDB\u76F8\u4E92\u4E86\u89E3\u4E0E\u53CB\u8C0A\u3002\u201C\u003C/p\u003E\n\u003Cp\u003E\u5F20\u5E86\u4FE1\u4ECA\u65E5\u5728\u6B66\u5409\u52A0\u91CC\u5C14\u67CF\u5A01\u5E74\u5E7F\u573A\u4F1A\u5C55\u4E2D\u5FC3\u4E3E\u884C\u7684\u9996\u5C4A\u201C\u4F60\u597D\uFF01\u4E2D\u56FD\u201D\u65C5\u6E38\u5C55\uFF08\u9A6C\u6765\u897F\u4E9A\uFF09\u5F00\u5E55\u81F4\u8F9E\u65F6\uFF0C\u8FD9\u4E48\u8BF4\u3002\u7531\u4E8E\u5F20\u5E86\u4FE1\u4E0D\u514B\u51FA\u5E2D\uFF0C\u5176\u8BB2\u7A3F\u7531\u5927\u9A6C\u65C5\u6E38\u4FC3\u8FDB\u5C40\u4E3B\u5E2D\u62FF\u7763\u96C5\u601D\u654F\u739B\u672B\u4EE3\u8BFB\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ECE\u5373\u65E5\u8D77\u81F3\u5468\u65E5\uFF0816\u65E5\uFF09\uFF0C\u4E3A\u671F\u4E09\u5929\u7684\u201C\u4F60\u597D\uFF01\u4E2D\u56FD\u201D \u65C5\u6E38\u5C55\u662F\u7531\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u6307\u5BFC\uFF0C\u9A6C\u4E2D\u6C11\u4FD7\u6587\u65C5\u603B\u5546\u4F1A\u4E3B\u529E\uFF0C\u4E2D\u56FD\u5357\u65B9\u822A\u7A7A\u4E3A\u6307\u5B9A\u822A\u7A7A\uFF0C\u4E2D\u56FD\u5DE5\u5546\u94F6\u884C\u4E3A\u5408\u4F5C\u94F6\u884C\uFF0C\u4E2D\u56FD\u9A7B\u9A6C\u6765\u897F\u4E9A\u5927\u4F7F\u9986\u3001\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38\u3001\u827A\u672F\u548C\u6587\u5316\u90E8\u3001\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38\u4FC3\u8FDB\u5C40\u4E3A\u5B98\u65B9\u652F\u6301\u5355\u4F4D\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/06/frc-1428772fa95f8e0bf8d1a0a26e330ba9.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u4E2D\u56FD\u9A7B\u9A6C\u5927\u4F7F\u9986\u6587\u5316\u5904\u53C2\u8D5E\u5E38\u73CA\u5973\u58EB\u5728\u81F4\u8F9E\u65F6\u8BF4\uFF0C\u65C5\u6E38\u662F\u4FC3\u8FDB\u9A6C\u4E2D\u4EBA\u6587\u4EA4\u6D41\u7684\u91CD\u8981\u8F7D\u4F53\uFF0C\u662F\u4E24\u56FD\u4EBA\u6C11\u52A0\u6DF1\u7406\u89E3\u548C\u53CB\u8C0A\u7684\u6709\u6548\u65B9\u5F0F\u3002\u003C/p\u003E\n\u003Cp\u003E\u5979\u6307\u51FA\uFF0C\u53BB\u5E7412\u67081\u65E5\u8D77\uFF0C\u9A6C\u4E2D\u5B9E\u65BD\u81F3\u514D\u7B7E\u8BC1\u653F\u7B56\uFF0C\u4E3A\u4E24\u56FD\u4EBA\u6C11\u63A2\u4EB2\u8BBF\u53CB\u3001\u65C5\u6E38\u89C2\u5149\u3001\u7ECF\u5546\u63D0\u4F9B\u4E86\u5B9E\u5B9E\u5728\u5728\u7684\u4FBF\u5229\uFF0C\u53D7\u5230\u5404\u65B9\u7684\u70ED\u70C8\u6B22\u8FCE\u548C\u54CD\u5E94\u3002\u003C/p\u003E\n\u003Cp\u003E\u5E38\u73CA\u8BF4\uFF0C\u622A\u81F3\u4ECA\u5E744\u6708\uFF0C\u5171\u670995\u4E075696\u540D\u4E2D\u56FD\u6E38\u5BA2\u5165\u5883\u9A6C\u6765\u897F\u4E9A\uFF0C\u5927\u9A6C\u5DF2\u7ECF\u6210\u4E3A\u8D8A\u6765\u8D8A\u591A\u4E2D\u56FD\u6E38\u5BA2\u7684\u9996\u9009\u76EE\u7684\u5730\u4E4B\u4E00\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u7B7E\u8BC1\u4FBF\u5229\u5316\u4E3E\u63AA\u7684\u5B9E\u65BD\uFF0C\u4E5F\u8BA9\u5927\u9A6C\u670B\u53CB\u53EF\u4EE5\u5BF9\u4E2D\u56FD\u6765\u4E00\u573A\u2018\u8BF4\u8D70\u5C31\u8D70\u7684\u65C5\u884C\u2019\uFF0C\u9971\u89C9\u4E2D\u56FD\u7684\u5927\u597D\u6CB3\u5C71\uFF0C\u5E76\u89C1\u8BC1\u4E2D\u56FD\u9AD8\u8D28\u91CF\u53D1\u5C55\u6210\u679C\u3002\u201C\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u4E2D\u6C11\u4FD7\u6587\u65C5\u603B\u5546\u4F1A\u603B\u4F1A\u957F\u62FF\u6C40\u65AF\u91CC\u5ED6\u5229\u5973\u8868\u793A\uFF1A\u201C\u6211\u4EEC\u76F8\u4FE1\uFF0C\u901A\u8FC7\u8FD9\u4E00\u65C5\u6E38\u5C55\uFF0C\u5C06\u8FDB\u4E00\u6B65\u63A8\u52A8\u5927\u9A6C\u548C\u4E2D\u56FD\u4E4B\u95F4\u7684\u65C5\u6E38\u5408\u4F5C\uFF0C\u4E3A\u4E24\u56FD\u4EBA\u6C11\u63D0\u4F9B\u66F4\u591A\u4E86\u89E3\u5F7C\u6B64\u6587\u5316\u3001\u589E\u8FDB\u53CB\u8C0A\u7684\u673A\u4F1A\u3002\u201C\u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u4EEC\u90FD\u505A\u597D\u5C71\u3001\u6C34\u3001\u6587\u5316\u7B49\u7ED3\u5408\u6587\u7AE0\uFF0C\u4EE5\u6587\u5851\u65C5\u3001\u4EE5\u65C5\u5F70\u6587\u3001\u8BA9\u81EA\u5DF1\u4E0E\u4F17\u4E0D\u540C\uFF0C\u4E92\u76F8\u5438\u5F15\u65C5\u5BA2\u53CA\u8BA9\u2018\u5934\u56DE\u5BA2\u2019\u53D8\u6210\u2018\u56DE\u5934\u5BA2\u2019\uFF0C\u8BA9\u7F51\u7EA2\u53D8\u6210\u957F\u7EA2\u3002\u201C\u003C/p\u003E\n\u003Cp\u003E\u4E0E\u4F1A\u8005\u8FD8\u6709\u4E2D\u56FD\u5B81\u590F\u56DE\u65CF\u81EA\u6CBB\u533A\u6587\u5316\u548C\u65C5\u6E38\u5385\u4E8C\u7EA7\u5DE1\u89C6\u5458\u5218\u5FD7\u658C\u3001\u5409\u9686\u5761\u67CF\u5A01\u5E74\uFF08\u96F6\u552E\u90E8\uFF09\u603B\u6267\u884C\u957F\u62FF\u7763\u53F6\u7D20\u6E05\u3001\u9A6C\u6765\u897F\u4E9A\u534E\u4EBA\u65C5\u6E38\u4E1A\u516C\u4F1A\u603B\u4F1A\u957F\u5305\u4E00\u96C4\u3001\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u4E3B\u4EFB\u5F20\u6770\u946B\u3001\u9A6C\u6765\u897F\u4E9A\u4E2D\u56FD\u5DE5\u5546\u94F6\u884C\u526F\u884C\u957F\u5218\u4E30\u3001\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38\u603B\u4F1A\u603B\u8D22\u653F\u8BB8\u5149\u6807\u3001\u4EE5\u53CA\u4E2D\u56FD\u5357\u65B9\u822A\u7A7A\u516C\u53F8\u9A6C\u6765\u897F\u4E9A\u5409\u9686\u5761\u8425\u4E1A\u90E8\u603B\u7ECF\u7406\u738B\u65ED\u7B49\u4EBA\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/T9k2-ztLhTHCmYMvKOUNdA\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
