{
  "id": "%e4%ba%bf%e7%ba%ac%e9%94%82%e8%83%bd%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e5%b7%a5%e5%8e%82%e7%a8%b3%e6%ad%a5%e6%8e%a8%e8%bf%9b%e5%bb%ba%e5%8e%82",
  "slug": "%e4%ba%bf%e7%ba%ac%e9%94%82%e8%83%bd%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e5%b7%a5%e5%8e%82%e7%a8%b3%e6%ad%a5%e6%8e%a8%e8%bf%9b%e5%bb%ba%e5%8e%82",
  "canonicalUrlKey": "%e4%ba%bf%e7%ba%ac%e9%94%82%e8%83%bd%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e5%b7%a5%e5%8e%82%e7%a8%b3%e6%ad%a5%e6%8e%a8%e8%bf%9b%e5%bb%ba%e5%8e%82",
  "route": "/4816/",
  "title": "\u4EBF\u7EAC\u9502\u80FD\u9A6C\u6765\u897F\u4E9A\u5DE5\u5382\u7A33\u6B65\u63A8\u8FDB\u5EFA\u5382",
  "summary": "\u6301\u7EED\u52A0\u7801 \u7A33\u6B65\u63A8\u8FDB \u4EBF\u7EAC\u9502\u80FD\u9A6C\u6765\u897F\u4E9A\u5DE5\u5382\u9879\u76EE\u5305\u542B\u4E24\u671F\uFF0C\u4E00\u671F\u4E3A\u201C\u56FD\u9645\u5316\u5706\u67F1\u7535\u6C60\u4EA7\u4E1A\u56ED\u201D\u9879\u76EE\uFF0C\u6295\u8D44\u4E0D\u8D85\u8FC742,230\u4E07\u7F8E\u5143\uFF0C\u4F4D\u4E8E\u9A6C\u6765\u897F\u4E9A\u5409\u6253\u5DDE\u5C45\u6797\u53BF\uFF0C\u5DF2\u4E8E2023\u5E748\u67087\u65E5\u6B63\u5F0F\u52A8\u5DE5\uFF1B\u4E8C\u671F\u4E3A\u201C\u50A8\u80FD\u9879\u76EE\u201D\uFF0C\u4EBF\u7EAC\u9502\u80FD\u5168\u8D44\u5B59\u516C\u53F8\u4EBF\u7EAC\u9502\u80FD\u9A6C\u6765\u897F\u4E9A\u6709\u9650\u516C\u53F8\u4E0EINVEST KEDAH BHD. \u4E8E2024\u5E741\u670815\u65E5\u5728\u60E0\u5DDE\u7B7E\u7F72\u8C05\u89E3\u5907\u5FD8\u5F55\uFF0C\u62DF\u8BBE\u7ACB\u4EBF\u7EAC\u9502\u80FD\u9A6C\u6765\u897F\u4E9A\u50A8\u80FD\u516C\u53F8\uFF0C\u5E76\u65B0\u8D2D\u4E8C\u671F\u5730\u5757\uFF0C\u5F00\u542F\u50A8\u80FD\u5DE5\u5382\u5EFA\u8BBE\uFF0C\u4EE5\u6EE1\u8DB3\u9A6C\u6765\u897F\u4E9A\u50A8\u80FD\u9700\u6C42\u3002 \u4EBF\u7EAC\u9502\u80FD\u9879\u76EE\u4E00\u671F\u66A8\u4EBF\u7EAC\u9502\u80FD\u7B2C\u4E94\u5341\u4E09\u5DE5\u5382\uFF0C\u4E3B\u8981\u751F\u4EA7\u7535\u52A8\u2026",
  "body": "\u003Cp\u003E\u003Cstrong\u003E\u6301\u7EED\u52A0\u7801 \u7A33\u6B65\u63A8\u8FDB\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u4EBF\u7EAC\u9502\u80FD\u9A6C\u6765\u897F\u4E9A\u5DE5\u5382\u9879\u76EE\u5305\u542B\u4E24\u671F\uFF0C\u4E00\u671F\u4E3A\u201C\u56FD\u9645\u5316\u5706\u67F1\u7535\u6C60\u4EA7\u4E1A\u56ED\u201D\u9879\u76EE\uFF0C\u6295\u8D44\u4E0D\u8D85\u8FC742,230\u4E07\u7F8E\u5143\uFF0C\u4F4D\u4E8E\u9A6C\u6765\u897F\u4E9A\u5409\u6253\u5DDE\u5C45\u6797\u53BF\uFF0C\u5DF2\u4E8E2023\u5E748\u67087\u65E5\u6B63\u5F0F\u52A8\u5DE5\uFF1B\u4E8C\u671F\u4E3A\u201C\u50A8\u80FD\u9879\u76EE\u201D\uFF0C\u4EBF\u7EAC\u9502\u80FD\u5168\u8D44\u5B59\u516C\u53F8\u4EBF\u7EAC\u9502\u80FD\u9A6C\u6765\u897F\u4E9A\u6709\u9650\u516C\u53F8\u4E0EINVEST KEDAH BHD. \u4E8E2024\u5E741\u670815\u65E5\u5728\u60E0\u5DDE\u7B7E\u7F72\u8C05\u89E3\u5907\u5FD8\u5F55\uFF0C\u62DF\u8BBE\u7ACB\u4EBF\u7EAC\u9502\u80FD\u9A6C\u6765\u897F\u4E9A\u50A8\u80FD\u516C\u53F8\uFF0C\u5E76\u65B0\u8D2D\u4E8C\u671F\u5730\u5757\uFF0C\u5F00\u542F\u50A8\u80FD\u5DE5\u5382\u5EFA\u8BBE\uFF0C\u4EE5\u6EE1\u8DB3\u9A6C\u6765\u897F\u4E9A\u50A8\u80FD\u9700\u6C42\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/06/frc-8c9fad9a2cfe7646ac5e40b7e7048a85.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u4EBF\u7EAC\u9502\u80FD\u9879\u76EE\u4E00\u671F\u66A8\u4EBF\u7EAC\u9502\u80FD\u7B2C\u4E94\u5341\u4E09\u5DE5\u5382\uFF0C\u4E3B\u8981\u751F\u4EA7\u7535\u52A8\u5DE5\u5177\u3001\u7535\u52A8\u4E24\u8F6E\u8F66\u7528\u5706\u67F1\u7535\u6C60\uFF0C\u81EA\u52A8\u5DE5\u4EE5\u6765\uFF0C\u51ED\u501F\u6210\u719F\u7684\u5236\u9020\u80FD\u529B\u4E0E\u6280\u672F\u50A8\u5907\uFF0C\u4E3A\u9A6C\u6765\u897F\u4E9A\u5F53\u5730\u7ECF\u6D4E\u6CE8\u5165\u6D3B\u529B\uFF0C\u540C\u65F6\u83B7\u5F97\u4E86\u9A6C\u6765\u897F\u4E9A\u5E02\u573A\u5E7F\u6CDB\u8BA4\u53EF\u3002\u76EE\u524D\uFF0C\u9879\u76EE\u5EFA\u8BBE\u6309\u8BA1\u5212\u7A33\u6B65\u63A8\u8FDB\u4E2D\u3002\u5C4A\u65F6\u6295\u4EA7\u540E\u5C06\u6781\u5927\u63D0\u5347\u6D77\u5916\u4EA4\u4ED8\u80FD\u529B\u53CA\u4F18\u52BF\uFF0C\u5145\u5206\u6EE1\u8DB3\u5BA2\u6237\u9700\u6C42\uFF0C\u7EE7\u7EED\u5F3A\u5316\u4EBF\u7EAC\u9502\u80FD\u5728\u5706\u67F1\u7535\u6C60\u9886\u57DF\u7684\u9886\u5148\u5730\u4F4D\u3002\u540C\u65F6\uFF0C\u5C06\u4FC3\u8FDB\u5F53\u5730\u5C31\u4E1A\u4E0E\u7ECF\u6D4E\u589E\u957F\uFF0C\u8FDB\u4E00\u6B65\u63A8\u52A8\u4E2D\u9A6C\u4E24\u56FD\u5728\u65B0\u80FD\u6E90\u9886\u57DF\u7684\u5408\u4F5C\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/06/frc-f79090d9963c194786307fbd52ea532c.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u4F5C\u4E3A\u5168\u7403\u9502\u7535\u6C60\u5934\u90E8\u4F01\u4E1A\uFF0C\u4EBF\u7EAC\u9502\u80FD\u59CB\u7EC8\u4EE5\u56FD\u9645\u5316\u89C6\u91CE\u5E03\u5C40\u5168\u7403\uFF0C\u6784\u5EFA\u201C\u5168\u7403\u5236\u9020\u3001\u5168\u7403\u4EA4\u4ED8\u3001\u5168\u7403\u670D\u52A1\u201D\u7684\u80FD\u529B\uFF0C\u8D34\u8FD1\u5BA2\u6237\uFF0C\u5FEB\u901F\u54CD\u5E94\u3002\u5728\u9A6C\u6765\u897F\u4E9A\u5DE5\u5382\u5EFA\u8BBE\u548C\u7ECF\u8425\u7BA1\u7406\u8FC7\u7A0B\u4E2D\uFF0C\u4EBF\u7EAC\u9502\u80FD\u5C06\u901A\u8FC7\u6570\u667A\u5316\u5DE5\u5382\u8D4B\u80FD\u9AD8\u6548\u751F\u4EA7\uFF0C\u63A8\u52A8\u4EA7\u54C1\u5168\u751F\u547D\u5468\u671F\u964D\u78B3\u51CF\u6392\uFF0C\u4EE5\u9AD8\u5B89\u5168\u3001\u9AD8\u53EF\u9760\u3001\u9AD8\u6027\u80FD\u7684\u4EA7\u54C1\u8DF5\u884C\u5168\u7403\u5316\u6218\u7565\uFF0C\u643A\u624B\u5168\u7403\u5408\u4F5C\u4F19\u4F34\uFF0C\u5171\u8D74\u7EFF\u8272\u672A\u6765\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5171\u8BDD\u5408\u4F5C \u9F50\u7ED8\u84DD\u56FE\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u8003\u5BDF\u671F\u95F4\uFF0C\u9EC4\u7EF4\u884D\u603B\u4E00\u884C\u4E0E\u9A6C\u6765\u897F\u4E9A\u6295\u8D44\u53D1\u5C55\u5C40\uFF08\u4EE5\u4E0B\u7B80\u79F0\u0026quot;MIDA\u0026quot;\uFF09\u65B0\u4EFBCEO Mr. Sikh Shamsul Ibrahim Sikh Abdul Majid \u5F00\u5C55\u6DF1\u5165\u4EA4\u6D41\uFF0C\u5C31\u5408\u4F5C\u5171\u8D62\u3001\u5171\u540C\u53D1\u5C55\u7B49\u65B9\u9762\u8FDB\u884C\u6DF1\u5165\u63A2\u8BA8\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/06/frc-df4478440278943441d812fdd6718190.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u9EC4\u7EF4\u884D\u603B\u4EE3\u8868\u4EBF\u7EAC\u9502\u80FD\u5411 MIDA \u7ED9\u4E88\u7684\u5927\u529B\u652F\u6301\u8868\u793A\u8877\u5FC3\u611F\u8C22\u3002MIDA\u65B0\u4EFBCEO Mr. Sikh Shamsul Ibrahim Sikh Abdul Majid\u5BF9\u4EBF\u7EAC\u9502\u80FD\u9A6C\u6765\u897F\u4E9A\u516C\u53F8\u8363\u83B72023\u5E74\u5E74\u5EA6\u9A6C\u6765\u897F\u4E9A\u5916\u5546\u6295\u8D44\u793E\u4F1A\u8D23\u4EFB\u5148\u8FDB\u5236\u9020\u4F01\u4E1A\uFF08\u552F\u4E00\u4E2D\u56FD\u4F01\u4E1A\uFF09\u8868\u793A\u9AD8\u5EA6\u8D5E\u8D4F\uFF0C\u8BE5\u5956\u9879\u7684\u83B7\u5F97\uFF0C\u662F\u5BF9\u4EBF\u7EAC\u9502\u80FD\u5148\u8FDB\u5236\u9020\u6C34\u5E73\u3001\u6280\u672F\u521B\u65B0\u80FD\u529B\u53CA\u7EFF\u8272\u53EF\u6301\u7EED\u53D1\u5C55\u7684\u9AD8\u5EA6\u8BA4\u53EF\u3002\u540C\u65F6\u8868\u793A\uFF0C\u672A\u6765\u5C06\u6301\u7EED\u652F\u6301\u4EBF\u7EAC\u9502\u80FD\u9879\u76EE\u5EFA\u8BBE\u4E0E\u4E1A\u52A1\u5F00\u5C55\uFF0C\u671F\u5F85\u4EBF\u7EAC\u4E3A\u9A6C\u6765\u897F\u4E9A\u7684\u5F53\u5730\u7ECF\u6D4E\u4E0E\u53D1\u5C55\u505A\u51FA\u7A81\u51FA\u8D21\u732E\u3002\u003C/p\u003E\n\u003Cp\u003E\u672A\u6765\uFF0C\u4EBF\u7EAC\u9502\u80FD\u9A6C\u6765\u897F\u4E9A\u5DE5\u5382\u5C06\u4F9D\u6258\u5148\u8FDB\u5236\u9020\u4F18\u52BF\u53CA\u8FD0\u8425\u7ECF\u9A8C\uFF0C\u52A0\u5F3A\u6280\u672F\u521B\u65B0\uFF0C\u81F4\u529B\u4E8E\u63A8\u52A8\u6253\u9020\u6781\u81F4\u5236\u9020\u3001\u4E16\u754C\u4E00\u6D41\u7684\u6570\u667A\u5316\u5DE5\u5382\uFF0C\u52A0\u901F\u5168\u7403\u5316\u5E03\u5C40\u7684\u62D3\u5C55\u6B65\u4F10\uFF0C\u52A9\u529B\u4E1C\u5357\u4E9A\u65B0\u80FD\u6E90\u4EA7\u4E1A\u53D1\u5C55\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/WciMiZg40Vy3m8ibtWOAvQ\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
