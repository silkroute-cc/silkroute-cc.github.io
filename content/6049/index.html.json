  "slug": "\u6BD4\u4E9A\u8FEA\u5148\u8FDB\u6280\u672F\u52A9\u653B-\u5927\u9A6C\u5C06\u8FCE\u65B0\u7535\u52A8\u5DF4\u58EB",
  "canonicalUrlKey": "\u6BD4\u4E9A\u8FEA\u5148\u8FDB\u6280\u672F\u52A9\u653B-\u5927\u9A6C\u5C06\u8FCE\u65B0\u7535\u52A8\u5DF4\u58EB",
  "route": "/6049/",
  "title": "\u6BD4\u4E9A\u8FEA\u5148\u8FDB\u6280\u672F\u52A9\u653B \u5927\u9A6C\u5C06\u8FCE\u65B0\u7535\u52A8\u5DF4\u58EB",
  "summary": "Bus Cap\u516C\u53F8\u5BA3\u5E03\uFF0C\u4E0E\u6BD4\u4E9A\u8FEA\u5927\u9A6C\u516C\u53F8\u7B7E\u7F72\u72EC\u5BB6\u8C05\u89E3\u5907\u5FD8\u5F55\uFF08MoU\uFF09\uFF0C\u5171\u540C\u63A8\u8FDB\u4EE5\u9A6C\u6765\u897F\u4E9A\u4E3A\u57FA\u5730\u7684\u65B0\u80FD\u6E90\u5546\u7528\u8F66\u7B56\u7565\u5408\u4F5C\u5E73\u53F0\u3002\u5408\u4F5C\u4EE5\u5728\u9739\u96F3\u62DF\u8BBE\u7ACB\u7535\u52A8\u5DF4\u58EB\u672C\u571F\u5316\u7EC4\u88C5\u4E0E\u5236\u9020\u8BBE\u65BD\u4E3A\u521D\u6B65\u91CD\u70B9\uFF0C\u8303\u56F4\u53EF\u6DB5\u76D6\u4EA7\u54C1\u672C\u571F\u5316\u3001\u5206\u9500\u3001\u552E\u540E\u670D\u52A1\u3001\u672C\u5730\u7EC4\u88C5\u4E0E\u5236\u9020\u7B49\uFF0C\u672A\u6765\u8FD8\u53EF\u5EF6\u4F38\u81F3\u5176\u4ED6\u65B0\u80FD\u6E90\u5546\u7528\u53CA\u5DE5\u4E1A\u51FA\u884C\u5E94\u7528\u548C\u8F68\u9053\u4EA4\u901A\u89E3\u51B3\u65B9\u6848\u3002\u53CC\u65B9\u8868\u793A\uFF0C\u7ED3\u5408\u6BD4\u4E9A\u8FEA\u7684\u65B0\u80FD\u6E90\u8F66\u8F86\u6280\u672F\u4E0EBus Cap\u7684\u672C\u5730\u5236\u9020\u3001\u5DE5\u7A0B\u80FD\u529B\u548C\u8425\u8FD0\u5E73\u53F0\uFF0C\u6709\u671B\u8FDB\u4E00\u6B65\u5F3A\u5316\u5927\u9A6C\u7535\u52A8\u5DF4\u58EB\u751F\u6001\uFF0C\u63A8\u52A8\u672C\u5730\u4EA7\u4E1A\u5E73\u53F0\u5EFA\u8BBE\u3002",
  "body": "\u003Cp\u003E\u5409\u9686\u576119\u65E5\u8BAF\uFF09Bus Cap\u516C\u53F8\uFF08BUSCAP\uFF0C0455\uFF0C\u521B\u4E1A\u677F\uFF09\u5BA3\u5E03\uFF0C\u4E0E\u6BD4\u4E9A\u8FEA\u5927\u9A6C\u516C\u53F8\u7B7E\u7F72\u4E00\u9879\u72EC\u5BB6\u8C05\u89E3\u5907\u5FD8\u5F55\uFF08MoU\uFF09\uFF0C\u5171\u540C\u63A8\u8FDB\u4EE5\u5927\u9A6C\u4E3A\u57FA\u5730\u7684\u65B0\u80FD\u6E90\u5546\u7528\u8F66\u7B56\u7565\u5408\u4F5C\u5E73\u53F0\u3002\u003C/p\u003E\n\u003Cp\u003EBus Cap\u516C\u53F8\u53D1\u6587\u544A\u6307\u51FA\uFF0C\u8BE5\u516C\u53F8\u4EE5\u5728\u9739\u96F3\u62DF\u8BBE\u7ACB\u7535\u52A8\u5DF4\u58EB\u672C\u571F\u5316\u7EC4\u88C5\u4E0E\u5236\u9020\u8BBE\u65BD\u4F5C\u4E3A\u521D\u6B65\u91CD\u70B9\uFF0C\u5408\u4F5C\u8303\u56F4\u53EF\u6DB5\u76D6\u4EA7\u54C1\u672C\u571F\u5316\u3001\u5206\u9500\u3001\u5168\u9762\u552E\u540E\u670D\u52A1\u3001\u672C\u5730\u7EC4\u88C5\u4E0E\u5236\u9020\uFF0C\u4EE5\u53CA\u8BC4\u4F30\u9002\u5408\u7684\u6295\u8D44\u4E0E\u8425\u8FD0\u67B6\u6784\u7B49\uFF0C\u4EE5\u652F\u6301\u8BE5\u62DF\u8BAE\u5E73\u53F0\u7684\u53D1\u5C55\u3002\u003C/p\u003E\n\u003Cp\u003E\u6B64\u5916\uFF0C\u53CC\u65B9\u4E5F\u53EF\u8FDB\u4E00\u6B65\u8BC4\u4F30\u5C06\u5408\u4F5C\u7531\u7535\u52A8\u5DF4\u58EB\u5EF6\u4F38\u81F3\u5176\u4ED6\u65B0\u80FD\u6E90\u5546\u7528\u53CA\u5DE5\u4E1A\u51FA\u884C\u5E94\u7528\uFF0C\u4EE5\u53CA\u8F68\u9053\u4EA4\u901A\u76F8\u5173\u89E3\u51B3\u65B9\u6848\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u76F8\u5173\u62D3\u5C55\u4ECD\u987B\u89C6\u5E02\u573A\u9700\u6C42\u3001\u6280\u672F\u53EF\u884C\u6027\u53CA\u53CC\u65B9\u65E5\u540E\u7B7E\u7F72\u7684\u6B63\u5F0F\u534F\u8BAE\u800C\u5B9A\u3002\u201D\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/mmbiz_png/LRoqHEicY0hvicawM5FibLmqibgpIgJ8uibH42XwG735mfMqvgJbNlSLXMNvq8Xseibg7PApJkZj9Mbic9TGL7fianq4VoibwwL1k9jm9tFKIkSpMI74/640?wx_fmt=png\u0026amp;from=appmsg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003EBus Cap\u516C\u53F8\u6267\u884C\u8463\u4E8B\u9EC4\u5B97\u626C\uFF08\u5DE63\uFF09\u4E0E\u6BD4\u4E9A\u8FEA\u526F\u603B\u88C1\u517C\u5546\u7528\u8F66\u53CA\u7B2C\u5341\u4E94\u4E8B\u4E1A\u90E8\u603B\u7ECF\u7406\u7F57\u5FE0\u826F\uFF08\u5DE64\uFF09\u7B7E\u7F72\u72EC\u5BB6\u8C05\u89E3\u5907\u5FD8\u5F55\u540E\u5408\u5F71\u3002\u5DE6\u8D77\u4E3ABus Cap\u516C\u53F8\u91C7\u8D2D\u603B\u76D1\u6731\u56FD\u7965\u3001\u975E\u72EC\u7ACB\u975E\u6267\u884C\u8463\u4E8B\u5F20\u666F\u707F\u3001\u6BD4\u4E9A\u8FEA\u5927\u9A6C\u516C\u53F8\u8463\u4E8B\u603B\u7ECF\u7406\u9A6C\u4F1F\uFF0C\u4EE5\u53CA\u5546\u7528\u8F66\u4E8B\u4E1A\u90E8\u54C1\u724C\u603B\u76D1\u738B\u7477\u73F2\u3002\u003C/p\u003E\n\u003Cp\u003E\u5EFA\u7ACB\u672C\u5730\u4EA7\u4E1A\u5E73\u53F0\u003C/p\u003E\n\u003Cp\u003EBus Cap\u516C\u53F8\u6267\u884C\u8463\u4E8B\u9EC4\u5B97\u626C\u8868\u793A\uFF0C\u6B64\u9879\u5408\u4F5C\u662F\u8BE5\u516C\u53F8\u7EE7\u4E0A\u5E02\u540E\u8FDB\u4E00\u6B65\u62D3\u5C55\u5176\u4F01\u4E1A\u7B56\u7565\u7684\u91CD\u8981\u4E00\u6B65\u3002\u6BD4\u4E9A\u8FEA\u5177\u5907\u5148\u8FDB\u7684\u65B0\u80FD\u6E90\u8F66\u8F86\u6280\u672F\u3001\u89E3\u51B3\u65B9\u6848\u53CA\u5168\u7403\u7ECF\u9A8C\uFF1B\u800CBus Cap\u516C\u53F8\u5219\u62E5\u6709\u672C\u5730\u5236\u9020\u80FD\u529B\u3001\u5DE5\u7A0B\u4E13\u4E1A\u77E5\u8BC6\u3001\u884C\u4E1A\u5173\u7CFB\u3001\u552E\u540E\u57FA\u7840\u53CA\u6210\u719F\u7684\u8425\u8FD0\u5E73\u53F0\u3002\u003C/p\u003E\n\u003Cp\u003E\u9EC4\u5B97\u626C\u79F0\uFF0C\u8FD9\u4E0D\u53EA\u662F\u628A\u7535\u52A8\u5DF4\u58EB\u5F15\u5165\u5927\u9A6C\uFF0C\u800C\u662F\u5171\u540C\u63A2\u7D22\u5EFA\u7ACB\u4E00\u4E2A\u80FD\u591F\u652F\u6301\u4EA7\u54C1\u672C\u5730\u5316\u3001\u672C\u5730\u7EC4\u88C5\u4E0E\u5236\u9020\u3001\u552E\u540E\u670D\u52A1\u53CA\u4EA4\u901A\u5DE5\u5177\u5168\u751F\u547D\u5468\u671F\u89E3\u51B3\u65B9\u6848\u7684\u672C\u5730\u4EA7\u4E1A\u5E73\u53F0\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u901A\u8FC7\u7ED3\u5408\u6BD4\u4E9A\u8FEA\u7684\u65B0\u80FD\u6E90\u8F66\u8F86\u80FD\u529B\u4E0EBus Cap\u516C\u53F8\u7684\u672C\u5730\u5E73\u53F0\uFF0C\u6211\u4EEC\u76F8\u4FE1\u53CC\u65B9\u6709\u673A\u4F1A\u8FDB\u4E00\u6B65\u5F3A\u5316\u5927\u9A6C\u7535\u52A8\u5DF4\u58EB\u751F\u6001\uFF0C\u5E76\u63A8\u52A8Bus Cap\u516C\u53F8\u8FDB\u5165\u4E0B\u4E00\u9636\u6BB5\u589E\u957F\u3002\u201D\u003C/p\u003E\n",
