{
  "id": "7851-2",
  "slug": "7851-2",
  "canonicalUrlKey": "7851-2",
  "route": "/4213/",
  "title": "\u62A2\u6293\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u53D1\u5C55\u673A\u9047 \u591A\u5BB6\u4E0A\u5E02\u516C\u53F8\u8D74\u4E1C\u5357\u4E9A\u6295\u8D44",
  "summary": "\u4EE5\u6CF0\u56FD\u3001\u9A6C\u6765\u897F\u4E9A\u7B49\u4E3A\u4EE3\u8868\u7684\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u5171\u5EFA\u56FD\u5BB6\u6B63\u6210\u4E3A\u6295\u8D44\u70ED\u571F\uFF0C\u8BB0\u8005\u6CE8\u610F\u5230\uFF0C\u8FD1\u65E5\uFF0C\u591A\u5BB6\u4E0A\u5E02\u516C\u53F8\u62AB\u9732\u4E86\u5728\u4E1C\u5357\u4E9A\u76F8\u5173\u56FD\u5BB6\u7684\u6295\u8D44\u8BA1\u5212\u3002 11\u670824\u65E5\u665A\u95F4\uFF0C\u9F0E\u9633\u79D1\u6280(688112)\u516C\u544A\u79F0\uFF0C\u4E3A\u6709\u6548\u63D0\u5347\u516C\u53F8\u76F8\u5173\u4E3B\u8425\u4EA7\u54C1\u5728\u5168\u7403\u5E02\u573A\u7684\u4F9B\u5E94\u80FD\u529B\u548C\u7ADE\u4E89\u529B\uFF0C\u6EE1\u8DB3\u5168\u7403\u901A\u7528\u7535\u5B50\u6D4B\u8BD5\u6D4B\u91CF\u4EEA\u5668\u65E5\u76CA\u589E\u957F\u7684\u5E02\u573A\u9700\u6C42\uFF0C\u4FC3\u8FDB\u516C\u53F8\u4E1A\u7EE9\u6301\u7EED\u5FEB\u901F\u589E\u957F\uFF0C\u589E\u5F3A\u516C\u53F8\u7684\u6838\u5FC3\u7ADE\u4E89\u529B\uFF0C\u589E\u5F3A\u516C\u53F8\u6574\u4F53\u6297\u98CE\u9669\u80FD\u529B\uFF0C\u516C\u53F8\u8BA1\u5212\u6295\u8D441.79\u4EBF\u5143\u5EFA\u8BBE\u9A6C\u6765\u897F\u4E9A\u751F\u4EA7\u57FA\u5730\uFF0C\u9879\u76EE\u5EFA\u8BBE\u5206\u4E24\u671F\u5B9E\u65BD\uFF0C\u4E00\u671F\u6295\u8D441895\u4E07\u5143\uFF0C\u4E8C\u671F\u6295\u8D441.6\u4EBF\u5143\u3002 \u9F0E\u9633\u79D1\u2026",
  "body": "\u003Cp\u003E\u4EE5\u6CF0\u56FD\u3001\u9A6C\u6765\u897F\u4E9A\u7B49\u4E3A\u4EE3\u8868\u7684\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u5171\u5EFA\u56FD\u5BB6\u6B63\u6210\u4E3A\u6295\u8D44\u70ED\u571F\uFF0C\u8BB0\u8005\u6CE8\u610F\u5230\uFF0C\u8FD1\u65E5\uFF0C\u591A\u5BB6\u4E0A\u5E02\u516C\u53F8\u62AB\u9732\u4E86\u5728\u4E1C\u5357\u4E9A\u76F8\u5173\u56FD\u5BB6\u7684\u6295\u8D44\u8BA1\u5212\u3002\u003C/p\u003E\n\u003Cp\u003E11\u670824\u65E5\u665A\u95F4\uFF0C\u9F0E\u9633\u79D1\u6280(688112)\u516C\u544A\u79F0\uFF0C\u4E3A\u6709\u6548\u63D0\u5347\u516C\u53F8\u76F8\u5173\u4E3B\u8425\u4EA7\u54C1\u5728\u5168\u7403\u5E02\u573A\u7684\u4F9B\u5E94\u80FD\u529B\u548C\u7ADE\u4E89\u529B\uFF0C\u6EE1\u8DB3\u5168\u7403\u901A\u7528\u7535\u5B50\u6D4B\u8BD5\u6D4B\u91CF\u4EEA\u5668\u65E5\u76CA\u589E\u957F\u7684\u5E02\u573A\u9700\u6C42\uFF0C\u4FC3\u8FDB\u516C\u53F8\u4E1A\u7EE9\u6301\u7EED\u5FEB\u901F\u589E\u957F\uFF0C\u589E\u5F3A\u516C\u53F8\u7684\u6838\u5FC3\u7ADE\u4E89\u529B\uFF0C\u589E\u5F3A\u516C\u53F8\u6574\u4F53\u6297\u98CE\u9669\u80FD\u529B\uFF0C\u516C\u53F8\u8BA1\u5212\u6295\u8D441.79\u4EBF\u5143\u5EFA\u8BBE\u9A6C\u6765\u897F\u4E9A\u751F\u4EA7\u57FA\u5730\uFF0C\u9879\u76EE\u5EFA\u8BBE\u5206\u4E24\u671F\u5B9E\u65BD\uFF0C\u4E00\u671F\u6295\u8D441895\u4E07\u5143\uFF0C\u4E8C\u671F\u6295\u8D441.6\u4EBF\u5143\u3002\u003C/p\u003E\n\u003Cp\u003E\u9F0E\u9633\u79D1\u6280\u79F0\uFF0C\u9A6C\u6765\u897F\u4E9A\u5168\u8D44\u5B50\u516C\u53F8\u7684\u6210\u7ACB\uFF0C\u901A\u8FC7\u8D2D\u7F6E\u5148\u8FDB\u751F\u4EA7\u8BBE\u5907\u8FDB\u4E00\u6B65\u6269\u5927\u6570\u5B57\u793A\u6CE2\u5668\u3001\u6CE2\u5F62\u548C\u4FE1\u53F7\u53D1\u751F\u5668\u3001\u9891\u8C31\u5206\u6790\u4EEA\u548C\u7535\u6E90\u7C7B\u53CA\u7535\u5B50\u8D1F\u8F7D\u7B49\u4EA7\u54C1\u7684\u4EA7\u80FD\u89C4\u6A21\uFF0C\u5B8C\u5584\u516C\u53F8\u7684\u6D77\u5916\u751F\u4EA7\u5236\u9020\u80FD\u529B\uFF0C\u5C06\u6709\u6548\u63D0\u5347\u76F8\u5173\u4E3B\u8425\u4EA7\u54C1\u5728\u5168\u7403\u5E02\u573A\u7684\u4F9B\u5E94\u80FD\u529B\u548C\u7ADE\u4E89\u529B\uFF0C\u6EE1\u8DB3\u5168\u7403\u901A\u7528\u7535\u5B50\u6D4B\u8BD5\u6D4B\u91CF\u4EEA\u5668\u65E5\u76CA\u589E\u957F\u7684\u5E02\u573A\u9700\u6C42\uFF0C\u6709\u5229\u4E8E\u63D0\u5347\u516C\u53F8\u4E1A\u7EE9\u3002\u003C/p\u003E\n\u003Cp\u003E\u8BB0\u8005\u67E5\u9605\u9F0E\u9633\u79D1\u62802023\u5E74\u534A\u5E74\u62A5\u53D1\u73B0\uFF0C\u622A\u81F3\u8BE5\u62A5\u544A\u671F\u672B\uFF0C\u516C\u53F8\u5883\u5916\u8D44\u4EA7\u4E3A5741.54\u4E07\u5143\uFF0C\u5360\u603B\u8D44\u4EA7\u7684\u6BD4\u4F8B\u4E3A3.62%\u3002\u516C\u53F8\u79F0\uFF0C\u672C\u6B21\u9009\u5740\u9A6C\u6765\u897F\u4E9A\u65B0\u5EFA\u751F\u4EA7\u57FA\u5730\uFF0C\u662F\u5BF9\u56FD\u5BB6\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u3001\u201C\u8D70\u51FA\u53BB\u201D\u3001\u201C\u56FD\u5185\u56FD\u9645\u53CC\u5FAA\u73AF\u201D\u56FD\u5BB6\u5BF9\u5916\u53D1\u5C55\u6218\u7565\u7684\u79EF\u6781\u54CD\u5E94\uFF0C\u6709\u5229\u4E8E\u63D0\u5347\u516C\u53F8\u6297\u98CE\u9669\u80FD\u529B\u3002\u003C/p\u003E\n\u003Cp\u003E\u65E0\u72EC\u6709\u5076\uFF0C\u4E1C\u5A01\u79D1\u6280(688700)\u540C\u65E5\u665A\u95F4\u5BA3\u5E03\uFF0C\u62DF\u5728\u6CF0\u56FD\u6295\u8D44\u5EFA\u8BBE\u751F\u4EA7\u57FA\u5730\uFF0C\u6295\u8D44\u91D1\u989D6100\u4E07\u5143\uFF0C\u5305\u62EC\u4F46\u4E0D\u9650\u4E8E\u65B0\u8BBE\u6CF0\u56FD\u516C\u53F8\u3001\u8D2D\u4E70\u571F\u5730\u3001\u5EFA\u8BBE\u5382\u623F\u3001\u8D2D\u5EFA\u56FA\u5B9A\u8D44\u4EA7\u7B49\u3002\u516C\u53F8\u5C06\u4E0E\u5B50\u516C\u53F8\u5E7F\u5FB7\u4E1C\u5A01\u79D1\u6280\u6709\u9650\u516C\u53F8\u5171\u540C\u6295\u8D44\u8BBE\u7ACB\u4E1C\u5A01\u79D1\u6280\uFF08\u6CF0\u56FD\uFF09\u6709\u9650\u516C\u53F8\uFF0C\u8D1F\u8D23\u9879\u76EE\u6295\u8D44\u5EFA\u8BBE\u8FD0\u8425\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E0E\u4E1C\u5A01\u79D1\u6280\u4E00\u6837\uFF0C\u7A0D\u65E9\u4E00\u5929\u768411\u670823\u65E5\u665A\u95F4\uFF0C\u4E5F\u6709\u4E24\u5BB6\u516C\u53F8\u5BA3\u5E03\u4E86\u6CF0\u56FD\u7684\u6295\u8D44\u8BA1\u5212\u3002\u003C/p\u003E\n\u003Cp\u003E\u5176\u4E2D\uFF0C\u6DF1\u5357\u7535\u8DEF(002916)\u5BA3\u5E03\uFF0C\u62DF\u901A\u8FC7\u5168\u8D44\u5B50\u516C\u53F8\u6B27\u535A\u817E\u6709\u9650\u516C\u53F8\u3001\u5E7F\u82AF\u5C01\u88C5\u57FA\u677F\u9999\u6E2F\u6709\u9650\u516C\u53F8\u5728\u6CF0\u56FD\u5171\u540C\u8BBE\u7ACB\u65B0\u516C\u53F8\uFF0C\u65B0\u8BBE\u516C\u53F8\u5C06\u8D1F\u8D23\u6295\u8D44\u5EFA\u8BBE\u6CF0\u56FD\u5DE5\u5382\uFF0C\u6CF0\u56FD\u5DE5\u5382\u603B\u6295\u8D44\u91D1\u989D12.7\u4EBF\u5143\uFF08\u6216\u7B49\u503C\u5916\u5E01\uFF09\u3002\u516C\u53F8\u79F0\uFF0C\u6B64\u6B21\u6295\u8D44\u662F\u57FA\u4E8E\u4E1A\u52A1\u53D1\u5C55\u9700\u8981\u548C\u5B8C\u5584\u6D77\u5916\u5E03\u5C40\u6218\u7565\u7684\u91CD\u8981\u4E3E\u63AA\uFF0C\u6709\u5229\u4E8E\u8FDB\u4E00\u6B65\u5F00\u62D3\u6D77\u5916\u5E02\u573A\uFF0C\u6EE1\u8DB3\u56FD\u9645\u5BA2\u6237\u9700\u6C42\uFF0C\u5B8C\u5584\u4EA7\u54C1\u5728\u5168\u7403\u5E02\u573A\u7684\u4F9B\u5E94\u80FD\u529B\u3002\u003C/p\u003E\n\u003Cp\u003E\u6B64\u5916\uFF0C\u5728\u5146\u9F99\u4E92\u8FDE(300913)\u62AB\u9732\u7684\u5B9A\u589E\u9884\u6848\u4E2D\uFF0C\u52DF\u6295\u9879\u76EE\u4E4B\u4E00\u5C31\u662F\u6CF0\u56FD\u751F\u4EA7\u57FA\u5730\u5EFA\u8BBE\u9879\u76EE\u3002\u516C\u53F8\u79F0\uFF0C\u8FD1\u5E74\u6765\uFF0C\u6CF0\u56FD\u79EF\u6781\u521B\u9020\u5BBD\u677E\u7684\u5916\u5546\u6295\u8D44\u73AF\u5883\uFF0C\u51ED\u501F\u7A0E\u6536\u3001\u571F\u5730\u7B49\u4F18\u60E0\u653F\u7B56\u4EE5\u53CA\u8425\u5546\u73AF\u5883\u5F00\u653E\u3001\u5DE5\u4E1A\u57FA\u7840\u8BBE\u65BD\u5B8C\u5907\u7B49\u4F18\u52BF\uFF0C\u6210\u4E3A\u56FD\u5185\u4F01\u4E1A\u201C\u8D70\u51FA\u53BB\u201D\u7684\u7406\u60F3\u843D\u811A\u70B9\u3002\u003C/p\u003E\n\u003Cp\u003E\u9884\u6848\u663E\u793A\uFF0C\u8BE5\u9879\u76EE\u603B\u6295\u8D446.6\u4EBF\u5143\uFF0C\u62DF\u901A\u8FC7\u5728\u6CF0\u56FD\u5EFA\u8BBE\u751F\u4EA7\u57FA\u5730\u5E76\u8D2D\u7F6E\u5148\u8FDB\u7684\u751F\u4EA7\u53CA\u6D4B\u8BD5\u8BBE\u5907\uFF0C\u65B0\u589E\u6570\u636E\u7535\u7F0620\u4E07\u516C\u91CC\u3001\u9AD8\u901F\u7535\u7F06\u53CA\u5DE5\u4E1A\u7535\u7F066.6\u4E07\u516C\u91CC\u3001\u8FDE\u63A5\u4EA7\u54C1850\u4E07\u6761\u7684\u4EA7\u80FD\uFF0C\u63D0\u5347\u5146\u9F99\u4E92\u8FDE\u6570\u636E\u7535\u7F06\u3001\u4E13\u7528\u7535\u7F06\u53CA\u8FDE\u63A5\u4EA7\u54C1\u7684\u751F\u4EA7\u80FD\u529B\uFF0C\u4E3B\u8981\u6EE1\u8DB3\u6D77\u5916\u5E02\u573A\u7684\u53D1\u5C55\u9700\u6C42\u3002\u003C/p\u003E\n\u003Cp\u003E\u5146\u9F99\u4E92\u8FDE\u79F0\uFF0C\u8BE5\u9879\u76EE\u662F\u516C\u53F8\u5B8C\u5584\u5168\u7403\u4E1A\u52A1\u5E03\u5C40\u7684\u91CD\u8981\u4E3E\u63AA\uFF0C\u5C06\u52A9\u529B\u516C\u53F8\u8FDB\u4E00\u6B65\u5F00\u62D3\u6D77\u5916\u5E02\u573A\u3002\u516C\u53F8\u8FD8\u8C08\u5230\uFF0C\u8FD1\u5E74\u6765\u56FD\u9645\u8D38\u6613\u5F62\u52BF\u590D\u6742\u591A\u53D8\uFF0C\u4E3A\u964D\u4F4E\u8D38\u6613\u4E89\u7AEF\u5BF9\u51FA\u53E3\u4E1A\u52A1\u7684\u5F71\u54CD\uFF0C\u901A\u8FC7\u5728\u6D77\u5916\u6295\u8D44\u5EFA\u5382\u4EE5\u6784\u5EFA\u5168\u7403\u5316\u4EA4\u4ED8\u57FA\u5730\u3001\u6EE1\u8DB3\u4EA7\u4E1A\u94FE\u5168\u7403\u5316\u9700\u6C42\uFF0C\u63D0\u9AD8\u516C\u53F8\u5728\u6D77\u5916\u5E02\u573A\u7684\u54CD\u5E94\u901F\u5EA6\uFF0C\u63D0\u5347\u5E94\u5BF9\u5168\u7403\u653F\u6CBB\u7ECF\u6D4E\u5F62\u52BF\u53D8\u5316\u7684\u6297\u98CE\u9669\u80FD\u529B\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E3A\u4F55\u4E0A\u5E02\u516C\u53F8\u7EB7\u7EB7\u5C06\u76EE\u5149\u7784\u51C6\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\uFF1F\u4E2D\u4FE1\u8BC1\u5238\u8FD1\u671F\u7684\u62A5\u544A\u6216\u8BB8\u80FD\u8BF4\u660E\u4E00\u4E9B\u539F\u56E0\u3002\u8BE5\u673A\u6784\u6307\u51FA\uFF0C\u4ECE\u8FD1\u5E74\u6765\u7684\u8D38\u6613\u6570\u636E\u770B\uFF0C\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u5408\u4F5C\u4FC3\u8FDB\u6211\u56FD\u4F9B\u5E94\u94FE\u97E7\u6027\u63D0\u5347\u3002\u4E00\u65B9\u9762\uFF0C\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u5171\u5EFA\u56FD\u5BB6\u7684\u8D44\u6E90\u7980\u8D4B\u4E0E\u6211\u56FD\u4F9B\u5E94\u94FE\u77ED\u677F\u7684\u4E92\u8865\u4F5C\u7528\u660E\u663E\uFF0C\u4E14\u8FD1\u5341\u5E74\u5BF9\u6211\u56FD\u591A\u6570\u77ED\u677F\u4EA7\u54C1\u7684\u4F9B\u5E94\u6BD4\u91CD\u660E\u663E\u63D0\u5347\uFF1B\u53E6\u4E00\u65B9\u9762\uFF0C\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u5408\u4F5C\u6709\u6548\u63D0\u5347\u6211\u56FD\u65B0\u80FD\u6E90\u3001\u6D88\u8D39\u7535\u5B50\u3001\u822A\u5929\u6838\u80FD\u3001\u9AD8\u7AEF\u5236\u9020\u7B49\u5173\u952E\u4EA7\u4E1A\u7684\u4F9B\u5E94\u94FE\u5B89\u5168\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E2D\u4FE1\u8BC1\u5238\u8FD8\u63D0\u5230\uFF0C\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u5171\u5EFA\u56FD\u5BB6\u4E5F\u5206\u4EAB\u4E86\u6211\u56FD\u5168\u4EA7\u4E1A\u94FE\u751F\u4EA7\u80FD\u529B\uFF0C\u6211\u56FD\u5916\u8D38\u4EA7\u4E1A\u7ED3\u6784\u987A\u5E94\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u5171\u5EFA\u56FD\u5BB6\u7684\u9700\u6C42\u505A\u4E86\u79EF\u6781\u6539\u53D8\uFF0C\u8026\u5408\u6027\u8FDB\u4E00\u6B65\u589E\u5F3A\uFF0C\u4E3A\u5171\u5EFA\u56FD\u5BB6\u63D0\u4F9B\u9AD8\u8D28\u91CF\u6709\u6548\u4F9B\u7ED9\u3002\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u5171\u5EFA\u56FD\u5BB6\u7684\u53D1\u5C55\u9884\u8BA1\u5C06\u6709\u6548\u63D0\u5347\u6211\u56FD\u5916\u9700\u7A7A\u95F4\uFF0C\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u5171\u5EFA\u56FD\u5BB6\u7ECF\u6D4E\u53D1\u5C55\u7684\u8FFD\u8D76\u6548\u5E94\u660E\u663E\uFF0C\u5916\u8D38\u9700\u6C42\u589E\u957F\u66F4\u5FEB\u3002\u003C/p\u003E\n\u003Cp\u003E\u636E\u8BB0\u8005\u4E0D\u5B8C\u5168\u7EDF\u8BA1\uFF0C11\u6708\u4EE5\u6765\uFF0C\u8FD8\u6709\u591A\u5BB6\u4E0A\u5E02\u516C\u53F8\u5BA3\u5E03\u5728\u4E1C\u5357\u4E9A\u56FD\u5BB6\u6295\u8D44\u3002\u5176\u4E2D\uFF0C\u6C38\u827A\u80A1\u4EFD(603600)\u8BA1\u5212\u4EE55000\u4E07\u7F8E\u5143\u6295\u8D44\u5EFA\u8BBE\u7B2C\u4E09\u671F\u8D8A\u5357\u751F\u4EA7\u57FA\u5730\u9879\u76EE\uFF1B\u8054\u5316\u79D1\u6280(002250)\u8BA1\u5212\u4EE5\u81EA\u6709\u8D44\u91D1\u548C\u81EA\u7B79\u8D44\u91D1\u51FA\u8D44\u4E0D\u8D85\u8FC72\u4EBF\u7F8E\u5143\uFF0C\u7528\u4E8E\u5EFA\u8BBE\u9A6C\u6765\u897F\u4E9A\u5DE5\u5382\u7B49\u4E8B\u5B9C\uFF1B\u79D1\u601D\u80A1\u4EFD(300856)\u62DF7.11\u4EBF\u5143\u6295\u8D44\u5EFA\u8BBE\u201C\u9A6C\u6765\u897F\u4E9A\u5E74\u4EA71\u4E07\u5428\u9632\u6652\u7CFB\u5217\u4EA7\u54C1\u9879\u76EE\u201D\u3002\u003C/p\u003E\n\u003Cp\u003E\n\n\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/zoDohUr1iyZrFTjfBCHMqQ\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
