  "route": "/4130/",
  "title": "\u5927\u9A6C\u9996\u76F8\u5B89\u534E\uFF1A\u7B80\u5316\u7A0B\u5E8F\u3000\u52A0\u5FEB\u5404\u5DDE\u57FA\u7840\u8BBE\u65BD\u53D1\u5C55",
  "summary": "\uFF08\u5409\u9686\u576126\u65E5\u8BAF\uFF09\u9996\u76F8\u62FF\u7763\u65AF\u91CC\u5B89\u534E\u8868\u793A\uFF0C\u7B80\u5316\u8054\u90A6\u653F\u5E9C\u4E0E\u5404\u5DDE\u7684\u7A0B\u5E8F\uFF0C\u52A0\u5FEB\u5404\u5DDE\u7684\u53D1\u5C55\u548C\u57FA\u7840\u8BBE\u65BD\uFF0C\u975E\u5E38\u91CD\u8981\uFF0C\u4F8B\u5982\u8F6C\u8BA9\u571F\u5730\u6743\u3002 \u201C\u6B64\u5916\uFF0C\u7ECF\u6D4E\u8D70\u5ECA\u7684\u89C4\u5212\u548C\u53D1\u5C55\uFF0C\u8FD8\u9700\u8003\u8651\u4E0E\u90BB\u56FD\u7684\u89C4\u5212\u548C\u53D1\u5C55\u6F5C\u529B\uFF61\u201D \u4ED6\u6628\u65E5\u662F\u5728\u4E3B\u6301\u4E86\u5317\u9A6C\u7ECF\u6D4E\u8D70\u5ECA\u6267\u884C\u673A\u6784\u3001\u4F9D\u65AF\u5E72\u8FBE\u7279\u533A\u53D1\u5C55\u673A\u6784\u548C\u4E1C\u6D77\u5CB8\u7ECF\u6D4E\u7279\u533A\u53D1\u5C55\u59D4\u5458\u4F1A\u8054\u5408\u4F1A\u8BAE\u540E\uFF0C\u5982\u662F\u6307\u51FA\u3002 \u5B89\u534E\u4E5F\u662F\u8D22\u653F\u90E8\u957F\uFF0C\u4ED6\u8BF4\uFF0C\u4E3A\u4E86\u914D\u5408\u660C\u660E\u7ECF\u6D4E\u7684\u8BAE\u7A0B\uFF0C\u653F\u5E9C\u4E5F\u51B3\u5B9A\u5B9E\u65BD\u9F13\u52B1\u6295\u8D44\u673A\u6784\u5408\u7406\u5316\u3002 \u201C\u8D70\u5ECA\u7BA1\u7406\u5C40\u5C06\u4E13\u6CE8\u4E8E\u652F\u6301\u6295\u8D44\u7684\u5B9E\u73B0\uFF61\u201D \u4ED6\u6307\u51FA\uFF0C\u4FC3\u9500\u548C\u6295\u8D44\u6FC0\u52B1\u7684\u6D3B\u52A8\u5C06\u7531\u9A6C\u6765\u2026",
  "body": "\u003Cp\u003E\uFF08\u5409\u9686\u576126\u65E5\u8BAF\uFF09\u9996\u76F8\u62FF\u7763\u65AF\u91CC\u5B89\u534E\u8868\u793A\uFF0C\u7B80\u5316\u8054\u90A6\u653F\u5E9C\u4E0E\u5404\u5DDE\u7684\u7A0B\u5E8F\uFF0C\u52A0\u5FEB\u5404\u5DDE\u7684\u53D1\u5C55\u548C\u57FA\u7840\u8BBE\u65BD\uFF0C\u975E\u5E38\u91CD\u8981\uFF0C\u4F8B\u5982\u8F6C\u8BA9\u571F\u5730\u6743\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6B64\u5916\uFF0C\u7ECF\u6D4E\u8D70\u5ECA\u7684\u89C4\u5212\u548C\u53D1\u5C55\uFF0C\u8FD8\u9700\u8003\u8651\u4E0E\u90BB\u56FD\u7684\u89C4\u5212\u548C\u53D1\u5C55\u6F5C\u529B\uFF61\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6628\u65E5\u662F\u5728\u4E3B\u6301\u4E86\u5317\u9A6C\u7ECF\u6D4E\u8D70\u5ECA\u6267\u884C\u673A\u6784\u3001\u4F9D\u65AF\u5E72\u8FBE\u7279\u533A\u53D1\u5C55\u673A\u6784\u548C\u4E1C\u6D77\u5CB8\u7ECF\u6D4E\u7279\u533A\u53D1\u5C55\u59D4\u5458\u4F1A\u8054\u5408\u4F1A\u8BAE\u540E\uFF0C\u5982\u662F\u6307\u51FA\u3002\u003C/p\u003E\n\u003Cp\u003E\u5B89\u534E\u4E5F\u662F\u8D22\u653F\u90E8\u957F\uFF0C\u4ED6\u8BF4\uFF0C\u4E3A\u4E86\u914D\u5408\u660C\u660E\u7ECF\u6D4E\u7684\u8BAE\u7A0B\uFF0C\u653F\u5E9C\u4E5F\u51B3\u5B9A\u5B9E\u65BD\u9F13\u52B1\u6295\u8D44\u673A\u6784\u5408\u7406\u5316\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u8D70\u5ECA\u7BA1\u7406\u5C40\u5C06\u4E13\u6CE8\u4E8E\u652F\u6301\u6295\u8D44\u7684\u5B9E\u73B0\uFF61\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6307\u51FA\uFF0C\u4FC3\u9500\u548C\u6295\u8D44\u6FC0\u52B1\u7684\u6D3B\u52A8\u5C06\u7531\u9A6C\u6765\u897F\u4E9A\u6295\u8D44\u3001\u8D38\u6613\u548C\u5DE5\u4E1A\u90E8\uFF08MITI\uFF09\u901A\u8FC7\u9A6C\u6765\u897F\u4E9A\u5DE5\u4E1A\u53D1\u5C55\u5C40\uFF08MIDA\uFF09\u96C6\u4E2D\u5904\u7406\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u4E5F\u5206\u4EAB\u4E86\u4E8E\u5317\u9A6C\u7ECF\u6D4E\u8D702022\u5E74\u7D2F\u8BA1\u6295\u8D44\u603B\u989D\u8FBE1850\u4EBF\u4EE4\u5409\u7684\u6210\u5C31\uFF0C\u8FD9\u8D85\u8FC7\u4E862021\u5E74\u81F32025\u5E74\u671F\u95F41465\u4EBF\u4EE4\u5409\u7684\u76EE\u6807\uFF61 \u003C/p\u003E\n\u003Cp\u003E\u201C\u6B64\u5916\uFF0C\u9A6C\u6765\u897F\u4E9A\u4F9D\u65AF\u5E72\u8FBE\u7279\u533A\u7684\u627F\u8BFA\u6295\u8D44\u989D\u8FBE 4095 \u4EBF\u4EE4\u5409\uFF0C\u800C 2025 \u5E74\u5C06\u5B9E\u73B0\u7684\u76EE\u6807\u4E3A 3830 \u4EBF\u4EE4\u5409\u3002\u76EE\u524D, \u4E1C\u6D77\u5CB8\u7ECF\u6D4E\u5C06\u533A\u5DF2\u83B7\u5F97\u627F\u8BFA\u6295\u8D44\uFF0C\u6D89\u53CA\u603B\u989D1647\u4EBF\u4EE4\u5409\uFF61\u201D\u003C/p\u003E\n\u003Cp\u003E\u8BE5\u4F1A\u8BAE\u4E5F\u8BA8\u8BBA\u4E86\u5404\u7ECF\u6D4E\u8D70\u5ECA\u7684\u6295\u8D44\u548C\u57FA\u7840\u8BBE\u65BD\u53D1\u5C55\u72B6\u51B5\uFF0C\u800C\u4E09\u5927\u7ECF\u6D4E\u8D70\u5ECA\u6240\u7D2F\u8BA1\u7684\u6295\u8D44\uFF0C\u8FBE7592\u4EBF\u4EE4\u5409\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/jFO1q-EXknDHEIJUIEQcKA\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
