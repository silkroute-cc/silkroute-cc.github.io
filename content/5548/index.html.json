{
  "id": "%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e5%b7%b4%e7%94%9f%e6%b8%af%e5%8f%a3%e5%86%80%e4%bb%8a%e5%b9%b4%e5%a4%84%e7%90%861500%e4%b8%87%e8%b4%a7%e6%9f%9c",
  "slug": "%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e5%b7%b4%e7%94%9f%e6%b8%af%e5%8f%a3%e5%86%80%e4%bb%8a%e5%b9%b4%e5%a4%84%e7%90%861500%e4%b8%87%e8%b4%a7%e6%9f%9c",
  "canonicalUrlKey": "%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e5%b7%b4%e7%94%9f%e6%b8%af%e5%8f%a3%e5%86%80%e4%bb%8a%e5%b9%b4%e5%a4%84%e7%90%861500%e4%b8%87%e8%b4%a7%e6%9f%9c",
  "route": "/5548/",
  "title": "\u9A6C\u6765\u897F\u4E9A\u5DF4\u751F\u6E2F\u53E3\u5180\u4ECA\u5E74\u5904\u74061500\u4E07\u8D27\u67DC",
  "summary": "\u9646\u5146\u798F\u5728\u6E2F\u52A1\u5C40\u4E3E\u529E\u7684\u519C\u5386\u65B0\u5E74\u5348\u4F1A\uFF0C\u53EC\u5F00\u8BB0\u8005\u4F1A\u3002\u53F3\u4E3A\u6B27\u9633\u634D\u534E\u3002 \uFF08\u5DF4\u751F17\u65E5\u8BAF\uFF09\u4EA4\u901A\u90E8\u957F\u9646\u5146\u798F\u6307\u51FA\uFF0C2024\u5E74\u56FD\u5185\u6E2F\u53E3\u53D6\u5F97\u4EAE\u773C\u8868\u73B0\u540E\uFF0C\u6700\u5927\u6E2F\u53E3\u2014\u2014\u5DF4\u751F\u6E2F\u53E3\u4ECA\u5E74\u8BBE\u5B9A2.3%\u589E\u957F\u7684\u76EE\u6807\uFF0C\u6216\u5904\u74061500\u4E07\u6807\u51C6\u8D27\u67DC\u3002 \u201C\u56FD\u5185\u6E2F\u53E3\u7684\u5168\u5E74\u8D27\u67DC\u603B\u541E\u5410\u91CF\u8FBE3068\u4E07\u6807\u51C6\u8D27\u67DC\uFF08TEU\uFF09\uFF0C\u540C\u6BD4\u589E\u957F8.6%\u3002\u201D \u4ED6\u8BF4\uFF0C\u5C3D\u7BA1\u5168\u7403\u7ECF\u6D4E\u5F62\u52BF\u4E0D\u786E\u5B9A\uFF0C\u5DF4\u751F\u6E2F\u53E3\u8FC7\u53BB\u4E00\u5E74\u4ECD\u7A33\u5065\u589E\u957F\uFF0C\u8D27\u67DC\u541E\u5410\u91CF\u8FBE1464\u4E07\u6807\u51C6\u8D27\u67DC\uFF0C\u540C\u6BD4\u589E\u957F4.5%\uFF0C\u5360\u5168\u56FD\u8D27\u67DC\u541E\u5410\u91CF\u7684\u7EA647.7%\u3002 \u201C\u8FD9\u662F\u5DF4\u751F\u6E2F\u53E3\u81EA1\u2026",
  "body": "\u003Cp\u003E\u9646\u5146\u798F\u5728\u6E2F\u52A1\u5C40\u4E3E\u529E\u7684\u519C\u5386\u65B0\u5E74\u5348\u4F1A\uFF0C\u53EC\u5F00\u8BB0\u8005\u4F1A\u3002\u53F3\u4E3A\u6B27\u9633\u634D\u534E\u3002\u003C/p\u003E\n\u003Cp\u003E\uFF08\u5DF4\u751F17\u65E5\u8BAF\uFF09\u4EA4\u901A\u90E8\u957F\u9646\u5146\u798F\u6307\u51FA\uFF0C2024\u5E74\u56FD\u5185\u6E2F\u53E3\u53D6\u5F97\u4EAE\u773C\u8868\u73B0\u540E\uFF0C\u6700\u5927\u6E2F\u53E3\u2014\u2014\u5DF4\u751F\u6E2F\u53E3\u4ECA\u5E74\u8BBE\u5B9A2.3%\u589E\u957F\u7684\u76EE\u6807\uFF0C\u6216\u5904\u74061500\u4E07\u6807\u51C6\u8D27\u67DC\u3002 \u003C/p\u003E\n\u003Cp\u003E\u201C\u56FD\u5185\u6E2F\u53E3\u7684\u5168\u5E74\u8D27\u67DC\u603B\u541E\u5410\u91CF\u8FBE3068\u4E07\u6807\u51C6\u8D27\u67DC\uFF08TEU\uFF09\uFF0C\u540C\u6BD4\u589E\u957F8.6%\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u5C3D\u7BA1\u5168\u7403\u7ECF\u6D4E\u5F62\u52BF\u4E0D\u786E\u5B9A\uFF0C\u5DF4\u751F\u6E2F\u53E3\u8FC7\u53BB\u4E00\u5E74\u4ECD\u7A33\u5065\u589E\u957F\uFF0C\u8D27\u67DC\u541E\u5410\u91CF\u8FBE1464\u4E07\u6807\u51C6\u8D27\u67DC\uFF0C\u540C\u6BD4\u589E\u957F4.5%\uFF0C\u5360\u5168\u56FD\u8D27\u67DC\u541E\u5410\u91CF\u7684\u7EA647.7%\u3002 \u003C/p\u003E\n\u003Cp\u003E\u201C\u8FD9\u662F\u5DF4\u751F\u6E2F\u53E3\u81EA1973\u5E74\u5F00\u59CB\u8FD0\u8425\u8D27\u67DC\u4E1A\u52A1\u4EE5\u6765\u521B\u4E0B\u7684\u5386\u53F2\u65B0\u9AD8\u3002\u4E0D\u8FC7\uFF0C\u6211\u4E2A\u4EBA\u5E0C\u671B\u4ED6\u4EEC\u80FD\u591F\u66F4\u6709\u4FE1\u5FC3\uFF0C\u8FDB\u4E00\u6B65\u63D0\u5347\u4ECA\u5E74\u6240\u8BBE\u5B9A\u7684\u76EE\u6807\u3002\u201D \u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8868\u793A\uFF0C\u5DF4\u751F\u6E2F\u53E3\u8BBE\u5B9A\u589E\u957F\u76EE\u6807\u7684\u4F9D\u636E\u5305\u62EC\u56FD\u5185\u7ECF\u6D4E\u7684\u7A33\u5B9A\u589E\u957F\u3001\u57FA\u7840\u8BBE\u65BD\u9879\u76EE\u7684\u53D1\u5C55\u3001\u5236\u9020\u4E1A\u548C\u7269\u6D41\u4E1A\u7684\u8D27\u8FD0\u589E\u957F\uFF0C\u4EE5\u53CA\u653F\u5E9C\u5728\u7269\u6D41\u9886\u57DF\u63A8\u51FA\u7684\u6709\u5229\u8D38\u6613\u653F\u7B56\u3002 \u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u6709\u671B\u664B\u5168\u740310\u5F3A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u9646\u5146\u798F\u4E5F\u900F\u9732\uFF0C\u5DF4\u751F\u6E2F\u53E3\u5728\u5168\u7403\u8D27\u67DC\u6E2F\u53E3\u6392\u540D\u9884\u8BA1\u5C06\u4E0A\u5347\u81F3\u7B2C10\u4F4D\u3002\u867D\u7136\u5B98\u65B9\u6392\u540D\u9884\u8BA1\u5C06\u5728\u672A\u6765\u51E0\u4E2A\u6708\u5185\u516C\u5E03\uFF0C\u4F46\uFF0C\u636E\u6089\u9E7F\u7279\u4E39\u548C\u9999\u6E2F\u7B49\u7ADE\u4E89\u5BF9\u624B\u7684\u8D27\u67DC\u541E\u5410\u91CF\u5747\u4F4E\u4E8E\u5DF4\u751F\u6E2F\u53E3\u3002 \u003C/p\u003E\n\u003Cp\u003E\u201C\u9664\u4E86\u5DF4\u751F\u6E2F\u53E3\uFF0C\u4E39\u7ED2\u67CF\u52D2\u5DF4\u65AF\u6E2F\u53E3\u4E5F\u6709\u671B\u51ED\u501F2024\u5E741220\u4E07\u6807\u51C6\u8D27\u67DC\u7684\u541E\u5410\u91CF\uFF0C\u6392\u540D\u63D0\u5347\u81F3\u5168\u7403\u7B2C13\u4F4D\u3002\u201D \u003C/p\u003E\n\u003Cp\u003E\u4ED6\u5F3A\u8C03\uFF0C\u653F\u5E9C\u81F4\u529B\u4E8E\u63A8\u52A8\u4EA4\u901A\u548C\u7269\u6D41\u57FA\u7840\u8BBE\u65BD\u5EFA\u8BBE\uFF0C\u4F5C\u4E3A\u56FD\u5BB6\u8D38\u6613\u7684\u5173\u952E\u652F\u67F1\uFF0C\u4EE5\u4FC3\u8FDB\u8D38\u6613\u6D3B\u52A8\u5E76\u5438\u5F15\u66F4\u591A\u6295\u8D44\u8005\u4E0E\u6E38\u5BA2\u3002 \u003C/p\u003E\n\u003Cp\u003E\u201C\u9996\u76F8\u5728\u63D0\u54482025\u5E74\u8D22\u653F\u9884\u7B97\u6848\u65F6\uFF0C\u5BA3\u5E03\u62E8\u6B3E1\u4EBF700\u4E07\u4EE4\u5409\uFF0C\u7528\u4E8E\u5EFA\u8BBE\u548C\u5347\u7EA7\u82F1\u8FBE\u5C9B\u73AF\u8DEF\u53CA\u5317\u6E2F\u3002\u6B64\u5916\uFF0C\u653F\u5E9C\u4E5F\u9F13\u52B1\u7269\u6D41\u4F01\u4E1A\u53D1\u5C55\u667A\u80FD\u7269\u6D41\u4E2D\u5FC3\uFF0C\u5E76\u63D0\u4F9B\u4E3A\u671F5\u5E74\u768460%\u6295\u8D44\u7A0E\u6536\u51CF\u514D\uFF0C\u4EE5\u63D0\u5347\u7269\u6D41\u884C\u4E1A\u7684\u6574\u4F53\u4EA7\u80FD\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u6D77\u4E8B\u5355\u4E00\u7A97\u53E3\u63A8\u5E7F\u5168\u56FD\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u5728\u5DF4\u751F\u6E2F\u53E3\u4F18\u5148\u63A8\u884C\u540E\uFF0C\u7EBF\u4E0A\u7533\u8BF7\u670D\u52A1\u7CFB\u7EDF\u5927\u9A6C\u6D77\u4E8B\u5355\u4E00\u7A97\u53E3\u4ECA\u5E74\u4E5F\u5168\u9762\u63A8\u5E7F\u81F3\u5168\u56FD\u5176\u4ED6\u4E3B\u8981\u6E2F\u53E3\uFF0C\u4EE5\u63D0\u5347\u5927\u9A6C\u822A\u8FD0\u8D38\u6613\u6548\u7387\u3002\u003C/p\u003E\n\u003Cp\u003E\u9646\u5146\u798F\u8868\u793A\uFF0C\u8BE5\u7CFB\u7EDF\u63D0\u4F9B\u7EDF\u4E00\u7684\u7EBF\u4E0A\u5E73\u53F0\uFF0C\u7B80\u5316\u548C\u6570\u4F4D\u5316\u6E2F\u53E3\u6E05\u5173\u6D41\u7A0B\uFF0C\u4EE5\u63D0\u9AD8\u900F\u660E\u5EA6\u3001\u6210\u672C\u6548\u7387\uFF0C\u4EE5\u53CA\u52A0\u5FEB\u8D27\u7269\u8FD0\u8F93\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u5DF4\u751F\u6E2F\u53E3\u57282024\u5E74\u521D\u63A8\u884C\u540E\uFF0C\u6839\u636E\u6570\u636E\uFF0C\u4ECE2024\u5E746\u67081\u65E5\u81F312\u670831\u65E5\uFF0C\u5171\u67091\u4E07682\u8258\u8239\u53EA\u4F7F\u7528\u8BE5\u7CFB\u7EDF\u8FDB\u884C\u62B5\u8FBE\u548C\u79BB\u6E2F\u4E8B\u52A1\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6307\u51FA\uFF0C\u968F\u7740\u8D8A\u6765\u8D8A\u591A\u7684\u79C1\u4EBA\u6E2F\u53E3\u548C\u7801\u5934\u91C7\u7528\u8BE5\u7CFB\u7EDF\uFF0C\u8FD9\u4E00\u6570\u5B57\u9884\u8BA1\u5C06\u4F1A\u4E0D\u65AD\u589E\u52A0\u3002\u4EA4\u901A\u90E8\u9F13\u52B1\u6240\u6709\u6E2F\u53E3\u7528\u6237\u6700\u5927\u9650\u5EA6\u5730\u5229\u7528MMSW\u7684\u4FBF\u5229\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6B64\u5916\uFF0C\u901A\u8FC7\u7528\u6237\u7684\u56DE\u9988\u8BC1\u5B9E\uFF0C\u900F\u8FC7\u6570\u5B57\u5316\u8FD0\u4F5C\uFF0C\u663E\u8457\u63D0\u9AD8\u4E86\u6548\u7387\uFF0C\u4E5F\u51CF\u5C11\u5B98\u50DA\u4F5C\u98CE\uFF0C\u5E76\u7B80\u5316\u6E2F\u53E3\u6E05\u5173\u6D41\u7A0B\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8865\u5145\uFF0C\u8BE5\u90E8\u8BA1\u5212\u7EE7\u7EED\u5C06\u5927\u9A6C\u6D77\u4E8B\u5355\u4E00\u7A97\u53E3\u7CFB\u7EDF\u6269\u5C55\u5230\u7B2C\u4E8C\u9636\u6BB5\uFF0C\u5305\u62EC\u8D27\u67DC\u8FFD\u8E2A\u548C\u76D1\u63A7\u529F\u80FD\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5DF4\u751F\u6E2F\u52A1\u5C40\u63A8\u57F9\u8BAD\u8BA1\u5212\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u89E3\u51B3\u7269\u6D41\u9886\u57DF\u4EBA\u529B\u77ED\u7F3A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u5DF4\u751F\u6E2F\u52A1\u5C40\u4E3B\u5E2D\u6B27\u9633\u634D\u534E\u8868\u793A\uFF0C\u6E2F\u52A1\u5C40\u59CB\u7EC8\u81F4\u529B\u4E8E\u63A8\u52A8\u6E2F\u53E3\u53CA\u7269\u6D41\u4EA7\u4E1A\u7684\u6301\u7EED\u53D1\u5C55\uFF0C\u4EE5\u786E\u4FDD\u6E2F\u53E3\u8FD0\u8425\u9AD8\u6548\u4E14\u670D\u52A1\u4F18\u8D28\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u900F\u9732\uFF0C\u4E3A\u5E94\u5BF9\u884C\u4E1A\u9762\u4E34\u7684\u4EBA\u529B\u8D44\u6E90\u77ED\u7F3A\u95EE\u9898\uFF0C\u6E2F\u52A1\u5C40\u53BB\u5E74\u79EF\u6781\u5B9E\u65BD\u591A\u9879\u57F9\u8BAD\u8BA1\u5212\uFF0C\u5176\u4E2D\u5305\u62EC\u57F9\u517B500\u540D\u6301\u6709E\u6267\u7167\u6216GDL\u6267\u7167\u7684\u53F8\u673A\u3002\u540C\u65F6\u8FD8\u5F00\u8BBE\u4E86D\u9A7E\u7167\u57F9\u8BAD\u8BFE\u7A0B\uFF0C\u4E3A200\u540D\u6BD5\u4E1A\u751F\u63D0\u4F9B\u4E86\u5B9D\u8D35\u7684\u5C31\u4E1A\u673A\u4F1A\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u8FD9\u4E9B\u4E3E\u63AA\u662F\u6E2F\u52A1\u5C40\u4E0E\u4EA4\u901A\u90E8\u3001\u4EBA\u529B\u8D44\u6E90\u90E8\u53CA\u5176\u4ED6\u76F8\u5173\u90E8\u95E8\u5408\u4F5C\u7684\u6210\u679C\uFF0C\u65E8\u5728\u57F9\u517B\u4E13\u4E1A\u7684\u8D27\u8FD0\u53F8\u673A\u548C\u6E2F\u53E3\u5DE5\u4EBA\uFF0C\u4EE5\u6EE1\u8DB3\u884C\u4E1A\u4E0D\u65AD\u589E\u957F\u7684\u4EBA\u529B\u9700\u6C42\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8FD8\u8868\u793A\uFF0C\u914D\u5408\u653F\u5E9C\u63A8\u884C\u7684\u56FD\u5BB6\u80FD\u6E90\u8F6C\u578B\u8DEF\u7EBF\u56FE\uFF08NETR\uFF09\uFF0C\u6E2F\u52A1\u5C40\u4E5F\u79EF\u6781\u63A8\u52A8\u6E2F\u53E3\u91C7\u53D6\u4F4E\u78B3\u8FD0\u8425\u6218\u7565\uFF0C\u5F53\u4E2D\u5305\u62EC\u9F13\u52B1\u4F7F\u7528\u7535\u52A8\u8D27\u8F66\u3001\u6269\u5927\u592A\u9633\u80FD\u5E94\u7528\uFF0C\u5E76\u63D0\u5347\u5DF4\u751F\u6E2F\u53CA\u5DF4\u751F\u6E2F\u53E3\u81EA\u8D38\u533A\u7684\u518D\u751F\u80FD\u6E90\u6BD4\u4F8B\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u8FD9\u4E9B\u63AA\u65BD\u4E0D\u4EC5\u6709\u52A9\u4E8E\u964D\u4F4E\u8FD0\u8425\u6210\u672C\uFF0C\u8FD8\u5C06\u8FDB\u4E00\u6B65\u5DE9\u56FA\u5DF4\u751F\u6E2F\u4F5C\u4E3A\u2018\u7EFF\u8272\u667A\u6167\u6E2F\u53E3\u2019\u7684\u9886\u5148\u5730\u4F4D\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/GW38fKcE3MXLZNRFiZG97w\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
