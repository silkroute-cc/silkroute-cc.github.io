  "route": "/3984/",
  "title": "\u5185\u9601\u8BAE\u51B3\u65C5\u6E38\u90E8\u63A5\u624BMM2H\u63A8\u5E7F\u5DE5\u4F5C\u3000\u65B0\u89C4\u5219\u4E00\u81F3\u4E24\u5468\u5185\u516C\u5E03",
  "summary": "\uFF08\u5409\u9686\u576124\u65E5\u8BAF\uFF09\u65C5\u6E38\u3001\u827A\u672F\u53CA\u6587\u5316\u90E8\u957F\u62FF\u7763\u65AF\u91CC\u5F20\u5E86\u4FE1\u6307\u51FA\uFF0C\u7ECF\u5185\u9601\u51B3\u8BAE\u7531\u8BE5\u90E8\u63A5\u624B\u6211\u56FD\u201C\u7B2C\u4E8C\u5BB6\u56ED\u8BA1\u5212\u201D\uFF08MM2H\uFF09\u7684\u63A8\u5E7F\u4E0E\u5BA3\u4F20\u5DE5\u4F5C\uFF0C\u4EE5\u843D\u5B9E\u653F\u5E9C\u7684\u613F\u666F\uFF0C\u5C06\u5927\u9A6C\u6253\u9020\u6210\u4E16\u754C\u5404\u56FD\u7684\u9996\u9009\u5730\u3002 \u4ED6\u8868\u793A\uFF0C\u8BE5\u90E8\u5C06\u4F1A\u628A\u5FC5\u8981\u7684\u7533\u8BF7\u6587\u4EF6\u6574\u5408\uFF0C\u7EDF\u4E00\u4EA4\u7531\u5185\u653F\u90E8\u8FDB\u884C\u5BA1\u6279\u3002 \u201C\u6211\u5E0C\u671B\u900F\u8FC7\u8FD9\u9879\u65B0\u51B3\u8BAE\uFF0C\u80FD\u591F\u63D0\u5347\u670D\u52A1\u8D28\u91CF\u4E0E\u7533\u8BF7\u6548\u7387\uFF0C\u4ECE\u800C\u5B9E\u73B0\u653F\u5E9C\u7684\u613F\u666F\uFF0C\u4F7F\u9A6C\u6765\u897F\u4E9A\u6210\u4E3A\u56FD\u9645\u793E\u4F1A\uFF0C\u7279\u522B\u662F\u533A\u57DF\u5185\u56FD\u5BB6\u7684\u9996\u9009\u76EE\u7684\u5730\u3002\u201D \u4ED6\u6566\u4FC3\uFF0C\u5168\u56FD\u8303\u56F4\u7684\u65C5\u6E38\u5C40\u529E\u4E8B\u5904\u4E0E\u673A\u6784\u80FD\u591F\u53D1\u6325\u4F5C\u7528\u63A8\u5E7F\u9A6C\u6765\u897F\u4E9A\uFF0C\u4E3A\u56FD\u5BB6\u4E0E\u4EBA\u6C11\u5E26\u6765\u5229\u76CA\u3002 \u201C\u8BA9\u2026",
  "body": "\u003Cp\u003E\uFF08\u5409\u9686\u576124\u65E5\u8BAF\uFF09\u65C5\u6E38\u3001\u827A\u672F\u53CA\u6587\u5316\u90E8\u957F\u62FF\u7763\u65AF\u91CC\u5F20\u5E86\u4FE1\u6307\u51FA\uFF0C\u7ECF\u5185\u9601\u51B3\u8BAE\u7531\u8BE5\u90E8\u63A5\u624B\u6211\u56FD\u201C\u7B2C\u4E8C\u5BB6\u56ED\u8BA1\u5212\u201D\uFF08MM2H\uFF09\u7684\u63A8\u5E7F\u4E0E\u5BA3\u4F20\u5DE5\u4F5C\uFF0C\u4EE5\u843D\u5B9E\u653F\u5E9C\u7684\u613F\u666F\uFF0C\u5C06\u5927\u9A6C\u6253\u9020\u6210\u4E16\u754C\u5404\u56FD\u7684\u9996\u9009\u5730\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8868\u793A\uFF0C\u8BE5\u90E8\u5C06\u4F1A\u628A\u5FC5\u8981\u7684\u7533\u8BF7\u6587\u4EF6\u6574\u5408\uFF0C\u7EDF\u4E00\u4EA4\u7531\u5185\u653F\u90E8\u8FDB\u884C\u5BA1\u6279\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u5E0C\u671B\u900F\u8FC7\u8FD9\u9879\u65B0\u51B3\u8BAE\uFF0C\u80FD\u591F\u63D0\u5347\u670D\u52A1\u8D28\u91CF\u4E0E\u7533\u8BF7\u6548\u7387\uFF0C\u4ECE\u800C\u5B9E\u73B0\u653F\u5E9C\u7684\u613F\u666F\uFF0C\u4F7F\u9A6C\u6765\u897F\u4E9A\u6210\u4E3A\u56FD\u9645\u793E\u4F1A\uFF0C\u7279\u522B\u662F\u533A\u57DF\u5185\u56FD\u5BB6\u7684\u9996\u9009\u76EE\u7684\u5730\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6566\u4FC3\uFF0C\u5168\u56FD\u8303\u56F4\u7684\u65C5\u6E38\u5C40\u529E\u4E8B\u5904\u4E0E\u673A\u6784\u80FD\u591F\u53D1\u6325\u4F5C\u7528\u63A8\u5E7F\u9A6C\u6765\u897F\u4E9A\uFF0C\u4E3A\u56FD\u5BB6\u4E0E\u4EBA\u6C11\u5E26\u6765\u5229\u76CA\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u8BA9\u6211\u4EEC\u52AA\u529B\u5438\u5F15\u56FD\u9645\u793E\u4F1A\u7684\u5174\u8DA3\u6765\u53C2\u4E0E\u8FD9\u9879\u8BA1\u5212\uFF0C\u7279\u522B\u662F\u5177\u6709\u7ECF\u6D4E\u6F5C\u529B\u7684\u9AD8\u8D28\u91CF\u7533\u8BF7\u8005\uFF0C\u4ECE\u800C\u4E3A\u6211\u56FD\u7ECF\u6D4E\u589E\u957F\u4F5C\u51FA\u8D21\u732E\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u5F20\u5E86\u4FE1\u6628\u591C\u900F\u8FC7\u9762\u5B50\u4E66\u8D34\u6587\u5982\u662F\u8BF4\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u63D0\u53CA\uFF0C\u81EA\u5DF1\u5DF2\u6307\u793A\u90E8\u95E8\u79D8\u4E66\u957F\u62FF\u7763\u7F57\u65AF\u5170\u963F\u90FD\u62C9\u66FC\uFF0C\u4E0E\u5185\u653F\u90E8\u79D8\u4E66\u957F\u62FF\u7763\u9C81\u57FA\u4F1A\u9762\uFF0C\u5C31\u7533\u8BF7\u7A0B\u5E8F\u7684\u6807\u51C6\u4E0E\u6761\u4EF6\u8FDB\u884C\u5BA1\u67E5\uFF0C\u540C\u65F6\u5B8C\u5584\u8BA1\u5212\u7684\u5BA3\u4F20\u5DE5\u4F5C\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u7A0B\u5E8F\u4E0E\u6761\u4EF6\u5C06\u5728\u4E00\u5468\u81F3\u4E24\u5468\u5185\u6572\u5B9A\u5E76\u516C\u5E03\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u5F20\u5E86\u4FE1\u5F3A\u8C03\uFF0C\u6253\u7B97\u53C2\u4E0E\u8BA1\u5212\u7684\u65C5\u884C\u793E\u4E0E\u884C\u4E1A\u53C2\u4E0E\u8005\u9700\u5728\u65C5\u6E38\u3001\u827A\u672F\u53CA\u6587\u5316\u90E8\u8FDB\u884C\u6CE8\u518C\uFF0C\u4EE5\u786E\u4FDD\u4E0D\u4F1A\u6709\u4E0D\u8D1F\u8D23\u4EFB\u8005\u635F\u5BB3\u7B2C\u4E8C\u5BB6\u56ED\u8BA1\u5212\u7684\u58F0\u8A89\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u65C5\u6E38\u3001\u827A\u672F\u53CA\u6587\u5316\u90E8\u8F96\u4E0B\u7684\u673A\u6784\u8FD8\u9700\u6EE1\u8DB3\u5404\u90E8\u95E8\u5236\u5B9A\u7684\u5173\u952E\u7EE9\u6548\u6307\u6807\uFF0C\u786E\u4FDD\u7B2C\u4E8C\u5BB6\u56ED\u8BA1\u5212\u7684\u63A8\u5E7F\uFF0C\u4EE5\u4FC3\u8FDB\u56FD\u5BB6\u7ECF\u6D4E\u589E\u957F\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/Up4kWZH1LIYe4E3r-hnwRA\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
