{
  "id": "%e6%9d%a5%e5%9b%b4%e8%a7%82%ef%bc%81%e5%8f%88%e4%b8%80%e4%b8%aa%e6%8a%95%e8%b5%8420%e4%ba%bf%e4%bb%a4%e5%90%89%e7%9a%84%e6%95%b0%e6%8d%ae%e4%b8%ad%e5%bf%83%e9%a1%b9%e7%9b%ae",
  "slug": "%e6%9d%a5%e5%9b%b4%e8%a7%82%ef%bc%81%e5%8f%88%e4%b8%80%e4%b8%aa%e6%8a%95%e8%b5%8420%e4%ba%bf%e4%bb%a4%e5%90%89%e7%9a%84%e6%95%b0%e6%8d%ae%e4%b8%ad%e5%bf%83%e9%a1%b9%e7%9b%ae",
  "canonicalUrlKey": "%e6%9d%a5%e5%9b%b4%e8%a7%82%ef%bc%81%e5%8f%88%e4%b8%80%e4%b8%aa%e6%8a%95%e8%b5%8420%e4%ba%bf%e4%bb%a4%e5%90%89%e7%9a%84%e6%95%b0%e6%8d%ae%e4%b8%ad%e5%bf%83%e9%a1%b9%e7%9b%ae",
  "route": "/3788/",
  "title": "\u6765\u56F4\u89C2\uFF01\u53C8\u4E00\u4E2A\u6295\u8D4420\u4EBF\u4EE4\u5409\u7684\u6570\u636E\u4E2D\u5FC3\u9879\u76EE",
  "summary": "\uFF08\u5409\u9686\u576123\u65E5\u8BAF\uFF09\u4E9A\u6D32\u9886\u5148\u6570\u636E\u4E2D\u5FC3\u63D0\u4F9B\u5546\u666E\u5E73\u6570\u636E\u96C6\u56E2\uFF08PDG\uFF09\u548C\u67D4\u4F5B\u673A\u6784\u65D7\u4E0B\u5168\u8D44\u5B50\u516C\u53F8\u67D4\u4F5B\u7F6E\u5730\u96C6\u56E2\uFF08JLG\uFF09\u7B7E\u7F72\u534F\u8BAE\uFF0C\u6536\u8D2D\u67D4\u4F5B\u5DDE\u58EB\u5E74\u7EB3\u79D1\u6280\u56ED\uFF08STep\uFF09\u4E00\u590431\u82F1\u4EA9\u7684\u571F\u5730\uFF0C\u4EE5\u65A5\u8D44\u7EA620\u4EBF\u4EE4\u5409\u5EFA\u8BBE150\u5146\u74E6\u7684\u8D85\u5927\u89C4\u6A21\u6570\u636E\u4E2D\u5FC3\u56ED\u533A\u3002 \u5176\u4E2D\uFF0C\u9879\u76EE\u7684\u9996\u671F60\u5146\u74E6\u7684\u5DE5\u7A0B\u8BA1\u5212\u9884\u8BA1\u5C06\u5728\u660E\u5E74\u7B2C\u4E8C\u5B63\u5EA6\u5F00\u59CB\u8FD0\u4F5C\u3002 \u6B64\u6570\u636E\u4E2D\u5FC3\u547D\u540D\u4E3AJH1\uFF0C\u5C06\u662F\u4E1C\u5357\u4E9A\u89C4\u6A21\u6700\u5927\u7684\u6570\u636E\u56ED\u4E4B\u4E00\uFF0C\u5B83\u5C06\u6EE1\u8DB3\u4E9A\u592A\u5730\u533A\u5BA2\u6237\u7684\u57FA\u7840\u8BBE\u65BD\u9700\u6C42\u3002 \u666E\u5E73\u6570\u636E\u96C6\u56E2\u4E0E\u67D4\u4F5B\u7F6E\u5730\u96C6\u56E2\u6628\u65E5\u5728\u5409\u9686\u5761\u4E3E\u884C\u7B7E\u7EA6\u4EEA\u5F0F\uFF0C\u7531\u67D4\u4F5B\u5DDE\u52A1\u5927\u81E3\u517C\u67D4\u4F5B\u673A\u6784\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/05/frc-84eeaecf7985cc523de80c8d82eddbeb.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\uFF08\u5409\u9686\u576123\u65E5\u8BAF\uFF09\u4E9A\u6D32\u9886\u5148\u6570\u636E\u4E2D\u5FC3\u63D0\u4F9B\u5546\u666E\u5E73\u6570\u636E\u96C6\u56E2\uFF08PDG\uFF09\u548C\u67D4\u4F5B\u673A\u6784\u65D7\u4E0B\u5168\u8D44\u5B50\u516C\u53F8\u67D4\u4F5B\u7F6E\u5730\u96C6\u56E2\uFF08JLG\uFF09\u7B7E\u7F72\u534F\u8BAE\uFF0C\u6536\u8D2D\u67D4\u4F5B\u5DDE\u58EB\u5E74\u7EB3\u79D1\u6280\u56ED\uFF08STep\uFF09\u4E00\u590431\u82F1\u4EA9\u7684\u571F\u5730\uFF0C\u4EE5\u65A5\u8D44\u7EA620\u4EBF\u4EE4\u5409\u5EFA\u8BBE150\u5146\u74E6\u7684\u8D85\u5927\u89C4\u6A21\u6570\u636E\u4E2D\u5FC3\u56ED\u533A\u3002\u003C/p\u003E\n\u003Cp\u003E\u5176\u4E2D\uFF0C\u9879\u76EE\u7684\u9996\u671F60\u5146\u74E6\u7684\u5DE5\u7A0B\u8BA1\u5212\u9884\u8BA1\u5C06\u5728\u660E\u5E74\u7B2C\u4E8C\u5B63\u5EA6\u5F00\u59CB\u8FD0\u4F5C\u3002\u003C/p\u003E\n\u003Cp\u003E\u6B64\u6570\u636E\u4E2D\u5FC3\u547D\u540D\u4E3AJH1\uFF0C\u5C06\u662F\u4E1C\u5357\u4E9A\u89C4\u6A21\u6700\u5927\u7684\u6570\u636E\u56ED\u4E4B\u4E00\uFF0C\u5B83\u5C06\u6EE1\u8DB3\u4E9A\u592A\u5730\u533A\u5BA2\u6237\u7684\u57FA\u7840\u8BBE\u65BD\u9700\u6C42\u3002\u003C/p\u003E\n\u003Cp\u003E\u666E\u5E73\u6570\u636E\u96C6\u56E2\u4E0E\u67D4\u4F5B\u7F6E\u5730\u96C6\u56E2\u6628\u65E5\u5728\u5409\u9686\u5761\u4E3E\u884C\u7B7E\u7EA6\u4EEA\u5F0F\uFF0C\u7531\u67D4\u4F5B\u5DDE\u52A1\u5927\u81E3\u517C\u67D4\u4F5B\u673A\u6784\u4E3B\u5E2D\u62FF\u7763\u7FC1\u54C8\u83F2\u5179\u89C1\u8BC1\u3002 \u003C/p\u003E\n\u003Cp\u003E\u67D4\u4F5B\u673A\u6784\u4E3B\u5E2D\u517C\u603B\u6267\u884C\u957F\u62FF\u7763\u8D5B\u83AB\u54C8\u672B\u8D5B\u4F9D\u5E03\u62C9\u6B23\u8868\u793A\uFF0C\u666E\u5E73\u6570\u636E\u96C6\u56E2\u5165\u9A7B\u67D4\u4F5B\u548C\u58EB\u5E74\u7EB3\u79D1\u6280\u56ED\uFF0C\u662F\u5BF9\u67D4\u4F5B\u7F6E\u5730\u7684\u6218\u7565\u548C\u56ED\u533A\u7684\u6709\u529B\u8BC1\u660E\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u5F53\u524D\uFF0C\u6295\u8D44\u65B9\u548C\u8425\u8FD0\u65B9\u90FD\u5728\u4F18\u5148\u8003\u8651\u8BE5\u6570\u636E\u4E2D\u5FC3\u884C\u4E1A\u5FEB\u901F\u589E\u957F\u7684\u524D\u666F\uFF0C\u56E0\u6B64\uFF0C\u67D4\u4F5B\u7F6E\u5730\u7684\u91CD\u70B9\u662F\u6269\u5927\u6570\u636E\u4E2D\u5FC3\u884C\u4E1A\u7684\u673A\u4F1A\u3002\u6211\u4EEC\u5728\u58EB\u5E74\u7EB3\u79D1\u6280\u56ED\u63D0\u4F9B\u7684\u7EFC\u5408\u6027\u4EA7\u54C1\uFF0C\u8868\u660E\u4E86\u6211\u4EEC\u5C06\u7EE7\u7EED\u52A0\u5F3A\u67D4\u4F5B\u4F5C\u4E3A\u533A\u57DF\u6570\u636E\u4E2D\u5FC3\u67A2\u7EBD\u7684\u5730\u4F4D\uFF0C\u6EE1\u8DB3\u4E0D\u65AD\u589E\u957F\u7684\u9700\u6C42\u3002\u201D \u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u7531\u4E8E\u8D8A\u6765\u8D8A\u591A\u7684\u516C\u53F8\u548C\u793E\u533A\u5C06\u5F15\u5165\u4E0B\u4E00\u4EE3\u6570\u5B57\u5DE5\u5177\u548C\u6218\u7565\uFF0C\u53EF\u9760\u3001\u667A\u80FD\u548C\u5F3A\u97E7\u7684\u6570\u636E\u5B58\u50A8\u9700\u6C42\u5C06\u5448\u6307\u6570\u7EA7\u589E\u957F\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u56E0\u6B64\uFF0C\u6211\u4EEC\u6B63\u81F4\u529B\u4E8E\u901A\u8FC7\u5DE5\u4E1A\u7269\u8054\u7F51\uFF08IIoT\uFF09\u5E73\u53F0\u3001\u80FD\u6E90\u548C\u7535\u529B\u76D1\u6D4B\u4EE5\u53CA\u521B\u65B0\u51B7\u5374\u6280\u672F\u7B49\uFF0C\u63D0\u9AD8\u6570\u636E\u4E2D\u5FC3\u7684\u6C38\u7EED\u6027\u3002\u201D \u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5165\u9A7B\u5927\u9A6C\u62D3\u5C55\u4E1A\u52A1\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u666E\u5E73\u6570\u636E\u96C6\u56E2\u8054\u5408\u521B\u59CB\u4EBA\u3001\u8463\u4E8B\u957F\u517C\u603B\u6267\u884C\u957F\u62C9\u53E4\u8868\u793A\uFF0C\u8BE5\u96C6\u56E2\u5165\u9A7B\u5927\u9A6C\uFF0C\u4E0D\u4F46\u6269\u5927\u4E86\u4E9A\u6D32\u4E0D\u65AD\u589E\u957F\u7684\u4E1A\u52A1\u7248\u56FE\uFF0C\u4E5F\u8FDB\u4E00\u6B65\u52A0\u5F3A\u4E86\u8BE5\u96C6\u56E2\u4F5C\u4E3A\u4E9A\u6D32\u6570\u5B57\u57FA\u7840\u8BBE\u65BD\u9886\u5BFC\u8005\u7684\u5730\u4F4D\u3002\u003C/p\u003E\n\u003Cp\u003E\u8BE5\u96C6\u56E2\u9996\u5E2D\u6280\u672F\u5B98\u517C\u65B0\u52A0\u5761\u603B\u7ECF\u7406\u6797\u5FE0\u6770\u5219\u8BF4\uFF0C\u58EB\u5E74\u7EB3\u79D1\u6280\u56ED\u6709\u5F88\u597D\u7684\u7535\u529B\u3001\u7F51\u7EDC\u53CA\u5176\u5B83\u4F18\u52BF\u8D44\u6E90\uFF0C\u662F\u8FDB\u884C\u8D85\u5927\u578B\u6570\u636E\u4E2D\u5FC3\u5EFA\u8BBE\u7684\u7406\u60F3\u5730\u70B9\u3002\u003C/p\u003E\n\u003Cp\u003E\u51FA\u5E2D\u8005\u5305\u62EC\u67D4\u4F5B\u7F6E\u5730\u96C6\u56E2\u8463\u4E8B\u7ECF\u7406\u6155\u963F\u5360\u3001\u67D4\u4F5B\u673A\u6784\u623F\u5730\u4EA7\u4E0E\u57FA\u5EFA\u90E8\u603B\u76D1\u62FF\u7763\u963F\u514B\u9A6C\u3001\u666E\u5E73\u6570\u636E\u96C6\u56E2\u9996\u5E2D\u6295\u8D44\u5B98\u9A6C\u8482\u4E9A\u65AF\u7B49\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u6269\u5EFA\u58EB\u5E74\u7EB3\u79D1\u6280\u56ED2\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u67D4\u4F5B\u7F6E\u5730\u5BA3\u5E03\uFF0C\u5C06\u6269\u5EFA640\u82F1\u4EA9\u7684\u6570\u636E\u4E2D\u5FC3\u56ED\u533A\u5373\u58EB\u5E74\u7EB3\u79D1\u6280\u56ED2\uFF08STeP 2\uFF09\uFF0C\u9884\u8BA1\u4E8E2024\u5E749\u6708\u5B8C\u5DE5\u3002\u003C/p\u003E\n\u003Cp\u003E\u4F5C\u4E3A\u4F9D\u5E03\u62C9\u6B23\u79D1\u6280\u57CE\uFF08IBTEC\uFF09\u5F00\u53D1\u9879\u76EE\u7684\u4E00\u90E8\u5206\uFF0C\u58EB\u5E74\u7EB3\u79D1\u6280\u56ED2\u5C06\u6309\u7167\u4F4E\u78B3\u57CE\u5E02\u6846\u67B6\uFF08LCCF\uFF09\u7406\u5FF5\uFF0C\u7528\u592A\u9633\u80FD\u5149\u4F0F\u53D1\u7535\u573A\u4F9B\u7535\u3002\u003C/p\u003E\n\u003Cp\u003E\u6B64\u5916\uFF0CIBTEC\u6B63\u5728\u79EF\u6781\u7B79\u5EFA\u9A6C\u6765\u897F\u4E9A\u6570\u5B57\u7F51\u7EDC\u4E2D\u5FC3\u7684\u5730\u4F4D\uFF0C\u6BEB\u65E0\u7591\u95EE\uFF0C\u58EB\u5E74\u7EB3\u79D1\u6280\u56ED2\u5C06\u5728\u8FD9\u4E00\u8FC7\u7A0B\u4E2D\u53D7\u76CA\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E9A\u592A\u5730\u533A\u7684\u4E91\u8BA1\u7B97\u3001\u7535\u5B50\u5546\u52A1\u548C\u5927\u6570\u636E\u5E94\u7528\u7684\u5FEB\u901F\u53D1\u5C55\u63A8\u52A8\u4E86\u6570\u636E\u4E2D\u5FC3\u4F53\u91CF\u548C\u667A\u80FD\u57FA\u7840\u8BBE\u65BD\u7CFB\u7EDF\u7684\u5FEB\u901F\u589E\u957F\u3002\u003C/p\u003E\n\u003Cp\u003E\u6700\u8FD1\uFF0C\u83B1\u574A\u516C\u5E03\u7684\u4E1C\u5357\u4E9A5\u56FD\u6570\u636E\u4E2D\u5FC3\u673A\u4F1A\u6307\u6570\uFF08SEA-5 Index\uFF09\u663E\u793A\uFF0C\u9A6C\u6765\u897F\u4E9A\u662F\u6570\u636E\u4E2D\u5FC3\u6295\u8D44\u7684\u9996\u9009\u5730\uFF0C2022\u5E74\u5438\u7EB3\u4E86113\u5146\u74E6\uFF0C\u5E76\u4E14\u5B9E\u73B0\u4E868.7%\u7684\u7ECF\u6D4E\u589E\u957F\u3002\u8FD9\u8868\u660E\u9A6C\u6765\u897F\u4E9A\u4F5C\u4E3A\u8BE5\u5730\u533A\u589E\u957F\u6700\u5FEB\u7684\u6570\u636E\u4E2D\u5FC3\u6258\u7BA1\u670D\u52A1\u5E02\u573A\u4E4B\u4E00\uFF0C\u6B63\u5728\u7A33\u6B65\u5438\u5F15\u6295\u8D44\u8005\u548C\u6570\u636E\u4E2D\u5FC3\u8FD0\u8425\u65B9\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/ma5Ao_P4KO2ivBfBcVA1qA\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
