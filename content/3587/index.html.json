  "route": "/3587/",
  "title": "\u8336\u548C\u5929\u4E0B\u4E28\u4E2D\u56FD\u8336\u6587\u5316\u4E0E\u4E16\u754C\u5386\u53F2\u8FDB\u7A0B\u2014\u2014\u4ECE\u9646\u7FBD\u7684\u56FD\u9645\u5F71\u54CD\u8C08\u8D77",
  "summary": "2022\u5E7411\u6708\uFF0C \u201C\u4E2D\u56FD\u4F20\u7EDF\u5236\u8336\u6280 \u827A\u53CA\u5176\u76F8\u5173\u4E60\u4FD7\u201D \u6210\u529F\u7533\u9057\u5E76\u88AB\u5217\u5165\u8054\u5408\u56FD\u6559\u79D1\u6587\u7EC4\u7EC7\u300A\u4EBA\u7C7B\u975E\u7269\u8D28\u6587\u5316\u9057\u4EA7\u4EE3\u8868\u4F5C\u540D\u5F55\u300B \u3002 \u4E2D\u56FD\uFF0C\u662F\u8336\u6811\u7684\u539F\u4EA7\u5730\uFF0C\u662F\u8336\u6587\u5316\u7684\u7B56\u6E90\u5730\u3002\u5C0F\u5C0F\u7684\u4E00\u7247\u8336\u53F6\uFF0C\u72EC\u7279\u7684\u4E00\u4E2A\u8336\u5B57\uFF0C\u662F\u4E94\u5343\u5E74\u4E2D\u534E\u6587\u660E\u7684\u91CD\u8981\u8F7D\u4F53\u548C\u4F20\u64AD\u5A92\u4ECB\u3002 \u4EE5\u8336\u4E3A\u793C\uFF0C\u4EE5\u8336\u4E3A\u5A92\uFF0C\u8336\u548C\u5929\u4E0B\u3002\u4E2D\u56FD\u8336\u53F6\u50CF\u4E00\u53EA\u53EA\u548C\u5E73\u9E3D\uFF0C\u4E00\u4E2A\u4E2A\u7EFF\u8272\u6587\u660E\u4F7F\u8005\uFF0C\u901A\u8FC7\u6D77\u9646\u53E4\u4E1D\u7EF8\u8336\u8DEF\uFF0C\u98DE\u5411\u4E16\u754C\u5404\u5730\uFF0C\u5728\u4E16\u754C\u4E94\u5927\u6D32\u751F\u6839\u5F00\u82B1\u53D1\u82BD\u3002 \u5982\u679C\u60F3\u4E86\u89E3\u66F4\u591A\u5173\u4E8E\u8336\u6587\u5316\u7684\u77E5\u8BC6\uFF0C\u672C\u671F\u63A8\u8350\u6B66\u6C49\u56FE\u4E66\u9986\u540D\u5BB6\u8BBA\u575B\u7CFB\u5217\uFF0C\u8457\u540D\u5B66\u8005\u4F59\u60A6\u4E3A\u4F60\u4ECB\u7ECD\u300A\u4E2D\u56FD\u8336\u6587\u5316\u4E0E\u4E16\u754C\u5386\u2026",
  "body": "\u003Cp\u003E2022\u5E7411\u6708\uFF0C\u201C\u4E2D\u56FD\u4F20\u7EDF\u5236\u8336\u6280\u827A\u53CA\u5176\u76F8\u5173\u4E60\u4FD7\u201D\u6210\u529F\u7533\u9057\u5E76\u88AB\u5217\u5165\u8054\u5408\u56FD\u6559\u79D1\u6587\u7EC4\u7EC7\u300A\u4EBA\u7C7B\u975E\u7269\u8D28\u6587\u5316\u9057\u4EA7\u4EE3\u8868\u4F5C\u540D\u5F55\u300B\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E2D\u56FD\uFF0C\u662F\u8336\u6811\u7684\u539F\u4EA7\u5730\uFF0C\u662F\u8336\u6587\u5316\u7684\u7B56\u6E90\u5730\u3002\u5C0F\u5C0F\u7684\u4E00\u7247\u8336\u53F6\uFF0C\u72EC\u7279\u7684\u4E00\u4E2A\u8336\u5B57\uFF0C\u662F\u4E94\u5343\u5E74\u4E2D\u534E\u6587\u660E\u7684\u91CD\u8981\u8F7D\u4F53\u548C\u4F20\u64AD\u5A92\u4ECB\u3002\u003C/p\u003E\n\u003Cp\u003E\u4EE5\u8336\u4E3A\u793C\uFF0C\u4EE5\u8336\u4E3A\u5A92\uFF0C\u8336\u548C\u5929\u4E0B\u3002\u4E2D\u56FD\u8336\u53F6\u50CF\u4E00\u53EA\u53EA\u548C\u5E73\u9E3D\uFF0C\u4E00\u4E2A\u4E2A\u7EFF\u8272\u6587\u660E\u4F7F\u8005\uFF0C\u901A\u8FC7\u6D77\u9646\u53E4\u4E1D\u7EF8\u8336\u8DEF\uFF0C\u98DE\u5411\u4E16\u754C\u5404\u5730\uFF0C\u5728\u4E16\u754C\u4E94\u5927\u6D32\u751F\u6839\u5F00\u82B1\u53D1\u82BD\u3002\u003C/p\u003E\n\u003Cp\u003E\u5982\u679C\u60F3\u4E86\u89E3\u66F4\u591A\u5173\u4E8E\u8336\u6587\u5316\u7684\u77E5\u8BC6\uFF0C\u672C\u671F\u63A8\u8350\u6B66\u6C49\u56FE\u4E66\u9986\u540D\u5BB6\u8BBA\u575B\u7CFB\u5217\uFF0C\u8457\u540D\u5B66\u8005\u4F59\u60A6\u4E3A\u4F60\u4ECB\u7ECD\u300A\u4E2D\u56FD\u8336\u6587\u5316\u4E0E\u4E16\u754C\u5386\u53F2\u8FDB\u7A0B\u2014\u2014\u4ECE\u9646\u7FBD\u7684\u56FD\u9645\u5F71\u54CD\u8C08\u8D77\u300B\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E0A\u003C/p\u003E\n\u003Cp\u003E\u4E0B\u003C/p\u003E\n\u003Cp\u003E\u66F4\u591A\u7CBE\u5F69\uFF0C\u656C\u8BF7\u5173\u6CE8\uFF1A\u003C/p\u003E\n\u003Cp\u003E\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5B98\u7F51\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003Ehttps://www.chinaculturalcentre.my\u003C/p\u003E\n\u003Cp\u003E\u003Cs