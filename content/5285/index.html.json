  "slug": "%e6%88%91%e5%9c%a8%e5%a4%a7%e7%be%8e%e6%96%b0%e7%96%86%e7%ad%89%e4%bd%a0-2024%e6%96%b0%e7%96%86%e7%a7%8b%e5%86%ac%e5%ad%a3%e6%97%85%e6%b8%b8%e8%b5%84%e6%ba%90",
  "canonicalUrlKey": "%e6%88%91%e5%9c%a8%e5%a4%a7%e7%be%8e%e6%96%b0%e7%96%86%e7%ad%89%e4%bd%a0-2024%e6%96%b0%e7%96%86%e7%a7%8b%e5%86%ac%e5%ad%a3%e6%97%85%e6%b8%b8%e8%b5%84%e6%ba%90",
