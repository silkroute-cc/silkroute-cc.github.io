  "route": "/3745/",
  "title": "\u9686\u65B0\u9AD8\u94C1\u91CD\u542F\u73B0\u66D9\u5149 \u72EE\u57CE\u968F\u65F6\u7814\u7A76\u5927\u9A6C\u5EFA\u8BAE",
  "summary": "\uFF08\u65B0\u5C7111\u65E5\u8BAF\uFF09\u9A6C\u65B0\u4E24\u56FD\u9488\u5BF9\u9686\u65B0\u9AD8\u94C1\u9879\u76EE\u91CD\u542F\u73B0\u66D9\u5149\uFF0C\u5927\u9A6C\u8868\u660E\u5728\u79C1\u4EBA\u6295\u8D44\u4E0B\uFF0C\u56E2\u7ED3\u653F\u5E9C\u6B22\u8FCE\u6062\u590D\u9686\u65B0\u9AD8\u94C1\uFF08HSR\uFF09\u9879\u76EE\uFF0C\u65B0\u52A0\u5761\u5219\u968F\u65F6\u51C6\u5907\u7814\u7A76\u5927\u9A6C\u53EF\u80FD\u63D0\u51FA\u7684\u4EFB\u4F55\u5EFA\u8BAE\u3002 \u4EA4\u901A\u90E8\u957F\u9646\u5146\u798F\u4ECA\u65E5\u4E0B\u5348\u548C\u65B0\u52A0\u5761\u4EA4\u901A\u90E8\u957F\u6613\u534E\u4EC1\u5230\u4F4D\u4E8E\u65B0\u5C71\u7684\u67D4\u65B0\u6377\u8FD0\u7CFB\u7EDF\uFF08RTS\uFF09\u6D77\u4E0A\u9AD8\u67B6\u6865\u65BD\u5DE5\u73B0\u573A\u89C6\u5BDF\u540E\uFF0C\u5728\u8BB0\u8005\u4F1A\u4E0A\u900F\u9732\uFF0C\u4ECA\u65E5\u7684\u9A6C\u65B0\u4EA4\u957F\u53CC\u8FB9\u4F1A\u8BAE\u8BA8\u8BBA\u7684\u8BFE\u9898\u4E4B\u4E00\uFF0C\u5305\u62EC\u91CD\u542F\u9686\u65B0\u9AD8\u94C1\u9879\u76EE\u3002 \u4ED6\u8BF4\uFF0C\u4ED6\u5DF2\u5411\u6613\u534E\u4EC1\u8868\u660E\uFF0C\u5927\u9A6C\u653F\u5E9C\u76EE\u524D\u7684\u7ACB\u573A\u662F\u5BF9\u9686\u65B0\u9AD8\u94C1\u6301\u5F00\u653E\u6001\u5EA6\uFF0C\u73B0\u9636\u6BB5\u662F\u5F00\u653E\u63A5\u53D7\u6765\u81EA\u79C1\u4EBA\u9886\u57DF\u7684\u5EFA\u8BAE\uFF0C\u800C\u5DF2\u6709\u6570\u5BB6\u79C1\u4EBA\u516C\u53F8\u8868\u6001\u6709\u5174\u2026",
  "body": "\u003Cp\u003E\uFF08\u65B0\u5C7111\u65E5\u8BAF\uFF09\u9A6C\u65B0\u4E24\u56FD\u9488\u5BF9\u9686\u65B0\u9AD8\u94C1\u9879\u76EE\u91CD\u542F\u73B0\u66D9\u5149\uFF0C\u5927\u9A6C\u8868\u660E\u5728\u79C1\u4EBA\u6295\u8D44\u4E0B\uFF0C\u56E2\u7ED3\u653F\u5E9C\u6B22\u8FCE\u6062\u590D\u9686\u65B0\u9AD8\u94C1\uFF08HSR\uFF09\u9879\u76EE\uFF0C\u65B0\u52A0\u5761\u5219\u968F\u65F6\u51C6\u5907\u7814\u7A76\u5927\u9A6C\u53EF\u80FD\u63D0\u51FA\u7684\u4EFB\u4F55\u5EFA\u8BAE\u3002\u003C/p\u003E\n\u003Cp\u003E\u4EA4\u901A\u90E8\u957F\u9646\u5146\u798F\u4ECA\u65E5\u4E0B\u5348\u548C\u65B0\u52A0\u5761\u4EA4\u901A\u90E8\u957F\u6613\u534E\u4EC1\u5230\u4F4D\u4E8E\u65B0\u5C71\u7684\u67D4\u65B0\u6377\u8FD0\u7CFB\u7EDF\uFF08RTS\uFF09\u6D77\u4E0A\u9AD8\u67B6\u6865\u65BD\u5DE5\u73B0\u573A\u89C6\u5BDF\u540E\uFF0C\u5728\u8BB0\u8005\u4F1A\u4E0A\u900F\u9732\uFF0C\u4ECA\u65E5\u7684\u9A6C\u65B0\u4EA4\u957F\u53CC\u8FB9\u4F1A\u8BAE\u8BA8\u8BBA\u7684\u8BFE\u9898\u4E4B\u4E00\uFF0C\u5305\u62EC\u91CD\u542F\u9686\u65B0\u9AD8\u94C1\u9879\u76EE\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u4ED6\u5DF2\u5411\u6613\u534E\u4EC1\u8868\u660E\uFF0C\u5927\u9A6C\u653F\u5E9C\u76EE\u524D\u7684\u7ACB\u573A\u662F\u5BF9\u9686\u65B0\u9AD8\u94C1\u6301\u5F00\u653E\u6001\u5EA6\uFF0C\u73B0\u9636\u6BB5\u662F\u5F00\u653E\u63A5\u53D7\u6765\u81EA\u79C1\u4EBA\u9886\u57DF\u7684\u5EFA\u8BAE\uFF0C\u800C\u5DF2\u6709\u6570\u5BB6\u79C1\u4EBA\u516C\u53F8\u8868\u6001\u6709\u5174\u8DA3\u53C2\u4E0E\u6B64\u9879\u76EE\u3002\u003C/p\u003E\n\u003Cp\u003E\u9646\u5146\u798F\u8868\u793A\uFF0C\u653F\u5E9C\u7684\u539F\u5219\u662F\u6B22\u8FCE\u79C1\u4EBA\u754C\u4E3B\u5BFC\uFF0C\u540C\u65F6\u9700\u8981\u5148\u8BE6\u7EC6\u7814\u7A76\u63A8\u884C\u6A21\u5F0F\u548C\u878D\u8D44\u6A21\u5F0F\u7B49\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u4EEC\uFF08\u5927\u9A6C\uFF09\u7684\u7ACB\u573A\u662F\u6B22\u8FCE\u6062\u590D\u8FD9\u4E2A\u9879\u76EE\uFF0C\u4F46\u5FC5\u987B\u662F\u6765\u81EA\u79C1\u4EBA\u6295\u8D44\uFF0C\u4E4B\u540E\u6211\u4EEC\u4F1A\u518D\u8FDB\u4E00\u6B65\u8BA8\u8BBA\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u6613\u534E\u4EC1\u5219\u6307\u51FA\uFF0C\u65B0\u52A0\u5761\u51C6\u5907\u63A5\u6536\u6765\u81EA\u5927\u9A6C\u63D0\u5448\u6709\u5173\u5982\u4F55\u91CD\u542F\u9686\u65B0\u9AD8\u94C1\u9879\u76EE\u7684\u5EFA\u8BAE\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u4EEC\u6301\u5F00\u653E\u6001\u5EA6\uFF0C\u4E5F\u968F\u65F6\u51C6\u5907\u4E0E\u5927\u9A6C\u653F\u5E9C\u5408\u4F5C\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u65B0\u4E24\u56FD\u662F\u57282016\u5E74\u5C31\u5174\u5EFA350\u516C\u91CC\u7684\u9AD8\u94C1\u9879\u76EE\u7B7E\u7F72\u4E86\u4E00\u9879\u53CC\u8FB9\u534F\u8BAE\uFF0C\u539F\u8BA2\u57282026\u5E74\u5B8C\u6210\uFF0C\u9884\u8BA1\u80FD\u5C06\u5409\u9686\u5761\u548C\u65B0\u52A0\u5761\u4E4B\u95F4\u7684\u884C\u7A0B\u65F6\u95F4\u7F29\u77ED\u81F390\u5206\u949F\u3002\u003C/p\u003E\n\u003Cp\u003E2021\u5E741\u67081\u65E5\uFF0C\u8BE5\u9879\u76EE\u88AB\u56FD\u76DF\u653F\u5E9C\u53D6\u6D88\uFF0C\u5E76\u5411\u65B0\u52A0\u5761\u652F\u4ED81\u4EBF280\u4E07\u65B0\u5143\uFF08\u7EA63\u4EBF2000\u4E07\u4EE4\u5409\uFF09\u7684\u8D54\u507F\u91D1\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E5\u516C\u53F8\u6709\u610F\u7ADE\u6807\u627F\u529E\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u65E5\u524D\u6709\u6D88\u606F\u900F\u9732\uFF0C\u67095\u5BB6\u516C\u53F8\u6709\u610F\u7ADE\u6807\u627F\u529E\u9AD8\u8FBE600\u4EBF\u4EE4\u5409\u9686\u65B0\u9AD8\u94C1\u9879\u76EE\uFF0C\u6709\u8005\u66F4\u662F\u4E0E\u6F5C\u5728\u5408\u4F5C\u4F19\u4F34\u5546\u8BA8\u627F\u63A5\u9879\u76EE\u3002\u003C/p\u003E\n\u003Cp\u003E\u8D22\u7ECF\u5468\u520A\u300AThe Edge\u300B\u62A5\u9053\uFF0C\u6D88\u606F\u4EBA\u58EB\u900F\u9732\uFF0C\u8FD95\u5BB6\u6709\u5173\u7684\u4E0A\u5E02\u516C\u53F8\uFF0C\u5206\u522B\u662F\u4E39\u65AF\u91CC\u8D5B\u83AB\u8FBE\u63A7\u5236\u7684\u9A6C\u77FF\u4E1A\uFF08MMCORP\uFF09\u3001\u4E39\u65AF\u91CC\u6797\u6653\u6625\u638C\u63A7WCT\u63A7\u80A1\uFF08WCT\uFF0C9679\uFF0C\u4E3B\u677F\u5EFA\u7B51\u80A1\uFF09\u3001\u6768\u5FE0\u793C\u673A\u6784\uFF08YTL\uFF0C4677\uFF0C\u4E3B\u677F\u516C\u7528\u4E8B\u4E1A\u80A1\uFF09\u3001\u9A6C\u8D44\u6E90\uFF08MRCB\uFF0C1651\uFF0C\u4E3B\u677F\u4EA7\u4E1A\u80A1\uFF09\uFF0C\u4EE5\u53CA\u4E39\u65AF\u91CC\u9648\u5FD7\u8FDC\u65D7\u4E0B\u7684\u6210\u529F\u673A\u6784\uFF08BJCORP\uFF0C3395\uFF0C\u4E3B\u677F\u5DE5\u4E1A\u80A1\uFF09\u3002\u003C/p\u003E\n\u003Cp\u003E\u5176\u4E2D\uFF0C\u81F3\u5C11\u6709\u4E24\u5BB6\u516C\u53F8\u5DF2\u4E0E\u4E2D\u56FD\u4F01\u4E1A\u5C55\u5F00\u6D3D\u8C08\uFF0C\u53E6\u4E00\u5BB6\u5219\u4F3C\u4E4E\u503E\u5411\u4E8E\u4E0E\u65E5\u672C\u8D22\u56E2\u5408\u4F5C\uFF0C\u5269\u4F59\u4E24\u5BB6\u5219\u6709\u5F85\u653F\u5E9C\u900F\u9732\u66F4\u591A\u9879\u76EE\u8BE6\u60C5\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/Lepuf3lGa3A4OdJUhD6aSA\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
