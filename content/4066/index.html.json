{
  "id": "%e5%8e%a6%e9%97%a8%e5%a4%a7%e5%ad%a6%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e5%88%86%e6%a0%a1%e8%a2%ab%e8%aa%89%e4%b8%ba%e9%95%b6%e5%b5%8c%e5%9c%a8%e4%b8%80%e5%b8%a6%e4%b8%80%e8%b7%af",
  "slug": "%e5%8e%a6%e9%97%a8%e5%a4%a7%e5%ad%a6%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e5%88%86%e6%a0%a1%e8%a2%ab%e8%aa%89%e4%b8%ba%e9%95%b6%e5%b5%8c%e5%9c%a8%e4%b8%80%e5%b8%a6%e4%b8%80%e8%b7%af",
  "canonicalUrlKey": "%e5%8e%a6%e9%97%a8%e5%a4%a7%e5%ad%a6%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e5%88%86%e6%a0%a1%e8%a2%ab%e8%aa%89%e4%b8%ba%e9%95%b6%e5%b5%8c%e5%9c%a8%e4%b8%80%e5%b8%a6%e4%b8%80%e8%b7%af",
  "route": "/4066/",
  "title": "\u53A6\u95E8\u5927\u5B66\u9A6C\u6765\u897F\u4E9A\u5206\u6821\u88AB\u8A89\u4E3A\u201C\u9576\u5D4C\u5728\u2018\u4E00\u5E26\u4E00\u8DEF\u2019\u4E0A\u7684\u7480\u74A8\u660E\u73E0\u201D",
  "summary": "\u53A6\u95E8\u5927\u5B66\u9A6C\u6765\u897F\u4E9A\u5206\u6821\u63A8\u52A8\u7740\u4E2D\u5916\u6587\u660E\u4EA4\u6D41\u4E92\u9274\u3002\uFF08\u53A6\u95E8\u5927\u5B66 \u4F9B\u56FE\uFF09 \u6628\u5929\uFF0C\u53A6\u95E8\u5927\u5B66\u4E3E\u884C\u201C\u53A6\u95E8\u5927\u5B66\u9A6C\u6765\u897F\u4E9A\u5206\u6821\u5171\u5EFA\u534F\u8BAE\u7B7E\u7F72\u5341\u5468\u5E74\u5EA7\u8C08\u4F1A\u66A8\u2018\u4E00\u5E26\u4E00\u8DEF\u2019\u7814\u8BA8\u4F1A\u201D\u3002\u8BB0\u8005\u83B7\u6089\uFF0C\u8FC7\u53BB\u5341\u5E74\uFF0C\u53A6\u5927\u901A\u8FC7\u201C\u8D70\u51FA\u53BB\u201D\uFF0C\u52A9\u529B\u5171\u5EFA\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u3002 \u4E00\u5EA6\u88AB\u8BA4\u4E3A\u662F\u201C\u4E0D\u53EF\u80FD\u5B8C\u6210\u7684\u4EFB\u52A1\u201D \u5F53\u5929\u5728\u53A6\u5927\u601D\u660E\u6821\u533A\u4E3E\u884C\u7684\u4F1A\u8BAE\uFF0C\u901A\u8FC7\u7EBF\u4E0A\u89C6\u9891\u548C\u7EBF\u4E0B\u5EA7\u8C08\uFF0C\u53EC\u96C6\u5F53\u5E74\u53A6\u5927\u9A6C\u6765\u897F\u4E9A\u5206\u6821\uFF08\u4EE5\u4E0B\u7B80\u79F0\u201C\u53A6\u5927\u9A6C\u6821\u201D\uFF09\u5EFA\u8BBE\u7684\u4E2D\u9A6C\u53CC\u65B9\u89C1\u8BC1\u8005\u8FDB\u884C\u7814\u8BA8\u3002 \u9A6C\u4E2D\u5546\u52A1\u7406\u4E8B\u4F1A\u524D\u4E3B\u5E2D\u4E39\u65AF\u91CC\u9EC4\u5BB6\u5B9A\u8BF4\uFF0C\u53A6\u5927\u5230\u9A6C\u6765\u897F\u4E9A\u529E\u5B66\uFF0C\u6700\u521D\u662F\u9A6C\u6765\u897F\u4E9A\u5411\u4E2D\u56FD\u6559\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/10/frc-7b80837045dfd9a654fc5f3215285f68.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u53A6\u95E8\u5927\u5B66\u9A6C\u6765\u897F\u4E9A\u5206\u6821\u63A8\u52A8\u7740\u4E2D\u5916\u6587\u660E\u4EA4\u6D41\u4E92\u9274\u3002\uFF08\u53A6\u95E8\u5927\u5B66 \u4F9B\u56FE\uFF09\u003C/p\u003E\n\u003Cp\u003E\u6628\u5929\uFF0C\u53A6\u95E8\u5927\u5B66\u4E3E\u884C\u201C\u53A6\u95E8\u5927\u5B66\u9A6C\u6765\u897F\u4E9A\u5206\u6821\u5171\u5EFA\u534F\u8BAE\u7B7E\u7F72\u5341\u5468\u5E74\u5EA7\u8C08\u4F1A\u66A8\u2018\u4E00\u5E26\u4E00\u8DEF\u2019\u7814\u8BA8\u4F1A\u201D\u3002\u8BB0\u8005\u83B7\u6089\uFF0C\u8FC7\u53BB\u5341\u5E74\uFF0C\u53A6\u5927\u901A\u8FC7\u201C\u8D70\u51FA\u53BB\u201D\uFF0C\u52A9\u529B\u5171\u5EFA\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E00\u5EA6\u88AB\u8BA4\u4E3A\u662F\u201C\u4E0D\u53EF\u80FD\u5B8C\u6210\u7684\u4EFB\u52A1\u201D\u003C/p\u003E\n\u003Cp\u003E\u5F53\u5929\u5728\u53A6\u5927\u601D\u660E\u6821\u533A\u4E3E\u884C\u7684\u4F1A\u8BAE\uFF0C\u901A\u8FC7\u7EBF\u4E0A\u89C6\u9891\u548C\u7EBF\u4E0B\u5EA7\u8C08\uFF0C\u53EC\u96C6\u5F53\u5E74\u53A6\u5927\u9A6C\u6765\u897F\u4E9A\u5206\u6821\uFF08\u4EE5\u4E0B\u7B80\u79F0\u201C\u53A6\u5927\u9A6C\u6821\u201D\uFF09\u5EFA\u8BBE\u7684\u4E2D\u9A6C\u53CC\u65B9\u89C1\u8BC1\u8005\u8FDB\u884C\u7814\u8BA8\u3002\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u4E2D\u5546\u52A1\u7406\u4E8B\u4F1A\u524D\u4E3B\u5E2D\u4E39\u65AF\u91CC\u9EC4\u5BB6\u5B9A\u8BF4\uFF0C\u53A6\u5927\u5230\u9A6C\u6765\u897F\u4E9A\u529E\u5B66\uFF0C\u6700\u521D\u662F\u9A6C\u6765\u897F\u4E9A\u5411\u4E2D\u56FD\u6559\u80B2\u90E8\u63D0\u51FA\u7684\u9080\u7EA6\u2014\u2014\u53A6\u5927\u662F\u4E2D\u56FD\u91CD\u70B9\u5927\u5B66\uFF0C\u5728\u5F53\u5730\u4EAB\u6709\u76DB\u8A89\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E0D\u4EC5\u5982\u6B64\uFF0C\u9A6C\u6765\u897F\u4E9A\u548C\u53A6\u5927\u8FD8\u6709\u4E00\u4E2A\u91CD\u8981\u7EBD\u5E26\u2014\u2014\u9648\u5609\u5E9A\u3002\u9648\u5609\u5E9A\u4ECE\u53A6\u95E8\u6F02\u6D0B\u8FC7\u6D77\uFF0C\u5728\u9A6C\u6765\u897F\u4E9A\u7ECF\u8425\u6A61\u80F6\u5236\u54C1\u83B7\u5F97\u6210\u529F\uFF1B1921\u5E74\uFF0C\u9648\u5609\u5E9A\u7528\u4ED6\u5728\u9A6C\u6765\u897F\u4E9A\u8D5A\u7684\u94B1\u8FD4\u56DE\u6545\u4E61\u503E\u8D44\u521B\u529E\u53A6\u5927\u3002\u003C/p\u003E\n\u003Cp\u003E\u53A6\u5927\u515A\u59D4\u4E66\u8BB0\u5F20\u8363\u548C\u6821\u957F\u5F20\u5B97\u76CA\u6628\u5929\u8BF4\uFF0C\u53A6\u5927\u662F\u6000\u7740\u5BF9\u5386\u53F2\u7684\u611F\u6069\u548C\u56DE\u9988\uFF0C\u8D70\u51FA\u56FD\u95E8\uFF0C\u6765\u5230\u5609\u5E9A\u5148\u751F\u4E8B\u4E1A\u53D6\u5F97\u5DE8\u5927\u6210\u529F\u7684\u9A6C\u6765\u897F\u4E9A\uFF0C\u521B\u529E\u5206\u6821\uFF0C\u6210\u4E3A\u5171\u5EFA\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u5021\u8BAE\u7684\u79EF\u6781\u8DF5\u884C\u8005\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E0D\u8FC7\uFF0C\u9A6C\u6765\u897F\u4E9A\u5F81\u9633\u96C6\u56E2\u6267\u884C\u4E3B\u5E2D\u4E39\u65AF\u91CC\u62FF\u7763\u6234\u826F\u4E1A\u6628\u5929\u8BF4\uFF0C\u53A6\u5927\u9A6C\u6821\u4E00\u5EA6\u88AB\u8BA4\u4E3A\u662F\u201C\u4E0D\u53EF\u80FD\u5B8C\u6210\u7684\u4EFB\u52A1\u201D\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u4ECB\u7ECD\uFF0C\u65F6\u4EFB\u53A6\u5927\u6821\u957F\u6731\u5D07\u5B9E\u4E0D\u4EC5\u5BF9\u5B66\u6821\u9762\u79EF\u6709\u8981\u6C42\uFF1A\u6211\u4EEC\u8981\u7684\u662F\u4E00\u6240\u5360\u5730\u4E00\u5343\u4EA9\u7684\u4E2D\u56FD\u5927\u5B66\uFF0C\u6709\u5B8C\u6574\u7684\u6821\u533A\uFF0C\u8FD8\u5BF9\u5730\u70B9\u6709\u8981\u6C42\uFF1A\u5FC5\u987B\u8981\u5728\u4E00\u4E2A\u4E2D\u56FD\u5BB6\u957F\u4E00\u542C\u5C31\u77E5\u9053\u7684\u5730\u65B9\uFF0C\u4ED6\u4EEC\u624D\u80FD\u653E\u5FC3\u5730\u8BA9\u5B69\u5B50\u53BB\u4E0A\u5B66\u3002\u003C/p\u003E\n\u003Cp\u003E\u5728\u5F53\u5730\u534E\u4EBA\u9F0E\u529B\u534F\u52A9\u4E0B\uFF0C\u53A6\u5927\u51ED\u501F\u201C\u60CA\u4EBA\u6BC5\u529B\u201D\u5C06\u4E00\u7247\u68D5\u6988\u6811\u6797\u8F6C\u53D8\u6210\u6700\u5148\u8FDB\u7684\u6559\u80B2\u8BBE\u65BD\uFF0C\u53A6\u5927\u9A6C\u6821\u4F4D\u4E8E\u9A6C\u6765\u897F\u4E9A\u96EA\u5170\u83AA\u5DDE\uFF0C\u8DDD\u79BB\u56FD\u9645\u673A\u573A15\u5206\u949F\u8F66\u7A0B\u30022016\u5E74\u5143\u5BB5\uFF0C\u53A6\u5927\u9A6C\u6821\u5F00\u529E\uFF0C\u8FCE\u63A5\u7B2C\u4E00\u6279200\u4F59\u540D\u5B66\u751F\uFF0C\u8FD9\u662F\u4E2D\u56FD\u77E5\u540D\u5927\u5B66\u5728\u6D77\u5916\u5168\u8D44\u8BBE\u7ACB\u7684\u3001\u62E5\u6709\u72EC\u7ACB\u6821\u56ED\u7684\u7B2C\u4E00\u6240\u6D77\u5916\u5206\u6821\u3002\u003C/p\u003E\n\u003Cp\u003E\u73B0\u67099\u4E2A\u5B66\u96627300\u4F59\u5B66\u751F\u003C/p\u003E\n\u003Cp\u003E\u6628\u5929\uFF0C\u53A6\u5927\u9A6C\u6821\u6821\u957F\u738B\u745E\u82B3\u4ECB\u7ECD\u8BF4\uFF0C\u53A6\u5927\u9A6C\u6821\u73B0\u67099\u4E2A\u5B66\u9662\uFF0C\u5B66\u79D1\u6D89\u53CA\u6587\u7406\u5DE5\u5546\u533B\u5404\u9886\u57DF\uFF0C\u6559\u5B66\u6DB5\u76D6\u672C\u7855\u535A\u5404\u9636\u6BB5\uFF0C\u76EE\u524D\u62E5\u6709\u6765\u81EA40\u4E2A\u56FD\u5BB6\u548C\u5730\u533A\u7684\u5B66\u751F7300\u4F59\u4EBA\uFF0C\u81F3\u4ECA\u5DF2\u57F9\u517B\u4E865\u5C4A\u3001\u51714813\u540D\u6BD5\u4E1A\u751F\u3002\u003C/p\u003E\n\u003Cp\u003E\u5728\u79D1\u7814\u65B9\u9762\uFF0C\u53A6\u5927\u9A6C\u6821\u5E08\u751F\u53D1\u8868\u76845\u7BC7\u8BBA\u6587\u5165\u9009ESI\u5168\u7403\u524D0.1%\u7684\u70ED\u70B9\u8BBA\u6587\uFF0C87\u7BC7\u6587\u7AE0\u5165\u9009\u5168\u7403\u524D1%\u7684\u9AD8\u88AB\u5F15\u7528\u8BBA\u6587\u3002\u53A6\u5927\u9A6C\u6821\u76847\u4F4D\u6559\u5E08\u5165\u90092022\u5E74\u7F8E\u56FD\u65AF\u5766\u798F\u5927\u5B66\u53D1\u5E03\u7684\u201C\u5168\u7403\u524D2%\u9876\u5C16\u79D1\u5B66\u5BB6\u699C\u5355\u201D\u3002\u003C/p\u003E\n\u003Cp\u003E\u9EC4\u5BB6\u5B9A\u8BF4\uFF0C\u4E0D\u4E45\u524D\uFF0C\u4ED6\u5E94\u9080\u53C2\u52A0\u53A6\u5927\u9A6C\u6821\u6BD5\u4E1A\u5178\u793C\uFF0C\u63F4\u5F15\u4E86\u5B66\u6821\u53D6\u5F97\u7684\u6210\u7EE9\uFF0C\u88AB\u9A6C\u6765\u897F\u4E9A\u5A92\u4F53\u62A5\u9053\u540E\uFF0C\u6536\u5230\u9A6C\u65B9\u5305\u62EC\u6559\u80B2\u754C\u5728\u5185\u7684\u5404\u754C\u53CD\u9988\uFF0C\u201C\u4ED6\u4EEC\u8BF4\uFF0C\u771F\u4EE4\u4EBA\u5403\u60CA\uFF0C\u77ED\u77ED\u51E0\u5E74\u5C31\u6709\u8FD9\u6837\u7684\u6210\u5C31\uFF01\u201D\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u662F\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u4E00\u4E2A\u91CD\u8981\u8282\u70B9\u3002\u6628\u5929\u7684\u7814\u8BA8\u4F1A\u8BF4\uFF0C\u529E\u5B66\u6570\u636E\u66F4\u91CD\u8981\u7684\u610F\u4E49\u5728\u4E8E\uFF1A\u53A6\u5927\u901A\u8FC7\u201C\u8D70\u51FA\u53BB\u201D\uFF0C\u52A9\u529B\u5171\u5EFA\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u3002\u003C/p\u003E\n\u003Cp\u003E\u636E\u4ECB\u7ECD\uFF0C\u53A6\u5927\u9A6C\u6821\u5728\u4E13\u4E1A\u8BBE\u7F6E\u4E0A\uFF0C\u5145\u5206\u8003\u91CF\u4E86\u9A6C\u6765\u897F\u4E9A\u4EBA\u624D\u9700\u8981\uFF0C\u5305\u62EC\u65B0\u80FD\u6E90\u79D1\u5B66\u4E0E\u5DE5\u7A0B\u3001\u91D1\u878D\u5B66\u3001\u56FD\u9645\u5546\u52A1\u7B49\u3002\u4E0D\u4EC5\u5982\u6B64\uFF0C\u53A6\u5927\u9A6C\u6821\u80FD\u6E90\u4E0E\u5316\u5B66\u5DE5\u7A0B\u5B66\u9662\u9662\u957F\u9648\u79C9\u8F89\u6559\u6388\u8BF4\uFF1A\u201C\u9A6C\u6765\u897F\u4E9A\u662F\u4E16\u754C\u7B2C\u4E8C\u5927\u68D5\u6988\u6CB9\u53CA\u76F8\u5173\u5236\u54C1\u751F\u4EA7\u56FD\uFF0C\u6211\u4EEC\u5E2E\u52A9\u9A6C\u6765\u897F\u4E9A\u89E3\u51B3\u4E86\u68D5\u6988\u6CB9\u63D0\u70BC\u4E2D\u7684\u4E00\u4E9B\u6280\u672F\u96BE\u9898\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u9648\u79C9\u8F89\u8BA4\u4E3A\uFF0C\u5728\u75AB\u60C5\u9632\u63A7\u5E38\u6001\u5316\u540E\uFF0C\u968F\u7740\u8D8A\u6765\u8D8A\u591A\u4E2D\u56FD\u4F01\u4E1A\u8D70\u51FA\u53BB\uFF0C\u53A6\u5927\u9A6C\u6821\u5C06\u5728\u5171\u5EFA\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u4E2D\u505A\u51FA\u66F4\u5927\u8D21\u732E\u3002\u4ED6\u8BF4\uFF0C\u6700\u8FD1\u5DF2\u7ECF\u6709\u8BB8\u591A\u4E2D\u56FD\u4F01\u4E1A\u5230\u5B66\u6821\uFF0C\u62DB\u6536\u6BD5\u4E1A\u751F\uFF0C\u6216\u662F\u5BFB\u6C42\u79D1\u7814\u5408\u4F5C\u3002\u003C/p\u003E\n\u003Cp\u003E\u9648\u79C9\u8F89\u8BA4\u4E3A\uFF0C\u8BA9\u5B66\u751F\u5728\u8DE8\u6587\u5316\u5F53\u4E2D\uFF0C\u5728\u76F8\u4E92\u7684\u6B23\u8D4F\u3001\u5B66\u4E60\u3001\u751F\u6D3B\u5F53\u4E2D\uFF0C\u4E86\u89E3\u5F53\u5730\u7684\u6587\u5316\uFF0C\u52A0\u6DF1\u540C\u5B66\u95F4\u7684\u60C5\u8C0A\uFF0C\u5C06\u6765\u4E0D\u7BA1\u5E72\u4EC0\u4E48\u4E8B\u60C5\uFF0C\u4ED6\u4EEC\u90FD\u80FD\u66F4\u597D\u5730\u5408\u4F5C\u4EA4\u6D41\uFF0C\u6BD5\u4E1A\u540E\u5C06\u6210\u4E3A\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u5171\u5EFA\u56FD\u5BB6\u5408\u4F5C\u53D1\u5C55\u7684\u4E00\u80A1\u91CD\u8981\u529B\u91CF\u3002\u003C/p\u003E\n\u003Cp\u003E\u6821\u65B9\u81EA\u8C6A\u5730\u8BF4\uFF0C\u53A6\u5927\u9A6C\u6821\u88AB\u8A89\u4E3A\u201C\u9576\u5D4C\u5728\u2018\u4E00\u5E26\u4E00\u8DEF\u2019\u4E0A\u7684\u7480\u74A8\u660E\u73E0\u201D\u3002\u003C/p\u003E\n\u003Cp\u003E\uFF08\u53A6\u95E8\u65E5\u62A5\u8BB0\u8005 \u4F58\u5CE5 \u901A\u8BAF\u5458 \u6234\u73EE\u742A\uFF09\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/fnkh_uCgpvjyNDkh5URVfw\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
