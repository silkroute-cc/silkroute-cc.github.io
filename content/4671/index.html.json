{
  "id": "%e6%9f%94%e5%a4%a7%e8%87%a3%ef%bc%9a%e4%be%9d%e5%8c%ba%e7%b4%af%e8%ae%a1%e6%8a%95%e8%b5%84%e9%a2%9d4131%e4%ba%bf-59%e5%b7%b2%e8%90%bd%e5%ae%9e-%e5%ae%89%e5%8d%8e%ef%bc%9a2030%e5%b9%b4%e5%ae%9e",
  "slug": "%e6%9f%94%e5%a4%a7%e8%87%a3%ef%bc%9a%e4%be%9d%e5%8c%ba%e7%b4%af%e8%ae%a1%e6%8a%95%e8%b5%84%e9%a2%9d4131%e4%ba%bf-59%e5%b7%b2%e8%90%bd%e5%ae%9e-%e5%ae%89%e5%8d%8e%ef%bc%9a2030%e5%b9%b4%e5%ae%9e",
  "canonicalUrlKey": "%e6%9f%94%e5%a4%a7%e8%87%a3%ef%bc%9a%e4%be%9d%e5%8c%ba%e7%b4%af%e8%ae%a1%e6%8a%95%e8%b5%84%e9%a2%9d4131%e4%ba%bf-59%e5%b7%b2%e8%90%bd%e5%ae%9e-%e5%ae%89%e5%8d%8e%ef%bc%9a2030%e5%b9%b4%e5%ae%9e",
  "route": "/4671/",
  "title": "\u67D4\u5927\u81E3\uFF1A\u4F9D\u533A\u7D2F\u8BA1\u6295\u8D44\u989D4131\u4EBF 59%\u5DF2\u843D\u5B9E  \u5B89\u534E\uFF1A2030\u5E74\u5B9E\u73B06360\u4EBF\u603B\u6295\u8D44",
  "summary": "\u4F9D\u533A\u7D2F\u8BA1\u6295\u8D44\u989D4131\u4EBF \u67D4\u5927\u81E3\uFF1A59%\u5DF2\u843D\u5B9E \uFF08\u65B0\u5C7124\u65E5\u8BAF\uFF09 \u67D4\u4F5B\u5DDE\u52A1\u5927\u81E3\u62FF\u7763\u7FC1\u54C8\u83F2\u5179\u900F\u9732\uFF0C\u6210\u7ACB\u4E8E2006\u5E74\u7684\u4F9D\u65AF\u5E72\u8FBE\u7279\u533A\uFF0C\u622A\u81F32023\u5E74\u7684\u7D2F\u8BA1\u6295\u8D44\u989D\u8FBE4131\u4EBF\u4EE4\u5409\uFF0C\u5176\u4E2D59%\u53732419\u4EBF\u4EE4\u5409\u5DF2\u843D\u5B9E\uFF0C\u663E\u793A\u5916\u56FD\u6295\u8D44\u8005\u5BF9\u5927\u9A6C\u53CA\u67D4\u4F5B\u7684\u6295\u8D44\u4FE1\u5FC3\u65E5\u76CA\u589E\u5F3A\u3002 \u4ED6\u900F\u9732\uFF0C\u4ED6\u4E0E\u9996\u76F8\u62FF\u7763\u65AF\u91CC\u5B89\u534E\u4E00\u540C\u4E3B\u6301\u4F9D\u65AF\u5E72\u8FBE\u7279\u533A\u53D1\u5C55\u5C40\u7B2C32\u6B21\u4F1A\u8BAE\uFF0C\u63A2\u8BA8\u5404\u79CD\u957F\u671F\u8BA1\u5212\uFF0C\u4EE5\u5B9E\u8DF5\u5927\u9A6C\u4F9D\u65AF\u5E72\u8FBE2022\u5E74\u81F32030\u5E74\u7EFC\u5408\u53D1\u5C55\u8BA1\u5212\u7684\u6295\u8D44\u7B56\u7565\u53CA\u65B9\u5411\uFF0C\u5305\u62EC\u67D4\u65B0\u7ECF\u6D4E\u7279\u533A\uFF08JS-SEZ\uFF09\u4E0E\u91D1\u878D\u7279\u533A\uFF08SFZ\uFF09\uFF0C\u4EE5\u2026",
  "body": "\u003Ch1\u003E\u4F9D\u533A\u7D2F\u8BA1\u6295\u8D44\u989D4131\u4EBF\u3000\u67D4\u5927\u81E3\uFF1A59%\u5DF2\u843D\u5B9E\u003C/h1\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/04/frc-3ee7016bb7ced35d7f7eb9cf461ca0aa.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\uFF08\u65B0\u5C7124\u65E5\u8BAF\uFF09\u3000\u67D4\u4F5B\u5DDE\u52A1\u5927\u81E3\u62FF\u7763\u7FC1\u54C8\u83F2\u5179\u900F\u9732\uFF0C\u6210\u7ACB\u4E8E2006\u5E74\u7684\u4F9D\u65AF\u5E72\u8FBE\u7279\u533A\uFF0C\u622A\u81F32023\u5E74\u7684\u7D2F\u8BA1\u6295\u8D44\u989D\u8FBE4131\u4EBF\u4EE4\u5409\uFF0C\u5176\u4E2D59%\u53732419\u4EBF\u4EE4\u5409\u5DF2\u843D\u5B9E\uFF0C\u663E\u793A\u5916\u56FD\u6295\u8D44\u8005\u5BF9\u5927\u9A6C\u53CA\u67D4\u4F5B\u7684\u6295\u8D44\u4FE1\u5FC3\u65E5\u76CA\u589E\u5F3A\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u900F\u9732\uFF0C\u4ED6\u4E0E\u9996\u76F8\u62FF\u7763\u65AF\u91CC\u5B89\u534E\u4E00\u540C\u4E3B\u6301\u4F9D\u65AF\u5E72\u8FBE\u7279\u533A\u53D1\u5C55\u5C40\u7B2C32\u6B21\u4F1A\u8BAE\uFF0C\u63A2\u8BA8\u5404\u79CD\u957F\u671F\u8BA1\u5212\uFF0C\u4EE5\u5B9E\u8DF5\u5927\u9A6C\u4F9D\u65AF\u5E72\u8FBE2022\u5E74\u81F32030\u5E74\u7EFC\u5408\u53D1\u5C55\u8BA1\u5212\u7684\u6295\u8D44\u7B56\u7565\u53CA\u65B9\u5411\uFF0C\u5305\u62EC\u67D4\u65B0\u7ECF\u6D4E\u7279\u533A\uFF08JS-SEZ\uFF09\u4E0E\u91D1\u878D\u7279\u533A\uFF08SFZ\uFF09\uFF0C\u4EE5\u53CA\u628A\u5927\u9A6C\u4F9D\u65AF\u5E72\u8FBE\u6295\u8D44\u670D\u52A1\u4E2D\u5FC3\u6253\u9020\u6210\u4E00\u4E2A\u5B8C\u6574\u7684\u5355\u4E00\u7A97\u53E3\u6295\u8D44\u4FBF\u5229\u5316\u4E2D\u5FC3\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u7FC1\u54C8\u83F2\u5179\u6628\u665A\u900F\u8FC7\u9762\u5B50\u4E66\u8D34\u6587\uFF0C\u4F5C\u51FA\u4E0A\u8FF0\u900F\u9732\u3002\u4E0E\u4F1A\u8005\u5305\u62EC\u7ECF\u6D4E\u90E8\u957F\u62C9\u83F2\u5179\uFF0C\u4EE5\u53CA\u6295\u8D44\u3001\u8D38\u6613\u53CA\u5DE5\u4E1A\u90E8\u957F\u4E1C\u59D1\u624E\u592B\u9C81\u7B49\u4EBA\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/04/frc-89e118286f935d7bb207f2caa552d88b.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u81EA2006\u5E74\u6210\u7ACB\u81F32023\u5E74\uFF0C\u5927\u9A6C\u4F9D\u65AF\u5E72\u8FBE\u7279\u533A\u5DF2\u7D2F\u8BA1\u8FBE\u81F34131\u4EBF\u4EE4\u5409\u7684\u6295\u8D44\u989D\uFF0C\u5176\u4E2D59%\uFF082419\u4EBF\u4EE4\u5409\uFF09\u6295\u8D44\u989D\u5DF2\u843D\u5B9E\uFF0C\u4EE5\u4E0A\u6570\u5B57\u8BC1\u660E\u5916\u56FD\u6295\u8D44\u8005\u5BF9\u4E8E\u67D4\u4F5B\uFF0C\u4E43\u81F3\u6574\u4E2A\u5927\u9A6C\u7684\u6295\u8D44\u4FE1\u5FC3\u662F\u4E0E\u65E5\u4FF1\u589E\u201D\u003C/p\u003E\n\u003Cp\u003E\u201C\u8FD9\u4E9B\u6240\u6709\u7684\u52AA\u529B\u53CD\u6620\u4F9D\u65AF\u5E72\u8FBE\u7279\u533A\u53CA\u4F9D\u65AF\u5E72\u8FBE\u7279\u533A\u53D1\u5C55\u5C40\u7684\u5408\u4F5C\u6F5C\u529B\uFF0C\u4EE4\u8BE5\u7279\u533A\u6210\u4E3A\u56FD\u9645\u5927\u90FD\u5E02\u548C\u5145\u6EE1\u6D3B\u529B\u7684\u6295\u8D44\u76EE\u7684\u5730\u9009\u62E9\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u5E0C\u671B\uFF0C\u5168\u90E8\u8BA1\u5212\u90FD\u80FD\u5B9E\u73B0\uFF0C\u8FDB\u4E00\u6B65\u8BA9\u4F9D\u65AF\u5E72\u8FBE\u7279\u533A\u7EE7\u7EED\u53D1\u5C55\uFF0C\u5E76\u5177\u6709\u7ADE\u4E89\u529B\uFF0C\u7B26\u5408\u67D4\u5DDE\u653F\u5E9C2030\u5E74\u6210\u4E3A\u53D1\u8FBE\u5DDE\u5C5E\u7684\u613F\u666F\u3002\u003C/p\u003E\n\u003Cp\u003E\u6839\u636E\u62A5\u5BFC\uFF0C\u4F9D\u65AF\u5E72\u8FBE\u7279\u533A\u53D1\u5C55\u5C40\u653E\u773C2030\u5E74\u5B9E\u73B0\u7D2F\u8BA1\u6295\u8D44\u603B\u989D\u8FBE6360\u4EBF\u4EE4\u5409\uFF0C\u56FD\u5185\u751F\u4EA7\u603B\u503C\uFF08GDP\uFF09\u589E\u957F\u4ECB\u4E8E5.5%\u81F36.5%\uFF0C\u4EE5\u53CA\u4EBA\u5747\u56FD\u5185\u751F\u4EA7\u603B\u503C\uFF08GDP\uFF09\u8FBE5\u4E078800\u4EE4\u5409\u3002\u003C/p\u003E\n\u003Cp\u003E\u517C\u4EFB\u8D22\u653F\u90E8\u957F\u7684\u5B89\u534E\u8868\u793A\uFF0C\u6B64\u4E3A\u5927\u9A6C\u4F9D\u65AF\u5E72\u8FBE\u7279\u533A\u7684\u7B56\u7565\u4E4B\u4E00\uFF0C\u4E3A\u5927\u9A6C\u8FBE\u5230\u6210\u4E3A\u5168\u7403\u7B2C30\u5927\u7ECF\u6D4E\u4F53\u53CA\u5168\u7403\u7ADE\u4E89\u6307\u6570\u524D12\u540D\u4E4B\u5185\u7684\u76EE\u6807\uFF0C\u4F5C\u51FA\u8D21\u732E\u3002\u003C/p\u003E\n\u003Ch1\u003E\u4F9D\u533A\u53D1\u5C55\u5C40\u76EE\u6807\u3000\u5B89\u534E\uFF1A2030\u5E74\u5B9E\u73B06360\u4EBF\u603B\u6295\u8D44\u003C/h1\u003E\n\u003Cp\u003E\uFF08\u5409\u9686\u576123\u65E5\u8BAF\uFF09\u4F9D\u65AF\u5E72\u8FBE\u7279\u533A\u53D1\u5C55\u5C40\uFF08IRDA\uFF09\u653E\u773C\u57282030\u5E74\u5B9E\u73B06360\u4EBF\u4EE4\u5409\uFF08\u7D2F\u8BA1\uFF09\u6295\u8D44\u603B\u989D\uFF0C\u56FD\u5185\u751F\u4EA7\u603B\u503C\uFF08GDP\uFF09\u589E\u957F\u4ECB\u4E8E5.5%\u81F36.5%\u3002\uFF0C\u4EE5\u53CA\u4EBA\u5747GDP\u8FBE5\u4E078800\u4EE4\u5409\u3002\u003C/p\u003E\n\u003Cp\u003E\u9996\u76F8\u517C\u8D22\u957F\u62FF\u7763\u65AF\u91CC\u5B89\u534E\u8BF4\uFF0C\u8FD9\u662F\u5927\u9A6C\u4F9D\u65AF\u5E72\u8FBE\u7279\u533A\u7684\u7B56\u7565\u4E4B\u4E00\uFF0C\u4E3A\u5927\u9A6C\u8FBE\u5230\u6210\u4E3A\u5168\u7403\u7B2C30\u5927\u7ECF\u6D4E\u4F53\u53CA\u5168\u7403\u7ADE\u4E89\u6307\u6570\u524D12\u540D\u4E4B\u5185\u7684\u76EE\u6807\uFF0C\u4F5C\u51FA\u8D21\u732E\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u76F8\u4FE1\uFF0C\u5927\u9A6C\u4F9D\u65AF\u5E72\u8FBE\u7279\u533A\u7684\u589E\u957F\u76EE\u6807\u4E5F\u53D7\u5230\u6211\u5BA3\u5E03\u7684\u5021\u8BAE\u63A8\u52A8\uFF0C\u4F8B\u5982\u67D4\u4F5B-\u65B0\u52A0\u5761\u7ECF\u6D4E\u7279\u533A\uFF08JS-SEZ\uFF09\u53CA\u68EE\u6797\u57CE\u5E02\u91D1\u878D\u7279\u533A\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u4ECA\u5929\u4E3B\u6301\u7B2C32\u6B21IRDA\u6210\u5458\u4F1A\u8BAE\u540E\u5728\u5176\u9762\u5B50\u4E66\u4E13\u9875\u8D34\u6587\u8BF4\uFF0C\u8BE5\u4F1A\u8BAE\u5DF2\u63A2\u8BA8IRDA\u5728\u660C\u660E\u7ECF\u6D4E\u8BAE\u7A0B\u4E4B\u4E0B\u6240\u5EFA\u8BAE\u7684\u65B9\u5411\uFF0C\u4F5C\u4E3A\u8D70\u5ECA\u7279\u533A\u53CA\u534F\u8C032022\u5E74\u81F32023\u5E74\u5927\u9A6C\u4F9D\u65AF\u5E72\u8FBE\u7279\u533A\u7EFC\u5408\u53D1\u5C55\u8BA1\u5212\uFF08CDPiii\uFF09\u3002\u003C/p\u003E\n\u003Cp\u003E\u5B89\u534E\u8BF4\uFF0C\u6709\u9274\u4E8E\u6B64\uFF0C\u8FD9\u7B26\u5408\u653F\u5E9C\u91CD\u7EC4\u56FD\u5BB6\u6295\u8D44\u4FC3\u8FDB\u673A\u6784\u7248\u56FE\u7684\u51B3\u5B9A\uFF0C\u4EE5\u534F\u8C03\u4E0E\u6295\u8D44\u6709\u5173\u7684\u7ECF\u6D4E\u8D70\u5ECA\u529F\u80FD\u548C\u89D2\u8272\u4F5C\u4E3A\u5F00\u59CB\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u63D0\u5230\uFF0C\u4F1A\u8BAE\u4E5F\u8BA8\u8BBA\u7B56\u7565\u4E3E\u63AA\uFF0C\u5373\u6539\u5584\u5927\u9A6C\u4F9D\u65AF\u5E72\u8FBE\u6295\u8D44\u670D\u52A1\u4E2D\u5FC3\uFF0C\u4EE5\u53CA\u901A\u8FC7\u516C\u5E73\u7684\u804C\u4E1A\u914D\u5BF9\u6539\u5584\u793E\u4F1A\u7ECF\u6D4E\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/-jl1Lr1W_XLfknbduOa9-w\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
