  "canonicalUrlKey": "%e8%8c%b6%e5%92%8c%e5%a4%a9%e4%b8%8b-%c2%b7-%e9%9b%85%e9%9b%86-%e7%b3%bb%e5%88%97%e6%b4%bb%e5%8a%a8%e5%9c%a8%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e5%90%89%e9%9a%86",
  "route": "/3749/",
  "title": "\u201C\u8336\u548C\u5929\u4E0B\u201D \u00B7 \u96C5\u96C6\u2014\u2014\u7CFB\u5217\u6D3B\u52A8\u5728\u9A6C\u6765\u897F\u4E9A\u5409\u9686\u5761\u6210\u529F\u4E3E\u529E",
  "summary": "\u7531\u4E2D\u56FD\u6587\u5316\u548C\u65C5\u6E38\u90E8\u4E3B\u529E\uFF0C\u4E2D\u56FD\u5BF9\u5916\u6587\u5316\u4EA4\u6D41\u534F\u4F1A\u3001\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u3001\u5927\u9A6C\u4F5B\u6559\u6587\u5316\u603B\u4F1A\u627F\u529E\u7684\u201C\u8336\u548C\u5929\u4E0B\u201D\u00B7\u96C5\u96C6\u6D3B\u52A8\u4E8E5\u670810\u65E5\u8D77\u5728\u9A6C\u6765\u897F\u4E9A\u5409\u9686\u5761\u6210\u529F\u4E3E\u529E\u3002 \u672C\u6B21\u5409\u9686\u5761\u7AD9\u7684\u201C\u8336\u548C\u5929\u4E0B\u201D\u00B7\u96C5\u96C6\u6D3B\u52A8\u662F\u4E3A\u4E86\u5E86\u795D\u201C\u4E2D\u56FD\u4F20\u7EDF\u5236\u8336\u6280\u827A\u53CA\u5176\u76F8\u5173\u4E60\u4FD7\u201D\u7533\u9057\u6210\u529F\u5E76\u57285 \u670821\u65E5\u201C\u56FD\u9645\u8336\u65E5\u201D\u6765\u4E34\u4E4B\u9645\u800C\u7279\u522B\u4E3E\u529E\u7684\u5168\u7403\u6027\u6D3B\u52A8\u7684\u4E00\u90E8\u5206\u3002 \u6D3B\u52A8\u5206\u4E3A\u7EBF\u4E0B\u548C\u7EBF\u4E0A\u4E24\u4E2A\u90E8\u5206\uFF0C\u4ECE\u8336\u6587\u5316\u3001\u8336\u4EBA\u3001\u8336\u5546\u3001\u8336\u54C1\u7B49\u89C6\u89D2\u5207\u5165\uFF0C\u5728\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u548C\u5F53\u5730\u5546\u573A\u4E3E\u529E\u201C\u8BC6\u8336\u6709\u9053\u201D\u4F53\u9A8C\u65E5\u3001\u201C\u7985\u4E0E\u8336\u201D\u7CFB\u5217\u6D3B\u52A8\u3001\u201C\u8336\u7F18\u6EE1\u5929\u4E0B\u00B7\u7941\u7EA2\u4E07\u91CC\u884C\u201D\u2026",
  "body": "\u003Cp\u003E\u7531\u4E2D\u56FD\u6587\u5316\u548C\u65C5\u6E38\u90E8\u4E3B\u529E\uFF0C\u4E2D\u56FD\u5BF9\u5916\u6587\u5316\u4EA4\u6D41\u534F\u4F1A\u3001\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u3001\u5927\u9A6C\u4F5B\u6559\u6587\u5316\u603B\u4F1A\u627F\u529E\u7684\u201C\u8336\u548C\u5929\u4E0B\u201D\u0026#183;\u96C5\u96C6\u6D3B\u52A8\u4E8E5\u670810\u65E5\u8D77\u5728\u9A6C\u6765\u897F\u4E9A\u5409\u9686\u5761\u6210\u529F\u4E3E\u529E\u3002\u003C/p\u003E\n\u003Cp\u003E\u672C\u6B21\u5409\u9686\u5761\u7AD9\u7684\u201C\u8336\u548C\u5929\u4E0B\u201D\u0026#183;\u96C5\u96C6\u6D3B\u52A8\u662F\u4E3A\u4E86\u5E86\u795D\u201C\u4E2D\u56FD\u4F20\u7EDF\u5236\u8336\u6280\u827A\u53CA\u5176\u76F8\u5173\u4E60\u4FD7\u201D\u7533\u9057\u6210\u529F\u5E76\u57285\u670821\u65E5\u201C\u56FD\u9645\u8336\u65E5\u201D\u6765\u4E34\u4E4B\u9645\u800C\u7279\u522B\u4E3E\u529E\u7684\u5168\u7403\u6027\u6D3B\u52A8\u7684\u4E00\u90E8\u5206\u3002\u003C/p\u003E\n\u003Cp\u003E\u6D3B\u52A8\u5206\u4E3A\u7EBF\u4E0B\u548C\u7EBF\u4E0A\u4E24\u4E2A\u90E8\u5206\uFF0C\u4ECE\u8336\u6587\u5316\u3001\u8336\u4EBA\u3001\u8336\u5546\u3001\u8336\u54C1\u7B49\u89C6\u89D2\u5207\u5165\uFF0C\u5728\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u548C\u5F53\u5730\u5546\u573A\u4E3E\u529E\u201C\u8BC6\u8336\u6709\u9053\u201D\u4F53\u9A8C\u65E5\u3001\u201C\u7985\u4E0E\u8336\u201D\u7CFB\u5217\u6D3B\u52A8\u3001\u201C\u8336\u7F18\u6EE1\u5929\u4E0B\u0026#183;\u7941\u7EA2\u4E07\u91CC\u884C\u201D\u7941\u95E8\u7EA2\u8336\u5168\u7403\u63A8\u4ECB\u4F1A\uFF0C\u5E76\u5728\u6587\u5316\u4E2D\u5FC3\u5B98\u7F51\u4E0A\u7EBF\u201C\u4E2D\u56FD\u8336\u6587\u5316\u201D\u5C55\u89C8\u8D44\u6E90\uFF0C\u4EE5\u8336\u4E3A\u5A92\u4ECB\u5728\u9A6C\u6765\u897F\u4E9A\u63A8\u5E7F\u8336\u6587\u5316\uFF0C\u52A0\u5F3A\u6587\u660E\u53CB\u597D\u5BF9\u8BDD\uFF0C\u63A8\u52A8\u6587\u660E\u4EA4\u6D41\u4E92\u9274\u3002\u003C/p\u003E\n\u003Cp\u003E\u8336\u4F5C\u4E3A\u4E2D\u56FD\u4F20\u7EDF\u6587\u5316\u7684\u4EE3\u8868\u4E4B\u4E00\uFF0C\u627F\u8F7D\u4E86\u6DF1\u539A\u7684\u5386\u53F2\u6587\u5316\u5E95\u8574\u548C\u7CBE\u9AD3\u5185\u6DB5\uFF0C\u800C\u201C\u8336\u548C\u5929\u4E0B\u201D\u0026#183;\u96C5\u96C6\u2014\u2014\u7CFB\u5217\u6D3B\u52A8\u5728\u5409\u9686\u5761\u7684\u6210\u529F\u4E3E\u529E\uFF0C\u8BA9\u66F4\u591A\u9A6C\u6765\u897F\u4E9A\u4EBA\u6C11\u5F97\u4EE5\u611F\u53D7\u5230\u8336\u6587\u5316\u7684\u9B45\u529B\u4E0E\u5185\u6DB5\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E01\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u201C\u8336\u548C\u5929\u4E0B\u201D\u0026#183;\u96C5\u96C6\u2014\u2014\u8BC6\u8336\u6709\u9053\u4F53\u9A8C\u65E5\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u4F5C\u4E3A\u7CFB\u5217\u6D3B\u52A8\u9996\u53D1\uFF0C\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u9996\u5148\u4E8E5\u670810\u65E5\u5728\u4E2D\u5FC3\u5185\u4E3E\u529E\u4E86\u201C\u8336\u548C\u5929\u4E0B\u201D\u0026#183;\u96C5\u96C6\u2014\u2014\u8BC6\u8336\u6709\u9053\u4F53\u9A8C\u65E5\uFF0C\u7531\u4E2D\u5FC3\u7279\u9080\u8336\u827A\u5E08\u4EB2\u4E34\u6587\u5316\u4E2D\u5FC3\u73B0\u573A\uFF0C\u4E3A\u53C2\u4E0E\u8005\u8FDB\u884C\u8336\u9053\u5C55\u793A\uFF0C\u5E76\u63D0\u4F9B\u8336\u9053\u4F53\u9A8C\u548C\u8336\u6587\u5316\u5206\u4EAB\uFF0C\u518D\u73B0\u53E4\u65F6\u6587\u4EBA\u96C5\u58EB\u95FB\u9999\u54C1\u8317\u7684\u201C\u96C5\u96C6\u201D\u4E4B\u76DB\u51B5\uFF0C\u63D0\u5347\u5B66\u5458\u4EEC\u7684\u827A\u672F\u6DB5\u517B\u3001\u9676\u51B6\u9AD8\u5C1A\u60C5\u64CD\u3002\u003C/p\u003E\n\u003Cp\u003E\u672C\u6B21\u8336\u9053\u4F53\u9A8C\u65E5\u83B7\u591A\u4F4D\u9A6C\u6765\u897F\u4E9A\u5927\u5B66\u751F\u53C2\u4E0E\u5176\u4E2D\uFF0C\u9664\u4E86\u5B66\u4E60\u5230\u5982\u4F55\u8FA8\u522B\u4E0D\u540C\u7684\u8336\u7C7B\uFF0C\u4E5F\u5728\u8336\u827A\u5E08\u7684\u6307\u5BFC\u4E0B\u4E00\u6B65\u6B65\u5B66\u4E60\u51C0\u624B\u3001\u6C64\u5668\u3001\u8BF7\u8336\u3001\u5949\u8336\u3001\u95FB\u9999\u3001\u54C1\u8317\u7B49\u5341\u6570\u9053\u8336\u827A\u6B65\u9AA4\u3002\u73B0\u573A\u53C2\u4E0E\u5B66\u5458\u674E\u5973\u58EB\u53D7\u8BBF\u65F6\u8868\u793A\uFF0C\u201C\u901A\u8FC7\u8FD9\u6B21\u7684\u8BC6\u8336\u6709\u9053\u4F53\u9A8C\u65E5\uFF0C\u6211\u8BA4\u8BC6\u5230\u4E86\u8336\u9053\u4E0D\u4EC5\u4EC5\u662F\u7B80\u5355\u7684\u51B2\u3001\u6CE1\u3001\u559D\uFF0C\u8336\u9053\u6587\u5316\u4E5F\u662F\u4E00\u79CD\u4E2D\u56FD\u793C\u4EEA\u6587\u5316\uFF0C\u4F53\u73B0\u7684\u662F\u5BF9\u4EBA\u4E0E\u81EA\u7136\u7684\u5C0A\u91CD\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u73B0\u573A\u5B66\u5458\u4E5F\u79EF\u6781\u8E0A\u8DC3\u53D1\u8868\u81EA\u8EAB\u5728\u54C1\u8317\u65F6\u7684\u611F\u609F\u548C\u4F53\u9A8C\uFF0C\u76F8\u4E92\u4EA4\u6D41\u201C\u8336\u540E\u611F\u201D\uFF0C\u5BF9\u8336\u6587\u5316\u5C55\u73B0\u4E86\u6D53\u539A\u7684\u5174\u8DA3\u548C\u559C\u7231\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/05/frc-131ecde47491dd902a1623efc4d891bb.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u56FE1\uFF1A\u201C\u8336\u548C\u5929\u4E0B\u201D\u0026#183;\u96C5\u96C6\u2014\u2014\u8BC6\u8336\u6709\u9053\u4F53\u9A8C\u65E5\u73B0\u573A\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E02\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u201C\u8336\u548C\u5929\u4E0B\u201D\u0026#183;\u96C5\u96C6\u2014\u2014\u7985\u4E0E\u8336\u7CFB\u5217\u6D3B\u52A8\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u201C\u8336\u548C\u5929\u4E0B\u201D\u0026#183;\u96C5\u96C6\u7684\u7B2C\u4E8C\u573A\u6D3B\u52A8\u662F\u7531\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u8054\u5408\u5927\u9A6C\u4F5B\u6559\u6587\u5316\u603B\u4F1A\u6240\u4E3B\u529E\u7684\u201C\u8336\u548C\u5929\u4E0B\u201D\u0026#183;\u96C5\u96C6\u2014\u2014\u7985\u4E0E\u8336\u7CFB\u5217\u6D3B\u52A8\u3002\u6B64\u6D3B\u52A8\u4E8E5\u670812\u65E5\u81F314\u65E5\u5728KL Gateway \u5546\u573A\u914D\u5408\u4F5B\u6559\u536B\u585E\u8282\u4E49\u5356\u4F1A\u76DB\u5927\u4E3E\u884C\uFF0C\u5728\u77ED\u77ED3\u5929\u5185\u4FBF\u5438\u5F15\u4E86\u8FD1\u4E07\u4EBA\u8E0A\u8DC3\u53C2\u4E0E\u3002\u672C\u6B21\u6D3B\u52A8\u65E8\u5728\u901A\u8FC7\u8336\u6587\u5316\u5C55\u793A\u3001\u8336\u9053\u4F53\u9A8C\u3001\u4F20\u7EDF\u6C11\u4FD7\u4F53\u9A8C\u7B49\u591A\u79CD\u5F62\u5F0F\uFF0C\u5411\u5927\u4F17\u666E\u53CA\u4E2D\u534E\u4F20\u7EDF\u8336\u6587\u5316\uFF0C\u8BA9\u66F4\u591A\u7684\u9A6C\u6765\u897F\u4E9A\u6C11\u4F17\u8BA4\u8BC6\u201C\u559D\u8336\u201D\u8FD9\u4E00\u95E8\u96C5\u4FD7\u5171\u8D4F\u7684\u827A\u672F\u7CBE\u9AD3\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/05/frc-0c3dee78b86fc2469a046c94fa02c25b.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u56FE2\uFF1A\u201C\u8336\u548C\u5929\u4E0B\u201D\u0026#183;\u96C5\u96C6\u2014\u2014\u7985\u4E0E\u8336\u7CFB\u5217\u6D3B\u52A8\u4E0E\u4F5B\u6559\u536B\u585E\u8282\u4E49\u5356\u4F1A\u73B0\u573A\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/05/frc-45959d3f38e1f89c4125364b1362db5e.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/05/frc-2bbba872c07a521aa6911d687058cef5.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u56FE3\uFF1A\u73B0\u573A\u54C1\u8317\u4F53\u9A8C\u003C/p\u003E\n\u003Cp\u003E\u73B0\u573A\u6C11\u4F17\u5728\u201C\u8336\u548C\u5929\u4E0B\u201D\u5C55\u533A\u5185\uFF0C\u900F\u8FC7\u56FE\u7247\u4E0E\u89C6\u9891\u7684\u7ED3\u5408\uFF0C\u89C2\u89C8\u201C\u8336\u7684\u6545\u4E61\u201D\u3001\u201C\u9999\u64AD\u4E07\u91CC\u201D\u3001\u201C\u6587\u5316\u4E4B\u8DEF\u201D\u7B49\u8336\u6587\u5316\u4E3B\u9898\u5C55\u793A\uFF0C\u611F\u53D7\u4E2D\u534E\u8336\u6587\u5316\u7684\u6DF1\u539A\u5E95\u8574\u3002\u5C55\u533A\u5185\u7CBE\u7F8E\u96C5\u81F4\u7684\u8336\u827A\u9053\u5177\u548C\u98D8\u9038\u5728\u73B0\u573A\u7A7A\u6C14\u4E2D\u7684\u8336\u9999\uFF0C\u66F4\u662F\u5438\u5F15\u4E86\u6C11\u4F17\u9A7B\u8DB3\uFF0C\u5FAA\u7740\u8336\u9999\u800C\u81F3\u3002\u4E0D\u4EC5\u5982\u6B64\uFF0C\u5728\u8336\u9053\u4F53\u9A8C\u533A\uFF0C\u8FD8\u6709\u4E13\u4E1A\u8336\u827A\u5E08\u5411\u6C11\u4F17\u8BB2\u89E3\u8336\u9053\u6587\