  "id": "5822-2",
  "slug": "5822-2",
  "canonicalUrlKey": "5822-2",
  "route": "/3625/",
  "title": "\u9A6C\u6765\u897F\u4E9A\u7802\u62C9\u8D8A\u7532\u9187\u5382\u914D\u5957\u7801\u5934BEPCC\u9879\u76EE\u8BE6\u8BBE\u5B8C\u6210\u66A8\u6808\u6865\u7BA1\u9053\u9996\u540A\u6210\u529F\u5173\u952E\u8282\u70B9",
  "summary": "\u8FD1\u65E5\uFF0C\u968F\u7740\u4E0E\u4E1A\u4E3B\u5468\u4F8B\u4F1A\u4E0A\u6700\u540E\u4E00\u4EFD\u8BBE\u8BA1\u89C4\u683C\u4E66\u7684\u95ED\u5408\uFF0C\u9A6C\u6765\u897F\u4E9A\u7802\u62C9\u8D8A\u7532\u9187\u5382\u914D\u5957\u7801\u5934BEPCC\u9879\u76EE\u8BE6\u7EC6\u8BBE\u8BA1\u8FDB\u5EA6\u5B8C\u6210100%\uFF0C\u7EC8\u4E8E\u5706\u6EE1\u5B8C\u6210\u3002\u4E0E\u6B64\u540C\u65F6\uFF0C\u65BD\u5DE5\u73B0\u573A\u7B2C\u4E00\u683936\u5BF8\u7532\u9187\u7BA1\u987A\u5229\u540A\u653E\u6808\u6865\u4E0A\uFF0C\u6807\u5FD7\u7740\u6D77\u4E0A\u6808\u6865\u6BB5\u7BA1\u9053\u5B89\u88C5\u65BD\u5DE5\u5168\u9762\u94FA\u5F00\u3002\u8BBE\u8BA1\u65BD\u5DE5\u627F\u524D\u542F\u540E\uFF0C\u9879\u76EE\u63A8\u8FDB\u4E89\u62A2\u8282\u70B9\u3002 01 \u7CBE\u96D5\u7EC6\u7422\uFF0C\u521B\u4F18\u6811\u7891 \u672C\u9879\u76EE\u8BBE\u8BA1\u662F\u516C\u53F8\u7279\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/03/frc-5d1ba40671062454e24767622232409b.gif\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u8FD1\u65E5\uFF0C\u968F\u7740\u4E0E\u4E1A\u4E3B\u5468\u4F8B\u4F1A\u4E0A\u6700\u540E\u4E00\u4EFD\u8BBE\u8BA1\u89C4\u683C\u4E66\u7684\u95ED\u5408\uFF0C\u9A6C\u6765\u897F\u4E9A\u7802\u62C9\u8D8A\u7532\u9187\u5382\u914D\u5957\u7801\u5934BEPCC\u9879\u76EE\u8BE6\u7EC6\u8BBE\u8BA1\u8FDB\u5EA6\u5B8C\u6210100%\uFF0C\u7EC8\u4E8E\u5706\u6EE1\u5B8C\u6210\u3002\u4E0E\u6B64\u540C\u65F6\uFF0C\u65BD\u5DE5\u73B0\u573A\u7B2C\u4E00\u683936\u5BF8\u7532\u9187\u7BA1\u987A\u5229\u540A\u653E\u6808\u6865\u4E0A\uFF0C\u6807\u5FD7\u7740\u6D77\u4E0A\u6808\u6865\u6BB5\u7BA1\u9053\u5B89\u88C5\u65BD\u5DE5\u5168\u9762\u94FA\u5F00\u3002\u8BBE\u8BA1\u65BD\u5DE5\u627F\u524D\u542F\u540E\uFF0C\u9879\u76EE\u63A8\u8FDB\u4E89\u62A2\u8282\u70B9\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E 01\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u7CBE\u96D5\u7EC6\u7422\uFF0C\u521B\u4F18\u6811\u7891\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u672C\u9879\u76EE\u8BBE\u8BA1\u662F\u516C\u53F8\u7279\u8272\u53CA\u4F18\u52BF\u7684\u201C\u6C34\u5DE5\u002B\u5316\u5DE5\u201D\u7EFC\u5408\u6027BEPCC\u9879\u76EE\uFF0C\u8BBE\u8BA1\u8303\u56F4\u6DB5\u76D6\u4E8615\u4E2A\u4E13\u4E1A\u3002\u81EA2021\u5E74\u57FA\u7840\u8BBE\u8BA1\u5DE5\u4F5C\u5B8C\u6210\u5E76\u5168\u9762\u8FDB\u5165\u8BE6\u7EC6\u8BBE\u8BA1\u9636\u6BB5\uFF0C\u8BBE\u8BA1\u56E2\u961F\u524D\u540E\u65B9\u8054\u52A8\uFF0C\u5207\u5B9E\u505A\u5230\u6709\u8BA1\u5212\uFF0C\u6293\u843D\u5B9E\uFF0C\u7D27\u8FFD\u8E2A\uFF0C\u65E9\u95ED\u73AF\u3002\u529F\u592B\u4E0D\u8D1F\u6709\u5FC3\u4EBA\uFF0C\u6700\u7EC8\u4E8E2023\u5E743\u670815\u5168\u90E8\u53D6\u5F97\u4E86\u6279\u590D\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/03/frc-102e0438d6a8c4723fd20a4ff013d72e.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u9879\u76EE\u8BBE\u8BA1\u4E13\u9898\u5BA1\u67E5\u4F1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u7CBE\u96D5\u7EC6\u7422\uFF0C\u94F8\u9020\u7CBE\u54C1\u3002\u8BE6\u7EC6\u8BBE\u8BA1\u8FC7\u7A0B\u4E2D\uFF0C\u9A6C\u6765\u897F\u4E9A\u56FD\u5BB6\u77F3\u6CB9\u516C\u53F8\u7BA1\u7406\u80CC\u666F\u7684\u4E1A\u4E3B\u56E2\u961F\u5BF9\u8BBE\u8BA1\u8FC7\u7A0B\u7BA1\u7406\u4E13\u4E1A\u5316\u3001\u6807\u51C6\u5316\u3001\u7CBE\u7EC6\u5316\u7684\u8981\u6C42\uFF0C\u4F7F\u5F97\u8BBE\u8BA1\u56E2\u961F\u9762\u4E34\u7740\u6210\u679C\u8D28\u91CF\u4FDD\u8BC1\u548C\u5982\u671F\u4EA4\u4ED8\u7684\u53CC\u91CD\u8003\u9A8C\u3002\u8BBE\u8BA1\u56E2\u961F\u79C9\u5B88\u521D\u5FC3\uFF0C\u5206\u522B\u5F00\u5C55\u4E8630%\u300160%\u300190%\u7684\u6A21\u578B\u5BA1\u67E5\u4EE5\u53CA\u5173\u952E\u8BBE\u5907\u4E13\u9898\u4E09\u7EF4\u6A21\u578B\u5BA1\u67E5\u4F1A\u30013D\u6C34\u5DE5\u7269\u6A21\u4E13\u9898\u62A5\u544A\u4F1A\u3001\u7535\u6C14\u5B89\u5168\u53CA\u53EF\u64CD\u4F5C\u6027\u5BA1\u67E5\uFF08 ELSOR \uFF09\u7B49\u3002\u4E3A\u786E\u4FDD\u8BBE\u8BA1\u5B89\u5168(d-HSE) \uFF0C\u8BBE\u8BA1\u6210\u679C\u8FDB\u884C\u4E86\u706B\u707E\u53CA\u7206\u70B8\u5371\u9669\u6027\u5206\u6790\uFF08 FERA \uFF09\u3001\u5B9A\u91CF\u98CE\u9669\u5206\u6790\uFF08 QRA \uFF09\u3001\u4E09\u7EF4\u706B\u6C14\u5730\u56FE\u3001\u53EF\u9760\u6027\u53EF\u5B9E\u73B0\u6027\u53CA\u53EF\u7EF4\u62A4\u6027\uFF08 RAM \uFF09\u5206\u6790\u7B49\u8FD120\u9879\u4E13\u9898\u8BBE\u8BA1\u5B89\u5168\u8BC4\u4F30\u3002\u003C/p\u003E\n\u003Cp\u003E\u8BBE\u8BA1\u56E2\u961F\u4EE5\u4E13\u4E1A\u7684\u7D20\u517B\u8D62\u5F97\u4E1A\u4E3B\u4FE1\u4EFB\u3002\u503C\u5F97\u4E00\u63D0\u7684\u662F \uFF0C\u5728\u5B8C\u6210\u4E86\u6C34\u6587\u548C\u6C34\u5DE5\u8054\u5408\u6570\u6A21\u7269\u6A21\u4E13\u9898\u62A5\u544A\u4F1A\u540E \uFF0C\u4E1A\u4E3B\u4E0D\u7EA6\u800C\u540C\u5730\u4E3A\u6211\u4EEC\u7AD6\u8D77\u62C7\u6307\u3001\u54CD\u8D77\u638C\u58F0\uFF0C\u5E76\u7559\u4E0B\u4E86\u201CCCCC can fly on the sea\u201D\u7684\u8D5E\u8D4F\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/03/frc-62bd65d0748bf6fbe25e78290a41007f.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003EDosh \u5B89\u5168\u5BA1\u67E5\u4F1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u8BBE\u8BA1\u5F15\u9886\uFF0C\u521B\u4F18\u6811\u7891\u3002\u4E3A\u5145\u5206\u53D1\u6325EPC\u9879\u76EE\u7684\u4F18\u52BF\uFF0C\u8BBE\u8BA1\u56E2\u961F\u52C7\u5F53\u6392\u5934\u5175\uFF0C\u4ECE\u9879\u76EE\u4F0A\u59CB\u4FBF\u79EF\u6781\u914D\u5408\u9879\u76EE\u90E8\u5F00\u5C55\u8BBE\u8BA1\u65B9\u6848\u4F18\u5316\u5DE5\u4F5C\uFF0C\u5E76\u591A\u6B21\u4E0E\u4E1A\u4E3B\u4EE5\u4E13\u9898\u4F1A\u7684\u5F62\u5F0F\u8FDB\u884C\u6DF1\u5165\u8BA8\u8BBA\u3002\u5176\u4E2D\uFF0C\u7531\u8BBE\u8BA1\u56E2\u961F\u7275\u5934\u5B8C\u6210\u7684\u5BC6\u6392\u6869\u53CA\u6321\u6D6A\u677F\u4F18\u5316\u6709\u6548\u5C06\u9879\u76EE\u65BD\u5DE5\u5DE5\u671F\u7F29\u77ED\u4E00\u4E2A\u6708\u4EE5\u4E0A\u3002\u6B64\u5916\uFF0C\u5982\u6865\u67B6\u9632\u8150\u3001\u6D88\u9632\u6CF5\u8BBE\u7F6E\u4EE5\u53CA\u7535\u6C14\u65B9\u6848\u4F18\u5316\u7B49\u5747\u51F8\u663E\u4E86\u4E2D\u4EA4\u7684\u8BBE\u8BA1\u6280\u672F\u6C34\u5E73\uFF0C\u540C\u65F6\u4E3A\u9879\u76EE\u8282\u7EA6\u4E86\u6210\u672C\u3002\u003C/p\u003E\n\u003Cp\u003E\u4F5C\u4E3A\u9A6C\u6765\u897F\u4E9A\u6CB9\u6C14\u884C\u4E1A\u4E2D\u7684\u9996\u4E2A\u4E2D\u56FD\u627F\u5305\u5546\uFF0C\u8BBE\u8BA1\u56E2\u961F\u6DF1\u77E5\u6811\u7ACB\u53E3\u7891\u7684\u91CD\u8981\u6027\uFF0C\u5176\u4E0D\u4EC5\u51DD\u805A\u7740\u8BBE\u8BA1\u56E2\u961F\u7684\u4ED8\u51FA\uFF0C\u516C\u53F8\u9886\u5BFC\u7684\u671F\u8BB8\uFF0C\u66F4\u4F53\u73B0\u7740\u4E2D\u4EA4\u54C1\u724C\u7684\u5B9E\u529B\uFF0C\u4EE5\u53CA\u4E2D\u56FD\u5DE5\u7A0B\u5E08\u7684\u4E13\u4E1A\u3002\u8BBE\u8BA1\u56E2\u961F\u7684\u4E25\u8C28\u3001\u4E13\u4E1A\u3001\u52A1\u5B9E\u3001\u6C9F\u901A\u6700\u7EC8\u8D62\u5F97\u4E86\u4E1A\u4E3B\u7684\u4FE1\u4EFB\u4E0E\u79F0\u8D5E\uFF0C\u5E76\u4E8E\u8BE6\u7EC6\u8BBE\u8BA1\u9636\u6BB5\u5411\u8BBE\u8BA1\u56E2\u961F\u53D1\u6765\u8868\u626C\u4FE1\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/03/frc-67a924317d1c5740e0190ff7ad5887b7.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u4E1A\u4E3B\u8868\u626C\u4FE1\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E 02\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5288\u6CE2\u65A9\u6D6A\uFF0C\u76F4\u6D4E\u6CA7\u6D77\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u9879\u76EE\u81EA2021\u5E743\u6708\u4E2D\u6807\u4EE5\u6765\uFF0C\u53D7\u75AB\u60C5\u7B49\u76F8\u5173\u56E0\u7D20\u5F71\u54CD\uFF0C\u9879\u76EE\u7269\u8D44\u91C7\u8D2D\u8FC7\u7A0B\u56F0\u96BE\u91CD\u91CD\uFF0C\u4ECE\u5408\u540C\u7B7E\u7F72\u3001\u751F\u4EA7\u3001\u53D1\u8FD0\u53CA\u5230\u573A\u4E3E\u6B65\u7EF4\u8270\uFF1B\u540C\u65F6\u7531\u4E8E2022\u5E7410\u6708\u20142023\u5E743\u6708\u7684\u957F\u5B63\u98CE\u671F\u5BFC\u81F4\u6C34\u5DE5\u5DE5\u4F5C\u9762\u7684\u79FB\u4EA4\u4E25\u91CD\u6EDE\u540E\uFF0C\u4E0A\u90E8\u5B89\u88C5\u5DE5\u671F\u4E25\u91CD\u538B\u7F29 \uFF0C\u6309\u671F\u5B8C\u5DE5\u5E0C\u671B\u6E3A\u832B\u3002\u9053\u963B\u4E14\u957F\uFF0C\u884C\u5219\u5C06\u81F3\uFF0C\u884C\u800C\u4E0D\u8F8D\uFF0C\u672A\u6765\u53EF\u671F\u3002\u003C/p\u003E\n\u003Cp\u003E\u81EA 2022\u5E746\u6708 \uFF0C\u5728\u516C\u53F8\u5404\u7EA7\u9886\u5BFC\u7684\u8FD0\u7B79\u5E37\u5E44\u548C\u7CBE\u5FC3\u6307\u5BFC\u4E0B\uFF0C\u5404\u90E8\u95E8\u53CA\u8BBE\u8BA1\u56E2\u961F\u901A\u529B\u914D\u5408\u548C\u8F9B\u82E6\u4ED8\u51FA\uFF0C\u9879\u76EE\u90E8\u5168\u4F53\u6210\u5458\u540C\u5FC3\u534F\u529B\uFF0C\u7ECF\u8FC7\u5927\u534A\u5E74\u7684\u524D\u671F\u51C6\u5907\uFF0C\u9879\u76EE\u4E3B\u8981\u7532\u9187\u7BA1\u6750\u4E8E2022\u5E7410\u670815\u65E5\u8D77\u5206\u6279\u62B5\u8FBE\u73B0\u573A\uFF0C\u5E76\u5B8C\u6210\u55B7\u7802\u6CB9\u6F06\u5DE5\u4F5C\u4EE5\u53CA\u9646\u57DF\u540A\u88C5\u5DE5\u4F5C\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/03/frc-9c6e836e57399b491ce0462045102b64.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E2023\u5E743\u670810\u65E5\u7B2C\u4E00\u6BB5\u6808\u6865\u5DE5\u4F5C\u9762\u6B63\u5F0F\u79FB\u4EA4\u3002\u4E3A\u8FBE\u5230\u65BD\u5DE5\u9762\u7684\u65E0\u7F1D\u8854\u63A5\uFF0C\u9879\u76EE\u90E8\u6B64\u524D\u63D0\u524D\u5B8C\u6210\u4E0A\u6808\u6865\u65BD\u5DE5\u5404\u9879\u65B9\u6848\u7684\u62A5\u6279\u5DE5\u4F5C\u3001\u5B89\u5168\u6280\u672F\u4EA4\u5E95\u5DE5\u4F5C\u7B49\u51C6\u5907\u5DE5\u4F5C\u3002\u9488\u5BF9\u6808\u6865\u4E34\u6C34\u4E34\u8FB9\u65BD\u5DE5\uFF0C\u4F5C\u4E1A\u9762\u7A84\u53CA\u5DE5\u5E8F\u642D\u63A5\u7B49\u56F0\u96BE\uFF0C\u591A\u6B21\u7EC4\u7EC7\u5185\u90E8\u5C31\u65BD\u5DE5\u65B9\u6848\u548C\u8FC7\u7A0B\u98CE\u9669\u63A7\u5236\u8BA8\u8BBA\uFF0C\u9010\u6761\u843D\u5B9E\u3002\u003C/p\u003E\n\u003Cp\u003E2023\u5E743\u670815\u65E5\uFF0C\u6D77\u4E0A\u6808\u6865\u6BB5\u9996\u683936\u5BF8\u7BA1\u9053\u540A\u88C5\u6210\u529F\uFF0C\u6807\u5FD7\u7740\u73B0\u573A\u5DE5\u4F5C\u5168\u9762\u94FA\u5F00\uFF0C\u9879\u76EE\u8FDB\u5165\u51B2\u523A\u9636\u6BB5\uFF0C\u9879\u76EE\u5168\u4F53\u6210\u5458\u5C06\u7EE7\u7EED\u594B\u52C7\u5411\u524D\uFF0C\u56E2\u7ED3\u4E00\u5FC3\uFF0C\u53D1\u6325\u516C\u53F8\u6D77\u5916\u56E2\u961F\u5F3A\u5927\u7684\u653B\u575A\u514B\u96BE\u80FD\u529B\uFF0C\u6309\u671F\u4FDD\u8D28\u5B8C\u6210\u9879\u76EE\u3002\u003C/p\u003E\n\u003Cp\u003E\u56FE\u6587\uFF1A\u4E2D\u4EA4\u56DB\u822A\u9662\u003C/p\u003E\n\u003Cp\u003E\u7F16\u8F91\uFF1A\u6C5F\u9759\u79CB\u003C/p\u003E\n\u003Cp\u003E\n\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/4tEFc1bDQMoenJ9tBNLJHg\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
