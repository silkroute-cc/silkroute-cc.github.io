  "id": "731",
  "slug": "731",
  "canonicalUrlKey": "731",
  "route": "/2613/",
  "title": "Shopee-\u6771\u5357\u4E9E\u96FB\u5546\u5DE8\u982D",
  "summary": "\u5173\u4E8EShopee\uFF0C\u4F60\u77E5\u9053\u591A\u5C11",
  "body": "\u003Ch2\u003E\u5F15\u8A00\u003C/h2\u003E\n\u003Cp\u003E\u3000\u3000\u5176\u5B9E\u6574\u4E2A18\u5E74\uFF0C\u4E1C\u5357\u4E9A\u7535\u5546\u5728\u6574\u4E2A\u56FD\u5185\u8DE8\u5883\u5708\u53D8\u5F97\u7279\u522B\u70ED\u8D77\u6765\uFF0C\u66F4\u591A\u7684\u8DE8\u5883\u5356\u5BB6\uFF0C\u8DBA\u5883\u65B0\u4EBA\u5F00\u59CB\u5165\u9A7B\u4E1C\u5357\u4E9A\u7535\u5546\u3002\u5C24\u5176\u662F\u9A6C\u4E91\u7238\u7238\u76F4\u63A5\u63A7\u80A1Lazada\u540E\uFF0C\u6D3E18\u7F57\u6C49\u4E4B\u4E00\u7684\u5F6D\u857E\u6302\u5E05Lazada\uFF0C\u5C06\u4E1C\u5357\u4E9A\u7535\u5546\u5F7B\u5E95\u63A8\u5411\u4E86\u98CE\u53E3\u6D6A\u5C16\u3002\u4F46\u662F\u7531\u4E8ELazada\u4E4B\u524D\u6316\u7684\u5751\u592A\u6DF1\uFF0C\u6574\u4F53\u7CFB\u7EDF\uFF0C\u7535\u5546\u4F53\u9A8C\u6D41\u7A0B\u592A\u5DEE\uFF0C18\u5E74\u53C8\u56E0\u4E3A\u5347\u7EA7\u7CFB\u7EDF\uFF0C\u66F4\u662F\u5173\u95ED\u4E86\u56FD\u5185\u5356\u5BB6\u5165\u9A7B\u901A\u9053\uFF0C\u6240\u4EE5\u5C31\u7ED9\u4E86Shopee\u66F4\u591A\u8D70\u5411\u524D\u53F0\u7684\u673A\u4F1A\uFF0C\u8BDD\u8BF418\u5E74Shopee\u597D\u591A\u62DB\u5546\u4F1A\uFF0C\u800C\u4E14\u5165\u9A7B\u4E5F\u7279\u522B\u5BB9\u6613\u3002\u523019\u5E74\uFF0CShopee\u66F4\u591A\u7684\u62DB\u5546\u4F1A\uFF0C\u66F4\u591A\u6FC0\u8FDB\u7684\u653F\u7B56\uFF0C\u4F7F\u5F97\u6574\u4E2A\u4E1C\u5357\u4E9A\u5E02\u573A\u66F4\u71E5\u70ED\u4E86\uFF0C\u4E3B\u8981\u4E5F\u662F\u5F97\u76CA\u4E8E\u4E1C\u5357\u4E9A\u76F8\u5F53\u4E8E10\u5E74\u524D\u4E2D\u56FD\u7684\u7535\u5546\u73AF\u5883\uFF0C\u5E76\u4E14\u6709\u77406.7\u4EBF\u7684\u4EBA\u53E3\uFF0C\u4E146.7\u4EBF\u4E2D\u6709\u66F4\u591A\u5E74\u8F7B\u7684\u4E92\u8054\u7F51\u4EBA\u53E3\uFF0C\u4EE5\u53CA\u66F4\u591A\u7684\u8D44\u672C\u5728\u4E1C\u5357\u4E9A\u6492\u4E0B\u4E86\u66F4\u591A\u7684\u94B1\u3002\u800C\u4E14\u7ADE\u4E89\u5BF9\u624BLazada\u95ED\u5173\u4FEE\u6574\uFF0C\u6240\u4EE5\u6765\u81EA\u4E1C\u5357\u4E9A\u7684Shopee\u4FBF\u6311\u8D77\u4E86\u4E1C\u5357\u4E9A\u7535\u5546\u5728\u56FD\u5185\u7684\u5BA3\u4F20\u5927\u6881\u3002\u4F46\u662F\u5176\u5B9E\u5F88\u591A\u4EBA\u4E5F\u53EF\u80FD\u53EA\u542C\u8BF4\u8FC7Shopee\uFF08\u867E\u76AE\uFF09\uFF0C\u611F\u89C9\u50CF\u7A81\u7136\u5192\u51FA\u6765\u4E00\u6837\uFF0C\u800C\u4E14\u600E\u4E48\u7A81\u7136\u4E00\u4E0B\u5B50\u53D8\u5F97\u77E5\u540D\u8D77\u6765\u4E86\uFF0C\u4F46\u5927\u90E8\u4EBA\u5BF9\u5176\u4E86\u89E3\u5E76\u4E0D\u6DF1\uFF0C\u5E78\u4E8F\u7F8E\u5C11\u5973\u6211\uFF0C\u6709\u7740\u4E00\u9897\u8654\u8BDA\u7684\u516B\u5366\u4E4B\u5FC3\uFF0C\u67E5\u9605\u8BB8\u591A\u6B63\u53F2\u91CE\u53F2\u8D44\u6599\u540E\u624D\u53D1\u73B0Shopee\u8DDF\u56FD\u5185\u4E92\u8054\u7F51/\u7535\u5546\u5708\u7684\u6E0A\u6E90\u8FD8\u662F\u6781\u6DF1\u7684\u3002\u003C/p\u003E\n\u003Ch2\u003E\u5173\u4E8EShopee\uFF0C\u4F60\u77E5\u9053\u591A\u5C11\u003C/h2\u003E\n\u003Cp\u003E\u5148\u6765\u770B\u4E00\u4E0BShopee\u7684\u7B80\u4ECB\u003C/p\u003E\n\u003Cul\u003E\n\u003Cli\u003E\u6210\u7ACB\u4E8E2015\u5E74\uFF0CShopee\u662F\u4E1C\u5357\u4E9A\u4E0E\u53F0\u6E7E\u9886\u822A\u7535\u5546\u5E73\u53F0\uFF0C\u8986\u76D6\u65B0\u52A0\u5761\u3001\u9A6C\u6765\u897F\u4E9A\u3001\u83F2\u5F8B\u5BBE\u3001\u53F0\u6E7E\u3001\u5370\u5EA6\u5C3C\u897F\u4E9A\u3001\u6CF0\u56FD\u548C\u8D8A\u5357\u3002\u003C/li\u003E\n\u003Cli\u003E2017\u5E74GMV\u8FBE\u523041\u4EBF\u7F8E\u91D1\uFF0C\u603B\u8BA2\u5355\u91CF2.45\u4EBF\u3002\u003C/li\u003E\n\u003Cli\u003E2018\u5E74GMV\u8FBE\u5230103\u4EBF\u7F8E\u91D1\u3002\u003C/li\u003E\n\u003Cli\u003E2018\u5E74\u53CC11\u8BA2\u5355\uFF0C1100\u4E07\u5355\uFF1B2018\u5E74\u53CC12\u8BA2\u5355\uFF0C1200\u4E07\u5355\u3002\u003C/li\u003E\n\u003Cli\u003EShopee APP\u4E0B\u8F7D\u91CF\u8D851.95\u4EBF\uFF0C \u4E3A 2018 \u5E74\u4E1C\u5357\u4E9A\u8D2D\u7269\u7C7B App \u4E0B\u8F7D\u91CF\u7B2C\u4E00\u540D\u3002\u003C/li\u003E\n\u003Cli\u003E\u6BCD\u516C\u53F8\uFF1ASea\uFF0C\u7EBD\u4EA4\u6240\u4E0A\u5E02\u4F01\u4E1A\u3002\u003C/li\u003E\n\u003C/ul\u003E\n\u003Ch2\u003EShopee\u4E0E\u9648\u6B27\u7684\u5173\u7CFB\u003C/h2\u003E\n\u003Cp\u003E\u3000\u3000\u770B\u6570\u636E\u8D44\u6599\u8FD8\u662F\u633A\u5389\u5BB3\u7684\u5BF9\u5427\uFF0C\u6240\u4EE5\u5927\u5BB6\u5E94\u8BE5\u66F4\u597D\u5947\u4E86\uFF0CShopee\u4ECE\u54EA\u91CC\u6765\uFF0C\u8981\u5230\u54EA\u91CC\u53BB\uFF1F\u8BF4\u5230Shopee\u4ECE\u54EA\u91CC\u6765\uFF0C\u4E00\u5B9A\u7ED5\u4E0D\u5F00\u4E00\u4E2A\u4EBA\uFF0C\u8C01\uFF1F\u805A\u7F8E\u4F18\u54C1\u7684\u9648\u6B27\uFF0C\u7F8E\u56FD\u7EBD\u7EA6\u4EA4\u6613\u6240200\u591A\u5E74\u5386\u53F2\u4E0A\u6700\u5E74\u8F7B\u7684CEO,\u4E0A\u5E02\u90A3\u5E74\uFF0C\u624D31\u5C81\u3002\u63D0\u8D77\u9648\u6B27\uFF0C\u5927\u5BB6\u4E00\u5B9A\u5BF9\u4ED6\u201C\u4E3A\u81EA\u5DF1\u4EE3\u8A00\u201D\u7684\u5E7F\u544A\uFF0C\u5386\u5386\u5728\u76EE\u5427\u3002\u90A3\u5927\u5BB6\u53C8\u95EE\u4E86\uFF0C\u9648\u6B27\u4E0E\u8FD9\u4E2AShopee\u53C8\u6709\u5565\u5173\u7CFB\u5462\uFF1F\u4E0D\u8981\u5FC3\u6025\uFF0C\u5F85\u6211\u4E3A\u5927\u5BB6\u4E00\u5C42\u4E00\u5C42\u5265\u5F00\u8FD9\u9897\u201C\u6D0B\u8471\u201D\u3002\u003C/p\u003E\n\u003Cp\u003E\u3000\u3000\u5654\u5654\u5654\uFF0C\u5148\u770B\u4E00\u4E0B\u9648\u6B27\u7684\u5C65\u5386\uFF0C2006\u5E74\uFF0C\u8FD8\u5728\u65B0\u52A0\u5761\u5357\u6D0B\u7406\u5DE5\u5927\u5B66\u8BFB\u5927\u56DB\u7684\u9648\u6B27\uFF08\u559C\u6B22\u6253\u6E38\u620F\uFF09\uFF0C\u521B\u529E\u4E86\u6E38\u620F\u5BF9\u6218\u5E73\u53F0GG game\u3002\u8FD9\u4E2AGG game\u5728\u5F53\u65F6\u7684\u4E1C\u5357\u4E9A\u6E38\u620F\u754C\u8FD8\u662F\u5F88\u706B\u7684\uFF0C\u6240\u4EE5\u9648\u6B27\u7B2C\u4E00\u6B21\u521B\u4E1A\u7B97\u662F\u86EE\u6210\u529F\u7684\u3002\u003C/p\u003E\n\u003Cp\u003E\u3000\u3000\u63A5\u4E0B\u6765\uFF0C\u5230\u4E8609\u5E74\uFF0C\u9648\u6B27\u53D1\u73B0\u81EA\u5DF1\u4E0E\u516C\u53F8\u4E0D\u5408\u62CD\uFF0C\u4E8E\u662F\u5356\u6389\u516C\u53F8 \u3002\u5728GG game\u53D1\u5C55\u5F97\u4E0D\u9519\u65F6\uFF0C\u4E0D\u7518\u5FC3\u73B0\u72B6\u7684\u9648\u6B27\u51B3\u5B9A\u53BB\u003Ca href=\u0022https://link.zhihu.com/?target=https%3A%2F%2Fbaike.baidu.com%2Fitem%2F%25E6%2596%25AF%25E5%259D%25A6%25E7%25A6%258F%25E5%25A4%25A7%25E5%25AD%25A6%2522%2520%255Ct%2520%2522_blank\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u65AF\u5766\u798F\u5927\u5B66\u003C/a\u003E\u8BFBMBA\uFF0C\u6269\u5145\u81EA\u5DF1\u7684\u77E5\u8BC6\u50A8\u5907\u3002\u7136\u540E\u4ED6\u628A\u81EA\u5DF1\u7684\u80A1\u4EFD\u5356\u7ED9\u4E86\u4E00\u4E2A\u4EBA\uFF0C\u8C01\u5462\uFF1F\u8FD9\u4E2A\u4EBA\u53EBForrest Li\uFF0C\u4E2D\u6587\u540D\u53EB\u674E\u5C0F\u51AC\uFF0C\u7EF4\u57FA\u767E\u79D1\u4E0A\u663E\u793A\u662F\u5929\u6D25\u4EBA\uFF08\u81EA\u52A8\u8111\u8865\u5929\u6D25\u8BDD\uFF09 \u3002\u540E\u6765\u4E24\u4E2A\u4EBA\u56E0\u4E3A\u80A1\u6743\u7684\u4E8B\u60C5\uFF0C\u8FD8\u95F9\u8FC7\u5F88\u591A\u4E0D\u6109\u5FEB\uFF0C\u7F51\u4E0A\u6709\u5F88\u591A\u4E2A\u7248\u672C\uFF0C\u6709\u516B\u5C01\u4E4B\u5FC3\u7684\u5C0F\u4F19\u4F34\u4EEC\uFF0C\u53EF\u4EE5\u53BB\u770B\u770B\uFF0C\u53CD\u6B63\u7F8E\u5C11\u5973\u6211\u662F\u90FD\u770B\u5B8C\u4E86\u3002\u003C/p\u003E\n\u003Cp\u003E\u9648\u6B27\u5B66\u6210\u5F52\u6765\u540E\uFF0C\u5728\u56FD\u5185\u521B\u4E1A\uFF0C\u62FF\u5230\u4E86\u5F90\u5C0F\u5E73\u8001\u5E08\uFF08\u771F\u683C\u57FA\u91D1\uFF0C\u4E0D\u61C2\u7684\u53EF\u4EE5\u767E\u5EA6\u54C8\uFF0C\u5F90\u8001\u5E08\u6295\u4E86\u5F88\u591A\u77E5\u540D\u7684\u9879\u76EE\uFF09\u7684\u6295\u8D44\uFF0C\u7136\u540E\u5728\u5343\u56E2\u5927\u6218\u7684\u65F6\u5019\uFF0C\u6210\u7ACB\u4E86\u805A\u7F8E\u4F18\u54C1\uFF0C\u5927\u5BB6\u8DDF\u6211\u8FD9\u4E2A\u5E74\u7EAA\uFF0C\u6216\u8005\u7A0D\u5FAE\u66F4\u5927\u4E00\u70B9\u7684\uFF0C\u90FD\u6709\u8FC7\u5728\u805A\u7F8E\u4F18\u54C1\u4E0A\u8FB9\u4E70\u8FC7\u5316\u5986\u54C1\u5427\uFF0C\u6210\u7ACB\u56DB\u5E74\u540E\u5C31\u4E0A\u5E02\uFF0C\u6210\u4E3A\u7F8E\u56FD\u7EBD\u7EA6\u4EA4\u6613\u6240200\u591A\u5E74\u7684\u5386\u53F2\u4E0A\u6700\u5E74\u8F7B\u7684CEO\u3002\u4E00\u65F6\u98CE\u5934\u65E0\u4E24\uFF0C\u5E02\u503C\u4E00\u5EA6\u9AD8\u8FBE56.5\u4EBF\u7F8E\u5143\u3002\u7136\u540E\u8DEF\u5B50\u8D70\u91CE\u4E86\uFF0C\u5F00\u59CB\u62CD\u7535\u89C6\u5267\uFF0C\u62CD\u7535\u5F71\uFF0C\u53C2\u52A0\u7EFC\u827A\u8282\u76EE\uFF0C\u540C\u65F6\u805A\u7F8E\u4E5F\u88AB\u7206\u51FA\u5316\u5986\u54C1\u95EE\u9898\uFF0C\u5E02\u503C\u4E00\u8DEF\u4E0B\u8DCC\uFF0C\u4E4B\u524D\u51C6\u5907\u4EE57\u7F8E\u91D1\u79C1\u6709\u5316\u9000\u5E02\uFF0C\u88AB\u53E6\u4E00\u77E5\u540D\u6295\u8D44\u4EBA\u6731\u5578\u864E\uFF08\u8DE8\u5883\u5708\u7684\u4EBA\u4E0D\u8BA4\u8BC6\uFF1F\u4E0D\u8981\u7D27\uFF0C\u4F60\u77E5\u9053\u6EF4\u6EF4\uFF0C\u997F\u4E86\u4E48\uFF0Cofo\u5C31\u597D\u4E86\uFF0C\u4ED6\u5168\u6295\u8D44\u8FC7\uFF0C\u8FD8\u6709\u662F\u7B2C\u4E00\u4E2A\u5728\u670B\u53CB\u5708\u6562\u6012\u5BF9\u9A6C\u5316\u817E\u7238\u7238\u7684\u4EBA\uFF0C\u6709\u5174\u8DA3\uFF0C\u81EA\u884C\u767E\u5EA6\uFF0C\u6211\u4E5F\u662F\u767E\u5EA6\u7684\uFF09\u6012\u603C\uFF0C\u5E76\u8D60\u5916\u53F7\uFF1A\u9648\u4E03\u5757\u3002\u73B0\u5728\u805A\u7F8E\u5E02\u503C\uFF0C\u53EA\u52692\u30013\u4EBF\u7F8E\u91D1\u4E86\u5427\uFF0C\u8DCC\u4E8699%\uFF0C\u9648\u6B27\u4E5F\u4ECE\u795E\u575B\u8DCC\u843D\u3002\u003C/p\u003E\n\u003Ch2\u003EShopee\u4E0E\u674E\u5C0F\u51AC\u7684\u5173\u7CFB\u003C/h2\u003E\n\u003Cp\u003E\u3000\u3000\u8BF4\u5B8C\u4E86\u9648\u4E03\u5757\uFF0C\u6211\u4EEC\u518D\u6765\u804A\u804A\u8FD9\u4E2AForrest Li\uFF08\u674E\u5C0F\u51AC\uFF09\uFF0C\u674E\u5C0F\u51AC\u4E70\u4E86\u9648\u6B27\u7684\u80A1\u4EFD\u540E\uFF0C\u628AGG game\u6539\u540D\u4E3AGarena\uFF0C \u8DDF\u817E\u8BAF\u7684\u53D1\u5C55\u7ECF\u5386\u9887\u4E3A\u76F8\u4F3C\uFF0CGarena\u6700\u521D\u662F\u4E00\u4E2A\u7F51\u7EDC\u793E\u4EA4\u548C\u6E38\u620F\u5E73\u53F0\uFF0C\u72EC\u7ACB\u7814\u53D1\u7684 Free Fire \u6E38\u620F\u98CE\u9761\u5168\u7403\u3002\u968F\u7740\u5E73\u53F0\u7528\u6237\u7684\u79EF\u7D2F\uFF0C\u516C\u53F8\u9010\u6E10\u884D\u751F\u53D1\u5C55\u6210\u7531\u6570\u5B57\u5A31\u4E50\u3001\u7535\u5B50\u5546\u52A1\u548C\u7535\u5B50\u94B1\u5305\u4E1A\u52A1\u7EC4\u6210\u7684\u7EFC\u5408\u79FB\u52A8\u4E92\u8054\u5E73\u53F0\uFF0C\u6210\u957F\u4E3A\u4E1C\u5357\u4E9A\u5730\u533A\u8D6B\u8D6B\u6709\u540D\u7684\u72EC\u89D2\u517D\u516C\u53F8\uFF0C \u5E02\u573A\u8986\u76D6