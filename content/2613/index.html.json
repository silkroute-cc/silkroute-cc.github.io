u003C/h2\u003E\n\u003Cp\u003E\u3000\u30002017\u5E7412\u670810\u65E5\uFF0CShopee\u6BCD\u516C\u53F8Sea\u4E0A\u5E02\uFF0C\u817E\u8BAF\u5728 Sea IPO \u524D\u5915\u4EE5\u6218\u7565\u6295\u8D44\u8005\u8EAB\u4EFD\u4E00\u4E3E\u6210\u4E3A\u7B2C\u4E00\u5927\u80A1\u4E1C\uFF0C\u80A1\u6743\u62AB\u9732\uFF0C\u817E\u8BAF\u5360\u80A139.7%\uFF0C\u5E72\u7238\u7238\u65E0\u7591\u4E86\uFF0C\u6211\u67E5\u9605\u4E86\u597D\u591A\u8D44\u6599\uFF0C\u5176\u5B9E\u817E\u8BAF\u5F88\u65E9\u5C31\u5F00\u59CB\u5165\u80A1Sea,\u5E76\u4E14\u5BF9 Sea \u5728\u8D44\u91D1\u3001\u6280\u672F\u3001\u4E1A\u52A1\u8FD8\u6709\u54C1\u724C\u4E0A\u7684\u652F\u6301\u53EF\u8C13\u4E0D\u9057\u4F59\u529B\u3002\u9664\u4E86\u8BA4\u8D2D\u516C\u53F8\u503A\u5238\uFF0C\u5BF9 Garena \u6E38\u620F\u5E73\u53F0\u7ED9\u4E0E\u5927\u6570\u636E\u6280\u672F\u652F\u6301\uFF0C\u8FD8\u6388\u4E88\u4E86 Garena \u5E73\u53F0\u5728\u9664\u8D8A\u5357\u4EE5\u5916\u7684\u4E1C\u5357\u4E9A\u4E94\u56FD\u4EE5\u53CA\u53F0\u6E7E\u5730\u533A\u53D1\u884C\u817E\u8BAF\u624B\u673A\u548C\u7535\u8111\u6E38\u620F\u7684\u4F18\u5148\u6743\u3002\u53E6\u5916\uFF0CShopee\u4E0A\u7EBF\u540E\uFF0C\u66F4\u662F\u7ED9\u4EBA\u7ED9\u94B1\u3002\u636E\u5C0F\u9053\u6D88\u606F\uFF0CShopee\u5728\u6DF1\u5733\u7684\u7814\u53D1\u4E2D\u5FC3\uFF0C\u4ECE\u817E\u8BAF\u8FC7\u6765\u5F88\u591A\u4EBA\u7684\uFF08\u5618\uFF0C\u6211\u771F\u5F97\u662F\u9053\u542C\u9014\u8BF4\u54C8\uFF09\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EShopee\u672A\u6765\u53D1\u5C55\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u6709\u4E86\u817E\u8BAF\u7684\u52A0\u6301\uFF0C\u4E14\u6BCD\u516C\u53F8Sea\u6DF1\u8015\u4E1C\u5357\u4E9A\u5E02\u573A\u591A\u5E74\uFF0CShopee\u5728\u4E1C\u5357\u4E9A\u5E02\u573A\u7684\u672A\u6765\u53D1\u5C55\u524D\u666F\u53EF\u671F\u3002\u003C/p\u003E\n\u003Cp\u003E\u5176\u5B9EShopee2015\u5E74\u624D\u6210\u7ACB\uFF0C\u6BD4Lazada\u665A\u4E86\u6574\u6574\u4E09\u56DB\u5E74\uFF0C\u4F46\u662F\u5E76\u4E0D\u59A8\u788D\u4ED6\u8FC5\u901F\u6210\u957F\u4E3A\u4E1C\u5357\u4E9A\u548C\u53F0\u6E7E\u5730\u533A GMV \u6700\u9AD8\u7684\u7535\u5546\u5E73\u53F0\uFF0C\u800C\u4E14\u8FD9\u79CD\u589E\u957F\u662F\u706B\u7BAD\u5F0F\uFF0C\u4E5F\u662F\u788E\u949E\u673A\u5F0F\u7684\u3002Shopee 2018\u5E74\u6536\u5165\u540C\u6BD4\u589E\u957F\u4E86\u8FD15\u500D\uFF0C\u53EF\u662F\u6210\u672C\u5374\u9AD8\u8FBE\u6536\u5165\u76841.7\u500D\u3002\u53E6\u5916Shopee \u7684\u5BF9\u624B\u53EF\u662F\u963F\u91CC\u5BB6\u7684\u72EC\u89D2\u517D Lazada \u548C\u6709\u963F\u91CC\u80A1\u4EFD\u7684\u5370\u5C3C\u72EC\u89D2\u517D Tokopedia\uFF08\u5370\u5C3C\u6700\u5927\u7684\u7535\u5B50\u5546\u52A1\u5E73\u53F0\uFF0C\u5728\u5370\u5C3C\uFF0CLazada,Shopee\u5747\u6392\u5728\u4ED6\u540E\u8FB9\uFF09\uFF0C\u5168\u90FD\u4E0D\u597D\u5BF9\u4ED8\u3002\u003C/p\u003E\n\u003Cp\u003E\u3000\u3000\u4F46\u662F\u4ECE Shopee \u7684\u603B\u4F53\u8D44\u8D28\u548C\u6F5C\u529B\u6765\u770B\uFF0C\u6211\u8BA4\u4E3AShopee\u8DDF\u963F\u91CC\u7CFB\u7684Lazada\u4EE5\u53CATokopedia\u5C06\u4F1A\u5728\u4E1C\u5357\u4E9A\u7535\u5546\u5E02\u573A\uFF0C\u5E73\u5206\u79CB\u8272\uFF0C\u53EF\u80FD\u7C7B\u4F3C\u4E8E\u56FD\u5185\u4E4B\u524D58\u540C\u57CE\u4E0E\u8D76\u96C6\uFF0C\u6EF4\u6EF4\u4E0E\u5FEB\u7684\u5F53\u65F6\u5171\u5B58\u7684\u4E00\u4E2A\u72B6\u6001\uFF0C\u5F53\u7136\u540E\u671F\u4E5F\u6709\u53EF\u80FD\u4E00\u4E2A\u628A\u53E6\u4E00\u4E2A\u7529\u5728\u8EAB\u540E\u3002\u800C\u4E14Shopee\u6709Sea\u96C6\u56E2\u7684\u52A0\u6301\uFF0C\u5C24\u5176\u662F\u5728\u865A\u62DF\u6E38\u620F\u4EA7\u54C1\u54C1\u7C7B\u65B9\u9762\uFF0C\u9886\u5148Lazada\u597D\u51E0\u4E2A\u6BB5\u4F4D\uFF0C\u53E6\u5916Shopee\u73B0\u5728\u5728\u5356\u5BB6\u7AEF\u5F88\u52AA\u529B\uFF0C\u5728\u56FD\u5185\u5927\u529B\u62DB\u5546\uFF0C\u8865\u9F50\u81EA\u5DF1\u4EA7\u54C1\u8D44\u6E90\u8FD9\u8FB9\u7684\u77ED\u677F\u4E0D\u8BF4\uFF0C\u5728\u7269\u6D41\u65B9\u9762\uFF0C\u5F00\u59CB\u5728\u56FD\u5185\u5EFA\u7ACB\u5F88\u591A\u57CE\u5E02\u5EFA\u7ACB\u4E2D\u8F6C\u4ED3\u5E93\uFF0C\u5728\u4E1C\u5357\u4E9A\u5404\u56FD\u7684\u57CE\u5E02\u4E5F\u5EFA\u7ACB\u4E2D\u8F6C\u4ED3\u5E93\uFF0C\u5E76\u4E14\u4E0E\u4E1C\u5357\u4E9A\u7684\u4E00\u4E9B\u5927\u7684\u7269\u6D41\u5DE8\u5934\u4E5F\u641E\u4E86\u6218\u7565\u5408\u4F5C\uFF0C\u6240\u4EE5\u8BF4\u524D\u666F\u53EF\u671F\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EShopee\u4E0ELazada\u7684\u7ADE\u4E89\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u3000\u3000\u5176\u5B9EShopee\u80FD\u5230\u4ECA\u5929\u8FD9\u4E2A\u4F53\u91CF\uFF0C\u5B8C\u5168\u662F\u7531\u4E8ELazada\u7ED9\u81EA\u5DF1\u6316\u4E86\u7279\u522B\u6DF1\u7684\u5751\uFF0C\u5F53\u7136\u4E5F\u6709\u53EF\u80FD\u662F\u4E1C\u5357\u4E9A\u7535\u5546\u5E02\u573A\u672C\u6765\u5C31\u8D77\u70B9\u4F4E\uFF0C\u5E02\u573A\u6BD4\u8F83\u5272\u88C2\uFF0C\u6CA1\u6709\u7EDD\u5BF9\u7684\u5784\u65AD\u5DE8\u5934\uFF0C\u6240\u4EE5\u7ED9\u4E86Shopee\u5145\u8DB3\u7684\u65F6\u95F4\u53BB\u8BD5\u9519\uFF0C\u53D1\u5C55\uFF0C\u4F46\u73B0\u5728Lazada\u7684\u5356\u5BB6\u7AEF\u3001\u4E70\u5BB6\u7AEF\u7684\u4F53\u9A8C\uFF0C\u771F\u5F97\u662F\u8D8A\u6765\u8D8A\u597D\u4E86\u3002\u5C31\u62FF\u7269\u6D41\u6765\u8BF4\uFF0C\u4E4B\u524D\u5230\u9A6C\u6765\uFF0C\u4ECE\u63A5\u5230\u8BA2\u5355\u5230\u4E70\u5BB6\u6536\u5230\u8D27\uFF0C\u9700\u89817~12\u5929\uFF0C\u73B0\u5728\u53EF\u80FD\u53EA\u9700\u89813~5\u5929\uFF0CShopee\u7269\u6D41\u4F53\u9A8C\u7A0D\u5FAE\u5DEE\u4E00\u4E9B\u3002\u53E6\u5916\u5982\u679C\uFF0C\u6211\u662F\u8BF4\u5982\u679C\u6DD8\u5B9D\u628A\u81EA\u5DF1\u7684\u5356\u5BB6\u8D44\u6E90\uFF08\u4E2A\u4EBA\uFF0C\u5929\u732B\uFF09\u5168\u90E8\u63A5\u5165\u5230Lazada\u5E73\u53F0\uFF0C\u90A3\u53EF\u5C31\u4E86\u4E0D\u5F97\u4E86\uFF0C\u4F60\u60F3\u4E00\u4E0B\uFF0C\u6DD8\u5B9D\u6709\u51E0\u5341\u4EBF\u5546\u54C1\u8D44\u6599\uFF0C\u8DB3\u591F\u4E1C\u5357\u4E9A\u7684\u4E70\u5BB6\u6311\u82B1\u773C\u4E86\uFF0C\u5927\u5BB6\u53EF\u80FD\u4F1A\u8BF4\uFF0C\u56FD\u5185\u7684\u5356\u5BB6\u5982\u4F55\u8DDF\u4E1C\u5357\u4E9A\u7684\u4E70\u5BB6\u600E\u4E48\u6C9F\u901A\uFF0C\u8FD8\u6709\u8D44\u6599\u7FFB\u8BD1\u7684\u95EE\u9898\uFF0C\u6211\u8BA4\u4E3A\u7FFB\u8BD1\u8FD9\u4E2A\u4E1C\u897F\u5728\u51E0\u5E74\u540E\u7684AI\u65F6\u4EE3\u771F\u5F97\u771F\u5F97\u53EA\u662F\u5C0F\u83DC\u4E00\u789F\u3002\u003C/p\u003E\n\u003Cp\u003E\u5185\u5BB9\u4F86\u6E90\uFF1A\u003Ca href=\u0022https://zhuanlan.zhihu.com/p/67141146\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u4E1C\u5357\u4E9A\u7535\u5546\u5DE8\u5934shopee\u7684\u524D\u4E16\u4ECA\u751F - \u77E5\u4E4E (zhihu.com)\u003C/a\u003E\u003C/p\u003E\n",
