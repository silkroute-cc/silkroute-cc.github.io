  "route": "/3682/",
  "title": "\u5927\u9A6C\u653F\u5E9C\u540C\u610F\u91CD\u65B0\u7814\u7A76MM2H\u6807\u51C6\u6761\u4EF6 \u65C5\u6E38\u90E8:\u7533\u8BF7\u66F4\u7075\u6D3B\u900F\u660E",
  "summary": "\uFF08\u5E03\u57CE18\u65E5\u8BAF\uFF09\u653F\u5E9C\u540C\u610F\u91CD\u65B0\u7814\u7A76\u9A6C\u6765\u897F\u4E9A\u6211\u7684\u7B2C\u4E8C\u5BB6\u56ED\u8BA1\u5212\uFF08MM2H)\u7684\u6807\u51C6\u548C\u6761\u4EF6\uFF0C\u4EE5\u8BA9\u6B64\u8BA1\u5212\u66F4\u5177\u7ADE\u4E89\u529B\u3002 \u65C5\u6E38\u3001\u827A\u672F\u53CA\u6587\u5316\u90E8\u957F\u62FF\u7763\u65AF\u91CC\u5F20\u5E86\u4FE1\u548C\u5185\u653F\u90E8\u79D8\u4E66\u957F\u62FF\u7763\u9646\u7EE7\u6628\u65E5\u5728\u5E03\u57CE\u4F1A\u5546\u540E\uFF0C\u53CC\u65B9\u540C\u610F\u8BA9\u65C5\u6E38\u90E8\u65D7\u4E0B\u7684\u5927\u9A6C\u65C5\u6E38\u4FC3\u8FDB\u5C40\u7B5B\u9009\u5927\u9A6C\u6211\u7684\u7B2C\u4E8C\u5BB6\u56ED\u8BA1\u5212\u4E00\u7AD9\u5F0F\u4E2D\u5FC3\u7A0B\u5E8F\u540E\uFF0C\u518D\u63A8\u5E7F\u548C\u63A8\u8350\u7533\u8BF7\u7A0B\u5E8F\uFF0C\u4EE5\u8BA9\u6709\u5174\u8DA3\u7533\u8BF7\u7684\u5916\u56FD\u4EBA\u66F4\u4E86\u89E3\u8BE6\u60C5\u548C\u6761\u4EF6\u3002 \u65C5\u6E38\u90E8\u53D1\u6587\u544A\u8BF4\uFF0C\u4E00\u7AD9\u5F0F\u4E2D\u5FC3\u5C06\u534F\u52A9\u7533\u8BF7\u4EBA\u5904\u7406\u7533\u8BF7\u5E76\u6536\u96C6\u5FC5\u8981\u7684\u8D44\u6599\uFF0C\u7136\u540E\u76F4\u63A5\u8F6C\u53D1\u7ED9\u5185\u653F\u90E8\uFF08\u6216\u662F\u79FB\u6C11\u5C40\uFF09\uFF0C\u4EE5\u5904\u7406\u53CA\u53D1\u51FA\u5927\u9A6C\u6211\u7684\u7B2C\u4E8C\u5BB6\u56ED\u8BA1\u5212\u7684\u7B7E\u8BC1\u3002 \u5F20\u5E86\u4FE1\u8BF4\u2026",
  "body": "\u003Cp\u003E\uFF08\u5E03\u57CE18\u65E5\u8BAF\uFF09\u653F\u5E9C\u540C\u610F\u91CD\u65B0\u7814\u7A76\u9A6C\u6765\u897F\u4E9A\u6211\u7684\u7B2C\u4E8C\u5BB6\u56ED\u8BA1\u5212\uFF08MM2H)\u7684\u6807\u51C6\u548C\u6761\u4EF6\uFF0C\u4EE5\u8BA9\u6B64\u8BA1\u5212\u66F4\u5177\u7ADE\u4E89\u529B\u3002\u003C/p\u003E\n\u003Cp\u003E\n\u65C5\u6E38\u3001\u827A\u672F\u53CA\u6587\u5316\u90E8\u957F\u62FF\u7763\u65AF\u91CC\u5F20\u5E86\u4FE1\u548C\u5185\u653F\u90E8\u79D8\u4E66\u957F\u62FF\u7763\u9646\u7EE7\u6628\u65E5\u5728\u5E03\u57CE\u4F1A\u5546\u540E\uFF0C\u53CC\u65B9\u540C\u610F\u8BA9\u65C5\u6E38\u90E8\u65D7\u4E0B\u7684\u5927\u9A6C\u65C5\u6E38\u4FC3\u8FDB\u5C40\u7B5B\u9009\u5927\u9A6C\u6211\u7684\u7B2C\u4E8C\u5BB6\u56ED\u8BA1\u5212\u4E00\u7AD9\u5F0F\u4E2D\u5FC3\u7A0B\u5E8F\u540E\uFF0C\u518D\u63A8\u5E7F\u548C\u63A8\u8350\u7533\u8BF7\u7A0B\u5E8F\uFF0C\u4EE5\u8BA9\u6709\u5174\u8DA3\u7533\u8BF7\u7684\u5916\u56FD\u4EBA\u66F4\u4E86\u89E3\u8BE6\u60C5\u548C\u6761\u4EF6\u3002\n\u003C/p\u003E\n\u003Cp\u003E\u65C5\u6E38\u90E8\u53D1\u6587\u544A\u8BF4\uFF0C\u4E00\u7AD9\u5F0F\u4E2D\u5FC3\u5C06\u534F\u52A9\u7533\u8BF7\u4EBA\u5904\u7406\u7533\u8BF7\u5E76\u6536\u96C6\u5FC5\u8981\u7684\u8D44\u6599\uFF0C\u7136\u540E\u76F4\u63A5\u8F6C\u53D1\u7ED9\u5185\u653F\u90E8\uFF08\u6216\u662F\u79FB\u6C11\u5C40\uFF09\uFF0C\u4EE5\u5904\u7406\u53CA\u53D1\u51FA\u5927\u9A6C\u6211\u7684\u7B2C\u4E8C\u5BB6\u56ED\u8BA1\u5212\u7684\u7B7E\u8BC1\u3002\u003C/p\u003E\n\u003Cp\u003E\n\u5F20\u5E86\u4FE1\u8BF4\uFF0C\u6B64\u4E3E\u5C06\u4F1A\u4EE4\u5230\u7533\u8BF7\u7A0B\u5E8F\u66F4\u52A0\u7075\u6D3B\u6027\u3002\n\u003C/p\u003E\n\u003Cp\u003E\u6587\u544A\u8BF4\uFF0C\u53CC\u65B9\u4E5F\u8BA8\u8BBA\u5C24\u5176\u662F\u4E2D\u56FD\u548C\u5370\u5EA6\u6E38\u5BA2\u7684\u843D\u5730\u7B7E\u8BC1 (VOA) \u4FBF\u5229\uFF1B\u5185\u653F\u90E8\u540C\u610F\u7EE7\u7EED\u53D1\u51FA\u843D\u5730\u7B7E\u8BC1\uFF0C\u4EE5\u63A8\u52A8\u6211\u56FD\u7684\u65C5\u6E38\u4E1A\u3002\u60DF\uFF0C\u53CC\u65B9\u9700\u8981\u8FDB\u4E00\u6B65\u8BE6\u7EC6\u7814\u7A76\u3002\u003C/p\u003E\n\u003Cp\u003E\n\u5F20\u5E86\u4FE1\u900F\u9732\uFF0C\u76EE\u524D\u4E1C\u76DF\u56FD\u5BB6\uFF0C\u5C24\u5176\u662F\u5370\u5C3C\u5DF2\u5F00\u653E\u591A\u4E2A\u56FD\u5BB6\u7684\u843D\u5730\u7B7E\u8BC1\uFF0C\u5927\u9A6C\u6709\u5FC5\u8981\u52A0\u5FEB\u8FD9\u9879\u7814\u7A76\uFF0C\u4EE5\u63A8\u8FDB\u6211\u56FD\u7684\u65C5\u6E38\u4E1A\uFF0C\u8BA9\u5927\u9A6C\u4E0D\u4F1A\u9519\u5931\u8FD9\u4E2A\u9EC4\u91D1\u65F6\u673A\u3002\n\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u4E5F\u63D0\u5230\u65C5\u6E38\u90E8\u53CA\u5185\u653F\u90E8\u5C06\u4F1A\u9488\u5BF9\u6B64\u4E8B\u63D0\u5448\u5185\u9601\u8BA8\u8BBA\uFF0C\u4EE5\u91C7\u53D6\u8FDB\u4E00\u6B65\u7684\u884C\u52A8\u3002\u003C/p\u003E\n\u003Cp\u003E\n\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/o29RCu51rmnTKhuoM_CISA\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
