  "title": "\u5916\u6D3E\u4EBA\u5458\u751F\u6D3B\u6210\u672C\u6700\u9AD8\u57CE\u5E02 \u5409\u9686\u5761\u6392\u540D\u7B2C167",
  "summary": "\uFF08\u5409\u9686\u57617\u65E5\u8BAF\uFF09\u6839\u636E\u4EBA\u529B\u8D44\u6E90\u7BA1\u7406\u987E\u95EE\u673A\u6784ECA\u56FD\u9645\uFF08ECA International\uFF09\u6700\u65B0\u53D1\u5E03\u9488\u5BF9\u751F\u6D3B\u6210\u672C\u7684\u8C03\u67E5\u663E\u793A\uFF0C\u5728\u5168\u7403\u5916\u6D3E\u4EBA\u5458\u751F\u6D3B\u6210\u672C\u6700\u9AD8\u7684\u57CE\u5E02\u4E2D\uFF0C\u5409\u9686\u5761\u6392\u540D\u7B2C167\u4F4D\uFF0C\u5728\u4E9A\u6D32\u5219\u6392\u540D\u7B2C32\u3002 ECA\u56FD\u9645\u4E9A\u6D32\u533A\u603B\u76D1\u5173\u793C\u5EC9\u8868\u793A\uFF0C\u9AD8\u901A\u8D27\u81A8\u80C0\u7387\u5BFC\u81F4\u9A6C\u6765\u897F\u4E9A\u591A\u4E2A\u5730\u533A\u7684\u6392\u540D\u4E0A\u5347\uFF0C\u5305\u62EC\u67D4\u4F5B\u5DDE\u65B0\u5C71\u3002 \u201C\u867D\u7136\u8BB8\u591A\u98DF\u54C1\u4EF7\u683C\u5927\u5E45\u4E0A\u6DA8\uFF0C\u4F46\u6700\u5927\u7684\u53D8\u5316\u662F\u6C7D\u6CB9\uFF0C\u4EF7\u683C\u6DA8\u5E45\u8D85\u8FC750%\u3002\u4EE4\u5409\u5151\u7F8E\u5143\u7684\u75B2\u8F6F\u62B5\u6D88\u5409\u9686\u5761\u7684\u901A\u80C0\u5F71\u54CD\uFF0C\u5BFC\u81F4\u6392\u540D\u4E0B\u964D\u3002\u201D \u6839\u636E\u62A5\u544A\uFF0C\u6CF0\u56FD\u548C\u83F2\u5F8B\u5BBE\u7684\u57CE\u5E02\u4ECA\u5E74\u6392\u540D\u4E5F\u6709\u6240\u4E0B\u964D\uFF1B\u2026",
  "body": "\u003Cp\u003E\uFF08\u5409\u9686\u57617\u65E5\u8BAF\uFF09\u6839\u636E\u4EBA\u529B\u8D44\u6E90\u7BA1\u7406\u987E\u95EE\u673A\u6784ECA\u56FD\u9645\uFF08ECA International\uFF09\u6700\u65B0\u53D1\u5E03\u9488\u5BF9\u751F\u6D3B\u6210\u672C\u7684\u8C03\u67E5\u663E\u793A\uFF0C\u5728\u5168\u7403\u5916\u6D3E\u4EBA\u5458\u751F\u6D3B\u6210\u672C\u6700\u9AD8\u7684\u57CE\u5E02\u4E2D\uFF0C\u5409\u9686\u5761\u6392\u540D\u7B2C167\u4F4D\uFF0C\u5728\u4E9A\u6D32\u5219\u6392\u540D\u7B2C32\u3002\u003C/p\u003E\n\u003Cp\u003EECA\u56FD\u9645\u4E9A\u6D32\u533A\u603B\u76D1\u5173\u793C\u5EC9\u8868\u793A\uFF0C\u9AD8\u901A\u8D27\u81A8\u80C0\u7387\u5BFC\u81F4\u9A6C\u6765\u897F\u4E9A\u591A\u4E2A\u5730\u533A\u7684\u6392\u540D\u4E0A\u5347\uFF0C\u5305\u62EC\u67D4\u4F5B\u5DDE\u65B0\u5C71\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u867D\u7136\u8BB8\u591A\u98DF\u54C1\u4EF7\u683C\u5927\u5E45\u4E0A\u6DA8\uFF0C\u4F46\u6700\u5927\u7684\u53D8\u5316\u662F\u6C7D\u6CB9\uFF0C\u4EF7\u683C\u6DA8\u5E45\u8D85\u8FC750%\u3002\u4EE4\u5409\u5151\u7F8E\u5143\u7684\u75B2\u8F6F\u62B5\u6D88\u5409\u9686\u5761\u7684\u901A\u80C0\u5F71\u54CD\uFF0C\u5BFC\u81F4\u6392\u540D\u4E0B\u964D\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u6839\u636E\u62A5\u544A\uFF0C\u6CF0\u56FD\u548C\u83F2\u5F8B\u5BBE\u7684\u57CE\u5E02\u4ECA\u5E74\u6392\u540D\u4E5F\u6709\u6240\u4E0B\u964D\uFF1B\u66FC\u8C37\u4E0B\u964D12\u4F4D\u81F3\u7B2C63\u4F4D\uFF0C\u9A6C\u5C3C\u62C9\u4E0B\u964D10\u4F4D\u81F3\u7B2C67\u4F4D\uFF0C\u5BBF\u52A1\u5E02\u4E0B\u964D14\u4F4D\u81F3\u5168\u7403\u7B2C169\u4F4D\u3002\u003C/p\u003E\n\u003Cp\u003E\u8001\u631D\u5728\u4E1C\u5357\u4E9A\u5730\u533A\u4E2D\u6392\u540D\u4E0B\u964D\u5E45\u5EA6\u6700\u5927\uFF0C\u7531\u4E8E\u57FA\u666E\u5151\u7F8E\u5143\u8D2C\u503C38%\uFF0C\u9996\u90FD\u6C38\u73CD\uFF08\u4E07\u8C61\uFF09\u5728\u5168\u7403\u6392\u540D\u4E0B\u964D29\u4F4D\u81F3\u7B2C193\u4F4D\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u65B0\u52A0\u5761\u5168\u7403\u7B2C8\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u4E0E\u6B64\u540C\u65F6\uFF0C\u8DE8\u5883\u4F4F\u5BBF\u6210\u672C\u7684\u98D9\u5347\u6269\u5927\u4E86\u65B0\u52A0\u5761\u4E0E\u4E1C\u5357\u4E9A\u90BB\u56FD\u4E4B\u95F4\u751F\u6D3B\u6210\u672C\u7684\u5DEE\u8DDD\uFF0C\u8FD9\u4E2A\u57CE\u5E02\u56FD\u5BB6\u6BD4\u53BB\u5E74\u4E0A\u5347\u4E864\u540D\uFF0C\u6210\u4E3A\u5168\u7403\u7B2C8\u5927\u5916\u7C4D\u4EBA\u58EB\u751F\u6D3B\u6210\u672C\u6700\u9AD8\u7684\u57CE\u5E02\u3002\u003C/p\u003E\n\u003Cp\u003E\u5173\u793C\u5EC9\u8BF4\uFF0C\u65B0\u52A0\u5761\u5728\u6700\u65B0\u6392\u540D\u4E2D\u4E0A\u5347\u7684\u6700\u5927\u63A8\u52A8\u529B\u662F 2022\u5E74\u7684\u79DF\u91D1\u6210\u672C\u4EE5\u4E24\u4F4D\u6570\u589E\u957F\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6307\u51FA\uFF0C\u75AB\u60C5\u5F71\u54CD\u4E86\u5E02\u573A\u4E0A\u7684\u4F4F\u5BBF\u4F9B\u5E94\uFF0C\u968F\u7740\u57CE\u5E02\u91CD\u65B0\u5F00\u653E\uFF0C\u9700\u6C42\u7684\u590D\u82CF\u5C06\u663E\u7740\u589E\u52A0\u3002\u8FD9\u53EF\u80FD\u662F\u4E00\u4E2A\u77ED\u671F\u7684\u51B2\u51FB\uFF0C\u4F46\u65B0\u52A0\u5761\u76EE\u524D\u662F\u5168\u7403\u5341\u5927\u6700\u6602\u8D35\u57CE\u5E02\u4E4B\u4E00\u3002\u003C/p\u003E\n\u003Cp\u003EECA\u8FD9\u9879\u8C03\u67E5\u6BD4\u8F83\u4E86\u5168\u7403490\u591A\u4E2A\u5730\u70B9\u7684\u5916\u6D3E\u4EBA\u5458\u901A\u5E38\u8D2D\u4E70\u7684\u6D88\u8D39\u54C1\u548C\u670D\u52A1\uFF0C\u4F4F\u5BBF\u6570\u636E\u4E5F\u88AB\u8003\u8651\u5728\u5185\uFF0C\u6BD4\u8F83\u4E86\u5168\u7403410\u591A\u4E2A\u5730\u70B9\u7684\u5916\u6D3E\u5458\u5DE5\u901A\u5E38\u5C45\u4F4F\u5730\u533A\u7684\u79DF\u91D1\u6210\u672C\u3002\u003C/p\u003E\n\u003Cp\u003E\n\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/HpCruDQ4jEZ6sF3YD9f9uA\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
