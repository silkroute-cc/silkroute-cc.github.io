  "title": "\u4E2D\u4EA4\u9A6C\u6765\u897F\u4E9A\u4E1C\u6D77\u5CB8\u94C1\u8DEF\u52A8\u6001",
  "summary": "01 NEWS \u9A6C\u4E1C\u94C1\u9879\u76EE\u4E03\u5206\u90E8 \u9996\u4E2A\u8FDE\u7EED\u6881\u4E3B\u58A9\u627F\u53F0\u6D47\u7B51\u5B8C\u6210 12\u670821\u65E5\u51CC\u6668\uFF0C\u7ECF\u8FC713\u4E2A\u5C0F\u65F6\u7684\u8FDE\u7EED\u594B\u6218\uFF0C\u9A6C\u4E1C\u94C1\u9879\u76EE\u4E03\u5206\u90E82\u53F7\u6865\u8FDE\u7EED\u6881\u4E3B\u58A9\u627F\u53F0P1\u6DF7\u51DD\u571F\u987A\u5229\u5B8C\u6210\u6D47\u7B51\uFF0C\u6807\u5FD7\u7740\u4E03\u5206\u90E8\u8FDE\u7EED\u6881\u6865\u7531\u6869\u57FA\u65BD\u5DE5\u8F6C\u5165\u627F\u53F0\u3001\u58A9\u8EAB\u65BD\u5DE5\u9636\u6BB5\u3002 2\u53F7\u6865\u5168\u957F1246\u7C73\uFF0C\u91C7\u752840\u002B64\u002B40\u7C73\u8FDE\u7EED\u6881\u8DE8\u8D8A\u2026",
  "body": "\u003Cp\u003E\u003Cstrong\u003E01\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003ENEWS\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u9A6C\u4E1C\u94C1\u9879\u76EE\u4E03\u5206\u90E8\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u9996\u4E2A\u8FDE\u7EED\u6881\u4E3B\u58A9\u627F\u53F0\u6D47\u7B51\u5B8C\u6210\u003C/strong\u003E\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2022/12/frc-dd48c5eea2d31163f2e0b5649765b82e.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E12\u670821\u65E5\u51CC\u6668\uFF0C\u7ECF\u8FC713\u4E2A\u5C0F\u65F6\u7684\u8FDE\u7EED\u594B\u6218\uFF0C\u9A6C\u4E1C\u94C1\u9879\u76EE\u4E03\u5206\u90E82\u53F7\u6865\u8FDE\u7EED\u6881\u4E3B\u58A9\u627F\u53F0P1\u6DF7\u51DD\u571F\u987A\u5229\u5B8C\u6210\u6D47\u7B51\uFF0C\u6807\u5FD7\u7740\u4E03\u5206\u90E8\u8FDE\u7EED\u6881\u6865\u7531\u6869\u57FA\u65BD\u5DE5\u8F6C\u5165\u627F\u53F0\u3001\u58A9\u8EAB\u65BD\u5DE5\u9636\u6BB5\u3002\u003C/p\u003E\n\u003Cp\u003E2\u53F7\u6865\u5168\u957F1246\u7C73\uFF0C\u91C7\u752840\u002B64\u002B40\u7C73\u8FDE\u7EED\u6881\u8DE8\u8D8A2\u53F7\u516C\u8DEF\uFF0C\u4E3A\u4E03\u5206\u90E8\u9996\u67B6\u65B9\u5411\u7B2C\u4E00\u5EA7\u6865\u6881\u3002\u672C\u6B21\u65BD\u5DE5\u7684P1\u58A9\u7D27\u90BB2\u53F7\u516C\u8DEF\uFF0C\u627F\u53F0\u957F13.2\u7C73\u3001\u5BBD9.6\u7C73\u3001\u9AD82.5\u7C73\uFF0C\u6D47\u7B51\u6DF7\u51DD\u571F317\u65B9\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E3A\u987A\u5229\u5B8C\u6210\u8282\u70B9\u76EE\u6807\uFF0C\u81EA\u8FDE\u7EED\u6881\u4E3B\u58A9\u627F\u53F0\u65BD\u5DE5\u4EE5\u6765\uFF0C\u5206\u90E8\u7F16\u5236\u4E86\u8BE6\u7EC6\u7684\u4E13\u9879\u65BD\u5DE5\u65B9\u6848\uFF0C\u4E25\u683C\u843D\u5B9E\u5404\u9879\u7BA1\u63A7\u8981\u70B9\uFF0C\u6309\u5DE5\u5E8F\u9010\u9879\u5BF9\u4F5C\u4E1A\u4EBA\u5458\u8FDB\u884C\u5B89\u5168\u6280\u672F\u4EA4\u5E95\u3002\u5728\u6D47\u7B51\u8FC7\u7A0B\u4E2D\uFF0C\u9879\u76EE\u4E25\u683C\u6267\u884C\u9886\u5BFC\u5E26\u73ED\u5236\u5EA6\uFF0C\u6280\u672F\u4EBA\u5458\u3001\u8BD5\u9A8C\u4EBA\u5458\u5BF9\u6DF7\u51DD\u571F\u7684\u914D\u5408\u6BD4\u3001\u632F\u6363\u8FC7\u7A0B\u8FDB\u884C\u5168\u8FC7\u7A0B\u76EF\u63A7\uFF0C\u4E3A\u9996\u4E2A\u8FDE\u7EED\u6881\u627F\u53F0\u7684\u987A\u5229\u6D47\u7B51\u63D0\u4F9B\u6709\u529B\u4FDD\u969C\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E03\u5206\u90E8\u7BA1\u6BB5\u8FDE\u7EED\u688118\u5904\uFF0C\u5DE5\u671F\u538B\u529B\u5DE8\u5927\u3002\u672C\u6B212\u53F7\u6865\u9996\u4E2A\u8FDE\u7EED\u6881\u4E3B\u58A9\u627F\u53F0\u7684\u987A\u5229\u6D47\u7B51\uFF0C\u6781\u5927\u63D0\u5347\u9879\u76EE\u4EBA\u5458\u58EB\u6C14\u3002\uFF08\u51AF\u8000\u660E\uFF09\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E03\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003ENEWS\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u9A6C\u4E1C\u94C1\u516D\u5206\u90E8\u4E00\u5DE5\u70B9\u7EC4\u7EC7\u53EC\u5F00\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E2022\u5E74\u5EA6\u9879\u76EE\u4E2D\u5C42\u7BA1\u7406\u4EBA\u5458\u6C11\u4E3B\u6D4B\u8BC4\u4F1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2022/12/frc-0ec0d2bcff3bbd12dc2973de84adf01d.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u4E3A\u8FDB\u4E00\u6B65\u5F3A\u5316\u4EBA\u624D\u961F\u4F0D\u5EFA\u8BBE\uFF0C\u5168\u9762\u4E86\u89E3\u9879\u76EE\u4E2D\u5C42\u7BA1\u7406\u4EBA\u5458\u5C65\u804C\u60C5\u51B5\uFF0C12\u670817\u65E5\u4E0B\u5348\uFF0C\u9A6C\u4E1C\u94C1\u516D\u5206\u90E8\u4E00\u5DE5\u70B9\u53EC\u5F002022\u5E74\u5EA6\u4E2D\u5C42\u7BA1\u7406\u4EBA\u5458\u6C11\u4E3B\u6D4B\u8BC4\u6D3B\u52A8\u3002\u9879\u76EE\u9886\u5BFC\u73ED\u5B50\u3001\u90E8\u95E8\u6B63\u526F\u804C\u4EBA\u5458\u3001\u7BA1\u7406\u4EBA\u5458\u5171\u8BA166\u4EBA\u901A\u8FC7\u73B0\u573A\u548C\u89C6\u9891\u53C2\u52A0\u8BC4\u6D4B\u3002\u003C/p\u003E\n\u003Cp\u003E\u6B64\u6B21\u6D4B\u8BC4\u4EE5\u201C\u80FD\u5E72\u4E8B \u5728\u72B6\u6001 \u5584\u5408\u4F5C\u201D\u4E3A\u8003\u6838\u6807\u51C6\uFF0C\u5185\u5BB9\u91CD\u70B9\u56F4\u7ED5\u804C\u5DE5\u653F\u6CBB\u7D20\u517B\u3001\u5C65\u804C\u80FD\u529B\u3001\u534F\u540C\u5DE5\u4F5C\u60C5\u51B5\u3001\u5DE5\u4F5C\u53CA\u751F\u6D3B\u7EAA\u5F8B\u7B494\u5927\u987915\u5C0F\u9879\u5185\u5BB9\u5C55\u5F00\uFF0C\u805A\u7126\u7EFC\u5408\u80FD\u529B\u8BC4\u6D4B\uFF0C\u901A\u8FC7\u201C\u667E\u3001\u6652\u3001\u8BC4\u201D\u7B49\u624B\u6BB5\uFF0C\u6FC0\u53D1\u804C\u5DE5\u5DE5\u4F5C\u52A8\u529B\u53CA\u521B\u65B0\u529B\uFF0C\u8FDB\u4E00\u6B65\u8425\u9020\u7231\u5C97\u656C\u4E1A\uFF0C\u594B\u52C7\u4E89\u5148\u7684\u826F\u597D\u5DE5\u4F5C\u6C1B\u56F4\u3002\u003C/p\u003E\n\u003Cp\u003E\u6B64\u6B21\u6D4B\u8BC4\u65E2\u662F\u9879\u76EE\u90E8\u575A\u6301\u9AD8\u6807\u51C6\u57F9\u517B\u4EBA\u624D\u7684\u91CD\u8981\u624B\u6BB5\uFF0C\u4E5F\u4E3A\u5E74\u672B\u7684\u8BC4\u4F18\u4E89\u5148\u6D3B\u52A8\u63D0\u4F9B\u4E86\u4F9D\u636E\uFF0C\u9879\u76EE\u5C06\u4EE5\u6B64\u4E3A\u5951\u673A\uFF0C\u6301\u7EED\u8FDB\u884C\u4EBA\u624D\u9009\u62D4\u3001\u8003\u6838\uFF0C\u8D2F\u5F7B\u597D\u80FD\u8005\u4E0A\u3001\u5E73\u8005\u8BA9\u3001\u5EB8\u8005\u4E0B\u7684\u7528\u4EBA\u5236\u5EA6\uFF0C\u4E3A\u516C\u53F8\u548C\u9879\u76EE\u53D1\u5C55\u6253\u9020\u4E00\u652F\u7D20\u8D28\u9AD8\u3001\u80FD\u529B\u5F3A\u7684\u7BA1\u7406\u961F\u4F0D\uFF0C\u4E3A\u9879\u76EE\u4E0B\u4E00\u5E74\u5EA6\u7684\u65BD\u5DE5\u751F\u4EA7\u7BA1\u7406\u4FDD\u9A7E\u62A4\u822A\u3002\uFF08\u5189\u8C6A\uFF09\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E05\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003ENEWS\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u9A6C\u4E1C\u94C1\u516D\u5206\u90E8\u4E00\u5DE5\u70B9\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u53EC\u5F00\u65BD\u5DE5\u8D28\u91CF\u54C1\u8D28\u63D0\u5347\u5BA3\u8D2F\u4F1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2022/12/frc-3a19d47e56d1801c3bfc8bbd1a8093f9.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u4E3A\u8FDB\u4E00\u6B65\u63D0\u5347\u5DE5\u7A0B\u8D28\u91CF\uFF0C12\u670819\u65E5\u665A\uFF0C\u9A6C\u4E1C\u94C1\u516D\u5206\u90E8\u4E00\u5DE5\u70B9\u7EC4\u7EC7\u53EC\u5F00\u65BD\u5DE5\u8D28\u91CF\u54C1\u8D28\u63D0\u5347\u5BA3\u8D2F\u4F1A\uFF0C\u9879\u76EE\u9886\u5BFC\u3001\u5404\u90E8\u95E8\u8D1F\u8D23\u4EBA\u3001\u73B0\u573A\u4E3B\u7BA1\u5DE5\u7A0B\u5E08\u7B49\u5171\u8BA128\u4EBA\u901A\u8FC7\u73B0\u573A\u002B\u89C6\u9891\u7684\u5F62\u5F0F\u53C2\u52A0\u3002\u003C/p\u003E\n\u003Cp\u003E\u4F1A\u8BAE\u4F20\u8FBE\u4E86\u9A6C\u4E1C\u94C1\u603B\u7ECF\u7406\u90E8\u3001\u516D\u5206\u90E8\u5173\u4E8E\u672C\u6B21\u65BD\u5DE5\u8D28\u91CF\u54C1\u8D28\u63D0\u5347\u884C\u52A8\u7684\u5177\u4F53\u8981\u6C42\uFF0C\u968F\u540E\u5BF9\u9879\u76EE\u5B9E\u65BD\u65B9\u6848\u8FDB\u884C\u5168\u5458\u5BA3\u8D2F\u3002\u65B9\u6848\u4ECE\u9879\u76EE\u5728\u5EFA\u65BD\u5DE5\u7684\u8DEF\u57FA\u5DE5\u7A0B\u3001\u6865\u6881\u5DE5\u7A0B\u96A7\u9053\u5DE5\u7A0B\u4EE5\u53CA\u56DB\u7535\u9884\u7559\u63A5\u53E3\u5DE5\u7A0B\u7B49\u56DB\u65B9\u9762\u8FDB\u884C\u4E3B\u4F53\u5206\u7C7B\uFF0C\u8D23\u4EFB\u5230\u4EBA\uFF0C\u8981\u6C42\u76F8\u5173\u4EBA\u5458\u5B9A\u671F\u68C0\u67E5\uFF0C\u5EFA\u7ACB\u8D28\u91CF\u6392\u67E5\u95EE\u9898\u5E93\uFF0C\u5EFA\u7ACB\u9010\u9879\u6574\u6539\u9500\u53F7\u673A\u5236\uFF0C\u5207\u5B9E\u5C06\u65B9\u6848\u843D\u5B9E\u5230\u4F4D\u3002\u003C/p\u003E\n\u003Cp\u003E\u672C\u6B21\u6D3B\u52A8\u65E8\u5728\u8FDB\u4E00\u6B65\u592F\u5B9E\u5168\u5458\u201C\u575A\u6301\u8D28\u91CF\u7B2C\u4E00\uFF0C\u521B\u7CBE\u54C1\u4F18\u8D28\u5DE5\u7A0B\u201D\u610F\u8BC6\uFF0C\u901A\u8FC7\u4E13\u9879\u6D3B\u52A8\u201C\u627E\u5DEE\u8DDD\u3001\u8865\u77ED\u677F\u3001\u5F3A\u63D0\u5347\u201D\uFF0C\u4E3A\u9879\u76EE\u5B9E\u73B0\u65E2\u5B9A\u751F\u4EA7\u76EE\u6807\u4FDD\u9A7E\u62A4\u822A\u3002\uFF08\u9A6C\u519B\u5F3A\uFF09\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/BRsk1zNAfYJPiZ68KbF88A\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
