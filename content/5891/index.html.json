  "title": "\u3010\u9879\u76EE\u3011\u666F\u5174\u7EB8\u4E1A\uFF1A\u9A6C\u6765\u897F\u4E9A\u4E8C\u671F\u9879\u76EE\u6B63\u6309\u8BA1\u5212\u63A8\u8FDB",
  "summary": "\u666F\u5174\u7EB8\u4E1A\uFF08002067.SZ\uFF092\u670827\u65E5\u5728\u6295\u8D44\u8005\u4E92\u52A8\u5E73\u53F0\u8868\u793A\uFF0C\u9A6C\u6765\u897F\u4E9A\u4E8C\u671F\u9879\u76EE\u6B63\u6309\u8BA1\u5212\u79EF\u6781\u63A8\u8FDB\uFF0C\u76EE\u524D\u5DF2\u5B8C\u6210\u571F\u5EFA\u4E3B\u4F53\u7ED3\u6784\u65BD\u5DE5\uFF0C3\u6708\u4EFD\u5373\u5C06\u5F00\u5C55\u4E3B\u8981\u8BBE\u5907\u5B89\u88C5\u5DE5\u4F5C\u3002 2025\u5E7412\u67085\u65E5\uFF0C\u6D59\u6C5F\u666F\u5174\u7EB8\u4E1A\u80A1\u4EFD\u6709\u9650\u516C\u53F8\u4F4D\u4E8E\u9A6C\u6765\u897F\u4E9A\u7684\u4E8C\u671F\u9879\u76EE\u8FCE\u6765\u5173\u952E\u8282\u70B9\u2014\u2014\u6E7F\u5F0F\u9020\u7EB8\u8054\u5408\u5382\u623F\u4E3B\u4F53\u7ED3\u6784\u987A\u5229\u5C01\u9876\uFF0C\u8C61\u5F81\u7740\u9879\u76EE\u5EFA\u8BBE\u53D6\u5F97\u4E86\u91CD\u5927\u8FDB\u5C55\u3002\u2026",
  "body": "\u003Cp\u003E\u666F\u5174\u7EB8\u4E1A\uFF08002067.SZ\uFF092\u670827\u65E5\u5728\u6295\u8D44\u8005\u4E92\u52A8\u5E73\u53F0\u8868\u793A\uFF0C\u9A6C\u6765\u897F\u4E9A\u4E8C\u671F\u9879\u76EE\u6B63\u6309\u8BA1\u5212\u79EF\u6781\u63A8\u8FDB\uFF0C\u76EE\u524D\u5DF2\u5B8C\u6210\u571F\u5EFA\u4E3B\u4F53\u7ED3\u6784\u65BD\u5DE5\uFF0C3\u6708\u4EFD\u5373\u5C06\u5F00\u5C55\u4E3B\u8981\u8BBE\u5907\u5B89\u88C5\u5DE5\u4F5C\u3002\u003C/p\u003E\n\u003Cp\u003E2025\u5E7412\u67085\u65E5\uFF0C\u6D59\u6C5F\u666F\u5174\u7EB8\u4E1A\u80A1\u4EFD\u6709\u9650\u516C\u53F8\u4F4D\u4E8E\u9A6C\u6765\u897F\u4E9A\u7684\u4E8C\u671F\u9879\u76EE\u8FCE\u6765\u5173\u952E\u8282\u70B9\u2014\u2014\u6E7F\u5F0F\u9020\u7EB8\u8054\u5408\u5382\u623F\u4E3B\u4F53\u7ED3\u6784\u987A\u5229\u5C01\u9876\uFF0C\u8C61\u5F81\u7740\u9879\u76EE\u5EFA\u8BBE\u53D6\u5F97\u4E86\u91CD\u5927\u8FDB\u5C55\u3002\u003C/p\u003E\n\u003Cp\u003E\u4F5C\u4E3A\u666F\u5174\u7EB8\u4E1A\u62D3\u5C55\u6D77\u5916\u5E02\u573A\u3001\u63D0\u5347\u4EA7\u80FD\u89C4\u6A21\u3001\u63A8\u52A8\u667A\u80FD\u5316\u4E0E\u7EFF\u8272\u8F6C\u578B\u7684\u91CD\u8981\u6218\u7565\u4E3E\u63AA\uFF0C\u9A6C\u6765\u897F\u4E9A\u4E8C\u671F\u9879\u76EE\u81EA\u542F\u52A8\u4EE5\u6765\uFF0C\u5728\u8BBE\u8BA1\u5355\u4F4D\u3001\u65BD\u5DE5\u5355\u4F4D\u53CA\u987E\u95EE\u516C\u53F8\u7B49\u5404\u65B9\u901A\u529B\u534F\u4F5C\u4E0B\uFF0C\u901A\u8FC7\u79D1\u5B66\u89C4\u5212\u3001\u7CBE\u7EC6\u7BA1\u7406\u3001\u89C4\u8303\u65BD\u5DE5\uFF0C\u79EF\u6781\u5E94\u5BF9\u5404\u7C7B\u6311\u6218\uFF0C\u786E\u4FDD\u4E86\u9879\u76EE\u5EFA\u8BBE\u4F18\u8D28\u9AD8\u6548\u63A8\u8FDB\u3002\u003C/p\u003E\n",
