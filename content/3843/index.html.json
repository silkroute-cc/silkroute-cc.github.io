  "route": "/3843/",
  "title": "\u5927\u9A6C\u53BB\u5E74\u5F55\u5F97746\u4EBF\u5916\u6765\u76F4\u63A5\u6295\u8D44\uFF08FDI\uFF09\u3000\u521B\u8FD12\u5E74\u65B0\u9AD8",
  "summary": "\uFF08\u5409\u9686\u576116\u65E5\u8BAF\uFF09\u5927\u9A6C2022\u5E74\u7684\u5916\u6765\u76F4\u63A5\u6295\u8D44\uFF08FDI\uFF09\u4E0E\u6D77\u5916\u76F4\u63A5\u6295\u8D44\uFF08DIA\uFF09\u5206\u522B\u5F55\u5F97746\u4EBF\u4EE4\u5409\u4E0E586\u4EBF\u4EE4\u5409\uFF0C\u5404\u522B\u521B\u4E0B2021\u5E74\u548C2014\u5E74\u4EE5\u6765\u65B0\u9AD8\u7EAA\u5F55\u3002 \u7EDF\u8BA1\u5C40\u4ECA\u65E5\u53D1\u6587\u544A\u8868\u793A\uFF0C\u5236\u9020\u4E1A\u4ECD\u662F\u5438\u5F15\u6700\u591A\u5916\u6765\u76F4\u63A5\u6295\u8D44\u7684\u9886\u57DF\uFF0C\u5360\u603B\u989D\u7684495\u4EBF\u4EE4\u5409\u621666.4%\uFF0C\u7D27\u968F\u5176\u540E\u7684\u5219\u662F\u91D1\u878D\u670D\u52A1\u9886\u57DF\u548C\u77FF\u4EA7\u9886\u57DF\u3002 \u6211\u56FD2022\u5E74\u7684\u5916\u6765\u76F4\u63A5\u6295\u8D44\u51C0\u6D41\u5165\u4E3A746\u4EBF\u4EE4\u5409\uFF0C\u6BD4\u4E0A\u5E74\u7684504\u4EBF\u4EE4\u5409\u9AD8\u51FA48.0%\uFF0C\u662F2021\u5E74\u4EE5\u6765\u7684\u6700\u9AD8\u6C34\u5E73\u3002 \u5927\u9A6C\u7684\u5916\u6765\u76F4\u63A5\u6295\u8D44\u4E3B\u8981\u6765\u81EA\u7F8E\u56FD\u533A\u57DF\uFF0C\u51C0\u6D41\u5165\u91D1\u989D\u4E3A426\u2026",
  "body": "\u003Cp\u003E\uFF08\u5409\u9686\u576116\u65E5\u8BAF\uFF09\u5927\u9A6C2022\u5E74\u7684\u5916\u6765\u76F4\u63A5\u6295\u8D44\uFF08FDI\uFF09\u4E0E\u6D77\u5916\u76F4\u63A5\u6295\u8D44\uFF08DIA\uFF09\u5206\u522B\u5F55\u5F97746\u4EBF\u4EE4\u5409\u4E0E586\u4EBF\u4EE4\u5409\uFF0C\u5404\u522B\u521B\u4E0B2021\u5E74\u548C2014\u5E74\u4EE5\u6765\u65B0\u9AD8\u7EAA\u5F55\u3002\u003C/p\u003E\n\u003Cp\u003E\u7EDF\u8BA1\u5C40\u4ECA\u65E5\u53D1\u6587\u544A\u8868\u793A\uFF0C\u5236\u9020\u4E1A\u4ECD\u662F\u5438\u5F15\u6700\u591A\u5916\u6765\u76F4\u63A5\u6295\u8D44\u7684\u9886\u57DF\uFF0C\u5360\u603B\u989D\u7684495\u4EBF\u4EE4\u5409\u621666.4%\uFF0C\u7D27\u968F\u5176\u540E\u7684\u5219\u662F\u91D1\u878D\u670D\u52A1\u9886\u57DF\u548C\u77FF\u4EA7\u9886\u57DF\u3002\u003C/p\u003E\n\u003Cp\u003E\u6211\u56FD2022\u5E74\u7684\u5916\u6765\u76F4\u63A5\u6295\u8D44\u51C0\u6D41\u5165\u4E3A746\u4EBF\u4EE4\u5409\uFF0C\u6BD4\u4E0A\u5E74\u7684504\u4EBF\u4EE4\u5409\u9AD8\u51FA48.0%\uFF0C\u662F2021\u5E74\u4EE5\u6765\u7684\u6700\u9AD8\u6C34\u5E73\u3002\u003C/p\u003E\n\u003Cp\u003E\u5927\u9A6C\u7684\u5916\u6765\u76F4\u63A5\u6295\u8D44\u4E3B\u8981\u6765\u81EA\u7F8E\u56FD\u533A\u57DF\uFF0C\u51C0\u6D41\u5165\u91D1\u989D\u4E3A426\u4EBF\u4EE4\u5409\u3002\u4F46\u7EDF\u8BA1\u5C40\u8865\u5145\uFF0C\u4E9A\u6D32\u5730\u533A\u4ECD\u662F\u5927\u9A6C\u7684\u5916\u56FD\u76F4\u63A5\u6295\u8D44\u6700\u5927\u6765\u6E90\uFF0C\u5F15\u8D444490\u4EBF\u4EE4\u5409\u6216\u603B\u989D\u768451%\uFF0C\u63A5\u8457\u662F\u6B27\u6D32\uFF08\u53602245\u4EBF\u4EE4\u5409\uFF09\uFF0C\u7F8E\u56FD\uFF08\u53601873\u4EBF\u5409\uFF09\u3002\u003C/p\u003E\n\u003Cp\u003E2022\u5E74\u5916\u6765\u76F4\u63A5\u6295\u8D44\u7684\u6295\u8D44\u56DE\u62A5\u7387\uFF08ROI\uFF09\u4E3A\u6BCF1\u4EE4\u5409\u83B712\u4ED9\u56DE\u916C\uFF0C\u6BD4\u53BB\u5E7413\u4ED9\u7684\u6295\u8D44\u56DE\u62A5\u7A0D\u4F4E\u3002\n\u53E6\u4E00\u65B9\u9762\uFF0C2022\u5E74\u7684\u6D77\u5916\u76F4\u63A5\u6295\u8D44\u6309\u5E74\u589E\u52A0393\u4EBF\u4EE4\u5409\uFF0C\u81F3586\u4EBF\u4EE4\u5409\uFF0C\u5199\u4E0B\u81EA2014\u5E74\u4EE5\u6765\u7684\u65B0\u9AD8\u3002\u003C/p\u003E\n\u003Cp\u003E\u5176\u4E2D\uFF0C\u6295\u8D44\u96C6\u4E2D\u4E8E\u91D1\u878D\u670D\u52A1\u9886\u57DF\uFF08\u536072.2%\uFF09\u3001\u7D27\u63A5\u8457\u662F\u91C7\u77FF\u4E1A\uFF08\u536012.5%\uFF09\u548C\u5236\u9020\u4E1A\uFF0810.2%\uFF09\u3002\n\u6D77\u5916\u76F4\u63A5\u6295\u8D44\u7684\u99963\u4E2A\u76EE\u7684\u5730\u5206\u522B\u4E3A\u8377\u5170\u3001\u5370\u5C3C\u53CA\u65B0\u52A0\u5761\u30022022\u5E74\u7684\u6D77\u5916\u76F4\u63A5\u6295\u8D44\u56DE\u62A5\u7387\u5219\u662F\u6BCF1\u4EE4\u5409\u83B7\u5F978\u4ED9\u56DE\u916C\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/bK7EOCF89EPCtd-GDl-01g\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
