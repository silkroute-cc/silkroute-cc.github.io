{
  "id": "%e6%b9%96%e6%b1%bd%e8%81%8c%e9%99%a2%e9%a6%96%e4%b8%aa%e6%b5%b7%e5%a4%96%e5%ad%a6%e9%99%a2%e4%b8%8e%e4%ba%ba%e6%89%8d%e5%9f%b9%e5%85%bb%e5%9f%ba%e5%9c%b0%e8%90%bd%e6%88%b7%e9%a9%ac",
  "slug": "%e6%b9%96%e6%b1%bd%e8%81%8c%e9%99%a2%e9%a6%96%e4%b8%aa%e6%b5%b7%e5%a4%96%e5%ad%a6%e9%99%a2%e4%b8%8e%e4%ba%ba%e6%89%8d%e5%9f%b9%e5%85%bb%e5%9f%ba%e5%9c%b0%e8%90%bd%e6%88%b7%e9%a9%ac",
  "canonicalUrlKey": "%e6%b9%96%e6%b1%bd%e8%81%8c%e9%99%a2%e9%a6%96%e4%b8%aa%e6%b5%b7%e5%a4%96%e5%ad%a6%e9%99%a2%e4%b8%8e%e4%ba%ba%e6%89%8d%e5%9f%b9%e5%85%bb%e5%9f%ba%e5%9c%b0%e8%90%bd%e6%88%b7%e9%a9%ac",
  "route": "/4274/",
  "title": "\u6E56\u6C7D\u804C\u9662\u9996\u4E2A\u6D77\u5916\u5B66\u9662\u4E0E\u4EBA\u624D\u57F9\u517B\u57FA\u5730\u201C\u843D\u6237\u201D\u9A6C\u6765\u897F\u4E9A",
  "summary": "\u6E56\u5357\u65E5\u62A512\u670819\u65E5\u8BAF\uFF08\u5168\u5A92\u4F53\u8BB0\u8005 \u4F59\u84C9 \u901A\u8BAF\u5458 \u5218\u6D77\u5B8F \u5468\u626C\u8389\uFF09\u6E56\u5357\u804C\u6559\u201C\u51FA\u6D77\u201D\u518D\u626C\u5E06\uFF0C\u8FD1\u65E5\uFF0C\u6E56\u5357\u6C7D\u8F66\u5DE5\u7A0B\u804C\u4E1A\u5B66\u9662\u9996\u4E2A\u6D77\u5916\u201C\u8299\u84C9\u6C7D\u8F66\u5B66\u9662\u201D\u201C\u8282\u80FD\u4E0E\u65B0\u80FD\u6E90\u6C7D\u8F66\u6280\u672F\u56FD\u9645\u4EBA\u624D\u57F9\u8BAD\u57FA\u5730\u201D\uFF0C\u5728\u9A6C\u6765\u897F\u4E9A\u82CF\u4E39\u4F9D\u5FB7\u7406\u65AF\u6559\u80B2\u5927\u5B66\uFF08\u4EE5\u4E0B\u7B80\u79F0UPSI\uFF09\u63ED\u724C\u6210\u7ACB\uFF0C\u8FD9\u4E5F\u662F\u6E56\u6C7D\u804C\u9662\u63A8\u8FDB\u56FD\u5BB6\u201C\u53CC\u9AD8\u8BA1\u5212\u201D\u7684\u91CD\u8981\u6210\u679C\u4E4B\u4E00\u3002 UPSI\u4E13\u6CE8\u4E8E\u65B0\u80FD\u6E90\u6C7D\u8F66\u65B9\u5411\u7814\u7A76\uFF0C\u662F\u9A6C\u6765\u897F\u4E9A\u6392\u540D\u7B2C\u4E00\u7684\u6559\u80B2\u5927\u5B66\uFF0C\u5728\u4E9A\u6D32\u6392\u540D\u7B2C168\u3002\u6E56\u6C7D\u804C\u9662\u4EE5\u201C\u7ACB\u8DB3\u6C7D\u8F66\u884C\u4E1A\uFF0C\u670D\u52A1\u6C7D\u8F66\u4EA7\u4E1A\uFF0C\u57F9\u517B\u6C7D\u8F66\u4EBA\u624D\uFF0C\u6253\u9020\u6C7D\u8F66\u54C1\u724C\u201D\u4E3A\u529E\u5B66\u5B9A\u4F4D\uFF0C\u83B7\u8BC4\u4E2D\u56FD\u7279\u8272\u2026",
  "body": "\u003Cp\u003E\u6E56\u5357\u65E5\u62A512\u670819\u65E5\u8BAF\uFF08\u5168\u5A92\u4F53\u8BB0\u8005 \u4F59\u84C9 \u901A\u8BAF\u5458 \u5218\u6D77\u5B8F \u5468\u626C\u8389\uFF09\u6E56\u5357\u804C\u6559\u201C\u51FA\u6D77\u201D\u518D\u626C\u5E06\uFF0C\u8FD1\u65E5\uFF0C\u6E56\u5357\u6C7D\u8F66\u5DE5\u7A0B\u804C\u4E1A\u5B66\u9662\u9996\u4E2A\u6D77\u5916\u201C\u8299\u84C9\u6C7D\u8F66\u5B66\u9662\u201D\u201C\u8282\u80FD\u4E0E\u65B0\u80FD\u6E90\u6C7D\u8F66\u6280\u672F\u56FD\u9645\u4EBA\u624D\u57F9\u8BAD\u57FA\u5730\u201D\uFF0C\u5728\u9A6C\u6765\u897F\u4E9A\u82CF\u4E39\u4F9D\u5FB7\u7406\u65AF\u6559\u80B2\u5927\u5B66\uFF08\u4EE5\u4E0B\u7B80\u79F0UPSI\uFF09\u63ED\u724C\u6210\u7ACB\uFF0C\u8FD9\u4E5F\u662F\u6E56\u6C7D\u804C\u9662\u63A8\u8FDB\u56FD\u5BB6\u201C\u53CC\u9AD8\u8BA1\u5212\u201D\u7684\u91CD\u8981\u6210\u679C\u4E4B\u4E00\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/12/frc-4a0849cb7f3746ad154d6840339108de.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003EUPSI\u4E13\u6CE8\u4E8E\u65B0\u80FD\u6E90\u6C7D\u8F66\u65B9\u5411\u7814\u7A76\uFF0C\u662F\u9A6C\u6765\u897F\u4E9A\u6392\u540D\u7B2C\u4E00\u7684\u6559\u80B2\u5927\u5B66\uFF0C\u5728\u4E9A\u6D32\u6392\u540D\u7B2C168\u3002\u6E56\u6C7D\u804C\u9662\u4EE5\u201C\u7ACB\u8DB3\u6C7D\u8F66\u884C\u4E1A\uFF0C\u670D\u52A1\u6C7D\u8F66\u4EA7\u4E1A\uFF0C\u57F9\u517B\u6C7D\u8F66\u4EBA\u624D\uFF0C\u6253\u9020\u6C7D\u8F66\u54C1\u724C\u201D\u4E3A\u529E\u5B66\u5B9A\u4F4D\uFF0C\u83B7\u8BC4\u4E2D\u56FD\u7279\u8272A\u6863\u9AD8\u6C34\u5E73\u4E13\u4E1A\u7FA4\u5EFA\u8BBE\u5355\u4F4D\u3001\u56FD\u5BB6\u4F18\u8D28\u4E13\u79D1\u9AD8\u7B49\u804C\u4E1A\u9662\u6821\u7B49\u8363\u8A89\u3002\u8BB0\u8005\u83B7\u6089\uFF0C\u6E56\u6C7D\u804C\u9662\u5C06\u4E0EUPSI\u5F3A\u5F3A\u5408\u4F5C\uFF0C\u4EE5\u65B0\u80FD\u6E90\u6C7D\u8F66\u667A\u80FD\u6280\u672F\u7279\u8272\u4E13\u4E1A\u4E3A\u6838\u5FC3\uFF0C\u901A\u8FC7\u5E08\u8D44\u57F9\u8BAD\u3001\u5B66\u751F\u4EA4\u6D41\u3001\u56FD\u9645\u5316\u8BFE\u7A0B\u53CA\u6280\u80FD\u5927\u8D5B\u7B49\u9879\u76EE\u5408\u4F5C\uFF0C\u5B9E\u73B0\u65B0\u80FD\u6E90\u6C7D\u8F66\u667A\u80FD\u6280\u672F\u548C\u6587\u5316\u7684\u56FD\u9645\u5316\u53D1\u5C55\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/12/frc-0ee24a40917218b5f3cc4e08f3a7c24a.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u5927\u5B66\u8054\u76DF\u4E3B\u5E2D\u62FF\u7763\u65AF\u91CC\u9EC4\u5B50\u709C\uFF0C\u9A6C\u6765\u897F\u4E9AUPSI\u62FF\u7763\u6559\u6388\u3001\u526F\u6821\u957FMdAminbinMdTaff\uFF0C\u6E56\u6C7D\u804C\u9662\u515A\u59D4\u59D4\u5458\u3001\u526F\u9662\u957F\u5468\u91D1\u5B97\u51FA\u5E2D\u63ED\u724C\u4EEA\u5F0F\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6E56\u6C7D\u804C\u9662\u548C\u9A6C\u6765\u897F\u4E9A\u5927\u5B66\u8054\u76DF\uFF08\u4EE5\u4E0B\u7B80\u79F0CMU\uFF09\u4E00\u884C\u8BBF\u95EEUPSI\uFF0C\u5BF9\u4E8EUPSI\u6765\u8BF4\u662F\u4E00\u9879\u83AB\u5927\u8363\u8A89\u3002\u201D\u63ED\u724C\u4EEA\u5F0F\u4E0A\uFF0CMdAminbinMdTaff\u5728\u81F4\u8F9E\u4E2D\u8868\u793A\uFF0C\u6E56\u6C7D\u804C\u9662\u4E0E\u884C\u4E1A\u5408\u4F5C\u57F9\u517B\u6C7D\u8F66\u6280\u80FD\u5DE5\u4EBA\u7684\u58F0\u8A89\u5353\u8457\u3002\u5E0C\u671B\u6B64\u6B21\u5F3A\u5F3A\u643A\u624B\uFF0C\u53CC\u65B9\u80FD\u5F00\u542F\u5728\u56FD\u9645\u5316\u3001\u6C7D\u8F66\u57F9\u8BAD\u548C\u5B66\u751F\u53D1\u5C55\u9886\u57DF\uFF0C\u5C24\u5176\u662F\u4EE5\u8282\u80FD\u548C\u65B0\u80FD\u6E90\u6C7D\u8F66\u6280\u672F\u4E3A\u57FA\u7840\u7684\u56FD\u9645\u4EBA\u624D\u57F9\u8BAD\u65B9\u9762\u7684\u826F\u597D\u5F00\u7AEF\u3002\u540E\u7EED\uFF0CUPSI\u5C06\u7AED\u529B\u4E3A\u672C\u6B21\u9879\u76EE\u63D0\u4F9B\u5728\u6559\u80B2\u3001\u8BED\u8A00\u57F9\u8BAD\u548C\u56FD\u9645\u5316\u9700\u6C42\u7B49\u65B9\u9762\u7684\u9700\u6C42\u4E0E\u5E2E\u52A9\u3002\u003C/p\u003E\n\u003Cp\u003E\u5468\u91D1\u5B97\u8868\u793A\uFF0CUPSI\u529E\u5B66\u5386\u53F2\u60A0\u4E45\uFF0C\u6559\u80B2\u7406\u5FF5\u5148\u8FDB\uFF0C\u529E\u5B66\u6210\u679C\u663E\u8457\uFF0C\u6709\u7740\u826F\u597D\u7684\u56FD\u9645\u53E3\u7891\uFF0C\u201C\u8299\u84C9\u6C7D\u8F66\u5B66\u9662\u201D\u7684\u5EFA\u7ACB\uFF0C\u662F\u63A8\u8FDB\u53CC\u65B9\u5728\u804C\u4E1A\u6559\u80B2\u9886\u57DF\u5171\u5EFA\u5171\u7814\u3001\u5171\u7528\u5171\u4EAB\u7684\u65B0\u5E73\u53F0\u3002\u5468\u91D1\u5B97\u5E0C\u671B\u201C\u8299\u84C9\u6C7D\u8F66\u5B66\u9662\u201D\u5728\u5F18\u626C\u4E2D\u56FD\u5DE5\u5320\u7CBE\u795E\u3001\u5171\u4EAB\u4E2D\u56FD\u804C\u4E1A\u6559\u80B2\u7ECF\u9A8C\u4E0E\u65B9\u6848\u7684\u540C\u65F6\uFF0C\u6210\u4E3A\u201C\u4E2D\u9A6C\u201D\u4E24\u56FD\u5F00\u5C55\u6C7D\u8F66\u4F01\u4E1A\u5408\u4F5C\u7684\u6865\u6881\uFF0C\u6210\u4E3A\u57F9\u517B\u65B0\u80FD\u6E90\u6C7D\u8F66\u667A\u80FD\u6280\u672F\u56FD\u9645\u5316\u4EBA\u624D\u7684\u65B0\u652F\u70B9\uFF0C\u4E3A\u8FDB\u4E00\u6B65\u4FC3\u8FDB\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u56FD\u5BB6\u5EFA\u8BBE\u53D1\u5C55\u8D21\u732E\u529B\u91CF\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/12/frc-a7e59c5f4e9a4f5ec9ef62beffbd0065.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u636E\u6089\uFF0C\u63ED\u724C\u4EEA\u5F0F\u5F53\u65E5\uFF0C\u6E56\u6C7D\u804C\u9662\u5411UPSI\u8F93\u9001\u4E86\u300A\u6C7D\u8F66\u7535\u6C14\u8BBE\u5907\u539F\u7406\u4E0E\u68C0\u4FEE\u300B\u7B49\u4E9F\u9700\u7684\u65B0\u80FD\u6E90\u6C7D\u8F66\u6280\u672F\u56FD\u9645\u53CC\u8BED\u6559\u6750\u3002\u6B21\u65E5\uFF0C\u201C\u8299\u84C9\u6C7D\u8F66\u5B66\u9662\u201D\u201C\u8282\u80FD\u4E0E\u65B0\u80FD\u6E90\u6C7D\u8F66\u6280\u672F\u56FD\u9645\u4EBA\u624D\u57F9\u8BAD\u57FA\u5730\u201D\u9996\u573A\u57F9\u8BAD\u5728\u5409\u9686\u5761\u5EFA\u8BBE\u5927\u5B66\u53CA\u9A6C\u6765\u897F\u4E9A\u535A\u7279\u62C9\u5927\u5B66\u7CBE\u5F69\u5F00\u8BFE\u3002\u6E56\u6C7D\u804C\u9662\u5F6D\u8FDB\u535A\u58EB\u4F5C\u4E3A\u9996\u4F4D\u8BB2\u5E08\uFF0C\u5411\u73B0\u573A\u7684100\u4F59\u540D\u5E08\u751F\u5206\u4EAB\u4E86\u4E2D\u56FD\u65B0\u80FD\u6E90\u667A\u80FD\u6280\u672F\u53D1\u5C55\u4E0E\u8D8B\u52BF\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/12/frc-4f8c0403250f4fdcc4751709e8fce92a.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u8BB0\u8005\u83B7\u6089\uFF0C\u201C\u8299\u84C9\u6C7D\u8F66\u5B66\u9662\u201D\u4EE5\u53CA\u201C\u8282\u80FD\u4E0E\u65B0\u80FD\u6E90\u6C7D\u8F66\u6280\u672F\u56FD\u9645\u4EBA\u624D\u57F9\u8BAD\u57FA\u5730\u201D\u7684\u6210\u7ACB\uFF0C\u5F97\u5230\u4E86\u9A6C\u6765\u897F\u4E9A\u9AD8\u7B49\u6559\u80B2\u90E8\u3001\u9A6C\u6765\u897F\u4E9A\u5927\u5B66\u8054\u76DF\u7684\u5927\u529B\u652F\u6301\u300212\u670814\u65E5\u4E0B\u5348\uFF0C\u5468\u91D1\u5B97\u4E00\u884C\u4E09\u4EBA\u53D7\u5230\u9A6C\u6765\u897F\u4E9A\u9AD8\u7B49\u6559\u80B2\u90E8\u90E8\u957F\u52A9\u7406\u53CA\u5176\u4ED6\u9886\u5BFC\u7684\u63A5\u89C1\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/12/frc-6abff44a149b4a59656e4153c43d5359.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/vZ1uGT9qv2F8FnHMPgAO_A\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
