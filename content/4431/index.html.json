  "id": "%e9%a2%91%e7%99%bb%e4%b8%ad%e5%9b%bd%e9%87%8d%e8%a6%81%e8%bf%8e%e6%98%a5%e8%88%9e%e5%8f%b0-%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e5%bb%bf%e5%9b%9b%e8%8a%82%e4%bb%a4%e9%bc%93%e5%8a%bf%e5%a4%b4%e5%bc%ba",
  "slug": "%e9%a2%91%e7%99%bb%e4%b8%ad%e5%9b%bd%e9%87%8d%e8%a6%81%e8%bf%8e%e6%98%a5%e8%88%9e%e5%8f%b0-%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e5%bb%bf%e5%9b%9b%e8%8a%82%e4%bb%a4%e9%bc%93%e5%8a%bf%e5%a4%b4%e5%bc%ba",
  "canonicalUrlKey": "%e9%a2%91%e7%99%bb%e4%b8%ad%e5%9b%bd%e9%87%8d%e8%a6%81%e8%bf%8e%e6%98%a5%e8%88%9e%e5%8f%b0-%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e5%bb%bf%e5%9b%9b%e8%8a%82%e4%bb%a4%e9%bc%93%e5%8a%bf%e5%a4%b4%e5%bc%ba",
  "route": "/4431/",
  "title": "\u9891\u767B\u4E2D\u56FD\u91CD\u8981\u8FCE\u6625\u821E\u53F0 \u9A6C\u6765\u897F\u4E9A\u5EFF\u56DB\u8282\u4EE4\u9F13\u52BF\u5934\u5F3A\u52B2",
  "summary": "\u4ECE\u9A6C\u6765\u897F\u4E9A\u4F20\u5165\u4E2D\u56FD\u7684\u5EFF\u56DB\u8282\u4EE4\u9F13\uFF0C\u7EB7\u7EB7\u767B\u4E0A\u4E2D\u56FD\u91CD\u8981\u7684\u7535\u89C6\u8DE8\u5E74\u3001\u8FCE\u6625\u6216\u6625\u665A\uFF0C\u53C8\u6216\u4EAE\u76F8\u7EBF\u4E0B\u91CD\u8981\u7684\u6C11\u4FD7\u8282\u573A\uFF0C\u4EE5\u78C5\u7934\u7684\u8282\u4EE4\u9F13\u821E\uFF0C\u547C\u5524\u6625\u98CE\uFF0C\u5E26\u52A8\u5E74\u5473\uFF0C\u4E5F\u4E3A \u4E2D \u9A6C\u5EFA\u4EA450\u5468\u5E74\u7684\u6587\u5316\u4EA4\u6D41\uFF0C\u7559\u4E0B\u91CC\u7A0B\u7891\u6027\u7684\u4E30\u7891\u3002 2024\u5E74\u4E00\u5F00\u59CB\uFF0C\u4E2D\u56FD\u5883\u5185\u7684\u5EFF\u56DB\u8282\u4EE4\u9F13\u4FBF\u7EB7\u7EB7\u4EAE\u76F8\u91CD\u8981\u7684\u56FD\u5BB6\u7EA7\u53CA\u7701\u7EA7\u7535\u89C6\u53F0\u6216\u5730\u65B9\u8282\u573A\uFF0C\u4EE5\u96C4\u6D51\u7684\u9F13\u9635\u64C2\u52A8\u7532\u8FB0\u5E74\u7684\u6625\u5929\uFF0C\u8FD9\u79CD\u7EB7\u7EB7\u4EAE\u76F8\u91CD\u8981\u6625\u8282\u821E\u53F0\u7684\u73B0\u8C61\uFF0C\u8DB3\u4EE5\u6784\u6210\u8282\u4EE4\u9F13\u5728\u4E2D\u56FD\u53D1\u5C55\u7684\u91CD\u8981\u91CC\u7A0B\u7891\uFF0C\u4E5F\u662F\u4E2D \u9A6C \u5EFA\u4EA450\u5E74\u6765\u4E00\u4E2A\u4EE4\u4EBA\u9F13\u821E\u7684\u6587\u5316\u73B0\u8C61\u3002 \u5EFF\u56DB\u8282\u4EE4\u9F13\u539F\u521B\u4EBA\u4E4B\u4E00\u7684\u9648\u518D\u85E9\uFF0C\u8FD1\u671F\u6574\u7406\u4E86\u51E0\u573A\u91CD\u8981\u2026",
  "body": "\u003Cp\u003E\u4ECE\u9A6C\u6765\u897F\u4E9A\u4F20\u5165\u4E2D\u56FD\u7684\u5EFF\u56DB\u8282\u4EE4\u9F13\uFF0C\u7EB7\u7EB7\u767B\u4E0A\u4E2D\u56FD\u91CD\u8981\u7684\u7535\u89C6\u8DE8\u5E74\u3001\u8FCE\u6625\u6216\u6625\u665A\uFF0C\u53C8\u6216\u4EAE\u76F8\u7EBF\u4E0B\u91CD\u8981\u7684\u6C11\u4FD7\u8282\u573A\uFF0C\u4EE5\u78C5\u7934\u7684\u8282\u4EE4\u9F13\u821E\uFF0C\u547C\u5524\u6625\u98CE\uFF0C\u5E26\u52A8\u5E74\u5473\uFF0C\u4E5F\u4E3A\u4E2D\u9A6C\u5EFA\u4EA450\u5468\u5E74\u7684\u6587\u5316\u4EA4\u6D41\uFF0C\u7559\u4E0B\u91CC\u7A0B\u7891\u6027\u7684\u4E30\u7891\u3002\n\u003C/p\u003E\n\u003Cp\u003E2024\u5E74\u4E00\u5F00\u59CB\uFF0C\u4E2D\u56FD\u5883\u5185\u7684\u5EFF\u56DB\u8282\u4EE4\u9F13\u4FBF\u7EB7\u7EB7\u4EAE\u76F8\u91CD\u8981\u7684\u56FD\u5BB6\u7EA7\u53CA\u7701\u7EA7\u7535\u89C6\u53F0\u6216\u5730\u65B9\u8282\u573A\uFF0C\u4EE5\u96C4\u6D51\u7684\u9F13\u9635\u64C2\u52A8\u7532\u8FB0\u5E74\u7684\u6625\u5929\uFF0C\u8FD9\u79CD\u7EB7\u7EB7\u4EAE\u76F8\u91CD\u8981\u6625\u8282\u821E\u53F0\u7684\u73B0\u8C61\uFF0C\u8DB3\u4EE5\u6784\u6210\u8282\u4EE4\u9F13\u5728\u4E2D\u56FD\u53D1\u5C55\u7684\u91CD\u8981\u91CC\u7A0B\u7891\uFF0C\u4E5F\u662F\u4E2D\u9A6C\u5EFA\u4EA450\u5E74\u6765\u4E00\u4E2A\u4EE4\u4EBA\u9F13\u821E\u7684\u6587\u5316\u73B0\u8C61\u3002\u003C/p\u003E\n\u003Cp\u003E\u5EFF\u56DB\u8282\u4EE4\u9F13\u539F\u521B\u4EBA\u4E4B\u4E00\u7684\u9648\u518D\u85E9\uFF0C\u8FD1\u671F\u6574\u7406\u4E86\u51E0\u573A\u91CD\u8981\u7684\u6F14\u51FA\u8D44\u8BAF\u3002\u003C/p\u003E\n\u003Cp\u003E1\uFF092023\u5E7412\u670831\u65E5\uFF0C\u6DC5\u6C5F\u67EF\u57CE\u7ACB\u6625\u9F13\u793E\u4EAE\u76F8\u4E2D\u592E\u7535\u89C6\u7B2C3\u53F0\u300A2024\u8DE8\u5E74\u665A\u4F1A\u300B\u7684\u5F00\u573A\u9F13\u4E50\u300A\u548C\u9E23\u300B\uFF0C\u4E0E\u4E2D\u56FD\u5C71\u897F\u7684\u7EDB\u5DDE\u9F13\u53CA\u5A01\u98CE\u9523\u9F13\u3001\u6C55\u5934\u7684\u6F6E\u5DDE\u5927\u9523\u9F13\u7B49\u91CD\u8981\u7684\u4E2D\u56FD\u4F20\u7EDF\u9F13\u4E50\uFF0C\u4E00\u8D77\u201C\u548C\u9E23\u201D\u8FCE\u65B0\u3002\u7ACB\u6625\u9F13\u793E\u8D1F\u8D23\u6F14\u51FA\u7684\u5730\u70B9\u662F\u5728\u6DC5\u6C5F\u4E1C\u90E8\u53F0\u5DDE\u7684\u5343\u79A7\u66D9\u5149\u516C\u56ED\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/02/frc-b3d3111042291dc9cf6db08b09cfa891.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E2023\u5E7412\u670831\u65E5\uFF0C\u4E2D\u56FD\u592E\u89C62024\u8DE8\u5E74\u665A\u4F1A\uFF0C\u6D59\u6C5F\u67EF\u57CE\u7ACB\u6625\u9F13\u793E\u53C2\u6F14\u300A\u548C\u9E23\u300B\u3002\uFF08\u9648\u518D\u85E9\u63D0\u4F9B\uFF09\u003C/p\u003E\n\u003Cp\u003E2\uFF092024\u5E742\u67083\u65E5\u7ACB\u6625\u524D\u5915\uFF0C\u6F6E\u5DDE\u7684\u6F6E\u54CD\u9F13\u793E\u8054\u5408\u6E56\u5357\u6E58\u5357\u5B66\u9662\u9F13\u793E\uFF0C\u4EE542\u7C92\u9F13\u7684\u5927\u9635\u5BB9\u4F5C\u54C1\u300A\u8FCE\u6625\u300B\uFF0C\u4EAE\u76F8\u6296\u97F3\u51A0\u540D\u7684\u6E56\u5357\u536B\u89C6\u76F4\u64AD\u300A\u6625\u665A\u300B\uFF0C\u6536\u89C6\u7387\u8FC7\u4EBF\u3002\u003C/p\u003E\n\u003Cp\u003E3\uFF092\u67084\u65E5\u7ACB\u6625\uFF0C\u67EF\u57CE\u9F13\u793E\u4E8E\u6D59\u6C5F\u56FD\u5BB6\u7EA7\u975E\u9057\uFF0C\u8862\u5DDE\u7684\u201C\u4E5D\u534E\u7ACB\u6625\u796D\u201D\u8868\u6F14\u300A\u8FCE\u6625\u300B\uFF0C\u662F\u8282\u4EE4\u9F13\u4E0E\u5EFF\u56DB\u8282\u6C14\u6587\u5316\u6709\u673A\u7ED3\u5408\u7684\u5178\u8303\u4F8B\u5B50\u3002\u003C/p\u003E\n\u003Cp\u003E4\uFF092\u67089\u65E5\u9664\u5915\u4E0B\u5348\uFF0C\u6F6E\u5DDE\u6F6E\u54CD\u9F13\u793E\u4EAE\u76F8\u4E2D\u56FD\u4E2D\u592E\u7535\u89C6\u53F0CCTV4\u4E4B\u300A\u4F20\u5947\u4E2D\u56FD\u8282\uFF0E\u6625\u8282\u300B\uFF0C\u9F13\u793E\u9996\u6B21\u7ED3\u5408\u6F6E\u6C55\u706B\u70ED\u7684\u82F1\u6B4C\u821E\u821E\u59FF\uFF0C\u5448\u73B0\u521B\u65B0\u7684\u9F13\u821E\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/02/frc-964c496bd9e978c5bb305ea10d7837ae.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u4E2D\u56FD\u592E\u89C6\u300A\u4F20\u5947\u4E2D\u56FD\u8282\u300B\uFF0C\u6F6E\u54CD\u9F13\u793E\u5728\u6F6E\u5DDE\u9F99\u6E56\u53E4\u5BE8\u524D\u5448\u73B0\u201C\u8282\u4EE4\u9F13\u82F1\u6B4C\u821E\u201D\u7ED3\u5408\u7684\u65B0\u5C1D\u5F0F\u3002\uFF08\u9648\u518D\u85E9\u63D0\u4F9B\uFF09\u003C/p\u003E\n\u003Cp\u003E5\uFF092\u670810\u65E5\u5927\u5E74\u521D\u4E00\u665A\u4E0A8\u65F6\uFF0C\u4E8E\u6F6E\u5DDE\u7535\u89C6\u53F0\u9996\u529E\u7684\u300A\u9F99\u817E\u6F6E\u6D8C\u3001\u79C0\u7F8E\u6F6E\u5DDE\u300B\u8FCE\u6625\u6587\u827A\u665A\u4F1A\u4E2D\uFF0C\u6F6E\u54CD\u9F13\u793E\u5448\u73B0\u540D\u4E3A\u300A\u6F6E\u5DDE\u4EBA\u300B\u7684\u8282\u4EE4\u9F13\u821E\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/02/frc-387fe08ee142070050a25a5a6d52d997.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5927\u5E74\u521D\u4E00\u6F6E\u5DDE\u7535\u89C6\u53F0\u9996\u529E\u6F6E\u5DDE\u6625\u665A\uFF0C\u6F6E\u54CD\u9F13\u793E\u5448\u73B0\u300A\u6F6E\u5DDE\u4EBA\u300B\u3002\uFF08\u9648\u518D\u85E9\u63D0\u4F9B\uFF09\u003C/p\u003E\n\u003Cp\u003E6\uFF09\u6E5B\u6C5F\u7535\u89C6\u53F0\u4E8E\u7532\u8FB0\u8FCE\u65B0\u8282\u76EE\u4E2D\uFF0C\u64AD\u6620\u53A6\u95E8\u5B89\u6D77\u804C\u6821\u5EFF\u56DB\u8282\u4EE4\u9F13\u4E8E\u6CC9\u5DDE\u53E4\u8FF9\u5B89\u5E73\u6865\u666F\u533A\u5448\u732E\u7684\u201C\u8FCE\u6625\u8868\u6F14\u201D\u3002\u003C/p\u003E\n\u003Cp\u003E7\uFF09\u6625\u8282\u671F\u95F4\uFF0C\u6C55\u5934\u7684\u5EFF\u56DB\u8282\u4EE4\u9F13\u5728\u6C55\u5934\u5E02\u5C0F\u516C\u56ED\u516C\u6F14\uFF0C\u5C06\u5E74\u5473\u62C9\u5F97\u6EE1\u6EE1\u3002\u003C/p\u003E\n\u003Cp\u003E\u5EFF\u56DB\u8282\u4EE4\u9F13\u4ECE\u9A6C\u6765\u897F\u4E9A\u4F20\u5165\u4E2D\u56FD\uFF0C\u8FC4\u4ECA\u5DF2\u670927\u5E74\u7684\u5386\u53F2\u3002\u003C/p\u003E\n\u003Cp\u003E\u6700\u521D\u7684\u4F20\u64AD\u8DEF\u5F84\uFF0C\u591A\u7531\u5927\u9A6C\u7684\u7559\u5B66\u751F\u5E26\u5F80\u5F7C\u7B49\u6DF1\u9020\u7684\u5927\u5B66\uFF0C\u59821997\u5E74\u7684\u534E\u4FA8\u5927\u5B66\uFF0C2005\u5E74\u5317\u4EAC\u5404\u5927\u4E13\u7559\u5B66\u751F\u5408\u7EC4\u7684\u201C\u5357\u51FB\u624B\u201D\u9F13\u961F\uFF0C\u4EE5\u53CA\u8FC7\u540E\u7684\u5929\u6D25\u5927\u5B66\u3001\u5317\u4EAC\u5E08\u8303\u5927\u5B66\u3001\u4E0A\u6D77\u4EA4\u901A\u5927\u5B66\u3001\u6B66\u6C49\u5927\u5B66\u3001\u6DC5\u6C5F\u5927\u5B66\u3001\u5E7F\u5DDE\u66A8\u5357\u5927\u5B66\u7B49\u9F13\u961F\u3002\u003C/p\u003E\n\u003Cp\u003E\u8FD1\u5E74\u793E\u533A\u5EFF\u56DB\u8282\u4EE4\u9F13\u961F\u7684\u53D1\u5C55\u4E5F\u52BF\u5934\u5F3A\u52B2\uFF0C\u5355\u5728\u53A6\u95E8\u6CC9\u5DDE\u5708\u53CA\u6F6E\u6C55\u5730\u533A\u4FBF\u6709\u793E\u533A\u53CA\u4E2D\u5C0F\u5B66\u8282\u4EE4\u9F13\u961F\u903E50\u652F\uFF0C\u5E76\u4E14\u8DE8\u7701\u5F00\u679D\u6563\u53F6\uFF0C\u5F62\u6210\u5145\u6EE1\u6D3B\u529B\u7684\u4E2D\u56FD\u8282\u4EE4\u9F13\u7F51\u7EDC\u3002\u003C/p\u003E\n\u003Cp\u003E\u8FC7\u53BB\uFF0C\u5927\u5B66\u9F13\u961F\u4E5F\u66FE\u5728\u4E2D\u56FD\u91CD\u8981\u7684\u6587\u5316\u3001\u4F53\u80B2\u6216\u91CD\u8981\u8282\u573A\u4EAE\u76F8\uFF0C\u59822008\u5E74\u5317\u4EAC\u5965\u8FD0\u706B\u70AC\u5728\u6CC9\u5DDE\u7AD9\u7684\u4F20\u9012\uFF0C\u4FBF\u662F\u7531\u534E\u4FA8\u5927\u5B66\u8282\u4EE4\u9F13\u8D1F\u8D23\u64C2\u9F13\u8FCE\u63A5\u3002\u003C/p\u003E\n\u003Cp\u003E\u53BB\u5E74\u676D\u5DDE\u4E9A\u8FD0\u7684\u5F00\u5E55\u5F0F\u4E0A\uFF0C\u6D59\u6C5F\u67EF\u57CE\u7684\u7ACB\u6625\u9F13\u793E\u4E5F\u4EAE\u76F8\u4E9A\u8FD0\u4F1A8\u4E07\u4EBA\u7684\u5F00\u5E55\u4E3B\u9986\uFF0C\u505A\u4E86\u4EE4\u4EBA\u60CA\u8273\u7684\u8868\u6F14\u3002\u003C/p\u003E\n\u003Chr /\u003E\n\u003Cp\u003E\u62A5\u9053\uFF1A\u661F\u6D32\u65E5\u62A5\u003C/p\u003E\n\u003Cp\u003E\u66F4\u591A\u7CBE\u5F69\uFF0C\u656C\u8BF7\u5173\u6CE8\uFF1A\u003C/p\u003E\n\u003Cp\u003E\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5B98\u7F51\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003Ehttps://www.chinaculturalcentre.my\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EFacebook\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u201CChina Cult