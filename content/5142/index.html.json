  "slug": "%e6%89%8e%e5%b8%8c%e6%8e%a2%e8%ae%a8%e4%b8%8e%e4%b8%ad%e5%9b%bd%e5%90%88%e4%bd%9c-%e5%a4%a7%e9%a9%ac%e7%9b%bc%e5%88%b6%e9%80%a0%e6%97%a0%e4%ba%ba%e6%9c%ba",
  "canonicalUrlKey": "%e6%89%8e%e5%b8%8c%e6%8e%a2%e8%ae%a8%e4%b8%8e%e4%b8%ad%e5%9b%bd%e5%90%88%e4%bd%9c-%e5%a4%a7%e9%a9%ac%e7%9b%bc%e5%88%b6%e9%80%a0%e6%97%a0%e4%ba%ba%e6%9c%ba",
  "route": "/5142/",
  "title": "\u624E\u5E0C:\u63A2\u8BA8\u4E0E\u4E2D\u56FD\u5408\u4F5C \u5927\u9A6C\u76FC\u5236\u9020\u65E0\u4EBA\u673A",
  "summary": "\u9A6C\u4E2D\u6B63\u63A2\u8BA8\u65E0\u4EBA\u673A\u5236\u9020\u9886\u57DF\u7684\u65B0\u5408\u4F5C\uFF0C\u5E76\u7B7E\u7F72\u4E86\u89E3\u5408\u4F5C\u5907\u5FD8\u5F55\u3002\u5DE6\u8D77\u4E3A\u963F\u65AF\u62C9\u592B\u3001\u8BFA\u66FC\u3001\u7956\u5361\u7EB3\u56E0\u3001\u963F\u672B\u624E\u5E0C\u3001\u9B4F\u5BB6\u7965\u3001\u5218\u94C1\u519B\u3001\u7A0B\u9896\u6D01\u3001\u90ED\u76DB\u57FA\u548C\u738B\u5EFA\u6B66\u3002 \uFF08\u4E0A\u6D7711\u65E5\u8BAF\uFF09\u526F\u9996\u76F8\u62FF\u7763\u65AF\u91CC\u963F\u672B\u624E\u5E0C\u535A\u58EB\u6307\u51FA\uFF0C\u9A6C\u6765\u897F\u4E9A\u548C\u4E2D\u56FD\u6B63\u63A2\u8BA8\u65E0\u4EBA\u673A\uFF08UAV\uFF09\u5236\u9020\u9886\u57DF\u7684\u65B0\u5408\u4F5C\uFF0C\u800C\u6B64\u4E3E\u5C06\u4F7F\u5927\u9A6C\u5236\u9020\u7684\u4EA7\u54C1\u5728\u5168\u7403\u5E02\u573A\u4E0A\u63A8\u5E7F\u3002 \u4ED6\u8BF4\uFF0C\u6B63\u5728\u4FEE\u8BFB\u6280\u804C\u6559\u80B2\u4E0E\u57F9\u8BAD\uFF08TVET\uFF09\u8BFE\u7A0B\u7684\u5B66\u751F\u9884\u8BA1\u5C06\u5728\u8FD9\u9879\u5408\u4F5C\u4E2D\u53D7\u76CA\uFF0C\u83B7\u5F97\u4E2D\u56FD\u6280\u672F\u8F6C\u79FB\u7684\u77E5\u8BC6\u3002 \u4ED6\u4E5F\u5F62\u5BB9\u6B64\u6B21\u5408\u4F5C\u4E3A\u5927\u9A6C\u5728\u6280\u804C\u6559\u80B2\u4E0E\u57F9\u8BAD\uFF0C\u4EE5\u53CA\u65E0\u4EBA\u673A\u884C\u4E1A\u4E0A\u7684\u4E00\u4E2A\u91CC\u7A0B\u7891\u3002 \u201C\u65E0\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/09/frc-3a2e9590e4d384eba1eea2065c28885e.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u9A6C\u4E2D\u6B63\u63A2\u8BA8\u65E0\u4EBA\u673A\u5236\u9020\u9886\u57DF\u7684\u65B0\u5408\u4F5C\uFF0C\u5E76\u7B7E\u7F72\u4E86\u89E3\u5408\u4F5C\u5907\u5FD8\u5F55\u3002\u5DE6\u8D77\u4E3A\u963F\u65AF\u62C9\u592B\u3001\u8BFA\u66FC\u3001\u7956\u5361\u7EB3\u56E0\u3001\u963F\u672B\u624E\u5E0C\u3001\u9B4F\u5BB6\u7965\u3001\u5218\u94C1\u519B\u3001\u7A0B\u9896\u6D01\u3001\u90ED\u76DB\u57FA\u548C\u738B\u5EFA\u6B66\u3002\u003C/p\u003E\n\u003Cp\u003E\uFF08\u4E0A\u6D7711\u65E5\u8BAF\uFF09\u526F\u9996\u76F8\u62FF\u7763\u65AF\u91CC\u963F\u672B\u624E\u5E0C\u535A\u58EB\u6307\u51FA\uFF0C\u9A6C\u6765\u897F\u4E9A\u548C\u4E2D\u56FD\u6B63\u63A2\u8BA8\u65E0\u4EBA\u673A\uFF08UAV\uFF09\u5236\u9020\u9886\u57DF\u7684\u65B0\u5408\u4F5C\uFF0C\u800C\u6B64\u4E3E\u5C06\u4F7F\u5927\u9A6C\u5236\u9020\u7684\u4EA7\u54C1\u5728\u5168\u7403\u5E02\u573A\u4E0A\u63A8\u5E7F\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u6B63\u5728\u4FEE\u8BFB\u6280\u804C\u6559\u80B2\u4E0E\u57F9\u8BAD\uFF08TVET\uFF09\u8BFE\u7A0B\u7684\u5B66\u751F\u9884\u8BA1\u5C06\u5728\u8FD9\u9879\u5408\u4F5C\u4E2D\u53D7\u76CA\uFF0C\u83B7\u5F97\u4E2D\u56FD\u6280\u672F\u8F6C\u79FB\u7684\u77E5\u8BC6\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u4E5F\u5F62\u5BB9\u6B64\u6B21\u5408\u4F5C\u4E3A\u5927\u9A6C\u5728\u6280\u804C\u6559\u80B2\u4E0E\u57F9\u8BAD\uFF0C\u4EE5\u53CA\u65E0\u4EBA\u673A\u884C\u4E1A\u4E0A\u7684\u4E00\u4E2A\u91CC\u7A0B\u7891\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u65E0\u4EBA\u673A\u5C06\u6539\u53D8\u6211\u4EEC\u5904\u7406\u4E8B\u52A1\u7684\u65B9\u5F0F\uFF0C\u8FD9\u4E0D\u4EC5\u5728\u4E8E\u5B89\u5168\u9886\u57DF\uFF0C\u4E5F\u5305\u62EC\u519C\u4E1A\u3002\u81F3\u4E8E\u6280\u672F\u8F6C\u79FB\uFF0C\u5C31\u8BFB\u6280\u804C\u6559\u80B2\u4E0E\u57F9\u8BAD\u8BFE\u7A0B\u7684\u5B66\u751F\uFF0C\u7279\u522B\u662F\u5728\u5409\u9686\u5761\u5927\u5B66\uFF08UniKL\uFF09\u7684\u5B66\u751F\u5C06\u4ECE\u4E2D\u53D7\u76CA\uFF0C\uFF08\u80FD\uFF09\u4E86\u89E3\u5982\u4F55\u5236\u9020\u8FD9\u4E9B\u673A\u5668\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u963F\u672B\u624E\u5E0C\u89C1\u8BC1\u739B\u62C9\u822A\u5B87\u79D1\u6280\u79C1\u4EBA\u6709\u9650\u516C\u53F8\uFF08Mara Aerospace\u0026amp;Technologies\uFF09\u4E0E\u8702\u5DE2\u822A\u5B87\u79D1\u6280\uFF08\u5317\u4EAC\uFF09\u6709\u9650\u516C\u53F8\u7B7E\u7F72\u4E86\u89E3\u5907\u5FD8\u5F55\u540E\uFF0C\u5411\u5927\u9A6C\u8BB0\u8005\u8FD9\u4E48\u8BF4\u3002\u003C/p\u003E\n\u003Cp\u003E\u8702\u5DE2\u822A\u5B87\u662F\u4E2D\u56FD\u7B2C\u4E09\u5927\u65E0\u4EBA\u673A\u5236\u9020\u5546\u3002\u6839\u636E\u4E86\u89E3\u5907\u5FD8\u5F55\uFF0C\u8FD9\u5BB6\u4E2D\u56FD\u516C\u53F8\u5C06\u6295\u8D441\u4EBF\u4EE4\u5409\u5728\u5927\u9A6C\u5EFA\u7ACB\u4E00\u5BB6\u65E0\u4EBA\u673A\u5236\u9020\u8BBE\u65BD\u3002\u8FD9\u8BBE\u65BD\u9884\u8BA1\u5C06\u4E8E2025\u5E74\u5F00\u59CB\u8FD0\u4F5C\uFF0C\u9884\u8BA1\u6295\u4EA7\u540E\u6BCF\u5E74\u5C06\u751F\u4EA7\u7EA63000\u67B6\u65E0\u4EBA\u673A\u3002\u003C/p\u003E\n\u003Cp\u003E\u5728\u521D\u671F\u9636\u6BB5\uFF0C\u8702\u5DE2\u822A\u5B87\u5C06\u4E8E\u4ECA\u5E7410\u6708\u5728\u5409\u9686\u5761\u5927\u5B66\u4F4D\u4E8E\u822A\u7A7A\u6280\u672F\u5B66\u9662\u6821\u56ED\u8BBE\u7ACB\u4E00\u4E2A\u65E0\u4EBA\u673A\u7EC4\u88C5\u8BBE\u65BD\u3002\u003C/p\u003E\n\u003Cp\u003E\u8FD9\u5907\u5FD8\u5F55\u65E8\u5728\u63A8\u8FDB\u53CC\u65B9\u5F00\u62D3\u65E0\u4EBA\u673A\u4EA7\u54C1\u7684\u88C5\u7F6E\u3001\u5236\u9020\u548C\u4F9B\u5E94\u9886\u57DF\u5728\u672C\u533A\u57DF\u7684\u5546\u4E1A\u5E02\u573A\u3002\u003C/p\u003E\n\u003Cp\u003E\u5728\u573A\u8005\u5305\u62EC\u739B\u62C9\u673A\u6784\u96C6\u56E2\u603B\u6267\u884C\u957F\u7956\u5361\u7EB3\u56E0\u3001\u8702\u5DE2\u822A\u5B87\u5E38\u52A1\u526F\u603B\u7ECF\u7406\u5218\u94C1\u519B\u3001\u4EBA\u6C11\u4FE1\u6258\u5C40\uFF08MARA\uFF09\u4E3B\u5E2D\u62FF\u7763\u963F\u65AF\u62C9\u592B\u3001\u963F\u672B\u624E\u5E0C\u8BBF\u534E\u7279\u522B\u987E\u95EE\u517C\u9A6C\u534E\u603B\u4F1A\u957F\u62FF\u7763\u65AF\u91CC\u9B4F\u5BB6\u7965\u535A\u58EB\u3001\u5927\u9A6C\u9A7B\u4E2D\u56FD\u5927\u4F7F\u62FF\u7763\u8BFA\u66FC\u3001\u5927\u9A6C\u9A7B\u4E0A\u6D77\u9886\u4E8B\u8D5B\u76CA\u6CD5\u91CC\u67E5\u3001\u8702\u5DE2\u822A\u5B87\u8D22\u52A1\u603B\u76D1\u517C\u676D\u5DDE\u8702\u5DE2\u4E91\u89C6\u79D1\u6280\u6709\u9650\u516C\u53F8\u603B\u7ECF\u7406\u738B\u5EFA\u6B66\u3001\u56FD\u9645\u5E02\u573A\u9AD8\u7EA7\u7ECF\u7406\u90ED\u76DB\u57FA\u53CA\u603B\u76D1\u7A0B\u9896\u6D01\u3002\u003C/p\u003E\n\u003Cp\u003E\u963F\u672B\u624E\u5E0C\u8BF4\uFF0C\u5373\u5C06\u751F\u4EA7\u7684\u65E0\u4EBA\u673A\u6D3B\u52A8\u534A\u5F84\u7EA6\u4E3A300\u516C\u91CC\uFF0C\u6709\u52A9\u7EF4\u62A4\u5B89\u5168\uFF0C\u5C24\u5176\u5728\u5927\u9A6C\u8FB9\u5883\u5730\u533A\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u52A9\u7EF4\u62A4\u8FB9\u5883\u5730\u533A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u201C\u8FD9\u9879\u5408\u4F5C\u8003\u8651\u5230\u8BE5\u516C\u53F8\u5728\u4E2D\u56FD\u6210\u4E3A\u4E3B\u8981\u65E0\u4EBA\u673A\u5236\u9020\u5546\u7684\u8868\u73B0\uFF0C\u6BCF\u5E74\u80FD\u751F\u4EA7\u8D85\u8FC730\u4E07\u67B6\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u65E0\u4EBA\u673A\u5E02\u573A\u9700\u6C42\u5DF2\u5B58\u5728\uFF0C\u56E0\u6B64\u4ED6\u4EEC\u6562\u4E8E\u6295\u8D44\uFF0C\u5E76\u4E14\u5DF2\u9274\u5B9A\u5408\u4F5C\u6210\u529F\u4E4B\u540E\u53EF\u63D0\u4EA4\u7684\u5176\u4ED6\u9886\u57DF\u3002\u91CD\u8981\u7684\u662F\u4ED6\u4EEC\u7684\u8BDA\u610F\uFF0C\u9009\u62E9\u739B\u62C9\u673A\u6784\u4F5C\u4E3A\u5408\u4F5C\u4F19\u4F34\uFF0C\u8FD9\u957F\u671F\u5408\u4F5C\u5C06\u9020\u798F\u5409\u9686\u5761\u5927\u5B66\u7684\u5B66\u751F\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u9488\u5BF9\u519C\u4E1A\u9886\u57DF\uFF0C\u963F\u672B\u624E\u5E0C\u6307\u8FD9\u6280\u672F\u5C06\u4ECE\u8054\u90A6\u571F\u5730\u590D\u5174\u4E0E\u7EDF\u4E00\u5C40\uFF08FELCRA\uFF09\u7684\u7A3B\u7530\u533A\u5F00\u59CB\u5E94\u7528\uFF0C\u4EE5\u8FDB\u884C\u65BD\u80A5\u3001\u55B7\u6D12\u519C\u836F\u7B49\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/NT5abBi6N5YdL-_c54__yA\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
