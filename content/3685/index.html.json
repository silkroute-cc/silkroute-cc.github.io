  "slug": "6655-2",
  "canonicalUrlKey": "6655-2",
  "route": "/3685/",
  "title": "\u6B22\u8FCE\u7A46\u8FEA\u7EF4\u6301\u8BC4\u7EA7A3\u3000\u5927\u9A6C\u4FDD\u6301\u7ECF\u6D4E\u589E\u957F\u52BF\u5934",
  "summary": "\uFF08\u5409\u9686\u576114\u65E5\u8BAF\uFF09\u6211\u56FD\u653F\u5E9C\u6B22\u8FCE\u7A46\u8FEA\u6295\u8D44\u8005\u670D\u52A1\u516C\u53F8\uFF08Moody\u0027s\uFF09\u7ED9\u4E88\u5927\u9A6C\u7684\u4E3B\u6743\u4FE1\u7528\u8BC4\u7EA7\u7EF4\u6301\u5728A3\uFF0C\u5C55\u671B\u4E3A\u201C\u7A33\u5B9A\u201D\u3002\u6B64\u8BC4\u7EA7\u53CD\u6620\u4E86\u5927\u9A6C\u9762\u5BF9\u5145\u6EE1\u6311\u6218\u548C\u4E0D\u786E\u5B9A\u7684\u5168\u7403\u73AF\u5883\u4E0B\uFF0C\u4ECD\u4FDD\u6301\u7ECF\u6D4E\u589E\u957F\u52BF\u5934\u53CA\u97E7\u6027\u7684\u51B3\u5FC3\u3002 \u7A46\u8FEA\u6307\uFF0C\u5927\u9A6C\u7684\u7ECF\u6D4E\u591A\u6837\u6027\u548C\u5177\u7ADE\u4E89\u529B\uFF0C\u4E14\u968F\u653F\u5E9C\u83B7\u5F97\u5F3A\u5927\u7684\u56FD\u5185\u878D\u8D44\u6765\u6E90\uFF0C\u53EF\u6301\u7EED\u6210\u4E3A\u8BC4\u7EA7\u4F18\u52BF\u3002\u8FD9\u6709\u52A9\u964D\u4F4E\u51A0\u75C5\u75AB\u60C5\u540E\u63D0\u5347\u7684\u8D22\u653F\u98CE\u9669\uFF0C\u5305\u62EC\u503A\u52A1\u8D1F\u62C5\u589E\u52A0\u548C\u8D1F\u503A\u80FD\u529B\u51CF\u5F31\u3002 \u7A46\u8FEA\u9884\u6D4B\uFF0C\u7EB5\u7136\u53D7\u5230\u5168\u56FD\u7ECF\u6D4E\u75B2\u8F6F\u5F71\u54CD\uFF0C\u5728\u5546\u54C1\u51FA\u53E3\u589E\u52A0\u3001\u65C5\u6E38\u4E1A\u9886\u57DF\u590D\u82CF\u548C\u52B3\u52A8\u529B\u5E02\u573A\u8D70\u5F3A\uFF0C\u5927\u9A6C\u7684\u5B9E\u9645\u56FD\u5185\u751F\u4EA7\u603B\u503C\u53EF\u4E8E202\u2026",
  "body": "\u003Cp\u003E\n\uFF08\u5409\u9686\u576114\u65E5\u8BAF\uFF09\u6211\u56FD\u653F\u5E9C\u6B22\u8FCE\u7A46\u8FEA\u6295\u8D44\u8005\u670D\u52A1\u516C\u53F8\uFF08Moody\u0026#39;s\uFF09\u7ED9\u4E88\u5927\u9A6C\u7684\u4E3B\u6743\u4FE1\u7528\u8BC4\u7EA7\u7EF4\u6301\u5728A3\uFF0C\u5C55\u671B\u4E3A\u201C\u7A33\u5B9A\u201D\u3002\u6B64\u8BC4\u7EA7\u53CD\u6620\u4E86\u5927\u9A6C\u9762\u5BF9\u5145\u6EE1\u6311\u6218\u548C\u4E0D\u786E\u5B9A\u7684\u5168\u7403\u73AF\u5883\u4E0B\uFF0C\u4ECD\u4FDD\u6301\u7ECF\u6D4E\u589E\u957F\u52BF\u5934\u53CA\u97E7\u6027\u7684\u51B3\u5FC3\u3002\n\n\u7A46\u8FEA\u6307\uFF0C\u5927\u9A6C\u7684\u7ECF\u6D4E\u591A\u6837\u6027\u548C\u5177\u7ADE\u4E89\u529B\uFF0C\u4E14\u968F\u653F\u5E9C\u83B7\u5F97\u5F3A\u5927\u7684\u56FD\u5185\u878D\u8D44\u6765\u6E90\uFF0C\u53EF\u6301\u7EED\u6210\u4E3A\u8BC4\u7EA7\u4F18\u52BF\u3002\u8FD9\u6709\u52A9\u964D\u4F4E\u51A0\u75C5\u75AB\u60C5\u540E\u63D0\u5347\u7684\u8D22\u653F\u98CE\u9669\uFF0C\u5305\u62EC\u503A\u52A1\u8D1F\u62C5\u589E\u52A0\u548C\u8D1F\u503A\u80FD\u529B\u51CF\u5F31\u3002\n\n\u7A46\u8FEA\u9884\u6D4B\uFF0C\u7EB5\u7136\u53D7\u5230\u5168\u56FD\u7ECF\u6D4E\u75B2\u8F6F\u5F71\u54CD\uFF0C\u5728\u5546\u54C1\u51FA\u53E3\u589E\u52A0\u3001\u65C5\u6E38\u4E1A\u9886\u57DF\u590D\u82CF\u548C\u52B3\u52A8\u529B\u5E02\u573A\u8D70\u5F3A\uFF0C\u5927\u9A6C\u7684\u5B9E\u9645\u56FD\u5185\u751F\u4EA7\u603B\u503C\u53EF\u4E8E2023\u5E74\u589E\u81F34.5%\u3002\n\n\u81F3\u4E8E\u4E2D\u671F\u800C\u8A00\uFF0C\u7A46\u8FEA\u5219\u9884\u6D4B\uFF0C\u5927\u9A6C\u7684\u5B9E\u9645\u56FD\u5185\u751F\u4EA7\u603B\u503C\u53EF\u4E8E2025\u5E74\u589E\u81F35%\uFF0C\u63A5\u8FD1\u6F5C\u5728\u4EA7\u51FA\u589E\u957F\uFF0C\u7406\u7531\u662F\u76F8\u8F83\u4E8EA\u7EA7\u56FD\u5BB6\u4EBA\u53E3\u7ED3\u6784\u66F4\u597D\u3001\u6295\u8D44\u6C34\u5E73\u5F3A\u52B2\uFF0C\u53CA\u53D1\u8FBE\u7ECF\u6D4E\u4F53\u66F4\u9AD8\u7684\u9700\u6C42\u3002\n\n\u7A46\u8FEA\u8868\u793A\uFF0C\u53D7\u5230\u5404\u7C7B\u957F\u9A71\u56E0\u7D20\u53CA\u5927\u9A6C\u53C2\u4E0E\u5168\u7403\u4EF7\u503C\u94FE\u7684\u652F\u6301\uFF0C\u5305\u62EC\u9AD8\u4EF7\u503C\u884C\u4E1A\u7684\u5916\u56FD\u6295\u8D44\u589E\u52A0\uFF0C\u5927\u9A6C\u7ECF\u6D4E\u8868\u73B0\u548C\u5F39\u6027\u662F\u9884\u8BA1\u53EF\u8FDB\u6B65\u3002\n\n\u8D22\u653F\u90E8\u4ECA\u65E5\u53D1\u8868\u6587\u544A\uFF0C\u5982\u662F\u8868\u793A\u3002\n\n\u7A46\u8FEA\u4E5F\u8868\u793A\uFF0C\u4E2D\u671F\u6210\u957F\u5C06\u7EE7\u7EED\u53D7\u5230\u5927\u9A6C\u878D\u5165\u533A\u57DF\u548C\u5168\u7403\u4F9B\u5E94\u94FE\uFF0C\u4EE5\u53CA\u9AD8\u7ECF\u6D4E\u7ADE\u4E89\u529B\u7684\u652F\u6301\uFF0C\u9884\u8BA1\u53EF\u6709\u52A9\u4E8E\u5B9E\u8DF5\u53EF\u89C2\u7684\u5916\u90E8\u76C8\u9980\u3002\n\n\u201C\u53E6\u5916\uFF0C\u5F71\u54CD\u589E\u957F\u7684\u5176\u5B83\u56E0\u7D20\u5305\u62EC\uFF0C\u5927\u9A6C\u7684\u57FA\u7840\u8BBE\u65BD\u8D28\u91CF\u3001\u9AD8\u7B49\u6559\u80B2\u548C\u57F9\u8BAD\u3001\u52B3\u52A8\u529B\u548C\u4EA7\u54C1\u5E02\u573A\u6548\u7387\uFF0C\u4EE5\u53CA\u6280\u672F\u91C7\u7528\u65B9\u9762\u4F18\u4E8E\u4ED6\u56FD\u7684\u65B0\u5174\u533A\u57DF\u5E02\u573A\u3002\u201D\n\n\u7A46\u8FEA\u4E5F\u8868\u793A\uFF0C\u5927\u9A6C\u6301\u7EED\u8868\u73B0\u51FA\u9AD8\u5EA6\u7684\u7ECF\u6D4E\u590D\u6742\u6027\uFF0C\u53CD\u6620\u4E86\u5982\u7535\u6C14\u548C\u7535\u5B50\u5546\u54C1\u7B49\u51FA\u53E3\u7684\u77E5\u8BC6\u5BC6\u96C6\u5EA6\u3002\n\n\u7A46\u8FEA\u627F\u8BA4\u4E86\u5927\u9A6C\u673A\u6784\u5728\u901A\u8FC7\u5B9E\u65BD\u6709\u6548\u7684\u8D27\u5E01\u548C\u5B8F\u89C2\u7ECF\u6D4E\u7684\u653F\u7B56\uFF0C\u4EE5\u53CA\u56FD\u5BB6\u94F6\u884C\u4E25\u683C\u76D1\u7BA1\u63AA\u65BD\u5E26\u6765\u7684\u94F6\u884C\u4F53\u7CFB\u5F39\u6027\u4E0B\u5E94\u5BF9\u5404\u79CD\u6311\u6218\u7684\u80FD\u529B\u3002\n\n\u7A46\u8FEA\u6307\uFF0C\u6216\u6709\u8D1F\u503A\u62A5\u544A\u548C\u4E2D\u671F\u8D22\u653F\u6846\u67B6\u7684\u53D1\u5E03\u63D0\u5347\u4E86\u900F\u660E\u5EA6\uFF0C\u8868\u660E\u8D22\u653F\u653F\u7B56\u6709\u6548\u6027\u7684\u6709\u6240\u63D0\u9AD8\u3002\n\n\u7A46\u8FEA\u9884\u6D4B\uFF0C\u5927\u9A6C\u81F4\u529B\u5B9E\u65BD\u7684\u7BA1\u7406\u6539\u9769\uFF0C\u5305\u62EC\u63D0\u9AD8\u8D22\u653F\u95EE\u8D23\u5236\u7684\u300A\u8D22\u653F\u8D23\u4EFB\u6CD5\u300B\u548C\u300A\u653F\u5E9C\u91C7\u8D2D\u6CD5\u300B\uFF0C\u5C06\u80FD\u591F\u89E3\u51B3\u6D6A\u8D39\u548C\u8150\u8D25\u95EE\u9898\u3002\n\u003C/p\u003E\n\u003Cp\u003E\n\u7A46\u8FEA\u8BA4\u4E3A\uFF0C\u8FD9\u9879\u6539\u9769\u5BF9\u653F\u5E9C\u5B9E\u65BD\u8D22\u653F\u6574\u987F\u548C\u503A\u52A1\u7A33\u5B9A\u7684\u52AA\u529B\uFF0C\u5177\u6709\u660E\u786E\u7684\u610F\u4E49\u3002\n\n\u7A46\u8FEA\u4E5F\u9884\u6D4B\uFF0C\u5927\u9A6C\u7684\u8D22\u653F\u8D64\u5B57\u5C06\u57282023\u5E74\u964D\u81F3\u56FD\u5185\u751F\u4EA7\u603B\u503C\u76845%\uFF0C\u800C2024\u5E74\u548C2025\u5E74\u7684\u8D22\u653F\u6574\u987F\u8F68\u8FF9\u5C06\u653E\u7F13\uFF0C\u4E0E\u5B98\u65B9\u9884\u6D4B\u76842025\u5E743.6%\u4E00\u81F4\uFF0C\u8FD9\u662F\u968F\u8457\u7A0E\u6536\u57FA\u7840\u6709\u9650\u4E14\u652F\u51FA\u627F\u8BFA\u9AD8\u3002\n\n\u7A46\u8FEA\u8FD8\u9884\u6D4B\uFF0C\u653F\u5E9C\u7684\u503A\u52A1\u8D1F\u62C5\u5C06\u57282024\u5E74\u964D\u81F3\u56FD\u5185\u751F\u4EA7\u603B\u503C\u768461%\uFF0C\u5E76\u5F3A\u8C03\u5177\u4F4E\u98CE\u9669\u6216\u6709\u8D1F\u503A\u3002\n\n\u56E0\u6B64\uFF0C\u7A46\u8FEA\u8868\u793A\uFF0C\u6DF1\u539A\u7684\u56FD\u5185\u8D44\u672C\u5E02\u573A\u5E73\u8861\u4E86\u5F53\u524D\u8D22\u653F\u72B6\u51B5\u7684\u4E0D\u8DB3\uFF0C\u800C\u5229\u7387\u548C\u653F\u5E9C\u7684\u6536\u76CA\u7387\u66F2\u7EBF\u5DF2\u6062\u590D\u5230\u75AB\u60C5\u524D\u7684\u6B63\u5E38\u6C34\u5E73\u5E76\u4FDD\u6301\u7A33\u5B9A\u3002\n\n\u7A46\u8FEA\u8BA4\u4E3A\uFF0C\u8003\u8651\u5230\u56FD\u5BB6\u7A0E\u6536\u57FA\u7840\u4E0E\u5177\u6709\u4E0EA\u8BC4\u7EA7\u56FD\u5BB6\u76F8\u6BD4\u662F\u6700\u4F4E\u7684\u5176\u4E2D\u4E4B\u4E00\uFF0C\u4EE5\u53CA\u653F\u5E9C\u5728\u9000\u4F11\u91D1\u3001\u507F\u503A\u652F\u4ED8\u548C\u6D25\u8D34\u53EF\u6301\u7EED\u6027\u65B9\u9762\u7684\u9AD8\u989D\u652F\u51FA\u627F\u8BFA\uFF0C\u56E0\u6B64\u9700\u8FDB\u884C\u6539\u9769\u6269\u5927\u7A0E\u6536\u57FA\u7840\u3002\n\n\u751A\u81F3\u76EE\u524D\u503A\u52A1\u7684\u6C34\u5E73\u53CA\u8D1F\u503A\u6216\u5BF9\u653F\u5E9C\u7684\u501F\u8D37\u80FD\u529B\u5E26\u6765\u98CE\u9669\u3002\n\n\u6587\u544A\u6307\uFF0C\u7B26\u5408\u660C\u660E\u5927\u9A6C\u613F\u666F\uFF0C\u653F\u5E9C\u81F4\u529B\u63A8\u52A8\u5305\u5BB9\u548C\u53EF\u6301\u7EED\u6027\u589E\u957F\uFF0C\u6062\u590D\u5BF9\u516C\u5171\u673A\u6784\u548C\u6CBB\u7406\u7684\u4FE1\u5FC3\uFF0C\u5E76\u634D\u536B\u6240\u6709\u5927\u9A6C\u4EBA\u7684\u793E\u4F1A\u516C\u4E49\u3002\n\n\u6587\u544A\u8BF4\uFF0C\u653F\u5E9C\u5C06\u6301\u7EED\u8FDB\u4E00\u6B65\u5DE9\u56FA\u7ECF\u6D4E\u589E\u957F\u5E76\u5438\u5F15\u66F4\u591A\u6295\u8D44\uFF0C\u540C\u65F6\u8457\u91CD\u63A7\u5236\u901A\u80C0\u538B\u529B\u548C\u51CF\u8F7B\u4EBA\u6C11\u751F\u6D3B\u8D1F\u62C5\u3002\n\n\u653F\u5E9C\u627F\u8BFA\uFF0C\u5B9E\u65BD\u8D22\u653F\u6539\u9769\u548C\u63A7\u5236\u503A\u52A1\u6C34\u5E73\uFF0C\u786E\u4FDD\u575A\u56FA\u7ECF\u6D4E\u7ED3\u6784\uFF0C\u53CA\u7BA1\u7406\u516C\u5171\u8D22\u653F\u7684\u6743\u5A01\u4F53\u5236\u6846\u67B6\u3002\n\u003C/p\u003E\n\u003Cp\u003E\n\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/hxBi72p6cJOzty8vI1-nSw\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
