  "id": "%e5%87%af%e5%88%a9%e7%9a%84%e5%9f%8e%e5%a0%a1%e7%9a%84%e7%a7%98%e5%af%86",
  "slug": "%e5%87%af%e5%88%a9%e7%9a%84%e5%9f%8e%e5%a0%a1%e7%9a%84%e7%a7%98%e5%af%86",
  "canonicalUrlKey": "%e5%87%af%e5%88%a9%e7%9a%84%e5%9f%8e%e5%a0%a1%e7%9a%84%e7%a7%98%e5%af%86",
  "route": "/2783/",
  "title": "\u51EF\u5229\u7684\u57CE\u5821\u7684\u79D8\u5BC6",
  "summary": "\u5728\u9739\u96F3\u5DDE\u5CC7\u90FD\u7259\u4E5F\u7684\u5C71\u9876\u4E0A\uFF0C\u5750\u843D\u7740\u4E00\u5EA7\u5EFA\u4E8E 1915 \u5E74\u7684\u57CE\u5821\uFF0C\u662F\u82CF\u683C\u5170\u6A61\u80F6\u79CD\u690D\u56ED\u4E3B\u5A01\u5EC9\u00B7\u51EF\u5229\u00B7\u53F2\u5BC6\u65AF (William Kellie Smith)\u5EFA\u9020\u7684\u3002 \u6700\u521D\uFF0C\u8FD9\u5EA7\u57CE\u5821\u7531\u4E00\u5EA7 6 \u5C42\u9AD8\u7684\u5854\u697C\u3001\u4E00\u4E2A\u7F51\u7403\u573A\u3001\u5C4B\u9876\u5A31\u4E50\u533A\u3001\u9152\u7A96\u548C\u79D8\u5BC6\u96A7\u9053\u7EC4\u6210\u3002\u5B83\u8FD8\u8BA1\u5212\u5EFA\u9020\u9A6C\u6765\u897F\u4E9A\u7684\u7B2C\u4E00\u90E8\u7535\u68AF\uFF0C\u4E0D\u5E78\u7684\u662F\uFF0C\u53F2\u5BC6\u65AF\u7684\u68A6\u60F3\u6CA1\u6709\u5B9E\u73B0\u3002 \u6545\u4E8B\u5F00\u59CB\u4E8E\u53F2\u5BC6\u65AF\u79FB\u5C45\u5230\u9A6C\u6765\u897F\u4E9A\uFF0C\u5E76\u6D89\u8DB3\u6A61\u80F6\u79CD\u690D\u4E1A\uFF0C\u8FD9\u4E2A\u4EA7\u4E1A\u4F7F\u4ED6\u8FBE\u5230\u4E86\u8D22\u5BCC\u7684\u9876\u5CF0\u3002\u7136\u800C\uFF0C\u4E8B\u60C5\u5728 1926 \u5E74\u5F00\u59CB\u53D1\u751F\u60B2\u2026",
  "body": "\u003Cp\u003E\u003Cstrong\u003E\u5728\u9739\u96F3\u5DDE\u5CC7\u90FD\u7259\u4E5F\u7684\u5C71\u9876\u4E0A\uFF0C\u5750\u843D\u7740\u4E00\u5EA7\u5EFA\u4E8E 1915 \u5E74\u7684\u57CE\u5821\uFF0C\u662F\u82CF\u683C\u5170\u6A61\u80F6\u79CD\u690D\u56ED\u4E3B\u5A01\u5EC9\u0026#183;\u51EF\u5229\u0026#183;\u53F2\u5BC6\u65AF (William Kellie Smith)\u5EFA\u9020\u7684\u3002\u003C/strong\u003E\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/mmbiz_jpg/JsSxkvuj1TEACY9iaQUicnrwIr3oV4NBtGhtzDlfmOWzibhUIIA1ia3WN6Avm9JNRWlhe5Mtu7ZwcURGezlJ1KIUhw/640?wx_fmt=jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u6700\u521D\uFF0C\u8FD9\u5EA7\u57CE\u5821\u7531\u4E00\u5EA7 6 \u5C42\u9AD8\u7684\u5854\u697C\u3001\u4E00\u4E2A\u7F51\u7403\u573A\u3001\u5C4B\u9876\u5A31\u4E50\u533A\u3001\u9152\u7A96\u548C\u79D8\u5BC6\u96A7\u9053\u7EC4\u6210\u3002\u5B83\u8FD8\u8BA1\u5212\u5EFA\u9020\u9A6C\u6765\u897F\u4E9A\u7684\u7B2C\u4E00\u90E8\u7535\u68AF\uFF0C\u4E0D\u5E78\u7684\u662F\uFF0C\u53F2\u5BC6\u65AF\u7684\u68A6\u60F3\u6CA1\u6709\u5B9E\u73B0\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/mmbiz_jpg/JsSxkvuj1TEACY9iaQUicnrwIr3oV4NBtGdibXYlES45k0pkzicPoj3zIWica57FZzVUGzDgCZEbAE7XAp5rmcQ3qSw/640?wx_fmt=jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u6545\u4E8B\u5F00\u59CB\u4E8E\u53F2\u5BC6\u65AF\u79FB\u5C45\u5230\u9A6C\u6765\u897F\u4E9A\uFF0C\u5E76\u6D89\u8DB3\u6A61\u80F6\u79CD\u690D\u4E1A\uFF0C\u8FD9\u4E2A\u4EA7\u4E1A\u4F7F\u4ED6\u8FBE\u5230\u4E86\u8D22\u5BCC\u7684\u9876\u5CF0\u3002\u7136\u800C\uFF0C\u4E8B\u60C5\u5728 1926 \u5E74\u5F00\u59CB\u53D1\u751F\u60B2\u5267\u6027\u7684\u8F6C\u53D8\uFF0C\u53F2\u5BC6\u65AF\u5728\u91CC\u65AF\u672C\u53BB\u4E16\u3002\u5728\u4ED6\u7A81\u7136\u53BB\u4E16\u540E\uFF0C\u57CE\u5821\u7684\u5EFA\u8BBE\u6682\u505C\u4E86\u3002\u53F2\u5BC6\u65AF\u7684\u59BB\u5B50\u6700\u7EC8\u5C06\u8FD9\u5EA7\u57CE\u5821\u5356\u7ED9\u4E86\u4ED6\u4EBA\u3002\u51E0\u5E74\u540E\uFF0C\u5B83\u88AB\u5E9F\u5F03\u5E76\u6210\u4E3A\u5386\u53F2\u9057\u8FF9\u3002\u003C/p\u003E\n\u003Cp\u003E\u662F\u4EC0\u4E48\u8BA9\u8FD9\u5EA7\u57CE\u5821\u5728\u4ECA\u5929\u51FA\u540D\u5462\uFF1F\u51EF\u5229\u57CE\u5821\u63D0\u4F9B\u4E86\u5728\u5EFA\u7B51\u7F8E\u666F\u4E2D\u6F2B\u6B65\u7684\u7EDD\u4F73\u4F53\u9A8C\uFF0C\u540C\u65F6\u4E5F\u88AB\u8BA4\u4E3A\u662F\u4E00\u4E2A\u6709\u8D85\u81EA\u7136\u4F20\u95FB\u7684\u5730\u65B9\u3002\u5C3D\u7BA1\u5173\u4E8E\u57CE\u5821\u5468\u56F4\u51FA\u73B0\u9B3C\u9B42\u7684\u8C23\u8A00\u4E0D\u65AD\uFF0C\u4F46\u4E0D\u80FD\u5426\u8BA4\u57CE\u5821\u7684\u6BCF\u4E2A\u89D2\u843D\u90FD\u88C5\u9970\u7740\u4EE4\u4EBA\u5370\u8C61\u6DF1\u523B\u7684\u7ED3\u6784\u5947\u89C2\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/mmbiz_jpg/JsSxkvuj1TEACY9iaQUicnrwIr3oV4NBtG2jAicZjHTVACvgsBkjO1R0rOicJSpkzj9k5XaK01T3I5GgBEZxibtgVaQ/640?wx_fmt=jpeg\u0026amp;wxfrom=5\u0026amp;wx_lazy=1\u0026amp;wx_co=1\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u51EF\u5229\u57CE\u5821\u878D\u5408\u4E86\u7F57\u9A6C\u7B49\u897F\u6B27\u98CE\u683C\u5EFA\u7B51\u7684\u7279\u8272\uFF0C\u8FD9\u79CD\u7C7B\u578B\u7684\u5EFA\u7B51\u4E5F\u53EF\u4EE5\u5728\u5409\u9686\u5761\u7684\u82CF\u4E39\u963F\u90FD\u6C99\u672B\u5927\u53A6\u770B\u5230\u3002\u57CE\u5821\u62E5\u6709\u4EE4\u4EBA\u5370\u8C61\u6DF1\u523B\u7684\u9A6C\u8E44\u5F62\u62F1\u95E8\u3001\u4E0D\u540C\u79CD\u7C7B\u7684\u8FDB\u53E3\u74F7\u7816\u3001\u7816\u5757\uFF0C\u4EE5\u53CA\u88C5\u9970\u7740\u590D\u6742\u77F3\u818F\u6A90\u53E3\u8BBE\u8BA1\u7684\u5929\u82B1\u677F\u3002\u5C4B\u9876\u73B0\u5728\u4E5F\u5BF9\u6E38\u5BA2\u5F00\u653E\uFF0C\u5728\u90A3\u91CC\u53EF\u4EE5\u6B23\u8D4F\u5230\u5468\u8FB9\u5730\u533A\u7684\u7F8E\u4E3D\u666F\u8272\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/mmbiz_jpg/JsSxkvuj1TEACY9iaQUicnrwIr3oV4NBtGKtAmJHeE4EHVrlia36E2ckFBnrrIl2uDbjiarRaZ4XNkvy5vo2lmffWQ/640?wx_fmt=jpeg\u0026amp;wxfrom=5\u0026amp;wx_lazy=1\u0026amp;wx_co=1\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5728\u57CE\u5821\u573A\u7A7A\u5730\u4E0A\u7684\u662F\u53F2\u5BC6\u65AF\u548C\u4ED6\u7684\u4E24\u4E2A\u5B69\u5B50\u7684\u96D5\u5851\uFF0C\u50CF\u662F\u5728\u6B22\u8FCE\u6240\u6709\u524D\u6765\u7684\u6E38\u5BA2\u3002\u76F4\u5230\u4ECA\u5929\uFF0C\u5F53\u5730\u4EBA\u90FD\u8BA4\u4E3A\u8FD9\u4E2A\u5730\u65B9\u88AB\u53F2\u5BC6\u65AF\u5BB6\u65CF\u7684\u9B3C\u9B42\u6240\u73AF\u7ED5\u3002\u5EFA\u7B51\u7269\u4E2D\u7684\u4E00\u4E2A\u5730\u65B9\u88AB\u6807\u8BB0\u4E3A\u201C\u5E7D\u7075\u56DE\u5ECA\u9633\u53F0\u201D\uFF0C\u88AB\u63CF\u8FF0\u4E3A\u53F2\u5BC6\u65AF\u7684\u7075\u9B42\u5728\u591C\u95F4\u6E38\u8361\u7684\u8D70\u5ECA\u3002\u65E0\u8BBA\u6709\u5173\u62A5\u9053\u662F\u5426\u5C5E\u5B9E\uFF0C\u6E38\u5BA2\u80AF\u5B9A\u4F1A\u5BF9\u57CE\u5821\u7684\u5B8F\u4F1F\u548C\u5468\u56F4\u7684\u602A\u5F02\u6C14\u6C1B\u611F\u5230\u656C\u754F\uFF0C\u5BAB\u6BBF\u7684\u6BCF\u4E2A\u89D2\u843D\u90FD\u5145\u6EE1\u4E86\u795E\u79D8\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/mmbiz_jpg/JsSxkvuj1TEACY9iaQUicnrwIr3oV4NBtGsTZKUHPFYibMRnAz3FS6owVE1fgVc2BmSNLgbqR8qZeiabtv7kE7Mg5g/640?wx_fmt=jpeg\u0026amp;wxfrom=5\u0026amp;wx_lazy=1\u0026amp;wx_co=1\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u6BCF\u4F4D\u6E38\u5BA2\u9700\u8981\u7F34\u7EB3\u5165\u573A\u8D39\uFF0C\u800C\u4E14\u6839\u636E\u9700\u6C42\u53EF\u4EE5\u9009\u62E9\u76F8\u5E94\u7684\u5BFC\u6E38\u670D\u52A1\u3002\u5F53\u7136\uFF0C\u8FD8\u5305\u62EC\u53C2\u89C2\u9644\u8FD1\u7684\u9521\u77FF\u6316\u6398\u673A\uFF0C\u56E0\u4E3A\u9739\u96F3\u5DDE\u4EE5\u524D\u4EE5\u5176\u9521\u77FF\u5F00\u91C7\u4E1A\u800C\u95FB\u540D\u3002\u5BF9\u4E8E\u5BFB\u6C42\u66F4\u523A\u6FC0\u4F53\u9A8C\u7684\u6E38\u5BA2\uFF0C\u8FD8\u63D0\u4F9B\u539F\u751F\u6001\u591C\u6E38 - \u6240\u4EE5\u8BF7\u505A\u597D\u51C6\u5907\uFF0C\u6C89\u6D78\u5728\u6F06\u9ED1\u7684\u591C\u665A\u548C\u5BC2\u9759\u5F53\u4E2D\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/mmbiz_jpg/JsSxkvuj1TEACY9iaQUicnrwIr3oV4NBtGeUFdic2UWPzma9jetgdua6rToO4NIfGziaibpgQWFAH5SzeMicibtw2cMbg/640?wx_fmt=jpeg\u0026amp;wxfrom=5\u0026amp;wx_lazy=1\u0026amp;wx_co=1\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/mmbiz_jpg/JsSxkvuj1TGsZq0JlhqhS2DjfYFdHKdKIkQiaEUMI6CwfJX2s9wcP1uDPPA7n03YNWMpYwQQPhFNric7RS8M7zbA/640?wx_fmt=jpeg\u0026amp;wxfrom=5\u0026amp;wx_lazy=1\u0026amp;wx_co=1\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u66F4\u591A\u8D44\u8BAF\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u56FD\u5BB6\u65C5\u6E38\u5C40\u5B98\u65B9\u7F51\u7AD9\uFF1A\u003C/p\u003E\n\u003Cp\u003Ewww.tourism.gov.my\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u56FD\u5BB6\u65C5\u6E38\u5C40\u5B98\u65B9\u5FAE\u535A\uFF1A\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38\u5C40\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u56FD\u5BB6\u65C5\u6E38\u5C40\u5B98\u65B9\u5FAE\u4FE1\u516C\u4F17\u53F7\uFF1A\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38\u5C40\u003C/p\u003E\n",
