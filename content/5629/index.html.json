  "title": "\u56FD\u9645\u5112\u5B66\u8054\u5408\u4F1A\u4E0E\u9A6C\u6765\u897F\u4E9A\u56FD\u9645\u4F0A\u65AF\u5170\u5927\u5B66\u5171\u540C\u4E3E\u529E\u5112\u4F0A\u6587\u660E\u5BF9\u8BDD\u4F1A",
  "summary": "6\u670816\u65E5\uFF0C\u7531\u56FD\u9645\u5112\u5B66\u8054\u5408\u4F1A\u3001\u9A6C\u6765\u897F\u4E9A\u56FD\u9645\u4F0A\u65AF\u5170\u5927\u5B66\u5171\u540C\u4E3B\u529E\u7684\u201C\u5112\u4F0A\u6587\u660E\u5BF9\u8BDD\u4F1A\u201D\u5728\u5409\u9686\u5761\u4E3E\u884C\u3002\u56FD\u9645\u5112\u5B66\u8054\u5408\u4F1A\u4F1A\u957F\u5B59\u6625\u5170\uFF0C\u9A6C\u6765\u897F\u4E9A\u524D\u526F\u603B\u7406\u3001\u5B89\u74E6\u5C14\u603B\u7406\u592B\u4EBA\u65FA\u00B7\u963F\u5179\u838E\uFF0C\u4E2D\u56FD\u9A7B\u9A6C\u6765\u897F\u4E9A\u5927\u4F7F\u6B27\u9633\u7389\u9756\uFF0C\u9A6C\u6765\u897F\u4E9A\u56FD\u9645\u4F0A\u65AF\u5170\u5927\u5B66\u6821\u957F\u5965\u65AF\u66FC\u00B7\u5DF4\u5361\u5C14\u7B49\u51FA\u5E2D\u5F00\u5E55\u5F0F\u5E76\u81F4\u8F9E\u3002\u9A6C\u6765\u897F\u4E9A\u603B\u7406\u5E9C\u5B97\u6559\u4E8B\u52A1\u90E8\u526F\u90E8\u957F\u7956\u5C14\u57FA\u592B\u5229\u00B7\u54C8\u6851\uFF0C\u56FD\u9645\u4F0A\u65AF\u5170\u5927\u5B66\u7406\u4E8B\u4F1A\u4E3B\u5E2D\u8428\u59C6\u82CF\u4E01\u00B7\u5965\u65AF\u66FC\uFF0C\u56FD\u9645\u5112\u5B66\u8054\u5408\u4F1A\u526F\u7406\u4E8B\u957F\u7FC1\u8BD7\u6770\u51FA\u5E2D\u4F1A\u8BAE\u3002\u5BF9\u8BDD\u4F1A\u4E3B\u9898\u4E3A\u201C\u5112\u5BB6\u6587\u5316\u4E0E\u4F0A\u65AF\u5170\u6587\u660E\u7684\u4EA4\u6D41\u4E92\u9274\u201D\uFF0C\u8FD1\u767E\u4F4D\u5B66\u8005\u4E0E\u4F1A\u3002 \u5B59\u6625\u5170\u8868\u793A\uFF0C\u4E2D\u9A6C\u4E24\u2026",
  "body": "\u003Cp\u003E6\u670816\u65E5\uFF0C\u7531\u56FD\u9645\u5112\u5B66\u8054\u5408\u4F1A\u3001\u9A6C\u6765\u897F\u4E9A\u56FD\u9645\u4F0A\u65AF\u5170\u5927\u5B66\u5171\u540C\u4E3B\u529E\u7684\u201C\u5112\u4F0A\u6587\u660E\u5BF9\u8BDD\u4F1A\u201D\u5728\u5409\u9686\u5761\u4E3E\u884C\u3002\u56FD\u9645\u5112\u5B66\u8054\u5408\u4F1A\u4F1A\u957F\u5B59\u6625\u5170\uFF0C\u9A6C\u6765\u897F\u4E9A\u524D\u526F\u603B\u7406\u3001\u5B89\u74E6\u5C14\u603B\u7406\u592B\u4EBA\u65FA\u0026#183;\u963F\u5179\u838E\uFF0C\u4E2D\u56FD\u9A7B\u9A6C\u6765\u897F\u4E9A\u5927\u4F7F\u6B27\u9633\u7389\u9756\uFF0C\u9A6C\u6765\u897F\u4E9A\u56FD\u9645\u4F0A\u65AF\u5170\u5927\u5B66\u6821\u957F\u5965\u65AF\u66FC\u0026#183;\u5DF4\u5361\u5C14\u7B49\u51FA\u5E2D\u5F00\u5E55\u5F0F\u5E76\u81F4\u8F9E\u3002\u9A6C\u6765\u897F\u4E9A\u603B\u7406\u5E9C\u5B97\u6559\u4E8B\u52A1\u90E8\u526F\u90E8\u957F\u7956\u5C14\u57FA\u592B\u5229\u0026#183;\u54C8\u6851\uFF0C\u56FD\u9645\u4F0A\u65AF\u5170\u5927\u5B66\u7406\u4E8B\u4F1A\u4E3B\u5E2D\u8428\u59C6\u82CF\u4E01\u0026#183;\u5965\u65AF\u66FC\uFF0C\u56FD\u9645\u5112\u5B66\u8054\u5408\u4F1A\u526F\u7406\u4E8B\u957F\u7FC1\u8BD7\u6770\u51FA\u5E2D\u4F1A\u8BAE\u3002\u5BF9\u8BDD\u4F1A\u4E3B\u9898\u4E3A\u201C\u5112\u5BB6\u6587\u5316\u4E0E\u4F0A\u65AF\u5170\u6587\u660E\u7684\u4EA4\u6D41\u4E92\u9274\u201D\uFF0C\u8FD1\u767E\u4F4D\u5B66\u8005\u4E0E\u4F1A\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/mmbiz_png/rHJM5w2uDEPgl2db5eDjkiccbHaOYUNQOSsSVqdMTqwwHH9PTibzqq7riaLd1RB7byt0uG3k07WZ8JG3kiaJ2xURug/640?wx_fmt=png\u0026amp;from=appmsg\u0026amp;wxfrom=5\u0026amp;wx_lazy=1\u0026amp;tp=webp\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5B59\u6625\u5170\u8868\u793A\uFF0C\u4E2D\u9A6C\u4E24\u56FD\u9886\u5BFC\u4EBA\u9AD8\u77BB\u8FDC\u77A9\uFF0C\u79EF\u6781\u63A8\u52A8\u4E24\u56FD\u5173\u7CFB\u53D1\u5C55\u548C\u6587\u660E\u5BF9\u8BDD\u3002\u4ECA\u5E744\u6708\uFF0C\u4E60\u8FD1\u5E73\u4E3B\u5E2D\u5BF9\u9A6C\u6765\u897F\u4E9A\u8FDB\u884C\u56FD\u4E8B\u8BBF\u95EE\uFF0C\u4E24\u56FD\u9886\u5BFC\u4EBA\u8FBE\u6210\u4E00\u7CFB\u5217\u91CD\u8981\u5171\u8BC6\uFF0C\u5171\u540C\u89C1\u8BC1\u4E2D\u9A6C\u53CC\u65B9\u4EA4\u6362\u300A\u56FD\u9645\u5112\u5B66\u8054\u5408\u4F1A\u548C\u9A6C\u6765\u897F\u4E9A\u56FD\u9645\u4F0A\u65AF\u5170\u5927\u5B66\u5173\u4E8E\u5F00\u5C55\u5112\u4F0A\u6587\u660E\u5BF9\u8BDD\u9886\u57DF\u5408\u4F5C\u7684\u8C05\u89E3\u5907\u5FD8\u5F55\u300B\uFF08\u4EE5\u4E0B\u7B80\u79F0\u300A\u8C05\u89E3\u5907\u5FD8\u5F55\u300B\uFF09\uFF0C\u4E3A\u6784\u5EFA\u9AD8\u6C34\u5E73\u6218\u7565\u6027\u4E2D\u9A6C\u547D\u8FD0\u5171\u540C\u4F53\u6307\u660E\u4E86\u65B9\u5411\uFF0C\u4E3A\u5112\u4F0A\u6587\u660E\u4EA4\u6D41\u4E92\u9274\u6CE8\u5165\u4E86\u5F3A\u5927\u52A8\u529B\u3002\u672C\u6B21\u5BF9\u8BDD\u4F1A\u65E2\u662F\u8DF5\u884C\u5168\u7403\u6587\u660E\u5021\u8BAE\u3001\u63A8\u52A8\u4E0D\u540C\u6587\u660E\u4E4B\u95F4\u76F8\u4E92\u5C0A\u91CD\u76F8\u4E92\u5B66\u4E60\u7684\u751F\u52A8\u5B9E\u8DF5\uFF0C\u4E5F\u662F\u843D\u5B9E\u4E2D\u9A6C\u4E24\u56FD\u9886\u5BFC\u4EBA\u5171\u8BC6\u7684\u79EF\u6781\u884C\u52A8\u3002\u003C/p\u003E\n\u003Cp\u003E\u3000\u3000\u5B59\u6625\u5170\u8868\u793A\uFF0C\u5112\u5BB6\u6587\u5316\u4E0E\u4F0A\u65AF\u5170\u6587\u660E\u5343\u767E\u5E74\u7684\u53CB\u597D\u4EA4\u5F80\u5386\u7A0B\u8574\u542B\u7740\u4E30\u5BCC\u7684\u5386\u53F2\u7ECF\u9A8C\u3002\u9762\u5BF9\u4E16\u754C\u767E\u5E74\u672A\u6709\u4E4B\u5927\u53D8\u5C40\uFF0C\u52A0\u5F3A\u5112\u4F0A\u6587\u660E\u5BF9\u8BDD\u5C06\u4E3A\u5E94\u5BF9\u6311\u6218\u63D0\u4F9B\u4EBA\u6587\u667A\u6167\uFF0C\u4E3A\u6DF1\u5316\u5168\u7403\u5357\u65B9\u5408\u4F5C\u548C\u4FC3\u8FDB\u4E16\u754C\u548C\u5E73\u53D1\u5C55\u6CE8\u5165\u79EF\u6781\u80FD\u91CF\u3002\u4E2D\u9A6C\u53CC\u65B9\u8981\u6DF1\u5165\u63A2\u8BA8\u5112\u5BB6\u6587\u5316\u4E0E\u4F0A\u65AF\u5170\u6587\u660E\u7684\u5185\u6DB5\u3001\u4EF7\u503C\u53CA\u5176\u5171\u901A\u4E4B\u5904\uFF0C\u4E3A\u4FC3\u8FDB\u6587\u660E\u4EA4\u6D41\u4E92\u9274\u63D0\u4F9B\u7406\u8BBA\u652F\u6491\u3002\u8981\u5171\u540C\u5206\u4EAB\u5112\u4F0A\u6587\u660E\u4EA4\u6D41\u4E92\u9274\u4E2D\u7684\u6210\u529F\u7ECF\u9A8C\uFF0C\u4E3A\u4E2D\u9A6C\u4E24\u56FD\u4E43\u81F3\u5730\u533A\u76F8\u5173\u9886\u57DF\u5408\u4F5C\u63D0\u4F9B\u6709\u529B\u652F\u6301\u3002\u8981\u5171\u540C\u63A2\u7D22\u6784\u5EFA\u5112\u4F0A\u6587\u660E\u5BF9\u8BDD\u7684\u957F\u6548\u673A\u5236\uFF0C\u4E0D\u65AD\u521B\u9020\u65B0\u7684\u6210\u679C\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/mmbiz_png/rHJM5w2uDEPgl2db5eDjkiccbHaOYUNQOj14KicLiahj54QOMpSjmIbdJ06sS1nmHorg2WZ2iaVhCLpJxVaGEqJcXA/640?wx_fmt=png\u0026amp;from=appmsg\u0026amp;wxfrom=5\u0026amp;wx_lazy=1\u0026amp;tp=webp\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u65FA\u0026#183;\u963F\u5179\u838E\u4EE3\u8868\u5B89\u74E6\u5C14\u603B\u7406\u81F4\u8F9E\uFF0C\u6B22\u8FCE\u5B59\u6625\u5170\u4F1A\u957F\u4E00\u884C\u8BBF\u95EE\u9A6C\u6765\u897F\u4E9A\u3002\u5979\u8868\u793A\uFF0C\u9A6C\u4E2D\u4E24\u56FD\u6587\u660E\u90FD\u6709\u60A0\u4E45\u7684\u4F20\u7EDF\uFF0C\u6CE8\u91CD\u9053\u5FB7\u4F26\u7406\u3001\u81EA\u6211\u4FEE\u517B\u3001\u5BB6\u5EAD\u548C\u793E\u533A\u8D23\u4EFB\uFF0C\u5E76\u5BF9\u77E5\u8BC6\u4E0E\u548C\u8C10\u6000\u6709\u6DF1\u539A\u7684\u656C\u4EF0\u4E4B\u60C5\u3002\u6211\u4EEC\u94ED\u8BB0\uFF0C\u90D1\u548C\u548C\u4F0A\u672C\u0026#183;\u767D\u56FE\u6CF0\u8DE8\u8D8A\u6D77\u6D0B\uFF0C\u4E0D\u662F\u4E3A\u4E86\u5F81\u670D\uFF0C\u800C\u662F\u4E3A\u4E86\u8FDE\u63A5\u3002\u7A33\u5B9A\u3001\u548C\u5E73\u4E0E\u826F\u653F\u59CB\u7EC8\u662F\u5B89\u74E6\u5C14\u603B\u7406\u201C\u660C\u660E\u5927\u9A6C\u201D\uFF08Malaysia MADANI\uFF09\u8BAE\u7A0B\u4E0B\u4F18\u5148\u7684\u56FD\u5BB6\u4E8B\u52A1\u3002\u8981\u901A\u8FC7\u5F00\u5C55\u5112\u4F0A\u6587\u660E\u5BF9\u8BDD\uFF0C\u79EF\u6781\u5316\u89E3\u6F5C\u5728\u51B2\u7A81\uFF0C\u575A\u5B9A\u5730\u79C9\u6301\u548C\u5E73\u3001\u81EA\u7531\u3001\u4EC1\u7231\u4E0E\u516C\u6B63\u7684\u4EF7\u503C\u7406\u5FF5\uFF0C\u5171\u540C\u81F4\u529B\u4E8E\u6784\u5EFA\u4E00\u4E2A\u548C\u8C10\u4E14\u53EF\u6301\u7EED\u53D1\u5C55\u7684\u672A\u6765\u3002\u003C