  "title": "\u201C\u5171\u6816\u201D\uFF1A\u6C14\u5019\u5371\u673A\u4E0B\u7684\u751F\u6001\u827A\u672F\u884C\u52A8\u4EA4\u6D41\u6D3B\u52A8\u5728\u9A6C\u6765\u897F\u4E9A\u542F\u52A8",
  "summary": "6\u670819\u65E5\uFF0C\u7531\u4E2D\u56FD\u6587\u5316\u548C\u65C5\u6E38\u90E8\u56FD\u9645\u4EA4\u6D41\u4E0E\u5408\u4F5C\u5C40\u6307\u5BFC\uFF0C\u4E2D\u5916\u6587\u5316\u4EA4\u6D41\u4E2D\u5FC3\u3001\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u4E0E\u56DB\u5DDD\u7F8E\u672F\u5B66\u9662\u4E3B\u529E\uFF0C\u9A6C\u6765\u897F\u4E9A\u827A\u672F\u5B66\u9662\u4E3A\u5408\u4F5C\u5355\u4F4D\u7684\u201C\u5171\u6816\u201D\uFF1A\u6C14\u5019\u5371\u673A\u4E0B\u7684\u751F\u6001\u827A\u672F\u884C\u52A8\u4EA4\u6D41\u6D3B\u52A8\u5728\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u542F\u52A8\u3002 \u6D3B\u52A8\u5F00\u5E55 \u672C\u6B21\u6D3B\u52A8\u4EE5\u5F71\u50CF\u5C55\u3001\u751F\u6001\u5DE5\u574A\u3001\u5B66\u672F\u8BBA\u575B\u66A8\u7814\u8BA8\u4F1A\u53CA\u827A\u672F\u88C5\u7F6E\u76F8\u7ED3\u5408\u7684\u65B9\u5F0F\uFF0C\u9080\u7EA6\u73AF\u4FDD\u548C\u81EA\u7136\u6559\u80B2\u9886\u57DF\u7684\u5B66\u9662\u3001\u7814\u7A76\u673A\u6784\u3001\u516C\u76CA\u7EC4\u7EC7\u3001\u827A\u672F\u5BB6\u7B49\u76F8\u5173\u4EBA\u5458\u4E0E\u666E\u901A\u516C\u4F17\u4E00\u8D77\u5F00\u5C55\u516C\u5171\u8BA8\u8BBA\uFF0C\u5E76\u901A\u8FC7\u73B0\u573A\u5236\u4F5C\uFF0C\u63A2\u7D22\u672A\u6765\u5728\u5171\u540C\u5408\u4F5C\u4FDD\u62A4\u751F\u7269\u591A\u6837\u6027\u3001\u5E94\u5BF9\u6C14\u5019\u53D8\u5316\u4E0E\u5F00\u5C55\u516C\u4F17\u6559\u80B2\u6D3B\u52A8\u7B49\u65B9\u9762\u7684\u53EF\u80FD\u6027\u3002\u2026",
  "body": "\u003Cp\u003E6\u670819\u65E5\uFF0C\u7531\u4E2D\u56FD\u6587\u5316\u548C\u65C5\u6E38\u90E8\u56FD\u9645\u4EA4\u6D41\u4E0E\u5408\u4F5C\u5C40\u6307\u5BFC\uFF0C\u4E2D\u5916\u6587\u5316\u4EA4\u6D41\u4E2D\u5FC3\u3001\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u4E0E\u56DB\u5DDD\u7F8E\u672F\u5B66\u9662\u4E3B\u529E\uFF0C\u9A6C\u6765\u897F\u4E9A\u827A\u672F\u5B66\u9662\u4E3A\u5408\u4F5C\u5355\u4F4D\u7684\u201C\u5171\u6816\u201D\uFF1A\u6C14\u5019\u5371\u673A\u4E0B\u7684\u751F\u6001\u827A\u672F\u884C\u52A8\u4EA4\u6D41\u6D3B\u52A8\u5728\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u542F\u52A8\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/06/frc-a2028caca999830483292eff874be23b.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u6D3B\u52A8\u5F00\u5E55\u003C/p\u003E\n\u003Cp\u003E\u672C\u6B21\u6D3B\u52A8\u4EE5\u5F71\u50CF\u5C55\u3001\u751F\u6001\u5DE5\u574A\u3001\u5B66\u672F\u8BBA\u575B\u66A8\u7814\u8BA8\u4F1A\u53CA\u827A\u672F\u88C5\u7F6E\u76F8\u7ED3\u5408\u7684\u65B9\u5F0F\uFF0C\u9080\u7EA6\u73AF\u4FDD\u548C\u81EA\u7136\u6559\u80B2\u9886\u57DF\u7684\u5B66\u9662\u3001\u7814\u7A76\u673A\u6784\u3001\u516C\u76CA\u7EC4\u7EC7\u3001\u827A\u672F\u5BB6\u7B49\u76F8\u5173\u4EBA\u5458\u4E0E\u666E\u901A\u516C\u4F17\u4E00\u8D77\u5F00\u5C55\u516C\u5171\u8BA8\u8BBA\uFF0C\u5E76\u901A\u8FC7\u73B0\u573A\u5236\u4F5C\uFF0C\u63A2\u7D22\u672A\u6765\u5728\u5171\u540C\u5408\u4F5C\u4FDD\u62A4\u751F\u7269\u591A\u6837\u6027\u3001\u5E94\u5BF9\u6C14\u5019\u53D8\u5316\u4E0E\u5F00\u5C55\u516C\u4F17\u6559\u80B2\u6D3B\u52A8\u7B49\u65B9\u9762\u7684\u53EF\u80FD\u6027\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/06/frc-5ef147228b20299f28817998c1b3cd78.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u73B0\u573A\u5BFC\u89C8\u003C/p\u003E\n\u003Cp\u003E\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u4E3B\u4EFB\u5F20\u6770\u946B\u3001\u56DB\u5DDD\u7F8E\u672F\u5B66\u9662\u5B9E\u9A8C\u827A\u672F\u5B66\u9662\u9662\u957F\u674E\u5DDD\u3001\u9773\u7ACB\u9E4F\u6559\u6388\u3001\u9A6C\u6765\u897F\u4E9A\u827A\u672F\u5B66\u9662\u7F8E\u672F\u7CFB\u4E3B\u4EFB\u5218\u6E05\u534E\u3001\u9A6C\u6765\u897F\u4E9A\u591A\u5A92\u4F53\u5927\u5B66\u521B\u610F\u5A92\u4F53\u5B66\u9662\u53F6\u7ECD\u658C\u7B49\u827A\u672F\u754C\u548C\u5F53\u5730\u5B66\u751F\u4EE3\u8868\u7B49\u8FD180\u4EBA\u53C2\u52A0\u542F\u52A8\u4EEA\u5F0F\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/06/frc-a44e2d48cafe4dfb99b9b6d5972f39bb.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u73B0\u573A\u5BFC\u89C8\u003C/p\u003E\n\u003Cp\u003E\u5F20\u6770\u946B\u8868\u793A\uFF0C\u4ECA\u5E74\u662F\u4E2D\u9A6C\u5EFA\u4EA450\u5468\u5E74\u548C\u4E2D\u9A6C\u53CB\u597D\u5E74\uFF0C\u672C\u6B21\u6D3B\u52A8\u7684\u4E3E\u529E\u9002\u9022\u674E\u5F3A\u603B\u7406\u8BBF\u9A6C\uFF0C\u4E3A\u4E2D\u9A6C\u4E24\u56FD50\u5E74\u6DF1\u539A\u53CB\u8C0A\u589E\u6DFB\u4E86\u65B0\u7684\u52A9\u529B\u3002\u827A\u672F\u4EA4\u6D41\u662F\u63A8\u52A8\u53EF\u6301\u7EED\u53D1\u5C55\u7684\u91CD\u8981\u9014\u5F84\u3002\u4E2D\u9A6C\u4E24\u56FD\u5728\u751F\u6001\u73AF\u4FDD\u9886\u57DF\u6709\u5E7F\u6CDB\u5171\u540C\u5229\u76CA\uFF0C\u5408\u4F5C\u6F5C\u529B\u5DE8\u5927\u3002\u672C\u6B21\u6D3B\u52A8\u5C55\u793A\u4E86\u4E2D\u56FD\u5728\u751F\u6001\u827A\u672F\u884C\u52A8\u65B9\u9762\u7684\u6210\u679C\u548C\u601D\u8003\uFF0C\u4E5F\u4E3A\u4E2D\u9A6C\u6587\u5316\u4EA4\u6D41\u6253\u5F00\u4E86\u4E00\u6247\u65B0\u7684\u7A97\u53E3\u3002\u003C/p\u003E\n\u003Cp\u003E\u674E\u5DDD\u8868\u793A\uFF0C\u672C\u6B21\u6D3B\u52A8\u65E8\u5728\u901A\u8FC7\u5B66\u672F\u4EA4\u6D41\u548C\u827A\u672F\u521B\u4F5C\uFF0C\u6DF1\u5165\u63A8\u52A8\u53CC\u65B9\u5728\u751F\u6001\u827A\u672F\u65B9\u9762\u7684\u5408\u4F5C\u3002\u5E0C\u671B\u901A\u8FC7\u5F7C\u6B64\u5B66\u4E60\u548C\u4EA4\u6D41\uFF0C\u589E\u8FDB\u4E0D\u540C\u6587\u5316\u4E4B\u95F4\u7684\u7406\u89E3\u548C\u5C0A\u91CD\uFF0C\u540C\u65F6\u5524\u8D77\u66F4\u591A\u4EBA\u5BF9\u73AF\u5883\u95EE\u9898\u7684\u5173\u6CE8\u548C\u884C\u52A8\u610F\u8BC6\uFF0C\u5B9E\u73B0\u6587\u660E\u4E92\u9274\uFF0C\u66F4\u597D\u5730\u4E86\u89E3\u5F7C\u6B64\u7684\u6587\u5316\u548C\u4EF7\u503C\u89C2\u3002\u003C/p\u003E\n\u003Cp\u003E\u5218\u6E05\u534E\u4EE3\u8868\u9A6C\u6765\u897F\u4E9A\u827A\u672F\u5B66\u9662\u9662\u957F\u9A86\u4E3D\u82B3\u81F4\u8F9E\u8868\u793A\uFF0C\u5927\u5B66\u548C\u6559\u80B2\u673A\u6784\u5728\u89E3\u51B3\u73AF\u5883\u95EE\u9898\u4E0A\u53D1\u6325\u7740\u4E0D\u53EF\u6216\u7F3A\u7684\u4F5C\u7528\u3002\u901A\u8FC7\u8DE8\u5B66\u79D1\u7814\u7A76\uFF0C\u5927\u5B66\u53EF\u4EE5\u5F00\u53D1\u51FA\u5B9E\u7528\u4E14\u53EF\u6301\u7EED\u7684\u6280\u672F\u5E76\u52A0\u4EE5\u5B9E\u65BD\u3002\u5E0C\u671B\u66F4\u591A\u5927\u5B66\u548C\u516C\u53F8\u80FD\u591F\u6295\u8D44\u7EFF\u8272\u6280\u672F\uFF0C\u63A8\u5E7F\u53EF\u6301\u7EED\u5B9E\u8DF5\uFF0C\u652F\u6301\u73AF\u5883\u7814\u7A76\u9879\u76EE\uFF0C\u5171\u540C\u5EFA\u8BBE\u53EF\u6301\u7EED\u672A\u6765\u3002\u003C/p\u003E\n\u003Cp\u003E\u53F6\u7ECD\u658C\u8868\u793A\uFF0C\u6B64\u6B21\u5C55\u89C8\u4ECE\u5B8F\u89C2\u3001\u4E2D\u89C2\u548C\u5FAE\u89C2\u4E09\u4E2A\u89D2\u5EA6\u51FA\u53D1\uFF0C\u5C55\u793A\u4E86\u5728\u6587\u5316\u827A\u672F\u4E0E\u751F\u6001\u827A\u672F\u521B\u4F5C\u9886\u57DF\u7684\u6301\u7EED\u52AA\u529B\uFF0C\u6DF1\u5165\u63A2\u8BA8\u5E76\u5173\u6CE8\u73AF\u5883\u8BAE\u9898\u3002\u5E0C\u671B\u8FD9\u4E9B\u72EC\u7279\u7684\u827A\u672F\u4F5C\u54C1\u80FD\u591F\u5F15\u53D1\u793E\u4F1A\u5BF9\u73AF\u5883\u4FDD\u62A4\u7684\u601D\u8003\u4E0E\u5171\u9E23\uFF0C\u5171\u540C\u4E3A\u751F\u6001\u53EF\u6301\u7EED\u53D1\u5C55\u505A\u51FA\u79EF\u6781\u8D21\u732E\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/06/frc-6c2674fe25b6205c8f5c6d3fb950018b.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u6444\u5F71/\u4E92\u52A8\u88C5\u7F6E\u300A\u62C2\u8FC7\u300B \u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/06/frc-71fd9a1221084e6425c33c0c4af93b93.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5609\u5BBE\u4E0E\u827A\u672F\u5BB6\u5408\u5F71\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/06/frc-5f27de05047ca98be0d64e7702717f30.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u68D5\u6988\u6CB9Mapping\u4E0E\u5E9F\u6CB9\u7682\u5236\u4F5C\u751F\u6001\u827A\u672F\u5DE5\u574A\u4E8E20\u65E5\u4E0A\u5348\u5728\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u4E3E\u529E\u003C/p\u003E\n\u003Cp\u003E\u672C\u6B21\u542F\u52A8\u4EEA\u5F0F\u5171\u5C55\u51FA\u6765\u81EA\u4E2D\u9A6C\u4E24\u56FD10\u591A\u540D\u827A\u672F\u5BB6\u768416\u7EC4\u4F5C\u54C1\uFF0C\u901A\u8FC7\u7A7A\u95F4\u548C\u5F71\u50CF\u88C5\u7F6E\u8BE0\u91CA\u5171\u5EFA\u4E00\u4E2A\u548C\u8C10\u5171\u751F\u7684\u7EFF\u8272\u5730\u7403\u7684\u7406\u5FF5\uFF0C\u63A2\u8BA8\u4E86\u5728\u5168\u7403\u5316\u80CC\u666F\u4E0B\u5982\u4F55\u901A\u8FC7\u8BD7\u610F\u5EFA\u6784\u7684\u884C\u52A8\u53BB\u79EF\u6781\u4FEE\u590D\u6211\u4EEC\u7684\u5BB6\u56ED\u4E0E\u5FC3\u7075\uFF0C\u63D0\u4F9B\u4E86\u4E00\u4E2A\u4E86\u89E3\u56FD\u9645\u751F\u6001\u827A\u672F\u7684\u8054\u7ED3\u3001\u5F00\u653E\u4E0E\u8DE8\u57DF\u5B9E\u8DF5\u7684\u7A97\u53E3\u3002\u003C/p\u003E\n\u003Cp\u003E\u66F4\u591A\u7CBE\u5F69\uFF0C\u656C\u8BF7\u5173\u6CE8\uFF1A\u003C/p\u003E\n\u003Cp\u003E\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5B98\u7F51\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003Ehttps://www.chinaculturalcentre.my\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EFacebook\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u201CChina Cultural Centre in Kuala Lumpur\u201D\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u516C\u4F17\u53F7\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u201C\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u201D\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EYoutube\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u201CChina Cultural Centre in Kuala Lumpur\u201D\u003C/p\u00