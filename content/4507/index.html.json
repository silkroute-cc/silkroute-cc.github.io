{
  "id": "%e5%a5%87%e7%91%9e%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e9%9a%86%e9%87%8d%e5%8f%91%e5%b8%83%e9%a6%96%e6%ac%be%e7%94%b5%e5%8a%a8%e6%b1%bd%e8%bd%a6omodae5",
  "slug": "%e5%a5%87%e7%91%9e%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e9%9a%86%e9%87%8d%e5%8f%91%e5%b8%83%e9%a6%96%e6%ac%be%e7%94%b5%e5%8a%a8%e6%b1%bd%e8%bd%a6omodae5",
  "canonicalUrlKey": "%e5%a5%87%e7%91%9e%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e9%9a%86%e9%87%8d%e5%8f%91%e5%b8%83%e9%a6%96%e6%ac%be%e7%94%b5%e5%8a%a8%e6%b1%bd%e8%bd%a6omodae5",
  "route": "/4507/",
  "title": "\u5947\u745E\u9A6C\u6765\u897F\u4E9A\u9686\u91CD\u53D1\u5E03\u9996\u6B3E\u7535\u52A8\u6C7D\u8F66OMODAE5",
  "summary": "(\u5409\u9686\u57617\u65E5)\u5947\u745E\u9A6C\u6765\u897F\u4E9A\u81EA\u8C6A\u5730\u5728\u5927\u9A6C\u63A8\u51FA\u9996\u6B3E\u7535\u52A8\u6C7D\u8F66OMODA E5\uFF0C\u8BE5\u8F66\u5C06\u589E\u5F3A\u9A6C\u6765\u897F\u4E9A\u7684\u7EFF\u8272\u51FA\u884C\uFF0C\u5E76\u4E3A\u9A6C\u6765\u897F\u4E9A\u6D88\u8D39\u8005\u63D0\u4F9B\u5B89\u5168\u7684\u65C5\u884C\u4F53\u9A8C\u3002 OMODA E5 \u4E0D\u4EC5\u4EC5\u662F\u4E00\u8F86\u7535\u52A8\u6C7D\u8F66\uFF1B\u5B83\u8C61\u5F81\u8457\u5947\u745E\u5BF9\u53EF\u6301\u7EED\u53D1\u5C55\u548C\u521B\u65B0\u7684\u627F\u8BFA\u3002\u51ED\u501F\u5176\u5148\u8FDB\u7684\u529F\u80FD\u548C\u5C16\u7AEF\u6280\u672F\uFF0COMODA E5 \u5C06\u5F7B\u5E95\u6539\u53D8\u9A6C\u6765\u897F\u4E9A\u4EBA\u5BF9\u4EA4\u901A\u7684\u770B\u6CD5\u3002 \u5947\u745E\u9A6C\u6765\u897F\u4E9A\u6267\u884C\u526F\u603B\u88C1\u9648\u521A\u8868\u793A\uFF1A\u201C\u6211\u4EEC\u5F88\u9AD8\u5174\u5C06 OMODA E5 \u5F15\u5165\u9A6C\u6765\u897F\u4E9A\u5E02\u573A\uFF0COMODA E5 \u4EE3\u8868\u8457\u6211\u4EEC\u5728\u63D0\u4F9B\u53EF\u6301\u7EED\u51FA\u884C\u89E3\u51B3\u65B9\u6848\u7684\u4F7F\u547D\u4E2D\u5411\u524D\u8FC8\u51FA\u4E86\u91CD\u8981\u4E00\u6B65\u3002\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/03/frc-d3cde4329e24b1f0a31c50b742a79826.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E(\u5409\u9686\u57617\u65E5)\u5947\u745E\u9A6C\u6765\u897F\u4E9A\u81EA\u8C6A\u5730\u5728\u5927\u9A6C\u63A8\u51FA\u9996\u6B3E\u7535\u52A8\u6C7D\u8F66OMODA E5\uFF0C\u8BE5\u8F66\u5C06\u589E\u5F3A\u9A6C\u6765\u897F\u4E9A\u7684\u7EFF\u8272\u51FA\u884C\uFF0C\u5E76\u4E3A\u9A6C\u6765\u897F\u4E9A\u6D88\u8D39\u8005\u63D0\u4F9B\u5B89\u5168\u7684\u65C5\u884C\u4F53\u9A8C\u3002\u003C/p\u003E\n\u003Cp\u003EOMODA E5 \u4E0D\u4EC5\u4EC5\u662F\u4E00\u8F86\u7535\u52A8\u6C7D\u8F66\uFF1B\u5B83\u8C61\u5F81\u8457\u5947\u745E\u5BF9\u53EF\u6301\u7EED\u53D1\u5C55\u548C\u521B\u65B0\u7684\u627F\u8BFA\u3002\u51ED\u501F\u5176\u5148\u8FDB\u7684\u529F\u80FD\u548C\u5C16\u7AEF\u6280\u672F\uFF0COMODA E5 \u5C06\u5F7B\u5E95\u6539\u53D8\u9A6C\u6765\u897F\u4E9A\u4EBA\u5BF9\u4EA4\u901A\u7684\u770B\u6CD5\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/03/frc-67512c8dfb2fafd8f4a87281a4fa7848.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5947\u745E\u9A6C\u6765\u897F\u4E9A\u6267\u884C\u526F\u603B\u88C1\u9648\u521A\u8868\u793A\uFF1A\u201C\u6211\u4EEC\u5F88\u9AD8\u5174\u5C06 OMODA E5 \u5F15\u5165\u9A6C\u6765\u897F\u4E9A\u5E02\u573A\uFF0COMODA E5 \u4EE3\u8868\u8457\u6211\u4EEC\u5728\u63D0\u4F9B\u53EF\u6301\u7EED\u51FA\u884C\u89E3\u51B3\u65B9\u6848\u7684\u4F7F\u547D\u4E2D\u5411\u524D\u8FC8\u51FA\u4E86\u91CD\u8981\u4E00\u6B65\u3002\u6211\u4EEC\u76F8\u4FE1\uFF0COMODA E5 \u4E0D\u4EC5\u4F1A\u6EE1\u8DB3\u751A\u81F3\u8D85\u8D8A\u9A6C\u6765\u897F\u4E9A\u6D88\u8D39\u8005\u7684\u671F\u671B\uFF0C\u6216\u8BB8\u8FD8\u4F1A\u4E3A\u7EFF\u8272\u51FA\u884C\u5236\u5B9A\u65B0\u6807\u51C6\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u9648\u521A\u8865\u5145\u9053\uFF0COMODA E5\u5C06\u662F\u7B2C\u4E00\u6B3E\u5728\u9A6C\u6765\u897F\u4E9A\u7EC4\u88C5\u7684\u4E2D\u56FD\u7535\u52A8\u6C7D\u8F66\u3002\u201C\u901A\u8FC7\u5728\u9A6C\u6765\u897F\u4E9A\u7EC4\u88C5\u6C7D\u8F66\uFF0C\u5947\u745E\u5C06\u80FD\u591F\u521B\u9020\u66F4\u591A\u5C31\u4E1A\u673A\u4F1A\u5E76\u8FDB\u4E00\u6B65\u63A8\u52A8\u5F53\u5730\u7ECF\u6D4E\u3002\u8FD9\u4E00\u4E3E\u63AA\u7B26\u5408\u653F\u5E9C\u7684\u672C\u5730\u5316\u5408\u89C4\u653F\u7B56\uFF0C\u5E76\u5C06\u5E2E\u52A9\u9A6C\u6765\u897F\u4E9A\u6210\u4E3A\u8BE5\u5730\u533A\u7684\u7535\u52A8\u6C7D\u8F66\u4E2D\u5FC3\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u5947\u745E OMODA E5 \u53D1\u5E03\u4F1A\u7531\u9A6C\u6765\u897F\u4E9A\u526F\u9996\u76F8\u62FF\u7763\u65AF\u91CC\u6CD5\u8FEA\u62C9\u5C24\u7D22\u592B\u548C\u4E2D\u534E\u4EBA\u6C11\u5171\u548C\u56FD\u9A7B\u9A6C\u6765\u897F\u4E9A\u7279\u547D\u5168\u6743\u5927\u4F7F\u6B27\u9633\u7389\u9756\u5148\u751F\u4E3B\u6301\u3002\u003C/p\u003E\n\u003Cp\u003E\u6D3B\u52A8\u671F\u95F4\uFF0C\u5947\u745E\u9A6C\u6765\u897F\u4E9A\u6267\u884C\u526F\u603B\u88C1\u9648\u521A\u8FD8\u63ED\u6653\u4E86\u5947\u745E\u9A6C\u6765\u897F\u4E9A\u7684\u73AF\u5883\u3001\u793E\u4F1A\u548C\u6CBB\u7406\uFF08ESG\uFF09\u8BA1\u5212\uFF0C\u65E8\u5728\u4FC3\u8FDB\u53EF\u6301\u7EED\u53D1\u5C55\u5E76\u9F13\u52B1\u5947\u745E\u5728\u9A6C\u6765\u897F\u4E9A\u7684\u5458\u5DE5\u4EE5\u53CA\u7ECF\u9500\u5546\u5408\u4F5C\u4F19\u4F34\u548C\u5229\u76CA\u76F8\u5173\u8005\u91C7\u53D6\u73AF\u4FDD\u6218\u7565\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/03/frc-f7a92ece76bac04b9ca6707b334b6f46.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5947\u745E\u9A6C\u6765\u897F\u4E9A\u4EA7\u54C1\u603B\u76D1 Michael Chew \u5411\u5305\u62EC\u5A92\u4F53\u6210\u5458\u5728\u5185\u7684\u89C2\u4F17\u4ECB\u7ECD\u4E86 OMODA E5\uFF0C\u5F3A\u8C03\u4E86\u8FD9\u6B3E\u7535\u52A8\u6C7D\u8F66\u7684\u4E3B\u8981\u7279\u70B9\u3002\u003C/p\u003E\n\u003Cp\u003E\u4EE5\u4E0B\u662F OMODA E5 \u7684\u4E00\u4E9B\u53EF\u5708\u53EF\u70B9\u7684\u4EAE\u70B9\u529F\u80FD\u3002\u003C/p\u003E\n\u003Cp\u003E\u9AD8\u7EA7\u667A\u80FD\u52A8\u529B\u603B\u6210\u003C/p\u003E\n\u003Cp\u003EOMODA E5 \u51ED\u501F\u5F3A\u5927\u7684\u4E09\u5408\u4E00\u6241\u7EBF\u7535\u673A\u548C\u4E09\u4E2A\u9886\u5148\u7684\u7535\u5B50\u63A7\u5236\u7CFB\u7EDF\u91CD\u65B0\u5B9A\u4E49\u4E86\u9A7E\u9A76\uFF0C\u63D0\u4F9B\u65E0\u4E0E\u4F26\u6BD4\u7684\u529B\u91CF\u548C\u6280\u672F\u878D\u5408\uFF0C\u63D0\u5347\u9A7E\u9A76\u4F53\u9A8C\u3002\u4E09\u79CD\u6280\u672F\u7684\u4F18\u70B9\uFF1B15.5kWh/100km\u8D85\u4F4E\u529F\u8017\uFF0C430km\u8D85\u957F\u7EED\u822A\uFF0C28\u5206\u949F\u6781\u81F4\u5FEB\u514530%\u81F380%\u3002\u003C/p\u003E\n\u003Cp\u003EOMODA E5\u914D\u5907\u4E86\u9AD8\u6548\u7684\u7535\u9A71\u52A8\u7CFB\u7EDF\uFF0C\u4E0D\u4EC5\u53EF\u4EE5\u5B9E\u73B094%\u4EE5\u4E0A\u7684\u7A33\u5B9A\u8F93\u51FA\u529F\u7387\uFF0C\u800C\u4E14\u8FD8\u878D\u5165\u4E86\u9759\u97F3\u8BBE\u8BA1\uFF0C\u663E\u8457\u63D0\u5347\u4E86\u9A7E\u9A76\u4F53\u9A8C\u7684\u8212\u9002\u6027\u3002\u003C/p\u003E\n\u003Cp\u003EOMODA E5\u642D\u8F7D61kWh\u5927\u5BB9\u91CF\u78F7\u9178\u94C1\u9502\u5200\u7247\u7535\u6C60\uFF0C\u786E\u4FDD\u8FDC\u8DDD\u79BB\u5FEB\u901F\u5145\u7535\uFF0C\u540C\u65F6\u589E\u5F3A\u73AF\u4FDD\u6027\u3002\u63D0\u4F9B\u4EE4\u4EBA\u5370\u8C61\u6DF1\u523B\u7684 201 \u9A6C\u529B\u548C 340 \u725B\u7C73\u626D\u77E9\uFF0C\u540C\u65F6\u62E5\u6709\u5353\u8D8A\u7684\u5168\u7403\u7EDF\u4E00\u8F7B\u578B\u8F66\u8F86\u6D4B\u8BD5\u7A0B\u5E8F (WLTP) 430 \u516C\u91CC\u7EED\u822A\u91CC\u7A0B\u3002\u003C/p\u003E\n\u003Cp\u003E\u4EA4\u6D41\u5145\u7535\u529F\u7387\u4E3A 9.9kW\uFF0C\u76F4\u6D41\u5145\u7535\u529F\u7387\u4E3A 80kW\u3002\u5FEB\u901F\u76F4\u6D41\u5145\u7535\u53EA\u9700 28 \u5206\u949F\u5373\u53EF\u5C06\u7535\u6C60\u7535\u91CF\u4ECE 30% \u8865\u5145\u5230 80%\u3002\u7535\u6C60\u5BFF\u547D\u957F\uFF0C\u964D\u4F4E\u4E86\u66F4\u6362\u6210\u672C\uFF0C\u4F53\u73B0\u4E86\u8282\u80FD\u51CF\u6392\u3002\u003C/p\u003E\n\u003Cp\u003E\u901A\u8FC7 OMODA E5 \u7684\u521B\u65B0\u8F66\u8F86\u5230\u8D1F\u8F7D (V2L)\u653E\u7535\u6280\u672F\u4F53\u9A8C\u65B0\u6C34\u5E73\u7684\u591A\u529F\u80FD\u6027\u3002\u8FD9\u4E00\u7A81\u7834\u6027\u529F\u80FD\u53EF\u5C06\u60A8\u7684\u7535\u52A8\u6C7D\u8F66\u8F6C\u53D8\u4E3A\u4FBF\u643A\u5F0F\u7535\u6E90\uFF0C\u975E\u5E38\u9002\u5408\u6237\u5916\u63A2\u9669\u3001\u9732\u8425\u65C5\u884C\u6216\u7D27\u6025\u60C5\u51B5\u3002\u501F\u52A9 V2L\u653E\u7535\u529F\u80FD\uFF0C\u60A8\u53EF\u4EE5\u76F4\u63A5\u4ECE\u8F66\u8F86\u65B9\u4FBF\u5730\u4E3A\u7535\u5B50\u8BBE\u5907\u4F9B\u7535\uFF0C\u4E3A\u60A8\u7684\u5FD9\u788C\u751F\u6D3B\u65B9\u5F0F\u589E\u6DFB\u65B0\u7684\u4FBF\u5229\u6027\u548C\u7075\u6D3B\u6027\u3002\u003C/p\u003E\n\u003Cp\u003E\u98CE\u963B\u7CFB\u6570\uFF0C\u6781\u81F4\u9759\u97F3\uFF0C\u540C\u7EA7\u522B\u7B2C\u4E00\u003C/p\u003E\n\u003Cp\u003E\u65C5\u9014\u4E2D\u4EAB\u53D7\u5B8C\u7F8E\u7684\u5B89\u9759\uFF0C\u5728 120 \u516C\u91CC/\u5C0F\u65F6\u65F6\u6D4B\u5F97\u7684\u98CE\u566A\u58F0\u4F4E\u81F3\u60CA\u4EBA\u7684 62.9 \u5206\u8D1D\uFF0C\u8BA9\u60A8\u4E0E\u5468\u56F4\u7684\u4E16\u754C\u548C\u5E73\u548C\u8C10\u5730\u4EAB\u53D7\u6BCF\u4E00\u6B21\u65C5\u7A0B\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E2D\u63A7\u53F0\u521B\u65B0\u50A8\u7269\u51B7\u5374\u5BA4\u003C/p\u003E\n\u003Cp\u003E\u5C45\u4F4F\u5728\u6E29\u6696\u6F6E\u6E7F\u7684\u6C14\u5019\u4E2D\uFF0C\u9700\u8981\u968F\u65F6\u968F\u5730\u996E\u7528\u6E05\u51C9\u996E\u6599\u3002OMODA E5 \u7684\u521B\u65B0\u51B7\u5374\u50A8\u85CF\u5BA4\u8D85\u51FA\u4E86\u6807\u51C6\u529F\u80FD\uFF0C\u53EF\u786E\u4FDD\u60A8\u5728\u65C5\u9014\u4E2D\u7269\u54C1\u4FDD\u6301\u6E05\u723D\u51C9\u723D\u3002\u003C/p\u003E\n\u003Cp\u003E\u5B89\u5168\u548C\u9AD8\u7EA7\u9A7E\u9A76\u8F85\u52A9\u7CFB\u7EDF\u003C/p\u003E\n\u003Cp\u003E\u5B89\u5168\u662FOMODA E5\u7684\u91CD\u4E2D\u4E4B\u91CD\uFF0C\u5B83\u914D\u5907\u4E86\u6700\u65B0\u4E00\u4EE3\u9AD8\u7EA7\u9A7E\u9A76\u8F85\u52A9\u7CFB\u7EDF2.5\uFF08ADAS 2.5\uFF09\u7CFB\u7EDF\u3002\u5B83\u96C6\u6210\u4E86\u5148\u8FDB\u7684\u4F20\u611F\u5668\u3001\u4EBA\u5DE5\u667A\u80FD\u548C\u8FDE\u63A5\u529F\u80FD\uFF0C\u91CD\u65B0\u5B9A\u4E49\u4E86\u9A7E\u9A76\u4F53\u9A8C\uFF0C\u5E76\u4EE5 17 \u9879\u529F\u80FD\u4E3A\u7535\u52A8\u6C7D\u8F66\u5E02\u573A\u7684\u9AD8\u7EA7\u9A7E\u9A76\u8F85\u52A9\u7CFB\u7EDF\u5EFA\u7ACB\u4E86\u65B0\u6807\u51C6\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/03/frc-46b841e529af17fc2f494b79d8457ff1.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u667A\u80FD\u8FDE\u63A5\u548C\u5A31\u4E50\u4EA4\u4E92\u4F53\u9A8C\u003C/p\u003E\n\u003Cp\u003E\u667A\u80FD\u5EA7\u8231\u662F\u4E00\u9879\u91CD\u5927\u521B\u65B0\uFF0C\u91C7\u7528\u9AD8\u901A8155\u82AF\u7247\u5B9E\u73B0\u65E0\u7F1D\u4EBA\u8F66\u4EA4\u4E92\uFF0C\u8F85\u4EE524.6\u82F1\u540B\u66F2\u97622K\u9AD8\u6E05\u53CC\u5C4F\uFF0C\u5E26\u6765\u6C89\u6D78\u5F0F\u89C6\u89C9\u4F53\u9A8C\u3002\u003C/p\u003E\n\u003Cp\u003EOMODA E5 \u7684\u5185\u9970\u6C1B\u56F4\u706F\u53EF\u91C7\u7528 64\u8272\u8FDB\u884C\u72EC\u7279\u5B9A\u5236\uFF0C\u8FDB\u4E00\u6B65\u589E\u5F3A\u5176\u4F18\u96C5\u7684\u8BBE\u8BA1\u3002\u9AD8\u7EA7Sony \u97F3\u54CD\u8FDB\u4E00\u6B65\u589E\u5F3A\u4E86\u97F3\u4E50\u4EAB\u53D7\u003C/p\u003E\n\u003Cp\u003E\u97F3\u54CD\u7CFB\u7EDF\u8F85\u4EE5\u52A8\u6001\u73AF\u5883\u7167\u660E\uFF0C\u53EF\u6253\u9020\u9AD8\u5EA6\u53EF\u5B9A\u5236\u7684\u89C6\u542C\u4F53\u9A8C\uFF0C\u975E\u5E38\u9002\u5408\u767D\u5929\u548C\u591C\u95F4\u9A7E\u9A76\u3002\u003C/p\u003E\n\u003Cp\u003E\u5728\u65C5\u9014\u4E2D\u4FDD\u6301\u8054\u7CFB\u81F3\u5173\u91CD\u8981\u3002OMODA E5 \u914D\u5907\u7684\u8F66\u8F7D\u65E0\u7EBF 50W \u5145\u7535\u5668\u53EF\u786E\u4FDD\u60A8\u7684\u624B\u673A\u5FEB\u901F\u5145\u7535\uFF0C\u5176\u4E3B\u52A8\u51B7\u5374\u7CFB\u7EDF\u53EF\u6709\u6548\u964D\u4F4E\u65E0\u7EBF\u5145\u7535\u8FC7\u7A0B\u4E2D\u624B\u673A\u7684\u6E29\u5EA6\u3002\u003C/p\u003E\n\u003Cp\u003E\u9AD8\u7EA7\u5185\u9970\uFF0C\u8D85\u5927\u7A7A\u95F4\u003C/p\u003E\n\u003Cp\u003EOMODA E5 \u62E5\u6709\u8C6A\u534E\u5BBD\u655E\u7684\u5185\u9970\uFF0C\u7CBE\u5FC3\u6253\u9020\uFF0C\u8212\u9002\u53C8\u65F6\u5C1A\u3002OMODA E5 \u91C7\u7528\u84DD\u8272\u548C\u767D\u8272\u7C73\u8272\u4EE5\u53CA\u5168\u9ED1\u7684\u4E24\u79CD\u5185\u9970\u7EC4\u5408\uFF0C\u4EE5\u5176\u72EC\u7279\u7684\u4F18\u96C5\u548C\u7CBE\u81F4\u8BA9\u60A8\u7684\u8F66\u8F86\u4E0E\u4F17\u4E0D\u540C\u3002\u8FD9\u79CD\u89C6\u89C9\u4E0A\uFF0C\u76F4\u89C2\u7684\u4E0E\u4F17\u4E0D\u540C\u7684\u7F8E\u611F\uFF0C\u52A0\u4E0A\u9AD8\u54C1\u8D28\u76AE\u9769\u6750\u6599\u7684\u4F7F\u7528\uFF0C\u4E3A\u5185\u9970\u589E\u6DFB\u4E86\u5962\u534E\u611F\uFF0C\u589E\u5F3A\u4E86\u6574\u4F53\u4F53\u9A8C\u3002\u003C/p\u003E\n\u003Cp\u003E\u8F66\u957F4420mm\uFF0C\u8F74\u8DDD2630mm\uFF0C\u4E3A\u4E58\u5BA2\u548C\u8D27\u7269\u63D0\u4F9B\u4E86\u5145\u8DB3\u7684\u7A7A\u95F4\u3002\u5BBD\u655E\u7684 483 \u5347\u884C\u674E\u7BB1\u5BB9\u91CF\u786E\u4FDD\u60A8\u6709\u8DB3\u591F\u7684\u7A7A\u95F4\u5B58\u653E\u6240\u6709\u7269\u54C1\u3002OMODA E5\u9AD8\u5EA61588\u6BEB\u7C73\uFF0C\u79BB\u5730\u95F4\u9699145\u6BEB\u7C73\uFF0C\u5BBD\u5EA61830\u6BEB\u7C73\uFF0C\u5C06\u4F18\u96C5\u4E0E\u5B9E\u7528\u878D\u4E3A\u4E00\u4F53\uFF0C\u8BA9\u6BCF\u4E00\u6B21\u65C5\u7A0B\u90FD\u6210\u4E3A\u6109\u60A6\u7684\u4F53\u9A8C\u3002\u003C/p\u003E\n\u003Cp\u003E\u8D85\u5F3A\u9632\u6C34\u6027\u80FD\u548C\u6781\u81F4\u8010\u7528\u003C/p\u003E\n\u003Cp\u003E\u5947\u745EOMODA E5\u5728\u4E25\u9177\u7684\u6D89\u6C34\u6D4B\u8BD5\u548C\u522E\u5E95\u6D4B\u8BD5\u4E2D\u4E5F\u8868\u73B0\u7684\u76F8\u5F53\u51FA\u8272\uFF0C\u8BC1\u660E\u4E86\u8BE5\u7535\u52A8\u6C7D\u8F66\u80FD\u591F\u4ECE\u5BB9\u5E94\u5BF9\u5404\u79CD\u5730\u5F62\uFF0C\u786E\u4FDD\u53EF\u9760\u3001\u5B89\u5168\u7684\u9A7E\u9A76\u4F53\u9A8C\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E0E\u6B64\u540C\u65F6\uFF0C\u5947\u745E\u9A6C\u6765\u897F\u4E9A\u526F\u603B\u88C1\u674E\u6587\u6E58\u5206\u4EAB\u4E86\u5907\u53D7\u671F\u5F85\u7684\u6709\u5173\u8F66\u8F86\u4EF7\u683C\u7684\u8BE6\u7EC6\u4FE1\u606F\uFF0C\u4EE5\u53CA Chery \u4E3A OMODA E5 \u8F66\u4E3B\u63D0\u4F9B\u7684\u5168\u9762\u914D\u5957\u3002\u5947\u745EOMODA E5\u989C\u8272\u53CA\u5305\u88C5\u003C/p\u003E\n\u003Cp\u003EOMODA E5 \u6709\u6C34\u7EFF\u8272\u3001\u5361\u5176\u767D\u8272\u3001\u5E7B\u5F71\u7070\u8272\u548C\u6DF1\u9ED1\u8272\uFF0C\u552E\u4EF7\u4E3A RM\uFF08\u4EF7\u683C\u5C06\u5728\u53D1\u5E03\u4F1A\u4E0A\u516C\u5E03\uFF09\u3002\u003C/p\u003E\n\u003Cp\u003E\u5947\u745E OMODA E5 \u5957\u88C5\u5305\u62EC\u51FA\u8272\u7684 7 \u5E74\u6216 150,000 \u516C\u91CC\u8F66\u8F86\u4FDD\u4FEE\u3001\u4EE4\u4EBA\u9707\u60CA\u7684 8 \u5E74\u6216 160,000 \u516C\u91CC\u7535\u6C60\u4FDD\u4FEE\uFF0C\u4EE5\u53CA\u540C\u6837\u5F3A\u5927\u7684\u4FDD\u4FEE\u914D\u5957\u670D\u52A1\u003C/p\u003E\n\u003Cp\u003E8 \u5E74\u6216 160,000 \u516C\u91CC\u9A71\u52A8\u5355\u5143\u4FDD\u4FEE, \u5305\u62EC\u52A8\u529B\u7535\u673A\uFF0C\u52A8\u529B\u7535\u673A\u63A7\u5236\u5355\u5143\u3001\u52A8\u529B\u7535\u6C60\u7BA1\u7406\u7CFB\u7EDF\u548C\u8F66\u8F86\u63A7\u5236\u5355\u5143\u5728\u5176\u7EC6\u5206\u5E02\u573A\u4E2D\u5904\u4E8E\u9886\u5148\u5730\u4F4D\u3002\u6B64\u5916\uFF0C\u5947\u745E\u9A6C\u6765\u897F\u4E9A\u4E5F\u63D0\u4F9B\u4E00\u5BF9\u4E00\u670D\u52A1.\u003C/p\u003E\n\u003Cp\u003E\u5728\u4FDD\u4FEE\u671F\u5185\uFF0C\u5982\u679C\u7535\u6C60\u7684\u5065\u5EB7\u72B6\u6001\u4F4E\u4E8E70%\uFF0C\u5C06\u8FDB\u884C\u66F4\u6362\u3002\u003C/p\u003E\n\u003Cp\u003E\u65B0\u6B3EOMODA E5\u7684\u8F66\u4E3B\u5728\u8BBF\u95EE\u5168\u56FD\u4EFB\u4F55\u5947\u745E\u7ECF\u9500\u5E97\u65F6\u8FD8\u5C06\u83B7\u5F97\u514D\u8D39\u5145\u7535\u8BBE\u65BD\u3002\u003C/p\u003E\n\u003Cp\u003E\u524D2000\u540D\u9884\u8BA2\u5C06\u4EAB\u53D7\u514D\u8D39\uFF1A\u003C/p\u003E\n\u003Cp\u003E\u2022 \u58C1\u6302\u5F0F\u5145\u7535\u5668\u003C/p\u003E\n\u003Cp\u003E\u2022 V2L\uFF08\u8F66\u8F86\u5230\u8D1F\u8F7D\uFF09\u653E\u7535\u5145\u7535\u5668\u003C/p\u003E\n\u003Cp\u003E\u2022 EVC \u6F2B\u6E38\u5408\u4F5C\u4F19\u4F34\u4EF7\u503C RM1000 \u7684\u5145\u503C\u79EF\u5206*\u3002\u003C/p\u003E\n\u003Cp\u003E\u5947\u745E\u9A6C\u6765\u897F\u4E9A\u662F\u7B2C\u4E00\u4E2A\u4E0E EVC \u5408\u4F5C\u7684\u54C1\u724C\uFF0CEVC \u662F\u9A6C\u6765\u897F\u4E9A\u53EF\u6301\u7EED\u80FD\u6E