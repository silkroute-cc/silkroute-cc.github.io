{
  "id": "%e9%99%86%e5%85%86%e7%a6%8f%e6%95%b0%e7%99%be%e5%85%ac%e5%8f%b8%e6%9c%89%e5%85%b4%e8%b6%a3-%e6%97%a5%e4%bc%81%e9%80%80%e5%87%ba%e6%97%a0%e7%a2%8d%e9%9a%86%e6%96%b0%e9%ab%98%e9%93%81",
  "slug": "%e9%99%86%e5%85%86%e7%a6%8f%e6%95%b0%e7%99%be%e5%85%ac%e5%8f%b8%e6%9c%89%e5%85%b4%e8%b6%a3-%e6%97%a5%e4%bc%81%e9%80%80%e5%87%ba%e6%97%a0%e7%a2%8d%e9%9a%86%e6%96%b0%e9%ab%98%e9%93%81",
  "canonicalUrlKey": "%e9%99%86%e5%85%86%e7%a6%8f%e6%95%b0%e7%99%be%e5%85%ac%e5%8f%b8%e6%9c%89%e5%85%b4%e8%b6%a3-%e6%97%a5%e4%bc%81%e9%80%80%e5%87%ba%e6%97%a0%e7%a2%8d%e9%9a%86%e6%96%b0%e9%ab%98%e9%93%81",
  "route": "/4370/",
  "title": "\u9646\u5146\u798F:\u6570\u767E\u516C\u53F8\u6709\u5174\u8DA3 \u65E5\u4F01\u9000\u51FA\u65E0\u788D\u9686\u65B0\u9AD8\u94C1",
  "summary": "\uFF08\u5409\u9686\u576113\u65E5\u8BAF\uFF09\u4EA4\u901A\u90E8\u957F\u9646\u5146\u798F\u8BA4\u4E3A\uFF0C\u5373\u4F7F\u65E5\u4F01\u9000\u51FA\u9686\u65B0\u9AD8\u94C1\u5F81\u96C6\u4F01\u5212\u4E66\uFF08RFI\uFF09\u7A0B\u5E8F\uFF0C\u5E76\u4E0D\u4F1A\u5F71\u54CD\u9686\u65B0\u9AD8\u94C1\u8BA1\u5212\uFF0C\u56E0\u4E3A\u8FD8\u6709\u6570\u767E\u5BB6\u516C\u53F8\u5BF9\u8FD9\u4E2A\u8BA1\u5212\u6709\u5174\u8DA3\u3002 \u4ED6\u8BF4\uFF0C\u9686\u65B0\u9AD8\u94C1\u4FE1\u606F\u5F81\u8BE2\u4E66\uFF08RFI\uFF09\u7A0B\u5E8F\u662F\u5F00\u653E\u6027\u7684\uFF0C\u516C\u53F8\u53EF\u4EE5\u81EA\u7531\u9009\u62E9\u662F\u5426\u53C2\u4E0E\u5176\u4E2D\u3002 \u201C\u6211\u4EEC\u4E0D\u4F1A\u56E0\u4E00\u5BB6\u516C\u53F8\u6CA1\u5174\u8DA3\u5C31\u558A\u505C\uFF0C\u8FD8\u6709\u5F88\u591A\u516C\u53F8\u611F\u5174\u8DA3\u3002\u56E0\u6B64\uFF0C\u6CA1\u4EC0\u4E48\u597D\u8BC4\u8BBA\u7684\u3002\u201D \u8BE2\u95EE\u65E5\u8D44\u516C\u53F8\u9000\u51FA\u662F\u5426\u5E26\u6765\u5F71\u54CD\uFF0C\u9646\u5146\u798F\u91CD\u7533\uFF0C\u5E76\u6CA1\u6709\u4EFB\u4F55\u5F71\u54CD\u3002 \u201C\u8FD8\u6709\u5F88\u591A\u4EBA\u611F\u5174\u8DA3\u3002\u6211\u4EEC\u662F\u5F00\u653E\u5F81\u96C6\u4F01\u5212\u4E66\u7684\uFF0C\u4E3A\u4F55\u9700\u8981\u5C31\u6B64\u611F\u5230\u538B\u529B\uFF1F\u53EA\u662F\u4E00\u5BB6\u516C\u53F8\uFF08\u9000\u51FA\uFF09\uFF0C\u53EF\u2026",
  "body": "\u003Cp\u003E\uFF08\u5409\u9686\u576113\u65E5\u8BAF\uFF09\u4EA4\u901A\u90E8\u957F\u9646\u5146\u798F\u8BA4\u4E3A\uFF0C\u5373\u4F7F\u65E5\u4F01\u9000\u51FA\u9686\u65B0\u9AD8\u94C1\u5F81\u96C6\u4F01\u5212\u4E66\uFF08RFI\uFF09\u7A0B\u5E8F\uFF0C\u5E76\u4E0D\u4F1A\u5F71\u54CD\u9686\u65B0\u9AD8\u94C1\u8BA1\u5212\uFF0C\u56E0\u4E3A\u8FD8\u6709\u6570\u767E\u5BB6\u516C\u53F8\u5BF9\u8FD9\u4E2A\u8BA1\u5212\u6709\u5174\u8DA3\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u9686\u65B0\u9AD8\u94C1\u4FE1\u606F\u5F81\u8BE2\u4E66\uFF08RFI\uFF09\u7A0B\u5E8F\u662F\u5F00\u653E\u6027\u7684\uFF0C\u516C\u53F8\u53EF\u4EE5\u81EA\u7531\u9009\u62E9\u662F\u5426\u53C2\u4E0E\u5176\u4E2D\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u4EEC\u4E0D\u4F1A\u56E0\u4E00\u5BB6\u516C\u53F8\u6CA1\u5174\u8DA3\u5C31\u558A\u505C\uFF0C\u8FD8\u6709\u5F88\u591A\u516C\u53F8\u611F\u5174\u8DA3\u3002\u56E0\u6B64\uFF0C\u6CA1\u4EC0\u4E48\u597D\u8BC4\u8BBA\u7684\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u8BE2\u95EE\u65E5\u8D44\u516C\u53F8\u9000\u51FA\u662F\u5426\u5E26\u6765\u5F71\u54CD\uFF0C\u9646\u5146\u798F\u91CD\u7533\uFF0C\u5E76\u6CA1\u6709\u4EFB\u4F55\u5F71\u54CD\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u8FD8\u6709\u5F88\u591A\u4EBA\u611F\u5174\u8DA3\u3002\u6211\u4EEC\u662F\u5F00\u653E\u5F81\u96C6\u4F01\u5212\u4E66\u7684\uFF0C\u4E3A\u4F55\u9700\u8981\u5C31\u6B64\u611F\u5230\u538B\u529B\uFF1F\u53EA\u662F\u4E00\u5BB6\u516C\u53F8\uFF08\u9000\u51FA\uFF09\uFF0C\u53EF\u80FD\u89C9\u5F97\u8FD9\u4E2A\u6A21\u5F0F\u4E0D\u9002\u5408\u4ED6\u4EEC\uFF0C\u4F46\u8FD8\u6709\u6570\u767E\u5BB6\u516C\u53F8\u5BF9\u6B64\u611F\u5174\u8DA3\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u662F\u4ECA\u65E5\u5728\u7535\u52A8\u706B\u8F66\u9ED1\u98CE\u6D1E\u7AD9\u51FA\u5E2D\u5927\u5B9D\u68EE\u8282\u6D3B\u52A8\u540E\u5982\u662F\u6307\u51FA\u3002\u003C/p\u003E\n\u003Cp\u003E\u53E6\u5916\uFF0C\u4ED6\u4E5F\u6F84\u6E05\uFF0C\u73B0\u9636\u6BB5\u5E76\u975E\u7ADE\u6807\u7A0B\u5E8F\uFF0C\u53EA\u662FRFI\u9636\u6BB5\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u5728\u8FD9\u4E2A\u9636\u6BB5\uFF0C\u6709\u5F88\u591A\u516C\u53F8\u8868\u793A\u6709\u5174\u8DA3\uFF0C\u6211\u4EEC\u60F3\u8981\u85C9\u6B64\u77E5\u9053\u4ED6\u4EEC\u7684\u6267\u884C\u65B9\u5F0F\u3002\u636E\u6211\u4E86\u89E3\uFF0C\u6709\u6570\u767E\u5BB6\u516C\u53F8\u63D0\u5448\u4E86\u4F01\u5212\u4E66\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C1\u670815\u65E5\uFF08\u5468\u4E8C\uFF09\u7ED3\u675F\u5F81\u96C6\u4FE1\u606F\u5F81\u8BE2\u4E66\u540E\uFF0C\u653F\u5E9C\u624D\u80FD\u77E5\u9053\u6709\u591A\u5C11\u516C\u53F8\u611F\u5174\u8DA3\uFF0C\u4E4B\u540E\u624D\u8FDB\u884C\u8BC4\u4F30\u3002\u003C/p\u003E\n\u003Cp\u003E\u65E5\u672C\u300A\u5171\u540C\u793E\u300B\u62A5\u9053\uFF0C\u6D88\u606F\u6307\u51FA\uFF0C\u7531\u4E8E\u5927\u9A6C\u653F\u5E9C\u4E0D\u613F\u63D0\u4F9B\u8D22\u52A1\u63F4\u52A9\uFF0C\u53C2\u4E0E\u5EFA\u8BBE\u98CE\u9669\u592A\u9AD8\uFF0C\u65E5\u8D44\u516C\u53F8\u51B3\u5B9A\u9000\u51FA\u53C2\u4E0E\u9686\u65B0\u9AD8\u94C1\u8BA1\u5212\u3002\u003C/p\u003E\n\u003Cp\u003E\u9996\u76F8\u517C\u8D22\u653F\u90E8\u957F\u62FF\u7763\u65AF\u91CC\u5B89\u534E\u6628\u65E5\u4E5F\u8BC1\u5B9E\uFF0C\u65E5\u8D44\u4F01\u4E1A\u5C06\u9000\u51FA\u9686\u65B0\u9AD8\u94C1\u9879\u76EE\u7ADE\u6807\uFF0C\u4ED6\u7B80\u77ED\u56DE\u5E94\u8868\u793A\uFF0C\u81EA\u5DF1\u521A\u6536\u5230\u76F8\u5173\u62A5\u544A\uFF0C\u9700\u8981\u65F6\u95F4\u518D\u505A\u7814\u7A76\u3002\u003C/p\u003E\n\u003Cp\u003E\u300A\u5171\u540C\u793E\u300B\u662F\u5F15\u8FF0\u653F\u5E9C\u53CA\u79C1\u4EBA\u754C\u6D88\u606F\u62A5\u9053\uFF0C\u5305\u62EC\u5E0C\u671B\u80FD\u5C06\u65E5\u672C\u65B0\u5E72\u7EBF\u5B50\u5F39\u5217\u8F66\u7CFB\u7EDF\uFF0C\u8FD0\u7528\u5728\u9686\u65B0\u9AD8\u94C1\u7684\u4E1C\u65E5\u672C\u94C1\u9053\uFF08East Japan Railway Co\uFF09\u5728\u5185\u7684\u65E5\u4F01\uFF0C\u5DF2\u51B3\u5B9A\u9000\u51FA\u7ADE\u6807\uFF0C\u56E0\u8FD9\u4E2A\u9879\u76EE\u7F3A\u4E4F\u653F\u5E9C\u8D22\u52A1\u63F4\u52A9\uFF0C\u98CE\u9669\u76F8\u5BF9\u589E\u52A0\u3002\u003C/p\u003E\n\u003Cp\u003E\u8FD9\u4E2A\u9879\u76EE\u9884\u8BA1\u8017\u8D441000\u4EBF\u4EE4\u5409\uFF0C\u4E0D\u8FC7\u5927\u9A6C\u653F\u5E9C\u8BA1\u5212\u901A\u8FC7\u516C\u79C1\u5408\u8425\uFF0C\u800C\u975E\u653F\u5E9C\u652F\u51FA\u6216\u63D0\u4F9B\u503A\u52A1\u62C5\u4FDD\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u4E2D\u8D44\u516C\u53F8\u6216\u5F97\u5229\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u62A5\u9053\u6307\u51FA\uFF0C\u65E5\u8D44\u516C\u53F8\u64A4\u51FA\u6295\u6807\uFF0C\u6216\u8BA9\u7ADE\u4E89\u7684\u4E2D\u8D44\u516C\u53F8\uFF0C\u8FDB\u4E00\u6B65\u5F3A\u5316\u5728\u4E1C\u4E9A\u7684\u57FA\u7840\u5EFA\u8BBE\u7248\u56FE\uFF0C\u5C24\u5176\u4E2D\u8D44\u4F01\u4E1A\u5DF2\u5728\u53BB\u5E74\u5B8C\u6210\u5728\u5370\u5C3C\u7684\u9AD8\u94C1\u9879\u76EE\uFF0C\u53E6\u5916\u7531\u4E2D\u8D44\u51FA\u8D44\u5EFA\u8BBE\u7684\u5BEE\u56FD\u9AD8\u94C1\u7EBF\u4E5F\u5728\u8FD0\u4F5C\u4E2D\uFF0C\u4E14\u6B63\u7F13\u6162\u8854\u63A5\u81F3\u6CF0\u56FD\u3002\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u65B0\u653F\u5E9C\u662F\u57282013\u5E74\uFF0C\u9488\u5BF9\u5EFA\u8BBE\u9686\u65B0\u9AD8\u94C1\u8FBE\u6210\u521D\u6B65\u534F\u8BAE\uFF0C\u4EE5\u5728\u5409\u9686\u5761\u81F3\u65B0\u52A0\u5761\u4E4B\u95F4\uFF0C\u5EFA\u8BBE\u5168\u957F350\u516C\u91CC\u7684\u9AD8\u94C1\u8F68\u9053\uFF0C\u8FDB\u800C\u7F29\u77ED\u4E24\u5730\u901A\u52E4\u65F6\u95F4\u81F390\u5206\u949F\uFF0C\u76F8\u6BD4\u5F00\u8F66\u5219\u9700\u8D39\u65F6\u903E4\u5C0F\u65F6\u3002\u003C/p\u003E\n\u003Cp\u003E\u5F53\u65F6\uFF0C\u4E1C\u65E5\u672C\u94C1\u9053\u53CA\u65E5\u672C\u4F4F\u53CB\u5546\u4E8B\uFF08Sumitomo Corp\uFF09\uFF0C\u90FD\u8868\u793A\u5BF9\u53C2\u4E0E\u7ADE\u6807\u9686\u65B0\u9AD8\u94C1\u6709\u5174\u8DA3\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E0D\u8FC7\uFF0C\u57FA\u4E8E\u4E0D\u613F\u52A0\u91CD\u653F\u5E9C\u7684\u8D22\u653F\u8D1F\u62C5\uFF0C\u524D\u9996\u76F8\u4E39\u65AF\u91CC\u6155\u5C24\u4E01\u57282021\u5E74\u53D6\u6D88\u8FD9\u9879\u8BA1\u5212\uFF0C\u800C\u73B0\u4EFB\u9996\u76F8\u5B89\u534E\uFF0C\u5219\u5BA3\u5E03\u91CD\u542F\u9686\u65B0\u9AD8\u94C1\u9879\u76EE\uFF0C\u4F46\u5374\u8F6C\u4E3A\u516C\u79C1\u5408\u8425\u6A21\u5F0F\u63A8\u884C\uFF0C\u4EE5\u514D\u8BA9\u653F\u5E9C\u8D22\u52A1\u8D1F\u62C5\u8FC7\u91CD\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/kEmRvWF2ovzkLMg0pVieSA\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
