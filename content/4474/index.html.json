  "title": "\u5E7F\u5DDE\u5E02\u65C5\u6E38\u63A8\u4ECB\u4F1A\u66A82023\u5E74\u4EE3\u7406\u4EBA\u7B54\u8C22\u4F1A\u5728\u5409\u9686\u5761\u4E3E\u884C",
  "summary": "2\u670823\u65E5\uFF0C\u4E2D\u56FD\u5357\u65B9\u822A\u7A7A\u5728\u5409\u9686\u5761\u4E3E\u529E\u5E7F\u5DDE\u5E02\u65C5\u6E38\u63A8\u4ECB\u4F1A\u66A82023\u5E74\u4EE3\u7406\u4EBA\u7B54\u8C22\u4F1A\uFF0C\u4E5F\u662F\u5E7F\u5DDE\u5E02\u65C5\u6E38\u63A8\u5E7F\u4E2D\u5FC3\u7684\u5357\u822A\u5409\u9686\u5761\u8425\u4E1A\u90E8\uFF0C\u5728\u5F53\u5929\u63A8\u5E7F\u5E7F\u5DDE\u65C5\u6E38\u8D44\u6E90\u3001\u57CE\u5E02\u5F62\u8C61\uFF0C\u4EE5\u53CA\u5BF9\u5408\u4F5C\u4EE3\u7406\u4EBA\u57282023\u5E74\u4E2D\u7684\u9F0E\u529B\u652F\u6301\u8868\u793A\u611F\u8C22\u3002 \u9A6C\u6765\u897F\u4E9A\u65C5\u6E38\u4FC3\u8FDB\u5C40\u526F\u4E3B\u5E2D\u62FF\u7763\u6768\u987A\u5174\u3001\u4E2D\u56FD\u5357\u65B9\u822A\u7A7A\u5409\u9686\u5761\u8425\u4E1A\u90E8\u603B\u7ECF\u7406\u738B\u65ED\u3001\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u4E3B\u4EFB\u5F20\u6770\u946B\u3001\u9A6C\u6765\u897F\u4E9A\u534E\u4EBA\u65C5\u6E38\u4E1A\u516C\u4F1A\u603B\u4F1A\u957F\u5305\u4E00\u96C4\u3001\u9A6C\u4E2D\u6C11\u4FD7\u6587\u65C5\u603B\u5546\u4F1A\u603B\u4F1A\u957F\u62FF\u6C40\u65AF\u91CC\u5ED6\u5229\u5973\u7B49100\u4F59\u4F4D\u65C5\u6E38\u4E1A\u8005\u53CA\u5408\u4F5C\u4EE3\u7406\u4EBA\u51FA\u5E2D\u63A8\u4ECB\u4F1A\u66A8\u4EE3\u7406\u4EBA\u7B54\u8C22\u4F1A\u3002 \u738B\u65ED\u603B\u7ECF\u7406\u8868\u793A\uFF0C\u5E7F\u5DDE\u662F\u4E2D\u56FD\u7B2C\u4E09\u5927\u57CE\u5E02\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/02/frc-d8996b0f82e192bf7864c63578b0b56b.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E2\u670823\u65E5\uFF0C\u4E2D\u56FD\u5357\u65B9\u822A\u7A7A\u5728\u5409\u9686\u5761\u4E3E\u529E\u5E7F\u5DDE\u5E02\u65C5\u6E38\u63A8\u4ECB\u4F1A\u66A82023\u5E74\u4EE3\u7406\u4EBA\u7B54\u8C22\u4F1A\uFF0C\u4E5F\u662F\u5E7F\u5DDE\u5E02\u65C5\u6E38\u63A8\u5E7F\u4E2D\u5FC3\u7684\u5357\u822A\u5409\u9686\u5761\u8425\u4E1A\u90E8\uFF0C\u5728\u5F53\u5929\u63A8\u5E7F\u5E7F\u5DDE\u65C5\u6E38\u8D44\u6E90\u3001\u57CE\u5E02\u5F62\u8C61\uFF0C\u4EE5\u53CA\u5BF9\u5408\u4F5C\u4EE3\u7406\u4EBA\u57282023\u5E74\u4E2D\u7684\u9F0E\u529B\u652F\u6301\u8868\u793A\u611F\u8C22\u3002\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38\u4FC3\u8FDB\u5C40\u526F\u4E3B\u5E2D\u62FF\u7763\u6768\u987A\u5174\u3001\u4E2D\u56FD\u5357\u65B9\u822A\u7A7A\u5409\u9686\u5761\u8425\u4E1A\u90E8\u603B\u7ECF\u7406\u738B\u65ED\u3001\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u4E3B\u4EFB\u5F20\u6770\u946B\u3001\u9A6C\u6765\u897F\u4E9A\u534E\u4EBA\u65C5\u6E38\u4E1A\u516C\u4F1A\u603B\u4F1A\u957F\u5305\u4E00\u96C4\u3001\u9A6C\u4E2D\u6C11\u4FD7\u6587\u65C5\u603B\u5546\u4F1A\u603B\u4F1A\u957F\u62FF\u6C40\u65AF\u91CC\u5ED6\u5229\u5973\u7B49100\u4F59\u4F4D\u65C5\u6E38\u4E1A\u8005\u53CA\u5408\u4F5C\u4EE3\u7406\u4EBA\u51FA\u5E2D\u63A8\u4ECB\u4F1A\u66A8\u4EE3\u7406\u4EBA\u7B54\u8C22\u4F1A\u3002\u003C/p\u003E\n\u003Cp\u003E\u738B\u65ED\u603B\u7ECF\u7406\u8868\u793A\uFF0C\u5E7F\u5DDE\u662F\u4E2D\u56FD\u7B2C\u4E09\u5927\u57CE\u5E02\uFF0C\u4E5F\u662F\u5386\u53F2\u60A0\u4E45\u7684\u6587\u5316\u540D\u57CE\uFF0C\u7D20\u6709\u201C\u82B1\u57CE\u201D\u7F8E\u8A89\u3002\u5E7F\u5DDE\u662F\u5CAD\u5357\u6587\u5316\u7684\u4E2D\u5FC3\u5730\uFF0C\u4E5F\u662F\u8457\u540D\u7684\u4FA8\u4E61\uFF0C\u81EA\u53E4\u4EE5\u6765\uFF0C\u5C31\u4E0E\u9A6C\u6765\u897F\u4E9A\u6709\u8457\u7D27\u5BC6\u7684\u8054\u7CFB\uFF0C\u5CAD\u5357\u6587\u5316\u5728\u9A6C\u6765\u897F\u4E9A\u5F97\u5230\u4E86\u5F88\u597D\u7684\u4FDD\u7559\u53CA\u53D1\u5C55\uFF0C\u4E5F\u6307\u51FA\u6587\u5316\u8BA4\u540C\u662F\u4E24\u5730\u5F00\u5C55\u53CC\u5411\u65C5\u6E38\u4EA4\u6D41\u5408\u4F5C\u6700\u5927\u7684\u4F18\u52BF\u548C\u6700\u575A\u5B9E\u7684\u57FA\u7840\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E2D\u56FD\u5357\u65B9\u822A\u7A7A\u603B\u90E8\u8BBE\u5728\u5E7F\u5DDE\uFF0C\u65E9\u57281989\u5E74\u4FBF\u5F00\u901A\u4E86\u4E86\u5E7F\u5DDE\u4E0E\u5409\u9686\u5761\u4E4B\u95F4\u7684\u5F80\u8FD4\u822A\u7EBF \u3002\u5982\u4ECA\u5357\u822A\u4ECE\u5409\u9686\u5761\u3001\u69DF\u57CE\u3001\u6C99\u5DF4\u51FA\u53D1\u98DE\u5F80\u5E7F\u5DDE\u7684\u822A\u73ED\u5DF2\u8FBE\u5230\u6BCF\u546838\u8D9F\uFF0C\u8FD0\u529B\u6062\u590D\u8D85\u8FC7\u4E86\u75AB\u60C5\u524D\u6C34\u5E73\uFF0C2023\u5E74\u627F\u8FD0\u4E2D\u9A6C\u95F4\u7684\u5F80\u8FD4\u65C5\u5BA2\u4EBA\u6570\u8FBE\u5230\u4E8641\u4E07\u4EBA\u6B21\u3002\u5728\u4ECA\u5E74\u8FCE\u6765\u4E86\u4E2D\u9A6C\u5EFA\u4EA450\u5468\u5E74\u4E4B\u9645\uFF0C\u738B\u65ED\u4E5F\u8868\u793A\u4E24\u56FD\u95F4\u7684\u51FA\u884C\u5C06\u9884\u8BA1\u8FCE\u6765\u9AD8\u5CF0\uFF0C\u5357\u822A\u4E5F\u5C06\u8FDB\u4E00\u6B65\u52A0\u5F3A\u4E0E\u65C5\u884C\u793E\u95F4\u7684\u5408\u4F5C\uFF0C\u4E3A\u4FC3\u8FDB\u4E24\u56FD\u7684\u5546\u8D38\u548C\u65C5\u6E38\u53D1\u5C55\u53CA\u4EBA\u6587\u4EA4\u6D41\u4FDD\u9A7E\u62A4\u822A\u3002\u003C/p\u003E\n\u003Cp\u003E\u5F20\u6770\u946B\u4E3B\u4EFB\u8868\u793A\uFF0C\u53D7\u4E92\u514D\u7B7E\u8BC1\u653F\u7B56\u3001\u652F\u4ED8\u4FBF\u5229\u5316\u548C\u56FD\u9645\u822A\u73ED\u589E\u5BC6\u7B49\u5229\u597D\u5F71\u54CD\uFF0C\u52A0\u4E0A\u6587\u5316\u4EA4\u6D41\u548C\u65C5\u6E38\u63A8\u5E7F\u6548\u5E94\u91CA\u653E\uFF0C\u4ECA\u5E74\u6625\u8282\u671F\u95F4\u4E2D\u56FD\u5165\u51FA\u5883\u6E38\u5E02\u573A\u70ED\u5EA6\u6301\u7EED\u9AD8\u6DA8\u3002\u5927\u6570\u636E\u663E\u793A\uFF0C\u9664\u5915\u5F53\u5929\u5165\u5883\u4E2D\u56FD\u7684\u65C5\u5BA2\u8D8560\u4E07\u4EBA\u6B21\uFF0C\u5305\u62EC\u9A6C\u6765\u897F\u4E9A\u5728\u5185\u7684\u65B0\u589E\u514D\u7B7E\u5165\u5883\u4E2D\u56FD\u7684\u56FD\u5BB6\u65C5\u5BA2\u589E\u957F\u660E\u663E\u30022023\u5E74\u5E7F\u5DDE\u63A5\u5F85\u65C5\u5BA2\u8FBE\u5230\u4E862.3\u4EBF\u4EBA\u6B21\u3002\u5E7F\u5DDE\u4F5C\u4E3A\u201C\u6392\u5934\u5175\u201D\uFF0C\u62C9\u5F00\u4E86\u9F99\u5E74\u4E2D\u56FD\u65C5\u6E38\u6D77\u5916\u63A8\u5E7F\u7684\u5E8F\u5E55\uFF0C\u5177\u6709\u975E\u5E38\u7279\u6B8A\u7684\u610F\u4E49\u3002\u003C/p\u003E\n\u003Cp\u003E\u6768\u987A\u5174\u526F\u4E3B\u5E2D\u8868\u793A\uFF0C2023\u5E74\u9A6C\u6765\u897F\u4E9A\u8FCE\u6765\u4E86147\u4E07\u540D\u4E2D\u56FD\u65C5\u5BA2\uFF0C\u76EE\u524D\u9A6C\u6765\u897F\u4E9A\u4E0E\u5E7F\u5DDE\u4E4B\u95F4\u7684\u822A\u73ED\u4E5F\u53D1\u5C55\u5230\u4E86\u6BCF\u546881\u73ED\u3002\u5728\u4E2D\u9A6C\u5EFA\u4EA450\u5468\u5E74\u4E4B\u9645\uFF0C\u4E24\u56FD\u65C5\u6E38\u4E8B\u4E1A\u7684\u53D1\u5C55\u548C\u670D\u52A1\u6C34\u5E73\u7684\u63D0\u9AD8\u5C06\u4F1A\u8FDB\u4E00\u6B65\u4FC3\u8FDB\u53CC\u5411\u65C5\u6E38\u4EBA\u6570\u7684\u589E\u957F\u3002\u003C/p\u003E\n\u003Cp\u003E\u5F53\u665A\u7B54\u8C22\u4F1A\u4E0A\u5357\u822A\u5171\u9881\u51FA32\u4E2A\u5956\u9879\uFF0C\u5BF9\u5176\u4EE3\u7406\u4EBA\u5728\u8FC7\u53BB\u4E00\u5E74\u505A\u51FA\u7684\u8D21\u732E\u8868\u793A\u611F\u8C22\u3002\u003C/p\u003E\n\u003Cp\u003E\u66F4\u591A\u7CBE\u5F69\uFF0C\u656C\u8BF7\u5173\u6CE8\uFF1A\u003C/p\u003E\n\u003Cp\u003E\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5B98\u7F51\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003Ehttps://www.chinaculturalcentre.my\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EFacebook\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u201CChina Cultural Centre in Kuala Lumpur\u201D\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u516C\u4F17\u53F7\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u201C\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u201D\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EYoutube\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u00