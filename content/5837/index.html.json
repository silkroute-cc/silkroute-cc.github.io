ibpNDVB1yfJ6aW1C3t1nS3MWcZkakxVPMB9Gx9nl3CdA9vlBHRZFNCVyH941aeCSQ/640?wx_fmt=png\u0026amp;from=appmsg\u0026amp;tp=webp\u0026amp;wxfrom=5\u0026amp;wx_lazy=1\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u6D3B\u52A83\uFF1A\u201C\u58A8\u6DA6\u6C5F\u6DEE\u0026#183;\u6587\u8109\u65B0\u5B89\u201D\u5B89\u5FBD\u7ED8\u753B\u4F20\u627F\u4E0E\u521B\u65B0\u4E3B\u9898\u4F5C\u54C1\u5C55\u003C/p\u003E\n\u003Cp\u003E\u65E5\u671F\uFF1A2026\u5E742\u67087\u65E5\uFF08\u661F\u671F\u516D\uFF09\u81F33\u67086\u65E5\uFF08\u661F\u671F\u4E94\uFF09\u003C/p\u003E\n\u003Cp\u003E\u65F6\u95F4\uFF1A\u4E0A\u534810\u65F6\u81F3\u4E0B\u53484\u65F6\u003C/p\u003E\n\u003Cp\u003E\u5730\u70B9\uFF1A\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\uFF08\u5468\u65E5\u4E0E\u8282\u5047\u65E5\u95ED\u9986\uFF09\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/sz_mmbiz_jpg/KzZqvMiaRfUyDzuqvPcnofJz0lknq3IOQn3tKn5ibiaaWG5Qb6WENqI3plp5cIZgibZQiaYIss4t5dXpoJLPibjBAhrA/640?wx_fmt=jpeg\u0026amp;from=appmsg\u0026amp;tp=webp\u0026amp;wxfrom=5\u0026amp;wx_lazy=1\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u58A8\u9999\u8FCE\u65B0\u6625\uFF0C\u6587\u8109\u6DA6\u5357\u6D0B\uFF01\u5C55\u89C8\u4EE5\u65B0\u5B89\u753B\u6D3E\u827A\u672F\u7CBE\u795E\u4E3A\u6838\u5FC3\u8109\u7EDC\uFF0C\u835F\u805A\u5B89\u5FBD\u7ECF\u5178\u7ED8\u753B\u590D\u523B\u4F5C\u54C1\u4E0E\u5F53\u4EE3\u521B\u65B0\u4F73\u4F5C\uFF0C\u9898\u6750\u6DB5\u76D6\u6C5F\u6DEE\u5C71\u6C34\u3001\u5FBD\u5DDE\u6C11\u5C45\u3001\u6C11\u4FD7\u98CE\u60C5\u7B49\u591A\u5143\u666F\u81F4\u3002\u7B14\u58A8\u4E4B\u95F4\uFF0C\u5C3D\u663E\u4E2D\u56FD\u6C34\u58A8\u7684\u5BA1\u7F8E\u610F\u5883\u4E0E\u6DF1\u539A\u6587\u5316\u5185\u6DB5\uFF0C\u4E3A\u65B0\u6625\u4F73\u8282\u8425\u9020\u4E00\u65B9\u58A8\u97F5\u60A0\u957F\u3001\u5E74\u5473\u96C5\u81F4\u7684\u6587\u5316\u5929\u5730\uFF0C\u9080\u89C2\u4F17\u6C89\u6D78\u5F0F\u5F9C\u5F89\u4E66\u753B\u4E16\u754C\uFF0C\u611F\u53D7\u4E2D\u534E\u4F20\u7EDF\u7F8E\u5B66\u7684\u72EC\u7279\u9B45\u529B\u3002\u003C/p\u003E\n\u003Cp\u003EThe exhibition focuses on the inheritance and innovation of Anhui painting, displaying classic and contemporary works of the Xin\u0026#39;an School to present the artistic charm of Chinese ink wash painting.\u003C/p\u003E\n\u003Cp\u003E\u6D3B\u52A84\uFF1A\u201C\u6B22\u4E50\u6625\u8282\u201D\u66A8\u201C\u4E00\u8109\u5C90\u9EC4\u201D\u2014\u2014\u534E\u4FA8\u534E\u4EBA\u4E0E\u4E2D\u533B\u836F\u6587\u5316\u5C55\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/sz_mmbiz_jpg/KzZqvMiaRfUyDzuqvPcnofJz0lknq3IOQ3WiavhJcHCqqRIh9OYl4AukYnDXUUEw3OrtRlPjvc4Spo28zhic5M3pw/640?wx_fmt=jpeg\u0026amp;from=appmsg\u0026amp;tp=webp\u0026amp;wxfrom=5\u0026amp;wx_lazy=1\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u7CFB\u5217\u516C\u4F17\u6D3B\u52A8\u65E5\u671F\uFF1A2026\u5E742\u670814\u65E5\u53CA15\u65E5\uFF08\u661F\u671F\u516D\u53CA\u65E5\uFF09\u003C/p\u003E\n\u003Cp\u003E\u7CFB\u5217\u516C\u4F17\u6D3B\u52A8\u65F6\u95F4\uFF1A\u4E2D\u534812\u65F6\u81F3\u4E0B\u53484\u65F6\u003C/p\u003E\n\u003Cp\u003E\u5C55\u89C8\u5C55\u671F\uFF1A\u5373\u65E5\u8D77\u81F32026\u5E743\u67088\u65E5\uFF08\u661F\u671F\u65E5\uFF09\u003C/p\u003E\n\u003Cp\u003E\u5C55\u89C8\u5F00\u653E\u65F6\u95F4\uFF1A\u4E0A\u534810\u65F6\u81F3\u665A\u4E0A10\u65F6\u003C/p\u003E\n\u003Cp\u003E\u5730\u70B9\uFF1A\u6B66\u5409\u52A0\u91CC\u5C14\u67CF\u5A01\u5E74\u5E7F\u573A3\u5C42\u5C55\u5385\u003C/p\u003E\n\u003Cp\u003E\u5C90\u9EC4\u4F20\u96C5\u97F5\uFF0C\u4FA8\u5FC3\u6696\u65B0\u6625\uFF012\u670814-15\u65E5\u65B0\u6625\u516C\u4F17\u4F53\u9A8C\u4E13\u573A\u542F\u5E55\uFF0C\u4EE5\u4E13\u9898\u5C55\u89C8\u3001\u624B\u4F5C\u4E92\u52A8\u3001\u6587\u827A\u6F14\u51FA\u7B49\u5F62\u5F0F\uFF0C\u878D\u5408\u5448\u73B0\u6625\u8282\u56E2\u5706\u4E0E\u4E2D\u533B\u836F\u6587\u5316\u7684\u5343\u5E74\u4F20\u627F\u3002\u5C55\u89C8\u8FFD\u6EAF\u4E2D\u533B\u836F\u53D1\u5C55\u8109\u7EDC\u53CA\u534E\u4FA8\u534E\u4EBA\u95EF\u5357\u6D0B\u3001\u4E2D\u533B\u836F\u6F02\u6D0B\u8FC7\u6D77\u7684\u4F20\u64AD\u5386\u7A0B\uFF1B\u73B0\u573A\u8FD8\u7279\u8BBE\u6C11\u4E50\u6F14\u594F\u3001\u4E2D\u5F0F\u54C1\u8317\u3001\u6325\u6625\u9001\u798F\u3001\u4E2D\u533B\u836F\u517B\u751F\u4F53\u9A8C\u7B49\u6696\u5FC3\u73AF\u8282\uFF0C\u9080\u60A8\u5728\u559C\u5E86\u6C1B\u56F4\u4E2D\u611F\u53D7\u4E2D\u534E\u4F20\u7EDF\u6587\u5316\u7684\u6E29\u6DA6\u529B\u91CF\u3002\u003C/p\u003E\n\u003Cp\u003EThe exhibition displays the inheritance and spread of traditional Chinese medicine culture by overseas Chinese, with a variety of interactive experience activities to enhance Sino-Malaysian cultural identity.\u003C/p\u003E\n\u003Cp\u003E\u6D3B\u52A85\uFF1A\u9A6C\u821E\u65B0\u6625\u2014\u2014\u4E19\u5348\u9A6C\u5E74\u5168\u7403\u751F\u8096\u6587\u5316\u7EBF\u4E0A\u8054\u5C55\u003C/p\u003E\n\u003Cp\u003E\u4E0A\u7EBF\u65E5\u671F\uFF1A2026\u5E742\u670811\u65E5\uFF08\u661F\u671F\u4E09\uFF09\u003C/p\u003E\n\u003Cp\u003E\u5C55\u64AD\u5E73\u53F0\uFF1A\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u5FAE\u4FE1\u516C\u4F17\u53F7 \u0026amp; \u5B98\u65B9\u7F51\u7AD9\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/sz_mmbiz_jpg/KzZqvMiaRfUyDzuqvPcnofJz0lknq3IOQwk4ichnrhmhNv4uLlfic41gYEW0ExH5tN2mNNalobMvgw30lrLYMKhSg/640?wx_fmt=jpeg\u0026amp;from=appmsg\u0026amp;tp=webp\u0026amp;wxfrom=5\u0026amp;wx_lazy=1\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u201C\u9A6C\u821E\u65B0\u6625\u2014\u2014\u4E19\u5348\u9A6C\u5E74\u5168\u7403\u751F\u8096\u6587\u5316\u7EBF\u4E0A\u8054\u5C55\u201D\u7531\u4E2D\u56FD\u6587\u7269\u62A5\u793E\u8054\u5408\u5168\u56FD\u591A\u5BB6\u535A\u7269\u9986\u4E3B\u529E\uFF0C\u4EE5\u751F\u8096\u201C\u9A6C\u201D\u4E3A\u6838\u5FC3\u4E3B\u7EBF\uFF0C\u7CFB\u7EDF\u5448\u73B0\u5176\u5728\u81EA\u7136\u751F\u6001\u3001\u5386\u53F2\u6587\u660E\u3001\u827A\u672F\u521B\u4F5C\u4E0E\u6C11\u4FD7\u751F\u6D3B\u4E2D\u7684\u591A\u91CD\u6587\u5316\u610F\u8C61\u3002\u901A\u8FC7\u6587\u7269\u590D\u5236\u3001\u56FE\u50CF\u5C55\u793A\u4E0E\u5F53\u4EE3\u827A\u672F\u878D\u5408\u7684\u65B9\u5F0F\uFF0C\u8BE0\u91CA\u9A6C\u6240\u627F\u8F7D\u7684\u594B\u8FDB\u3001\u52C7\u6BC5\u3001\u5954\u817E\u4E0D\u606F\u7684\u7CBE\u795E\u5185\u6838\uFF0C\u4EE5\u751F\u8096\u6587\u5316\u4E3A\u6865\uFF0C\u4ECE\u4E1C\u65B9\u89C6\u89D2\u8054\u7ED3\u4E16\u754C\u6587\u660E\uFF0C\u8425\u9020\u517C\u5177\u4E2D\u56FD\u5E74\u5473\u4E0E\u56FD\u9645\u89C6\u91CE\u7684\u8282\u65E5\u6C1B\u56F4\uFF0C\u9080\u6D77\u5185\u5916\u89C2\u4F17\u4E91\u7AEF\u5171\u8D4F\u3002\u003C/p\u003E\n\u003Cp\u003ECo-hosted by multiple cultural institutions, this online exhibition themed on the Chinese zodiac \u0026quot;Horse\u0026quot; shows the cultural connotation of horses and interprets the spirit of forge ahead symbolized by horses.\u003C/p\u003E\n\u003Cp\u003E\u6D3B\u52A86\uFF1A\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC32026\u5E74\u7B2C1\u5B66\u671F\u7CFB\u5217\u827A\u672F\u8BFE\u7A0B\u62DB\u751F\u53CA\u5F00\u8BFE\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/sz_mmbiz_jpg/KzZqvMiaRfUxsYiamWzO4WwGTrJTAzmq3wgpAqxkxKA7SrP59bjFXSPa6j0lCJf5HEwJgzRaEfDTutH4puaPGODw/640?wx_fmt=jpeg\u0026amp;from=appmsg\u0026amp;tp=webp\u0026amp;wxfrom=5\u0026amp;wx_lazy=1\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u8BE6\u60C5\u67E5\u8BE2\uFF1Ahttps://www.chinaculturalcentre.my/courses/\u003C/p\u003E\n\u003Cp\u003E\u65B0\u5C81\u4E60\u827A\uFF0C\u58A8\u97F5\u7434\u58F0\u4F34\u65B0\u6625\uFF01\u672C\u6B21\u8BFE\u7A0B\u4EE5\u201C\u65B0\u5C81\u0026#183;\u827A\u672F\u6B63\u5F53\u65F6\u201D\u4E3A\u4E3B\u9898\uFF0C\u5F00\u8BBE\u53E4\u7B5D\u3001\u56F4\u68CB\u3001\u5F69\u58A8\u753B\u3001\u6C34\u58A8\u753B\u3001\u4E66\u6CD5\u3001\u5DE5\u7B14\u753B\u516D\u5927\u7ECF\u5178\u4E2D\u534E\u827A\u672F\u8BFE\u7A0B\uFF0C\u8BFE\u7A0B\u8BBE\u7F6E\u517C\u987E\u96F6\u57FA\u7840\u5165\u95E8\u8005\u4E0E\u8D44\u6DF1\u827A\u672F\u7231\u597D\u8005\uFF0C\u9002\u914D\u4E0D\u540C\u5B66\u4E60\u9700\u6C42\u3002\u8BA9\u6307\u5C16\u7684\u7434\u58F0\u3001\u68CB\u76D8\u7684\u667A\u6167\u3001\u7B14\u58A8\u7684\u8272\u5F69\uFF0C\u4E3A\u65B0\u5E74\u6DFB\u4E00\u62B9\u96C5\u81F4\u6587\u5316\u5E95\u8272\uFF0C\u9080\u60A8\u5728\u6162\u54C1\u827A\u672F\u7684\u8FC7\u7A0B\u4E2D\uFF0C\u611F\u53D7\u4E2D\u534E\u4F20\u7EDF\u7F8E\u5B66\u7684\u72EC\u7279\u9B45\u529B\uFF0C\u9082\u9005\u9759\u5FC3\u521B\u4F5C\u7684\u7F8E\u597D\u65F6\u5149\u3002\u003C/p\u003E\n\u003Cp\u003EThe 2026 Spring semester art courses of China Cultural Centre in Kuala Lumpur cover six classic Chinese art categories, suitable for both beginners and advanced learners to study.\u003C/p\u003E\n\u003Cp\u003E\u6D3B\u52A87\uFF1A2026\u201C\u4F60\u597D\uFF01\u4E2D\u56FD\u201D\u51AC\u5B63\u5165\u5883\u65C5\u6E38\u63A8\u5E7F\u5B63\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/sz_mmbiz_jpg/KzZqvMiaRfUxe9Hc0pu8Sp7ibpNDVB1yfJmrypy8ooE67FFtf8tQGE2oj6u283gssVTvXq6jf8ibGI7Pe6QaFlS7g/640?wx_fmt=jpeg\u0026amp;from=appmsg\u0026amp;tp=webp\u0026amp;wxfrom=5\u0026amp;wx_lazy=1\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/sz_mmbiz_jpg/KzZqvMiaRfUyDzuqvPcnofJz0lknq3IOQdN4cRRNyGRj9UkfNWSXy78ewWWr2zE5QkZRy02HibZpj9hntbQvzNTA/640?wx_fmt=jpeg\u0026amp;from=appmsg\u0026amp;tp=webp\u0026amp;wxfrom=5\u0026amp;wx_lazy=1\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u65E5\u671F\uFF1A2026\u5E741\u6708\u81F34\u6708\u003C/p\u003E\n\u003Cp\u003E\u5E73\u53F0\uFF1A\u7EBF\u4E0A\u7EBF\u4E0B\u7ED3\u5408\u003C/p\u003E\n\u003Cp\u003E\u4E3A\u5145\u5206\u53D1\u6325\u4E2D\u56FD\u51B0\u96EA\u65C5\u6E38\u8D44\u6E90\u4F18\u52BF\uFF0C\u52A9\u529B\u7EFF\u8272\u53D1\u5C55\u4E0E\u9AD8\u8D28\u91CF\u53D1\u5C55\uFF0C\u4F9D\u6258\u5165\u5883\u65C5\u6E38\u4FBF\u5229\u5316\u53CA\u514D\u7B7E\u653F\u7B56\u7EA2\u5229\uFF0C\u5168\u9762\u5C55\u793A\u4E2D\u56FD\u7279\u8272\u51AC\u5B63\u65C5\u6E38\u8D44\u6E90\u4E0E\u6587\u5316\u5185\u6DB5\uFF0C\u62DF\u56F4\u7ED5\u201C\u4F60\u597D\uFF01\u4E2D\u56FD\u201D\u54C1\u724C\u4E3B\u7EBF\uFF0C\u4EE5\u51AC\u5B63\u65C5\u6E38\u4E3A\u6838\u5FC3\u4E3B\u9898\uFF0C\u7ED3\u5408\u9A6C\u6765\u897F\u4E9A\u548C\u5370\u5EA6\u5C3C\u897F\u4E9A\u5E02\u573A\u7279\u70B9\uFF0C\u91C7\u53D6\u7EBF\u4E0A\u7EBF\u4E0B\u76F8\u7ED3\u5408\u7684\u65B9\u5F0F\uFF0C\u5206\u9636\u6BB5\u3001\u5206\u91CD\u70B9\u63A8\u51FA\u7CFB\u5217\u51B0\u96EA\u65C5\u6E38\u4E3B\u9898\u5185\u5BB9\u4E0E\u63A8\u5E7F\u6D3B\u52A8\uFF0C\u5F62\u6210\u6301\u7EED\u7A33\u5B9A\u7684\u4F20\u64AD\u6548\u5E94\u4E0E\u6709\u6548\u5E02\u573A\u8F6C\u5316\u3002\u003C/p\u003E\n\u003Cp\u003E\u540C\u65F6\uFF0C\u7ED3\u5408\u201C\u6B22\u4E50\u6625\u8282\u201D\u8282\u5E86\u6C1B\u56F4\uFF0C\u4E2D\u5FC3\u5C06\u56F4\u7ED5\u201C\u6B22\u4E50\u6625\u8282\u201D\u201C\u4F60\u597D\uFF01\u4E2D\u56FD\u201D\u54C1\u724C\u5F62\u8C61\u63A8\u5E7F\uFF0C\u5728\u9A6C\u6765\u897F\u4E9A\u548C\u5370\u5EA6\u5C3C\u897F\u4E9A\u5E02\u573A\uFF0C\u9488\u5BF9\u6625\u8282\u5047\u671F\u8D74\u534E\u65C5\u6E38\u4EBA\u7FA4\u504F\u597D\uFF0C\u901A\u8FC7\u5A92\u4F53\u4E13\u9898\u62A5\u9053\u3001\u6237\u5916\u5E7F\u544A\u7B49\u591A\u6E20\u9053\u4F20\u64AD\u65B9\u5F0F\uFF0C\u8FDB\u4E00\u6B65\u5F3A\u5316\u54C1\u724C\u66DD\u5149\uFF0C\u91CD\u70B9\u7A81\u51FA\u4E2D\u56FD\u51B0\u96EA\u65C5\u6E38\u76EE\u7684\u5730\u7684\u6587\u5316\u7279\u8272\u4E0E\u8282\u5E86\u9B45\u529B\u3002\u003C/p\u003E\n\u003Cp\u003EUnder the \u201CNihao! China\u201D and \u201CHappy Chinese New Year\u201D brands, the campaign promotes China\u2019s ice and snow tourism in the Malaysian and Indonesian markets through phased online and offline activities, highlighting the cultural appeal and festive charm of China\u2019s winter destinations while generating sustained exposure and market conversion.\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/sz_mmbiz_png/KzZqvMiaRfUwzEsic20H4EsVtzuuKqibuKI10J9m68MWnu1XsriaAkoIedMj9Gc14FYZibBw2EDE7dUfCQZvqt1GLWQ/640?wx_fmt=png\u0026amp;from=appmsg\u0026amp;tp=webp\u0026amp;wxfrom=5\u0026amp;wx_lazy=1\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/sz_mmbiz_jpg/KzZqvMiaRfUxia96vzD0pPVkV1pghvFQ9IKFTEvL2tUHYsl1y0cLqCH4YlchZe8sm13ib7QNNAV6lDEcn2DGtCB9Q/640?wx_fmt=jpeg\u0026amp;from=appmsg\u0026amp;tp=webp\u0026amp;wxfrom=5\u0026amp;wx_lazy=1\u0022 alt=\u0022\u0022 /\u003E\n",
