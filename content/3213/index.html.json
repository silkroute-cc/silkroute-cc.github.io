{
  "id": "%e9%a2%84%e5%91%8a%ef%bd%9c%e3%80%8a%e4%b8%ad%e5%9b%bd%e5%8a%a8%e7%94%bb%e4%b9%8b%e6%97%85%e3%80%8b%e7%b3%bb%e5%88%97%e8%ae%b2%e5%ba%a7%ef%bc%8c%e8%ae%a9%e6%88%91%e4%bb%ac%e4%b8%80%e5%90%8c%e8%b8%8f",
  "slug": "%e9%a2%84%e5%91%8a%ef%bd%9c%e3%80%8a%e4%b8%ad%e5%9b%bd%e5%8a%a8%e7%94%bb%e4%b9%8b%e6%97%85%e3%80%8b%e7%b3%bb%e5%88%97%e8%ae%b2%e5%ba%a7%ef%bc%8c%e8%ae%a9%e6%88%91%e4%bb%ac%e4%b8%80%e5%90%8c%e8%b8%8f",
  "canonicalUrlKey": "%e9%a2%84%e5%91%8a%ef%bd%9c%e3%80%8a%e4%b8%ad%e5%9b%bd%e5%8a%a8%e7%94%bb%e4%b9%8b%e6%97%85%e3%80%8b%e7%b3%bb%e5%88%97%e8%ae%b2%e5%ba%a7%ef%bc%8c%e8%ae%a9%e6%88%91%e4%bb%ac%e4%b8%80%e5%90%8c%e8%b8%8f",
  "route": "/3213/",
  "title": "\u9884\u544A\uFF5C\u300A\u4E2D\u56FD\u52A8\u753B\u4E4B\u65C5\u300B\u7CFB\u5217\u8BB2\u5EA7\uFF0C\u8BA9\u6211\u4EEC\u4E00\u540C\u8E0F\u5165\u795E\u5947\u7684\u4E2D\u56FD\u52A8\u753B\u4E16\u754C",
  "summary": "\u4E3A\u589E\u8FDB\u9A6C\u6765\u897F\u4E9A\u6C11\u4F17\u5BF9\u4E2D\u56FD\u56FD\u4EA7\u52A8\u753B\u53D1\u5C55\u53F2\u548C\u4EA7\u4E1A\u73B0\u72B6\u7684\u4E86\u89E3\uFF0C\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u5C06\u4E8E 12\u67086\u65E5\u63A8\u51FA\u300A\u4E2D\u56FD\u52A8\u753B\u4E4B\u65C5\u300B \u7CFB\u5217\u8BB2\u5EA7 \uFF0C\u7279\u9080\u56DB\u5DDD\u6587\u5316\u4EA7\u4E1A\u804C\u4E1A\u5B66\u9662\u5F20\u7FDB\u7136\u8001\u5E08\u4E3E\u529E 4\u573AZoom\u7EBF\u4E0A\u8BB2\u5EA7 \uFF0C\u901A\u8FC7\u7CBE\u5F69\u8BB2\u89E3\u5C55\u793A\u4E2D\u56FD\u52A8\u753B\u9C9C\u660E\u7684\u98CE\u683C\u7279\u8272\u3001\u4E30\u5BCC\u5E95\u8574\u548C\u6587\u5316\u65B0\u6C14\u8C61\u3002 \u4E3B\u8BB2\u4EBA\u5C06 \u5E26\u9886\u5B66\u5458\u4E00\u540C\u8E0F\u4E0A\u4E2D\u56FD\u52A8\u753B\u4E4B\u65C5\uFF0C\u5750\u4E0A\u65F6\u5149\u7A7F\u68AD\u673A\u56DE\u6EAF\u4E2D\u56FD\u4F20\u7EDF\u52A8\u753B\u53D1\u5C55\u4E0E\u5386\u53F2\uFF0C\u4ECE\u300A\u5C0F\u874C\u86AA\u627E\u5988\u5988\u300B\u5230\u300A \u5927 \u95F9\u5929\u5BAB\u300B\uFF0C\u63ED\u79D8\u8033\u719F\u80FD\u8BE6\u7684\u52A8\u753B\u89D2\u8272\uFF0C\u7545\u4EAB\u4F20\u7EDF\u52A8\u753B\u7684\u7075\u52A8\u4E4B\u7F8E\uFF0C\u518D\u4E00\u540C\u63A2\u5BFB\u6570\u5B57\u52A8\u753B\u524D\u6CBF\uFF0C\u9886\u7565\u300A\u54EA\u5412\u300B\u4E0E\u300A\u5927\u9C7C\u6D77\u68E0\u300B\u7684\u7ECF\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2022/11/frc-e7815cecdef49208a6404d7195da3d96.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u4E3A\u589E\u8FDB\u9A6C\u6765\u897F\u4E9A\u6C11\u4F17\u5BF9\u4E2D\u56FD\u56FD\u4EA7\u52A8\u753B\u53D1\u5C55\u53F2\u548C\u4EA7\u4E1A\u73B0\u72B6\u7684\u4E86\u89E3\uFF0C\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u5C06\u4E8E\u003Cstrong\u003E12\u67086\u65E5\u63A8\u51FA\u300A\u4E2D\u56FD\u52A8\u753B\u4E4B\u65C5\u300B\u003C/strong\u003E\u7CFB\u5217\u8BB2\u5EA7\uFF0C\u7279\u9080\u56DB\u5DDD\u6587\u5316\u4EA7\u4E1A\u804C\u4E1A\u5B66\u9662\u5F20\u7FDB\u7136\u8001\u5E08\u4E3E\u529E\u003Cstrong\u003E4\u573AZoom\u7EBF\u4E0A\u8BB2\u5EA7\u003C/strong\u003E\uFF0C\u901A\u8FC7\u7CBE\u5F69\u8BB2\u89E3\u5C55\u793A\u4E2D\u56FD\u52A8\u753B\u9C9C\u660E\u7684\u98CE\u683C\u7279\u8272\u3001\u4E30\u5BCC\u5E95\u8574\u548C\u6587\u5316\u65B0\u6C14\u8C61\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E3B\u8BB2\u4EBA\u5C06\u5E26\u9886\u5B66\u5458\u4E00\u540C\u8E0F\u4E0A\u4E2D\u56FD\u52A8\u753B\u4E4B\u65C5\uFF0C\u5750\u4E0A\u65F6\u5149\u7A7F\u68AD\u673A\u56DE\u6EAF\u4E2D\u56FD\u4F20\u7EDF\u52A8\u753B\u53D1\u5C55\u4E0E\u5386\u53F2\uFF0C\u4ECE\u300A\u5C0F\u874C\u86AA\u627E\u5988\u5988\u300B\u5230\u300A\u5927\u95F9\u5929\u5BAB\u300B\uFF0C\u63ED\u79D8\u8033\u719F\u80FD\u8BE6\u7684\u52A8\u753B\u89D2\u8272\uFF0C\u7545\u4EAB\u4F20\u7EDF\u52A8\u753B\u7684\u7075\u52A8\u4E4B\u7F8E\uFF0C\u518D\u4E00\u540C\u63A2\u5BFB\u6570\u5B57\u52A8\u753B\u524D\u6CBF\uFF0C\u9886\u7565\u300A\u54EA\u5412\u300B\u4E0E\u300A\u5927\u9C7C\u6D77\u68E0\u300B\u7684\u7ECF\u5178\u6F14\u7ECE\uFF0C\u6B23\u8D4F\u4F20\u7EDF\u53D9\u4E8B\u4E0E3D\u52A8\u753B\u7684\u5B8C\u7F8E\u878D\u5408\u3002\u4E3B\u8BB2\u4EBA\u8FD8\u5C06\u5728\u8BFE\u95F4\u5411\u5B66\u5458\u5C55\u793A\u4E2D\u56FD\u56FD\u4EA7\u52A8\u753B\u7684\u5148\u8FDB\u5236\u4F5C\u6280\u672F\u3001\u5DE5\u827A\uFF0C\u4EE5\u53CA\u4F20\u7EDF\u795E\u8BDD\u6545\u4E8B\u5728\u73B0\u4EE3\u5F71\u50CF\u5236\u4F5C\u4E2D\u7684\u4F20\u627F\u548C\u5F18\u626C\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2022/11/frc-0c55e3e3d28c6061a2826c8770fe7eea.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u4F5C\u4E3A\u4ECA\u5E74\u63A8\u51FA\u7684\u201C\u8FDE\u901A\u4E2D\u56FD\u201D\u6587\u5316\u827A\u672F\u62D3\u5C55\u7CFB\u5217\u7B2C\u4E8C\u8BB2\uFF0C\u8BE5\u8BB2\u5EA7\u7531\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u3001\u4E2D\u5916\u6587\u5316\u4EA4\u6D41\u4E2D\u5FC3\u5171\u540C\u4E3B\u529E\uFF0C\u5317\u4EAC\u8FDE\u901A\u4E94\u6D32\u6587\u65C5\u6709\u9650\u516C\u53F8\u627F\u529E\uFF0C\u4E0E\u9A6C\u6765\u897F\u4E9A\u4E00\u5E26\u4E00\u8DEF\u59D4\u5458\u4F1A\u5408\u4F5C\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u7EBF\u4E0A\u8BFE\u7A0B\u4EAE\u70B9\uFF1A\u7EBF\u4E0A\u542C\u8BFE\uFF0C\u7EBF\u4E0B\u4F5C\u753B\u7684\u4E50\u8DA3\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u6B64\u6B21\u8BB2\u5EA7\uFF0C\u4E3B\u8BB2\u4EBA\u5C06\u5E26\u9886\u5B66\u5458\u4E00\u540C\u5B9E\u65F6\u4F5C\u753B\u3002\u4E3B\u529E\u5355\u4F4D\u9F13\u52B1\u5B66\u5458\u5728\u5BB6\u4E2D\u63D0\u524D\u5907\u597D\u4E0A\u8BFE\u6240\u9700\u6750\u6599\uFF0C\u4F53\u9A8C\u7EBF\u4E0A\u542C\u8BB2\uFF0C\u7EBF\u4E0B\u52A8\u624B\u4F5C\u753B\u7684\u4E50\u8DA3\uFF0C\u76F8\u5173\u6750\u6599\u5C06\u7535\u90AE\u81F3\u62A5\u540D\u6210\u529F\u7684\u5B66\u5458\u3002\u8BFE\u7A0B\u5F53\u5929\u8BBE\u6709\u70B9\u8BC4\u73AF\u8282\uFF0C\u4E3B\u8BB2\u4EBA\u5C06\u901A\u8FC7\u955C\u5934\u968F\u673A\u70B9\u8BC4\u6307\u5BFC\uFF0C\u5B9E\u65F6\u4E0E\u5B66\u5458\u8FDB\u884C\u4E92\u52A8\uFF0C\u6B22\u8FCE\u559C\u6B22\u52A8\u753B\u3001\u70ED\u7231\u521B\u4F5C\u7684\u5927\u4EBA\u5C0F\u5B69\uFF0C\u4E00\u8D77\u53C2\u4E0E\u8FD9\u573A\u52A8\u753B\u4E4B\u65C5\u3002\u003C/p\u003E\n\u003Cp\u003E\u8BB2\u5EA7\u5C06\u4E8E12\u67086\u65E5\uFF08\u5468\u4E8C\uFF098PM\u5F00\u8BB2\uFF0C\u51FA\u5E2D\u7387\u6EE1\u5206\u7684\u53C2\u4E0E\u8005\u5C06\u83B7\u5F97\u7531\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u9881\u53D1\u7684\u7535\u5B50\u7248\u53C2\u4E0E\u8BC1\u4E66\u3002\u7531\u4E8E\u7EBF\u4E0A\u5E73\u53F0\u540D\u989D\u6709\u9650,\u4E3B\u529E\u5355\u4F4D\u547C\u5401\u6C11\u4F17\u63D0\u65E9\u62A5\u540D,\u5F53\u5929\u63D0\u524D\u767B\u5165\u7EBF\u4E0A\u8BFE\u5802\u4EE5\u514D\u5411\u9685\u3002\u6C11\u4F17\u53EF\u4EE5\u626B\u7801\u5BA3\u4F20\u56FE\u4E2D\u7684\u4E8C\u7EF4\u7801,\u6216\u67E5\u9605\u4EE5\u4E0B\u7F51\u5740\u63D0\u4EA4\u62A5\u540D, https://bit.ly/3DcBKmT\u003C/p\u003E\n\u003Cp\u003E\u66F4\u591A\u8BE6\u60C5,\u8BF7\u6D4F\u89C8\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u003C/p\u003E\n\u003Cp\u003E\u5B98\u7F51\uFF1Ahttp://www.chinaculturalcentre.my\u003C/p\u003E\n\u003Cp\u003E\u9762\u5B50\u4E66\uFF1A\u201CChina Cultural Centre in Kuala Lumpur\u201D\u3001\u003C/p\u003E\n\u003Cp\u003E\u5FAE\u4FE1\u516C\u4F17\u53F7\uFF1A\u201C\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u201D\u003C/p\u003E\n\u003Cp\u003E\u6216\u7535\u90AE\u81F3\uFF1Aedu@chinaculturalcentre.my\u003C/p\u003E\n\u003Cp\u003E\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3 Zoom \u7EBF\u4E0A\u4E13\u9898\u8BB2\u5EA7:\u300A\u4E2D\u56FD\u52A8\u753B\u4E4B\u65C5\u300B\u003C/p\u003E\n\u003Cp\u003E\u4E3B\u8BB2\u4EBA\uFF1A\u5F20\u7FDB\u7136\u8001\u5E08\u003C/p\u003E\n\u003Cp\u003E\u65E5\u671F\uFF1A6/12\u300113/12\u300120/12\u300127/12\uFF08\u6BCF\u5468\u4E8C\uFF09\u003C/p\u003E\n\u003Cp\u003E\u65F6\u95F4\uFF1A8PM\u003C/p\u003E\n\u003Cp\u003E\u5A92\u4ECB\u8BED\uFF1A\u4E2D\u6587\u003C/p\u003E\n\u003Cp\u003E- End -\n\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u957F\u6309\u8BC6\u522B\u4E8C\u7EF4\u7801\n\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u83B7\u53D6\u66F4\u591A\u7CBE\u5F69\u5185\u5BB9\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u25BC\u003C/strong\u003E\n\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2022/11/frc-393d7a99f3f2b62d8101a4e46568d89f.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2022/11/frc-55a705354cac3bb838e283010202f339.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2022/11/frc-e592b6d7fcb0f17eb92480e99a800f61.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2022/11/frc-38bc8c97af1c04b93222b36dcb5bbbce.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2022/11/frc-66f61deeda48ac066eaadc74e0ff7ca3.gif\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5206\u4EAB\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2022/11/frc-4db2f23cf0e6f951e341ba1ced8f0917.gif\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u6536\u85CF\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2022/11/frc-280a49ece728eeef36bddfc55343e370.gif\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u8FDE\u901A\u4E2D\u56FD \u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2022/11/frc-2bef5eb45056a72b7565d3b6c80d4a2f.gif\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u8BB2\u5EA7\n\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2022/11/frc-8d50aaa027045ecf6acc610884c4aaf0.gif\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1Ahttps://mp.weixin.qq.com/s/HxlADgNA9AjP0hpO3I1P2w\u003C/p\u003E\n",
