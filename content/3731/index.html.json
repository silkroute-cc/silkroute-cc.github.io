  "canonicalUrlKey": "%e7%a0%94%e7%a9%b6%e4%b8%9c%e9%93%81%e8%ae%a1%e5%88%92%e4%b8%ba%e4%b8%b9%e5%b7%9e%e5%b8%a6%e6%9d%a5%e6%94%b9%e5%8f%98%e3%80%80%e5%ae%89%e5%8d%8e%ef%bc%9a%e7%a7%af%e6%9e%81%e6%8b%9b%e8%b5%84%e5%8a%a0",
  "route": "/3731/",
  "title": "\u7814\u7A76\u4E1C\u94C1\u8BA1\u5212\u4E3A\u4E39\u5DDE\u5E26\u6765\u6539\u53D8\u3000\u5B89\u534E\uFF1A\u79EF\u6781\u62DB\u8D44\u52A0\u901F\u6279\u51C6\u7A0B\u5E8F",
  "summary": "\uFF08\u54E5\u6253\u5CC7\u9C8112\u65E5\u8BAF\uFF09\u9996\u76F8\u62FF\u7763\u65AF\u91CC\u5B89\u534E\u4E0B\u4EE4\u6DF1\u5165\u7814\u7A76\u4E1C\u6D77\u5CB8\u94C1\u8DEF\uFF08ECRL\uFF09\uFF0C\u786E\u4FDD\u8FD9\u4E2A\u4F30\u8BA1\u57283\u5E74\u5185\u7AE3\u5DE5\u7684\u8BA1\u5212\uFF0C\u80FD\u4E3A\u4E1C\u6D77\u5CB8\u7279\u522B\u662F\u5409\u5170\u4E39\u5DDE\u5E26\u6765\u6539\u53D8\u3002 \u201C\u6211\u4EEC\u4E0E\u5916\u8D44\u5305\u62EC\u4E2D\u8D44\u8BA8\u8BBA\u65F6\u8C08\u5230\u7684\u6700\u5927\u95EE\u9898\u4E4B\u4E00\uFF0C\u662F\u6E2F\u53E3\u95EE\u9898\uFF0C\uFF08\u4E1C\u6D77\u5CB8\u7684\uFF09\u767B\u5609\u697C\u8F83\u4E0D\u53D7\u5230\u5173\u6CE8\uFF0C\u7279\u522B\u662F\u5409\u5170\u4E39\uFF0C\u5C3D\u7BA1\uFF08\u8FD9\u4E9B\u5DDE\u5C5E\uFF09\u6CA1\u6709\u6E2F\u53E3\uFF0C\u4F46\uFF08ECRL\uFF09\u80FD\u65B9\u4FBF\u4E39\u5DDE\u8F93\u51FA\u519C\u4E1A\u6216\u5DE5\u4E1A\u4EA7\u54C1\u3002\u201D \u201C\u56E0\u6B64\uFF0C\u5FC5\u987B\u66F4\u79EF\u6781\u5730\u5C55\u5F00\u62DB\u5546\u5F15\u8D44\u7684\u884C\u52A8\uFF0C\u4E14\u9700\u8981\u4FDD\u8BC1\u4F1A\u6709\u65B0\u7684\u5956\u6396\u4EE5\u53CA\u52A0\u901F\u6279\u51C6\u7A0B\u5E8F\u3002\u201D \u4ED6\u4ECA\u65E5\u51FA\u5E2DECRL\u9996\u4E2A\u7AD9\u70B9\u54E5\u6253\u5CC7\u9C81\u7AD9\u7684\u52A8\u5DE5\u63A8\u4ECB\u793C\uFF0C\u5728\u4F1A\u4E0A\u81F4\u8BCD\u2026",
  "body": "\u003Chr /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/05/frc-52586e35882d7fc17db0038b7a5ad359.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\uFF08\u54E5\u6253\u5CC7\u9C8112\u65E5\u8BAF\uFF09\u9996\u76F8\u62FF\u7763\u65AF\u91CC\u5B89\u534E\u4E0B\u4EE4\u6DF1\u5165\u7814\u7A76\u4E1C\u6D77\u5CB8\u94C1\u8DEF\uFF08ECRL\uFF09\uFF0C\u786E\u4FDD\u8FD9\u4E2A\u4F30\u8BA1\u57283\u5E74\u5185\u7AE3\u5DE5\u7684\u8BA1\u5212\uFF0C\u80FD\u4E3A\u4E1C\u6D77\u5CB8\u7279\u522B\u662F\u5409\u5170\u4E39\u5DDE\u5E26\u6765\u6539\u53D8\u3002 \u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u4EEC\u4E0E\u5916\u8D44\u5305\u62EC\u4E2D\u8D44\u8BA8\u8BBA\u65F6\u8C08\u5230\u7684\u6700\u5927\u95EE\u9898\u4E4B\u4E00\uFF0C\u662F\u6E2F\u53E3\u95EE\u9898\uFF0C\uFF08\u4E1C\u6D77\u5CB8\u7684\uFF09\u767B\u5609\u697C\u8F83\u4E0D\u53D7\u5230\u5173\u6CE8\uFF0C\u7279\u522B\u662F\u5409\u5170\u4E39\uFF0C\u5C3D\u7BA1\uFF08\u8FD9\u4E9B\u5DDE\u5C5E\uFF09\u6CA1\u6709\u6E2F\u53E3\uFF0C\u4F46\uFF08ECRL\uFF09\u80FD\u65B9\u4FBF\u4E39\u5DDE\u8F93\u51FA\u519C\u4E1A\u6216\u5DE5\u4E1A\u4EA7\u54C1\u3002\u201D \u003C/p\u003E\n\u003Cp\u003E\u201C\u56E0\u6B64\uFF0C\u5FC5\u987B\u66F4\u79EF\u6781\u5730\u5C55\u5F00\u62DB\u5546\u5F15\u8D44\u7684\u884C\u52A8\uFF0C\u4E14\u9700\u8981\u4FDD\u8BC1\u4F1A\u6709\u65B0\u7684\u5956\u6396\u4EE5\u53CA\u52A0\u901F\u6279\u51C6\u7A0B\u5E8F\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u4ECA\u65E5\u51FA\u5E2DECRL\u9996\u4E2A\u7AD9\u70B9\u54E5\u6253\u5CC7\u9C81\u7AD9\u7684\u52A8\u5DE5\u63A8\u4ECB\u793C\uFF0C\u5728\u4F1A\u4E0A\u81F4\u8BCD\u65F6\u8FD9\u4E48\u8BF4\u3002 \u003C/p\u003E\n\u003Cp\u003E\u5360\u573020\u516C\u9877\u7684\u54E5\u6253\u5CC7\u9C81\u7AD9\uFF0C\u8BBE\u8BA1\u51F8\u663E\u4E39\u5DDE\u9A6C\u6765\u4F20\u7EDF\u5EFA\u7B51\u7684\u98CE\u683C\uFF0C\u4E14\u878D\u5165\u4E39\u5DDE\u7684\u6587\u5316\u7279\u70B9\u3002 \u003C/p\u003E\n\u003Cp\u003E\u4E1C\u94C1\u5DE5\u7A0B\u88AB\u4E2D\u56FD\u5784\u65AD\uFF1F\u5B89\u534E\uFF1A\u4E00\u6D3E\u80E1\u8A00\u003C/p\u003E\n\u003Cp\u003E\u5B89\u534E\u8BF4\uFF0C\u4ECE2017\u5E74\u8D77\u65BD\u5DE5\u7684\u4E1C\u94C1\u8BA1\u5212\uFF0C\u5DF2\u6709\u8D85\u8FC72100\u5BB6\u672C\u5730\u516C\u53F8\u7684\u53C2\u4E0E\uFF0C\u5305\u62EC\u627F\u5305\u5546\u3001\u4F9B\u5E94\u5546\u3001\u987E\u95EE\u516C\u53F8\u7B49\u3002 \u003C/p\u003E\n\u003Cp\u003E\u201C\u56E0\u6B64\uFF0C\u8BF4\u4E1C\u94C1\u8BA1\u5212\u5B8C\u5168\u88AB\u4E2D\u56FD\u5784\u65AD\uFF0C\u5168\u662F\u4E00\u6D3E\u80E1\u8A00\u3002\u201D \u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u521A\u624D\u5DF2\u8BF4\u4E86\uFF0C\u6211\u4EEC\u4E0E\u4E2D\u56FD\u548C\u4E2D\u8D44\u516C\u53F8\u7684\u4F1A\u8C08\u5F53\u4E2D\uFF0C\u6240\u6709\u7684\u65B0\u8BA1\u5212\u6211\u4EEC\u90FD\u4F1A\u5F3A\u8C03\u4E88\u4EE5\u672C\u56FD\u4EBA\u521B\u9020\u5DE5\u4F5C\u673A\u4F1A\u548C\u7A7A\u95F4\uFF0C\u5408\u7EA6\u548C\u54A8\u5546\u7B49\u7B49\u4E5F\u5E94\u9881\u7ED9\u672C\u571F\u516C\u53F8\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u5B89\u534E\u4ECA\u65E5\u51FA\u5E2D\u4E1C\u94C1\u8BA1\u5212\u54E5\u6253\u5CC7\u9C81\u7AD9\u7684\u5F00\u5DE5\u4EEA\u5F0F\uFF0C\u8BE5\u7AD9\u4E3A\u4E1C\u94C1\u9879\u76EE\u9996\u4E2A\u5F00\u5DE5\u8F66\u7AD9\uFF0C\u4E5F\u6807\u5FD7\u8457\u8FD9\u9879\u56FD\u5BB6\u57FA\u5EFA\u9879\u76EE\u6B63\u5F0F\u8FDB\u51652023\u5E74\u5EFA\u8BBE\u9AD8\u5CF0\u671F\u3002\u003C/p\u003E\n\u003Cp\u003E\u54E5\u6253\u5CC7\u9C81\u7AD9\u5750\u843D\u4E8E\u65B0\u4E39\u7ED2\u57CE\uFF08Bandar Baru Tunjong\uFF09\uFF0C\u5360\u573050.41\u82F1\u4EA9\uFF0C\u5176\u5EFA\u7B51\u8BBE\u8BA1\u7406\u5FF5\u6E90\u81EA \u201C\u5409\u5170\u4E39\u4F20\u7EDF\u9A6C\u6765\u5C4B\u201D\uFF08Rumah Meleh Melayu)\u548C\u9EC4\u82B1\u68EF\uFF08bunga ketam guri)\uFF0C\u5145\u5206\u5C55\u73B0\u4E86\u5409\u5170\u4E39\u5DDE\u72EC\u6709\u7684\u6587\u5316\u7279\u8272\u3002\u003C/p\u003E\n\u003Cp\u003E\u54E5\u6253\u5CC7\u9C81\u7AD9\u4E3A\u5BA2\u8FD0\u7AD9\uFF0C\u7AD9\u623F\u8BBE\u65BD\u5305\u62EC\u4E00\u4E2A\u591A\u5C42\u7AD9\u53F0\u3001\u505C\u8F66\u573A\u3001\u63A5\u9001\u5BA2\u7B49\u5019\u533A\u3001\u98CE\u96E8\u901A\u9053\u3001\u5458\u5DE5\u5BBF\u820D\u548C\u98CE\u666F\u7EFF\u5316\u5E26\u7B49\u8BBE\u65BD\u3002\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u94C1\u8DEF\u8854\u63A5\u516C\u53F8\uFF08MRL\uFF09\u4E3B\u5E2D\u4E39\u65AF\u91CC\u83AB\u54C8\u672B\u7956\u57FA\u963F\u91CC\u8868\u793A\uFF0C\u54E5\u6253\u5CC7\u9C81\u7AD9\u7684\u65BD\u5DE5\u4E0D\u4EC5\u8868\u660E\u8BE5\u9879\u76EE\u5DF2\u53D6\u5F97\u53EF\u559C\u8FDB\u5C55\uFF0C\u540C\u65F6\u4EA6\u4EE3\u8868\u8457\u5F53\u524D\u8FDB\u5EA6\u4E0E\u8BA1\u5212\u4E00\u81F4\u3002\u003C/p\u003E\n\u003Cp\u003E\u5728\u8FD9\u9996\u76F8\u5B89\u534E\u51FA\u5E2D\u7684\u5F00\u5DE5\u4EEA\u5F0F\u4E2D\uFF0C\u83AB\u54C8\u672B\u7956\u57FA\u963F\u91CC\u8868\u793A\uFF1A\u201C\u54E5\u6253\u5CC7\u9C81\u7AD9\u5DF2\u987A\u5229\u5F00\u5DE5\uFF0C\u4E1C\u94C1\u6CBF\u7EBF\u5176\u4ED6\u8F66\u7AD9\u4E5F\u5373\u5C06\u5206\u6279\u5F00\u5DE5\uFF0C\u94C1\u8DEF\u5EFA\u8BBE\u8FDB\u5EA6\u52A0\u5FEB\uFF0C\u4ECE\u800C\u53EF\u57282026\u5E7412\u6708\u5B8C\u5DE5\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u51FA\u5E2D\u6B64\u6B21\u91CD\u5927\u4EEA\u5F0F\u7684\u9886\u5BFC\u53CA\u6765\u5BBE\u8FD8\u5305\u62EC\u5409\u5170\u4E39\u5DDE\u52A1\u5927\u81E3\u62FF\u7763\u963F\u672B\u8036\u8C37\u3001\u4EA4\u901A\u90E8\u957F\u9646\u5146\u798F\u3001MRL\u9996\u5E2D\u6267\u884C\u5B98\u62FF\u7763\u65AF\u91CC\u8FBE\u7EF4\u65AF\uFF0C\u4EE5\u53CA\u4E2D\u56FD\u4EA4\u901A\u5EFA\u8BBE\u6709\u9650\u516C\u53F8\uFF08CCCC\uFF09\u8463\u4E8B\u5218\u8F89\u3002\u003C/p\u003E\n\u003Cp\u003E\u6B64\u5916\uFF0C\u83AB\u54C8\u672B\u7956\u57FA\u963F\u91CC\u8868\u793A\uFF0C\u4E1C\u94C1\u9879\u76EE\u5168\u957F665\u516C\u91CC\uFF0C\u6CBF\u7EBF\u5171\u8BBE20\u4E2A\u8F66\u7AD9\uFF0C\u5305\u62EC10\u4E2A\u5BA2\u8FD0\u7AD9\u4EE5\u53CA10\u4E2A\u5BA2\u8D27\u8FD0\u7AD9\u3002\u4E1C\u94C1\u9879\u76EE\u5C06\u66F4\u6709\u6548\u5730\u5C06\u4E1C\u6D77\u5CB8\u5404\u5DDE\u7684\u5DDE\u5E9C\u3001\u57CE\u9547\u3001\u5DE5\u4E1A\u4E2D\u5FC3\u3001\u6E2F\u53E3\u548C\u65C5\u6E38\u533A\u4E0E\u5DF4\u751F\u6E2F\u76F8\u8FDE, \u540C\u65F6\u66F4\u52A0\u73AF\u4FDD\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/o-MXFfqMWYwRji2-wQ8tKg\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
