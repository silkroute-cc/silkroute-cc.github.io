  "title": "\u6CB3\u5357\u4E8C\u5EFA\u94A2\u7ED3\u6784 | \u9A6C\u6765\u897F\u4E9A\u4E09\u661FSDIEM\u7EFC\u5408\u4F532\u53F7\u5DE5\u5382\u9879\u76EEB\u6807\u6BB5\u4E3B\u4F53\u94A2\u7ED3\u6784\u5706\u6EE1\u5C01\u9876",
  "summary": "6\u670815\u65E5\uFF0C\u7531\u6211\u516C\u53F8\u627F\u5EFA\u7684\u9A6C\u6765\u897F\u4E9A\u4E09\u661FSDIEM\u7EFC\u5408\u4F532\u53F7\u5DE5\u5382\u9879\u76EEB\u6807\u6BB5\u4E3B\u4F53\u94A2\u7ED3\u6784\u5706\u6EE1\u5C01\u9876\u3002 \u8BE5\u9879\u76EE\u662F\u6211\u516C\u53F8\u627F\u63A5\u7684\u7B2C\u4E00\u4E2A\u6D77\u5916\u94A2\u7ED3\u6784\u5236\u4F5C\u3001\u5B89\u88C5\u9879\u76EE\u3002\u9879\u76EE\u4F4D\u4E8E\u9A6C\u6765\u897F\u4E9A\u68EE\u7F8E\u5170\u6D32\u8299\u84C9\u5E02\uFF0C\u662F\u4E09\u661F SDI\u9A6C\u6765\u897F\u4E9A\u80FD\u6E90\u6709\u9650\u516C\u53F8\u5EFA\u8BBE\u7684\u65B0\u80FD\u6E90\u7535\u6C60\u5382\u623F\uFF0C\u5360\u5730\u9762\u79EF20943\u33A1\uFF0C\u4E3A\u5DE5\u4E1A\u5EFA\u7B51\u94A2\u7ED3\u6784\u5382\u623F\uFF0C\u5730\u4E0A\u4E09\u5C42\uFF0C\u5DE5\u7A0B\u9020\u4EF79919.2\u4E07\u5143\uFF0C\u5176\u4E2D\u94A2\u7ED3\u6784\u5236\u4F5C\u603B\u91CF\u7EA65900\u5428\uFF0C\u5B89\u88C5\u603B\u91CF\u7EA68500\u5428\u3002 \u9879\u76EE\u65BD\u5DE5\u521D\u671F\uFF0C\u56FD\u5185\u5236\u4F5C\u7684\u94A2\u6784\u4EF6\u5230\u8FBE\u9A6C\u6765\u897F\u4E9A\u5C31\u9762\u4E34 CIDB\u67E5\u9A8C\u6D41\u7A0B\u7E41\u7410\u3001\u6E05\u5173\u56F0\u96BE\u7684\u95EE\u9898\uFF0C\u5BFC\u81F4\u6784\u4EF6\u8FD0\u8F93\u2026",
  "body": "\u003Cp\u003E6\u670815\u65E5\uFF0C\u7531\u6211\u516C\u53F8\u627F\u5EFA\u7684\u9A6C\u6765\u897F\u4E9A\u4E09\u661FSDIEM\u7EFC\u5408\u4F532\u53F7\u5DE5\u5382\u9879\u76EEB\u6807\u6BB5\u4E3B\u4F53\u94A2\u7ED3\u6784\u5706\u6EE1\u5C01\u9876\u3002\u003C/p\u003E\n\u003Cp\u003E\u8BE5\u9879\u76EE\u662F\u6211\u516C\u53F8\u627F\u63A5\u7684\u7B2C\u4E00\u4E2A\u6D77\u5916\u94A2\u7ED3\u6784\u5236\u4F5C\u3001\u5B89\u88C5\u9879\u76EE\u3002\u9879\u76EE\u4F4D\u4E8E\u9A6C\u6765\u897F\u4E9A\u68EE\u7F8E\u5170\u6D32\u8299\u84C9\u5E02\uFF0C\u662F\u4E09\u661FSDI\u9A6C\u6765\u897F\u4E9A\u80FD\u6E90\u6709\u9650\u516C\u53F8\u5EFA\u8BBE\u7684\u65B0\u80FD\u6E90\u7535\u6C60\u5382\u623F\uFF0C\u5360\u5730\u9762\u79EF20943\u33A1\uFF0C\u4E3A\u5DE5\u4E1A\u5EFA\u7B51\u94A2\u7ED3\u6784\u5382\u623F\uFF0C\u5730\u4E0A\u4E09\u5C42\uFF0C\u5DE5\u7A0B\u9020\u4EF79919.2\u4E07\u5143\uFF0C\u5176\u4E2D\u94A2\u7ED3\u6784\u5236\u4F5C\u603B\u91CF\u7EA65900\u5428\uFF0C\u5B89\u88C5\u603B\u91CF\u7EA68500\u5428\u3002\u003C/p\u003E\n\u003Cp\u003E\u9879\u76EE\u65BD\u5DE5\u521D\u671F\uFF0C\u56FD\u5185\u5236\u4F5C\u7684\u94A2\u6784\u4EF6\u5230\u8FBE\u9A6C\u6765\u897F\u4E9A\u5C31\u9762\u4E34CIDB\u67E5\u9A8C\u6D41\u7A0B\u7E41\u7410\u3001\u6E05\u5173\u56F0\u96BE\u7684\u95EE\u9898\uFF0C\u5BFC\u81F4\u6784\u4EF6\u8FD0\u8F93\u5230\u73B0\u573A\u65F6\u95F4\u5EF6\u8FDF\u3002\u6211\u516C\u53F8\u9A6C\u6765\u897F\u4E9A\u4E09\u661F\u9879\u76EE\u90E8\u4E0D\u65AD\u5B66\u4E60\u6D77\u5916\u76F8\u5173\u6CD5\u5F8B\u3001\u6CD5\u89C4\uFF0C\u7406\u987A\u6D41\u7A0B\uFF0C\u63D0\u9AD8\u4E86\u6E05\u5173\u6548\u7387\uFF0C\u540C\u65F6\u4E5F\u8282\u7EA6\u4E86\u6E05\u5173\u6210\u672C\u3002\u9879\u76EE\u5EFA\u8BBE\u8FC7\u7A0B\u4E2D\uFF0C\u5728\u9879\u76EE\u5DE5\u671F\u7D27\u3001\u4E09\u661F\u516C\u53F8\u7BA1\u7406\u8981\u6C42\u4E25\u683C\u3001\u5F53\u5730\u5404\u79CD\u8D44\u6E90\u532E\u4E4F\u3001\u52B3\u52A8\u6548\u7387\u4F4E\u7684\u60C5\u51B5\u4E0B\uFF0C\u9879\u76EE\u90E8\u514B\u670D\u91CD\u91CD\u56F0\u96BE\uFF0C\u5982\u671F\u5C65\u7EA6\uFF0C\u5F97\u5230\u4E86\u4E09\u661F\u516C\u53F8\u548C\u4E2D\u5EFA\u4E8C\u5C40\u7684\u5145\u5206\u80AF\u5B9A\u3002\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u4E09\u661FSDIEM\u7EFC\u5408\u4F532\u53F7\u5DE5\u5382\u9879\u76EEB\u6807\u6BB5\u4E3B\u4F53\u94A2\u7ED3\u6784\u5706\u6EE1\u5C01\u9876\uFF0C\u4E3A\u6211\u516C\u53F8\u627F\u63A5\u6D77\u5916\u94A2\u7ED3\u6784\u5236\u4F5C\u3001\u5B89\u88C5\u5DE5\u7A0B\u79EF\u7D2F\u4E86\u7ECF\u9A8C\u3002\u4E0B\u4E00\u6B65\uFF0C\u6211\u516C\u53F8\u5C06\u5728\u63D0\u9AD8\u6E05\u5173\u6548\u7387\u3001\u589E\u5F3A\u6D77\u5916\u9879\u76EE\u65BD\u5DE5\u80FD\u529B\u3001\u7BA1\u63A7\u6D77\u5916\u9879\u76EE\u6210\u672C\u7B49\u65B9\u9762\u8FDB\u884C\u79EF\u6781\u7684\u63A2\u7D22\u548C\u5B9E\u8DF5\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/z5yZZ1LAW-auC1uWoyilZw\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
