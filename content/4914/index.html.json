  "title": "\u5317\u4EAC\u623F\u5C71\u4E91\u5C45\u5BFA\u5343\u5E74\u523B\u7ECF\u53F2\u5373\u5C06\u5728\u9A6C\u5C55\u51FA",
  "summary": "7\u670811\u65E5\uFF0C\u7531\u798F\u6167\u56FD\u9645\u6148\u5584\u57FA\u91D1\u4E0E\u4E2D\u897F\u6587\u5316\u827A\u672F\u53D1\u5C55\u534F\u4F1A\u4E3B\u529E\u3001\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u4E0E\u7D2B\u85E4\u96C6\u56E2\u534F\u529E\u7684\u201C\u4E2D\u534E\u6587\u5316\u5947\u8FF9\uFF1A \u5317\u4EAC\u623F\u5C71\u4E91\u5C45\u5BFA\u5386\u53F2\u6587\u5316\u5C55\u201D\u5A92\u4F53\u53D1\u5E03\u4F1A\u5728\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u4E3E\u529E\u3002 \u5317\u4EAC\u623F\u5C71\u4E91\u5C45\u5BFA\u6587\u7269\u7BA1\u7406\u5904 \u4E3B\u4EFB \u738B\u5F97\u519B\u3001\u798F\u6167\u56FD\u9645\u6148\u5584\u57FA\u91D1\u4F1A\u521B\u4F1A\u4E3B\u5E2D\u9EC4\u50D6\u5072\u3001\u4E2D\u897F\u6587\u5316\u827A\u672F\u53D1\u5C55\u534F\u4F1A\u521B\u4F1A\u6267\u884C\u59D4\u5458\u957F\u674E\u5353\u9716\u3001\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u4E3B\u4EFB\u5F20\u6770\u946B\u3001\u7D2B\u85E4\u6587\u5316\u4F01\u4E1A\u96C6\u56E2\u603B\u7ECF\u7406\u9648\u5A75\u83C1\u3001Rimbamama Farm\u8463\u4E8B\u8DEF\u897F\uFF0C\u4EE5\u53CA\u4E2D\u9A6C\u53CC\u65B9\u6587\u5316\u3001\u65C5\u6E38\u548C\u65B0\u95FB\u5A92\u4F53\u754C\u5609\u5BBE30\u4F59\u4EBA\u51FA\u5E2D\u6D3B\u52A8\u3002 \u738B\u5F97\u519B\u89C6\u9891\u81F4\u8F9E\u8868\u793A\uFF0C\u623F\u5C71\u77F3\u7ECF\u662F\u4E2D\u2026",
  "body": "\u003Cp\u003E7\u670811\u65E5\uFF0C\u7531\u798F\u6167\u56FD\u9645\u6148\u5584\u57FA\u91D1\u4E0E\u4E2D\u897F\u6587\u5316\u827A\u672F\u53D1\u5C55\u534F\u4F1A\u4E3B\u529E\u3001\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u4E0E\u7D2B\u85E4\u96C6\u56E2\u534F\u529E\u7684\u201C\u4E2D\u534E\u6587\u5316\u5947\u8FF9\uFF1A\u5317\u4EAC\u623F\u5C71\u4E91\u5C45\u5BFA\u5386\u53F2\u6587\u5316\u5C55\u201D\u5A92\u4F53\u53D1\u5E03\u4F1A\u5728\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u4E3E\u529E\u3002\u003C/p\u003E\n\u003Cp\u003E\u5317\u4EAC\u623F\u5C71\u4E91\u5C45\u5BFA\u6587\u7269\u7BA1\u7406\u5904\u4E3B\u4EFB\u738B\u5F97\u519B\u3001\u798F\u6167\u56FD\u9645\u6148\u5584\u57FA\u91D1\u4F1A\u521B\u4F1A\u4E3B\u5E2D\u9EC4\u50D6\u5072\u3001\u4E2D\u897F\u6587\u5316\u827A\u672F\u53D1\u5C55\u534F\u4F1A\u521B\u4F1A\u6267\u884C\u59D4\u5458\u957F\u674E\u5353\u9716\u3001\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u4E3B\u4EFB\u5F20\u6770\u946B\u3001\u7D2B\u85E4\u6587\u5316\u4F01\u4E1A\u96C6\u56E2\u603B\u7ECF\u7406\u9648\u5A75\u83C1\u3001Rimbamama Farm\u8463\u4E8B\u8DEF\u897F\uFF0C\u4EE5\u53CA\u4E2D\u9A6C\u53CC\u65B9\u6587\u5316\u3001\u65C5\u6E38\u548C\u65B0\u95FB\u5A92\u4F53\u754C\u5609\u5BBE30\u4F59\u4EBA\u51FA\u5E2D\u6D3B\u52A8\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/07/frc-199de0e1f4b173429eed694bb0b0548c.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u738B\u5F97\u519B\u89C6\u9891\u81F4\u8F9E\u8868\u793A\uFF0C\u623F\u5C71\u77F3\u7ECF\u662F\u4E2D\u56FD\u968B\u4EE3\u81F3\u660E\u4EE3\uFF0C\u5386\u7ECF\u5343\u5E74\u7684\u77F3\u523B\u5B9D\u5E93\uFF0C\u662F\u7814\u7A76\u4E2D\u56FD\u53E4\u4EE3\u6587\u5316\u827A\u672F\uFF0C\u7279\u522B\u662F\u4F5B\u6559\u5386\u53F2\u548C\u5178\u7C4D\u7684\u91CD\u8981\u6587\u732E\u3002\u672C\u6B21\u5C55\u89C8\u4EE5\u4E91\u5C45\u5BFA\u5343\u5E74\u523B\u7ECF\u53F2\u4E3A\u4E3B\u7EBF\uFF0C\u4ECE\u4E91\u5C45\u6625\u79CB\u3001\u523B\u7ECF\u4F1F\u4E1A\u3001\u7269\u534E\u5929\u5B9D\u3001\u4EBA\u6770\u5730\u7075\u7B49\u56DB\u4E2A\u90E8\u5206\u5C55\u5F00\uFF0C\u4EE5\u6587\u7269\u62D3\u7247\u3001\u56FE\u6587VR\u5B9E\u666F\u548C\u6444\u5F71\u4F5C\u54C1\u7B49\u591A\u79CD\u5F62\u5F0F\u518D\u73B0\u4E91\u5C45\u5BFA\u8DE8\u8D8A\u5343\u5E74\u7684\u5386\u53F2\u3002\u003C/p\u003E\n\u003Cp\u003E\u9EC4\u50D6\u5072\u8868\u793A\uFF0C\u672C\u6B21\u5C55\u89C8\u662F\u4E91\u5C45\u5BFA\u201C\u4E09\u7EDD\u201D\u9996\u6B21\u8D70\u8FDB\u4E1C\u5357\u4E9A\uFF0C\u5176\u4E2D17\u4EF6\u77F3\u7ECF\u62D3\u7247\u4E5F\u662F\u9996\u6B21\u79BB\u5F00\u4E2D\u56FD\u6765\u5230\u6D77\u5916\u8FDB\u884C\u5C55\u51FA\u3002\u5C55\u89C8\u5C06\u901A\u8FC7\u5411\u9A6C\u6765\u897F\u4E9A\u6C11\u4F17\u5C55\u793A\u5317\u4EAC\u623F\u5C71\u4E91\u5C45\u5BFA\u5343\u5E74\u6587\u5316\u7470\u5B9D\uFF0C\u4FC3\u6210\u4E00\u573A\u522B\u5F00\u751F\u9762\u7684\u53E4\u4ECA\u5BF9\u8BDD\uFF0C\u4F20\u627F\u548C\u53D1\u626C\u53E4\u4EBA\u5BF9\u827A\u672F\u7684\u4E0D\u61C8\u8FFD\u6C42\u548C\u7CBE\u76CA\u6C42\u7CBE\u7684\u6587\u5316\u5320\u4EBA\u7CBE\u795E\u3002\u003C/p\u003E\n\u003Cp\u003E\u5F20\u6770\u946B\u8868\u793A\uFF0C\u8BE5\u5C55\u8FDC\u6E21\u91CD\u6D0B\u6765\u5230\u9A6C\u6765\u897F\u4E9A\uFF0C\u8FDB\u4E00\u6B65\u8868\u660E\u4E2D\u9A6C\u5730\u65B9\u95F4\u4EA4\u6D41\u65E5\u76CA\u589E\u5F3A\uFF0C\u4E5F\u5C55\u793A\u4E86\u53CC\u65B9\u4ECE\u653F\u5E9C\u5230\u6C11\u95F4\u5404\u9886\u57DF\u6587\u5316\u4EA4\u6D41\u7684\u84EC\u52C3\u53D1\u5C55\u3002\u672C\u6B21\u5C55\u89C8\u5C06\u4E3A\u9A6C\u6765\u897F\u4E9A\u6C11\u4F17\u8BB2\u8FF0\u4E00\u5802\u751F\u52A8\u7684\u4E2D\u56FD\u5386\u53F2\u8BFE\uFF0C\u5E0C\u671B\u6C11\u4F17\u5728\u5018\u4F6F\u4E2D\u56FD\u5386\u53F2\u3001\u9886\u7565\u4E91\u5C45\u5BFA\u6587\u5316\u9B45\u529B\u7684\u540C\u65F6\uFF0C\u4E5F\u80FD\u52A0\u6DF1\u5BF9\u4E2D\u56FD\u4F20\u7EDF\u601D\u60F3\u548C\u7CBE\u795E\u5E95\u8574\u7684\u4E86\u89E3\uFF0C\u8FDB\u4E00\u6B65\u4FC3\u8FDB\u4E24\u56FD\u6C11\u5FC3\u76F8\u901A\u3002\u003C/p\u003E\n\u003Cp\u003E\u5C55\u89C8\u5448\u73B0\u768443\u4EF6\u85CF\u54C1\u5305\u62EC\u6765\u81EA\u4E0D\u540C\u65F6\u671F\u7684\u77F3\u7ECF\u3001\u7EB8\u7ECF\u548C\u6728\u677F\u7ECF\u3002\u73B0\u573A\u8FD8\u8BBE\u6709\u6728\u677F\u7ECF\u62D3\u5370\u4E92\u52A8\u5DE5\u4F5C\u574A\uFF0C\u53C2\u89C2\u8005\u4E5F\u53EF\u4F69\u6234VR\u773C\u955C\uFF0C\u96F6\u8DDD\u79BB\u63A5\u89E6\u623F\u5C71\u77F3\u7ECF\u520A\u523B\u8D77\u6E90\u5730\u96F7\u97F3\u6D1E\u3002\u003C/p\u003E\n\u003Cp\u003E\u8BE5\u5C55\u5C06\u4E8E\u4ECA\u5E747\u670826\u65E5\u81F38\u670810\u65E5\u5728KEN Gallery TTDI \u514D\u8D39\u5411\u5F53\u5730\u516C\u4F17\u5F00\u653E\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/07/frc-07184cae66708653330394ef2b65f1a6.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u66F4\u591A\u7CBE\u5F69\uFF0C\u656C\u8BF7\u5173\u6CE8\uFF1A\u003C/p\u003E\n\u003Cp\u003E\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5B98\u7F51\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003Ehttps://www.chinaculturalcentre.my\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EFacebook\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u201CChina Cultural Centre in Kuala Lumpur\u201D\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u516C\u4F17\u53F7\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u201C\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u201D\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EYoutube\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u201CChina Cultural Centre in Kuala Lumpur\u201D\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003ETiktok\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u201CCCCKL\u201D\u003C/p\u003E\n\u003Chr /\u003E\n\u003Cp\u003E- End -\n\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u957F\u6309\u8BC6\u522B\u4E8C\u7EF4\u7801\n\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u83B7\u53D6\u66F4\u591A\u7CBE\u5F69\u5185\u5BB9\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u25BC\u003C/strong\u003E\n\u003C/p