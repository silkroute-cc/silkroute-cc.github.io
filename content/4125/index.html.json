{
  "id": "%e5%8f%88%e4%b8%80%e5%ae%b6%e4%b8%ad%e5%9b%bd%e8%91%97%e5%90%8d%e6%b1%bd%e8%bd%a6%e5%88%b6%e9%80%a0%e4%bc%81%e4%b8%9a%e5%9c%a8%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e8%ae%be%e7%ab%8b%e5%85%a8%e8%b5%84",
  "slug": "%e5%8f%88%e4%b8%80%e5%ae%b6%e4%b8%ad%e5%9b%bd%e8%91%97%e5%90%8d%e6%b1%bd%e8%bd%a6%e5%88%b6%e9%80%a0%e4%bc%81%e4%b8%9a%e5%9c%a8%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e8%ae%be%e7%ab%8b%e5%85%a8%e8%b5%84",
  "canonicalUrlKey": "%e5%8f%88%e4%b8%80%e5%ae%b6%e4%b8%ad%e5%9b%bd%e8%91%97%e5%90%8d%e6%b1%bd%e8%bd%a6%e5%88%b6%e9%80%a0%e4%bc%81%e4%b8%9a%e5%9c%a8%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e8%ae%be%e7%ab%8b%e5%85%a8%e8%b5%84",
  "route": "/4125/",
  "title": "\u53C8\u4E00\u5BB6\u4E2D\u56FD\u8457\u540D\u6C7D\u8F66\u5236\u9020\u4F01\u4E1A\u5728\u9A6C\u6765\u897F\u4E9A\u8BBE\u7ACB\u5168\u8D44\u5B50\u516C\u53F8",
  "summary": "\u4ECA\u5E74\u662F\u5171\u5EFA\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u5021\u8BAE\u63D0\u51FA\u5341\u5468\u5E74,\u56DE\u987E\u5341\u5E74\u53D1\u5C55\u5386\u7A0B,\u4EE5\u6C5F\u6DEE\u6C7D\u8F66\u4E3A\u4EE3\u8868\u7684\u4E2D\u56FD\u81EA\u4E3B\u54C1\u724C\u8F66\u4F01\u79EF\u6781\u201C\u8D70\u51FA\u53BB\u201D,\u53D6\u5F97\u4E86\u4E0D\u4FD7\u7684\u6210\u7EE9\u3002\u8FD1\u65E5,\u6C5F\u6DEE\u6C7D\u8F66\u6D77\u5916\u5E02\u573A\u518D\u8FCE\u597D\u6D88\u606F,\u6210\u529F\u5728\u4E00\u5E26\u4E00\u8DEF\u6CBF\u7EBF\u56FD\u5BB6\u9A6C\u6765\u897F\u4E9A\u96EA\u83AA\u5170\u5DDE\u8BBE\u7ACB\u5168\u8D44\u5B50\u516C\u53F8,\u4E3A\u4E2D\u56FD\u54C1\u724C\u6C7D\u8F66\u51FA\u6D77\u6CE8\u5165\u65B0\u52A8\u80FD\u3002 \u6C5F\u6C7D\u96C6\u56E2\u9A6C\u6765\u897F\u4E9A\u9879\u76EE\u56E2\u961F\u62DC\u8BBF\u5F53\u5730\u653F\u5E9C\u6295\u8D44\u53D1\u5C55\u90E8 \u9A6C\u6765\u897F\u4E9A\u662F\u4E1C\u5357\u4E9A\u7B2C\u4E8C\u5927\u6C7D\u8F66\u5E02\u573A,\u533A\u4F4D\u548C\u4EA7\u4E1A\u4F18\u52BF\u660E\u663E,\u501F\u52A9\u201CRCEP\u201D(\u533A\u57DF\u5168\u9762\u7ECF\u6D4E\u4F19\u4F34\u5173\u7CFB\u534F\u5B9A),\u53EF\u8F90\u5C04\u6574\u4E2A\u4E1C\u5357\u4E9A\u5E02\u573A,\u5BF9\u533A\u57DF\u5E03\u5C40\u5177\u6709\u6218\u7565\u610F\u4E49\u3002\u4ECA\u5E74\u662F\u4E2D\u9A6C\u5EFA\u7ACB\u5168\u9762\u6218\u7565\u4F19\u4F34\u5173\u7CFB10\u2026",
  "body": "\u003Cp\u003E\u4ECA\u5E74\u662F\u5171\u5EFA\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u5021\u8BAE\u63D0\u51FA\u5341\u5468\u5E74,\u56DE\u987E\u5341\u5E74\u53D1\u5C55\u5386\u7A0B,\u4EE5\u6C5F\u6DEE\u6C7D\u8F66\u4E3A\u4EE3\u8868\u7684\u4E2D\u56FD\u81EA\u4E3B\u54C1\u724C\u8F66\u4F01\u79EF\u6781\u201C\u8D70\u51FA\u53BB\u201D,\u53D6\u5F97\u4E86\u4E0D\u4FD7\u7684\u6210\u7EE9\u3002\u8FD1\u65E5,\u6C5F\u6DEE\u6C7D\u8F66\u6D77\u5916\u5E02\u573A\u518D\u8FCE\u597D\u6D88\u606F,\u6210\u529F\u5728\u4E00\u5E26\u4E00\u8DEF\u6CBF\u7EBF\u56FD\u5BB6\u9A6C\u6765\u897F\u4E9A\u96EA\u83AA\u5170\u5DDE\u8BBE\u7ACB\u5168\u8D44\u5B50\u516C\u53F8,\u4E3A\u4E2D\u56FD\u54C1\u724C\u6C7D\u8F66\u51FA\u6D77\u6CE8\u5165\u65B0\u52A8\u80FD\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/10/frc-65e14aa7696715b8bf82efd703c93aa8.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u6C5F\u6C7D\u96C6\u56E2\u9A6C\u6765\u897F\u4E9A\u9879\u76EE\u56E2\u961F\u62DC\u8BBF\u5F53\u5730\u653F\u5E9C\u6295\u8D44\u53D1\u5C55\u90E8\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u662F\u4E1C\u5357\u4E9A\u7B2C\u4E8C\u5927\u6C7D\u8F66\u5E02\u573A,\u533A\u4F4D\u548C\u4EA7\u4E1A\u4F18\u52BF\u660E\u663E,\u501F\u52A9\u201CRCEP\u201D(\u533A\u57DF\u5168\u9762\u7ECF\u6D4E\u4F19\u4F34\u5173\u7CFB\u534F\u5B9A),\u53EF\u8F90\u5C04\u6574\u4E2A\u4E1C\u5357\u4E9A\u5E02\u573A,\u5BF9\u533A\u57DF\u5E03\u5C40\u5177\u6709\u6218\u7565\u610F\u4E49\u3002\u4ECA\u5E74\u662F\u4E2D\u9A6C\u5EFA\u7ACB\u5168\u9762\u6218\u7565\u4F19\u4F34\u5173\u7CFB10\u5468\u5E74,\u660E\u5E74\u4E24\u56FD\u5C06\u8FCE\u6765\u5EFA\u4EA450\u5468\u5E74,\u7AD9\u5728\u65B0\u7684\u5386\u53F2\u8D77\u70B9\u4E0A,\u4E24\u56FD\u5982\u4F55\u6DF1\u5316\u5728\u5171\u5EFA\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u6846\u67B6\u4E0B\u7ECF\u8D38\u5408\u4F5C\u5907\u53D7\u5173\u6CE8\u3002\u003C/p\u003E\n\u003Cp\u003E\u6C5F\u6DEE\u6C7D\u8F66\u662F\u56FD\u5185\u8F83\u65E9\u5E03\u5C40\u6D77\u5916\u5E02\u573A\u7684\u6C7D\u8F66\u54C1\u724C\u4E4B\u4E00,\u5982\u4ECA\u7684\u6D77\u5916\u4E1A\u52A1\u5DF2\u7ECF\u5230\u4E86\u539A\u79EF\u8584\u53D1\u7684\u5173\u952E\u65F6\u671F\u3002\u6570\u636E\u663E\u793A,2023\u5E74\u524D\u4E09\u5B63\u5EA6\u6C5F\u6DEE\u6C7D\u8F66\u7D2F\u8BA1\u51FA\u53E312.69\u4E07\u8F86,\u540C\u6BD4\u589E\u957F58.88%;\u51FA\u53E3\u5E02\u573A\u5DF2\u8986\u76D6100\u591A\u4E2A\u5171\u5EFA\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u56FD\u5BB6,\u5E26\u52A8\u5171\u5EFA\u56FD\u5BB6\u53C2\u4E0E\u56FD\u9645\u6C7D\u8F66\u4EA7\u4E1A\u5206\u5DE5;\u5168\u740319\u5BB6\u6D77\u5916KD\u7EC4\u88C5\u5DE5\u5382\u4E2D,\u670916\u5BB6\u5206\u5E03\u5728\u5171\u5EFA\u56FD\u5BB6,\u9500\u91CF\u7EA6\u5360\u51FA\u53E3\u603B\u91CF\u768480%\u3002\u003C/p\u003E\n\u003Cp\u003E\u4F5C\u4E3A\u4E00\u5BB6\u5FD7\u5728\u5168\u7403\u6C7D\u8F66\u5E02\u573A\u7684\u7EFC\u5408\u578B\u6C7D\u8F66\u4F01\u4E1A\u96C6\u56E2,\u6C5F\u6DEE\u6C7D\u8F66\u6DF1\u77E5\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u5021\u8BAE\u610F\u4E49\u6DF1\u8FDC,\u66F4\u6DF1\u77E5\u575A\u6301\u72EC\u7ACB\u81EA\u4E3B\u3001\u6DF1\u8015\u672C\u571F\u5316\u7ECF\u8425\u7684\u91CD\u8981\u6027\u3002\u5728\u9A6C\u6765\u897F\u4E9A\u96EA\u83AA\u5170\u5DDE\u8BBE\u7ACB\u5168\u8D44\u5B50\u516C\u53F8,\u662F\u6C5F\u6DEE\u6C7D\u8F66\u5728\u6D77\u5916\u6295\u8D44\u8BBE\u7ACB\u7684\u7B2C\u516D\u4E2A\u9879\u76EE\u3001\u7B2C\u56DB\u5BB6\u5168\u8D44\u5B50\u516C\u53F8,\u6B64\u524D\u6C5F\u6DEE\u6C7D\u8F66\u5728\u8D8A\u5357\u3001\u80AF\u5C3C\u4E9A\u7B49\u56FD\u5BB6\u8BBE\u7ACB\u5408\u8D44\u6216\u72EC\u8D44\u516C\u53F8,\u624E\u6839\u4E00\u7EBF\u5F00\u5C55\u672C\u571F\u5316\u8FD0\u8425,\u5728\u6D77\u5916\u521B\u65B0\u4E86\u4E00\u5957\u53EF\u590D\u5236\u53EF\u63A8\u5E7F\u7684\u72EC\u7ACB\u81EA\u4E3B\u7ECF\u8425\u6A21\u5F0F,\u57F9\u80B2\u4E86\u4E00\u6279\u72EC\u7ACB\u81EA\u4E3B\u7ECF\u8425\u4EBA\u624D,\u5E76\u5728\u76EE\u6807\u5E02\u573A\u53D6\u5F97\u4E86\u826F\u597D\u7684\u4E1A\u7EE9\u548C\u89C4\u6A21\u3002\u6B64\u6B21\u901A\u8FC7\u5883\u5916\u6295\u8D44\u5728\u9A6C\u6765\u897F\u4E9A\u6210\u7ACB\u5168\u8D44\u5B50\u516C\u53F8,\u6C5F\u6DEE\u6C7D\u8F66\u5C06\u5728\u8BE5\u5730\u533A\u5B9E\u65BD\u5168\u65B0\u8FD0\u8425\u6A21\u5F0F,\u4EE5\u9AD8\u8D28\u91CF\u7684\u4EA7\u54C1\u548C\u670D\u52A1\u4E3A\u9A6C\u6765\u897F\u4E9A\u96EA\u83AA\u5170\u5DDE\u4EBA\u6C11\u63D0\u4F9B\u4FBF\u6377\u51FA\u884C\u7684\u89E3\u51B3\u65B9\u6848\u3002\u003C/p\u003E\n\u003Cp\u003E\u4F5C\u4E3A\u4E2D\u56FD\u54C1\u724C\u51FA\u6D77\u5178\u8303,\u6C5F\u6DEE\u6C7D\u8F66\u79EF\u6781\u54CD\u5E94\u56FD\u5BB6\u8D70\u51FA\u53BB\u6218\u7565\u548C\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u5021\u8BAE,\u6269\u5C55\u6D77\u5916\u4E1A\u52A1,\u4E0D\u4EC5\u66F4\u597D\u7684\u6EE1\u8DB3\u4E86\u4E0D\u540C\u5730\u533A\u7684\u6C7D\u8F66\u5E02\u573A\u9700\u6C42,\u4E5F\u63A8\u52A8\u4E86\u56FD\u5185\u56FD\u9645\u53CC\u5FAA\u73AF\u76F8\u4E92\u4FC3\u8FDB\u7684\u53D1\u5C55\u65B0\u683C\u5C40\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/_iXWh9g_1vz5RZKweizmEA\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
