{
  "id": "\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38\u5C40",
  "slug": "\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38\u5C40",
  "canonicalUrlKey": "\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38\u5C40",
  "route": "/6029/",
  "title": "\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38\u5C40",
  "summary": "2026\u5E746\u6708\u81F37\u6708\uFF0C\u9A6C\u6765\u897F\u4E9A\u5C06\u8FCE\u6765\u4E09\u5927\u6587\u5316\u72C2\u6B22\u8282\uFF1A\u6021\u4FDD\u9A6C\u6765\u897F\u4E9A\u6587\u5316\u8282\uFF086\u670825\u65E5\u81F328\u65E5\uFF09\u6C47\u805A\u6C11\u65CF\u7F8E\u98DF\u3001\u6C11\u95F4\u6E38\u620F\u3001\u624B\u5DE5\u827A\u4F53\u9A8C\u4E0E\u6B4C\u821E\u8868\u6F14\uFF0C\u8BA9\u6E38\u5BA2\u6C89\u6D78\u5F0F\u611F\u53D7\u591A\u5143\u6587\u5316\u4E07\u82B1\u7B52\uFF1B\u6CE2\u5FB7\u7533\u68EE\u7F8E\u5170\u8282\u594F\u8282\uFF086\u670826\u65E5\u81F328\u65E5\uFF09\u4EE5Adat Perpatih\u6BCD\u7CFB\u4F20\u7EDF\u4E3A\u7279\u8272\uFF0C\u5448\u73B0\u6D3B\u6001\u7684\u89C6\u542C\u76DB\u5BB4\u4E0E\u820C\u5C16\u65C5\u884C\uFF1B\u5409\u6253\u5DDE\u6C11\u4FD7\u5609\u5E74\u534E\uFF087\u670830\u65E5\u81F38\u67082\u65E5\uFF09\u878D\u5408\u4F20\u7EDF\u6C11\u4FD7\u4E0E\u521B\u65B0\u8868\u6F14\uFF0C\u5C55\u73B0\u5317\u90E8\u72EC\u7279\u7684\u6587\u5316\u8EAB\u4EFD\u4E0E\u5386\u53F2\u8109\u7EDC\u3002\u4E09\u573A\u8282\u5E86\u8986\u76D6\u591A\u5143\u6C11\u65CF\u6587\u5316\uFF0C\u4E3A2026\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38\u5E74\u6CE8\u5165\u6D3B\u529B\u3002",
  "body": "\u003Cp\u003E# 6\u6708\u20137\u6708\uFF0C\u9A6C\u6765\u897F\u4E9A\u4E09\u5927\u6587\u5316\u72C2\u6B22\u8282\u8FDE\u756A\u70B8\u573A\u003C/p\u003E\n\u003Cp\u003E\u6D3B\u52A8\u4E00\uFF1A\u9A6C\u6765\u897F\u4E9A\u6587\u5316\u8282\uFF08\u6021\u4FDD\uFF09  \n\u0026#128197; 2026.6.25 \u2013 6.28   \n\u0026#128205;\u6021\u4FDD Sultan Azlan Shah \u73AF\u5C9B\u5E7F\u573A\u003C/p\u003E\n\u003Cp\u003E\u8FD9\u4E0D\u662F\u4E00\u573A\u666E\u901A\u7684\u8282\u5E86\uFF0C\u800C\u662F\u4E00\u573A\u628A\u9A6C\u6765\u897F\u4E9A\u6240\u6709\u6C11\u65CF\u0026quot;\u6700\u6F6E\u3001\u6700\u9177\u0026quot;\u7684\u6587\u5316\u4E00\u6B21\u642C\u5230\u4F60\u9762\u524D\u7684\u8D85\u7EA7\u5927\u6D3E\u5BF9\uFF01  \n\u0026#127860; \u4ECE\u8857\u5934\u5C0F\u5403\u5230\u4F20\u7EDF\u7F8E\u5473\uFF0C\u6837\u6837\u90FD\u80FD\u998B\u54ED\u9694\u58C1\u5C0F\u5B69\u3002  \n\u0026#127918; \u6C11\u95F4\u6E38\u620F\u3001\u624B\u5DE5\u827A\u4F53\u9A8C\u3001\u8DA3\u5473\u7ADE\u8D5B\uFF0C\u7EDF\u7EDF\u53EF\u4EE5\u4EB2\u624B\u8BD5\u3001\u4E0B\u573A\u73A9\u3002  \n\u0026#128131; \u60CA\u8273\u7684\u6C11\u65CF\u670D\u9970\u3001\u8BA9\u4EBA\u5FCD\u4E0D\u4F4F\u8DDF\u7740\u626D\u7684\u6B4C\u821E\u620F\u5267\u3002  \n\u0026#127386; \u4E0D\u662F\u5149\u770B\u4E0D\u52A8\u624B\u2014\u2014\u4F60\u80FD\u548C\u5F53\u5730\u4EBA\u4E00\u8D77\u505A\u624B\u5DE5\u3001\u4E00\u8D77\u6BD4\u8D5B\u3001\u4E00\u8D77\u7B11\u3002  \n\u4E00\u79D2\u0026quot;\u7A7F\u8D8A\u0026quot;\u5230\u5927\u9A6C\uFF0C\u4EB2\u8EAB\u4F53\u9A8C\u4EC0\u4E48\u53EB\u771F\u6B63\u7684\u0026quot;\u6587\u5316\u4E07\u82B1\u7B52\u0026quot;\u3002\u4E0D\u6765\u8840\u4E8F\uFF0C\u6765\u4E86\u5C31\u662F\u8D5A\u5230\uFF01\u003C/p\u003E\n\u003Cp\u003E\u6D3B\u52A8\u4E8C\uFF1A\u68EE\u7F8E\u5170\u8282\u594F\u8282\uFF08\u6CE2\u5FB7\u7533\uFF09  \n\u0026#128197; 2026.6.26 \u2013 6.28   \n\u0026#128205; \u6CE2\u5FB7\u7533 Pantai Batu 1, \u68EE\u7F8E\u5170\u003C/p\u003E\n\u003Cp\u003E\u4E3B\u9898\uFF1A\u0026quot;Lantai Adat, Laman Budayo\u0026quot; \u2014\u2014 \u4E60\u4FD7\u4E3A\u5730\uFF0C\u6587\u5316\u4E3A\u9662\u3002  \n\u5728\u8FD9\u91CC\uFF0C\u4F20\u7EDF\u4E0D\u662F\u6559\u79D1\u4E66\u91CC\u7684\u5E72\u5DF4\u5DF4\u540D\u8BCD\uFF0C\u800C\u662F\u4E00\u573A\u6D3B\u7684\u89C6\u542C\u76DB\u5BB4 \u002B \u820C\u5C16\u4E0A\u7684\u65C5\u884C\u3002  \n\u68EE\u7F8E\u5170\u5DDE\u72EC\u6709\u7684 Adat Perpatih \u6BCD\u7CFB\u4F20\u7EDF\uFF0C\u4ECA\u5929\u4F9D\u7136\u88AB\u4E00\u4EE3\u4EE3\u5E74\u8F7B\u4EBA\u7684\u624B\u6258\u4E3E\u7740\u3001\u547C\u5438\u7740\u3001\u6D3B\u7740\u3002  \n\u4E00\u4E2A\u8282\u65E5\uFF0C\u4E5D\u79CD\u8EAB\u4EFD\u3002\u4ECE\u8868\u6F14\u3001\u4E60\u4FD7\u5230\u7ADE\u8D5B\u3001\u624B\u5DE5\u827A\uFF0C\u6BCF\u4E00\u5904\u90FD\u5728\u6084\u6084\u8BB2\u8FF0\u8FD9\u7247\u571F\u5730\u7684\u6545\u4E8B\u3002  \n\u8FD9\u662F\u68EE\u7F8E\u5170\u732E\u7ED9 2026 \u65C5\u6E38\u5E74 \u7684\u7B2C\u4E00\u58F0\u9080\u8BF7\u3002  \n\u4F60\uFF0C\u8981\u4E0D\u8981\u6765\u73B0\u573A\u542C\u4E00\u542C\uFF1F\u003C/p\u003E\n\u003Cp\u003E\u6D3B\u52A8\u4E09\uFF1A\u5409\u6253\u5DDE\u6C11\u4FD7\u5609\u5E74\u534E  \n\u0026#128197; 2026.7.30 \u2013 8.2   \n\u0026#128205; \u5409\u6253\u5DDE\u8FBE\u9C81\u963F\u66FC\u4F53\u80B2\u573A\u003C/p\u003E\n\u003Cp\u003E\u5409\u6253\u5DDE\u6C11\u4FD7\u5609\u5E74\u534E 2026 \u2014\u2014 \u4F20\u7EDF\u4E0E\u521B\u65B0\u78B0\u649E\u7684\u590F\u65E5\u76DB\u5178\u3002  \n\u0026#127774; \u4E30\u5BCC\u672C\u571F\u6C11\u4FD7\u5143\u7D20 \u002B \u7CBE\u5F69\u6587\u5316\u8868\u6F14\uFF0C\u4E00\u79D2\u5E26\u4F60\u56DE\u5230\u8001\u5409\u6253\u3002  \n\u0026#127912; \u8FD1\u8DDD\u79BB\u611F\u53D7\u5409\u6253\u5DDE\u72EC\u6709\u7684\u6587\u5316\u8EAB\u4EFD\u4E0E\u5386\u53F2\u8109\u7EDC\uFF0C\u5728\u4E92\u52A8\u4E0E\u89C2\u8D4F\u4E2D\u54C1\u5473\u5927\u9A6C\u5317\u90E8\u7684\u827A\u672F\u4E4B\u7F8E\u3002  \n\u0026#128106; \u4EB2\u5B50\u5BB6\u5EAD\u3001\u6587\u5316\u8FF7\u3001\u65C5\u884C\u8FBE\u4EBA\u2014\u2014\u8FD9\u91CC\u90FD\u4F1A\u6210\u4E3A\u4F60\u6536\u85CF\u56DE\u5FC6\u3001\u6536\u83B7\u610F\u4E49\u65C5\u7A0B\u7684\u7EDD\u4F73\u821E\u53F0\u3002  \n\u0026#128204; \u8BB0\u5F97\u628A 7.30 \u2013 8.2 \u7559\u51FA\u6765\uFF0C\u4E00\u8D77\u8D70\u8FDB\u5409\u6253\u7684\u6545\u4E8B\u91CC\u3002\u003C/p\u003E\n",
