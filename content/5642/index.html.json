  "title": "\u4E34\u6C82\u5E02\u79D1\u6280\u804C\u4E1A\u5B66\u9662\u6B22\u8FCEMCYTT\u9879\u76EE\u3000\u674E\u5B58\u5B5D\uFF1A\u6599\u4ECA\u5E74\u7B2C\u4E09\u5B63\u529E\u77ED\u671F\u8BFE\u7A0B\u4EA4\u6D41",
  "summary": "\uFF08\u5409\u9686\u576130\u65E5\u8BAF\uFF09\u6C11\u4E3B\u884C\u52A8\u515A\u6021\u4FDD\u4E1C\u533A\u56FD\u4F1A\u8BAE\u5458\u674E\u5B58\u5B5D\u8868\u793A\uFF0C\u4E34\u6C82\u5E02\u79D1\u6280\u804C\u4E1A\u5B66\u9662\u6B22\u8FCE\u9A6C\u4E2D\u9752\u5E74\u6280\u804C\u57F9\u8BAD\u5408\u4F5C\u9879\u76EE\uFF08MCYTT\uFF09\uFF0C\u5E76\u8BA1\u5212\u4E8E\u4ECA\u5E74\u7B2C\u4E09\u5B63\u5EA6\u8FDB\u884C\u9996\u4E2A\u77ED\u671F\u8BFE\u7A0B\u4EA4\u6D41\u3002 \u4ED6\u5728\u9762\u5B50\u4E66\u4E0A\u64B0\u6587\u8868\u793A\uFF0C\u4ED6\u5728\u51FA\u5E2D\u7B2C\u56DB\u5C4ARCEP\u533A\u57DF\uFF08\u5C71\u4E1C\uFF09\u8FDB\u53E3\u5546\u54C1\u535A\u89C8\u4F1A\uFF0C\u4EE5\u9A6C\u6765\u897F\u4E9A\u4E3B\u5BBE\u56FD\u4EE3\u8868\u8EAB\u4EFD\u5C65\u804C\u7684\u56DB\u5929\u884C\u7A0B\u4E2D\uFF0C\u8D70\u8FDB\u4E34\u6C82\u5E02\u79D1\u6280\u804C\u4E1A\u5B66\u9662\u5E76\u8FDB\u884C\u4E00\u573A\u867D\u77ED\u5374\u610F\u4E49\u6DF1\u8FDC\u7684\u8BBF\u95EE\u3002 \u201C\u4E34\u6C82\u5E02\u79D1\u6280\u804C\u4E1A\u5B66\u9662\uFF0C\u6839\u690D\u4E8E\u804C\u6559\u521B\u65B0\u7684\u571F\u58E4\uFF0C\u627F\u8F7D\u8457\u5730\u65B9\u4EA7\u4E1A\u53D1\u5C55\u3001\u6280\u672F\u4F20\u64AD\u4E0E\u793E\u4F1A\u670D\u52A1\u7684\u4E09\u91CD\u4F7F\u547D\u3002\u6211\u4EEC\u53D7\u5230\u4E86\u9662\u957F\u517C\u5B66\u9662\u515A\u59D4\u2026",
  "body": "\u003Cp\u003E\uFF08\u5409\u9686\u576130\u65E5\u8BAF\uFF09\u6C11\u4E3B\u884C\u52A8\u515A\u6021\u4FDD\u4E1C\u533A\u56FD\u4F1A\u8BAE\u5458\u674E\u5B58\u5B5D\u8868\u793A\uFF0C\u4E34\u6C82\u5E02\u79D1\u6280\u804C\u4E1A\u5B66\u9662\u6B22\u8FCE\u9A6C\u4E2D\u9752\u5E74\u6280\u804C\u57F9\u8BAD\u5408\u4F5C\u9879\u76EE\uFF08MCYTT\uFF09\uFF0C\u5E76\u8BA1\u5212\u4E8E\u4ECA\u5E74\u7B2C\u4E09\u5B63\u5EA6\u8FDB\u884C\u9996\u4E2A\u77ED\u671F\u8BFE\u7A0B\u4EA4\u6D41\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u5728\u9762\u5B50\u4E66\u4E0A\u64B0\u6587\u8868\u793A\uFF0C\u4ED6\u5728\u51FA\u5E2D\u7B2C\u56DB\u5C4ARCEP\u533A\u57DF\uFF08\u5C71\u4E1C\uFF09\u8FDB\u53E3\u5546\u54C1\u535A\u89C8\u4F1A\uFF0C\u4EE5\u9A6C\u6765\u897F\u4E9A\u4E3B\u5BBE\u56FD\u4EE3\u8868\u8EAB\u4EFD\u5C65\u804C\u7684\u56DB\u5929\u884C\u7A0B\u4E2D\uFF0C\u8D70\u8FDB\u4E34\u6C82\u5E02\u79D1\u6280\u804C\u4E1A\u5B66\u9662\u5E76\u8FDB\u884C\u4E00\u573A\u867D\u77ED\u5374\u610F\u4E49\u6DF1\u8FDC\u7684\u8BBF\u95EE\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u4E34\u6C82\u5E02\u79D1\u6280\u804C\u4E1A\u5B66\u9662\uFF0C\u6839\u690D\u4E8E\u804C\u6559\u521B\u65B0\u7684\u571F\u58E4\uFF0C\u627F\u8F7D\u8457\u5730\u65B9\u4EA7\u4E1A\u53D1\u5C55\u3001\u6280\u672F\u4F20\u64AD\u4E0E\u793E\u4F1A\u670D\u52A1\u7684\u4E09\u91CD\u4F7F\u547D\u3002\u6211\u4EEC\u53D7\u5230\u4E86\u9662\u957F\u517C\u5B66\u9662\u515A\u59D4\u4E66\u8BB0\u6C88\u5982\u8302\u535A\u58EB\u7684\u70ED\u60C5\u4EB2\u81EA\u5168\u7A0B\u63A5\u5F85\u4E0E\u5DE5\u4F5C\u9910\u8C08\uFF0C\u5E76\u5C31MCYTT\u5C55\u5F00\u4E86\u771F\u8BDA\u800C\u5BCC\u6709\u6210\u6548\u7684\u5BF9\u8BDD\u3002\u201D\u003C/p\u003E\n\u003Cimg src=\u0022https://www.orientaldaily.com.my/images/uploads/news/2025/JUN_2025/20250630/68585.jpg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u4ED6\u8868\u793A\uFF0C\u6C88\u9662\u957F\u5728\u5BF9\u8BDD\u671F\u95F4\u5BF9\u5408\u4F5C\u8BA1\u5212\u8868\u793A\u70ED\u70C8\u6B22\u8FCE\uFF0C\u53CC\u65B9\u521D\u6B65\u5546\u5B9A\uFF0C\u7B56\u5212\u4ECA\u5E74\u7B2C\u4E09\u5B63\u5EA6\u8FDB\u884C\u9996\u4E2AMCYTT\u5230\u4E34\u6C82\u5E02\u79D1\u6280\u804C\u4E1A\u5B66\u9662\u7684\u77ED\u671F\u8BFE\u7A0B\u4EA4\u6D41\uFF0C\u653E\u773C\u6DB5\u76D6\u4EBA\u5DE5\u667A\u80FD\u4E0E\u673A\u5668\u4EBA\u3001\u5BA0\u7269\u62A4\u7406\u4EA7\u4E1A\u3001\u73B0\u4EE3\u519C\u4E1A\u7B49\u91CD\u70B9\u9886\u57DF\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u8FD9\u4E0D\u4EC5\u662F\u4E00\u6B21\u673A\u6784\u4E4B\u95F4\u7684\u5408\u4F5C\uFF0C\u66F4\u662F\u4E00\u573A\u56FD\u5BB6\u4E4B\u95F4\u3001\u9752\u5E74\u4E4B\u95F4\u7684\u6865\u6881\u5EFA\u8BBE\uFF0C\u662F\u4E2D\u9A6C\u672A\u6765\u804C\u4E1A\u6280\u80FD\u751F\u6001\u7684\u65B0\u706B\u82B1\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u540C\u65F6\uFF0C\u4ED6\u4E5F\u611F\u8C22\u5C71\u4E1C\u4E34\u6C82\u4E07\u5FB7\u798F\u98DF\u54C1\u6709\u9650\u516C\u53F8\u8463\u4E8B\u957F\u90ED\u5FD7\u521A\u5148\u751F\u548C\u4E34\u6C82\u5927\u5B66\u5916\u8BED\u5B66\u9662\u8C22\u6960\u6559\u6388\uFF0C\u4E3A\u6B64\u6B21\u4F1A\u9762\u6240\u4F5C\u51FA\u7684\u7CBE\u5FC3\u5B89\u6392\u3002\u4E5F\u8981\u611F\u8C22\u4E34\u6C82\u5E02\u4EBA\u6C11\u653F\u5E9C\u5916\u4E8B\u529E\u516C\u5BA4\u526F\u4E3B\u4EFB\u960E\u667A\u5E73\u5973\u58EB\uFF0C\u4EB2\u81EA\u966A\u540C\u5176\u5B8C\u6210\u8FD9\u6BB5\u5177\u6709\u6218\u7565\u610F\u4E49\u7684\u4EA4\u6D41\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u4ED6\u4EEC\u4E5F\u5B9E\u5730\u53C2\u89C2\u4E86\u5BA0\u7269\u7F8E\u5BB9\u4E0E\u62A4\u7406\u65B0\u6280\u672F\u5E08\u8D44\u57F9\u8BAD\u90E8\u3001\u666F\u89C2\u4E0E\u56ED\u6797\u8BBE\u8BA1\u7CFB\uFF0C\u4EE5\u53CA\u6821\u56ED\u5185\u7684\u73B0\u4EE3\u5316\u5B9E\u8BAD\u519C\u573A\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u6DF1\u523B\u611F\u53D7\u5230\u8BE5\u6821/\u4EE5\u7528\u4FC3\u5B66\u3001\u4EE5\u4EA7\u52A9\u6559\u2019\u7684\u6559\u80B2\u7406\u5FF5\uFF0C\u5373\u6559\u5B66\u5373\u5B9E\u6218\uFF0C\u5B9E\u8BAD\u5373\u5C31\u4E1A\u3002\u5728\u56ED\u827A\u8BBE\u8BA1\u4E0E\u519C\u573A\u57F9\u8BAD\u4E4B\u95F4\uFF0C\u65E2\u89C1\u5320\u5FC3\u80B2\u4EBA\u4E4B\u5FD7\uFF0C\u66F4\u663E\u4EA7\u4E1A\u670D\u52A1\u793E\u4F1A\u4E4B\u80FD\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8868\u793A\uFF0C\u4ED6\u4EEC\u4E5F\u5C31\u2018\u897F\u4E34\u68A6\u60F3\u5BB6\u5B66\u9662\u2019\u5C55\u5F00\u6DF1\u5165\u4EA4\u6D41\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u8BE5\u5B66\u9662\u901A\u8FC7\u2018\u804C\u666E\u878D\u901A\u3001\u4EA7\u6559\u878D\u5408\u3001\u8BFE\u5C97\u4E92\u878D\u3001\u5C31\u4E1A\u6DF1\u9020\u53CC\u901A\u3001\u6559\u80B2\u57F9\u8BAD\u4E0E\u5DE5\u4F5C\u751F\u6D3B\u4E00\u4F53\u5316\u2019\u7684\u2018\u4E09\u878D\u4E24\u901A\u4E00\u4F53\u5316\u2019\u65B0\u578B\u804C\u4E1A\u6559\u80B2\u6A21\u5F0F\uFF0C\u7CBE\u5FC3\u6253\u9020\u9879\u76EE\u5236\u5B66\u4E60\u8DEF\u5F84\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u201C\u5B66\u751F\u6309\u5C97\u4F4D\u9700\u6C42\u91CF\u8EAB\u5B9A\u5236\u8BFE\u7A0B\u5185\u5BB9\uFF0C\u5728\u2018\u5B66\u4E2D\u505A\u3001\u505A\u4E2D\u5B66\u2019\u4E2D\u5B9E\u73B0\u81EA\u6211\u7A81\u7834\uFF0C\u6210\u4E3A\u771F\u6B63\u5177\u5907\u6570\u5B57\u7D20\u517B\u3001\u793E\u4F1A\u8D23\u4EFB\u4E0E\u884C\u4E1A\u521B\u65B0\u80FD\u529B\u7684\u7EC8\u8EAB\u5B66\u4E60\u8005\u4E0E\u81EA\u6211\u4EF7\u503C\u5B9E\u73B0\u8005\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8868\u793A\uFF0C\u8BE5\u9662\u7684\u529E\u5B66\u54F2\u5B66\u4E5F\u8BA9\u5176\u6DF1\u53D7\u542F\u53D1\uFF0C\u8BE5\u9662\u4E0D\u4EC5\u57F9\u517B\u6280\u80FD\u4EBA\u624D\uFF0C\u66F4\u5851\u9020\u6709\u601D\u60F3\u3001\u6709\u6E29\u5EA6\u7684\u73B0\u4EE3\u9752\u5E74\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u4ED6\u4EEC\u5728\u8BFE\u5802\u4E2D\u5B66\u4E60\uFF0C\u4E8E\u5B9E\u8BAD\u4E2D\u78E8\u7EC3\uFF0C\u5728\u9879\u76EE\u4E2D\u6210\u957F\uFF0C\u6700\u7EC8\u5C06\u6210\u4E3A\u56FD\u5BB6\u4E0E\u793E\u4F1A\u771F\u6B63\u7684\u4E2D\u575A\u529B\u91CF\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u6559\u80B2\u65E0\u754C\uFF0C\u5408\u4F5C\u6709\u68A6\u3002\u613F\u6B64\u884C\u79CD\u4E0B\u7684\u79CD\u5B50\uFF0C\u5728\u4E2D\u9A6C\u4E24\u56FD\u7684\u9752\u5E74\u5FC3\u4E2D\u5728\u5C71\u4E1C\u4E34\u589E\u6DFB\u591A\u4E00\u4E2A\u4EA4\u6D41\u5408\u4F5C\u5B66\u4E60\u7684\u65B0\u57FA\u5730\uFF0C\u643A\u624B\u5171\u7ED8\u9A6C\u4E2D\u4E24\u56FD\u6280\u804C\u6559\u80B2\u5408\u4F5C\u7684\u58EE\u4E3D\u84DD\u56FE\uFF0C\u4E3A\u4E24\u56FD\u7684\u4E0B\u4E00\u4EE3\u94FA\u5C31\u4E00\u6761\u901A\u5411\u4E16\u754C\u7684\u91D1\u8272\u5927\u9053\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Ca href=\u0022https://www.orientaldaily.com.my/news/nation/2025/06/30/743580\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
