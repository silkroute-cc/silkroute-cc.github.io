  "title": "\u767E\u5E74\u4E2D\u570B\u9676\u74F7\u767C\u5C55\u53F2\u4E0A\u7D93\u5178\u540D\u4F5C\u4E0A\u6D77\u5C55\u51FA",
  "summary": "\u4E2D\u65B0\u7DB2\u4E0A\u6D776\u670819\u65E5\u96FB (\u8A18\u8005 \u9673\u975C)19\u65E5\u6B63\u5728\u6B64\u9593\u8209\u884C\u7684\u300A\u5E74\u8F2A\u2014\u2014\u749F\u901A\u767E\u5E74\u9676\u74F7\u5C55\u300B\u5448\u73FE\u4E86\u8FD1\u767E\u5E74\u4E2D\u570B\u9676\u74F7\u767C\u5C55\u53F2\u4E0A\u7684\u7D93\u5178\u540D\u4F5C\uFF0C\u201C\u7D05\u8272\u7684\u5149\u8F1D\u201D\u201C\u9676\u74F7\u7F8E\u8853\u5BB6\u201D\u201C\u7576\u4EE3\u9676\u74F7\u201D\u7B49\u591A\u500B\u677F\u584A\uFF0C\u52FE\u52D2\u51FA\u8FD1\u767E\u5E74\u4E2D\u570B\u9676\u74F7\u53F2\u7684\u767C\u5C55\u6B77\u7A0B\uFF0C\u540C\u6642\u586B\u88DC\u4E86\u660E\u6E05\u5B98\u7AAF\u6587\u5316\u4EE5\u5F8C\u4E2D\u570B\u8FD1\u767E\u5E74\u9676\u74F7\u6587\u5316\u5728\u5B78\u8853\u7814\u7A76\u4E0A\u7684\u7A7A\u767D\u3002 \u4E2D\u570B\u8FD1\u767E\u5E74\u9676\u74F7\u53F2\u4E0A\uFF0C\u7D05\u8272\u984C\u6750\u8CAB\u7A7F\u59CB\u7D42\uFF0C\u8A95\u751F\u4E86\u4E0D\u5C11\u6FC0\u52F5\u6C11\u773E\u7684\u6B77\u53F2\u540D\u4F5C\u3002 \u5728\u201C\u5E74\u8F2A\u201D\u5C55\u7684\u201C\u7D05\u8272\u7684\u5149\u8F1D\u201D\u677F\u584A\u4E2D\uFF0C\u6709\u4E2D\u83EF\u4EBA\u6C11\u5171\u548C\u570B\u6210\u7ACB\u521D\u671F\u6642\u5320\u4EBA\u5275\u4F5C\u7684\u5168\u5957\u5049\u4EBA\u74F7\u756B\u50CF\u3001\u7C89\u5F69\u201C\u660C\u6C5F\u901A\u666F\u201D\u2026",
  "body": "\u003Cp\u003E\u4E2D\u65B0\u7DB2\u4E0A\u6D776\u670819\u65E5\u96FB (\u8A18\u8005 \u9673\u975C)19\u65E5\u6B63\u5728\u6B64\u9593\u8209\u884C\u7684\u300A\u5E74\u8F2A\u2014\u2014\u749F\u901A\u767E\u5E74\u9676\u74F7\u5C55\u300B\u5448\u73FE\u4E86\u8FD1\u767E\u5E74\u4E2D\u570B\u9676\u74F7\u767C\u5C55\u53F2\u4E0A\u7684\u7D93\u5178\u540D\u4F5C\uFF0C\u201C\u7D05\u8272\u7684\u5149\u8F1D\u201D\u201C\u9676\u74F7\u7F8E\u8853\u5BB6\u201D\u201C\u7576\u4EE3\u9676\u74F7\u201D\u7B49\u591A\u500B\u677F\u584A\uFF0C\u52FE\u52D2\u51FA\u8FD1\u767E\u5E74\u4E2D\u570B\u9676\u74F7\u53F2\u7684\u767C\u5C55\u6B77\u7A0B\uFF0C\u540C\u6642\u586B\u88DC\u4E86\u660E\u6E05\u5B98\u7AAF\u6587\u5316\u4EE5\u5F8C\u4E2D\u570B\u8FD1\u767E\u5E74\u9676\u74F7\u6587\u5316\u5728\u5B78\u8853\u7814\u7A76\u4E0A\u7684\u7A7A\u767D\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E2D\u570B\u8FD1\u767E\u5E74\u9676\u74F7\u53F2\u4E0A\uFF0C\u7D05\u8272\u984C\u6750\u8CAB\u7A7F\u59CB\u7D42\uFF0C\u8A95\u751F\u4E86\u4E0D\u5C11\u6FC0\u52F5\u6C11\u773E\u7684\u6B77\u53F2\u540D\u4F5C\u3002\u003C/p\u003E\n\u003Cp\u003E\u5728\u201C\u5E74\u8F2A\u201D\u5C55\u7684\u201C\u7D05\u8272\u7684\u5149\u8F1D\u201D\u677F\u584A\u4E2D\uFF0C\u6709\u4E2D\u83EF\u4EBA\u6C11\u5171\u548C\u570B\u6210\u7ACB\u521D\u671F\u6642\u5320\u4EBA\u5275\u4F5C\u7684\u5168\u5957\u5049\u4EBA\u74F7\u756B\u50CF\u3001\u7C89\u5F69\u201C\u660C\u6C5F\u901A\u666F\u201D\u5718\u7D50\u676F\u4EE5\u53CA\u201C\u4E16\u754C\u548C\u5E73\u201D\u984F\u8272\u91C9\u74F6\u7B49\uFF1B\u4E00\u584A\u4E8C\u5341\u4E16\u7D0050\u5E74\u4EE3\u7A0B\u93AE\u6E90\u5275\u4F5C\u7684\u7C89\u5F69\u74F7\u677F\u201C\u8FB2\u6703\u201D\uFF0C\u662F\u7576\u6642\u4E2D\u570B\u756B\u6539\u9769\u904B\u52D5\u85DD\u8853\u5BB6\u4E0B\u9109\u751F\u6D3B\u91C7\u98A8\u7684\u6210\u679C\uFF1B\u4E8C\u5341\u4E16\u7D0060\u5E74\u4EE3\u666F\u5FB7\u93AE\u66D9\u5149\u74F7\u5EE0\u5275\u4F5C\u7684\u201C\u8349\u539F\u82F1\u96C4\u5C0F\u59D0\u59B9\u201D\u5C0D\u74F6\u30011968\u5E74\u666F\u5FB7\u93AE\u9676\u74F7\u5B78\u9662\u5275\u4F5C\u7684\u201C\u516B\u5973\u6295\u6C5F\u201D\u74F6\u5747\u6975\u5BCC\u6559\u80B2\u610F\u7FA9\uFF0C\u8B1B\u8FF0\u7684\u6545\u4E8B\u5F71\u97FF\u4E86\u5E7E\u4EE3\u4EBA\uFF1B\u201C\u6C34\u9EDE\u6843\u82B1\u201D\u201C\u7FE0\u7AF9\u7D05\u6885\u201D\u662F\u666F\u5FB7\u93AE\u7279\u5730\u70BA\u570B\u5BB6\u9818\u5C0E\u4EBA\u6240\u5236\u7684\u9910\u5177\uFF0C\u88AB\u7A31\u70BA\u201C7501\u201D\u74F7\uFF0C\u9019\u6279\u7D05\u8272\u9676\u74F7\u7CBE\u54C1\u4E00\u76F4\u5099\u53D7\u6536\u85CF\u754C\u9752\u7750\u3002\u64DA\u4E86\u89E3\uFF0C\u9019\u4E9B\u201C7501\u201D\u74F7\uFF0C\u8B93\u89C0\u773E\u9818\u7565\u90A3\u500B\u5E74\u4EE3\u666F\u5FB7\u93AE\u9676\u74F7\u4EBA\u6EFF\u542B\u6DF1\u60C5\u6240\u5275\u9020\u7684\u7D93\u5178\u4F5C\u54C1\u3002\u003C/p\u003E\n\u003Cimg src=\u0022http://picture01.52hrttpic.com/image/infoImage/202106/19/D1623836803770.jpeg?536x540\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u512A\u79C0\u9676\u74F7\u85DD\u8853\u5BB6\u4E0D\u65B7\u5275\u65B0\u3002\u4E0A\u6D77\u749F\u901A\u85DD\u8853\u4E2D\u5FC3\u4F9B\u5716\u003C/p\u003E\n\u003Cp\u003E\u4E0A\u6D77\u749F\u901A\u85DD\u8853\u4E2D\u5FC3\u8CA0\u8CAC\u4EBA\u718A\u666F\u862D19\u65E5\u63A5\u53D7\u8A18\u8005\u91C7\u8A2A\u6642\u8868\u793A\uFF0C\u749F\u901A\u5C0D\u4E8E\u4EE5\u666F\u5FB7\u93AE\u70BA\u4EE3\u8868\u7684\u8FD1\u767E\u5E74\u4E2D\u570B\u9676\u74F7\u7684\u4F5C\u54C1\u6536\u85CF\u3001\u6587\u5316\u63A8\u5EE3\u548C\u5B78\u8853\u7814\u7A76\u5DF2\u7D93\u6301\u7E8C\u9032\u884C\u4E8630\u5E74\uFF0C\u7CFB\u7D71\u5730\u6536\u85CF\u4E86\u666F\u5FB7\u93AE\u9676\u74F7\u8FD1\u767E\u5E74\u7684\u85DD\u8853\u7D50\u6676\u3002\u003C/p\u003E\n\u003Cp\u003E\u64DA\u4E86\u89E3\uFF0C\u8FD1\u767E\u5E74\u4F86\u7684\u4E2D\u570B\u9676\u74F7\u85DD\u8853\uFF0C\u63A5\u7E8C\u4E86\u660E\u6E05\u5B98\u7AAF\u7684\u6587\u8108\uFF0C\u5E76\u4E0D\u65B7\u7DBB\u653E\u6642\u4EE3\u98A8\u91C7\u3002\u8A18\u8005\u770B\u5230\uFF0C\u4E00\u5C0D\u665A\u6E05\u6C11\u570B\u6642\u671F\u7684\u7D05\u5F69\u96D9\u9F8D\u7D0B\u5929\u96DE\u9215\u9AD8\u8DB3\u84CB\u7F50\uFF0C\u898B\u8B49\u4E86\u4E2D\u570B\u5B98\u7AAF\u9676\u74F7\u6587\u5316\u7684\u4F59\u6656\uFF1B\u201C\u73E0\u5C71\u516B\u53CB\u201D\u662F\u6C11\u570B\u6642\u671F\u666F\u5FB7\u93AE\u6700\u5927\u7684\u9676\u74F7\u5546\u696D\u6D41\u6D3E\uFF0C\u5F71\u97FF\u8513\u5EF6\u4E86\u6578\u5341\u5E74\uFF0C\u5C55\u89BD\u4E2D\u6709\u201C\u73E0\u5C71\u516B\u53CB\u201D\u5F8C\u4EE3\u738B\u7B71\u862D\u3001\u9127\u8096\u79B9\u3001\u738B\u932B\u826F\u7B49\u4EBA\u4F5C\u54C1\uFF0C\u986F\u793A\u4E86\u50B3\u7D71\u9676\u74F7\u6587\u5316\u7684\u6D41\u6D3E\u50B3\u627F\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E2D\u83EF\u4EBA\u6C11\u5171\u548C\u570B\u6210\u7ACB\u521D\u671F\uFF0C\u666F\u5FB7\u93AE\u9676\u5341\u5927\u74F7\u5EE0\u76F8\u7E7C\u6210\u7ACB\uFF0C\u8001\u85DD\u4EBA\u7165\u767C\u9752\u6625\uFF0C\u70BA\u6642\u4EE3\u800C\u4F5C\u3002\u64DA\u6089\uFF0C\u666F\u5FB7\u93AE\u9676\u74F7\u66FE\u5728\u8A08\u5283\u7D93\u6FDF\u6642\u671F\u627F\u64D4\u4E86\u570B\u5BB6\u51FA\u53E3\u5275\u532F\u7684\u91CD\u4EFB\uFF0C\u5C55\u89BD\u4E2D\uFF0C\u6709\u591A\u4EF6\u4F5C\u54C1\u7684\u984F\u8272\u3001\u9020\u578B\u3001\u7D0B\u6A23\u3001\u71D2\u9020\u5DE5\u85DD\u7B49\u5747\u9054\u5230\u4E86\u8F03\u9AD8\u7684\u85DD\u8853\u6C34\u6E96\u3002\u5B83\u5011\u662F\u5C0D\u4E2D\u570B\u50B3\u7D71\u9676\u74F7\u6587\u5316\u7684\u52E0\u529B\u50B3\u627F\uFF0C\u66F4\u662F\u5C0D\u50B3\u7D71\u6587\u5316\u7684\u63A8\u9673\u51FA\u65B0\u3002\u003C/p\u003E\n\u003Cp\u003E\u5C55\u89BD\u4E2D\uFF0C\u201C\u4E16\u754C\u548C\u5E73\u201D\u984F\u8272\u91C9\u74F6\u3001\u5718\u7D50\u676F\u7B49\uFF0C\u90FD\u98FD\u542B\u7740\u90A3\u500B\u5E74\u4EE3\u7279\u6709\u7684\u4FE1\u606F\u3002\u003C/p\u003E\n\u003Cp\u003E\u7576\u4EE3\u9676\u74F7\u85DD\u8853\u5BB6\u52AA\u529B\u7528\u5728\u9676\u74F7\u6587\u5316\u4E2D\u878D\u5165\u7576\u4EE3\u8A9E\u532F\u3002\u5C55\u89BD\u4E2D\uFF0C\u77E5\u540D\u666F\u5FB7\u93AE\u85DD\u8853\u5BB6\u89E3\u5F37\u5275\u4F5C\u7684\u77F3\u5EAB\u9580\u5927\u578B\u65B9\u74F6\uFF0C\u7528\u666F\u5FB7\u93AE\u74F7\u571F\u5448\u73FE\u6D77\u6D3E\u6587\u5316\uFF1B\u85DD\u8853\u5BB6\u5F35\u570B\u541B\u6B77\u6642\u5169\u5E74\u591A\u53CD\u5FA9\u5BE6\u9A57\u3001\u71D2\u9020\u7684\u5927\u578B\u74F7\u677F\u300A\u4E95\u5CA1\u6668\u8F1D\u300B\uFF0C\u5C06\u500B\u4EBA\u98A8\u683C\u8207\u6642\u4EE3\u7CBE\u795E\u76F8\u7D50\u5408\u3002\u003C/p\u003E\n\u003Cp\u003E\u5728\u6587\u5316\u5168\u7403\u5316\u6D6A\u6F6E\u4E2D\uFF0C\u512A\u79C0\u9676\u74F7\u85DD\u8853\u5BB6\u4E0D\u65B7\u5F9E\u50B3\u627F\u4E2D\u8D70\u5411\u5275\u65B0\uFF0C\u958B\u62D3\u51FA\u4E2D\u570B\u9676\u74F7\u7684\u65B0\u5929\u5730\u3002\u5982\u738B\u932B\u826F\u300A\u5C71\u6708\u7167\u5F48\u7434\u300B\u8336\u58FA\u3001\u5F35\u677E\u8302\u201C\u6885\u82B1\u9AD8\u8DB3\u7897\u201D\u548C\u201C\u7261\u4E39\u201D\u74F7\u677F\u3001\u5468\u570B\u6862\u201C\u6CE2\u65AF\u8C93\u201D\u96D5\u5851\u3001\u674E\u83CA\u751F\u201C\u7D72\u7BA1\u9189\u6625\u98A8\u201D\u74F6\u3001\u79E6\u932B\u9E9F\u7684\u9752\u82B1\u201C\u79CB\u83CA\u201D\u51AC\u74DC\u74F6\u7B49\u7B49\uFF0C\u90FD\u986F\u793A\u51FA\u4E2D\u570B\u73FE\u7576\u4EE3\u9676\u74F7\u85DD\u8853\u5BB6\u5011\u7684\u92B3\u610F\u9032\u53D6\u7684\u7CBE\u795E\u3002\u003C/p\u003E\n\u003Cp\u003E\u5728\u201C\u7576\u4EE3\u9676\u74F7\u201D\u677F\u584A\u4E2D\uFF0C\u4E2D\u570B\u9676\u74F7\u65B0\u4E00\u4EE3\u9818\u8ECD\u4EBA\u7269\u767D\u660E\u3001\u767D\u78CA\u7684\u4EE3\u8868\u4F5C\u5C55\u51FA\uFF0C\u4ED6\u5011\u878D\u532F\u4E2D\u897F\u7684\u5168\u65B0\u5BE9\u7F8E\uFF0C\u5C0D\u4E2D\u570B\u9676\u74F7\u9032\u884C\u4E86\u7576\u4EE3\u6587\u5316\u7684\u95E1\u91CB\u3002\u5F35\u570B\u541B\u3001\u5289\u6B63\u3001\u718A\u958B\u6CE2\u7B49\u7576\u4EE3\u5B78\u9662\u6D3E\u9676\u74F7\u85DD\u8853\u7CBE\u82F1\uFF0C\u4E5F\u90FD\u5448\u73FE\u4E86\u4ED6\u5011\u6700\u65B0\u7684\u529B\u4F5C\u3002\u5F35\u570B\u541B\u5C55\u51FA\u4E86\u74F7\u677F\u9577\u5377\u300A\u5343\u88CF\u6C5F\u5C71\u5716\u300B\uFF0C\u5289\u6B63\u5C55\u51FA\u4E86\u7F85\u6F22\u74F7\u677F\u56DB\u689D\u5C4F\uFF0C\u718A\u958B\u6CE2\u5C55\u51FA\u4E86\u4ED6\u525B\u525B\u69AE\u7372\u6D59\u6C5F\u7F8E\u5C55\u91D1\u734E\u548C\u5168\u570B\u7F8E\u5C55\u512A\u79C0\u734E\u7684\u300A\u9F0E\u8208\u4E2D\u83EF\u300B\u3002\u003C/p\u003E\n\u003Cp\u003E\u8FD1\u5E7E\u5E74\uFF0C\u4E00\u6279\u4E2D\u570B\u7576\u4EE3\u85DD\u8853\u5BB6\u3001\u5B78\u8005\u8DE8\u754C\u800C\u4F86\uFF0C\u8207\u9676\u74F7\u7D50\u7DE3\uFF0C\u9019\u4E5F\u662F\u749F\u901A\u85DD\u8853\u4E2D\u5FC3\u6B63\u5728\u63A2\u7D22\u7684\u4E00\u689D\u5177\u6709\u6F5B\u529B\u7684\u4E2D\u570B\u9676\u74F7\u65B0\u8DEF\u5F91\u3002\u64DA\u4E86\u89E3\uFF0C\u5927\u5B78\u8005\u5085\u7533\u5148\u751F\u7684\u66F8\u6CD5\u74F7\u74F6\u3001\u201C\u5954\u725B\u201D\u74F7\u76E4\u3001\u201C\u91D1\u8679\u201D\u90CE\u7D05\u5927\u7F38\u7B49\u4F5C\u54C1\uFF0C\u90FD\u53CD\u6620\u4E86\u4E2D\u570B\u7576\u4EE3\u85DD\u8853\u5BB6\u5B6B\u826F\u5168\u65B0\u7684\u85DD\u8853\u5275\u610F\u548C\u8DE8\u8D8A\u5F0F\u7684\u5BE9\u7F8E\u80FD\u529B\u3002(\u5B8C)\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1Ahttp://www.52hrtt.com/webservicepage_getInformationPage.do?id=D1623836803775\u0026amp;areaId=109\u0026amp;languageId=7\u0026amp;behaviorSource=4\u003C/p\u003E\n",
