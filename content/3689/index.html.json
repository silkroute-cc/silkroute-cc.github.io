  "route": "/3689/",
  "title": "\u9A6C\u6765\u897F\u4E9A\u5EFA\u7B51\u5DE5\u4E1A\u53D1\u5C55\u5C40\uFF1A\u52A0\u5FEB\u65BD\u5DE5\u51CF\u5C11\u4F9D\u8D56\u5916\u52B3",
  "summary": "\uFF08\u5409\u9686\u57611\u65E5\u8BAF\uFF09\u5927\u9A6C\u5EFA\u7B51\u5DE5\u4E1A\u53D1\u5C55\u5C40\u603B\u6267\u884C\u957F\u62FF\u7763\u963F\u672B\u963F\u65AF\u91CC\u6307\u51FA\uFF0C\u6211\u56FD\u5DE5\u4E1A\u5316\u5EFA\u7B51\u7CFB\u7EDF\uFF08IBS\uFF09\u8FC7\u53BB15\u5E74\u5728\u653F\u5E9C\u591A\u9879\u653F\u7B56\u652F\u6301\u4E0B\u7A33\u5065\u53D1\u5C55\uFF0C\u4ECA\u5E74\u5EFA\u7B51\u9879\u76EE\u5C24\u5176\u662F\u79C1\u4EBA\u754C\u9879\u76EE\u91C7\u7528IBS\u7387\u6709\u671B\u589E\u52A010\u81F315%\u3002 \u4ED6\u63A5\u53D7\u9A6C\u65B0\u793E\u8BBF\u95EE\u65F6\u6307\u51FA\uFF0C\u57282021\u5E74\uFF0C\u653F\u5E9C\u9879\u76EE\u91C7\u7528IBS\u7387\u589E\u52A0\u81F384%\uFF0C\u800C2020\u5E74\u4E3A79.5%\uFF0C\u5728\u79C1\u4EBA\u9879\u76EE\uFF0C\u5219\u4ECE2020\u5E7441%\u589E\u81F32021\u5E74\u768460%\u3002 \u4ED6\u8BF4\uFF0C\u91C7\u7528IBS\u4E0D\u4EC5\u63D0\u9AD8\u5EFA\u7B51\u8D28\u91CF\u548C\u6210\u672C\uFF0C\u51CF\u5C11\u4F9D\u8D56\u5916\u52B3\uFF0C\u800C\u4E14\u52A0\u5FEB\u65BD\u5DE5\u8FDB\u5EA6\u3001\u7B80\u5316\u73B0\u573A\u7BA1\u7406\u4E0E\u5B89\u5168\uFF0C\u4EE5\u53CA\u51CF\u5C11\u5EFA\u7B51\u4E1A\u5BF9\u73AF\u5883\u7684\u5F71\u54CD\u3002\u2026",
  "body": "\u003Cp\u003E\uFF08\u5409\u9686\u57611\u65E5\u8BAF\uFF09\u5927\u9A6C\u5EFA\u7B51\u5DE5\u4E1A\u53D1\u5C55\u5C40\u603B\u6267\u884C\u957F\u62FF\u7763\u963F\u672B\u963F\u65AF\u91CC\u6307\u51FA\uFF0C\u6211\u56FD\u5DE5\u4E1A\u5316\u5EFA\u7B51\u7CFB\u7EDF\uFF08IBS\uFF09\u8FC7\u53BB15\u5E74\u5728\u653F\u5E9C\u591A\u9879\u653F\u7B56\u652F\u6301\u4E0B\u7A33\u5065\u53D1\u5C55\uFF0C\u4ECA\u5E74\u5EFA\u7B51\u9879\u76EE\u5C24\u5176\u662F\u79C1\u4EBA\u754C\u9879\u76EE\u91C7\u7528IBS\u7387\u6709\u671B\u589E\u52A010\u81F315%\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u63A5\u53D7\u9A6C\u65B0\u793E\u8BBF\u95EE\u65F6\u6307\u51FA\uFF0C\u57282021\u5E74\uFF0C\u653F\u5E9C\u9879\u76EE\u91C7\u7528IBS\u7387\u589E\u52A0\u81F384%\uFF0C\u800C2020\u5E74\u4E3A79.5%\uFF0C\u5728\u79C1\u4EBA\u9879\u76EE\uFF0C\u5219\u4ECE2020\u5E7441%\u589E\u81F32021\u5E74\u768460%\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u91C7\u7528IBS\u4E0D\u4EC5\u63D0\u9AD8\u5EFA\u7B51\u8D28\u91CF\u548C\u6210\u672C\uFF0C\u51CF\u5C11\u4F9D\u8D56\u5916\u52B3\uFF0C\u800C\u4E14\u52A0\u5FEB\u65BD\u5DE5\u8FDB\u5EA6\u3001\u7B80\u5316\u73B0\u573A\u7BA1\u7406\u4E0E\u5B89\u5168\uFF0C\u4EE5\u53CA\u51CF\u5C11\u5EFA\u7B51\u4E1A\u5BF9\u73AF\u5883\u7684\u5F71\u54CD\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u5F88\u591A\u5927\u578B\u53D1\u5C55\u5546\u5728\u4ED6\u4EEC\u7684\u9879\u76EE\u4E2D\u4F7F\u7528IBS\uFF0C\u5E76\u53D6\u5F97\u826F\u597D\u6548\u679C\uFF0C\u5373\u91D1\u52A1\u5927\u96C6\u56E2\uFF08Gamuda\uFF09\u3001\u5B9E\u8FBE\u96C6\u56E2\uFF08SP Setia\uFF09\u3001\u9A6C\u661F\u96C6\u56E2\uFF08Mah Sing\uFF09\u53CA \u96EA\u5170\u83AA\u5DDE\u53D1\u5C55\u673A\u6784\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6B64\u5916\uFF0C\u8FD8\u6709\u5C11\u6570\u5EFA\u7B51\u516C\u53F8\u62E5\u6709\u81EA\u5DF1\u7684IBS\u6280\u672F\u548C\u751F\u4EA7\u8BBE\u65BD\uFF0C\u56E0\u4E3A\u5B83\u4EEC\u5BF9\u9879\u76EE\u6709\u53EF\u6301\u7EED\u7684\u9700\u6C42\uFF0C\u5176\u4E2D\u5305\u62EC\u6021\u4FDD\u5DE5\u7A0B\uFF08IJM\uFF09\u3001\u91D1\u52A1\u5927\u3001\u9A6C\u8D44\u6E90\uFF08MRCB\uFF09\u3001\u5B9E\u8FBE\u96C6\u56E2\u3001\u53CC\u5A01\u96C6\u56E2\uFF08Sunway\uFF09\u3001\u6797\u6728\u751F\u96C6\u56E2\uFF08LBS Bina\uFF09\u53CA\u78A7\u6842\u56ED\u592A\u5E73\u6D0B\u666F\u6709\u9650\u516C\u53F8\uFF08Country Garden Pacificview\uFF09\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u622A\u81F3\u4ECA\u5E743\u6708\uFF0C\u9A6C\u6765\u897F\u4E9A\u6709118\u95F4IBS\u4F9B\u5E94\u5546\uFF0C\u6DB5\u76D6\u6240\u6709\u7C7B\u578B\u7684IBS\u7EC4\u522B\u3002\u003C/p\u003E\n\u003Cp\u003E\u963F\u672B\u963F\u65AF\u91CC\u63D0\u5230\uFF0C\u81EA2008\u5E74\uFF0CIBS\u5DF2\u6388\u6743\u5728\u653F\u5E9C\u9879\u76EE\u4F7F\u7528\uFF0C\u79C1\u4EBA\u9879\u76EE\u5219\u4ECE2018\u5E741\u670810\u65E5\u8D77\u91C7\u7528\uFF0C\u5F53\u65F6\u623F\u5C4B\u53CA\u5730\u65B9\u653F\u5E9C\u90E8\u8981\u6C42\u4EF7\u503C5000\u4E07\u4EE4\u5409\u53CA\u4EE5\u4E0A\u9879\u76EE\u7684IBS\u5206\u6570\u81F3\u5C1150\u5206\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u76EE\u524D\u653F\u5E9C\u6B63\u5728\u5BA1\u67E5\u8FD9\u9879\u901A\u4EE4\uFF0C\u5C06\u5206\u6570\u63D0\u9AD8\u523070\u5206\uFF0C\u4F5C\u4E3A\u6700\u5927\u9650\u5EA6\u5730\u91C7\u7528IBS\u7684\u63AA\u65BD\uFF0C\u51CF\u5C11\u9879\u76EE\u73B0\u573A\u7684\u52B3\u52A8\u529B\u4F9D\u8D56\u6765\u63D0\u9AD8\u751F\u4EA7\u529B\u3002\u5C06IBS\u5206\u6570\u63D0\u9AD8\u81F370\u5206\u5EFA\u8BAE\u5DF2\u57282021\u5E745\u670819\u65E5\u83B7\u5F97\u5185\u9601\u6279\u51C6\uFF0C\u65B0\u901A\u4EE4\u5F88\u5FEB\u5BF9\u5916\u516C\u5E03\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u4E5F\u8BF4\uFF0CIBS\u5DF2\u8BC1\u660E\u80FD\u591F\u7F29\u77ED\u9879\u76EE\u7AE3\u5DE5\u65F6\u95F4\u548C\u63D0\u9AD8\u5DE5\u4F5C\u8D28\u91CF\uFF0C\u4ECE\u800C\u4F7F\u5EFA\u7B51\u4E1A\u66F4\u5177\u6210\u672C\u6548\u76CA\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E0D\u8FC7\uFF0C\u4ED6\u8BF4\uFF0C\u5728\u6211\u56FD\uFF0CIBS\u4ECD\u7136\u662F\u5173\u4E8E\u7EC4\u4EF6\u5236\u9020\uFF0C\u800C\u5728\u8BB8\u591A\u5176\u4ED6\u56FD\u5BB6\uFF0CIBS\u6B63\u5E94\u7528\u4E8E\u6A21\u5757\u5316\u5EFA\u7B51\uFF0C\u4F7F\u4F01\u4E1A\u80FD\u591F\u5B9E\u73B0\u66F4\u9AD8\u7684\u6210\u672C\u548C\u65F6\u95F4\u6548\u7387\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u56E0\u6B64\uFF0C\u5728\u672A\u6765\uFF0C\u6211\u4EEC\u5C06\u770B\u5230\u66F4\u591A\u91C7\u7528\u6A21\u5757\u5316\u5EFA\u7B51\u548C\u5F00\u53D1\u66F4\u5148\u8FDB\u6280\u672F\u63D0\u9AD8\u5EFA\u7B51\u884C\u4E1A\u751F\u4EA7\u529B\uFF0C\u4F8B\u59823D\u6253\u5370\u3001\u673A\u5668\u4EBA\u6280\u672F\u548C\u5176\u4ED6\u667A\u80FD\u5EFA\u7B51\u6280\u672F\u3002\u003C/p\u003E\n\u003Cp\u003E\u6B64\u5916\uFF0C\u4ED6\u8BA4\u4E3A\uFF0C\u6211\u56FD\u5EFA\u7B51\u4E1A\u91C7\u7528\u5EFA\u7B51\u4FE1\u606F\u6A21\u578B\uFF08BIM\uFF09\u6280\u672F\u5C06\u4F7F\u5EFA\u7B51\u73AF\u5883\u751F\u547D\u5468\u671F\u7BA1\u7406\u66F4\u52A0\u9AD8\u6548\u548C\u6709\u6548\uFF0C\u8FDB\u800C\u63D0\u9AD8\u5EFA\u7B51\u9879\u76EE\u7684\u751F\u4EA7\u529B\u548C\u53EF\u6301\u7EED\u6027\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8865\u5145\uFF0CBIM\u7684\u667A\u80FD\u6570\u5B57\u6A21\u578B\u6709\u5229\u4E8E\u5EFA\u7B51\u9879\u76EE\u7684\u5404\u4E2A\u9636\u6BB5\uFF0C\u56E0\u4E3A\u5404\u65B9\u53EF\u4EE5\u8FDB\u63A5\u548C\u66F4\u65B0\u540C\u4E00\u4E2A\u6570\u5B57\u6A21\u578B\uFF0C\u4EE5\u4FC3\u8FDB\u534F\u8C03\u3001\u6C9F\u901A\u3001\u5206\u6790\u3001\u9879\u76EE\u7BA1\u7406\uFF0C\u751A\u81F3\u8D44\u4EA7\u7BA1\u7406\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/HBz5uDr00JH3yYZITU3Vcg\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
