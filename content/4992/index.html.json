  "canonicalUrlKey": "%e8%bf%9e%e6%8e%a5%e8%80%81%e8%b6%8a%e6%9e%97%e6%a2%a6-%e7%bb%95%e8%bf%87%e6%b1%b6%e8%8e%b1-72%e4%ba%bf%e4%bb%a4%e5%90%89%e4%bf%ae%e7%ad%91%e7%a0%82%e6%b2%99%e8%bf%9e%e8%b4%af%e8%b7%af",
  "route": "/4992/",
  "title": "\u8FDE\u63A5\u8001\u8D8A\u6797\u68A6 \u7ED5\u8FC7\u6C76\u83B1 72\u4EBF\u4EE4\u5409\u4FEE\u7B51\u7802\u6C99\u8FDE\u8D2F\u8DEF",
  "summary": "\uFF08\u7F8E\u91CC29\u65E5\u8BAF\uFF09\u4E00\u65E6\u8DE8\u5A46\u7F57\u6D32\u5927\u9053\u4EE5\u53CA\u7802\u62C9\u8D8A\u6C99\u5DF4\u8FDE\u8D2F\u9053\u8DEF\u7684\u5927\u578B\u516C\u8DEF\u9879\u76EE\u5B8C\u5DE5\uFF0C\u7802\u62C9\u8D8A\u5317\u533A\u7684\u516C\u8DEF\u8FDE\u901A\u6027\u5C06\u5F97\u5230\u663E\u8457\u6539\u5584\u3002 \u7802\u62C9\u8D8A\u57FA\u672C\u8BBE\u65BD\u4E0E\u6D77\u6E2F\u53D1\u5C55\u90E8\u526F\u90E8\u957F\u62FF\u7763\u827E\u8FEA\u62C9\u91CC\u4E4C\u4ECA\u65E5\u5728\u53CC\u6EAA\u90FD\u4E5D\u5173\u5361\u5DE1\u89C6\u8DE8\u5A46\u7F57\u6D32\u5927\u9053\u5DE5\u7A0B\u65F6\uFF0C\u5982\u6B64\u8868\u793A\u3002 \u4ED6\u8BF4\uFF0C\u8DE8\u5A46\u7F57\u6D32\u5927\u9053\u9879\u76EE\u65E8\u5728\u5347\u7EA7\u73B0\u6709\u4ECE\u7F8E\u91CC\u5230\u6797\u68A6\u548C\u8001\u8D8A\u7684\u9053\u8DEF\uFF0C\u7ECF\u6C76\u83B1\u5EF6\u4F38\u81F3\u6C99\u5DF4\uFF0C\u5168\u957F93.25\u516C\u91CC\u3002\u56E0\u6B64\u5728\u8FD9\u9879\u76EE\u4E0B\u6709\u8DE8\u5A46\u7F57\u6D32\u5927\u9053 (LTB)\u3001\u7802\u62C9\u8D8A\u6C99\u5DF4\u8FDE\u63A5\u8DEF\u9879\u76EE\u7B2C\u4E00\u9636\u6BB5 (SSLR 1) \u548C\u7802\u62C9\u8D8A\u6C99\u5DF4\u8FDE\u63A5\u8DEF\u9879\u76EE\u7B2C\u4E8C\u9636\u6BB5 (SSLR 2)\u3002 \u9996\u9636\u6BB5\u5DE5\u7A0B\u8FDB\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/08/frc-dfeca3acdf6631f9ad83eb8727b97da0.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\uFF08\u7F8E\u91CC29\u65E5\u8BAF\uFF09\u4E00\u65E6\u8DE8\u5A46\u7F57\u6D32\u5927\u9053\u4EE5\u53CA\u7802\u62C9\u8D8A\u6C99\u5DF4\u8FDE\u8D2F\u9053\u8DEF\u7684\u5927\u578B\u516C\u8DEF\u9879\u76EE\u5B8C\u5DE5\uFF0C\u7802\u62C9\u8D8A\u5317\u533A\u7684\u516C\u8DEF\u8FDE\u901A\u6027\u5C06\u5F97\u5230\u663E\u8457\u6539\u5584\u3002\u003C/p\u003E\n\u003Cp\u003E\u7802\u62C9\u8D8A\u57FA\u672C\u8BBE\u65BD\u4E0E\u6D77\u6E2F\u53D1\u5C55\u90E8\u526F\u90E8\u957F\u62FF\u7763\u827E\u8FEA\u62C9\u91CC\u4E4C\u4ECA\u65E5\u5728\u53CC\u6EAA\u90FD\u4E5D\u5173\u5361\u5DE1\u89C6\u8DE8\u5A46\u7F57\u6D32\u5927\u9053\u5DE5\u7A0B\u65F6\uFF0C\u5982\u6B64\u8868\u793A\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u8DE8\u5A46\u7F57\u6D32\u5927\u9053\u9879\u76EE\u65E8\u5728\u5347\u7EA7\u73B0\u6709\u4ECE\u7F8E\u91CC\u5230\u6797\u68A6\u548C\u8001\u8D8A\u7684\u9053\u8DEF\uFF0C\u7ECF\u6C76\u83B1\u5EF6\u4F38\u81F3\u6C99\u5DF4\uFF0C\u5168\u957F93.25\u516C\u91CC\u3002\u56E0\u6B64\u5728\u8FD9\u9879\u76EE\u4E0B\u6709\u8DE8\u5A46\u7F57\u6D32\u5927\u9053 (LTB)\u3001\u7802\u62C9\u8D8A\u6C99\u5DF4\u8FDE\u63A5\u8DEF\u9879\u76EE\u7B2C\u4E00\u9636\u6BB5 (SSLR 1) \u548C\u7802\u62C9\u8D8A\u6C99\u5DF4\u8FDE\u63A5\u8DEF\u9879\u76EE\u7B2C\u4E8C\u9636\u6BB5 (SSLR 2)\u3002\u003C/p\u003E\n\u003Cp\u003E\u9996\u9636\u6BB5\u5DE5\u7A0B\u8FDB\u5EA6\u8D85\u524D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u900F\u9732\uFF0C\u76EE\u524D\u8BE5\u9879\u76EE\u5904\u4E8E\u89C4\u5212\u9636\u6BB5\uFF0C\u5206\u4E3A\u4E09\u4E2A\u90E8\u5206\uFF0C\u5373\u4ECE\u74DC\u62C9\u5CC7\u5357\u5230\u7F8E\u91CC\u53CC\u6EAA\u90FD\u4E5D\u79FB\u6C11\u3001\u6D77\u5173\u3001\u68C0\u75AB\u548C\u5B89\u5168\u5C40 (ICQS)\uFF084.9\u516C\u91CC\uFF09\u3001\u6797\u68A6\u7684\u5FB7\u90FD\u5CB8\u5173\u5361\u4E0E\u5230\u6797\u68A6\u73ED\u8FBE\u5F2F\u5173\u5361\uFF0854.6 \u516C\u91CC\uFF09\u3001\u4ECE\u8001\u8D8A\u9547\u5230\u8001\u8D8A\u5B5F\u5361\u524C\u5173\u5361 \uFF0833.7\u516C\u91CC\uFF09\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u7B2C\u4E00\u9636\u6BB5\u7684\u7802\u6C99\u8FDE\u8D2F\u9053\u8DEF\u957F\u7EA676\u516C\u91CC\uFF0C\u4ECE\u8001\u8D8A\u8FDE\u63A5\u81F3\u5F04\u7F57\u51B0\u4EA4\u754C\u8DEF\uFF0C\u4E8E2021\u5E748\u67089\u65E5\u5F00\u59CB\uFF0C\u76EE\u524D\u5DF2\u5B8C\u621035%\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u8FD9\u4E00\u8FDB\u5C55\u6BD4\u6700\u521D30.32%\u7684\u76EE\u6807\u5FEB\u4E865%\uFF0C\u9884\u8BA1\u5C06\u4E8E2026\u5E7411\u6708\u5168\u9762\u5B8C\u6210\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u79F0\uFF0C\u8BE5\u9879\u76EE\u7531\u8054\u90A6\u653F\u5E9C\u62E8\u6B3E10\u4EBF\u4EE4\u5409\u8D44\u52A9\uFF0C\u65E8\u5728\u8FDE\u63A5\u7802\u62C9\u8D8A\u548C\u6C99\u5DF4\uFF0C\u800C\u65E0\u9700\u7ECF\u8FC7\u6C76\u83B1\u3002\u8BE5\u9879\u76EE\u9884\u8BA1\u5C06\u4E8E2026\u5E74\u7B2C\u4E09\u5B63\u5EA6\u5B8C\u5DE5\uFF0C\u5E76\u5C06\u589E\u5F3A\u90CA\u533A\u7684\u9053\u8DEF\u7684\u8FDE\u901A\u6027\u548C\u7ECF\u6D4E\u589E\u957F\u3002\u003C/p\u003E\n\u003Cp\u003E\u8FDE\u63A5\u8001\u8D8A\u6797\u68A6\u59C6\u9C81\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u7802\u6C99\u8FDE\u8D2F\u9053\u8DEF\u9879\u76EE\u7684\u5EFA\u8BBE\u5305\u62EC\u5C06\u73B0\u6709\u9053\u8DEF\u5347\u7EA7\u5230R3\u6807\u51C6\uFF0C\u5E76\u4FEE\u5EFA322\u516C\u91CC\u7684\u65B0\u8DEF\u7EBF\u3002\u8FD9\u6761\u8DEF\u5C06\u65E0\u9700\u7ECF\u8FC7\u6C76\u83B1\uFF0C\u4E14\u8FDE\u63A5\u8D77\u7802\u62C9\u8D8A\u7684\u8001\u8D8A\u3001\u6797\u68A6\u548C\u59C6\u9C81\u5E02\u9547\u3002\u003C/p\u003E\n\u003Cp\u003E\u8FD9\u9879\u8017\u8D4472\u4EBF\u4EE4\u5409\u7684\u9879\u76EE\u5206\u4E3A\u56DB\u4E2A\u9636\u6BB5\u5B9E\u65BD\uFF0C\u4EE5\u6539\u5584\u5F53\u5730\u793E\u533A\u548C\u6E38\u5BA2\u7684\u51FA\u884C\u548C\u6D41\u52A8\u6027\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8868\u793A\uFF0C\u5728\u65B0\u51A0\u80BA\u708E\u75AB\u60C5\u671F\u95F4\uFF0C\u51F8\u663E\u4E86\u8FD9\u79CD\u8FDE\u901A\u6027\u7684\u5FC5\u8981\u6027\uFF0C\u5C24\u5176\u662F\u5728\u6C76\u83B1\u5173\u95ED\u8FB9\u5883\u3001\u5B64\u7ACB\u5317\u7802\u5404\u533A\uFF0C\u6700\u7EC8\u8FEB\u4F7F\u63F4\u52A9\u7269\u8D44\u5FC5\u987B\u901A\u8FC7\u6C99\u5DF4\u8FD0\u62B5\u3002\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u516C\u5171\u5DE5\u7A0B\u90E8\u957F\u4E8E\u4ECA\u5E743\u670826\u65E5\u5728\u5409\u9686\u5761\u5411\u4E3B\u8981\u627F\u5305\u5546\u9881\u53D1\u4E86\u8BE5\u9879\u76EE\u7684\u4E2D\u6807\u51FD\u3002\u7802\u62C9\u8D8A\u516C\u5171\u5DE5\u7A0B\u90E8\u5C06\u8D1F\u8D23\u76D1\u7763\u8BE5\u9879\u76EE\uFF0C\u8BE5\u9879\u76EE\u9884\u8BA1\u5C06\u57285\u5E74\u5185\u5B8C\u5DE5\uFF0C\u76EE\u524D\u521D\u6B65\u73B0\u573A\u5DE5\u4F5C\u5DF2\u5728\u65BD\u5DE5\u7684\u9636\u6BB5\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/pkg-Rd5CDacsUK2-hPQFWQ\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
