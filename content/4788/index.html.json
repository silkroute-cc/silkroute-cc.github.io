  "canonicalUrlKey": "%e4%b8%ad%e5%9b%bd%e4%bc%81%e4%b8%9a%e8%ae%a1%e5%88%92%e5%9c%a8%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e6%89%93%e9%80%a0%e7%94%9f%e7%89%a9%e5%8c%bb%e8%8d%af%e4%ba%a7%e4%b8%9a%e5%9b%ad",
  "route": "/4788/",
  "title": "\u4E2D\u56FD\u4F01\u4E1A\u8BA1\u5212\u5728\u9A6C\u6765\u897F\u4E9A\u6253\u9020\u751F\u7269\u533B\u836F\u4EA7\u4E1A\u56ED",
  "summary": "\u79EF\u6781\u6269\u5C55\u4E8B\u4E1A\u7248\u56FE\u7684\u6B63\u6E90\u96C6\u56E2\uFF08Meta Bright Group Berhad\uFF09\u5BA3\u5E03\uFF0C\u4E0E\u4E2D\u56FD\u4F01\u4E1A\u777F\u667A\u533B\u836F\u79D1\u6280\u80A1\u4EFD\u6709\u9650\u516C\u53F8\uFF08ChemPartner Pharmatech Co., Ltd\uFF0C\u7B80\u79F0\u201C\u777F\u667A\u533B\u836F\u201D\uFF09\u7B7E\u7F72\u8C05\u89E3\u5907\u5FD8\u5F55\uFF08\u201CMOU\u201D\uFF09\uFF0C\u8BA1\u5212\u643A\u624B\u5728\u9A6C\u6765\u897F\u4E9A\u6253\u9020\u4E00\u4E2A\u9876\u5C16\u7684\u751F\u7269\u533B\u836F\u4EA7\u4E1A\u56ED\uFF0C\u6807\u5FD7\u7740\u6B63\u6E90\u96C6\u56E2\u53D1\u5C55\u5386\u7A0B\u4E2D\u4E00\u5927\u91CD\u8981\u91CC\u7A0B\u7891\u3002 \u4E3A\u6B64\uFF0C\u6B63\u6E90\u96C6\u56E2\u7279\u522B\u98DE\u5F80\u4E2D\u56FD\u4E0A\u6D77\uFF0C\u5728\u9A6C\u6765\u897F\u4E9A\u526F\u9996\u76F8\u62FF\u7763\u65AF\u91CCAhmad Zahid Bin Hamidi\u535A\u58EB\u7684\u89C1\u8BC1\u4E0B\uFF0C\u4E0E\u777F\u667A\u533B\u836F\u7B7E\u7F72\u534F\u8BAE\u7F14\u7ED3\u6218\u7565\u5408\u4F5C\u4F19\u4F34\u5173\u7CFB\u2026",
  "body": "\u003Cp\u003E\u79EF\u6781\u6269\u5C55\u4E8B\u4E1A\u7248\u56FE\u7684\u6B63\u6E90\u96C6\u56E2\uFF08Meta Bright Group Berhad\uFF09\u5BA3\u5E03\uFF0C\u4E0E\u4E2D\u56FD\u4F01\u4E1A\u777F\u667A\u533B\u836F\u79D1\u6280\u80A1\u4EFD\u6709\u9650\u516C\u53F8\uFF08ChemPartner Pharmatech Co., Ltd\uFF0C\u7B80\u79F0\u201C\u777F\u667A\u533B\u836F\u201D\uFF09\u7B7E\u7F72\u8C05\u89E3\u5907\u5FD8\u5F55\uFF08\u201CMOU\u201D\uFF09\uFF0C\u8BA1\u5212\u643A\u624B\u5728\u9A6C\u6765\u897F\u4E9A\u6253\u9020\u4E00\u4E2A\u9876\u5C16\u7684\u751F\u7269\u533B\u836F\u4EA7\u4E1A\u56ED\uFF0C\u6807\u5FD7\u7740\u6B63\u6E90\u96C6\u56E2\u53D1\u5C55\u5386\u7A0B\u4E2D\u4E00\u5927\u91CD\u8981\u91CC\u7A0B\u7891\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E3A\u6B64\uFF0C\u6B63\u6E90\u96C6\u56E2\u7279\u522B\u98DE\u5F80\u4E2D\u56FD\u4E0A\u6D77\uFF0C\u5728\u9A6C\u6765\u897F\u4E9A\u526F\u9996\u76F8\u62FF\u7763\u65AF\u91CCAhmad Zahid Bin Hamidi\u535A\u58EB\u7684\u89C1\u8BC1\u4E0B\uFF0C\u4E0E\u777F\u667A\u533B\u836F\u7B7E\u7F72\u534F\u8BAE\u7F14\u7ED3\u6218\u7565\u5408\u4F5C\u4F19\u4F34\u5173\u7CFB\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E0A\u5E02\u4E8E\u6DF1\u5733\u8BC1\u5238\u4EA4\u6613\u6240\u7684\u777F\u667A\u533B\u836F\uFF08\u80A1\u7968\u4EE3\u7801\uFF1A300149.SZ\uFF09\uFF0C\u5E02\u503C\u7EA6\u8FBE24\u4EBF\u4EBA\u6C11\u5E01\uFF08\u7EA6\u76F8\u7B49\u4E8E16\u4EBF\u4EE4\u5409\uFF09\uFF0C\u662F\u4E00\u5BB6\u4EE5\u63D0\u4F9B\u5168\u9762\u7EFC\u5408\u670D\u52A1\u800C\u95FB\u540D\u7684\u751F\u7269\u5236\u836F\u9886\u57DF\u7FD8\u695A\u3002\u6240\u63D0\u4F9B\u7684\u670D\u52A1\u5305\u62EC\u5316\u836F\u53D1\u73B0\u4E36\u751F\u7269\u4E0E\u836F\u7406\u836F\u6548\u5B66\u4E36\u836F\u4EE3\u52A8\u529B\u5B66\uFF08\u201CDMPK\u201D\uFF09\u548C\u6BD2\u7406\u5B66\u3002\u003C/p\u003E\n\u003Cp\u003E\u4F5C\u4E3A\u4E00\u5BB6\u9886\u5148\u4E8E\u65B0\u836F\u7814\u53D1\u53CA\u751F\u4EA7\u4E00\u4F53\u5316\u670D\u52A1\uFF08\u201CCDMO\u201D\uFF09\u7684\u4F01\u4E1A\uFF0C\u777F\u667A\u533B\u836F\u4E13\u6CE8\u4E8E\u751F\u7269\u5236\u5242\u7684\u53D1\u73B0\u4E36\u5F00\u53D1\u548C\u751F\u4EA7\u3002\u6B64\u6B21\u5408\u4F5C\u5C06\u501F\u52A9\u777F\u667A\u533B\u836F\u4E30\u5BCC\u7684\u4E13\u4E1A\u77E5\u8BC6\u4EE5\u53CA\u5168\u7403\u5730\u4F4D\uFF0C\u6765\u63D0\u5347\u6B63\u6E90\u96C6\u56E2\u5728\u5236\u836F\u548C\u751F\u7269\u6280\u672F\u9886\u57DF\u7684\u5B9E\u529B\u3002\u003C/p\u003E\n\u003Cp\u003E\u5728\u8FD9\u6B21\u4E2D\u56FD\u9886\u5148\u4E0A\u5E02\u516C\u53F8\u4E0E\u9A6C\u6765\u897F\u4E9A\u5F00\u5C55\u7684\u5F00\u521B\u6027\u5408\u4F5C\u4E2D\uFF0C\u53CC\u65B9\u653E\u773C\u5728\u9A6C\u6765\u897F\u4E9A\u5EFA\u7ACB\u4E00\u4E2A\u6700\u5148\u8FDB\u7684\u751F\u7269\u533B\u836F\u4EA7\u4E1A\u56ED\uFF0C\u7740\u91CD\u4E8E\u5236\u836F\u4EA7\u54C1\u548C\u751F\u7269\u6280\u672F\u8FDB\u6B65\u7684\u7814\u53D1\u4E36\u751F\u4EA7\u548C\u5546\u4E1A\u5316\u3002\u003C/p\u003E\n\u003Cp\u003E\u6B63\u6E90\u96C6\u56E2\u8463\u4E8B\u7ECF\u7406\u674E\u5FD7\u575A\u5148\u751F\u6307\u51FA\uFF1A\u201C\u6B64\u6B21\u5408\u4F5C\u6807\u5FD7\u7740\u6B63\u6E90\u96C6\u56E2\u63ED\u5F00\u4E86\u6FC0\u52A8\u4EBA\u5FC3\u7684\u65B0\u7BC7\u7AE0\u3002\u8FD9\u4E2A\u6709\u522B\u4E8E\u4E00\u822C\u7684\u5F00\u53D1\u9879\u76EE\uFF0C\u65E8\u5728\u4E0E\u5236\u836F\u548C\u751F\u7269\u6280\u672F\u9886\u57DF\u7684\u9886\u5148\u4E1A\u8005\u5171\u521B\u4E00\u4E2A\u5229\u57FA\u5E02\u573A\u3002\u8FD9\u4EE3\u8868\u7740\u6211\u4EEC\u5DF2\u7ECF\u8D85\u8D8A\u4E86\u4F20\u7EDF\u7684\u5F00\u53D1\u9879\u76EE\uFF0C\u6709\u80FD\u529B\u627F\u63A5\u66F4\u7CBE\u5BC6\u590D\u6742\u7684\u9879\u76EE\u3002\u6211\u4EEC\u6709\u4FE1\u5FC3\uFF0C\u6B64\u6B21\u5408\u4F5C\u5C06\u53EF\u5DE9\u56FA\u6211\u4EEC\u5728\u5E02\u573A\u7684\u9886\u5148\u5730\u4F4D\uFF0C\u4E3A\u9A6C\u6765\u897F\u4E9A\u66F4\u5E7F\u6CDB\u7684\u7ECF\u6D4E\u53D1\u5C55\u4F5C\u51FA\u8D21\u732E\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8865\u5145\u8BF4\uFF1A\u201C\u6B63\u6E90\u96C6\u56E2\u548C\u777F\u667A\u533B\u836F\u6000\u62B1\u7740\u5171\u540C\u7684\u613F\u666F\uFF0C\u4F01\u76FC\u52A0\u5F3A\u53CC\u8FB9\u5173\u7CFB\u4E36\u4FC3\u8FDB\u9A6C\u6765\u897F\u4E9A\u7ECF\u6D4E\u53D1\u5C55\u3002\u777F\u667A\u533B\u836F\u5728\u5236\u836F\u65B9\u9762\u7684\u4E13\u957F\u642D\u914D\u6B63\u6E90\u96C6\u56E2\u5728\u623F\u5730\u4EA7\u53D1\u5C55\u9886\u57DF\u7684\u4F18\u52BF\uFF0C\u6B64\u6B21\u5F3A\u5F3A\u5408\u4F5C\u6253\u9020\u4E00\u4E2A\u5F00\u521B\u6027\u7684\u751F\u7269\u533B\u836F\u4EA7\u4E1A\u56ED\uFF0C\u5180\u671B\u8BA9\u9A6C\u4E2D\u4E24\u56FD\u7686\u80FD\u53D7\u60E0\u3002\u201D\u003C/p\u003E\n\u003Cfigure\u003E\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/06/frc-2da28d49c579e85466de82a8cc52414d.png\u0022 alt=\u0022\u524D\u6392\u5DE6\u8D77\u777F\u667A\u533B\u836F\u79D1\u6280\u80A1\u4EFD\u6709\u9650\u516C\u53F8\u4E3B\u5E2D\u62FF\u7763\u80E1\u745E\u8FDE\uFF0C\u6B63\u6E90\u96C6\u56E2\u6709\u9650\u516C\u53F8\u8463\u4E8B\u7ECF\u7406\u674E\u5FD7\u575A\u3002\u540E\u6392\u5DE6\u8D77\u777F\u667A\u533B\u836F\u836F\u7406\u836F\u6548\u90E8\u526F\u603B\u88C1\u5C39\u5BC5\u98DE\u535A\u58EB\uFF0C\u4E0A\u6D77\u7F8E\u8FEA\u897F\u666E\u4E9A\u533B\u836F\u79D1\u6280\u5316\u836F\u53D1\u73B0\u90E8\u9AD8\u7EA7\u526F\u603B\u88C1\u9A6C\u5174\u6CC9\u5148\u751F\uFF0C\u777F\u667A\u533B\u836F\u8463\u4E8B\u6A0A\u4E16\u65B0\u5148\u751F\uFF0C\u9A6C\u6765\u897F\u4E9A\u526F\u9996\u76F8\u62FF\u7763\u65AF\u91CCAhmad Zahid Bin Hamidi\uFF0C\u4EBA\u6C11\u4FE1\u6258\u5C40\uFF08MARA\uFF09\u4E3B\u5E2D\u62FF\u7763Asyraf Wajdi Dusuki\u535A\u58EB\uFF0C\u6B63\u6E90\u96C6\u56E2\u6267\u884C\u8463\u4E8B\u62FF\u7763\u674E\u73C2\u540D\u53CA\u6B63\u6E90\u96C6\u56E2\u4F01\u4E1A\u4E0E\u6218\u7565\u89C4\u5212\u6267\u884C\u8463\u4E8B\u5F6D\u9526\u6797\u3002\u0022 /\u003E\u003Cfigcaption\u003E\u524D\u6392\u5DE6\u8D77\u777F\u667A\u533B\u836F\u79D1\u6280\u80A1\u4EFD\u6709\u9650\u516C\u53F8\u4E3B\u5E2D\u62FF\u7763\u80E1\u745E\u8FDE\uFF0C\u6B63\u6E90\u96C6\u56E2\u6709\u9650\u516C\u53F8\u8463\u4E8B\u7ECF\u7406\u674E\u5FD7\u575A\u3002\u540E\u6392\u5DE6\u8D77\u777F\u667A\u533B\u836F\u836F\u7406\u836F\u6548\u90E8\u526F\u603B\u88C1\u5C39\u5BC5\u98DE\u535A\u58EB\uFF0C\u4E0A\u6D77\u7F8E\u8FEA\u897F\u666E\u4E9A\u533B\u836F\u79D1\u6280\u5316\u836F\u53D1\u73B0\u90E8\u9AD8\u7EA7\u526F\u603B\u88C1\u9A6C\u5174\u6CC9\u5148\u751F\uFF0C\u777F\u667A\u533B\u836F\u8463\u4E8B\u6A0A\u4E16\u65B0\u5148\u751F\uFF0C\u9A6C\u6765\u897F\u4E9A\u526F\u9996\u76F8\u62FF\u7763\u65AF\u91CCAhmad Zahid Bin Hamidi\uFF0C\u4EBA\u6C11\u4FE1\u6258\u5C40\uFF08MARA\uFF09\u4E3B\u5E2D\u62FF\u7763Asyraf Wajdi Dusuki\u535A\u58EB\uFF0C\u6B63\u6E90\u96C6\u56E2\u6267\u884C\u8463\u4E8B\u62FF\u7763\u674E\u73C2\u540D\u53CA\u6B63\u6E90\u96C6\u56E2\u4F01\u4E1A\u4E0E\u6218\u7565\u89C4\u5212\u6267\u884C\u8463\u4E8B\u5F6D\u9526\u6797\u3002\u003C/figcaption\u003E\u003C/figure\u003E\n\u003Cp\u003E\u003Cstrong\u003E\n\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u777F\u667A\u533B\u836F\u4E3B\u5E2D\u62FF\u7763\u80E1\u745E\u8FDE\u4E5F\u5206\u4EAB\u9053\uFF1A\u201C\u6211\u4EEC\u975E\u5E38\u9AD8\u5174\u80FD\u4E0E\u6B63\u6E90\u96C6\u56E2\u5C55\u5F00\u8DE8\u5883\u5408\u4F5C\uFF0C\u4E0D\u4EC5\u6709\u52A9\u4E8E\u63D0\u9AD8\u6211\u4EEC\u7684\u5168\u7403\u5F71\u54CD\u529B\uFF0C\u8FD8\u80FD\u4E3A\u4E2D\u9A6C\u521B\u9020\u5DE8\u5927\u7684\u5229\u76CA\uFF0C\u4FC3\u8FDB\u533A\u57DF\u7684\u521B\u65B0\u548C\u7ECF\u6D4E\u589E\u957F\u3002\u201D\n\u003C/p\u003E\n\u003Cp\u003E\u6839\u636E\u4ECA\u65E5\u63D0\u4EA4\u4E88\u9A6C\u6765\u897F\u4E9A\u8BC1\u5238\u4EA4\u6613\u6240\u7684\u62A5\u5907\u6587\u4EF6\uFF0C\u5728\u8C05\u89E3\u5907\u5FD8\u5F55\u4E2D\uFF0C\u6B63\u6E90\u96C6\u56E2\u8D1F\u8D23\u9274\u5B9A\u80FD\u5EFA\u8BBE\u8FD9\u4EA7\u4E1A\u56ED\u7684\u6218\u7565\u5730\u70B9\uFF0C\u5E76\u76D1\u7763\u5B9E\u9A8C\u5BA4\u4E36\u751F\u4EA7\u8BBE\u65BD\u548C\u529E\u516C/\u96F6\u552E\u7A7A\u95F4\u7684\u5174\u5EFA\u548C\u53D1\u5C55\u3002\u6B64\u5916\uFF0C\u6B63\u6E90\u96C6\u56E2\u627F\u8BFA\u843D\u5B9E\u73AF\u5883\u53EF\u6301\u7EED\u53D1\u5C55\u5B9E\u8DF5\uFF0C\u6700\u5927\u9650\u5EA6\u51CF\u5C11\u751F\u6001\u5F71\u54CD\uFF0C\u5E76\u63A8\u5E7F\u7EFF\u8272\u5021\u8BAE\u3002\u003C/p\u003E\n\u003Cp\u003E\u800C\u777F\u667A\u533B\u836F\u5219\u627F\u62C5\u8D77\u63A2\u7D22\u548C\u4FC3\u8FDB\u6295\u8D44\u673A\u4F1A\u7684\u8D23\u4EFB\uFF0C\u4EE5\u652F\u6301\u8BE5\u4EA7\u4E1A\u56ED\u7684\u6210\u957F\u4E0E\u53D1\u5C55\u3002\u8BE5\u516C\u53F8\u5C06\u548C\u4E2D\u56FD\u5236\u836F\u548C\u751F\u7269\u6280\u672F\u4F01\u4E1A\u4E36\u5B66\u672F\u673A\u6784\u548C\u7814\u7A76\u7EC4\u7EC7\u5408\u4F5C\uFF0C\u8FDB\u4E00\u6B65\u63A8\u52A8\u4EA7\u4E1A\u56ED\u7684\u5408\u4F5C\u6F5C\u529B\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E0D\u4EC5\u5982\u6B64\uFF0C\u8FD9\u5EA7\u751F\u7269\u533B\u836F\u4EA7\u4E1A\u56ED\u6599\u8FD8\u80FD\u63D0\u632F\u5BF9\u53EF\u518D\u751F\u80FD\u6E90\u548C\u8282\u80FD\u89E3\u51B3\u65B9\u6848\u4E36\u673A\u68B0\u8BBE\u5907\u8FD0\u8425\u79DF\u8D41\u670D\u52A1\uFF0C\u4EE5\u53CA\u6DF7\u51DD\u571F\u7B49\u5EFA\u7B51\u6750\u6599\u7684\u9700\u6C42\uFF0C\u8FDB\u800C\u52A0\u5F3A\u6B63\u6E90\u96C6\u56E2\u7684\u80FD\u6E90\u4E36\u79DF\u8D41\u548C\u5EFA\u6750\u4E1A\u52A1\u3002\u003C/p\u003E\n\u003Cp\u003E\u6B63\u6E90\u96C6\u56E2\u4F01\u4E1A\u4E0E\u6218\u7565\u89C4\u5212\u6267\u884C\u8463\u4E8BDerek Phang Kiew Lim\u5148\u751F\u8868\u793A\uFF1A\u201C\u6B64\u751F\u7269\u533B\u836F\u4EA7\u4E1A\u56ED\u662F\u6211\u4EEC\u591A\u5143\u5316\u4E1A\u52A1\u7EC4\u5408\u7684\u6218\u7565\u4E3E\u63AA\uFF0C\u540C\u65F6\u6709\u52A9\u4E8E\u63A8\u52A8\u9A6C\u6765\u897F\u4E9A\u4F5C\u4E3A\u79D1\u5B66\u7814\u53D1\u4E2D\u5FC3\u7684\u58F0\u8A89\uFF0C\u975E\u5E38\u5174\u594B\u5730\u671F\u5F85\u8FD9\u5EA7\u4EA7\u4E1A\u56ED\u80FD\u5728\u6240\u6709\u76F8\u5173\u9886\u57DF\u5185\uFF0C\u4FC3\u8FDB\u66F4\u5927\u7684\u521B\u65B0\u548C\u521B\u9020\u65B0\u673A\u9047\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u6B64\u6B21\u5408\u4F5C\u4E5F\u6807\u5FD7\u6B63\u6E90\u96C6\u56E2\u53D1\u5C55\u53F2\u4E0A\u7684\u65B0\u7BC7\u7AE0\uFF0C\u4E0D\u4EC5\u80FD\u63A8\u52A8\u5B9E\u8D28\u6027\u7684\u8FDB\u6B65\uFF0C\u8FD8\u80FD\u8BA9\u8BE5\u96C6\u56E2\u5728\u5236\u836F\u548C\u751F\u7269\u6280\u672F\u9886\u57DF\u8D70\u4E0A\u66F4\u9AD8\u7684\u65B0\u9AD8\u5EA6\u3002\u6B64\u6B21\u4E0E\u777F\u667A\u533B\u836F\u7684\u5408\u4F5C\u6599\u80FD\u5E26\u9886\u6B63\u6E90\u96C6\u56E2\u8FC8\u5165\u4E00\u4E2A\u5168\u65B0\u7684\u6210\u957F\u65F6\u4EE3\uFF0C\u8FDB\u4E00\u6B65\u5DE9\u56FA\u5176\u5728\u5E02\u573A\u4E2D\u7684\u9886\u5BFC\u5730\u4F4D\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/jTshAtAwKoto71hEUk8qRg\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
