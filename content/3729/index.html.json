  "canonicalUrlKey": "%e9%a9%ac%e6%96%b0%e4%b8%a4%e5%9b%bd%e9%a6%96%e8%84%91%e9%a2%84%e8%ae%a1%e6%98%8e%e5%b9%b4%e5%88%9d%e3%80%80%e8%a7%81%e8%af%81%e9%a9%ac%e6%96%b0%e6%8d%b7%e8%bf%90%e9%ab%98%e6%9e%b6%e6%a1%a5%e8%bf%9e",
  "route": "/3729/",
  "title": "\u9A6C\u65B0\u4E24\u56FD\u9996\u8111\u9884\u8BA1\u660E\u5E74\u521D\u3000\u89C1\u8BC1\u9A6C\u65B0\u6377\u8FD0\u9AD8\u67B6\u6865\u8FDE\u63A5",
  "summary": "\uFF08\u65B0\u5C7111\u65E5\u8BAF\uFF09\u9A6C\u65B0\u6377\u8FD0\u7CFB\u7EDF\u8BA1\u5212\u5DE5\u7A0B\u8FDB\u5EA6\u76EE\u524D\u7686\u6309\u7167\u8FDB\u5EA6\uFF0C\u622A\u81F34\u670830\u65E5\uFF0C\u5927\u9A6C\u90E8\u5206\u7684\u57FA\u5EFA\u5DE5\u7A0B\u5DF2\u5B8C\u621036%\uFF0C\u65B0\u56FD\u90E8\u5206\u5219\u5B8C\u621050%\u3002\u9884\u8BA1\u660E\u5E74\u521D\u5C06\u7531\u9A6C\u65B0\u4E24\u56FD\u9996\u8111\u89C1\u8BC1\u6377\u8FD0\u9AD8\u67B6\u6865\u5B8C\u6210\u8FDE\u63A5\u3002 \u4EA4\u901A\u90E8\u957F\u9646\u5146\u798F\u6307\u51FA\uFF0C\u8FD9\u662F\u9A6C\u65B0\u4E24\u56FD\u90E8\u957F\u9996\u6B21\u5C31\u9A6C\u65B0\u6377\u8FD0\u7CFB\u7EDF\u4E00\u540C\u89C6\u5BDF\u5DE5\u7A0B\u8FDB\u5C55\uFF0C\u4ED6\u4E5F\u518D\u6B21\u91CD\u7533\uFF0C\u9A6C\u65B0\u6377\u8FD0\u5C06\u6539\u5584\u8BB8\u591A\u4E24\u56FD\u5BB6\u5EAD\u7684\u751F\u6D3B\uFF0C\u4ED6\u4E5F\u5BC6\u5207\u5173\u6CE8\u6BCF\u4E2A\u9879\u76EE\u7684\u91CC\u7A0B\u7891\uFF0C\u786E\u4FDD\u5DE5\u7A0B\u6309\u65F6\u5B8C\u6210\u3002 \u4ED6\u900F\u9732\uFF0C\u622A\u81F34\u670830\u65E5\uFF0C\u9A6C\u65B0\u6377\u8FD0\u5DE5\u7A0B\u5728\u6211\u56FD\u90E8\u5206\u7684\u6574\u4F53\u94C1\u8DEF\u57FA\u7840\u8BBE\u65BD\u8FDB\u5EA6\u8FBE36%\uFF0C\u4E5F\u5C31\u662F\u4E09\u5206\u4E4B\u4E00\u8FDB\u5EA6\uFF0C\u5176\u4E2D\u6700\u91CD\u8981\u7684\u6D77\u4E0A\u7ACB\u4EA4\u6865\u90E8\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/05/frc-fa3a38a53bd788be42c2b23f531492c9.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\uFF08\u65B0\u5C7111\u65E5\u8BAF\uFF09\u9A6C\u65B0\u6377\u8FD0\u7CFB\u7EDF\u8BA1\u5212\u5DE5\u7A0B\u8FDB\u5EA6\u76EE\u524D\u7686\u6309\u7167\u8FDB\u5EA6\uFF0C\u622A\u81F34\u670830\u65E5\uFF0C\u5927\u9A6C\u90E8\u5206\u7684\u57FA\u5EFA\u5DE5\u7A0B\u5DF2\u5B8C\u621036%\uFF0C\u65B0\u56FD\u90E8\u5206\u5219\u5B8C\u621050%\u3002\u9884\u8BA1\u660E\u5E74\u521D\u5C06\u7531\u9A6C\u65B0\u4E24\u56FD\u9996\u8111\u89C1\u8BC1\u6377\u8FD0\u9AD8\u67B6\u6865\u5B8C\u6210\u8FDE\u63A5\u3002\u003C/p\u003E\n\u003Cp\u003E\u4EA4\u901A\u90E8\u957F\u9646\u5146\u798F\u6307\u51FA\uFF0C\u8FD9\u662F\u9A6C\u65B0\u4E24\u56FD\u90E8\u957F\u9996\u6B21\u5C31\u9A6C\u65B0\u6377\u8FD0\u7CFB\u7EDF\u4E00\u540C\u89C6\u5BDF\u5DE5\u7A0B\u8FDB\u5C55\uFF0C\u4ED6\u4E5F\u518D\u6B21\u91CD\u7533\uFF0C\u9A6C\u65B0\u6377\u8FD0\u5C06\u6539\u5584\u8BB8\u591A\u4E24\u56FD\u5BB6\u5EAD\u7684\u751F\u6D3B\uFF0C\u4ED6\u4E5F\u5BC6\u5207\u5173\u6CE8\u6BCF\u4E2A\u9879\u76EE\u7684\u91CC\u7A0B\u7891\uFF0C\u786E\u4FDD\u5DE5\u7A0B\u6309\u65F6\u5B8C\u6210\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u900F\u9732\uFF0C\u622A\u81F34\u670830\u65E5\uFF0C\u9A6C\u65B0\u6377\u8FD0\u5DE5\u7A0B\u5728\u6211\u56FD\u90E8\u5206\u7684\u6574\u4F53\u94C1\u8DEF\u57FA\u7840\u8BBE\u65BD\u8FDB\u5EA6\u8FBE36%\uFF0C\u4E5F\u5C31\u662F\u4E09\u5206\u4E4B\u4E00\u8FDB\u5EA6\uFF0C\u5176\u4E2D\u6700\u91CD\u8981\u7684\u6D77\u4E0A\u7ACB\u4EA4\u6865\u90E8\u5206\uFF0C\u76EE\u524D\u8FDB\u5EA6\u4E3A30%\u3002\u003C/p\u003E\n\u003Cp\u003E\u9646\u5146\u798F\u4E0E\u65B0\u52A0\u5761\u4EA4\u901A\u90E8\u957F\u6613\u534E\u4EC1\u4ECA\u65E5\u4E0B\u5348\u5728\u65B0\u5C71\uFF0C\u89C6\u5BDF\u9A6C\u65B0\u6377\u8FD0\u7CFB\u7EDF\u5728\u6211\u56FD\u90E8\u5206\u7684\u5EFA\u8BBE\u5DE5\u4F5C\u8FDB\u5C55\uFF0C\u53CC\u65B9\u4E4B\u540E\u53EC\u5F00\u8054\u5408\u65B0\u95FB\u53D1\u5E03\u4F1A\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6307\u51FA\uFF0C\u5DE5\u7A0B\u76EE\u524D\u6309\u7167\u8FDB\u5EA6\u8FDB\u884C\uFF0C\u5927\u9A6C\u6709\u4FE1\u5FC3\u57282026\u5E7412\u670831\u65E5\u4E4B\u524D\uFF0C\u5168\u9762\u5B8C\u6210\u8BE5\u9879\u76EE\uFF0C\u5E76\u57282027\u5E74\u6B63\u5F0F\u542F\u7528\u3002\u003C/p\u003E\n\u003Cp\u003E\u8BE2\u53CA\u6377\u8FD0\u8F66\u8D44\uFF0C\u9646\u5146\u798F\u8868\u793A\uFF0C\u76EE\u524D\u8FD8\u6709\u65F6\u95F4\uFF0C\u653F\u5E9C\u9996\u8981\u5148\u5173\u6CE8\u5DE5\u7A0B\u8FDB\u5EA6\uFF0C\u81F3\u4E8E\u8F66\u8D44\u5219\u53EF\u5728\u6377\u8FD0\u7AE3\u5DE5\u524D\u8BA8\u8BBA\u3002\u003C/p\u003E\n\u003Cp\u003E\u65B0\u52A0\u5761\u90E8\u957F\u6613\u534E\u4EC1\u5219\u8868\u793A\uFF0C\u76EE\u524D\u9A6C\u65B0\u6377\u8FD0\u5728\u65B0\u52A0\u5761\u90E8\u5206\u7684\u6574\u4F53\u57FA\u5EFA\u53CA\u6D77\u4E0A\u9AD8\u67B6\u6865\u7684\u5DE5\u7A0B\u7686\u5DF2\u5B8C\u621050%\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u8BE5\u9879\u76EE\u8FDB\u5EA6\u7684\u91CC\u7A0B\u7891\uFF0C\u5C06\u4F1A\u662F\u4E24\u56FD\u9AD8\u67B6\u6865\u8FDE\u63A5\u7684\u90A3\u4E00\u523B\uFF0C\u5373\u9884\u8BA1\u660E\u5E74\u521D\uFF0C\u5C4A\u65F6\u5C06\u4F1A\u9080\u8BF7\u4E24\u56FD\u9996\u8111\u89C1\u8BC1\u8FD9\u5386\u53F2\u6027\u4E00\u523B\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/05/frc-5bba6f0c51e39a1ebe025bb65cb2beb5.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u9A6C\u65B0\u4E24\u56FD\u4EA4\u901A\u90E8\u957F\u9996\u6B21\u4E00\u540C\u89C6\u5BDF\u9A6C\u65B0\u6377\u8FD0\u5DE5\u5730\uFF0C\u56FE\u4E3A\u6613\u534E\u4EC1\uFF08\u524D\u6392\u5DE63\u8D77\uFF09\u4E0E\u9646\u5146\u798F\u5728\u6377\u8FD0\u516C\u53F8\uFF08MRT Corp\uFF09\u804C\u5458\u5E26\u9886\u4E0B\uFF0C\u89C6\u5BDF\u9AD8\u67B6\u6865\u5DE5\u7A0B\u3002\u003C/p\u003E\n\u003Cp\u003E\u53E6\u4E00\u65B9\u9762\uFF0C\u8BE2\u53CA\u4E24\u56FD\u653F\u5E9C\u662F\u5426\u6709\u63A2\u8BA8\u5982\u4F55\u89E3\u51B3\u4E24\u56FD\u901A\u5173\u5835\u585E\u95EE\u9898\uFF0C\u9646\u5146\u798F\u5219\u8868\u793A\uFF0C\u6211\u56FD\u653F\u5E9C\u5DF2\u6210\u7ACB\u4E00\u4E2A\u59D4\u5458\u4F1A\u89E3\u51B3\u8FD9\u9879\u95EE\u9898\uFF0C\u5305\u62EC\u786E\u4FDD\u6240\u6709\u901A\u5173\u67DC\u53F0\u5168\u9762\u8FD0\u4F5C\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u4E5F\u7279\u522B\u8D5E\u626C\u67D4\u4F5B\u5DDE\u52A1\u5927\u81E3\u62FF\u7763\u7FC1\u54C8\u83F2\u5179\u91C7\u53D6\u79EF\u6781\u6001\u5EA6\uFF0C\u51E0\u4E4E\u6BCF\u5929\u5230\u5173\u5361\u5C55\u5F00\u7A81\u51FB\u89C6\u5BDF\uFF0C\u4F7F\u901A\u5173\u66F4\u987A\u7545\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u900F\u9732\uFF0C\u9A6C\u65B0\u4E24\u56FD\u4E5F\u5C31\u8212\u7F13\u901A\u5173\u5835\u585E\u5C55\u5F00\u8BA8\u8BBA\u53CA\u63D0\u51FA\u5EFA\u8BAE\uFF0C\u5305\u62EC\u589E\u8BBE\u66F4\u591A\u6E21\u8F6E\u670D\u52A1\u53CA\u5730\u4E0D\u4F6C\u77ED\u7A0B\u706B\u8F66\u670D\u52A1\uFF08Shuttle Tebrau\uFF09\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/Becv66a9_fdb_uPmbqzZow\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
