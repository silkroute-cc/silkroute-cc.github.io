  "route": "/4103/",
  "title": "\u9A6C\u6765\u897F\u4E9A\u6C99\u7535\u5BFB\u6C42\u653F\u5E9C\u652F\u6301\u4E0E\u4E2D\u65B9\u5408\u4F5C\u5EFA700\u5146\u74E6\u53D1\u7535\u5382",
  "summary": "(\u5409\u9686\u5761\u5341\u4E5D\u65E5\u8BAF)\u6C99\u5DF4\u7535\u529B\u6709\u9650\u516C\u53F8\u6B63\u5BFB\u6C42\u653F\u5E9C\u7684\u652F\u6301,\u4E0E\u4E2D\u56FD\u5408\u4F5C\u901A\u8FC7\u2018\u4E00\u5E26\u4E00\u8DEF\u2019\u5021\u8BAE\u5174\u5EFA\u4E00\u5EA7700\u5146\u74E6\u5BB9\u91CF\u7684\u53D1\u7535\u5382,\u4EE5\u5F7B\u5E95\u89E3\u51B3\u6C99\u5DF4\u7684\u7535\u529B\u4F9B\u5E94\u95EE\u9898\u3002 \u6597\u4E9A\u5170\u56FD\u4F1A\u8BAE\u5458\u62FF\u7763\u65AF\u91CC\u5A01\u5F17\u70C8\u9093\u9AD8\u6307\u51FA\uFF0C\u4E3A\u4E86\u5B9E\u73B0\u8FD9\u4E2A\u76EE\u6807\uFF0C\u6C99\u7535\u6025\u9700\u4E2D\u592E\u653F\u5E9C\u548C\u6C99\u5DF4\u5DDE\u653F\u5E9C\u7684\u652F\u6301\u4E0E\u63F4\u52A9\u3002 \u4ED6\u8BF4\uFF1A\u0022\u6C99\u7535\u8BA1\u5212\u4E0E\u4E2D\u56FD\u5408\u4F5C\uFF0C\u901A\u8FC7\u2018\u4E00\u5E26\u4E00\u8DEF\u2019\u5021\u8BAE\u7684\u8D22\u653F\u63F4\u52A9\u5174\u5EFA\u6C99\u7535\u72EC\u8D44\u62E5\u6709\u7684\u5FAA\u73AF\u71C3\u6C14\u6DA1\u8F6E\uFF08Combine Cycle Gas Turbine (CCGT)\uFF09\u53D1\u7535\u5382\u0022\u3002 \u4ED6\u8BF4\uFF1A\u0022\u56E0\u6B64\uFF0C\u6597\u4E9A\u5170\u8981\u6C42\u9996\u76F8\u62FF\u7763\u65AF\u91CC\u5B89\u534E\u4F9D\u535C\u62C9\u6B23\u652F\u6301\u2026",
  "body": "\u003Cp\u003E(\u5409\u9686\u5761\u5341\u4E5D\u65E5\u8BAF)\u6C99\u5DF4\u7535\u529B\u6709\u9650\u516C\u53F8\u6B63\u5BFB\u6C42\u653F\u5E9C\u7684\u652F\u6301,\u4E0E\u4E2D\u56FD\u5408\u4F5C\u901A\u8FC7\u2018\u4E00\u5E26\u4E00\u8DEF\u2019\u5021\u8BAE\u5174\u5EFA\u4E00\u5EA7700\u5146\u74E6\u5BB9\u91CF\u7684\u53D1\u7535\u5382,\u4EE5\u5F7B\u5E95\u89E3\u51B3\u6C99\u5DF4\u7684\u7535\u529B\u4F9B\u5E94\u95EE\u9898\u3002\u003C/p\u003E\n\u003Cp\u003E\u6597\u4E9A\u5170\u56FD\u4F1A\u8BAE\u5458\u62FF\u7763\u65AF\u91CC\u5A01\u5F17\u70C8\u9093\u9AD8\u6307\u51FA\uFF0C\u4E3A\u4E86\u5B9E\u73B0\u8FD9\u4E2A\u76EE\u6807\uFF0C\u6C99\u7535\u6025\u9700\u4E2D\u592E\u653F\u5E9C\u548C\u6C99\u5DF4\u5DDE\u653F\u5E9C\u7684\u652F\u6301\u4E0E\u63F4\u52A9\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF1A\u0026quot;\u6C99\u7535\u8BA1\u5212\u4E0E\u4E2D\u56FD\u5408\u4F5C\uFF0C\u901A\u8FC7\u2018\u4E00\u5E26\u4E00\u8DEF\u2019\u5021\u8BAE\u7684\u8D22\u653F\u63F4\u52A9\u5174\u5EFA\u6C99\u7535\u72EC\u8D44\u62E5\u6709\u7684\u5FAA\u73AF\u71C3\u6C14\u6DA1\u8F6E\uFF08Combine Cycle Gas Turbine (CCGT)\uFF09\u53D1\u7535\u5382\u0026quot;\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF1A\u0026quot;\u56E0\u6B64\uFF0C\u6597\u4E9A\u5170\u8981\u6C42\u9996\u76F8\u62FF\u7763\u65AF\u91CC\u5B89\u534E\u4F9D\u535C\u62C9\u6B23\u652F\u6301\u8FD9\u4E2A\u8BA1\u5212\uFF0C\u5C06\u6B64\u8BA1\u5212\u7EB3\u5165\u5176\u4E0E\u914D\u5408\u9A6C\u4E2D\u5EFA\u4EA450\u5468\u5E74\u8BBF\u95EE\u9A6C\u6765\u897F\u4E9A\u7684\u4E2D\u56FD\u56FD\u5BB6\u4E3B\u5E2D\u4E60\u8FD1\u5E73\u4E4B\u95F4\u7684\u8BA8\u8BBA\u8BAE\u7A0B\u3002\u0026quot;\u003C/p\u003E\n\u003Cp\u003E\u4E5F\u662F\u6C99\u7535\u4E3B\u5E2D\u7684\u9093\u9AD8\u661F\u671F\u4E8C\u5728\u56FD\u4F1A\u4E0B\u8BAE\u9662\u53C2\u4E0E\u8FA9\u8BBA2024\u5E74\u56FD\u5BB6\u8D22\u653F\u9884\u7B97\u6848\u65F6\u63D0\u5230\u8FD9\u4E00\u8BA1\u5212\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u4E5F\u4FDD\u8BC1\u5C06\u786E\u4FDD\u6C99\u7535\u5168\u4F53\u5458\u5DE5\u90FD\u505A\u597D\u6700\u5145\u5206\u7684\u51C6\u5907\uFF0C\u5168\u529B\u4F7F\u8FD9\u4E2A\u8BA1\u5212\u6210\u529F\u5B9E\u73B0\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF1A\u0026quot;\u503C\u5F97\u4E00\u63D0\u7684\u662F\uFF0C\u8FD9700\u5146\u74E6\u7535\u529B\u4F9B\u5E94\u5C06\u4F7F\u7528\u5929\u7136\u6C14\u8FD0\u4F5C\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF1A\u0026quot;\u56E0\u6B64\uFF0C\u6597\u4E9A\u5170\u8981\u6C42\u653F\u5E9C\u6307\u793A\u56FD\u5BB6\u77F3\u6CB9\u516C\u53F8\u4EE5\u6BCF\u5355\u4F4D15\u4EE4\u5409\u7684\u4EF7\u683C\u5411\u6C99\u7535\u4F9B\u5E94\u5929\u7136\u6C14\uFF0C\u4EE5\u6EE1\u8DB3\u8FD9\u4E2A\u8BA1\u5212\u7684\u9700\u8981\u3002\u0026quot;\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF1A\u0026quot;\u5728\u5404\u65B9\u7ED9\u4E88\u652F\u6301\u7684\u60C5\u51B5\u4E0B\uFF0C\u6211\u4EEC\u5E0C\u671B\u5728\u83B7\u5F97\u6279\u6DEE\u540E\u7684\u4E24\u5E74\u5185\u5B8C\u6210\u8FD9\u4E2A\u53D1\u7535\u5382\u7684\u5EFA\u8BBE\u3002\u0026quot;\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF1A\u0026quot;\u6211\u518D\u6B21\u5F3A\u8C03\uFF0C\u8FD9\u4E00\u6B65\u5BF9\u4E8E\u7A33\u5B9A\u6C99\u5DF4\u7684\u7535\u529B\u4F9B\u5E94\u81F3\u5173\u91CD\u8981\u3002\u0026quot;\u003C/p\u003E\n\u003Cp\u003E\u6B64\u5916\uFF0C\u9093\u9AD8\u4E5F\u900F\u9732\uFF0C\u56FD\u5BB6\u80FD\u6E90\u59D4\u5458\u4F1A\u5DF2\u7ECF\u6279\u6DEE\u6C99\u5DF4\u7535\u529B\u6709\u9650\u516C\u53F8\u7684\u5EFA\u8BAE\uFF0C\u4EE5\u5B89\u88C5\u4E00\u4E2A\u5BB9\u91CF\u8FBE100\u5146\u74E6\u7684\u7535\u6C60\u50A8\u80FD\u7CFB\u7EDF\u89E3\u71C3\u7709\u4E4B\u6025\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u6C99\u7535\u5C06\u5B89\u88C5\u4E00\u4E2A\u5BB9\u91CF\u8FBE100\u5146\u74E6\u7684\u7535\u6C60\u50A8\u80FD\u7CFB\u7EDF\uFF0C\u4F5C\u4E3A\u6C99\u5DF4\u89E3\u51B3\u7535\u529B\u4F9B\u5E94\u77ED\u7F3A\u95EE\u9898\u7684\u4E00\u4E2A\u77ED\u671F\u63AA\u65BD\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8868\u793A\uFF0C\u8FD9\u9879\u51B3\u5B9A\u5DF2\u83B7\u5F97\u56FD\u5BB6\u80FD\u6E90\u59D4\u5458\u4F1A\u7684\u6279\u6DEE\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF1A\u0026quot;\u6211\u4EEC\u6C99\u7535\u5E0C\u671B\u80FD\u6E90\u4F9B\u5E94\u8BA1\u5212\u548C\u7535\u4EF7\u59D4\u5458\u4F1A\uFF08JPPPET\uFF09\u79EF\u6781\u5730\u8003\u8651\u56FD\u80FD\u7684\u51B3\u5B9A\uFF0C\u4EE5\u9020\u798F\u5927\u5BB6\u7684\u5229\u76CA\u548C\u798F\u7949\u3002\u0026quot;\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF1A\u0026quot;\u503C\u5F97\u4E00\u63D0\u7684\u662F\uFF0C\u8FD9\u4E2A\u7535\u6C60\u50A8\u80FD\u7CFB\u7EDF\u5C06\u50A8\u5B58\u5728\u975E\u9AD8\u5CF0\u7528\u7535\u65F6\u6BB5\u4E0D\u4F7F\u7528\u7684\u7535\u80FD\uFF0C\u5373\u665A\u4E0A12:00\u5230\u65E9\u4E0A7:00\u4E4B\u95F4\u672A\u4F7F\u7528\u7684\u7535\u80FD\u3002\u0026quot;\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF1A\u0026quot;\u8FD9\u4E9B\u7535\u80FD\u5C06\u6210\u4E3A\u5907\u7528\u7535\u6E90\uFF0C\u4EE5\u6EE1\u8DB3\u9AD8\u5CF0\u7528\u7535\u65F6\u6BB5\u7528\u6237\u7684\u9AD8\u9700\u6C42\uFF0C\u5C24\u5176\u662F\u5728\u708E\u70ED\u5929\u6C14\u6216\u5176\u4ED6\u76F8\u5173\u56E0\u7D20\uFF0C\u5305\u62EC\u7CFB\u7EDF\u6545\u969C\u7B49\u60C5\u51B5\u4E0B\u3002\u0026quot;\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/RxEd__hJCC3qAa3adtZfjw\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
