{
  "id": "%e5%bc%a0%e5%ba%86%e4%bf%a1%e4%b8%8e%e6%ac%a7%e9%98%b3%e7%8e%89%e9%9d%96%e3%80%80%e7%8e%87%e5%9b%a2%e8%ae%bf%e6%b2%99%e5%b7%b4%e6%97%85%e6%b8%b8%e7%83%ad%e7%82%b9",
  "slug": "%e5%bc%a0%e5%ba%86%e4%bf%a1%e4%b8%8e%e6%ac%a7%e9%98%b3%e7%8e%89%e9%9d%96%e3%80%80%e7%8e%87%e5%9b%a2%e8%ae%bf%e6%b2%99%e5%b7%b4%e6%97%85%e6%b8%b8%e7%83%ad%e7%82%b9",
  "canonicalUrlKey": "%e5%bc%a0%e5%ba%86%e4%bf%a1%e4%b8%8e%e6%ac%a7%e9%98%b3%e7%8e%89%e9%9d%96%e3%80%80%e7%8e%87%e5%9b%a2%e8%ae%bf%e6%b2%99%e5%b7%b4%e6%97%85%e6%b8%b8%e7%83%ad%e7%82%b9",
  "route": "/4922/",
  "title": "\u5F20\u5E86\u4FE1\u4E0E\u6B27\u9633\u7389\u9756\u3000\u7387\u56E2\u8BBF\u6C99\u5DF4\u65C5\u6E38\u70ED\u70B9",
  "summary": "\uFF08\u5409\u9686\u576112\u65E5\u8BAF\uFF09\u4E3A\u4E86\u8FDB\u4E00\u6B65\u52A0\u5F3A\u6C99\u5DF4\u5DDE\u7684\u65C5\u6E38\u5B89\u5168\uFF0C\u4E3A\u4F17\u591A\u65C5\u5BA2\u63D0\u4F9B\u66F4\u5168\u9762\u7684\u4FDD\u969C\uFF0C\u5927\u9A6C\u65C5\u6E38\u3001\u827A\u672F\u53CA\u6587\u5316\u90E8\u957F\u62FF\u7763\u65AF\u91CC\u5F20\u5E86\u4FE1\u4E0E\u4E2D\u56FD\u9A7B\u5927\u9A6C\u5927\u4F7F\u6B27\u9633\u7389\u9756\uFF0C\u5728\u672C\u67089\u65E5\u81F311\u65E5\u671F\u95F4\u5171\u540C\u7387\u56E2\u5BF9\u6C99\u5DF4\u5DDE\u6570\u70ED\u95E8\u65C5\u6E38\u666F\u70B9\u4E0E\u5C9B\u5C7F\u8FDB\u884C\u8BBF\u95EE\u4E0E\u8003\u5BDF\u3002 \u6B64\u884C\u4E5F\u4E0E\u6C99\u5DF4\u5DDE\u5185\u653F\u5E9C\u5355\u4F4D\u3001\u6267\u6CD5\u673A\u6784\u3001\u76F8\u5173\u90E8\u95E8\u8FDB\u884C\u4F1A\u6664\uFF0C\u5305\u62EC\u653F\u5E9C\u79D8\u4E66\u957F\u3001\u6C99\u5DF4\u5DDE\u65C5\u6E38\u3001\u6587\u5316\u53CA\u73AF\u5883\u90E8\u3001\u6C99\u5DF4\u65C5\u6E38\u5C40\u3001\u6C99\u5DF4\u516C\u56ED\u7BA1\u7406\u5C40\u3001\u4E1C\u90E8\u8230\u961F\u6307\u6325\u90E8\u3001\u9A6C\u6765\u897F\u4E9A\u79FB\u6C11\u5C40\u6C99\u5DF4\u5206\u5C40\u3001\u5185\u653F\u4E0E\u7814\u7A76\u4E8B\u52A1\u79D8\u4E66\u7B49\u4EA4\u6D41\u4E0E\u63A2\u8BA8\u65C5\u6E38\u76F8\u5173\u4E8B\u52A1\u3002 \u672C\u6B21\u8BBF\u95EE\u65E8\u5728\u4E0E\u5730\u65B9\u5F53\u5C40\u3001\u65C5\u6E38\u4E1A\u8005\u4EE5\u53CA\u76F8\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/07/frc-b63172cb95f3b4ec578ecf4a49615f3c.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\uFF08\u5409\u9686\u576112\u65E5\u8BAF\uFF09\u4E3A\u4E86\u8FDB\u4E00\u6B65\u52A0\u5F3A\u6C99\u5DF4\u5DDE\u7684\u65C5\u6E38\u5B89\u5168\uFF0C\u4E3A\u4F17\u591A\u65C5\u5BA2\u63D0\u4F9B\u66F4\u5168\u9762\u7684\u4FDD\u969C\uFF0C\u5927\u9A6C\u65C5\u6E38\u3001\u827A\u672F\u53CA\u6587\u5316\u90E8\u957F\u62FF\u7763\u65AF\u91CC\u5F20\u5E86\u4FE1\u4E0E\u4E2D\u56FD\u9A7B\u5927\u9A6C\u5927\u4F7F\u6B27\u9633\u7389\u9756\uFF0C\u5728\u672C\u67089\u65E5\u81F311\u65E5\u671F\u95F4\u5171\u540C\u7387\u56E2\u5BF9\u6C99\u5DF4\u5DDE\u6570\u70ED\u95E8\u65C5\u6E38\u666F\u70B9\u4E0E\u5C9B\u5C7F\u8FDB\u884C\u8BBF\u95EE\u4E0E\u8003\u5BDF\u3002\u003C/p\u003E\n\u003Cp\u003E\u6B64\u884C\u4E5F\u4E0E\u6C99\u5DF4\u5DDE\u5185\u653F\u5E9C\u5355\u4F4D\u3001\u6267\u6CD5\u673A\u6784\u3001\u76F8\u5173\u90E8\u95E8\u8FDB\u884C\u4F1A\u6664\uFF0C\u5305\u62EC\u653F\u5E9C\u79D8\u4E66\u957F\u3001\u6C99\u5DF4\u5DDE\u65C5\u6E38\u3001\u6587\u5316\u53CA\u73AF\u5883\u90E8\u3001\u6C99\u5DF4\u65C5\u6E38\u5C40\u3001\u6C99\u5DF4\u516C\u56ED\u7BA1\u7406\u5C40\u3001\u4E1C\u90E8\u8230\u961F\u6307\u6325\u90E8\u3001\u9A6C\u6765\u897F\u4E9A\u79FB\u6C11\u5C40\u6C99\u5DF4\u5206\u5C40\u3001\u5185\u653F\u4E0E\u7814\u7A76\u4E8B\u52A1\u79D8\u4E66\u7B49\u4EA4\u6D41\u4E0E\u63A2\u8BA8\u65C5\u6E38\u76F8\u5173\u4E8B\u52A1\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/07/frc-a88769fe04c5b5473637921d2a914980.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u672C\u6B21\u8BBF\u95EE\u65E8\u5728\u4E0E\u5730\u65B9\u5F53\u5C40\u3001\u65C5\u6E38\u4E1A\u8005\u4EE5\u53CA\u76F8\u5173\u5355\u4F4D\u8FDB\u884C\u4EA4\u6D41\uFF0C\u6DF1\u5165\u4E86\u89E3\u4E0E\u63A2\u8BA8\u6C99\u5DF4\u5DDE\u70ED\u95E8\u5C9B\u5C7F\u7684\u65C5\u6E38\u5B89\u5168\u3001\u57FA\u7840\u8BBE\u65BD\u8BAE\u9898\u3002 \u003C/p\u003E\n\u003Cp\u003E\u8BBF\u95EE\u671F\u95F4\uFF0C\u53CC\u65B9\u56E2\u961F\u4E0E\u6C99\u5DF4\u5DDE\u5730\u65B9\u5F53\u5C40\u53CA\u65C5\u6E38\u4E1A\u8005\u8FDB\u884C\u4F1A\u8C08\uFF0C\u4EA6\u63A2\u8BA8\u5982\u4F55\u900F\u8FC7\u521B\u65B0\u4E0E\u4F18\u8D28\u7BA1\u7406\u65B9\u5F0F\u63D0\u5347\u65C5\u6E38\u5B89\u5168\u6C34\u5E73\uFF0C\u589E\u5F3A\u6E38\u5BA2\u7684\u4FE1\u4EFB\u611F\uFF0C\u7EE7\u800C\u5EFA\u7ACB\u826F\u597D\u53E3\u7891\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/07/frc-abb23ce951954ff95d13f3ffecdfa7a6.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u6C99\u5DF4\u56E0\u5176\u7F8E\u4E3D\u7684\u81EA\u7136\u98CE\u5149\u548C\u4E30\u5BCC\u7684\u6D77\u6D0B\u8D44\u6E90\uFF0C\u6210\u4E3A\u56FD\u5185\u5916\u6E38\u5BA2\u7684\u70ED\u95E8\u65C5\u6E38\u76EE\u7684\u5730\uFF0C\u5C24\u5176\u4EE5\u6F5C\u6C34\u6D3B\u52A8\u6700\u4E3A\u76DB\u884C\uFF1B\u7136\u800C\uFF0C\u968F\u8457\u6E38\u5BA2\u4EBA\u6570\u7684\u589E\u52A0\uFF0C\u4E14\u5373\u5C06\u8FCE\u6765\u65C5\u6E38\u65FA\u5B63\uFF0C\u5F53\u5730\u7684\u65C5\u6E38\u5B89\u5168 \u95EE\u9898\u4E5F\u83B7\u5F97\u4E2D\u56FD\u9A7B\u9A6C\u6765\u897F\u4E9A\u5927\u4F7F\u9986\u4E0E\u65C5\u6E38\u3001\u827A\u672F\u53CA\u6587\u5316\u90E8\u7684\u9AD8\u5EA6\u5173\u6CE8\u3002\u003C/p\u003E\n\u003Cp\u003E\u5728\u5404\u9879\u4F1A\u8C08\u4E2D\uFF0C\u5404\u9020\u9488\u5BF9\u5982\u4F55\u52A0\u5F3A\u5B89\u5168\u7BA1\u7406\u3001\u5B8C\u5584\u7D27\u6025\u6551\u63F4\u673A\u5236\u548C\u63D0\u5347\u5B89\u5168\u63AA\u65BD\u7B49\u65B9\u9762\u63D0\u51FA\u5177\u4F53\u5EFA\u8BAE\u548C\u63AA\u65BD\uFF1B\u4EE5\u53CA\u5982\u4F55\u52A0\u5F3A\u9A6C\u4E2D\u4E24\u56FD\u5728\u65C5\u6E38\u5B89\u5168\u548C\u670D\u52A1\u54C1\u8D28\u65B9\u9762\u7684\u5408\u4F5C\uFF0C\u7F14\u9020\u5171\u8D62\u5C40\u9762\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/07/frc-9f87d96a88814c2b9190150dd6c7d3f1.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u6B64\u6B21\u8BBF\u95EE\u4E0D\u4EC5\u53CD\u6620\u4E86\u4E2D\u9A6C\u4E24\u56FD\u5728\u65C5\u6E38\u9886\u57DF\u7684\u7D27\u5BC6\u5408\u4F5C\uFF0C\u4E5F\u663E\u793A\u4E86\u53CC\u65B9\u5BF9\u63D0\u5347\u65C5\u6E38\u5B89\u5168\u548C\u670D\u52A1\u54C1\u8D28\u7684\u9AD8\u5EA6\u91CD\u89C6\u3002 \u003C/p\u003E\n\u003Cp\u003E\u76F8\u4FE1\u5728\u53CC\u65B9\u7684\u5171\u540C\u52AA\u529B\u4E0B\uFF0C\u6C99\u5DF4\u5DDE\u5C06\u8FDB\u4E00\u6B65\u6539\u5584\u65C5\u6E38\u5B89\u5168\u73AF\u5883\uFF0C\u4E3A\u56FD\u5185\u5916\u6E38\u5BA2\u63D0\u4F9B\u66F4\u5B89\u5168\u3001\u66F4\u6109\u5FEB\u7684\u65C5\u6E38\u4F53\u9A8C\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/07/frc-456dcb7a9f2349922ef9093867d9bd69.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5728\u6B64\u6B21\u8BBF\u95EE\u4E2D\uFF0C\u4EE3\u8868\u56E2\u8003\u5BDF\u6C99\u5DF4\u5DDE\u7684\u591A\u4E2A\u91CD\u8981\u5C9B\u5C7F\uFF0C\u5305\u62EC\u9A6C\u5E03\u5C9B(Pulau Mabul)\u3001\u5361\u5E15\u83B1\u5C9B(Pulau Kapalai)\u3001\u73CD\u73E0\u5C9B\uFF08Pulau Bohey Dulang\uFF09\u3001\u90A6\u90A6\u5C9B\uFF08Pulau Pom Pom )\u3001\u519B\u8230\u5C9B\uFF08Pulau Sibuan)\u3001\u897F\u5DF4\u4E39\u5C9B\uFF08Pulau Sipadan)\u3001\u9A6C\u8FBE\u4EAC\u5C9B\uFF08Pulau Matangking\uFF09\u7B49\u7B49\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/07/frc-a7d9ab5c5b468f60ab31c14579fe62fb.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5F20\u5E86\u4FE1\u5728\u4E0E\u6C99\u5DF4\u5DDE\u65C5\u6E38\u754C\u7684\u4EA4\u6D41\u4E2D\uFF0C\u4EA6\u547C\u5401\u4E1A\u8005\u5171\u540C\u63A2\u8BA8\u548C\u5546\u69B7\u5982\u4F55\u8FDB\u4E00\u6B65\u63D0\u5347\u6C34\u4E0A\u6D3B\u52A8\u7684\u591A\u6837\u6027\uFF0C\u5F00\u53D1\u66F4\u591A\u65C5\u6E38\u4EA7\u54C1\uFF0C\u5168\u9762\u63D0\u5347\u6574\u4E2A\u65C5\u6E38\u4E1A\u7684\u6807\u51C6\u6C34\u5E73\u548C\u7D20\u8D28\uFF0C\u4EE5\u5438\u5F15\u66F4\u591A\u6E38\u5BA2 \u524D\u6765\u65C5\u6E38\u53CA\u4F53\u9A8C\u3002\u6B64\u5916\uFF0C\u996D\u5E97\u6C11\u5BBF\u7684\u57FA\u7840\u5EFA\u8BBE\u4E5F\u9700\u8981\u5168\u9762\u63D0\u5347\uFF0C\u5305\u62EC\u63D0\u5347\u89C2\u611F\u3001\u5F3A\u5316\u65C5\u6E38\u4FE1\u5FC3\u53CA\u786E\u4FDD\u4F4F\u5BBF\u5B89\u5168\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/07/frc-c1a9dda622e636d689c6c1d8e67a9abb.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u4ED6\u8868\u793A\uFF0C\u5E0C\u671B\u900F\u8FC7\u6B64\u6B21\u8BBF\u95EE\uFF0C\u80FD\u8BA9\u65C5\u6E38\u9886\u57DF\u7684\u76F8\u5173\u6D89\u53CA\u5355\u4F4D\u548C\u4E1A\u8005\u6E05\u6670\u4E86\u89E3\u81EA\u8EAB\u8D23\u4EFB\u4E0E\u4E49\u52A1\uFF0C\u5305\u62EC\u7EA0\u6B63\u7F3A\u6F0F\u3001\u53CA\u65F6\u6539\u5584\uFF0C\u4E3A\u9A6C\u6765\u897F\u4E9A\u3001\u5C24\u5176\u662F\u6C99\u5DF4\u5373\u5C06\u8FCE\u6765\u5927\u6279\u4E2D\u56FD\u6E38\u5BA2\u505A\u597D\u51C6\u5907\u5DE5\u4F5C\uFF0C \u52A1\u5FC5\u8BA9\u5230\u8BBF\u8005\u90FD\u80FD\u83B7\u5F97\u66F4\u9AD8\u6C34\u51C6\u7684\u65C5\u6E38\u4F53\u9A8C\uFF0C\u521B\u9020\u7F8E\u597D\u56DE\u5FC6\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/vefebGgV50s7WgCT7ot9Kw\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
