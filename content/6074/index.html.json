{
  "id": "\u6570\u636E\u4E2D\u5FC3\u5E26\u52A8\u4EA7\u4E1A\u94FE-mida\u52A9\u9A6C\u6765\u897F\u4E9A\u672C\u571F\u4F01\u4E1A\u62D3\u5C55\u5546\u673A",
  "slug": "\u6570\u636E\u4E2D\u5FC3\u5E26\u52A8\u4EA7\u4E1A\u94FE-mida\u52A9\u9A6C\u6765\u897F\u4E9A\u672C\u571F\u4F01\u4E1A\u62D3\u5C55\u5546\u673A",
  "canonicalUrlKey": "\u6570\u636E\u4E2D\u5FC3\u5E26\u52A8\u4EA7\u4E1A\u94FE-mida\u52A9\u9A6C\u6765\u897F\u4E9A\u672C\u571F\u4F01\u4E1A\u62D3\u5C55\u5546\u673A",
  "route": "/6074/",
  "title": "\u6570\u636E\u4E2D\u5FC3\u5E26\u52A8\u4EA7\u4E1A\u94FE MIDA\u52A9\u9A6C\u6765\u897F\u4E9A\u672C\u571F\u4F01\u4E1A\u62D3\u5C55\u5546\u673A",
  "summary": "\u9A6C\u6765\u897F\u4E9A\u6295\u8D44\u53D1\u5C55\u5C40\uFF08MIDA\uFF09\u6B63\u5F3A\u5316\u6570\u636E\u4E2D\u5FC3\u4E1A\u5468\u8FB9\u751F\u6001\u7CFB\u7EDF\uFF0C\u534F\u52A9\u672C\u571F\u4F01\u4E1A\u63D0\u5347\u80FD\u529B\uFF0C\u53C2\u4E0E\u5DE5\u7A0B\u3001\u5EFA\u7B51\u3001\u7535\u6C14\u7CFB\u7EDF\u3001\u51B7\u5374\u3001\u901A\u8BAF\u3001\u7F51\u7EDC\u5B89\u5168\u53CA\u7269\u6D41\u7B49\u9886\u57DF\uFF0C\u6269\u5927\u6570\u636E\u4E2D\u5FC3\u6295\u8D44\u5E26\u6765\u7684\u7ECF\u6D4E\u6548\u76CA\u30022026\u5E74\u6570\u636E\u4E2D\u5FC3\u5CF0\u4F1A\u5C06\u4E3E\u884C\u4E13\u95E8\u5546\u4E1A\u914D\u5BF9\u6D3B\u52A8\uFF0C\u5B89\u639214\u5BB6\u6570\u636E\u4E2D\u5FC3\u4F01\u4E1A\u4E0E51\u5BB6\u672C\u5730\u4F9B\u5E94\u5546\u5BF9\u63A5\uFF0C\u4E3B\u9898\u4E3A\u201C\u63A8\u8FDBAI\u9A71\u52A8\u7684\u6570\u5B57\u57FA\u7840\u8BBE\u65BD\u53CA\u6C38\u7EED\u751F\u6001\u7CFB\u7EDF\u201D\uFF0C\u52A9\u529B\u672C\u571F\u4F9B\u5E94\u94FE\u4F01\u4E1A\u628A\u63E1\u6570\u636E\u4E2D\u5FC3\u4EA7\u4E1A\u53D1\u5C55\u673A\u9047\u3002",
  "body": "\u003Cp\u003E\uFF08\u5409\u9686\u576114\u65E5\u8BAF\uFF09\u9A6C\u6765\u897F\u4E9A\u6295\u8D44\u53D1\u5C55\u5C40\uFF08MIDA\uFF09\u6B63\u5F3A\u5316\u6570\u636E\u4E2D\u5FC3\u4E1A\u5468\u8FB9\u751F\u6001\u7CFB\u7EDF\uFF0C\u534F\u52A9\u672C\u571F\u4F01\u4E1A\u63D0\u5347\u80FD\u529B\uFF0C\u5E76\u53C2\u4E0E\u5DE5\u7A0B\u3001\u5EFA\u7B51\u3001\u7535\u6C14\u7CFB\u7EDF\u3001\u51B7\u5374\u3001\u901A\u8BAF\u3001\u7F51\u7EDC\u5B89\u5168\u53CA\u7269\u6D41\u7B49\u9886\u57DF\uFF0C\u8FDB\u4E00\u6B65\u6269\u5927\u6570\u636E\u4E2D\u5FC3\u6295\u8D44\u5E26\u6765\u7684\u7ECF\u6D4E\u6548\u76CA\u3002\u003C/p\u003E\n\u003Cp\u003E\u8BE5\u5C40\u4E3B\u5E2D\u4E1C\u59D1\u624E\u5BCC\u777F\u6307\u51FA\uFF0C\u6570\u636E\u4E2D\u5FC3\u5E26\u6765\u7684\u5546\u673A\u5E76\u4E0D\u5C40\u9650\u4E8E\u6570\u636E\u4E2D\u5FC3\u672C\u8EAB\u7684\u5B9E\u4F53\u5EFA\u8BBE\uFF0C\u800C\u662F\u5305\u62EC\u73AF\u7ED5\u6570\u636E\u4E2D\u5FC3\u6240\u5F62\u6210\u7684\u66F4\u5E7F\u6CDB\u7ECF\u6D4E\u6EA2\u51FA\u6548\u5E94\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u6570\u636E\u4E2D\u5FC3\u662F\u63A8\u52A8\u6211\u56FD\u6570\u5B57\u53CA\u7B97\u529B\u7ECF\u6D4E\u7684\u5173\u952E\u52A8\u529B\uFF0C\u4F46\u5176\u771F\u6B63\u6210\u529F\u4E0E\u5426\uFF0C\u8FDC\u8FDC\u8D85\u8D8A\u6570\u636E\u673A\u623F\u672C\u8EAB\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u5438\u5F15\u6295\u8D44\u4ECE\u6765\u53EA\u662F\u7B2C\u4E00\u6B65\u3002\u6211\u4EEC\u5982\u4ECA\u7684\u8D23\u4EFB\uFF0C\u662F\u6253\u9020\u4E00\u4E2A\u6C38\u7EED\u3001\u5177\u5305\u5BB9\u6027\u53CA\u957F\u4E45\u53D1\u5C55\u7684\u4EA7\u4E1A\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u624E\u5BCC\u777F\u4ECA\u65E5\u914D\u54082026\u5E74\u6570\u636E\u4E2D\u5FC3\u5CF0\u4F1A\u53D1\u8868\u6587\u544A\u65F6\u6307\u51FA\uFF0C\u9A6C\u6765\u897F\u4E9A\u6700\u7EC8\u8861\u91CF\u6210\u529F\u7684\u6807\u51C6\uFF0C\u4E0D\u5E94\u53EA\u662F\u5438\u5F15\u5230\u7684\u6295\u8D44\u89C4\u6A21\uFF0C\u800C\u662F\u6295\u8D44\u5468\u8FB9\u6240\u521B\u9020\u7684\u4EF7\u503C\uFF0C\u5305\u62EC\u66F4\u5F3A\u5927\u7684\u9A6C\u6765\u897F\u4E9A\u4F01\u4E1A\u3001\u66F4\u6DF1\u539A\u7684\u672C\u571F\u80FD\u529B\uFF0C\u4EE5\u53CA\u4E3A\u56FD\u4EBA\u521B\u9020\u6301\u4E45\u673A\u4F1A\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E0D\u53EA\u8FFD\u6C42\u66F4\u591A\u6570\u636E\u4E2D\u5FC3\u003C/p\u003E\n\u003Cp\u003E\u53E6\u4E00\u65B9\u9762\uFF0C\u5927\u9A6C\u6295\u8D44\u53D1\u5C55\u5C40\u603B\u6267\u884C\u957F\u62FF\u7763\u9521\u4E09\u82CF\u963F\u90FD\u9A6C\u5409\u6307\u51FA\uFF0C\u8BE5\u5C40\u65E5\u76CA\u7740\u91CD\u6253\u9020\u80FD\u591F\u4ECE\u6570\u636E\u4E2D\u5FC3\u4E1A\u589E\u957F\u4E2D\uFF0C\u83B7\u53D6\u66F4\u9AD8\u4EF7\u503C\u7684\u751F\u6001\u7CFB\u7EDF\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u5728\u8BE5\u5C40\u7684\u6587\u544A\u4E2D\u8BF4\uFF0C\u4ECA\u5E74\u7684\u91CD\u70B9\u4E0D\u4EC5\u662F\u5982\u4F55\u6269\u5927\u8BE5\u9886\u57DF\uFF0C\u66F4\u662F\u5982\u4F55\u4E3A\u9A6C\u6765\u897F\u4E9A\u521B\u9020\u6301\u4E45\u4EF7\u503C\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u4EBA\u5DE5\u667A\u80FD\uFF08AI\uFF09\u6B63\u4EE5\u60CA\u4EBA\u901F\u5EA6\u53D1\u5C55\uFF0C\u800C\u5176\u57FA\u7840\u662F\u7B97\u529B\u53CA\u6570\u5B57\u57FA\u7840\u8BBE\u65BD\uFF1B\u7136\u800C\uFF0C\u8FD9\u79CD\u589E\u957F\u5FC5\u987B\u4E0E\u8D1F\u8D23\u4EFB\u7684\u80FD\u6E90\u3001\u6C34\u6E90\u53CA\u571F\u5730\u7BA1\u7406\uFF0C\u4EE5\u53CA\u5728\u56FD\u5185\u57F9\u80B2\u7684\u80FD\u529B\u76F8\u5339\u914D\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u9521\u4E09\u82CF\u8BF4\uFF0C\u5927\u9A6C\u6295\u8D44\u53D1\u5C55\u5C40\u5E76\u4E0D\u53EA\u662F\u5E0C\u671B\u5927\u9A6C\u62E5\u6709\u66F4\u591A\u6570\u636E\u4E2D\u5FC3\uFF0C\u800C\u662F\u8981\u5EFA\u7ACB\u5177\u7ADE\u4E89\u529B\u3001\u521B\u65B0\u6027\u53CA\u6C38\u7EED\u6027\u7684\u751F\u6001\u7CFB\u7EDF\u3002\u003C/p\u003E\n\u003Cp\u003E14\u6570\u636E\u4E2D\u5FC3\u4F01\u4E1A\u5BF9\u63A551\u4F9B\u5E94\u5546\u003C/p\u003E\n\u003Cp\u003E\u5927\u9A6C\u6295\u8D44\u53D1\u5C55\u5C40\u6307\u51FA\uFF0C2026\u5E74\u6570\u636E\u4E2D\u5FC3\u5CF0\u4F1A\u5C06\u4E3E\u884C\u4E13\u95E8\u7684\u5546\u4E1A\u914D\u5BF9\u6D3B\u52A8\uFF0C\u5B89\u639214\u5BB6\u6570\u636E\u4E2D\u5FC3\u4F01\u4E1A\u4E0E51\u5BB6\u672C\u5730\u4F9B\u5E94\u5546\u5BF9\u63A5\uFF0C\u4EE5\u63A2\u7D22\u6F5C\u5728\u5408\u4F5C\u53CA\u4F9B\u5E94\u94FE\u5546\u673A\u3002\u003C/p\u003E\n\u003Cp\u003E\u8FD9\u6BD4\u53BB\u5E74\u7684\u9996\u5C4A\u5CF0\u4F1A\u53D6\u5F97\u8FDB\u4E00\u6B65\u6269\u5C55\uFF1B\u5F53\u65F6\u5171\u67098\u5BB6\u6570\u636E\u4E2D\u5FC3\u4F01\u4E1A\u4E0E17\u5BB6\u4F9B\u5E94\u94FE\u4F01\u4E1A\u8FDB\u884C\u5BF9\u63A5\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ECA\u5E74\u5CF0\u4F1A\u4E3B\u9898\u4E3A\u201C\u63A8\u8FDBAI\u9A71\u52A8\u7684\u6570\u5B57\u57FA\u7840\u8BBE\u65BD\u53CA\u6C38\u7EED\u751F\u6001\u7CFB\u7EDF\u201D\uFF0C\u6D3B\u52A8\u6C47\u96C6\u6570\u636E\u4E2D\u5FC3\u8425\u8FD0\u5546\u3001\u79D1\u6280\u4F01\u4E1A\u3001\u653F\u5E9C\u673A\u6784\u3001\u91D1\u878D\u673A\u6784\u53CA\u672C\u5730\u4F9B\u5E94\u94FE\u4F01\u4E1A\uFF0C\u5171\u540C\u63A2\u8BA8\u672C\u5730\u6570\u636E\u4E2D\u5FC3\u751F\u6001\u7CFB\u7EDF\u53D1\u5C55\u7684\u4E0B\u4E00\u9636\u6BB5\u3002\u003C/p\u003E\n",
