36\u9020\u4E1A\u57FA\u5730\uFF0C\u5728\u7535\u529B\u88C5\u5907\u3001\u53D1\u5236\u54C1\u3001\u98DF\u54C1\u52A0\u5DE5\u53CA\u73B0\u4EE3\u5546\u8D38\u7B49\u9886\u57DF\u5F62\u6210\u4E86\u9C9C\u660E\u7684\u4EA7\u4E1A\u7279\u8272\u3002\u8FD1\u5E74\u6765\uFF0C\u968F\u7740\u4E2D\u56FD\u4E0E\u4E1C\u76DF\u7ECF\u8D38\u5F80\u6765\u6301\u7EED\u6DF1\u5316\uFF0C\u8BB8\u660C\u4F18\u52BF\u4EA7\u4E1A\u4E0E\u9A6C\u6765\u897F\u4E9A\u53CA\u4E1C\u5357\u4E9A\u5E02\u573A\u7684\u5408\u4F5C\u7A7A\u95F4\u4E0D\u65AD\u62D3\u5C55\u3002\u6B64\u6B21\u8003\u5BDF\u4F7F\u4EE3\u8868\u56E2\u8FDB\u4E00\u6B65\u4E86\u89E3\u4E86\u8BB8\u660C\u91CD\u70B9\u4F01\u4E1A\u7684\u6280\u672F\u5B9E\u529B\u3001\u4EA7\u54C1\u4F18\u52BF\u53CA\u53D1\u5C55\u6F5C\u529B\uFF0C\u4E5F\u4E3A\u8C6B\u9A6C\u4E24\u5730\u4F01\u4E1A\u52A0\u5F3A\u4EA7\u4E1A\u8D44\u6E90\u5BF9\u63A5\u3001\u62D3\u5C55\u8D38\u6613\u6E20\u9053\u521B\u9020\u4E86\u826F\u597D\u5951\u673A\u3002\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u8C6B\u5546\u8054\u5408\u4F1A\u5BF9\u8BB8\u660C\u5E02\u5546\u52A1\u5C40\u3001\u5E02\u5916\u529E\u3001\u5E02\u8D38\u4FC3\u4F1A\u7B49\u6709\u5173\u5355\u4F4D\u7684\u70ED\u60C5\u63A5\u5F85\u4E0E\u5468\u5230\u5B89\u6392\u8868\u793A\u8877\u5FC3\u611F\u8C22\u3002\u672A\u6765\uFF0C\u5546\u4F1A\u5C06\u7EE7\u7EED\u53D1\u6325\u8FDE\u63A5\u6CB3\u5357\u4E0E\u9A6C\u6765\u897F\u4E9A\u7684\u6865\u6881\u7EBD\u5E26\u4F5C\u7528\uFF0C\u79EF\u6781\u63A8\u52A8\u8BB8\u660C\u4F18\u52BF\u4F01\u4E1A\u4E0E\u9A6C\u6765\u897F\u4E9A\u5E02\u573A\u8D44\u6E90\u5BF9\u63A5\uFF0C\u4FC3\u8FDB\u53CC\u65B9\u5728\u667A\u80FD\u5236\u9020\u3001\u98DF\u54C1\u52A0\u5DE5\u3001\u7535\u529B\u88C5\u5907\u3001\u8DE8\u5883\u8D38\u6613\u53CA\u73B0\u4EE3\u670D\u52A1\u4E1A\u7B49\u9886\u57DF\u6DF1\u5316\u52A1\u5B9E\u5408\u4F5C\uFF0C\u52A9\u529B\u66F4\u591A\u6CB3\u5357\u4F18\u8D28\u4EA7\u54C1\u548C\u4F01\u4E1A\u5F00\u62D3\u4E1C\u76DF\u5E02\u573A\uFF0C\u4E3A\u63A8\u52A8\u8C6B\u9A6C\u7ECF\u8D38\u5408\u4F5C\u8D70\u6DF1\u8D70\u5B9E\u8D21\u732E\u529B\u91CF\u3002\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u8C6B\u5546\u8054\u5408\u4F1A\u5E38\u52A1\u526F\u4F1A\u957F\u9EC4\u4E1C\u742A\u3001\u526F\u4F1A\u957F\u674E\u4E66\u667A\u3001\u91D1\u519B\u4F1F\uFF0C\u526F\u4F1A\u957F\u517C\u9A6C\u6765\u897F\u4E9A\u8C6B\u5546\u8054\u5408\u4F1A\u6D4E\u6E90\u5206\u4F1A\u4F1A\u957F\u51AF\u53CC\u559C\uFF0C\u4EE5\u53CA\u4F1A\u5458\u6F58\u4E16\u4E1C\u3001\u5E2D\u806A\u654F\u3001\u9A6C\u8D85\u7136\u7B49\u53C2\u4E0E\u51FA\u5E2D\u672C\u6B21\u8003\u5BDF\u6D3B\u52A8\u3002\u003C/p\u003E\n",
