{
  "id": "%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e5%85%ad%e5%ae%b6%e4%b8%bb%e8%a6%81%e5%ae%98%e8%81%94%e6%8a%95%e8%b5%84%e5%85%ac%e5%8f%b8-%e6%89%bf%e8%af%ba%e6%9c%aa%e6%9d%a55%e5%b9%b4%e5%86%85%e7%9b%b4",
  "slug": "%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e5%85%ad%e5%ae%b6%e4%b8%bb%e8%a6%81%e5%ae%98%e8%81%94%e6%8a%95%e8%b5%84%e5%85%ac%e5%8f%b8-%e6%89%bf%e8%af%ba%e6%9c%aa%e6%9d%a55%e5%b9%b4%e5%86%85%e7%9b%b4",
  "canonicalUrlKey": "%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e5%85%ad%e5%ae%b6%e4%b8%bb%e8%a6%81%e5%ae%98%e8%81%94%e6%8a%95%e8%b5%84%e5%85%ac%e5%8f%b8-%e6%89%bf%e8%af%ba%e6%9c%aa%e6%9d%a55%e5%b9%b4%e5%86%85%e7%9b%b4",
  "route": "/5010/",
  "title": "\u9A6C\u6765\u897F\u4E9A\u516D\u5BB6\u4E3B\u8981\u5B98\u8054\u6295\u8D44\u516C\u53F8  \u627F\u8BFA\u672A\u67655\u5E74\u5185\u76F4\u63A5\u6295\u8D44\u9886\u57DF\u6CE8\u51651200\u4EBF\u4EE4\u5409\u8D44\u91D1",
  "summary": "\u5B89\u534E\u3002 \u9A6C\u65B0\u793E \uFF08\u5409\u9686\u57618\u65E5\u8BAF\uFF09\u5728\u8D22\u653F\u90E8\u7275\u5934\u7684\u4E00\u4E2A\u8BA1\u5212\u4E0B\uFF0C\u516D\u5BB6\u4E3B\u8981\u5B98\u8054\u6295\u8D44\u516C\u53F8\u627F\u8BFA\u5728\u672A\u67655\u5E74\u5185\uFF0C\u5411\u56FD\u5185\u76F4\u63A5\u6295\u8D44\u9886\u57DF\u6CE8\u5165\u9AD8\u8FBE1200\u4EBF\u4EE4\u5409\u7684\u8D44\u91D1\u3002 \u6B64\u5916\uFF0C\u4F5C\u4E3A\u6301\u7EED\u6295\u8D44\u6D3B\u52A8\u7684\u4E00\u90E8\u5206\uFF0C\u5B83\u4EEC\u8FD8\u5C06\u5728\u516C\u5171\u5E02\u573A\u6295\u8D444400\u4EBF\u4EE4\u5409\u3002 6\u5BB6\u4E3B\u8981\u5B98\u8054\u6295\u8D44\u516C\u53F8\u662F\u56FD\u5E93\u63A7\u80A1\uFF08KHAZANAH\uFF09\u3001\u96C7\u5458\u516C\u79EF\u91D1\u5C40\uFF08KWSP\uFF09\u3001\u516C\u52A1\u5458\u9000\u4F11\u57FA\u91D1\u5C40\uFF08KWAP\uFF09\u3001\u56FD\u6C11\u6295\u8D44\u673A\u6784\uFF08PNB\uFF09\u3001\u671D\u5723\u57FA\u91D1\u5C40\u548C\u6B66\u88C5\u90E8\u961F\u57FA\u91D1\u5C40\uFF08LTAT\uFF09\u3002 \u5B83\u4EEC\u5C06\u5229\u7528\u5404\u81EA\u7684\u4E13\u4E1A\u77E5\u8BC6\uFF0C\u5B9E\u73B0\u5171\u540C\u76EE\u6807\uFF0C\u5373\u63D0\u5347\u56FD\u5BB6\u7ECF\u6D4E\u5730\u4F4D\u548C\u63D0\u9AD8\u4EBA\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/08/frc-49ef1a6e88f3618d77c22ea69a49ff2d.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5B89\u534E\u3002\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u65B0\u793E\u003C/p\u003E\n\u003Cp\u003E\uFF08\u5409\u9686\u57618\u65E5\u8BAF\uFF09\u5728\u8D22\u653F\u90E8\u7275\u5934\u7684\u4E00\u4E2A\u8BA1\u5212\u4E0B\uFF0C\u516D\u5BB6\u4E3B\u8981\u5B98\u8054\u6295\u8D44\u516C\u53F8\u627F\u8BFA\u5728\u672A\u67655\u5E74\u5185\uFF0C\u5411\u56FD\u5185\u76F4\u63A5\u6295\u8D44\u9886\u57DF\u6CE8\u5165\u9AD8\u8FBE1200\u4EBF\u4EE4\u5409\u7684\u8D44\u91D1\u3002\u003C/p\u003E\n\u003Cp\u003E\u6B64\u5916\uFF0C\u4F5C\u4E3A\u6301\u7EED\u6295\u8D44\u6D3B\u52A8\u7684\u4E00\u90E8\u5206\uFF0C\u5B83\u4EEC\u8FD8\u5C06\u5728\u516C\u5171\u5E02\u573A\u6295\u8D444400\u4EBF\u4EE4\u5409\u3002\u003C/p\u003E\n\u003Cp\u003E6\u5BB6\u4E3B\u8981\u5B98\u8054\u6295\u8D44\u516C\u53F8\u662F\u56FD\u5E93\u63A7\u80A1\uFF08KHAZANAH\uFF09\u3001\u96C7\u5458\u516C\u79EF\u91D1\u5C40\uFF08KWSP\uFF09\u3001\u516C\u52A1\u5458\u9000\u4F11\u57FA\u91D1\u5C40\uFF08KWAP\uFF09\u3001\u56FD\u6C11\u6295\u8D44\u673A\u6784\uFF08PNB\uFF09\u3001\u671D\u5723\u57FA\u91D1\u5C40\u548C\u6B66\u88C5\u90E8\u961F\u57FA\u91D1\u5C40\uFF08LTAT\uFF09\u3002\u003C/p\u003E\n\u003Cp\u003E\u5B83\u4EEC\u5C06\u5229\u7528\u5404\u81EA\u7684\u4E13\u4E1A\u77E5\u8BC6\uFF0C\u5B9E\u73B0\u5171\u540C\u76EE\u6807\uFF0C\u5373\u63D0\u5347\u56FD\u5BB6\u7ECF\u6D4E\u5730\u4F4D\u548C\u63D0\u9AD8\u4EBA\u6C11\u751F\u6D3B\u8D28\u91CF\u3002\u003C/p\u003E\n\u003Cp\u003E\u8FD9\u4E00\u6218\u7565\u6027\u8BA1\u5212\u662F\u8D22\u653F\u90E8\u63A8\u51FA\u7684GEAR-uP\u8BA1\u5212\uFF0C\u65E8\u5728\u4FC3\u8FDB\u5173\u952E\u9886\u57DF\u7684\u589E\u957F\u3002\u003C/p\u003E\n\u003Cp\u003E\u8D22\u653F\u90E8\u4ECA\u5929\u53D1\u8868\u6587\u544A\u6307\u51FA\uFF0C\u8FD9\u4E9B\u6295\u8D44\u5C06\u63A8\u52A8\u9AD8\u589E\u957F\u9AD8\u4EF7\u503C\uFF08HGHV\uFF09\u4EA7\u4E1A\u7684\u53D1\u5C55\uFF0C\u5305\u62EC\u80FD\u6E90\u8F6C\u578B\u548C\u5148\u8FDB\u5236\u9020\u4E1A\uFF0C\u7279\u522B\u662F\u5728\u534A\u5BFC\u4F53\u9886\u57DF\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u8FD9\u4E9B\u6295\u8D44\u5C06\u6DB5\u76D6\u6574\u4E2A\u4E1A\u52A1\u5468\u671F\uFF0C\u5305\u62EC\u521D\u521B\u516C\u53F8\u3001\u98CE\u9669\u8D44\u672C\u4EE5\u53CA\u4E2D\u671F\u516C\u53F8\uFF0C\u6700\u7EC8\u5E2E\u52A9\u8FD9\u4E9B\u516C\u53F8\u4E0A\u5E02\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u9996\u76F8\u517C\u8D22\u653F\u90E8\u957F\u62FF\u7763\u65AF\u91CC\u5B89\u534E\u8868\u793A\uFF0C\u5B9E\u73B0\u660C\u660E\u7ECF\u6D4E\u6846\u67B6\u7684\u613F\u666F\u76EE\u6807\u9700\u8981\u5168\u56FD\u5305\u62EC\u4F01\u4E1A\u754C\u7684\u5171\u540C\u52AA\u529B\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u901A\u8FC7\u8BA9\u5B98\u8054\u6295\u8D44\u516C\u53F8\u52A0\u5F3A\u5BF9\u56FD\u5185\u76F4\u63A5\u6295\u8D44\u7684\u5173\u6CE8\uFF0C\u8FD9\u7B14\u6295\u5165\u7684\u8D44\u91D1\u53EF\u4EE5\u516C\u5E73\u5730\u60E0\u53CA\u5927\u9A6C\u4EBA\uFF0C\u5E76\u50AC\u751F\u65B0\u7684\u7ECF\u6D4E\u751F\u6001\u7CFB\u7EDF\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6628\u65E5\u5728GEAR-uP\u8BA1\u5212\u542F\u52A8\u4EEA\u5F0F\u4E0A\u8BF4\uFF0C\u8FD9\u4E9B\u5B98\u8054\u6295\u8D44\u516C\u53F8\u7BA1\u7406\u7684\u8D44\u4EA7\u603B\u989D\u8D85\u8FC71\u51468000\u4EBF\u4EE4\u5409\uFF0C\u5927\u81F4\u76F8\u5F53\u4E8E\u5927\u9A6C\u540D\u4E49\u56FD\u5185\u751F\u4EA7\u603B\u503C\uFF0C\u5B83\u4EEC\u62E5\u6709\u5728\u7ECF\u6D4E\u4EF7\u503C\u94FE\u4E0A\u63A8\u52A8\u56FD\u5BB6\u5D1B\u8D77\uFF0C\u5E76\u6539\u5584\u5927\u9A6C\u4EBA\u751F\u6D3B\u7684\u8D22\u52A1\u80FD\u529B\u3002\u003C/p\u003E\n\u003Cp\u003E\u8D22\u653F\u90E8\u8868\u793A\uFF0C\u6BCF\u5BB6\u5B98\u8054\u6295\u8D44\u516C\u53F8\u90FD\u5C06\u5728\u8BE5\u8BA1\u5212\u4E2D\u5404\u6709\u5176\u91CD\u70B9\u5173\u6CE8\u7684\u9886\u57DF\u3002\u003C/p\u003E\n\u003Cp\u003E\u56FD\u5E93\u63A7\u80A1\u5C06\u7740\u624B\u63A8\u884C\u5176\u5927\u9A6C\u6295\u8D44\u6218\u7565\uFF0C\u8BE5\u6218\u7565\u4EE5\u201C\u5EFA\u8BBE\u56FD\u5BB6\u201D\u6846\u67B6\u4E3A\u57FA\u7840\uFF0C\u4EE5\u63D0\u9AD8\u56FD\u5BB6\u751F\u4EA7\u529B\u548C\u7ADE\u4E89\u529B\uFF0C\u800C\u516C\u52A1\u5458\u9000\u4F11\u57FA\u91D1\u5C40\u5C06\u4E13\u6CE8\u4E8E\u589E\u5F3A\u5927\u9A6C\u79C1\u52DF\u80A1\u6743\u3001\u57FA\u7840\u8BBE\u65BD\u548C\u623F\u5730\u4EA7\u9886\u57DF\u7684\u79C1\u4EBA\u5E02\u573A\uFF0C\u91CD\u70B9\u662F\u901A\u8FC7Dana Perintis\u548CDana Pemacu\u4E3A\u98CE\u9669\u6295\u8D44\u548C\u6210\u957F\u9636\u6BB5\u516C\u53F8\u63D0\u4F9B\u50AC\u5316\u5242\u57FA\u91D1\u3002\u003C/p\u003E\n\u003Cp\u003E\u800C\u56FD\u6C11\u6295\u8D44\u673A\u6784\u65E8\u5728\u4F7F\u5927\u9A6C\u5DE5\u4E1A\u548C\u4F01\u4E1A\u73B0\u4EE3\u5316\uFF0C\u4EE5\u5B9E\u73B0\u66F4\u9AD8\u9644\u52A0\u503C\u548C\u53EF\u6301\u7EED\u7684\u6D3B\u52A8\uFF0C\u7279\u522B\u5173\u6CE8\u5BF9\u65B0\u5DE5\u4E1A\u56ED\u533A\u7684\u6295\u8D44\uFF0C\u652F\u6301\u68D5\u6CB9\u7684\u81EA\u52A8\u5316\u548C\u667A\u80FD\u519C\u4E1A\uFF0C\u4EE5\u53CA\u7EFF\u8272\u548C\u80FD\u6E90\u8F6C\u578B\u8D44\u4EA7\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u516C\u79EF\u91D1\u5C40\u5C06\u81F4\u529B\u4E8E\u5EFA\u8BBE\u4E00\u4E2A\u6709\u5C0A\u4E25\u3001\u7E41\u8363\u7684\u8001\u9F84\u5316\u793E\u4F1A\uFF0C\u5305\u62EC\u4E0E\u653F\u5E9C\u5408\u4F5C\u6295\u8D44\u4E8E\u5177\u6709\u5546\u4E1A\u53EF\u884C\u6027\u7684\u6C38\u7EED\u533B\u7597\u4FDD\u5065\u89E3\u51B3\u65B9\u6848\uFF0C\u4EE5\u53CA\u6309\u7167\u536B\u751F\u90E8\u5021\u5BFC\u7684\u536B\u751F\u8F6C\u578B\u8BAE\u7A0B\uFF0C\u5728\u653F\u5E9C\u533B\u9662\u5EFA\u8BBE\u79C1\u4EBA\u81C2\u8180\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u800C\u671D\u5723\u57FA\u91D1\u5C40\u5C06\u6269\u5927\u56DE\u6559\u94F6\u884C\u7684\u4F5C\u7528\uFF0C\u5305\u62EC\u901A\u8FC7\u56DE\u6559\u91D1\u878D\u5DE5\u5177\u52A0\u5F3A\u6C38\u7EED\u793E\u4F1A\u5F71\u54CD\uFF0C\u4EE5\u4FBF\u7B80\u5316\u63F4\u52A9\u91D1\u53D1\u653E\u5230\u8D2B\u6C11\u7684\u7A0B\u5E8F\uFF0C\u5E76\u901A\u8FC7\u4E0E\u5176\u4ED6\u4E3B\u8981\u91D1\u878D\u673A\u6784\u548C\u5E02\u573A\u53C2\u4E0E\u8005\u7684\u6218\u7565\u5408\u4F5C\uFF0C\u6269\u5927\u56DE\u6559\u91D1\u878D\u4F53\u7CFB\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u6B66\u88C5\u90E8\u961F\u57FA\u91D1\u5C40\u5219\u5C06\u901A\u8FC7\u52A0\u5F3A\u751F\u4EA7\u672C\u5730\u751F\u7269\u5236\u836F\u4EA7\u54C1\u7684\u80FD\u529B\uFF0C\u63D0\u5347\u5927\u9A6C\u5236\u836F\u7684\u4EF7\u503C\u521B\u9020\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/MSqp0GctHRhS4enEn-nXRw\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
