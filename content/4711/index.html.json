{
  "id": "%e4%b8%ba%e4%b8%ad%e4%bc%81%e6%8f%90%e4%be%9b%e8%af%a6%e7%bb%86%e8%b5%84%e8%ae%af-%e9%a9%ac%e4%b8%ad%e6%80%bb%e5%95%86%e4%bc%9a%e6%8e%a8%e6%8a%95%e8%b5%84%e5%a4%a7%e9%a9%ac%e6%89%8b%e5%86%8c",
  "slug": "%e4%b8%ba%e4%b8%ad%e4%bc%81%e6%8f%90%e4%be%9b%e8%af%a6%e7%bb%86%e8%b5%84%e8%ae%af-%e9%a9%ac%e4%b8%ad%e6%80%bb%e5%95%86%e4%bc%9a%e6%8e%a8%e6%8a%95%e8%b5%84%e5%a4%a7%e9%a9%ac%e6%89%8b%e5%86%8c",
  "canonicalUrlKey": "%e4%b8%ba%e4%b8%ad%e4%bc%81%e6%8f%90%e4%be%9b%e8%af%a6%e7%bb%86%e8%b5%84%e8%ae%af-%e9%a9%ac%e4%b8%ad%e6%80%bb%e5%95%86%e4%bc%9a%e6%8e%a8%e6%8a%95%e8%b5%84%e5%a4%a7%e9%a9%ac%e6%89%8b%e5%86%8c",
  "route": "/4711/",
  "title": "\u4E3A\u4E2D\u4F01\u63D0\u4F9B\u8BE6\u7EC6\u8D44\u8BAF \u9A6C\u4E2D\u603B\u5546\u4F1A\u63A8\u6295\u8D44\u5927\u9A6C\u624B\u518C",
  "summary": "\uFF08\u5409\u9686\u57618\u65E5\u8BAF\uFF09\u9A6C\u6765\u897F\u4E9A-\u4E2D\u56FD\u603B\u5546\u4F1A\uFF08\u9A6C\u4E2D\u603B\u5546\u4F1A\uFF09\u5C06\u51FA\u7248\u300A\u6295\u8D44\u5927\u9A6C\uFF1A\u4E2D\u56FD\u6295\u8D44\u8005\u624B\u518C\u300B\uFF0C\u4E3A\u51C6\u5907\u5230\u5927\u9A6C\u6295\u8D44\u7684\u4E2D\u56FD\u4F01\u4E1A\u63D0\u4F9B\u8BE6\u7EC6\u7684\u8D44\u8BAF\uFF0C\u8BA9\u4ED6\u4EEC\u8282\u7701\u65F6\u95F4\u548C\u91D1\u94B1\uFF0C\u5C11\u8D70\u51A4\u6789\u8DEF\u3002 \u9A6C\u4E2D\u603B\u5546\u4F1A\u603B\u4F1A\u957F\u5362\u56FD\u7965\u8868\u793A\uFF0C\u8BE5\u4F1A\u63A5\u83B7\u4E2D\u56FD\u4F01\u4E1A\u5BB6\u548C\u6295\u8D44\u8005\u53CD\u6620\uFF0C\u5E0C\u671B\u80FD\u6709\u66F4\u591A\u5173\u4E8E\u5927\u9A6C\u6295\u8D44\u7684\u8D44\u6599\u548C\u8BAF\u606F\uFF0C\u5305\u62EC\u653F\u7B56\u548C\u6CD5\u5F8B\u95EE\u9898\uFF0C\u8FD8\u6709\u5404\u79CD\u7A0E\u52A1\u3001\u4F1A\u8BA1\u7B49\u65B9\u9762\u7684\u8D44\u8BAF\u3002 \u4ED6\u4ECA\u65E5\u5728\u8BB0\u8005\u4F1A\u4E0A\u8BF4\uFF0C\u5404\u65B9\u9762\u7684\u8D44\u8BAF\u5C06\u5BF9\u6709\u610F\u5230\u6211\u56FD\u6295\u8D44\u7684\u4E2D\u8D44\u6709\u5F88\u5927\u7684\u5E2E\u52A9\uFF0C\u56E0\u6B64\u8D81\u7740\u9A6C\u4E2D\u5EFA\u4EA450\u5468\u5E74\u4E4B\u9645\uFF0C\u901A\u8FC7\u51FA\u7248\u6B64\u624B\u518C\uFF0C\u8BF4\u597D\u9A6C\u4E2D\u6545\u4E8B\u3001\u642D\u5EFA\u5546\u4E1A\u5E73\u53F0\uFF0C\u8BA9\u4E2D\u8D44\u638C\u63E1\u2026",
  "body": "\u003Cp\u003E\uFF08\u5409\u9686\u57618\u65E5\u8BAF\uFF09\u9A6C\u6765\u897F\u4E9A-\u4E2D\u56FD\u603B\u5546\u4F1A\uFF08\u9A6C\u4E2D\u603B\u5546\u4F1A\uFF09\u5C06\u51FA\u7248\u300A\u6295\u8D44\u5927\u9A6C\uFF1A\u4E2D\u56FD\u6295\u8D44\u8005\u624B\u518C\u300B\uFF0C\u4E3A\u51C6\u5907\u5230\u5927\u9A6C\u6295\u8D44\u7684\u4E2D\u56FD\u4F01\u4E1A\u63D0\u4F9B\u8BE6\u7EC6\u7684\u8D44\u8BAF\uFF0C\u8BA9\u4ED6\u4EEC\u8282\u7701\u65F6\u95F4\u548C\u91D1\u94B1\uFF0C\u5C11\u8D70\u51A4\u6789\u8DEF\u3002\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u4E2D\u603B\u5546\u4F1A\u603B\u4F1A\u957F\u5362\u56FD\u7965\u8868\u793A\uFF0C\u8BE5\u4F1A\u63A5\u83B7\u4E2D\u56FD\u4F01\u4E1A\u5BB6\u548C\u6295\u8D44\u8005\u53CD\u6620\uFF0C\u5E0C\u671B\u80FD\u6709\u66F4\u591A\u5173\u4E8E\u5927\u9A6C\u6295\u8D44\u7684\u8D44\u6599\u548C\u8BAF\u606F\uFF0C\u5305\u62EC\u653F\u7B56\u548C\u6CD5\u5F8B\u95EE\u9898\uFF0C\u8FD8\u6709\u5404\u79CD\u7A0E\u52A1\u3001\u4F1A\u8BA1\u7B49\u65B9\u9762\u7684\u8D44\u8BAF\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u4ECA\u65E5\u5728\u8BB0\u8005\u4F1A\u4E0A\u8BF4\uFF0C\u5404\u65B9\u9762\u7684\u8D44\u8BAF\u5C06\u5BF9\u6709\u610F\u5230\u6211\u56FD\u6295\u8D44\u7684\u4E2D\u8D44\u6709\u5F88\u5927\u7684\u5E2E\u52A9\uFF0C\u56E0\u6B64\u8D81\u7740\u9A6C\u4E2D\u5EFA\u4EA450\u5468\u5E74\u4E4B\u9645\uFF0C\u901A\u8FC7\u51FA\u7248\u6B64\u624B\u518C\uFF0C\u8BF4\u597D\u9A6C\u4E2D\u6545\u4E8B\u3001\u642D\u5EFA\u5546\u4E1A\u5E73\u53F0\uFF0C\u8BA9\u4E2D\u8D44\u638C\u63E1\u7B87\u4E2D\u7684\u8D44\u8BAF\u3002\u003C/p\u003E\n\u003Cp\u003E\u8BE5\u4F1A\u4E5F\u5C06\u6839\u636E\u5404\u4E2A\u9886\u57DF\u9074\u9009\u51FA100\u5BB6\u672C\u5730\u4F01\u4E1A\uFF0C\u5C06\u4F01\u4E1A\u76F8\u5173\u8D44\u6599\u6536\u5F55\u518C\u4E2D\u3002\u003C/p\u003E\n\u003Cp\u003E\u8FD9\u5C06\u79EF\u6781\u4E3A\u4E24\u56FD\u7ECF\u6D4E\u7E41\u8363\u4E0E\u53D1\u5C55\u8D21\u732E\u529B\u91CF\uFF0C\u4E3A\u6211\u56FD\u76F8\u5173\u4F01\u4E1A\uFF0C\u5305\u62EC\u4E2D\u5C0F\u4F01\u4E1A\u5EFA\u7ACB\u8D77\u4E0E\u4E2D\u8D44\u5408\u4F5C\u7684\u5E73\u53F0\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u76EE\u524D\u9501\u5B9A\u670D\u52A1\u9886\u57DF\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u5362\u56FD\u7965\u8BF4\uFF0C\u300A\u6295\u8D44\u5927\u9A6C\uFF1A\u4E2D\u56FD\u6295\u8D44\u8005\u624B\u518C\u300B\u624B\u518C\u76EE\u524D\u4EE5\u670D\u52A1\u4E1A\u4E3A\u4E3B\uFF0C\u4F46\u4E0D\u6392\u9664\u5728\u672A\u6765\u63A8\u51FA\u5176\u4ED6\u9886\u57DF\u7684\u624B\u518C\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u76EE\u524D\u8FD9\u672C\u624B\u518C\u9501\u5B9A\u7684\u9886\u57DF\uFF0C\u5305\u62EC\u5927\u9A6C\u516C\u53F8\u79D8\u4E66\u3001\u5BA1\u8BA1\u4E0E\u7A0E\u52A1\u516C\u53F8\u3001\u5F8B\u5E08\u4E8B\u52A1\u6240\u3001\u8C18\u8BE2\u670D\u52A1\u3001\u8D44\u8BAF\u79D1\u6280\u3001\u7269\u6D41\u3001\u5DE5\u4E1A\u56ED\u3001\u623F\u4EA7\u3001\u975E\u4EBA\u5BFF\u4FDD\u9669\u7ECF\u7EAA\uFF08\u706B\u9669\u3001\u76D7\u7A83\u4FDD\u9669\u3001\u6C34\u707E\u9669\u7B49\uFF09\u3001\u533B\u7597\u3001\u65C5\u6E38\u670D\u52A1\uFF08\u5DF4\u58EB\u3001\u5FB7\u58EB\u3001\u516C\u53F8\u8F66\uFF09\u3001\u52B3\u5DE5\u4F9B\u5E94\u3001\u6559\u80B2\u673A\u6784\uFF08\u5E7C\u513F\u56ED\u81F3\u5927\u5B66\uFF09\u3001\u82F1\u8BED\u5B66\u6821\u7B49\u3002\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u4E2D\u603B\u5546\u4F1A\u6C38\u4E45\u8363\u8A89\u4F1A\u957F\u62FF\u7763\u9648\u53CB\u4FE1\u8BF4\uFF0C\u8BE5\u4F1A\u5C06\u6210\u7ACB\u8BC4\u5BA1\u9074\u9009\u5C0F\u7EC4\u4EE5\u786E\u4FDD\u624B\u518C\u5177\u6709\u516C\u4FE1\u529B\uFF0C\u6240\u6709\u88AB\u5F55\u7528\u7684\u4E1A\u8005\u80CC\u666F\u5C06\u5728\u8BC4\u4F30\u540E\u624D\u4F1A\u5C06\u5176\u8D44\u8BAF\u6536\u5F55\u624B\u518C\u4E2D\uFF0C\u8BA9\u4E2D\u8D44\u53C2\u8003\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u8BE5\u5546\u4F1A\u4E5F\u5C06\u5B9A\u671F\u68C0\u8BA8\u624B\u518C\u5185\u7684\u540D\u5355\uFF0C\u540C\u65F6\u6839\u636E\u4F7F\u7528\u8005\u7684\u53CD\u9988\u518D\u8BC4\u4F30\u76F8\u5173\u516C\u53F8\u662F\u5426\u9002\u5408\u7EE7\u7EED\u7559\u5728\u518C\u5B50\u5185\uFF0C\u786E\u4FDD\u672C\u5730\u4F01\u4E1A\u670D\u52A1\u5230\u4F4D\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/05/frc-a3997595e77dc50ef22d0b2ef1385184.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u53EF\u52A9\u4E2D\u4F01\u6295\u8D44\u7701\u65F6\u95F4\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u4E2D\u603B\u5546\u4F1A\u540D\u8A89\u4F1A\u957F\u5B59\u5EFA\u709C\u6307\u51FA\uFF0C\u8FC7\u53BB\u5230\u6211\u56FD\u6295\u8D44\u7684\u4E2D\u56FD\u4F01\u4E1A\u5BB6\u90FD\u7ECF\u5386\u5404\u79CD\u95EE\u9898\uFF0C\u300A\u6295\u8D44\u5927\u9A6C\uFF1A\u4E2D\u56FD\u6295\u8D44\u8005\u624B\u518C\u300B\u5C06\u80FD\u7F29\u77ED\u4ED6\u4EEC\u5230\u5927\u9A6C\u6295\u8D44\u7684\u7B79\u5907\u65F6\u95F4\u81F3\u5C111\u81F32\u4E2A\u6708\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u5728\u4E2D\u7F8E\u8D38\u6613\u6218\u4E0B\uFF0C\u4E2D\u8D44\u7EB7\u7EB7\u8D70\u51FA\u6D77\u5916\u6269\u5927\u5408\u4F5C\uFF0C\u5728\u6280\u672F\u539F\u6599\u5404\u65B9\u9762\u5F97\u5230\u56FD\u9645\u5316\u7684\u4F9B\u5E94\u94FE\u63D0\u5347\u624D\u80FD\u63D0\u9AD8\u7ADE\u4E89\u4F18\u52BF\uFF0C\u5927\u9A6C\u662F\u4E2D\u8D44\u8D70\u51FA\u6D77\u5916\u7684\u91CD\u8981\u8282\u70B9\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u5927\u9A6C\u548C\u4E2D\u56FD\u7684\u4ECE\u5546\u73AF\u5883\u5927\u4E0D\u540C\uFF0C\u8BB8\u591A\u4E2D\u8D44\u6765\u9A6C\u6295\u8D44\u90FD\u662F\u4ECE\u6CE8\u518C\u516C\u53F8\u5F00\u59CB\u5B66\u4E60\uFF0C\u5927\u591A\u6570\u901A\u8FC7\u719F\u4EBA\u5F15\u8350\uFF0C\u56E0\u6B64\u672C\u624B\u518C\u80FD\u8BA9\u4E2D\u8D44\u627E\u5230\u5408\u9002\u81EA\u5BB6\u7684\u670D\u52A1\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u201C\u9664\u4E86\u4ECB\u7ECD\u5927\u9A6C\u7684\u5546\u4E1A\u73AF\u5883\uFF0C\u5185\u5BB9\u4E5F\u5305\u62EC\u5B66\u6821\u3001\u5546\u5708\u3001\u843D\u5730\u8003\u5BDF\u63A8\u8350\u7B49\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6307\u51FA\uFF0C\u672C\u5730\u4F01\u4E1A\u4E5F\u53EF\u4EE5\u900F\u8FC7\u624B\u518C\u4E86\u89E3\u4E2D\u8D44\u6240\u9700\u8D44\u6599\uFF0C\u4ECE\u800C\u63D0\u5347\u670D\u52A1\u3002\u003C/p\u003E\n\u003Cp\u003E\u51FA\u5E2D\u8005\u8FD8\u6709\u9A6C\u4E2D\u603B\u5546\u4F1A\u540D\u8A89\u987E\u95EE\u738B\u5EFA\u6C11\u535A\u58EB\u3001\u79D8\u4E66\u957F\u9648\u4E91\u67AB\u3001\u9752\u5E74\u4F01\u4E1A\u5BB6\u59D4\u5458\u4F1A\u4E3B\u5E2D\u6797\u52B1\u80AF\uFF0C\u4EE5\u53CAYYC\u8D85\u8D8A\u96C6\u56E2\u9500\u552E\u4E0E\u8425\u9500\u5E02\u573A\u8463\u4E8B\u9EC4\u4FDD\u5168\u7B49\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/uc8B_TI76LRs7YGfk1eEPw\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
