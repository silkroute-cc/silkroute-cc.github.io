{
  "id": "%e8%8b%8f%e4%b8%b9%e6%98%93%e5%8d%9c%e6%8b%89%e6%ac%a3%e9%a9%ac%e6%9d%a5%e7%a0%94%e7%a9%b6%e9%ab%98%e7%ba%a7%e8%ae%bf%e9%97%ae%e5%ad%a6%e8%80%85%e6%95%99%e5%b8%ad%e5%91%bd",
  "slug": "%e8%8b%8f%e4%b8%b9%e6%98%93%e5%8d%9c%e6%8b%89%e6%ac%a3%e9%a9%ac%e6%9d%a5%e7%a0%94%e7%a9%b6%e9%ab%98%e7%ba%a7%e8%ae%bf%e9%97%ae%e5%ad%a6%e8%80%85%e6%95%99%e5%b8%ad%e5%91%bd",
  "canonicalUrlKey": "%e8%8b%8f%e4%b8%b9%e6%98%93%e5%8d%9c%e6%8b%89%e6%ac%a3%e9%a9%ac%e6%9d%a5%e7%a0%94%e7%a9%b6%e9%ab%98%e7%ba%a7%e8%ae%bf%e9%97%ae%e5%ad%a6%e8%80%85%e6%95%99%e5%b8%ad%e5%91%bd",
  "route": "/5223/",
  "title": "\u201C\u82CF\u4E39\u2022\u6613\u535C\u62C9\u6B23\u9A6C\u6765\u7814\u7A76\u9AD8\u7EA7\u8BBF\u95EE\u5B66\u8005\u6559\u5E2D\u201D\u547D\u540D\u4EEA\u5F0F\u5728\u5317\u4EAC\u5916\u56FD\u8BED\u5927\u5B66\u53EC\u5F00",
  "summary": "\u70B9\u51FB\u84DD\u5B57 \u00B7 \u5173\u6CE8\u6211\u4EEC \u201C\u82CF\u4E39\u2022\u6613\u535C\u62C9\u6B23\u9A6C\u6765\u7814\u7A76\u9AD8\u7EA7\u8BBF\u95EE\u5B66\u8005\u6559\u5E2D\u201D\u547D\u540D\u4EEA\u5F0F \u5317\u4EAC\uFF0C2024\u5E749\u670821\u65E5\uFF0C\u9A6C\u6765\u897F\u4E9A\u6700\u9AD8\u5143\u9996\u82CF\u4E39\u00B7\u6613\u535C\u62C9\u6B23\u965B\u4E0B\u6B23\u7136\u540C\u610F\u5C06\u5317\u4EAC\u5916\u56FD\u8BED\u5927\u5B66\u9A6C\u6765\u7814\u7A76\u9AD8\u7EA7\u8BBF\u95EE\u5B66\u8005\u6559\u5E2D\u6B63\u5F0F\u4EE5\u4ED6\u672C\u4EBA\u540D\u5B57\u547D\u540D\u3002 2007\u5E74\uFF0C\u8BE5\u6559\u5E2D\u7531\u9A6C\u6765\u897F\u4E9A\u9AD8\u7B49\u6559\u80B2\u90E8\u4E0E\u4E2D\u56FD\u653F\u5E9C\u5171\u540C\u6210\u7ACB\uFF0C\u6559\u5E2D\u627F\u8BA4\u4E86\u5317\u5916\u5728\u4FC3\u8FDB\u9A6C\u6765\u8BED\u5728\u4E2D\u56FD\u7684\u53D1\u5C55\u6240\u53D1\u6325\u7684\u5173\u952E\u4F5C\u7528\u3002\u65E9\u57281962\u5E74\uFF0C \u5317\u4EAC\u5916\u56FD\u8BED\u5927\u5B66 \u5C31\u5728\u5434\u5B97\u7389\u6559\u6388\u7684\u5E26\u9886\u4E0B\u53D1\u8D77\u4E86\u8FD9\u9879\u5B66\u672F\u4E8B\u4E1A\uFF0C\u6210\u4E3A \u4E2D\u56FD\u7B2C\u4E00 \u6240\u5F00\u8BBE\u9A6C\u6765\u8BED\u8BFE\u7A0B\u7684\u673A\u6784\u3002 \u76EE\u524D\uFF0C\u4E2D\u56FD\u670917\u6240\u9AD8\u7B49\u6559\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/10/frc-5d4e25d0c990882dc810319ae2ecf886.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u70B9\u51FB\u84DD\u5B57 \u0026#183; \u5173\u6CE8\u6211\u4EEC\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u201C\u82CF\u4E39\u2022\u6613\u535C\u62C9\u6B23\u9A6C\u6765\u7814\u7A76\u9AD8\u7EA7\u8BBF\u95EE\u5B66\u8005\u6559\u5E2D\u201D\u547D\u540D\u4EEA\u5F0F\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/10/frc-d4bf4798b92b4e8c368fa2de77ee4aab.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5317\u4EAC\uFF0C2024\u5E749\u670821\u65E5\uFF0C\u9A6C\u6765\u897F\u4E9A\u6700\u9AD8\u5143\u9996\u82CF\u4E39\u0026#183;\u6613\u535C\u62C9\u6B23\u965B\u4E0B\u6B23\u7136\u540C\u610F\u5C06\u5317\u4EAC\u5916\u56FD\u8BED\u5927\u5B66\u9A6C\u6765\u7814\u7A76\u9AD8\u7EA7\u8BBF\u95EE\u5B66\u8005\u6559\u5E2D\u6B63\u5F0F\u4EE5\u4ED6\u672C\u4EBA\u540D\u5B57\u547D\u540D\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/10/frc-5164cabe65a1f561dd350a663f53884a.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E2007\u5E74\uFF0C\u8BE5\u6559\u5E2D\u7531\u9A6C\u6765\u897F\u4E9A\u9AD8\u7B49\u6559\u80B2\u90E8\u4E0E\u4E2D\u56FD\u653F\u5E9C\u5171\u540C\u6210\u7ACB\uFF0C\u6559\u5E2D\u627F\u8BA4\u4E86\u5317\u5916\u5728\u4FC3\u8FDB\u9A6C\u6765\u8BED\u5728\u4E2D\u56FD\u7684\u53D1\u5C55\u6240\u53D1\u6325\u7684\u5173\u952E\u4F5C\u7528\u3002\u65E9\u57281962\u5E74\uFF0C\u5317\u4EAC\u5916\u56FD\u8BED\u5927\u5B66\u5C31\u5728\u5434\u5B97\u7389\u6559\u6388\u7684\u5E26\u9886\u4E0B\u53D1\u8D77\u4E86\u8FD9\u9879\u5B66\u672F\u4E8B\u4E1A\uFF0C\u6210\u4E3A\u4E2D\u56FD\u7B2C\u4E00\u6240\u5F00\u8BBE\u9A6C\u6765\u8BED\u8BFE\u7A0B\u7684\u673A\u6784\u3002\u76EE\u524D\uFF0C\u4E2D\u56FD\u670917\u6240\u9AD8\u7B49\u6559\u80B2\u673A\u6784\u63D0\u4F9B\u9A6C\u6765\u8BED\u8BFE\u7A0B\uFF0C\u8FD9\u8BF4\u660E\u4E2D\u6587\u6BCD\u8BED\u4EBA\u58EB\u5BF9\u9A6C\u6765\u8BED\u6000\u6709\u6301\u7EED\u5174\u8DA3\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/10/frc-cc21375477e215b1be9012d426a7f9a1.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u201C\u82CF\u4E39\u2022\u6613\u535C\u62C9\u6B23\u9A6C\u6765\u7814\u7A76\u9AD8\u7EA7\u8BBF\u95EE\u5B66\u8005\u6559\u5E2D\u201D\u7684\u66F4\u540D\u662F\u4E00\u6B21\u7A81\u663E\u9A6C\u4E2D\u6301\u4E45\u53CB\u8C0A\u7684\u91CD\u8981\u5951\u673A\uFF0C\u5EF6\u7EED\u4E86\u5F7C\u6B64\u53EF\u4EE5\u8FFD\u6EAF\u5230\u9A6C\u516D\u7532\u82CF\u4E39\u738B\u671D\u7684\u8054\u7CFB\u548C\u5171\u6709\u7684\u5386\u53F2\u3002\u81EA1974\u5E745\u670831\u65E5\u5EFA\u4EA4\u4EE5\u6765\uFF0C\u4ECA\u5E74\u6B63\u503C\u4E2D\u9A6C\u5EFA\u4EA4\u4E94\u5341\u5468\u5E74\u3002\n\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u9AD8\u6559\u90E8\u9AD8\u6559\u53F8\u53F8\u957F\u62FF\u7763\u0026#183;\u963F\u5179\u7433\u8FBE\u0026#183;\u963F\u5179\u66FC\u535A\u58EB(Datuk Prof. Dr. Azlinda Azman)\u4EE3\u8868\u9A6C\u6765\u897F\u4E9A\u9AD8\u7B49\u6559\u80B2\u90E8\u957F\u62FF\u7763\u65AF\u91CC\u8D5E\u5E03\u91CC\u535A\u58EB(YB Dato\u0026#39; Seri Diraja Dr. Zambry Abd Kadir)\u51FA\u5E2D\u4E86\u4EEA\u5F0F\uFF0C\u5E76\u5F3A\u8C03\u5317\u4EAC\u5916\u56FD\u8BED\u5927\u5B66\u201C\u82CF\u4E39\u2022\u6613\u535C\u62C9\u6B23\u9A6C\u6765\u7814\u7A76\u9AD8\u7EA7\u8BBF\u95EE\u5B66\u8005\u6559\u5E2D\u201D\u7684\u8BBE\u7ACB\u662F\u5BF9\u9A6C\u6765\u541B\u4E3B\u63A8\u8FDB\u9A6C\u6765\u8BED\u5168\u7403\u5316\u5728\u673A\u5236\u4E0A\u7684\u652F\u6301\u3002\u5979\u8877\u5FC3\u611F\u8C22\u56FD\u738B\u965B\u4E0B\u4EB2\u5207\u5730\u51B3\u5B9A\u5C06\u5176\u540D\u5B57\u501F\u7528\u4E8E\u8FD9\u4E00\u6559\u5E2D\uFF0C\u8FD9\u65E0\u7591\u5C06\u63D0\u9AD8\u6559\u5E2D\u7684\u58F0\u671B\u548C\u5F71\u54CD\u529B\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/10/frc-a0655076782e01eaade7af243b057235.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/10/frc-08b070ff30db7a5004739741bfe8685b.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/10/frc-afe4ee5b1443fc0969fa34a4e9e931e3.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/10/frc-72aac14b885103064fa0cd99f6b61579.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5317\u4EAC\u5916\u56FD\u8BED\u5927\u5B66\u6821\u957F\u8D3E\u6587\u952E\u6559\u6388\u8868\u8FBE\u4E86\u4ED6\u540C\u5317\u5916\u5E08\u751F\u4EEC\u5BF9\u8FD9\u4E00\u65B0\u540D\u79F0\u7684\u6FC0\u52A8\u5FC3\u60C5\uFF0C\u4ED6\u8BA4\u4E3A\uFF0C\u8FD9\u4E00\u547D\u540D\u5C06\u6FC0\u52B1\u5317\u5916\u4EBA\u6301\u7EED\u6269\u5927\u9A6C\u6765\u8BED\u5728\u4E2D\u56FD\u7684\u5F71\u54CD\u529B\u3002\u4E0E\u6B64\u540C\u65F6\uFF0C\u9A6C\u6765\u897F\u4E9A\u9A7B\u534E\u5927\u4F7F\u62FF\u7763\u8BFA\u66FC\u0026#183;\u7A46\u7F55\u9ED8\u5FB7\u9601\u4E0B\uFF08Dato\u0026#39; Norman Muhamad)\u5728\u81F4\u8F9E\u4E2D\u8868\u793A\uFF0C\u6B64\u6559\u5E2D\u7684\u8BBE\u7ACB\uFF0C\u662F\u5BF9\u5317\u4EAC\u5916\u56FD\u8BED\u5927\u5B66\u548C\u5176\u4ED616\u6240\u4E2D\u56FD\u9AD8\u7B49\u6559\u80B2\u673A\u6784\u5728\u4E2D\u56FD\u5404\u5730\u8FDB\u884C\u63D0\u5347\u548C\u63A8\u5E7F\u9A6C\u6765\u8BED\u6240\u4F5C\u5171\u540C\u52AA\u529B\u7684\u81F4\u656C\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/10/frc-608009a4f701d090213c78ad40596a23.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/10/frc-8742b780c33ea97ef819c07c30c72e72.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u4F4D\u4E8E\u5317\u4EAC\u5916\u56FD\u8BED\u5927\u5B66\u7684\u201C\u82CF\u4E39\u2022\u6613\u535C\u62C9\u6B23\u9A6C\u6765\u7814\u7A76\u9AD8\u7EA7\u8BBF\u95EE\u5B66\u8005\u6559\u5E2D\u201D\u662F\u9A6C\u6765\u897F\u4E9A\u9AD8\u7B49\u6559\u80B2\u90E8\u7684\u4E94\u4E2A\u9A6C\u6765\u7814\u7A76\u6559\u5E2D\u4E4B\u4E00\uFF0C\u8BE5\u6559\u5E2D\u4E0E\u5176\u4ED6\u4F4D\u4E8E\u4E16\u754C\u5404\u5730\u7684\u9A6C\u6765\u7814\u7A76\u6559\u5E2D\u534F\u4F5C\u5F00\u5C55\u5B66\u672F\u7814\u7A76\uFF0C\u6559\u5E2D\u6240\u5728\u5927\u5B66\u5305\u62EC\u7F8E\u56FD\u4FC4\u4EA5\u4FC4\u5927\u5B66\uFF081979\u5E74\uFF09\u3001\u8377\u5170\u83B1\u987F\u5927\u5B66\uFF081991\u5E74\uFF09\u3001\u65B0\u897F\u5170\u60E0\u7075\u987F\u7EF4\u591A\u5229\u4E9A\u5927\u5B66\uFF081995\u5E74\uFF09\u548C\u97E9\u56FD\u5916\u56FD\u8BED\u5927\u5B66\uFF082005\u5E74\uFF09\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/10/frc-91c163b61be24e84cb1235fba9bc319e.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u9A7B\u534E\u5927\u4F7F\u9986\u6559\u80B2\u5904\n\u003C/p\u003E\n\u003Cp\u003E\u6700\u53CA\u65F6\u7684\u7559\u5B66\u54A8\u8BE2\u003C/p\u003E\n\u003Cp\u003E\u6700\u70ED\u60C5\u7684\u6587\u5316\u4EA4\u6D41\u003C/p\u003E\n\u003Cp\u003E\u6700\u4EB2\u5207\u7684\u65F6\u523B\u966A\u4F34\u003C/p\u003E\n\u003Cp\u003E\u6B22\u8FCE\u5173\u6CE8\u9A6C\u6765\u897F\u4E9A\u9A7B\u534E\u5927\u4F7F\u9986\u6559\u80B2\u5904\u003C/p\u003E\n\u003Cp\u003E\u4E86\u89E3\u66F4\u591A\u9AD8\u6821\u4FE1\u606F\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u7559\u5B66\u6B22\u8FCE\u60A8\u003C/p\u003E\n\u003Cp\u003E\u5BA1\u6838 | \u9A6C\u6765\u897F\u4E9A\u9A7B\u534E\u5927\u4F7F\u9986\u6559\u80B2\u5904\u003C/p\u003E\n\u003Cp\u003E \u4FE1\u606F\u6765\u6E90 | \u9A6C\u6765\u897F\u4E9A\u9A7B\u534E\u5927\u4F7F\u9986\u6559\u80B2\u5904\u003C/p\u003E\n\u003Cp\u003E NO.1 \u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/10/frc-787b9b5f66c567ef70affad2b5436ee0.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\n\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5FAE\u4FE1\u516C\u4F17\u53F7\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u9A7B\u534E\u5927\u4F7F\u9986\u6559\u80B2\u5904\u003C/p\u003E\n\u003Cp\u003E\u5173\u6CE8\u003Cstrong\u003E\u5FAE\u4FE1\u516C\u4F17\u53F7\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u4E86\u89E3\u66F4\u591A\u9A6C\u6765\u897F\u4E9A\u6559\u80B2\u8D44\u8BAF\u4E0E\u6D3B\u52A8\u003C/p\u003E\n\u003Cp\u003E NO.2 \u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/10/frc-f74c50aab3b0a618ba6f3142341347dc.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5FAE\u535A\u003C/strong\u003E\n\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u9A7B\u534E\u5927\u4F7F\u9986\u6559\u80B2\u5904\u003C/p\u003E\n\u003Cp\u003E\u5173\u6CE8\u003Cstrong\u003E\u5FAE\u535A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u4E86\u89E3\u66F4\u591A\u7559\u5B66\u8D44\u8BAF\uFF0C\u6B22\u8FCE\u60A8\u6765\u4E92\u52A8\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/4VavoIWUPw-QjU3SLTqudA\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
