F\u57CE\u5E02\u653F\u5C40\u7684\u6240\u5728\u5730\uFF0C\u4E5F\u662F\u793E\u4EA4\u548C\u6587\u5316\u6D3B\u52A8\u7684\u573A\u6240\u3002\u5E02\u653F\u5385\u89C1\u8BC1\u4E86\u69DF\u57CE\u5386\u53F2\u4E0A\u8BB8\u591A\u91CD\u8981\u4E8B\u4EF6\uFF0C\u5305\u62EC1957\u5E74\u69DF\u57CE\u72EC\u7ACB\u5BA3\u8A00\u7684\u7B7E\u7F72\u3002\u5982\u4ECA\uFF0C\u5E02\u653F\u5385\u88AB\u7528\u4E8E\u5404\u79CD\u7528\u9014\uFF0C\u5305\u62EC\u5C55\u89C8\u3001\u4F1A\u8BAE\u548C\u5A5A\u793C\u3002\u003C/p\u003E\n\u003Cp\u003E\u540C\u65F6\uFF0C\u5B83\u4E5F\u662F\u4E00\u4E2A\u53D7\u6B22\u8FCE\u7684\u65C5\u6E38\u666F\u70B9\uFF0C\u6E38\u5BA2\u53EF\u4EE5\u53C2\u52A0\u5BFC\u89C8\uFF0C\u4E86\u89E3\u8FD9\u5EA7\u5EFA\u7B51\u7684\u5386\u53F2\u548C\u5EFA\u7B51\u98CE\u683C\u3002\u69DF\u57CE\u5E02\u653F\u5385\u662F\u69DF\u57CE\u5386\u53F2\u9057\u4EA7\u7684\u91CD\u8981\u90E8\u5206\uFF0C\u5BF9\u4E8E\u4EFB\u4F55\u6E38\u5BA2\u6765\u8BF4\uFF0C\u90FD\u662F\u4E00\u4E2A\u5FC5\u770B\u7684\u666F\u70B9\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/01/frc-e0c8a8c217d23938b10998db62d80f6a.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/01/frc-e98cdd22d54f82fed8321e227458fa49.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E1\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5927\u4F2F\u516C\u8857\u798F\u5FB7\u7960\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003ETua Pek Kong Temple\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u5728\u4E54\u6CBB\u5E02\u8001\u57CE\u533A\u7684\u5927\u4F2F\u516C\u8857\uFF0C\u9519\u843D\u6709\u81F4\u7684\u5357\u6D0B\u98CE\u683C\u8857\u5C4B\u4E2D\uFF0C\u6E38\u5BA2\u7684\u773C\u795E\u5F80\u5F80\u4F1A\u88AB\u4E09\u5EA7\u53E4\u8001\u800C\u4F18\u96C5\u7684\u4E2D\u56FD\u534E\u5357\u4F20\u7EDF\u5EFA\u7B51\u6240\u5438\u5F15\uFF1A\u9999\u5C71\u4F1A\u9986\u3001\u798F\u5FB7\u7960\uFF0C\u4EE5\u53CA\u58EE\u4E3D\u7684\u6B66\u5E1D\u5E99\u3001\u5B81\u9633\u4F1A\u9986\u3001\u4F0D\u6C0F\u5BB6\u5E99\u3002\u003C/p\u003E\n\u003Cp\u003E\u8FD9\u6761\u8857\u9053\u5728 1790 \u5E74\u5373\u5F00\u59CB\u5B58\u5728\uFF0C\u662F\u4E54\u6CBB\u5E02\u5F00\u57E0\u89C4\u5212\u5E02\u533A\u65F6\u6700\u65E9\u5174\u5EFA\u7684\u8857\u9053\u4E4B\u4E00\uFF0C\u4ECE\u5B83\u7684\u540D\u5B57\u201CKing Street\u201D\uFF08\u56FD\u738B\u8857\uFF09\u53EF\u4EE5\u770B\u51FA\u5B83\u7684\u5386\u53F2\u60A0\u4E45\uFF0CKing \u8FD9\u4E2A\u540D\u5B57\u6307\u7684\u662F\u82F1\u7687\u4E54\u6CBB\u4E09\u4E16\uFF08King George III\uFF09\u3002\u540E\u6765\uFF0C\u534E\u4EBA\u793E\u533A\u4EB2\u5207\u5730\u79F0\u8FD9\u6761\u5386\u53F2\u60A0\u4E45\u7684\u8857\u9053\u4E3A\u5927\u4F2F\u516C\u8857\uFF0C\u5F97\u540D\u4E8E\u6B63\u4E2D\u95F4\u7684\u798F\u5FB7\u7960\u3002\n\u003C/p\u003E\n\u003Cp\u003E\u798F\u5FB7\u7960\u5728\u69DF\u57CE\u5E7F\u4E1C\u793E\u7FA4\u4E2D\u4F54\u6709\u4E3E\u8DB3\u8F7B\u91CD\u7684\u5730\u4F4D\uFF0C\u5B83\u662F\u4E00\u4E2A\u91CD\u8981\u7684\u4FE1\u4EF0\u4E2D\u5FC3\u3002\u5E99\u5185\u4FDD\u5B58\u7740\u4E24\u5757\u6E05\u671D\u540C\u6CBB\u65F6\u671F\u7684\u7891\u6587\u3002\u8FD9\u4E9B\u5386\u53F2\u7891\u6587\u6210\u4E3A\u65F6\u5149\u7684\u89C1\u8BC1\uFF0C\u8BB0\u5F55\u8457\u8FD9\u5EA7\u5E99\u5B87\u7684\u4E30\u539A\u5386\u53F2\uFF0C\u4E5F\u662F\u6E38\u5BA2\u4EEC\u63A2\u5BFB\u69DF\u57CE\u6587\u5316\u5E95\u8574\u7684\u73CD\u8D35\u673A\u4F1A\u3002\n\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/01/frc-191b0311faaf64d02c62e3405e9c9dc1.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E2\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5C0F\u5370\u5EA6\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003ELittle India\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u4E54\u6CBB\u5E02\u7684\u5C0F\u5370\u5EA6\u662F\u5145\u6EE1\u6D3B\u529B\u548C\u8272\u5F69\u7684\u533A\u57DF\uFF0C\u4E5F\u662F\u8BB8\u591A\u5370\u5EA6\u793E\u533A\u7684\u805A\u96C6\u5730\u3002\u8FD9\u4E2A\u5730\u533A\u62E5\u6709\u4F1