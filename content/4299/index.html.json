{
  "id": "%e9%a6%96%e7%9b%b8%e5%ae%89%e5%8d%8e-%e5%a4%a7%e9%a9%ac%e5%90%8c%e6%84%8f%e9%87%8d%e5%90%af%e9%9a%86%e6%96%b0%e9%ab%98%e9%93%81",
  "slug": "%e9%a6%96%e7%9b%b8%e5%ae%89%e5%8d%8e-%e5%a4%a7%e9%a9%ac%e5%90%8c%e6%84%8f%e9%87%8d%e5%90%af%e9%9a%86%e6%96%b0%e9%ab%98%e9%93%81",
  "canonicalUrlKey": "%e9%a6%96%e7%9b%b8%e5%ae%89%e5%8d%8e-%e5%a4%a7%e9%a9%ac%e5%90%8c%e6%84%8f%e9%87%8d%e5%90%af%e9%9a%86%e6%96%b0%e9%ab%98%e9%93%81",
  "route": "/4299/",
  "title": "\u9996\u76F8\u5B89\u534E:  \u5927\u9A6C\u540C\u610F\u91CD\u542F\u9686\u65B0\u9AD8\u94C1",
  "summary": "\uFF08\u5E03\u57CE23\u65E5\u8BAF\uFF09\u9996\u76F8\u62FF\u7763\u65AF\u91CC\u5B89\u534E\u6307\u51FA\uFF0C\u5927\u9A6C\u539F\u5219\u4E0A\u540C\u610F\u91CD\u542F\u9686\u65B0\u9AD8\u94C1\u8BA1\u5212\u3002 \u4ED6\u8BF4\uFF0C\u76EE\u524D\u9700\u8003\u8651\u7684\u662F\u5F81\u5730\u95EE\u9898\uFF0C\u4EE5\u53CA\u4E0E\u65B0\u52A0\u5761\u65B9\u9762\u63A2\u8BA8\u9AD8\u94C1\u8DEF\u7EBF\u3002 \u5B89\u534E\u4ECA\u65E5\u5728\u201C\u9996\u76F8\u4E0E\u5370\u5237\u5A92\u4F53\u3001\u7535\u5B50\u5A92\u4F53\u548C\u7F51\u5A92\u603B\u7F16\u8F91\u5BF9\u8BDD\u4F1A\u201D\u4E0A\uFF0C\u5982\u6B64\u56DE\u5E94\u9686\u65B0\u9AD8\u94C1\u8BFE\u9898\u3002 \u201C\u652F\u4ED8\u7F5A\u6B3E\u662F\u96BE\u4EE5\u8BA9\u4EBA\u7406\u89E3\u7684\uFF0C\u5F53\u5E74\u5C31\u56E0\u4E3A\u5927\u9A6C\u7684\u8D22\u52A1\u95EE\u9898\uFF0C\u5BFC\u81F4\u9686\u65B0\u9AD8\u94C1\u8BA1\u5212\u88AB\u6401\u7F6E\u4E86\u2026\u2026\u82E5\u6211\u4EEC\uFF08\u5927\u9A6C\uFF09\u7EE7\u7EED\u6267\u884C\uFF0C\u5C31\u4F1A\u964D\u4F4E\u6210\u672C\uFF0C\u79C1\u4EBA\u754C\u4E5F\u4F1A\u53C2\u4E0E\u3002\u201D \u5728\u524D\u9996\u76F8\u62FF\u7763\u65AF\u91CC\u7EB3\u5409\u6267\u653F\u65F6\u671F\uFF0C\u5927\u9A6C\u548C\u65B0\u52A0\u5761\u4E8E2013\u5E742\u6708\u9996\u6B21\u63D0\u51FA\u5408\u4F5C\u5EFA\u8BBE\u9686\u65B0\u9AD8\u94C1\u8BA1\u5212\uFF0C\u4E4B\u540E\u4E8E2016\u5E74\u2026",
  "body": "\u003Cp\u003E\uFF08\u5E03\u57CE23\u65E5\u8BAF\uFF09\u9996\u76F8\u62FF\u7763\u65AF\u91CC\u5B89\u534E\u6307\u51FA\uFF0C\u5927\u9A6C\u539F\u5219\u4E0A\u540C\u610F\u91CD\u542F\u9686\u65B0\u9AD8\u94C1\u8BA1\u5212\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u76EE\u524D\u9700\u8003\u8651\u7684\u662F\u5F81\u5730\u95EE\u9898\uFF0C\u4EE5\u53CA\u4E0E\u65B0\u52A0\u5761\u65B9\u9762\u63A2\u8BA8\u9AD8\u94C1\u8DEF\u7EBF\u3002\u003C/p\u003E\n\u003Cp\u003E\u5B89\u534E\u4ECA\u65E5\u5728\u201C\u9996\u76F8\u4E0E\u5370\u5237\u5A92\u4F53\u3001\u7535\u5B50\u5A92\u4F53\u548C\u7F51\u5A92\u603B\u7F16\u8F91\u5BF9\u8BDD\u4F1A\u201D\u4E0A\uFF0C\u5982\u6B64\u56DE\u5E94\u9686\u65B0\u9AD8\u94C1\u8BFE\u9898\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u652F\u4ED8\u7F5A\u6B3E\u662F\u96BE\u4EE5\u8BA9\u4EBA\u7406\u89E3\u7684\uFF0C\u5F53\u5E74\u5C31\u56E0\u4E3A\u5927\u9A6C\u7684\u8D22\u52A1\u95EE\u9898\uFF0C\u5BFC\u81F4\u9686\u65B0\u9AD8\u94C1\u8BA1\u5212\u88AB\u6401\u7F6E\u4E86\u2026\u2026\u82E5\u6211\u4EEC\uFF08\u5927\u9A6C\uFF09\u7EE7\u7EED\u6267\u884C\uFF0C\u5C31\u4F1A\u964D\u4F4E\u6210\u672C\uFF0C\u79C1\u4EBA\u754C\u4E5F\u4F1A\u53C2\u4E0E\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u5728\u524D\u9996\u76F8\u62FF\u7763\u65AF\u91CC\u7EB3\u5409\u6267\u653F\u65F6\u671F\uFF0C\u5927\u9A6C\u548C\u65B0\u52A0\u5761\u4E8E2013\u5E742\u6708\u9996\u6B21\u63D0\u51FA\u5408\u4F5C\u5EFA\u8BBE\u9686\u65B0\u9AD8\u94C1\u8BA1\u5212\uFF0C\u4E4B\u540E\u4E8E2016\u5E7412\u670813\u65E5\u6B63\u5F0F\u7B7E\u7EA6\u3002\u003C/p\u003E\n\u003Cp\u003E\u5F53\u65F6\u7531\u8D22\u653F\u90E8\u72EC\u8D44\u62E5\u6709\u7684\u9A6C\u6765\u897F\u4E9A\u9AD8\u94C1\u673A\u6784\uFF08MyHSR Corp\uFF09\u5168\u6743\u8D1F\u8D23\u9AD8\u94C1\u5DE5\u7A0B\u3002\u4E00\u65E6\u8BA1\u5212\u5982\u671F\u57282026\u5E7412\u6708\u676A\u5B8C\u5DE5\uFF0C\u9686\u65B0\u9AD8\u94C1\u53EA\u970090\u5206\u949F\uFF0C\u5C31\u80FD\u4ECE\u5409\u9686\u5761\u62B5\u8FBE\u65B0\u52A0\u5761\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E0D\u8FC7\uFF0C\u8FD9\u8BA1\u5212\u4E8E2018\u5E749\u6708\u906D\u65F6\u4EFB\u5E0C\u76DF\u653F\u5E9C\u558A\u505C\u3002\u9A6C\u65B0\u4E24\u56FD\u57282020\u5E745\u670831\u65E5\u540C\u610F\u6B64\u8BA1\u5212\u6682\u7F13\u81F312\u670831\u65E5\u3002\u003C/p\u003E\n\u003Cp\u003E\u5230\u4E862021\u5E741\u67081\u65E5\uFF0C\u65F6\u4EFB\u9996\u76F8\u4E39\u65AF\u91CC\u6155\u5C24\u4E01\u4E0E\u65B0\u52A0\u5761\u603B\u7406\u674E\u663E\u9F99\u53D1\u8868\u8054\u5408\u58F0\u660E\uFF0C\u6307\u7531\u4E8E\u4E24\u56FD\u8FDB\u884C\u6570\u6B21\u8BA8\u8BBA\u4ECD\u65E0\u6CD5\u8FBE\u6210\u534F\u8BAE\uFF0C\u56E0\u6B64\u9686\u65B0\u9AD8\u94C1\u8BA1\u5212\u534F\u8BAE\u5DF2\u4E8E2020\u5E7412\u670831\u65E5\u5931\u6548\u3002\u003C/p\u003E\n\u003Cp\u003E\u5927\u9A6C\u987B\u652F\u4ED81\u4EBF280\u4E07\u65B0\u5E01\uFF08\u7EA63\u4EBF2000\u4E07\u4EE4\u5409\uFF09\u7684\u8D54\u507F\u91D1\u7ED9\u65B0\u52A0\u5761\u3002\u003C/p\u003E\n\u003Cp\u003E\u5728\u4ECA\u5E747\u6708\uFF0C\u5927\u9A6C\u9AD8\u94C1\u673A\u6784\u79C1\u4EBA\u6709\u9650\u516C\u53F8\u4E3B\u5E2D\u62FF\u7763\u65AF\u91CC\u5F17\u5179\u963F\u90FD\u62C9\u66FC\u5219\u6307\u653F\u5E9C\u5DF2\u51B3\u5B9A\uFF0C\u5927\u9A6C\u53CA\u65B0\u52A0\u5761\u5C06\u91CD\u632F\u8FD9\u8BA1\u5212\uFF0C\u7136\u800C\u5C06\u4EA4\u7531\u79C1\u4EBA\u9886\u57DF\u5168\u9762\u63A8\u8FDB\uFF0C\u653F\u5E9C\u4E0D\u4F1A\u627F\u62C5\u4EFB\u4F55\u6210\u672C\u3002\u003C/p\u003E\n\u003Cp\u003E\u5B89\u534E\u57288\u6708\u65F6\u8868\u660E\uFF0C\u9686\u65B0\u9AD8\u94C1\u8BA1\u5212\u7684\u91CD\u542F\u8FD8\u5728\u6211\u65B9\u9636\u6BB5\uFF0C\u4E00\u65E6\u6709\u4E86\u521D\u6B65\u7ED3\u8BBA\uFF0C\u5C31\u4F1A\u5411\u65B0\u52A0\u5761\u63D0\u5448\u65B0\u63D0\u6848\u3002\u003C/p\u003E\n\u003Cp\u003E\u76EE\u524D\u7531\u5927\u9A6C\u9AD8\u94C1\u673A\u6784\u53D1\u51FA\u7684\u9686\u65B0\u9AD8\u94C1\u4FE1\u606F\u5F81\u8BE2\u4E66\uFF08RFI\uFF09\u5C06\u4E8E\u660E\u5E741\u670815\u65E5\u622A\u6B62\u65E5\u671F\u540E\uFF0C\u6B63\u5F0F\u8FDB\u5165\u5F81\u6C42\u5EFA\u8BAE\u4E66\uFF08RFP\uFF09\u6D41\u7A0B\uFF0C\u518D\u7531\u653F\u5E9C\u6572\u5B9A\u843D\u5B9E\u9879\u76EE\u7684\u516C\u53F8\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/vAW2njSrmAgTYM2pPlEC1A\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
