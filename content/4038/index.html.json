{
  "id": "%e6%8f%ad%e5%bc%80%e7%a0%82%e6%8b%89%e8%b6%8a%e7%9a%84%e6%81%ac%e9%9d%99%e4%b9%8b%e7%be%8e",
  "slug": "%e6%8f%ad%e5%bc%80%e7%a0%82%e6%8b%89%e8%b6%8a%e7%9a%84%e6%81%ac%e9%9d%99%e4%b9%8b%e7%be%8e",
  "canonicalUrlKey": "%e6%8f%ad%e5%bc%80%e7%a0%82%e6%8b%89%e8%b6%8a%e7%9a%84%e6%81%ac%e9%9d%99%e4%b9%8b%e7%be%8e",
  "route": "/4038/",
  "title": "\u63ED\u5F00\u7802\u62C9\u8D8A\u7684\u606C\u9759\u4E4B\u7F8E",
  "summary": "\u7802\u62C9\u8D8A \u2219 \u65E0\u5C3D\u7684\u63A2\u7D22 \u95ED\u4E0A\u53CC\u773C\uFF0C\u60F3\u8C61\u6B64\u523B\u7684\u60A8\u7F6E\u8EAB\u4E8E\u666F\u81F4\u65D6\u65CE\u7684\u5B81\u9759\u5EA6\u5047\u80DC\u5730\uFF0C\u90A3\u91CC\u9633\u5149\u660E\u5A9A\u3001\u6D77\u6C34\u6E05\u6F88\u89C1\u5E95\u3002\u6B22\u8FCE\u6765\u5230\u7802\u62C9\u8D8A\uFF0C\u60A8\u53EF\u5728\u8FD9\u7247\u9A6C\u6765\u897F\u4E9A\u7684\u907F\u4E16\u79D8\u5883\u5C55\u5F00\u4E00\u6BB5\u653E\u677E\u8EAB\u5FC3\u3001\u5145\u6EE1\u60CA\u9669\u523A\u6FC0\u53CA\u5BFB\u5E7D\u63A2\u79D8\u7684\u65C5\u7A0B\uFF0C\u8FD8\u6709\u65E0\u4E0E\u4F26\u6BD4\u7684\u6D77\u57DF\u98CE\u5149\u4E0E\u9B45\u529B\u7B49\u60A8\u4E00\u4E00\u6765\u63ED\u79D8\u3002 \u63A2\u7D22\u4E30\u5BCC\u591A\u5143\u7684\u6D77\u57DF\u98CE\u5149 \u7802\u62C9\u8D8A\u5982\u68A6\u4F3C\u5E7B\u7684\u5C9B\u5C7F\u6709\u7740\u672A\u7ECF\u96D5\u7422\u7684\u81EA\u7136\u7F8E\u666F\u3002\u6C99\u5F53\u5C9B (Pulau Satang) \u548C\u5C71\u5DF4\u8FEA\u5C9B (Pulau Sampadi) \u5C31\u662F\u5360\u6709\u5F97\u5929\u72EC\u539A\u4F18\u52BF\u7684\u7EDD\u4F73\u4F8B\u8BC1\uFF0C\u5176\u8FF7\u4EBA\u7684\u539F\u59CB\u6C99\u6EE9\u3001\u7EFF\u610F\u76CE\u7136\u7684\u666F\u2026",
  "body": "\u003Cp\u003E\u003Cstrong\u003E\u7802\u62C9\u8D8A \u2219 \u65E0\u5C3D\u7684\u63A2\u7D22\u003C/strong\u003E\n\u003C/p\u003E\n\u003Cp\u003E\u95ED\u4E0A\u53CC\u773C\uFF0C\u60F3\u8C61\u6B64\u523B\u7684\u60A8\u7F6E\u8EAB\u4E8E\u666F\u81F4\u65D6\u65CE\u7684\u5B81\u9759\u5EA6\u5047\u80DC\u5730\uFF0C\u90A3\u91CC\u9633\u5149\u660E\u5A9A\u3001\u6D77\u6C34\u6E05\u6F88\u89C1\u5E95\u3002\u6B22\u8FCE\u6765\u5230\u7802\u62C9\u8D8A\uFF0C\u60A8\u53EF\u5728\u8FD9\u7247\u9A6C\u6765\u897F\u4E9A\u7684\u907F\u4E16\u79D8\u5883\u5C55\u5F00\u4E00\u6BB5\u653E\u677E\u8EAB\u5FC3\u3001\u5145\u6EE1\u60CA\u9669\u523A\u6FC0\u53CA\u5BFB\u5E7D\u63A2\u79D8\u7684\u65C5\u7A0B\uFF0C\u8FD8\u6709\u65E0\u4E0E\u4F26\u6BD4\u7684\u6D77\u57DF\u98CE\u5149\u4E0E\u9B45\u529B\u7B49\u60A8\u4E00\u4E00\u6765\u63ED\u79D8\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u63A2\u7D22\u4E30\u5BCC\u591A\u5143\u7684\u6D77\u57DF\u98CE\u5149\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u7802\u62C9\u8D8A\u5982\u68A6\u4F3C\u5E7B\u7684\u5C9B\u5C7F\u6709\u7740\u672A\u7ECF\u96D5\u7422\u7684\u81EA\u7136\u7F8E\u666F\u3002\u6C99\u5F53\u5C9B (Pulau Satang)\u548C\u5C71\u5DF4\u8FEA\u5C9B (Pulau Sampadi)\u5C31\u662F\u5360\u6709\u5F97\u5929\u72EC\u539A\u4F18\u52BF\u7684\u7EDD\u4F73\u4F8B\u8BC1\uFF0C\u5176\u8FF7\u4EBA\u7684\u539F\u59CB\u6C99\u6EE9\u3001\u7EFF\u610F\u76CE\u7136\u7684\u666F\u89C2\u53CA\u8FDC\u79BB\u55A7\u56A3\u7684\u4E45\u8FDD\u606C\u9759\u8BA9\u4EBA\u500D\u611F\u5FC3\u65F7\u795E\u6021\u3002\u7136\u800C\uFF0C\u7802\u62C9\u8D8A\u771F\u6B63\u7684\u72EC\u5230\u4E4B\u5904\u5728\u4E8E\u6E38\u5BA2\u6216\u6709\u673A\u4F1A\u53EF\u5728\u6BD7\u90BB\u9996\u90FD\u53E4\u664B\u7684\u5C71\u90FD\u671B (Santubong)\u6355\u6349\u5230\u7A00\u6709\u77ED\u543B\u6D77\u8C5A\u7684\u8E2A\u8FF9\u3002\u4F17\u591A\u751F\u7269\u9009\u62E9\u6816\u5C45\u4E8E\u6B64\u8DB3\u4EE5\u8BC1\u660E\u8FD9\u7247\u571F\u5730\u7684\u751F\u7269\u591A\u6837\u6027\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/09/frc-3b695af0affdde9f521cbc29026fa763.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003EIrrawady Dolphins, Santubong, Kuching \u56FE\u7247\u6765\u6E90: Sarawak Forestry\u003C/p\u003E\n\u003Cp\u003E\u5018\u82E5\u60A8\u662F\u6D77\u6EE9\u7231\u597D\u8005\uFF0C\u7802\u62C9\u8D8A\u7EDD\u5BF9\u8BA9\u60A8\u4E00\u89C1\u503E\u5FC3\u3002\u6765\u5230\u4E09\u9A6C\u4E39 (Sematan)\u3001\u8FBE\u8FC8(Damai)\u3001\u4E39\u7ED2\u5DF4\u90FD (Tanjung Batu)\u3001\u897F\u7C73\u62C9\u9065 (Similajau)\u53CA\u4E39\u7ED2\u62FF\u7763 (Tanjung Datu)\uFF0C\u6620\u5165\u773C\u5E18\u7684\u662F\u7EF5\u5EF6\u4E0D\u65AD\u7684\u6D77\u5CB8\u7EBF\uFF0C\u7EC6\u81F4\u67D4\u8F6F\u7684\u6C99\u6EE9\u4E0E\u6E5B\u84DD\u6E05\u6F88\u7684\u6D77\u6C34\u76F8\u4E92\u8F89\u6620\uFF0C\u7F8E\u4E0D\u80DC\u6536\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/09/frc-9dc310ba3a480411ee14069a010e99a4.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003EPulau Satang National Park \u56FE\u7247\u6765\u6E90: Sarawak Tourism Board\u003C/p\u003E\n\u003Cp\u003E\u8FD9\u91CC\u7F24\u7EB7\u591A\u5F69\u7684\u6D77\u5E95\u4E16\u754C\u4E5F\u662F\u6F5C\u6C34\u72C2\u70ED\u5206\u5B50\u4E0D\u53EF\u9519\u8FC7\u7684\u7EDD\u7F8E\u4E4B\u5730\u3002\u7802\u62C9\u8D8A\u8457\u540D\u7684\u6C89\u8239\u6F5C\u6C34\u5730\u70B9\u5305\u62ECKatori Maru\u3001Hiyoshi Maru\u53CASagiri\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/09/frc-ecb0f85b54b5cf8ccca95c81e29f72fd.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u6C89\u8239\u6F5C\u6C34\uFF0C\u5C71\u90FD\u671B\uFF0C\u53E4\u664B \u56FE\u7247\u6765\u6E90: Ernest Teo \u0026amp; Sarawak Tourism Board\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u6DF1\u5165\u6587\u5316\u63A2\u7D22\u5E76\u54C1\u5C1D\u820C\u5C16\u4E0A\u7684\u7F8E\u5473\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u9664\u4E86\u58EE\u4E3D\u7684\u81EA\u7136\u7F8E\u666F\u5916\uFF0C\u7802\u62C9\u8D8A\u7684\u591A\u5143\u6587\u5316\u4EA4\u878D\u4E5F\u80FD\u8BA9\u65C5\u9014\u589E\u8272\u4E0D\u5C11\u3002\u4E0E\u70ED\u60C5\u597D\u5BA2\u7684\u5F53\u5730\u5C45\u6C11\u6253\u4EA4\u9053\u4EE5\u501F\u6B64\u6DF1\u5165\u4E86\u89E3\u4ED6\u4EEC\u7684\u4F20\u7EDF\u6587\u5316\u3002\u8D70\u8BBF\u5F53\u5730\u5E02\u573A\u65F6\u4E5F\u53EF\u8D81\u673A\u54C1\u5C1D\u5404\u7C7B\u7279\u8272\u7684\u4F20\u7EDF\u5730\u9053\u7F8E\u98DF\u3002\u82E5\u60A8\u52C7\u4E8E\u5C1D\u8BD5\uFF0C\u4E0D\u59A8\u6765\u4E00\u7897\u8457\u540D\u7684\u7802\u62C9\u8D8A\u53FB\u6C99 (Sarawak Laksa)\u3002\u91C7\u7528\u5404\u79CD\u9999\u6599\u71AC\u716E\u7684\u7075\u9B42\u6C64\u5934\u5473\u9999\u56DB\u6EA2\uFF0C\u76F4\u51FB\u5473\u857E\uFF0C\u7EDD\u5BF9\u8BA9\u60A8\u4E00\u8BD5\u96BE\u5FD8\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5168\u65B9\u4F4D\u7684\u8EAB\u5FC3\u7597\u6108\u4F53\u9A8C\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u60F3\u8C61\u4E00\u4E0B\u5728\u5962\u534E\u60EC\u610F\u7684\u6D77\u6EE8\u5EA6\u5047\u6751\u9192\u6765\uFF0C\u73AF\u7ED5\u56DB\u5468\u7684\u5C3D\u662F\u90C1\u90C1\u8471\u8471\u7684\u70ED\u5E26\u96E8\u6797\uFF0C\u800C\u8033\u8FB9\u8FD8\u4F20\u6765\u60A6\u8033\u7684\u6D77\u6D6A\u58F0\u3002\u6765\u5230\u8FD9\u91CC\uFF0C\u60A8\u53EF\u6682\u4E14\u5378\u4E0B\u75B2\u60EB\uFF0C\u8BA9\u8EAB\u5FC3\u5F52\u96F6\uFF0C\u4EE5\u6D77\u8FB9\u745C\u4F3D\u5F00\u542F\u7F8E\u597D\u4E00\u5929\u5E76\u4EE5\u8F7B\u677E\u7684\u6C34\u7597\u62A4\u7406\u91CD\u7115\u8EAB\u5FC3\u6D3B\u529B\u3002\u6240\u63A8\u8350\u7684\u4F4F\u5BBF\u9009\u9879\u5305\u62EC\u8FBE\u8FC8\u6D77\u6EE9\u5EA6\u5047\u6751 (Damai Beach Resort)\u3001\u67CF\u8FC8\u96E8\u6797\u5EA6\u5047\u6751 (Permai Rainforest Resort)\u3001Tim\u2019s Seaside Hideout\u3001\u6751\u5C4B\u9152\u5E97 (The Village House)\u3001\u7F57\u514B\u897F\u4E09\u9A6C\u4E39\u522B\u5885 (Roxy Sematan Villa)\u53CAThe Culvert\u9152\u5E97\u5EA6\u5047\u6751\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/09/frc-a12d41b13f017ccf4bf2386c70818213.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/09/frc-6de978211510ec15d927bec524e772c5.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u56FE\u7247\u6765\u6E90: Damai Beach Resort \u0026amp; Booking.com\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u4EE4\u4EBA\u53F9\u4E3A\u89C2\u6B62\u7684\u65E5\u843D\u4E0E\u81EA\u7136\u5947\u89C2\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u5915\u9633\u897F\u4E0B\uFF0C\u843D\u65E5\u4F59\u8F89\u6655\u67D3\u6574\u7247\u5929\u7A7A\uFF0C\u552F\u7F8E\u666F\u81F4\u65E0\u4E0D\u4EE4\u4EBA\u53F9\u4E3A\u89C2\u6B62\u3002\u8BB0\u5F97\u4E5F\u628A\u897F\u7C73\u62C9\u9065\u56FD\u5BB6\u516C\u56ED (Similajau National Park)\u548C\u4E39\u7ED2\u62FF\u7763\u56FD\u5BB6\u516C\u56ED (Tanjung Datu National Park)\u7EB3\u5165\u60A8\u7684\u884C\u7A0B\u4E4B\u4E2D\uFF0C\u4E0E\u5947\u5CA9\u5F02\u77F3\u548C\u5404\u79CD\u91CE\u751F\u52A8\u7269\u6765\u573A\u7F8E\u4E3D\u9082\u9005\u3002\u7802\u62C9\u8D8A\u6E05\u6F88\u65E0\u57A0\u7684\u591C\u7A7A\u4EA6\u662F\u89C2\u661F\u540C\u597D\u7EDD\u4F73\u7684\u89C2\u661F\u80DC\u5730\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/09/frc-4924414a81f8c10b8681160a80f754cd.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u4E39\u7ED2\u62FF\u7763\u56FD\u5BB6\u516C \u56ED\u56FE\u7247\u6765\u6E90: Micheal Tsan \u0026amp; Sarawak Forestry\u003C/p\u003E\n\u003Cp\u003E\u003Cem\u003E\u003Cstrong\u003E\u6536\u62FE\u60A8\u7684\u884C\u56CA\uFF0C\u6765\u4E00\u573A\u7802\u62C9\u8D8A\u63A2\u5BFB\u4E4B\u884C\u003C/strong\u003E\u003C/em\u003E\u003C/p\u003E\n\u003Cp\u003E\u73B0\u5728\uFF0C\u662F\u65F6\u5019\u8F6E\u5230\u60A8\u8E0F\u4E0A\u8FD9\u573A\u5947\u5999\u7684\u6D77\u5C9B\u4E4B\u65C5\u3002\u524D\u5F80\u7802\u62C9\u8D8A\u65C5\u6E38\u7684\u9009\u62E9\u4F17\u591A\uFF0C\u4E14\u8BA9\u5B81\u9759\u9B54\u5E7B\u7684\u6D77\u5C9B\u98CE\u60C5\u548C\u591A\u59FF\u591A\u5F69\u7684\u4F20\u7EDF\u6587\u5316\u4E3A\u60A8\u6D17\u6DA4\u5FC3\u7075\u3002\u522B\u5FD8\u4E86\u4E0E\u60A8\u7684\u540C\u597D\u53CB\u4EBA\u5206\u4EAB\u6B64\u6587\u7AE0\u5E76\u76F8\u7EA6\u524D\u6765\u7802\u62C9\u8D8A\uFF0C\u4E00\u8D77\u63A2\u7D22\u65E0\u5C3D\u7684\u6D77\u57DF\u9B45\u529B\u3002\n\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/09/frc-2183dca80538d0b6c1e956fba95bbb6f.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u66F4\u591A\u8D44\u8BAF\uFF1A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u56FD\u5BB6\u65C5\u6E38\u5C40\u5B98\u65B9\u7F51\u7AD9\uFF1A\u003C/p\u003E\n\u003Cp\u003Ewww.malaysia.travel\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u56FD\u5BB6\u65C5\u6E38\u5C40\u5B98\u65B9\u5FAE\u535A\uFF1A\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38\u5C40\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u56FD\u5BB6\u65C5\u6E38\u5C40\u5B98\u65B9\u5FAE\u4FE1\u516C\u4F17\u53F7\uFF1A\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38\u5C40\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/WHc-syGfrG_j-zZW0VSOjw\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
