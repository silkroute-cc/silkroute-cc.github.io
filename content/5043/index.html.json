{
  "id": "%e5%bc%a0%e5%ba%86%e4%bf%a1%e4%b8%ad%e5%9b%bd%e5%b8%82%e5%9c%ba%e7%a7%af%e6%9e%81-%e5%88%b0%e4%ba%8c%e4%b8%89%e7%ba%bf%e5%9f%8e%e5%b8%82%e6%8b%93%e5%b1%95%e5%a4%a7%e9%a9%ac%e6%97%85%e6%b8%b8",
  "slug": "%e5%bc%a0%e5%ba%86%e4%bf%a1%e4%b8%ad%e5%9b%bd%e5%b8%82%e5%9c%ba%e7%a7%af%e6%9e%81-%e5%88%b0%e4%ba%8c%e4%b8%89%e7%ba%bf%e5%9f%8e%e5%b8%82%e6%8b%93%e5%b1%95%e5%a4%a7%e9%a9%ac%e6%97%85%e6%b8%b8",
  "canonicalUrlKey": "%e5%bc%a0%e5%ba%86%e4%bf%a1%e4%b8%ad%e5%9b%bd%e5%b8%82%e5%9c%ba%e7%a7%af%e6%9e%81-%e5%88%b0%e4%ba%8c%e4%b8%89%e7%ba%bf%e5%9f%8e%e5%b8%82%e6%8b%93%e5%b1%95%e5%a4%a7%e9%a9%ac%e6%97%85%e6%b8%b8",
  "route": "/5043/",
  "title": "\u5F20\u5E86\u4FE1:\u4E2D\u56FD\u5E02\u573A\u79EF\u6781 \u5230\u4E8C\u4E09\u7EBF\u57CE\u5E02\u62D3\u5C55\u5927\u9A6C\u65C5\u6E38",
  "summary": "\u5F20\u5E86\u4FE1 \u9A6C\u65B0\u793E \uFF08\u5409\u9686\u576111\u65E5\u8BAF\uFF09\u65C5\u6E38\u3001\u827A\u672F\u548C\u6587\u5316\u90E8\u957F\u62FF\u7763\u65AF\u91CC\u5F20\u5E86\u4FE1\u8868\u793A\uFF0C\u4E2D\u56FD\u5E02\u573A\u5BF9\u9A6C\u6765\u897F\u4E9A\u7684\u4FC3\u9500\u4E3E\u63AA\u53CD\u5E94\u975E\u5E38\u79EF\u6781\uFF0C\u4E0D\u4EC5\u5728\u4E3B\u8981\u57CE\u5E02\u8FDB\u884C\u63A8\u5E7F\uFF0C\u8FD8\u5411\u4E8C\u4E09\u7EBF\u57CE\u5E02\u62D3\u5C55\u3002 \u201C\u7136\u800C\uFF0C\u7F3A\u4E4F\u76F4\u98DE\u822A\u73ED\u7B49\u8FDE\u63A5\u95EE\u9898\u6784\u6210\u4E86\u6311\u6218\u3002\u6211\u4EEC\u6B63\u5728\u52AA\u529B\u5EFA\u7ACB\u4ECE\u8FD9\u4E9B\u4E8C\u7EBF\u57CE\u5E02\u98DE\u5F80\u9A6C\u6765\u897F\u4E9A\u7684\u76F4\u98DE\u6216\u5305\u673A\u822A\u73ED\u3002\u201D \u4E2D\u56FD\u4E8C\u4E09\u7EBF\u57CE\u5E02 \u5F20\u5E86\u4FE1\u63A5\u53D7\u300A\u661F\u62A5\u300B\u8BBF\u95EE\u65F6\u8BF4\uFF0C\u5728\u6269\u5F20\u4E4B\u524D\uFF0C\u4E13\u6CE8\u4E8E\u4E00\u4E2A\u5E02\u573A\u4EE5\u53D6\u5F97\u5207\u5B9E\u6210\u679C\u975E\u5E38\u91CD\u8981\u3002 \u201C\u5BF9\u4E8E\u4E2D\u56FD\u6765\u8BF4\uFF0C\u6211\u4EEC\u4E0D\u65AD\u53BB\u4E0D\u540C\u7684\u5730\u65B9\uFF0C\u751A\u81F3\u662F\u4E8C\u4E09\u7EBF\u57CE\u5E02\u3002\u5728\u90A3\u91CC\u62E5\u6709\u7A33\u5B9A\u7684\u5B58\u5728\u975E\u5E38\u91CD\u8981\u3002\u4E00\u65E6\u7A33\u5B9A\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/08/frc-1969ac127910cb11dbff683900776583.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5F20\u5E86\u4FE1\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u65B0\u793E\u003C/p\u003E\n\u003Cp\u003E\uFF08\u5409\u9686\u576111\u65E5\u8BAF\uFF09\u65C5\u6E38\u3001\u827A\u672F\u548C\u6587\u5316\u90E8\u957F\u62FF\u7763\u65AF\u91CC\u5F20\u5E86\u4FE1\u8868\u793A\uFF0C\u4E2D\u56FD\u5E02\u573A\u5BF9\u9A6C\u6765\u897F\u4E9A\u7684\u4FC3\u9500\u4E3E\u63AA\u53CD\u5E94\u975E\u5E38\u79EF\u6781\uFF0C\u4E0D\u4EC5\u5728\u4E3B\u8981\u57CE\u5E02\u8FDB\u884C\u63A8\u5E7F\uFF0C\u8FD8\u5411\u4E8C\u4E09\u7EBF\u57CE\u5E02\u62D3\u5C55\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u7136\u800C\uFF0C\u7F3A\u4E4F\u76F4\u98DE\u822A\u73ED\u7B49\u8FDE\u63A5\u95EE\u9898\u6784\u6210\u4E86\u6311\u6218\u3002\u6211\u4EEC\u6B63\u5728\u52AA\u529B\u5EFA\u7ACB\u4ECE\u8FD9\u4E9B\u4E8C\u7EBF\u57CE\u5E02\u98DE\u5F80\u9A6C\u6765\u897F\u4E9A\u7684\u76F4\u98DE\u6216\u5305\u673A\u822A\u73ED\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u4E2D\u56FD\u4E8C\u4E09\u7EBF\u57CE\u5E02\u003C/strong\u003E\n\n\u5F20\u5E86\u4FE1\u63A5\u53D7\u300A\u661F\u62A5\u300B\u8BBF\u95EE\u65F6\u8BF4\uFF0C\u5728\u6269\u5F20\u4E4B\u524D\uFF0C\u4E13\u6CE8\u4E8E\u4E00\u4E2A\u5E02\u573A\u4EE5\u53D6\u5F97\u5207\u5B9E\u6210\u679C\u975E\u5E38\u91CD\u8981\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u5BF9\u4E8E\u4E2D\u56FD\u6765\u8BF4\uFF0C\u6211\u4EEC\u4E0D\u65AD\u53BB\u4E0D\u540C\u7684\u5730\u65B9\uFF0C\u751A\u81F3\u662F\u4E8C\u4E09\u7EBF\u57CE\u5E02\u3002\u5728\u90A3\u91CC\u62E5\u6709\u7A33\u5B9A\u7684\u5B58\u5728\u975E\u5E38\u91CD\u8981\u3002\u4E00\u65E6\u7A33\u5B9A\uFF0C\u6211\u4EEC\u5C06\u7EE7\u7EED\u5411\u5176\u4ED6\u56FD\u5BB6\u6269\u5F20\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u6839\u636E\u7ECF\u6D4E\u8FDB\u6B65\u3001\u57FA\u7840\u8BBE\u65BD\u3001\u4FBF\u5229\u8BBE\u65BD\u548C\u4EBA\u53E3\u89C4\u6A21\uFF0C\u4E2D\u56FD\u57CE\u5E02\u5206\u4E3A\u56DB\u7EA7\uFF0C\u7B2C\u4E00\u7EA7\u4F4D\u4E8E\u6700\u4E0A\u9762\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E2D\u56FD\u4E0E\u9A6C\u6765\u897F\u4E9A\u4E5F\u4EAB\u6709\u514D\u7B7E\u8BC1\u5F85\u9047\uFF0C\u4E00\u76F4\u662F\u8BE5\u90E8\u7684\u91CD\u70B9\u8425\u9500\u533A\u57DF\u3002\u4E00\u5E74\u6765\uFF0C\u5176\u5927\u529B\u5438\u5F15\u4E2D\u56FD\u6E38\u5BA2\u7684\u884C\u52A8\u53D6\u5F97\u4E86\u663E\u8457\u6210\u6548\u3002\u73B0\u5728\uFF0C\u8BE5\u90E8\u5E0C\u671B\u5C06\u5176\u63A8\u5E7F\u5DE5\u4F5C\u6269\u5927\u5230\u5176\u4ED6\u56FD\u5BB6\u3002\u003C/p\u003E\n\u003Cp\u003E\u5F20\u5E86\u4FE1\u8868\u793A\uFF0C1\u6708\u81F35\u6708\uFF0C\u9A6C\u6765\u897F\u4E9A\u6765\u81EA\u4E2D\u56FD\u7684\u6E38\u5BA2\u6570\u91CF\u6BD42023\u5E74\u540C\u671F\u589E\u957F\u4E86190.4%\uFF0C\u8FBE\u5230118\u4E075050\u4EBA\u6B21\u3002\u622A\u81F3\u4E0A\u4E2A\u6708\uFF0C\u9A6C\u6765\u897F\u4E9A\u5DF2\u65B0\u589E41\u6761\u6765\u81EA\u4E2D\u56FD\u4E00\u4E8C\u7EBF\u57CE\u5E02\u7684\u822A\u7EBF\u548C\u5305\u673A\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/08/frc-44632eed46335241b48cae8e5f95d2bd.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u7F8E\u8054\u793E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u822A\u7A7A\u516C\u53F8\u003C/strong\u003E\n\n\u4ED6\u8BF4\uFF0C\u4E9A\u6D32\u822A\u7A7A\u3001\u5CC7\u8FEA\u822A\u7A7A\u3001\u98DE\u8424\u822A\u7A7A\u548C\u9A6C\u822A\u7B49\u822A\u7A7A\u516C\u53F8\uFF0C\u4EE5\u53CA\u4E2D\u56FD\u4E1C\u65B9\u822A\u7A7A\u3001\u4E2D\u56FD\u5357\u65B9\u822A\u7A7A\u3001\u4E0A\u6D77\u822A\u7A7A\u548C\u53A6\u95E8\u822A\u7A7A\u7B49\u5916\u56FD\u822A\u7A7A\u516C\u53F8\uFF0C\u52A0\u5F3A\u4E86\u4E0E\u5409\u9686\u5761\u3001\u69DF\u57CE\u3001\u4E9A\u5E87\u548C\u6597\u6E56\u7B49\u9A6C\u6765\u897F\u4E9A\u591A\u4E2A\u57CE\u5E02\u7684\u4E92\u8054\u4E92\u901A\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u65C5\u6E38\u90E8\u6709\u4FE1\u5FC3\u5B9E\u73B02024\u5E74\u4E2D\u56FD\u6E38\u5BA2500\u4E07\u4EBA\u6B21\u7684\u76EE\u6807\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6307\u51FA\uFF0C2023\u5E74\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38\u5C40\u8C03\u67E5\u663E\u793A\uFF0C47.3%\u7684\u4E2D\u56FD\u6E38\u5BA2\u66F4\u559C\u6B22\u6C99\u5DF4\u7684\u6D77\u6EE9\u548C\u897F\u5DF4\u4E39\u5C9B\u7B49\u4E16\u754C\u7EA7\u6F5C\u6C34\u80DC\u5730\u3002\u5409\u9686\u5761\u7D27\u968F\u5176\u540E\uFF0C\u5360 33%\u3002\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u548C\u4E2D\u56FD\u4ECA\u5E74\u6B63\u5728\u5E86\u795D\u5EFA\u4EA450\u5468\u5E74\uFF0C\u5728\u4E2D\u56FD\u603B\u7406\u674E\u5F3A6\u6708\u4EFD\u4E3A\u671F\u4E09\u5929\u7684\u6B63\u5F0F\u8BBF\u95EE\u671F\u95F4\uFF0C\u4E24\u56FD\u5747\u8868\u793A\uFF0C\u4E2D\u56FD\u540C\u610F\u5C06\u9A6C\u6765\u897F\u4E9A\u516C\u6C11\u7684\u514D\u7B7E\u8BC1\u5F85\u9047\u5EF6\u957F\u81F32025\u5E74\u5E95\uFF0C\u9A6C\u6765\u897F\u4E9A\u4E5F\u5C06\u540C\u610F\u5C06\u4E2D\u56FD\u516C\u6C11\u7684\u514D\u7B7E\u8BC1\u5F85\u9047\u5EF6\u957F\u81F32026\u5E74\u5E95\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5927\u9A6C\u65C5\u6E38\u5C40\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u9762\u5BF9\u6709\u5173\u4FC3\u9500\u6D3B\u52A8\u96C6\u4E2D\u5728\u4E2D\u56FD\u7684\u4E00\u4E9B\u95EE\u9898\uFF0C\u5F20\u5E86\u4FE1\u8868\u793A\uFF0C2024-2026\u5E74\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38\u5C40\u6218\u7565\u65B9\u5411\u8BA1\u5212\u6839\u636E\u4F18\u5148\u7EA7\u522B\u6982\u8FF0\u4E86\u76EE\u6807\u5E02\u573A\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u4E1C\u76DF\u5185\u90E8\u7684\u91CD\u4E2D\u4E4B\u91CD\u662F\u5370\u5C3C\u548C\u8D8A\u5357\u3002\u5BF9\u4E8E\u4E9A\u6D32\uFF08\u4E0D\u5305\u62EC\u4E1C\u76DF\uFF09\uFF0C\u4E3B\u8981\u76EE\u6807\u662F\u4E2D\u56FD\u548C\u5370\u5EA6\uFF0C\u5BF9\u4E8E\u5927\u6D0B\u6D32\u5E02\u573A\uFF0C\u91CD\u70B9\u662F\u6FB3\u6D32\uFF0C\u540C\u65F6\u4E5F\u4E0D\u5FFD\u89C6\u65B0\u52A0\u5761\u3001\u6CF0\u56FD\u548C\u6C76\u83B1\u7B49\u4F20\u7EDF\u5E02\u573A\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u7B2C\u4E8C\u68AF\u961F\u5305\u62EC\u97E9\u56FD\u3001\u4E2D\u4E1C\u548C\u82F1\u56FD\u7B49\u5E02\u573A\uFF0C\u800C\u7B2C\u4E09\u68AF\u961F\u76EE\u6807\u5305\u62EC\u53F0\u6E7E\u548C\u5FB7\u56FD\u3002\u7B2C\u56DB\u4E2A\u5305\u62EC\u5DF4\u57FA\u65AF\u5766\u548C\u5B5F\u52A0\u62C9\u7B49\u65B0\u5174\u5E02\u573A\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u5F20\u5E86\u4FE1\u8868\u793A\uFF0C\u5BF9\u4E8E\u6240\u6709\u8FD9\u4E9B\u5E02\u573A\uFF0C\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38\u5C40\u5C06\u7EE7\u7EED\u521B\u9020\u9700\u6C42\uFF0C\u589E\u52A0\u5BA2\u6D41\u91CF\uFF0C\u5E76\u4F18\u5148\u8FDB\u884C\u8425\u9500\u4EE5\u6EE1\u8DB3\u6E38\u5BA2\u5165\u5883\u76EE\u6807\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/yzwrxZYwC2iozi6Vyoqj4w\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
