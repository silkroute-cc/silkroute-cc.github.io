  "id": "%e8%81%9a%e8%83%b6%e8%82%a1%e4%bb%bd%e6%8a%95%e8%b5%84%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e6%96%b0%e7%94%9f%e4%ba%a7%e5%9f%ba%e5%9c%b0",
  "slug": "%e8%81%9a%e8%83%b6%e8%82%a1%e4%bb%bd%e6%8a%95%e8%b5%84%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e6%96%b0%e7%94%9f%e4%ba%a7%e5%9f%ba%e5%9c%b0",
  "canonicalUrlKey": "%e8%81%9a%e8%83%b6%e8%82%a1%e4%bb%bd%e6%8a%95%e8%b5%84%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e6%96%b0%e7%94%9f%e4%ba%a7%e5%9f%ba%e5%9c%b0",
