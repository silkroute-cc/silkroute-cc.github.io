  "canonicalUrlKey": "%e8%8b%a5%e7%8b%ae%e5%9f%8e%e4%b8%8d%e5%8f%82%e4%b8%8e-%e9%9a%86%e6%96%b0%e9%ab%98%e9%93%81%e6%88%96%e5%8f%98%e9%9a%86%e5%88%b0%e6%9f%94-%e4%b8%ad%e5%9b%bd%e9%93%81%e5%bb%ba%e6%88%90%e5%a4%a7%e7%83%ad",
  "route": "/4512/",
  "title": "\u82E5\u72EE\u57CE\u4E0D\u53C2\u4E0E \u9686\u65B0\u9AD8\u94C1\u6216\u53D8\u9686\u5230\u67D4 \u4E2D\u56FD\u94C1\u5EFA\u6210\u5927\u70ED\u95E8",
  "summary": "\uFF08\u5409\u9686\u57616\u65E5\u8BAF\uFF09\u653F\u5E9C\u5C06\u5728\u8FD1\u51E0\u4E2A\u6708\u5185\u4E0E\u65B0\u52A0\u5761\u653F\u5E9C\u5C55\u5F00\u5168\u9762\u534F\u5546\uFF0C\u4EE5\u786E\u5B9A\u540E\u8005\u5BF9\u91CD\u542F\u9686\u65B0\u9AD8\u94C1\u7684\u53C2\u4E0E\u610F\u613F\uFF0C\u6709\u5927\u9A6C\u5B98\u5458\u900F\u9732\uFF0C\u82E5\u65B0\u52A0\u5761\u4E0D\u53C2\u4E0E\u8FD9\u9879\u76EE\uFF0C\u9A6C\u6765\u897F\u4E9A\u9AD8\u94C1\u673A\u6784\uFF08MyHSR Corp\uFF09\u4E5F\u4F1A\u63A2\u8BA8\u5C06\u8BE5\u7EBF\u8DEF\u4ECE\u5409\u9686\u5761\u5EF6\u4F38\u81F3\u5357\u90E8\u67D4\u4F5B\u5DDE\u3002 \u8BC4\u4F307\u8D22\u56E2\u5EFA\u8BAE\u4E66 \u5927\u9A6C\u9AD8\u94C1\u673A\u6784\u4F1A\u5728\u672C\u6708\u7B5B\u9009\u6709\u610F\u627F\u63A5\u9686\u65B0\u9AD8\u94C1\u7684\u8D22\u56E2\u540D\u5355\uFF0C\u4EE5\u7F29\u5C0F\u81F33\u62164\u4E2A\u5019\u9009\u540D\u5355 \u3002 \u6839\u636E\u300A\u65E5\u7ECF\u4E9A\u6D32\u300B\u62A5\u9053\uFF0C\u77E5\u60C5\u4EBA\u58EB\u900F\u9732\uFF0C\u4E00\u65E6\u5B8C\u6210\u7B5B\u9009\u540D\u5355\u540E\uFF0C\u8BE5\u9879\u76EE\u5EFA\u8BAE\u5C06\u4F1A\u5728\u8FD1\u671F\u5185\u63D0\u5448\u4E88\u5185\u9601\u5BA1\u6838\u5E76\u5BFB\u6C42\u901A\u8FC7\u3002 \u5F53\u5C40\u6B63\u8BC4\u4F307\u4EFD\u9686\u65B0\u9AD8\u94C1\u7684\u9879\u76EE\u5EFA\u8BAE\u4E66\uFF0C\u6709\u2026",
  "body": "\u003Cp\u003E\uFF08\u5409\u9686\u57616\u65E5\u8BAF\uFF09\u653F\u5E9C\u5C06\u5728\u8FD1\u51E0\u4E2A\u6708\u5185\u4E0E\u65B0\u52A0\u5761\u653F\u5E9C\u5C55\u5F00\u5168\u9762\u534F\u5546\uFF0C\u4EE5\u786E\u5B9A\u540E\u8005\u5BF9\u91CD\u542F\u9686\u65B0\u9AD8\u94C1\u7684\u53C2\u4E0E\u610F\u613F\uFF0C\u6709\u5927\u9A6C\u5B98\u5458\u900F\u9732\uFF0C\u82E5\u65B0\u52A0\u5761\u4E0D\u53C2\u4E0E\u8FD9\u9879\u76EE\uFF0C\u9A6C\u6765\u897F\u4E9A\u9AD8\u94C1\u673A\u6784\uFF08MyHSR Corp\uFF09\u4E5F\u4F1A\u63A2\u8BA8\u5C06\u8BE5\u7EBF\u8DEF\u4ECE\u5409\u9686\u5761\u5EF6\u4F38\u81F3\u5357\u90E8\u67D4\u4F5B\u5DDE\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u8BC4\u4F307\u8D22\u56E2\u5EFA\u8BAE\u4E66\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u5927\u9A6C\u9AD8\u94C1\u673A\u6784\u4F1A\u5728\u672C\u6708\u7B5B\u9009\u6709\u610F\u627F\u63A5\u9686\u65B0\u9AD8\u94C1\u7684\u8D22\u56E2\u540D\u5355\uFF0C\u4EE5\u7F29\u5C0F\u81F33\u62164\u4E2A\u5019\u9009\u540D\u5355 \u3002\u003C/p\u003E\n\u003Cp\u003E\u6839\u636E\u300A\u65E5\u7ECF\u4E9A\u6D32\u300B\u62A5\u9053\uFF0C\u77E5\u60C5\u4EBA\u58EB\u900F\u9732\uFF0C\u4E00\u65E6\u5B8C\u6210\u7B5B\u9009\u540D\u5355\u540E\uFF0C\u8BE5\u9879\u76EE\u5EFA\u8BAE\u5C06\u4F1A\u5728\u8FD1\u671F\u5185\u63D0\u5448\u4E88\u5185\u9601\u5BA1\u6838\u5E76\u5BFB\u6C42\u901A\u8FC7\u3002\u003C/p\u003E\n\u003Cp\u003E\u5F53\u5C40\u6B63\u8BC4\u4F307\u4EFD\u9686\u65B0\u9AD8\u94C1\u7684\u9879\u76EE\u5EFA\u8BAE\u4E66\uFF0C\u670931\u5BB6\u516C\u53F8\u5305\u62EC7\u5BB6\u672C\u5730\u548C\u56FD\u9645\u8D22\u56E2\uFF0C\u5DF2\u63D0\u4EA4\u9686\u65B0\u9AD8\u94C1\u9879\u76EE\u4FE1\u606F\u5F81\u8BE2\u4E66\u3002\u003C/p\u003E\n\u003Cp\u003E\u5176\u4E2D\u5305\u62EC\u4E2D\u56FD\u94C1\u5EFA\u3001\u73B0\u4EE3\uFF08Hyundai\uFF09\u3001MMC\u96C6\u56E2\u3001\u91D1\u52A1\u5927\uFF08GAMUDA\uFF0C5398\uFF0C\u4E3B\u677F\u5EFA\u7B51\u80A1\uFF09\u3001\u6768\u5FE0\u793C\u673A\u6784\uFF08YTL\uFF0C4677\uFF0C\u4E3B\u677F\u516C\u7528\u4E8B\u4E1A\u80A1\uFF09\u3001WCT\u63A7\u80A1\u3001\u6210\u529F\u96C6\u56E2\u7B49\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u4E2D\u56FD\u94C1\u5EFA\u6210\u5927\u70ED\u95E8\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u636E\u4E86\u89E3 \uFF0C\u4E2D\u56FD\u94C1\u5EFA\u9886\u5BFC\u7684\u8D22\u56E2\u88AB\u89C6\u4E3A\u5177\u6709\u6F5C\u80FD\u5165\u56F4\u7684\u5019\u9009\u8005\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E00\u540D\u5927\u9A6C\u5B98\u5458\u8868\u793A\uFF0C\u5F53\u5C40\u5E0C\u671B\u80FD\u5C3D\u5FEB\u786E\u5B9A\u6709\u5173\u5EFA\u8BAE\uFF0C\u4EE5\u4FBF\u5728\u63A5\u4E0B\u6765\u76843\u81F34\u4E2A\u6708\u5185\u5B8C\u6210 \u3002\u003C/p\u003E\n\u003Cp\u003E\u5728\u53BB\u5E747\u6708\uFF0C\u5927\u9A6C\u653F\u5E9C\u547C\u5401\u79C1\u4EBA\u754C\u8FDB\u884C\u516C\u79C1\u5408\u4F5C\u6A21\u5F0F\u4EE5\u53D1\u5C55\u548C\u8425\u8FD0\u8BE5\u9879\u76EE\u3002\u65B0\u52A0\u5761\u5219\u5728\u76F8\u9694\u4E00\u4E2A\u6708\u540E\uFF0C\u5373\u540C\u5E748\u6708\u8868\u793A\u613F\u610F\u548C\u6211\u56FD\u91CD\u65B0\u8BA8\u8BBA\u9686\u65B0\u9AD8\u94C1\u8BA1\u5212\uFF0C\u4F46\u5F53\u65F6\u8868\u660E\u4ECD\u672A\u6536\u5230\u5927\u9A6C\u7684\u5EFA\u8BAE\u3002\u003C/p\u003E\n\u003Cp\u003E\u5206\u6790\u4EBA\u58EB\u8BA4\u4E3A\uFF0C\u5927\u9A6C\u8981\u5B8C\u6210\u6B64\u9879\u76EE\u8FD8\u9700\u8981\u514B\u670D\u91CD\u91CD\u969C\u788D\uFF0C\u5C24\u5176\u662F\u5728\u4F30\u8BA1\u6210\u672C\u9AD8\u8FBE1200\u4EBF\u4EE4\u5409\u7684\u60C5\u51B5\u4E0B\uFF0C\u8D44\u91D1\u662F\u653F\u5E9C\u7684\u53E6\u4E00\u4E2A\u969C\u788D\uFF0C\u9700\u901A\u8FC7\u79C1\u4EBA\u4F01\u4E1A\u627F\u62C5\u8D44\u672C\u3002\u003C/p\u003E\n\u003Cp\u003E\u653F\u7B56\u987E\u95EE\u516C\u53F8BowerGroupAsia\u603B\u76D1\u963F\u8FEA\u5E03\u8868\u793A\uFF0C\u8981\u662F\u6CA1\u6709\u653F\u5E9C\u7684\u660E\u786E\u652F\u6301\uFF0C\u5927\u9A6C\u5FC5\u987B\u4ED8\u51FA\u9AD8\u6602\u7684\u4EE3\u4EF7\u6765\u843D\u5B9E\u6B64\u9879\u76EE\uFF0C\u5C24\u5176\u662F\u7D27\u5F20\u7684\u8D22\u52A1\u72B6\u51B5\u9020\u6210\u4E86\u4E25\u91CD\u7684\u9650\u5236\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E3A\u4E86\u652F\u6491\u56FD\u5BB6\u7684\u8D22\u653F\u72B6\u51B5\uFF0C\u5927\u9A6C\u653F\u5E9C\u8C03\u9AD8\u6CD5\u5B9A\u503A\u52A1\u4E0A\u9650\uFF0C\u4ECE\u56FD\u5185\u751F\u4EA7\u603B\u503C\u768455%\u63D0\u9AD8\u81F360%\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/H0GXmQjq_YJXww5cdKD_3g\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
