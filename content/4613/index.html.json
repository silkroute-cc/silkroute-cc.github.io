  "canonicalUrlKey": "%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e4%b8%9c%e9%92%a2%e7%94%98%e9%a9%ac%e6%8c%bd%e6%b8%af%e5%8f%a3%e7%89%a9%e6%b5%81%e6%94%b9%e9%80%a0%e5%b7%a5%e7%a8%8b%e8%bf%9b%e5%85%a5%e8%af%95%e7%94%9f%e4%ba%a7",
  "route": "/4613/",
  "title": "\u9A6C\u6765\u897F\u4E9A\u4E1C\u94A2\u7518\u9A6C\u633D\u6E2F\u53E3\u7269\u6D41\u6539\u9020\u5DE5\u7A0B\u8FDB\u5165\u8BD5\u751F\u4EA7\u9636\u6BB5",
  "summary": "\u8FD1\u65E5\uFF0C\u9A6C\u6765\u897F\u4E9A\u4E1C\u94A2\u4F20\u6765\u597D\u6D88\u606F\uFF0C\u4ECE\u7518\u9A6C\u633D\u6E2F\u53E3\u5378\u8239\u673A\u540A\u53D6\u7684\u7B2C\u4E00\u540A\u539F\u71C3\u6599\u7ECF\u8FC7\u7BA1\u5F0F\u76AE\u5E26\u8F93\u9001\u673A\uFF08\u7B80\u79F0\u201C\u7BA1\u5E26\u673A\u201D\uFF09\u987A\u5229\u8FDB\u5165\u9A6C\u6765\u897F\u4E9A\u4E1C\u94A2\u7EFC\u5408\u6599\u573A\uFF0C\u6807\u5FD7\u7740 2023 \u5E74 1 \u6708 6 \u65E5\u5F00\u5DE5\u7684 \u7518\u9A6C\u633D\u6E2F\u53E3\u7269\u6D41\u6539 \u9020\u5DE5\u7A0B \uFF0C\u7ECF\u8FC7 470 \u591A\u5929\u7684\u7D27\u5F20\u5EFA\u8BBE\u987A\u5229\u7AE3\u5DE5\uFF0C \u8FDB\u5165\u8BD5\u751F\u4EA7\u9636\u6BB5\u3002 \u8BE5\u5DE5\u7A0B\u662F\u9A6C\u6765\u897F\u4E9A\u4E1C\u94A2\u4E8C\u671F270\u4E07\u5428\u4EA7\u80FD\u914D\u5957\u9879\u76EE\uFF0C\u901A\u8FC7\u5728\u7518\u9A6C\u633D\u6E2F\u53E3\u5EFA\u8BBE\u4E24\u5EA71500t/h\u6865\u5F0F\u6293\u6597\u5378\u8239\u673A\u3001\u4E24\u6761\u5E73\u76AE\u5E26\u8F93\u9001\u673A\u8F6C\u8FD0\u53CA\u4E09\u6761\u7BA1\u5E26\u673A\u8FDE\u63A5\u81F3\u516C\u53F8\u539F\u6599\u573A\uFF0C\u4F7F\u5F97\u539F\u3001\u71C3\u6599\u53EF\u4EE5\u76F4\u63A5\u7531\u6E2F\u53E3\u8FD0\u9001\u81F3\u7EFC\u5408\u6599\u573A\u3002\u76F8\u6BD4\u4F20\u7EDF\u8D27\u8F66\u8FD0\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/04/frc-c1ece8c81230572ba24d682db123631c.gif\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u8FD1\u65E5\uFF0C\u9A6C\u6765\u897F\u4E9A\u4E1C\u94A2\u4F20\u6765\u597D\u6D88\u606F\uFF0C\u4ECE\u7518\u9A6C\u633D\u6E2F\u53E3\u5378\u8239\u673A\u540A\u53D6\u7684\u7B2C\u4E00\u540A\u539F\u71C3\u6599\u7ECF\u8FC7\u7BA1\u5F0F\u76AE\u5E26\u8F93\u9001\u673A\uFF08\u7B80\u79F0\u201C\u7BA1\u5E26\u673A\u201D\uFF09\u987A\u5229\u8FDB\u5165\u9A6C\u6765\u897F\u4E9A\u4E1C\u94A2\u7EFC\u5408\u6599\u573A\uFF0C\u6807\u5FD7\u77402023\u5E741\u67086\u65E5\u5F00\u5DE5\u7684\u7518\u9A6C\u633D\u6E2F\u53E3\u7269\u6D41\u6539\u9020\u5DE5\u7A0B\uFF0C\u7ECF\u8FC7470\u591A\u5929\u7684\u7D27\u5F20\u5EFA\u8BBE\u987A\u5229\u7AE3\u5DE5\uFF0C\u8FDB\u5165\u8BD5\u751F\u4EA7\u9636\u6BB5\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/04/frc-839341c4ab2d028ce673bb9bf2d4d95e.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u8BE5\u5DE5\u7A0B\u662F\u9A6C\u6765\u897F\u4E9A\u4E1C\u94A2\u4E8C\u671F270\u4E07\u5428\u4EA7\u80FD\u914D\u5957\u9879\u76EE\uFF0C\u901A\u8FC7\u5728\u7518\u9A6C\u633D\u6E2F\u53E3\u5EFA\u8BBE\u4E24\u5EA71500t/h\u6865\u5F0F\u6293\u6597\u5378\u8239\u673A\u3001\u4E24\u6761\u5E73\u76AE\u5E26\u8F93\u9001\u673A\u8F6C\u8FD0\u53CA\u4E09\u6761\u7BA1\u5E26\u673A\u8FDE\u63A5\u81F3\u516C\u53F8\u539F\u6599\u573A\uFF0C\u4F7F\u5F97\u539F\u3001\u71C3\u6599\u53EF\u4EE5\u76F4\u63A5\u7531\u6E2F\u53E3\u8FD0\u9001\u81F3\u7EFC\u5408\u6599\u573A\u3002\u76F8\u6BD4\u4F20\u7EDF\u8D27\u8F66\u8FD0\u8F93\u65B9\u5F0F\uFF0C\u5177\u6709\u65E0\u7269\u6599\u6D12\u843D\u3001\u65E0\u626C\u5C18\u7B49\u7279\u70B9\uFF0C\u53EF\u8282\u7701\u6D77\u8FD0\u8D395\u7F8E\u5143/\u5428\u94A2\uFF0C\u5927\u5927\u52A0\u5FEB\u4E86\u6CCA\u4F4D\u5468\u8F6C\u6548\u7387\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/04/frc-5080da2624092d19e3f779dcbcc95eb7.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5378\u8239\u673A\u91C7\u7528\u5168\u6570\u5B57\u5F0F\u53D8\u9891\u5668\u8C03\u901F\u7684\u77E2\u91CF\u63A7\u5236\u3002\u8C03\u901F\u7CFB\u7EDF\u8C03\u901F\u8303\u56F4\u5BBD\u3001\u6027\u80FD\u597D\u3001\u5DE5\u4F5C\u6548\u7387\u9AD8\uFF0C\u5177\u6709\u6545\u969C\u81EA\u8BCA\u65AD\u529F\u80FD\u3002\u4E3B\u673A\u6784\u7684\u53D8\u9891\u5668\u5E26\u80FD\u91CF\u56DE\u9988\u5355\u5143\uFF0C\u80FD\u5C06\u5404\u673A\u6784\u5728\u4F5C\u4E1A\u4E2D\u4EA7\u751F\u7684\u591A\u4F59\u80FD\u91CF\u56DE\u9988\u5230\u7535\u7F51\uFF0C\u4EE5\u8FBE\u5230\u8282\u7701\u80FD\u6E90\u7684\u76EE\u7684\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/04/frc-93dd6b6b5bbb8ab7f7d40d1fd25927df.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u7BA1\u5E26\u673A\u5168\u957F\u7EA68\u516C\u91CC\uFF0C\u67094\u4E2A\u8F6C\u8FD0\u7AD9\uFF0C\u6BCF\u5C0F\u65F6\u6700\u5927\u8F93\u9001\u80FD\u529B3000\u5428\uFF0C\u5E74\u8F93\u9001\u80FD\u529B\u8FBE900\u4E07\u5428\u3002\u8BE5\u7BA1\u5E26\u673A\u8FD0\u7528\u4E86\u56FD\u5185\u5148\u8FDB\u7684\u667A\u80FD\u5DE1\u68C0\u6280\u672F\uFF0C\u91C7\u7528\u4E86\u96C6\u8F6C\u5411\u3001\u5BFC\u5411\u3001\u9884\u5F20\u7D27\u53CA\u9A71\u52A8\u4E3A\u4E00\u4F53\u7684\u53CC\u9A71\u673A\u6784\u7ED3\u6784\u8BBE\u8BA1\uFF0C\u642D\u8F7D\u4E91\u53F0\u3001\u9AD8\u6E05\u6444\u50CF\u5934\u3001\u7EA2\u5916\u70ED\u6210\u50CF\u4EEA\u3001\u62FE\u97F3\u5668\u3001\u8D85\u58F0\u6CE2\u96F7\u8FBE\u3001RFID\u53CA\u7F16\u7801\u5668\u7B49\u6A21\u5757\u4E8E\u4E00\u8EAB\uFF0C\u5177\u5907\u89C6\u89C9\u8BC6\u522B\u3001\u8BBE\u5907\u6D4B\u6E29\u3001\u566A\u97F3\u8BC6\u522B\u3001\u81EA\u4E3B\u5B9A\u4F4D\u3001\u81EA\u52A8\u907F\u969C\u3001\u81EA\u4E3B\u5145\u7535\u3001\u81EA\u52A8\u5DE1\u68C0\u3001\u5F02\u5E38\u60C5\u51B5\u81EA\u52A8\u62A5\u8B66\u7B49\u591A\u79CD\u529F\u80FD\uFF0C\u53EF\u901A\u8FC7\u7535\u8111\u3001\u624B\u673A\u6216IPAD\u7B49\u7EC8\u7AEF\u5B9E\u73B0\u8FDC\u7A0B\u7BA1\u7406\u548C\u76D1\u63A7\uFF0C\u968F\u65F6\u968F\u5730\u638C\u63E1\u73B0\u573A\u60C5\u51B5\u3002\u003C/p\u003E\n\u003Cp\u003E\u672A\u6765\uFF0C\u9A6C\u6765\u897F\u4E9A\u4E1C\u94A2\u5C06\u8FDB\u4E00\u6B65\u63D0\u5347\u7EFF\u8272\u3001\u73AF\u4FDD\u7684\u539F\u71C3\u6599\u8FD0\u8F93\u65B9\u5F0F\uFF0C\u6784\u5EFA\u66F4\u9AD8\u6548\u3001\u66F4\u4F4E\u78B3\u7684\u7269\u6D41\u4F53\u7CFB\uFF0C\u51CF\u5C11\u8FD0\u8F93\u8FC7\u7A0B\u4E2D\u7684\u80FD\u8017\u548C\u6392\u653E\uFF0C\u4E3A\u5EFA\u8BBE\u7EFF\u8272\u3001\u9AD8\u6548\u3001\u53EF\u6301\u7EED\u53D1\u5C55\u7684\u9A6C\u6765\u897F\u4E9A\u9996\u5C48\u4E00\u6307\u7684\u5927\u578B\u94A2\u94C1\u8054\u5408\u4F01\u4E1A\u8D21\u732E\u5EFA\u9F99\u529B\u91CF\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/04/frc-b08e17a320d37b60e80a4b7e50a9b235.gif\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5EFA\u9F99\u96C6\u56E2\u54C1\u724C\u4F20\u64AD\u4E2D\u5FC3\u51FA\u54C1\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u9A6C\u6765\u897F\u4E9A\u4E1C\u94A2\u003C/p\u003E\n\u003Cp\u003E\u4F5C\u8005\uFF1A\u5B59\u7389\u6210\n\u003C/p\u003E\n\u003Cp\u003E\u7F16\u8F91\uFF1A\u5218 \u535A\u003C/p\u003E\n\u003Cp\u003E\u5BA1\u6838\uFF1A\u90ED\u5C0F\u71D5\u003C/p\u003E\n\u003Cp\u003E\u76D1\u5236\uFF1A\u695A\u7ECD\u56FD\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/04/frc-932ba64cb62e561d3e17b684326e29c4.gif\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/04/frc-7bf90942a3412bda60c4e8b09f2c2c6c.jpg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u7531\u4E8E\u5FAE\u4FE1\u6539\u7248\u4E86\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5982\u679C\u60A8\u4E0D\u70B9\u661F\u6807\u7684\u8BDD\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5237\u5230\u6211\u4EEC\u65B0\u95FB\u7684\u6982\u7387\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u4F1A\u8D8A\u6765\u8D8A\u5C0F\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u751A\u81F3\u8FDE\u5C01\u9762\u4E5F\u770B\u4E0D\u5230\u4E86\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5982\u679C\u60A8\u4E0D\u60F3\u9519\u8FC7\u9F99\u5B9D\u7684\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u6BCF\u4E00\u4E2A\u7206\u6599\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u90A3\u5C31\u52A0\u4E2A\u661F\u6807\u5427\u003C/strong\u003E\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/04/frc-cc1dee007bd309a238df1ad274cbb59f.jpg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/04/frc-15526b34ab79378182c7bc92165e0e63.gif\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/04/frc-7b8fbc0c50f99c553f14b350a4b513f2.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/04/frc-a0b403a7241f97d80fbd80799234b455.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5F80\u671F\u63A8\u8350\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/04/frc-0e2650b34257faa61994c22f35c94316.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Ch1\u003E\u003Cstrong\u003E\u540C\u6BD4\u589E\u957F84%\uFF01\u5EFA\u9F99\u5DDD\u9505\u4E00\u5B63\u5EA6\u8BA2\u5355\u603B\u91CF\u521B5\u5E74\u6765\u65B0\u9AD8\u003C/strong\u003E\u003C/h1\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/04/frc-dec54886e923869c9d5e4b338f145515.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Ch1\u003E\u003Cstrong\u003E\u5EFA\u9F99\u96C6\u56E2\u4E0E\u9F99\u6C5F\u94F6\u884C\u7B7E\u7F72\u6218\u7565\u5408\u4F5C\u534F\u8BAE\u003C/strong\u003E\u003C/h1\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/RhDeKCg3Aqpx4LWrDRsTsw\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
