  "route": "/5370/",
  "title": "\u4E1C\u5357\u4E9A\u6570\u636E\u4E2D\u5FC3\u589E70% \u5927\u9A6C\u51ED\u4F18\u52BF\u8131\u9896\u800C\u51FA",
  "summary": "\uFF08\u5409\u9686\u57616\u65E5\u8BAF\uFF09\u8FD1\u5E74\u6765\uFF0C\u4E1C\u5357\u4E9A\u6570\u636E\u4E2D\u5FC3\u5E02\u573A\u8FC5\u901F\u589E\u957F\uFF0C\u5C24\u5176\u5927\u9A6C\u51ED\u501F\u5176\u4F18\u52BF\u5728\u533A\u57DF\u5185\u8131\u9896\u800C\u51FA\u3002 \u6839\u636E\u8D44\u6599\u4E2D\u5FC3\u60C5\u62A5\u516C\u53F8DC Byte\u7684\u6570\u636E\uFF0C\u4E1C\u5357\u4E9A\u4E94\u56FD\uFF08SEA-5\uFF09\u5373\u5927\u9A6C\u3001\u5370\u5C3C\u3001\u6CF0\u56FD\u3001\u83F2\u5F8B\u5BBE\u548C\u8D8A\u5357\u7684\u6570\u636E\u4E2D\u5FC3\u4F9B\u5E94\u57282018\u5E74\u81F32023\u5E74\u95F4\u7684\u5E74\u5747\u590D\u5408\u589E\u957F\u7387\uFF0C\u8FBE\u5230\u4E86\u60CA\u4EBA\u768470%\u3002 \u8FC7\u53BB\u4E24\u5E74\uFF0C\u5927\u9A6C\u5DF2\u5BA3\u5E03\u4EF7\u503C990\u4EBF\u4EE4\u5409\uFF08\u7EA6217\u4EBF\u7F8E\u5143\uFF09\u7684\u6570\u636E\u4E2D\u5FC3\u6295\u8D44\u9879\u76EE\u3002 \u6839\u636E\u5927\u9A6C\u6570\u5B57\u7ECF\u6D4E\u673A\u6784\uFF08MDEC\uFF09\u7684\u6570\u636E\uFF0C\u8FD8\u67091490\u4EBF\u4EE4\u5409\u7684\u6295\u8D44\u9879\u76EE\u6B63\u5728\u89C4\u5212\u4E2D\u3002 \u6839\u636E\u8D22\u7ECF\u5468\u520A\u201CThe Edge\u201D\u62A5\u9053\u2026",
  "body": "\u003Cp\u003E\uFF08\u5409\u9686\u57616\u65E5\u8BAF\uFF09\u8FD1\u5E74\u6765\uFF0C\u4E1C\u5357\u4E9A\u6570\u636E\u4E2D\u5FC3\u5E02\u573A\u8FC5\u901F\u589E\u957F\uFF0C\u5C24\u5176\u5927\u9A6C\u51ED\u501F\u5176\u4F18\u52BF\u5728\u533A\u57DF\u5185\u8131\u9896\u800C\u51FA\u3002\u003C/p\u003E\n\u003Cp\u003E\u6839\u636E\u8D44\u6599\u4E2D\u5FC3\u60C5\u62A5\u516C\u53F8DC Byte\u7684\u6570\u636E\uFF0C\u4E1C\u5357\u4E9A\u4E94\u56FD\uFF08SEA-5\uFF09\u5373\u5927\u9A6C\u3001\u5370\u5C3C\u3001\u6CF0\u56FD\u3001\u83F2\u5F8B\u5BBE\u548C\u8D8A\u5357\u7684\u6570\u636E\u4E2D\u5FC3\u4F9B\u5E94\u57282018\u5E74\u81F32023\u5E74\u95F4\u7684\u5E74\u5747\u590D\u5408\u589E\u957F\u7387\uFF0C\u8FBE\u5230\u4E86\u60CA\u4EBA\u768470%\u3002\u003C/p\u003E\n\u003Cp\u003E\u8FC7\u53BB\u4E24\u5E74\uFF0C\u5927\u9A6C\u5DF2\u5BA3\u5E03\u4EF7\u503C990\u4EBF\u4EE4\u5409\uFF08\u7EA6217\u4EBF\u7F8E\u5143\uFF09\u7684\u6570\u636E\u4E2D\u5FC3\u6295\u8D44\u9879\u76EE\u3002\u6839\u636E\u5927\u9A6C\u6570\u5B57\u7ECF\u6D4E\u673A\u6784\uFF08MDEC\uFF09\u7684\u6570\u636E\uFF0C\u8FD8\u67091490\u4EBF\u4EE4\u5409\u7684\u6295\u8D44\u9879\u76EE\u6B63\u5728\u89C4\u5212\u4E2D\u3002\n\u003C/p\u003E\n\u003Cp\u003E\u6839\u636E\u8D22\u7ECF\u5468\u520A\u201CThe Edge\u201D\u62A5\u9053\uFF0C\u5927\u9A6C\u7684\u6570\u636E\u4E2D\u5FC3\u589E\u957F\uFF0C\u90E8\u5206\u5F97\u76CA\u4E8E\u65B0\u52A0\u5761\u57282019\u5E74\u6682\u505C\u65B0\u6570\u636E\u4E2D\u5FC3\u5EFA\u8BBE\u7684\u6EA2\u51FA\u6548\u5E94\u3002\u51ED\u501F\u4F4E\u5EC9\u7684\u623F\u5730\u4EA7\u4EF7\u683C\u3001\u5F3A\u5927\u7684\u7535\u4FE1\u57FA\u7840\u8BBE\u65BD\u548C\u7A33\u5B9A\u7684\u7535\u529B\u4F9B\u5E94\uFF0C\u5927\u9A6C\u9010\u6E10\u6210\u4E3A\u5168\u7403\u6295\u8D44\u8005\u7684\u9996\u9009\u3002\u003C/p\u003E\n\u003Cp\u003E\u5927\u9A6C\u653F\u5E9C\u7684\u652F\u6301\u66F4\u662F\u5173\u952E\u63A8\u52A8\u529B\u3002\u5927\u9A6C\u6295\u8D44\u53D1\u5C55\u5C40\uFF08MIDA\uFF09\u4E0E\u5927\u9A6C\u6570\u5B57\u7ECF\u6D4E\u673A\u6784\u5408\u4F5C\u6210\u7ACB\u4E86\u6570\u5B57\u6295\u8D44\u529E\u516C\u5BA4\uFF0C\u4F5C\u4E3A\u653F\u5E9C\u4E0E\u6295\u8D44\u8005\u4E4B\u95F4\u7684\u534F\u8C03\u5E73\u53F0\uFF0C\u63A8\u52A8\u66F4\u591A\u6570\u5B57\u5316\u6295\u8D44\uFF0C\u52A0\u901F\u6570\u636E\u4E2D\u5FC3\u7684\u53D1\u5C55\u3002\u003C/p\u003E\n\u003Cp\u003E\u6B64\u5916\uFF0C\u653F\u5E9C\u901A\u8FC7\u5206\u8BBE\u6570\u5B57\u90E8\u548C\u901A\u8BAF\u90E8\uFF0C\u4EE5\u66F4\u4E13\u6CE8\u4E8E\u6570\u5B57\u5316\u57FA\u7840\u8BBE\u65BD\u5EFA\u8BBE\uFF0C\u540C\u65F6\u63A8\u51FAMyGovCloud\u3001Malaysia Digital\u7B49\u9879\u76EE\uFF0C\u63D0\u5347\u5927\u9A6C\u7684\u5438\u5F15\u529B\u3002\u003C/p\u003E\n\u003Cp\u003E\u9664\u6B64\u4E4B\u5916\uFF0C\u5927\u9A6C\u5438\u5F15\u4E86\u4F17\u591A\u56FD\u9645\u4E91\u8BA1\u7B97\u5DE8\u5934\u3002\u4ECA\u5E748\u6708\uFF0C\u4E9A\u9A6C\u900A\u7F51\u7EDC\u670D\u52A1\uFF08AWS\uFF09\u5728\u5927\u9A6C\u8BBE\u7ACB\u9996\u4E2A\u4E91\u533A\u57DF\uFF0C\u8BA1\u5212\u57282038\u5E74\u524D\u6295\u8D44292\u4EBF\u4EE4\u5409\u3002\u003C/p\u003E\n\u003Cp\u003E\u8C37\u6B4C\u4E5F\u627F\u8BFA\u5728\u5927\u9A6C\u6295\u8D4420\u4EBF\u7F8E\u5143\uFF08\u7EA688.5\u4EBF\u4EE4\u5409\uFF09\uFF0C\u5EFA\u8BBE\u9996\u4E2A\u6570\u636E\u4E2D\u5FC3\u53CA\u4E91\u533A\u57DF\uFF1B\u5FAE\u8F6F\u5219\u8BA1\u5212\u6295\u8D4422\u4EBF\u7F8E\u5143\uFF0897.35\u4EBF\u4EE4\u5409\uFF09\uFF0C\u5728\u5927\u9A6C\u5EFA\u8BBE\u65B0\u7684\u4E91\u4E0E\u4EBA\u5DE5\u667A\u80FD\u57FA\u7840\u8BBE\u65BD\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u672A\u67655\u5E74\u6599\u98D9\u5347600%\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u5927\u9A6C\u4E0D\u4EC5\u5728\u6570\u636E\u4E2D\u5FC3\u89C4\u6A21\u4E0A\u663E\u8457\u6269\u5F20\uFF0C\u5176\u53D1\u5C55\u8BA1\u5212\u603B\u5BB9\u91CF\u8FBE1.2\u5409\u74E6\uFF0C\u9884\u8BA1\u672A\u67655\u5E74\u98D9\u5347600%\u3002\u003C/p\u003E\n\u003Cp\u003E\u503C\u5F97\u4E00\u63D0\u7684\u662F\uFF0C\u5927\u9A6C\u6B63\u5728\u5B8C\u5584\u6570\u636E\u4E2D\u5FC3\u4F9B\u5E94\u94FE\u751F\u6001\u7CFB\u7EDF\uFF0C\u6D89\u53CA\u534A\u5BFC\u4F53\u3001\u6570\u636E\u4E2D\u5FC3\u8BBE\u5907\u5236\u9020\u3001\u4E91\u8BA1\u7B97\u670D\u52A1\u53CA\u4EBA\u5DE5\u667A\u80FD\u6570\u636E\u4E2D\u5FC3\u3002\u003C/p\u003E\n\u003Cp\u003E\u540C\u65F6\uFF0C\u6570\u636E\u4E2D\u5FC3\u6295\u8D44\u8005\u5BF9\u53EF\u518D\u751F\u80FD\u6E90\u7684\u9700\u6C42\u4E0D\u65AD\u589E\u957F\uFF0C\u4E3A\u5927\u9A6C\u6269\u5C55\u53EF\u518D\u751F\u80FD\u6E90\u751F\u6001\u7CFB\u7EDF\u63D0\u4F9B\u4E86\u673A\u4F1A\uFF0C\u8FD9\u4E5F\u4E0E\u653F\u5E9C\u7684\u80FD\u6E90\u8F6C\u578B\u76EE\u6807\u4E00\u81F4\u3002\u003C/p\u003E\n\u003Cp\u003E\u5728\u4EBA\u5DE5\u667A\u80FD\u65F6\u4EE3\uFF0C\u6570\u636E\u4E2D\u5FC3\u6210\u4E3A\u4E86\u6218\u7565\u6027\u5FC5\u9700\u54C1\u3002\u5927\u9A6C\u7684\u8D85\u5927\u89C4\u6A21\u6570\u636E\u4E2D\u5FC3\u6B63\u652F\u6301\u751F\u6210\u5F0F\u4EBA\u5DE5\u667A\u80FD\u7684\u5DE5\u4F5C\u8D1F\u8F7D\u589E\u957F\u3002\u003C/p\u003E\n\u003Cp\u003E\u901A\u8FC7\u5438\u5F15\u6570\u636E\u4E2D\u5FC3\u6295\u8D44\u5E76\u63A8\u52A8\u76F8\u5173\u4F9B\u5E94\u94FE\u7684\u53D1\u5C55\uFF0C\u5927\u9A6C\u6B63\u5728\u6253\u9020\u5F3A\u5927\u7684\u751F\u6001\u7CFB\u7EDF\uFF0C\u652F\u6301\u4EBA\u5DE5\u667A\u80FD\u53D1\u5C55\uFF0C\u5438\u5F15\u5168\u7403\u79D1\u6280\u5DE8\u5934\u5728\u5927\u9A6C\u5EFA\u7ACB\u4EBA\u5DE5\u667A\u80FD\u8425\u8FD0\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/HKvZAtPaIxF9hQmbn7vv2Q\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
