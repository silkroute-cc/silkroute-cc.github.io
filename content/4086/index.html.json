  "route": "/4086/",
  "title": "\u9A6C\u6765\u897F\u4E9A\u56FD\u6CB9\u5316\u5B66\u8FB9\u4F73\u5170\u6295\u8D44\u5EFA\u8BBE\u4E9A\u6D32\u6700\u5927\u5316\u5B66\u54C1\u56DE\u6536\u5382",
  "summary": "\uFF08\u5409\u9686\u57619\u65E5\u8BAF\uFF09\u56FD\u6CB9\u5316\u5B66\uFF08PCHEM\uFF0C5183\uFF0C\u4E3B\u677F\u5DE5\u4E1A\u80A1\uFF09\u8FBE\u6210\u6700\u7EC8\u6295\u8D44\u51B3\u5B9A\uFF0C\u5728\u67D4\u4F5B\u8FB9\u4F73\u5170\u5174\u5EFA\u4E00\u5EA7\u5E74\u4EA7\u80FD\u7EA633\u5343\u5428\uFF08KTPA\uFF09\u7684\u5316\u5B66\u54C1\u56DE\u6536\u5382\uFF0C\u9884\u8BA1\u4E8E2026\u5E74\u4E0A\u534A\u5E74\u6295\u5165\u8FD0\u4F5C\u3002 \u56FD\u6CB9\u5316\u5B66\u901A\u8FC7\u65B0\u95FB\u7A3F\u8868\u793A\uFF0C\u4E00\u65E6\u5B8C\u6210\u5174\u5EFA\u5DE5\u7A0B\uFF0C\u8BE5\u5382\u623F\u5C06\u4F1A\u662F\u4E9A\u6D32\u6700\u5927\u5148\u8FDB\u5316\u5B66\u54C1\u56DE\u6536\u5382\u3002 \u4E0E\u6B64\u540C\u65F6\uFF0C\u56FD\u6CB9\u5316\u5B66\u6307\u51FA\uFF0C\u8FD9\u662F\u8BE5\u516C\u53F8\u65B0\u5851\u6599\u7ECF\u6D4E\u8BAE\u7A0B\u7684\u4E00\u90E8\u4EFD\uFF0C\u4EE5\u652F\u6301\u5FAA\u73AF\u4F7F\u7528\u7ECF\u6D4E\u8F6C\u578B\uFF0C\u5E76\u4E3A\u6C38\u7EED\u5851\u6599\u751F\u6001\u7CFB\u7EDF\u4F5C\u51FA\u8D21\u732E\u3002 \u8BE5\u516C\u53F8\u8FDB\u4E00\u6B65\u6307\u51FA\uFF0C\u8FD9\u5BB6\u5316\u5B66\u54C1\u56DE\u6536\u5382\u5C06\u56DE\u6536\u62A5\u5E9F\u5851\u6599\uFF0C\u5E76\u8F6C\u5316\u4E3A\u88C2\u89E3\u6CB9\uFF0C\u4F5C\u4E3A\u751F\u4EA7\u6C38\u7EED\u5851\u6599\u7684\u5316\u5B66\u539F\u6599\u3002\u2026",
  "body": "\u003Cp\u003E\uFF08\u5409\u9686\u57619\u65E5\u8BAF\uFF09\u56FD\u6CB9\u5316\u5B66\uFF08PCHEM\uFF0C5183\uFF0C\u4E3B\u677F\u5DE5\u4E1A\u80A1\uFF09\u8FBE\u6210\u6700\u7EC8\u6295\u8D44\u51B3\u5B9A\uFF0C\u5728\u67D4\u4F5B\u8FB9\u4F73\u5170\u5174\u5EFA\u4E00\u5EA7\u5E74\u4EA7\u80FD\u7EA633\u5343\u5428\uFF08KTPA\uFF09\u7684\u5316\u5B66\u54C1\u56DE\u6536\u5382\uFF0C\u9884\u8BA1\u4E8E2026\u5E74\u4E0A\u534A\u5E74\u6295\u5165\u8FD0\u4F5C\u3002\u003C/p\u003E\n\u003Cp\u003E\u56FD\u6CB9\u5316\u5B66\u901A\u8FC7\u65B0\u95FB\u7A3F\u8868\u793A\uFF0C\u4E00\u65E6\u5B8C\u6210\u5174\u5EFA\u5DE5\u7A0B\uFF0C\u8BE5\u5382\u623F\u5C06\u4F1A\u662F\u4E9A\u6D32\u6700\u5927\u5148\u8FDB\u5316\u5B66\u54C1\u56DE\u6536\u5382\u3002\u003C/p\u003E\n\u003Cp\u003E\u4E0E\u6B64\u540C\u65F6\uFF0C\u56FD\u6CB9\u5316\u5B66\u6307\u51FA\uFF0C\u8FD9\u662F\u8BE5\u516C\u53F8\u65B0\u5851\u6599\u7ECF\u6D4E\u8BAE\u7A0B\u7684\u4E00\u90E8\u4EFD\uFF0C\u4EE5\u652F\u6301\u5FAA\u73AF\u4F7F\u7528\u7ECF\u6D4E\u8F6C\u578B\uFF0C\u5E76\u4E3A\u6C38\u7EED\u5851\u6599\u751F\u6001\u7CFB\u7EDF\u4F5C\u51FA\u8D21\u732E\u3002\u003C/p\u003E\n\u003Cp\u003E\u8BE5\u516C\u53F8\u8FDB\u4E00\u6B65\u6307\u51FA\uFF0C\u8FD9\u5BB6\u5316\u5B66\u54C1\u56DE\u6536\u5382\u5C06\u56DE\u6536\u62A5\u5E9F\u5851\u6599\uFF0C\u5E76\u8F6C\u5316\u4E3A\u88C2\u89E3\u6CB9\uFF0C\u4F5C\u4E3A\u751F\u4EA7\u6C38\u7EED\u5851\u6599\u7684\u5316\u5B66\u539F\u6599\u3002\u003C/p\u003E\n\u003Cp\u003E\u56FD\u6CB9\u5316\u5B66\u8463\u4E8B\u7ECF\u7406\u517C\u9996\u5E2D\u6267\u884C\u5458\u83AB\u54C8\u672B\u5C24\u65AF\u91CC\u8868\u793A\uFF0C\u201C\u6211\u4EEC\u5E0C\u671B\u63A8\u52A8\u6574\u4F53\u5851\u6599\u4EF7\u503C\u94FE\u7684\u521B\u65B0\uFF0C\u5171\u540C\u4E3A\u5FAA\u73AF\u4F7F\u7528\u5851\u6599\u7ECF\u6D4E\u4F5C\u51FA\u8D21\u732E\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u4E5F\u8BF4\uFF0C\u914D\u5408\u5927\u9A6C\u7684\u300A2021\u5E74\u81F32030\u5E74\u5851\u6599\u53EF\u6301\u7EED\u53D1\u5C55\u8DEF\u7EBF\u56FE\u300B\uFF0C\u5174\u5EFA\u5316\u5B66\u54C1\u56DE\u6536\u5382\u53EF\u63A8\u52A8\u56FD\u5BB6\u9010\u6B65\u6DD8\u6C70\u4E00\u6B21\u6027\u5851\u6599\uFF0C\u540C\u65F6\u6EE1\u8DB3\u5404\u5927\u54C1\u724C\u5BF9\u6C38\u7EED\u5305\u88C5\u4E0D\u65AD\u589E\u957F\u7684\u9700\u6C42\u3002\u003C/p\u003E\n\u003Cp\u003E\u622A\u81F3\u4E0B\u53484\u65F6\u96F69\u5206\uFF0C\u56FD\u6CB9\u5316\u5B66\u4E0A\u53478\u4ED9\u62161.13%\uFF0C\u81F37.18\u4EE4\u5409\uFF0C\u6210\u4EA4\u91CF\u4E3A169\u4E07\u80A1\uFF0C\u6682\u65F6\u5728\u4E0A\u5347\u699C\u4F4D\u5C45\u7B2C8\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/-Sf7B-otAN0ZlHSEkBVlZg\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
