  "route": "/2933/",
  "title": "\u81EA\u9A6C\u6765\u897F\u4E9A\u8D74\u534E\u4EBA\u5458\u7533\u8BF7\u5065\u5EB7\u7801\u548C\u884C\u524D\u68C0\u6D4B\u6700\u65B0\u89C4\u8303\uFF082022\u5E747\u67082\u65E5\u66F4\u65B0\uFF09",
  "summary": "\u6839\u636E\u5F53\u524D\u75AB\u60C5\u5F62\u52BF\u548C\u5965\u5BC6\u514B\u620E\u53D8\u5F02\u682A\u4F20\u64AD\u7279\u70B9\u7B49\u56E0\u7D20\uFF0C\u81EA2022\u5E747\u67082\u65E5\u8D77\uFF0C\u4ECE\u9A6C\u6765\u897F\u4E9A\u8D74\u534E\u4E58\u5BA2\u7533\u8BF7\u5065\u5EB7\u7801\u548C\u884C\u524D\u68C0\u6D4B\u8981\u6C42\u5982\u4E0B\uFF1A \u4E00\u3001\u6700\u65B0\u6750\u6599\u8981\u6C42 \uFF08\u4E00\uFF09\u5BF9\u6240\u6709\u8D74\u534E\u4EBA\u5458\uFF08\u65E2\u5F80\u611F\u67D3\u53F2\u4EBA\u5458\u3001\u5BC6\u5207\u63A5\u89E6\u4EBA\u5458\u3001\u6709\u7591\u4F3C\u75C7\u72B6\u4EBA\u5458\u3001\u7B2C\u4E09\u56FD\u6765\u9A6C\u4E2D\u8F6C\u8D74\u534E\u4EBA\u5458\u8BF7\u89C1\u7B2C\uFF08\u4E8C\uFF09-\uFF08\u4E94\uFF09\u9879\u8981\u6C42\uFF09 \u65F6\u95F4 \u68C0\u6D4B\u8981\u6C42 \u4E0A\u4F20\u5065\u5EB7\u7801\u5C0F\u7A0B\u5E8F\u6750\u6599\u8981\u6C42 \u767B\u673A\u524D48\u5C0F\u65F6\u5185 \u5728\u4E00\u5BB6\u9A6C\u6765\u897F\u4E9A\u5408\u6CD5\u68C0\u6D4B\u673A\u6784\u8FDB\u884C1\u6B21\u6838\u9178\u68C0\u6D4B\u3002 1.\u4E24\u6B21\u6838\u9178\u2026",
  "body": "\u003Cp\u003E\u6839\u636E\u5F53\u524D\u75AB\u60C5\u5F62\u52BF\u548C\u5965\u5BC6\u514B\u620E\u53D8\u5F02\u682A\u4F20\u64AD\u7279\u70B9\u7B49\u56E0\u7D20\uFF0C\u81EA2022\u5E747\u67082\u65E5\u8D77\uFF0C\u4ECE\u9A6C\u6765\u897F\u4E9A\u8D74\u534E\u4E58\u5BA2\u7533\u8BF7\u5065\u5EB7\u7801\u548C\u884C\u524D\u68C0\u6D4B\u8981\u6C42\u5982\u4E0B\uFF1A\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u4E00\u3001\u6700\u65B0\u6750\u6599\u8981\u6C42\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E \uFF08\u4E00\uFF09\u5BF9\u6240\u6709\u8D74\u534E\u4EBA\u5458\uFF08\u65E2\u5F80\u611F\u67D3\u53F2\u4EBA\u5458\u3001\u5BC6\u5207\u63A5\u89E6\u4EBA\u5458\u3001\u6709\u7591\u4F3C\u75C7\u72B6\u4EBA\u5458\u3001\u7B2C\u4E09\u56FD\u6765\u9A6C\u4E2D\u8F6C\u8D74\u534E\u4EBA\u5458\u8BF7\u89C1\u7B2C\uFF08\u4E8C\uFF09-\uFF08\u4E94\uFF09\u9879\u8981\u6C42\uFF09\u003C/p\u003E\n\u003Cp\u003E\u65F6\u95F4 | \u68C0\u6D4B\u8981\u6C42 | \u4E0A\u4F20\u5065\u5EB7\u7801\u5C0F\u7A0B\u5E8F\u6750\u6599\u8981\u6C42 \u767B\u673A\u524D48\u5C0F\u65F6\u5185 | \u5728\u4E00\u5BB6\u9A6C\u6765\u897F\u4E9A\u5408\u6CD5\u68C0\u6D4B\u673A\u6784\u8FDB\u884C1\u6B21\u6838\u9178\u68C0\u6D4B\u3002 | 1.\u4E24\u6B21\u6838\u9178\u68C0\u6D4B\u9634\u6027\u8BC1\u660E\u7535\u5B50\u7248\uFF1B2.\u8D74\u534E\u673A\u7968\u6216\u884C\u7A0B\u5355\u7535\u5B50\u7248\uFF1B3.\u75AB\u82D7\u63A5\u79CD\u8BC1\u660E\uFF08\u5982\u6709\uFF09\uFF1B4.\u6709\u6548\u56FD\u9645\u65C5\u884C\u8BC1\u4EF6\u8D44\u6599\u9875\u3002 \u767B\u673A\u524D24\u5C0F\u65F6\u5185 | \u5728\u53E6\u5916\u4E00\u5BB6\u9A6C\u6765\u897F\u4E9A\u5408\u6CD5\u68C0\u6D4B\u673A\u6784\u8FDB\u884C1\u6B21\u6838\u9178\u68C0\u6D4B\u3002\u003C/p\u003E\n\u003Cp\u003E\u6CE8\uFF1A\u4E24\u6B21\u68C0\u6D4B\u91C7\u6837\u65F6\u95F4\u81F3\u5C11\u95F4\u969424\u5C0F\u65F6\u3002\u003C/p\u003E\n\u003Cp\u003E\uFF08\u4E8C\uFF09\u65E2\u5F80\u611F\u67D3\u53F2\u4EBA\u5458\u003C/p\u003E\n\u003Cp\u003E\u65F6\u95F4 | \u68C0\u6D4B\u8981\u6C42 | \u4E0A\u4F20\u5065\u5EB7\u7801\u5C0F\u7A0B\u5E8F\u6750\u6599\u8981\u6C42 \u6CBB\u6108\u540E | 1.\u5728\u9A6C\u6765\u897F\u4E9A\u5408\u6CD5\u68C0\u6D4B\u673A\u6784\u8FDB\u884C\u4E24\u6B21\u6838\u9178\u68C0\u6D4B\uFF0C\u91C7\u6837\u65F6\u95F4\u95F4\u969424\u5C0F\u65F6\u4EE5\u4E0A\uFF0C\u7ED3\u679C\u987B\u4E3A\u9634\u6027\u30022.\u83B7\u5F97\u4E24\u6B21\u6838\u9178\u68C0\u6D4B\u9634\u6027\u8BC1\u660E\u540E\u6EE114\u5929\uFF08\u4ECE\u4E0A\u8FF0\u4E24\u4EFD\u68C0\u6D4B\u8BC1\u660E\u4E2D\u8F83\u665A\u4E00\u4EFD\u7684\u91C7\u6837\u65E5\u671F\u8D77\u7B97\uFF09\uFF0C\u53EF\u5B89\u6392\u8D74\u534E\u884C\u7A0B\uFF0C\u6309\u4E0A\u8FF0\u7B2C\uFF08\u4E00\uFF09\u9879\u8981\u6C42\u8FDB\u884C\u767B\u673A\u524D\u68C0\u6D4B\u3002 | \u6839\u636E\u4E0A\u8FF0\u7B2C\uFF08\u4E00\uFF09\u9879\u8981\u6C42\u63D0\u4EA4\u6750\u6599\uFF0C\u540C\u65F6\u8FD8\u9700\u63D0\u4EA4\u6CBB\u6108\u540E\u4E24\u6B21\u95F4\u969424\u5C0F\u65F6\u4EE5\u4E0A\u7684\u6838\u9178\u68C0\u6D4B\u9634\u6027\u8BC1\u660E\u7535\u5B50\u7248\u3002\u003C/p\u003E\n\u003Cp\u003E\u6CE8\uFF1A\u65E2\u5F80\u611F\u67D3\u53F2\u4EBA\u5458\u5305\u62EC\uFF1A1.\u66FE\u786E\u8BCA\u60A3\u6709\u65B0\u51A0\u80BA\u708E\u4EBA\u5458\uFF1B2.\u867D\u672A\u66FE\u786E\u8BCA\u4F46\u6838\u9178\u68C0\u6D4B\u7ED3\u679C\u66FE\u4E3A\u9633\u6027\u4EBA\u5458\u3002\u003C/p\u003E\n\u003Cp\u003E\uFF08\u4E09\uFF09\u5BC6\u5207\u63A5\u89E6\u4EBA\u5458\u003C/p\u003E\n\u003Cp\u003E\u65F6\u95F4 | \u68C0\u6D4B\u8981\u6C42 | \u4E0A\u4F20\u5065\u5EB7\u7801\u5C0F\u7A0B\u5E8F\u6750\u6599\u8981\u6C42 \u5BC6\u5207\u63A5\u89E6\u53D1\u751F\u540E | \u4E0E\u786E\u8BCA\u75C5\u4F8B\u6216\u65E0\u75C7\u72B6\u611F\u67D3\u8005\u8131\u79BB\u63A5\u89E6\u540E\uFF0C\u518D\u8FDB\u884C\u4E3A\u671F5\u5929\u7684\u9694\u79BB\u548C\u5065\u5EB7\u76D1\u6D4B\u3002\u9694\u79BB\u548C\u5065\u5EB7\u76D1\u6D4B\u671F\u95F4\u65E0\u5F02\u5E38\u7684\uFF0C\u6309\u4E0A\u8FF0\u7B2C\uFF08\u4E00\uFF09\u9879\u8981\u6C42\u8FDB\u884C\u767B\u673A\u524D\u68C0\u6D4B\u3002 | \u6839\u636E\u4E0A\u8FF0\u7B2C\uFF08\u4E00\uFF09\u9879\u8981\u6C42\u63D0\u4EA4\u6750\u6599\u3002\u003C/p\u003E\n\u003Cp\u003E\u6CE8\uFF1A\u5BC6\u5207\u63A5\u89E6\u4EBA\u5458\u5305\u62EC\uFF1A1.\u66FE\u4E0E\u786E\u8BCA\u75C5\u4F8B\u6216\u65E0\u75C7\u72B6\u611F\u67D3\u8005\u53D1\u751F\u8FC7\u65E0\u6709\u6548\u9632\u62A4\u63A5\u89E6\u7684\u4EBA\u5458\u30022.\u6838\u9178\u68C0\u6D4B\u4E3A\u4E0D\u786E\u5B9A\uFF08inconclusive\uFF09\u4EBA\u5458\u3002\u003C/p\u003E\n\u003Cp\u003E\uFF08\u56DB\uFF09\u6709\u7591\u4F3C\u75C7\u72B6\u4EBA\u5458\u003C/p\u003E\n\u003Cp\u003E\u6709\u7591\u4F3C\u75C7\u72B6\u4EBA\u5458\u5305\u62EC\uFF1A\u5F53\u4E8B\u4EBA\u5728\u767B\u673A\u524D\u6709\u53D1\u70ED\u3001\u54B3\u55FD\u3001\u8179\u6CFB\u7B49\u7591\u4F3C\u75C7\u72B6\uFF0C\u6216\u56E0\u4F53\u6E29\u8FC7\u9AD8\u3001\u7591\u4F3C\u75C7\u72B6\u7B49\u88AB\u822A\u7A7A\u516C\u53F8\u62D2\u7EDD\u767B\u673A\u3002\u6709\u7591\u4F3C\u75C7\u72B6\u4EBA\u5458\u68C0\u6D4B\u548C\u7533\u8BF7\u5065\u5EB7\u7801\u6750\u6599\u8981\u6C42\u53C2\u7167\u5BC6\u5207\u63A5\u89E6\u4EBA\u5458\u3002\u003C/p\u003E\n\u003Cp\u003E \uFF08\u4E94\uFF09\u7B2C\u4E09\u56FD\u6765\u9A6C\u4E2D\u8F6C\u8D74\u534E\u4EBA\u5458\u003C/p\u003E\n\u003Cp\u003E\u65F6\u95F4 | \u68C0\u6D4B\u8981\u6C42 | \u4E0A\u4F20\u5065\u5EB7\u7801\u5C0F\u7A0B\u5E8F\u6750\u6599\u8981\u6C42 \u5165\u5883\u9A6C\u6765\u897F\u4E9A\u524D | \u83B7\u5F97\u59CB\u53D1\u5730\uFF08\u4E2D\u8F6C\u5730\uFF09\u4E2D\u56FD\u4F7F\u9886\u9986\u5065\u5EB7\u7801\u3002 | \u6839\u636E\u4E0A\u8FF0\u7B2C\uFF08\u4E00\uFF09\u9879\u8981\u6C42\u63D0\u4EA4\u6750\u6599\uFF0C\u540C\u65F6\u8FD8\u9700\u63D0\u4EA4\u59CB\u53D1\u5730\uFF08\u4E2D\u8F6C\u5730\uFF09\u4E2D\u56FD\u4F7F\u9886\u9986\u5BA1\u53D1\u7684\u5065\u5EB7\u7801\u622A\u56FE\u3002 \u5165\u5883\u9A6C\u6765\u897F\u4E9A\u540E | \u6309\u4E0A\u8FF0\u7B2C\uFF08\u4E00\uFF09\u9879\u8981\u6C42\u8FDB\u884C\u767B\u673A\u524D\u68C0\u6D4B\u3002\u003C/p\u003E\n\u003Cp\u003E\u6CE8\uFF1A\u7531\u4E8E\u5409\u9686\u5761\u673A\u573A\u56FD\u9645\u4E2D\u8F6C\u533A\u4E0D\u5177\u5907\u65B0\u51A0\u6838\u9178\u68C0\u6D4B\u6761\u4EF6\uFF0C\u81EA\u7B2C\u4E09\u56FD\u7ECF\u5409\u9686\u5761\u673A\u573A\u003Cstrong\u003E\u4E0D\u5165\u5883\u76F4\u63A5\u4E2D\u8F6C\u003C/strong\u003E\u8D74\u534E\u4EBA\u5458\uFF0C\u9A7B\u9A6C\u4F7F\u9886\u9986\u4E0D\u53D7\u7406\u5176\u5065\u5EB7\u7801\u7533\u8BF7\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u4E8C\u3001\u6CE8\u610F\u4E8B\u9879\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\uFF08\u4E00\uFF09\u672C\u89C4\u8303\u7CFB\u6839\u636E\u76EE\u524D\u75AB\u60C5\u5F62\u52BF\u3001\u65B0\u51A0\u75C5\u6BD2\u53D8\u5F02\u7279\u70B9\u7B49\u56E0\u7D20\u5236\u5B9A\u3002\u4ECA\u540E\u6211\u9986\u5C06\u6839\u636E\u75AB\u60C5\u5F62\u52BF\u53D8\u5316\u5BF9\u6709\u5173\u63AA\u65BD\u52A8\u6001\u66F4\u65B0\u3002\u003C/p\u003E\n\u003Cp\u003E\uFF08\u4E8C\uFF09\u8FD1\u671F\u6570\u540D\u81EA\u9A6C\u8D74\u534E\u4E58\u5BA2\u5165\u5883\u540E\u88AB\u786E\u5B9A\u4E3A\u8F93\u5165\u75C5\u4F8B\uFF08\u591A\u7CFB\u5728\u673A\u573A\u68C0\u6D4B\u540E\u5802\u98DF\u6216\u98DE\u673A\u4E0A\u5C31\u9910\u7B49\u60C5\u51B5\u4E0B\u6458\u53E3\u7F69\u65F6\u88AB\u611F\u67D3\uFF09\u5E76\u5BFC\u81F4\u591A\u4E2A\u822A\u73ED\u7194\u65AD\uFF0C\u8BF7\u8D74\u534E\u4E58\u5BA2\u9AD8\u5EA6\u91CD\u89C6\u5965\u5BC6\u514B\u620E\u53D8\u5F02\u6BD2\u682A\u7684\u4F20\u64AD\u6027\u548C\u5371\u5BB3\u6027\uFF0C\u52A1\u5FC5\u505A\u597D\u884C\u524D\u81EA\u6211\u9632\u62A4\u53CA\u81EA\u6211\u5065\u5EB7\u76D1\u6D4B\uFF0C\u5728\u5B8C\u6210\u68C0\u6D4B\u524D\u540E\u3001\u5728\u5916\u7559\u5BBF\u671F\u95F4\u3001\u524D\u5F80\u673A\u573A\u8DEF\u9014\u3001\u7B49\u5019\u503C\u673A\u548C\u98DE\u884C\u8FC7\u7A0B\u7B49\u5168\u6D41\u7A0B\u4E2D\uFF0C\u003Cstrong\u003E\u5747\u8981\u6234\u597D\u53E3\u7F69\u3001\u505A\u597D\u5B89\u5168\u9632\u62A4\u003C/strong\u003E\uFF0C\u907F\u514D\u56E0\u767B\u673A\u524D\u68C0\u6D4B\u9633\u6027\u9020\u6210\u6EDE\u7559\u6216\u5165\u5883\u540E\u5E26\u6765\u8F93\u5165\u98CE\u9669\u3002\u003C/p\u003E\n\u003Cp\u003E\uFF08\u4E09\uFF09\u8BF7\u8BA4\u771F\u9605\u8BFB\u672C\u901A\u77E5\uFF0C\u5BF9\u7167\u81EA\u8EAB\u60C5\u51B5\u9884\u505A\u5145\u5206\u51C6\u5907\u3002\u5982\u6765\u4E0D\u53CA\u505A\u68C0\u6D4B\u5E76\u53D6\u5F97\u8BC1\u660E\uFF0C\u6682\u4E0D\u7B26\u767B\u673A\u6761\u4EF6\uFF0C\u8BF7\u8C03\u6574\u884C\u7A0B\u8BA1\u5212\u3002\u003C/p\u003E\n\u003Cp\u003E\uFF08\u56DB\uFF09\u6838\u9178\u68C0\u6D4B\u987B\u91C7\u7528\u9F3B\u54BD\u62ED\u5B50\uFF08Nasopharyngeal Swab\uFF09\u65B9\u5F0F\u91C7\u6837\uFF0C\u4EE5RT-PCR\u65B9\u5F0F\u68C0\u6D4B\u3002\u9A6C\u6765\u897F\u4E9A\u5408\u6CD5\u68C0\u6D4B\u673A\u6784\u51FA\u5177\u7684\u003Cstrong\u003E\u542B\u53EF\u67E5\u9A8C\u771F\u4F2A\u4E8C\u7EF4\u7801\u003C/strong\u003E\u7684\u6838\u9178\u68C0\u6D4B\u8BC1\u660E\u5747\u53EF\u63A5\u53D7\uFF08\u6837\u5F0F\u89C1\u9644\u4EF6\uFF09\uFF0C\u8BF7\u6240\u6709\u8D74\u534E\u4EBA\u5458\u52A1\u5FC5\u63D0\u4EA4\u6E05\u6670\u5B8C\u6574\u542B\u53EF\u67E5\u9A8C\u771F\u4F2A\u4E8C\u7EF4\u7801\u7684\u7535\u5B50\u7248\u68C0\u6D4B\u8BC1\u660E\uFF0C\u4EE5\u4FBF\u4F7F\u9886\u9986\u626B\u7801\u6838\u67E5\u771F\u4F2A\uFF0C\u5C3D\u5FEB\u590D\u6838\u901A\u8FC7\u3002\u4E3A\u65B9\u4FBF\u5E7F\u5927\u7533\u8BF7\u8005\uFF0C\u63A8\u8350\u68C0\u6D4B\u673A\u6784\u4FE1\u606F\u8BF7\u89C1\u9644\u4EF6\u3002\u003C/p\u003E\n\u003Cp\u003E\uFF08\u4E94\uFF09\u9886\u53D6\u68C0\u6D4B\u8BC1\u660E\u65F6\uFF0C\u8BF7\u6CE8\u610F\u68C0\u67E5\u8BC1\u660E\u662F\u5426\u542B\u6709\u53EF\u67E5\u9A8C\u771F\u4F2A\u7684\u4E8C\u7EF4\u7801\uFF0C\u5E76\u73B0\u573A\u6838\u5BF9\u59D3\u540D\u3001\u62A4\u7167\u53F7\u3001\u51FA\u751F\u65E5\u671F\u3001\u91C7\u6837\u65E5\u671F\u7B49\u4FE1\u606F\uFF0C\u5982\u6709\u8BEF\u5E94\u53CA\u65F6\u8981\u6C42\u66F4\u6B63\u3002\u003C/p\u003E\n\u003Cp\u003E\uFF08\u516D\uFF09\u9A7B\u9A6C\u4F7F\u9886\u9986\u5BA1\u6838\u5065\u5EB7\u7801\u65F6\u95F4\u4E3A\u822A\u73ED\u524D\u4E00\u59299:00-21:00\uFF08\u542B\u8282\u5047\u65E5\uFF09\u3002\u8BF7\u8D74\u534E\u4E58\u5BA2\u4E8E\u822A\u73ED\u524D\u4E00\u592920\u65F6\u524D\u7533\u8BF7\u300220\u65F6\u4EE5\u540E\u63D0\u4EA4\u7684\u6750\u6599\uFF08\u542B\u8865\u5145\u6750\u6599\uFF09\uFF0C\u539F\u5219\u4E