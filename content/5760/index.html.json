  "route": "/5760/",
  "title": "\u9A6C\u6765\u897F\u4E9A\u9A7B\u534E\u5927\u4F7F\u9986\u6559\u80B2\u5904",
  "summary": "\u201C\u672A\u6765\u4EBA\u5DE5\u667A\u80FD\u9A71\u52A8\u7684\u89C6\u89C9\u4FE1\u606F\u5B66\u201D\u8FD9\u4E00\u4E3B\u9898\u5904\u4E8E\u5168\u7403\u79D1\u6280\u53D1\u5C55\u7684\u6838\u5FC3\u3002\u81EA 2009 \u5E74\u4EE5\u6765\uFF0CIVIC \u5728\u957F\u8FBE\u5341\u4E94\u5E74\u7684\u65F6\u95F4\u91CC\u59CB\u7EC8\u53D1\u6325\u7740\u5173\u952E\u6865\u6881\u4F5C\u7528\uFF0C\u8FDE\u63A5\u5168\u7403\u82F1\u624D\u3001\u4FC3\u8FDB\u8DE8\u5B66\u79D1\u5BF9\u8BDD\uFF0C\u5E76\u5C55\u793A\u4ECE\u9AD8\u7EF4\u6570\u636E\u5206\u6790\u5230\u667A\u80FD\u4EBA\u673A\u4EA4\u4E92\u7B49\u9886\u57DF\u7684\u524D\u6CBF\u7814\u7A76\u6210\u679C\u3002 \u5728\u672C\u6B21\u6D3B\u52A8\u4E2D\uFF0C\u9A6C\u6765\u897F\u4E9A\u56FD\u7ACB\u5927\u5B66\uFF08UKM\uFF09\u6B63\u5F0F\u542F\u52A8\u4E86\u201C\u7814\u7A76\u751F\u4EBA\u624D\u53D1\u5C55\u534F\u540C\u7814\u7A76\u4E2D\u5FC3\u201D\uFF0C\u8FD9\u662F\u5DE9\u56FA\u4E2D\u9A6C\u9AD8\u7B49\u6559\u80B2\u5408\u4F5C\u7684\u53C8\u4E00\u91CD\u8981\u4E3E\u63AA\u3002 \u9274\u4E8E\u9752\u5E74\u7814\u7A76\u8005\u7684\u79D1\u7814\u4E4B\u8DEF\u65E2\u5173\u952E\u53C8\u5145\u6EE1\u6311\u6218\uFF0C\u4E2D\u5FC3\u671F\u671B\u901A\u8FC7\u63D0\u4F9B\u4E00\u4E2A\u4E16\u754C\u7EA7\u3001\u652F\u6301\u6027\u5F3A\u4E14\u5BCC\u6709\u5B66\u672F\u6D3B\u529B\u7684\u73AF\u5883\uFF0C\u8BA9\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2025/11/image-12-1024x682.jpg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u201C\u672A\u6765\u4EBA\u5DE5\u667A\u80FD\u9A71\u52A8\u7684\u89C6\u89C9\u4FE1\u606F\u5B66\u201D\u8FD9\u4E00\u4E3B\u9898\u5904\u4E8E\u5168\u7403\u79D1\u6280\u53D1\u5C55\u7684\u6838\u5FC3\u3002\u81EA 2009 \u5E74\u4EE5\u6765\uFF0CIVIC \u5728\u957F\u8FBE\u5341\u4E94\u5E74\u7684\u65F6\u95F4\u91CC\u59CB\u7EC8\u53D1\u6325\u7740\u5173\u952E\u6865\u6881\u4F5C\u7528\uFF0C\u8FDE\u63A5\u5168\u7403\u82F1\u624D\u3001\u4FC3\u8FDB\u8DE8\u5B66\u79D1\u5BF9\u8BDD\uFF0C\u5E76\u5C55\u793A\u4ECE\u9AD8\u7EF4\u6570\u636E\u5206\u6790\u5230\u667A\u80FD\u4EBA\u673A\u4EA4\u4E92\u7B49\u9886\u57DF\u7684\u524D\u6CBF\u7814\u7A76\u6210\u679C\u3002\u003C/p\u003E\n\u003Cp\u003E\u5728\u672C\u6B21\u6D3B\u52A8\u4E2D\uFF0C\u9A6C\u6765\u897F\u4E9A\u56FD\u7ACB\u5927\u5B66\uFF08UKM\uFF09\u6B63\u5F0F\u542F\u52A8\u4E86\u201C\u7814\u7A76\u751F\u4EBA\u624D\u53D1\u5C55\u534F\u540C\u7814\u7A76\u4E2D\u5FC3\u201D\uFF0C\u8FD9\u662F\u5DE9\u56FA\u4E2D\u9A6C\u9AD8\u7B49\u6559\u80B2\u5408\u4F5C\u7684\u53C8\u4E00\u91CD\u8981\u4E3E\u63AA\u3002\u003C/p\u003E\n\u003Cp\u003E\u9274\u4E8E\u9752\u5E74\u7814\u7A76\u8005\u7684\u79D1\u7814\u4E4B\u8DEF\u65E2\u5173\u952E\u53C8\u5145\u6EE1\u6311\u6218\uFF0C\u4E2D\u5FC3\u671F\u671B\u901A\u8FC7\u63D0\u4F9B\u4E00\u4E2A\u4E16\u754C\u7EA7\u3001\u652F\u6301\u6027\u5F3A\u4E14\u5BCC\u6709\u5B66\u672F\u6D3B\u529B\u7684\u73AF\u5883\uFF0C\u8BA9\u7814\u7A76\u751F\u548C\u535A\u58EB\u540E\u7814\u7A76\u4EBA\u5458\u80FD\u591F\u5F00\u5C55\u5BCC\u6709\u96C4\u5FC3\u4E0E\u63A2\u7D22\u7CBE\u795E\u7684\u79D1\u7814\u5DE5\u4F5C\uFF0C\u4ECE\u800C\u4FC3\u8FDB\u5353\u8D8A\u4EBA\u624D\u7684\u6210\u957F\u3002\u003C/p\u003E\n\u003Cp\u003E\u8BE5\u4E2D\u5FC3\u4E5F\u8C61\u5F81\u7740 UKM \u5BF9\u57F9\u517B\u672A\u6765\u89C6\u89C9\u4FE1\u606F\u5B66\u9886\u57DF\u9886\u519B\u4EBA\u624D\u7684\u957F\u671F\u627F\u8BFA\uFF0C\u65E8\u5728\u6253\u9020\u6210\u4E3A\u4EBA\u624D\u6C47\u805A\u7684\u521B\u65B0\u9AD8\u5730\uFF0C\u5438\u5F15\u6765\u81EA\u9A6C\u6765\u897F\u4E9A\u53CA\u5168\u7403\u7684\u6770\u51FA\u9752\u5E74\u5B66\u8005\uFF0C\u5E76\u6210\u4E3A\u56FD\u5BB6\u77E5\u8BC6\u578B\u7ECF\u6D4E\u7684\u91CD\u8981\u57FA\u77F3\u3002\u003C/p\u003E\n\u003Cp\u003E\u6B64\u5916\uFF0CUKM \u4E0E\u5408\u4F5C\u4F19\u4F34\u7B7E\u7F72\u5E76\u4EA4\u6362\u4E86\u4E94\u4EFD\u5408\u4F5C\u610F\u5411\u4E66\uFF0C\u8FDB\u4E00\u6B65\u63A8\u52A8\u5728\u5B66\u751F\u6D41\u52A8\u3001\u6559\u5E08\u4E92\u8BBF\u4EE5\u53CA\u8054\u5408\u79D1\u7814\u9879\u76EE\u7B49\u65B9\u9762\u7684\u5408\u4F5C\u6269\u5C55\u4E0E\u6DF1\u5316\u3002\u003C/p\u003E\n\u003Cp\u003E#StudyinMalaysia\u003C/p\u003E\n\u003Cp\u003E#EducationMalaysia4UResearch\u003C/p\u003E\n\u003Cp\u003E#EMB2Work2Engage2Facilitate\u003C/p\u003E\n\u003Cp\u003E\u003Ca href=\u0022https://mp.weixin.qq.com/s?__biz=MzkwNjEwNTA3OA%3D%3D\u0026amp;mid=2247498897\u0026amp;idx=1\u0026amp;sn=eba42a8f5e8a4a365b9b839d65af7822\u0026amp;chksm=c1a2738dea8c4fa6904251936621fe85f3072b1e4ad0664086f5387481d0d753a23c7d0caa1b\u0026amp;forbs=1\u0026amp;scene=126\u0026amp;subscene=91\u0026amp;sessionid=1763775478\u0026amp;flutter_pos=1\u0026amp;clicktime=1763775936\u0026amp;enterid=1763775936\u0026amp;finder_biz_enter_id=5\u0026amp;jumppath=20020_1763775689278%2CWebViewStubProxyUI_1763775689883%2C20020_1763775689993%2C50094_1763775916856\u0026amp;jumppathdepth=4\u0026amp;ascene=56\u0026amp;fasttmpl_type=4\u0026amp;fasttmpl_fullversion=8007211-zh_CN-zip\u0026amp;fasttmpl_flag=0\u0026amp;realreporttime=1763775936038\u0026amp;devicetype=android-36\u0026amp;version=28003e41\u0026amp;nettype=WIFI\u0026amp;abtest_cookie=AAACAA%3D%3D\u0026amp;lang=zh_CN\u0026amp;session_us=gh_08002b6879e2\u0026amp;countrycode=MY\u0026amp;exportkey=n_ChQIAhIQNRujXbTppTmTI5fxaXN6lBLoAQIE97dBBAEAAAAAAI8FCIEKGDkAAAAOpnltbLcz9gKNyK89dVj0CEI0%2BFQjjQ5n%2BuYdYsrYxgCjpiuoDqIRLLuSCtnacqqkT4qg9qb0eiwWVJHFmjJaJKpnjn2Z%2B%2FeNy79kEuB4ye3IhmAgiH0qdJ3r9kmkLgo1Bn%2BDc%2Fh6ahqJ11bkDASmN1a