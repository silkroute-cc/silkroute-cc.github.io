  "route": "/5371/",
  "title": "Cypark\u8D44\u6E90\u4E0E\u767B\u5DDE\u8054\u624B \u5F00\u53D1\u6DF7\u5408\u53D1\u7535\u5382",
  "summary": "\uFF08\u5409\u9686\u57616\u65E5\u8BAF\uFF09Cypark\u8D44\u6E90\uFF08CYPARK\uFF0C5184\uFF0C\u4E3B\u677F\u5DE5\u4E1A\u80A1\uFF09\u4E0E\u767B\u5609\u697C\u5DDE\u653F\u5E9C\u516C\u53F8\u8054\u624B\uFF0C\u5728\u80AF\u9038\u6E56\u5F00\u53D1\u6DF7\u5408\u6C34\u529B\u6D6E\u52A8\u592A\u9633\u80FD\u53D1\u7535\u5382\u3002 \u8BE5\u516C\u53F8\u53D1\u6587\u544A\u6307\u51FA\uFF0C\u4E0E\u767B\u5DDE\u653F\u5E9C\u6218\u7565\u6295\u8D44\u81C2\u8180\u7B7E\u7F72\u5408\u4F5C\u534F\u8BAE\uFF0C\u5171\u540C\u5F00\u53D1500\u5146\u74E6\u6DF7\u5408\u53D1\u7535\u5382\u3002 \u636E\u4E86\u89E3\uFF0C\u56FD\u5BB6\u80FD\u6E90\uFF08TENAGA\uFF0C5347\uFF0C\u4E3B\u677F\u516C\u7528\u4E8B\u4E1A\u80A1\uFF09\u65D7\u4E0B\u53D1\u7535\u4E1A\u52A1\u81C2\u8180\u2014\u2014TNB\u53D1\u7535\u79C1\u4EBA\u6709\u9650\u516C\u53F8\uFF08\u7B80\u79F0\u4E3ATNB Genco\uFF09\uFF0C\u5C06\u8D1F\u8D23\u8BBE\u8BA1\u3001\u5EFA\u7B51\u548C\u8425\u8FD0\u8BE5\u7535\u5382\uFF0C\u8FDB\u4E00\u6B65\u5C55\u793A\u5927\u9A6C\u5728\u7EFF\u8272\u80FD\u6E90\u521B\u65B0\u65B9\u9762\u7684\u9886\u5BFC\u5730\u4F4D\u3002 Cypark\u8D44\u6E90\u6267\u884C\u4E3B\u5E2D\u62FF\u7763\u4E9A\u7F8E\u83AB\u91CC\u2026",
  "body": "\u003Cp\u003E\uFF08\u5409\u9686\u57616\u65E5\u8BAF\uFF09Cypark\u8D44\u6E90\uFF08CYPARK\uFF0C5184\uFF0C\u4E3B\u677F\u5DE5\u4E1A\u80A1\uFF09\u4E0E\u767B\u5609\u697C\u5DDE\u653F\u5E9C\u516C\u53F8\u8054\u624B\uFF0C\u5728\u80AF\u9038\u6E56\u5F00\u53D1\u6DF7\u5408\u6C34\u529B\u6D6E\u52A8\u592A\u9633\u80FD\u53D1\u7535\u5382\u3002\u003C/p\u003E\n\u003Cp\u003E\u8BE5\u516C\u53F8\u53D1\u6587\u544A\u6307\u51FA\uFF0C\u4E0E\u767B\u5DDE\u653F\u5E9C\u6218\u7565\u6295\u8D44\u81C2\u8180\u7B7E\u7F72\u5408\u4F5C\u534F\u8BAE\uFF0C\u5171\u540C\u5F00\u53D1500\u5146\u74E6\u6DF7\u5408\u53D1\u7535\u5382\u3002\u003C/p\u003E\n\u003Cp\u003E\u636E\u4E86\u89E3\uFF0C\u56FD\u5BB6\u80FD\u6E90\uFF08TENAGA\uFF0C5347\uFF0C\u4E3B\u677F\u516C\u7528\u4E8B\u4E1A\u80A1\uFF09\u65D7\u4E0B\u53D1\u7535\u4E1A\u52A1\u81C2\u8180\u2014\u2014TNB\u53D1\u7535\u79C1\u4EBA\u6709\u9650\u516C\u53F8\uFF08\u7B80\u79F0\u4E3ATNB Genco\uFF09\uFF0C\u5C06\u8D1F\u8D23\u8BBE\u8BA1\u3001\u5EFA\u7B51\u548C\u8425\u8FD0\u8BE5\u7535\u5382\uFF0C\u8FDB\u4E00\u6B65\u5C55\u793A\u5927\u9A6C\u5728\u7EFF\u8272\u80FD\u6E90\u521B\u65B0\u65B9\u9762\u7684\u9886\u5BFC\u5730\u4F4D\u3002\u003C/p\u003E\n\u003Cp\u003ECypark\u8D44\u6E90\u6267\u884C\u4E3B\u5E2D\u62FF\u7763\u4E9A\u7F8E\u83AB\u91CC\u65AF\u8868\u793A\uFF0C\u6709\u5173\u9879\u76EE\u80FD\u534F\u52A9\u63A8\u8FDB\u6C38\u7EED\u80FD\u6E90\uFF0C\u4E14\u901A\u8FC7\u81EA\u8EAB\u7ECF\u9A8C\u4E0E\u767B\u5DDE\u6218\u7565\u613F\u666F\u76F8\u7ED3\u5408\uFF0C\u80FD\u4E3A\u6C38\u7EED\u53D1\u5C55\u5236\u5B9A\u5F3A\u800C\u6709\u529B\u7684\u5927\u84DD\u56FE\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u80AF\u9038\u6E56\u62E5\u6709\u72EC\u7279\u7684\u751F\u6001\u7CFB\u7EDF\u548C\u5DE8\u5927\u6F5C\u529B\uFF0C\u4E3A\u8FD9\u4E00\u521B\u4E3E\u63D0\u4F9B\u4E86\u7406\u60F3\u7684\u73AF\u5883\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u6709\u5173\u9879\u76EE\u9884\u8BA1\u5C06\u57282025\u5E74\u52A8\u5DE5\uFF0C\u91C7\u7528\u6DF7\u5408\u6C34\u7535\u548C\u6D6E\u52A8\u592A\u773C\u80FD\u5149\u4F0F\u6280\u672F\uFF0C\u540C\u65F6\u4E5F\u4F1A\u521B\u9020\u66F4\u591A\u5C31\u4E1A\u673A\u4F1A\u3002\u003C/p\u003E\n\u003Cp\u003E\u767B\u5609\u697C\u516C\u53F8\u603B\u88C1\u517C\u603B\u6267\u884C\u957F\u5E03\u54C8\u52AA\u4E01\uFF0C\u4E5F\u501F\u6B64\u5F3A\u8C03\u6709\u5173\u9879\u76EE\u7684\u91CD\u8981\u6027\uFF0C\u540C\u65F6\u4E5F\u4F1A\u81F4\u529B\u4E8E\u8D1F\u8D23\u4EFB\u5730\u5229\u7528\u767B\u5609\u697C\u7684\u81EA\u7136\u8D44\u672C\uFF0C\u4EE5\u53CA\u63A8\u52A8\u8BE5\u5DDE\u548C\u56FD\u5BB6\u7684\u5305\u5BB9\u6027\u548C\u6C38\u7EED\u53D1\u5C55\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/XaAiBI3qFBQxh2mw-uiOYA\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
