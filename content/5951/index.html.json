  "title": "\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u7EC4\u7EC7\u9A6C\u5370\u65C5\u884C\u5546\u8D74\u7518\u8083\u8E29\u7EBF\u8003\u5BDF \u6DF1\u5316\u4E1D\u8DEF\u6587\u65C5\u4EA4\u6D41\u5408\u4F5C",
  "summary": "\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u7EC4\u7EC7\u9A6C\u6765\u897F\u4E9A\u3001\u5370\u5EA6\u5C3C\u897F\u4E9A20\u5BB6\u65C5\u884C\u793E\u4EE3\u8868\u8D74\u7518\u8083\uFF0C\u53C2\u52A02026\u7518\u8083\u5165\u5883\u6E38\u56FD\u9645\u65C5\u884C\u5546\u5927\u4F1A\uFF0C\u5E76\u8D74\u5F20\u6396\u3001\u5609\u5CEA\u5173\u3001\u6566\u714C\u3001\u4E34\u590F\u7B49\u5730\u5B9E\u5730\u8003\u5BDF\u3002\u5927\u4F1A\u4EE5\u0022\u7518\u8083\uFF0C\u4E1D\u7EF8\u4E4B\u8DEF\u4E0A\u7684\u5947\u8FF9\u0022\u4E3A\u4E3B\u9898\uFF0C\u63A8\u52A8\u4E2D\u56FD\u897F\u5317\u4E0E\u4E1C\u5357\u4E9A\u65C5\u6E38\u4E1A\u754C\u52A1\u5B9E\u4EA4\u6D41\u4E0E\u8D44\u6E90\u5BF9\u63A5\u3002",
  "body": "\u003Cimg src=\u0022https://mmbiz.qpic.cn/sz_mmbiz_jpg/KpBbR2xoyyr3LCmfc00MDGGoroBee7ibOibA0SxxMVictkr75WEICE8e2p6wKYHtsYl3Aga80xuUjUnF2xZdL4N1ljrdSl8GT3UdREN1J57JZ4/640?wx_fmt=jpeg\u0026amp;from=appmsg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E4\u670820\u65E5\u81F328\u65E5\uFF0C\u5409\u9686\u5761\u4E2D\u56FD\u6587\u5316\u4E2D\u5FC3\u7EC4\u7EC7\u9A6C\u6765\u897F\u4E9A\u3001\u5370\u5EA6\u5C3C\u897F\u4E9A\u65C5\u884C\u5546\u8D70\u8FDB\u7518\u8083\uFF0C\u53C2\u52A0\u7531\u7518\u8083\u7701\u6587\u5316\u548C\u65C5\u6E38\u5385\u4E3B\u529E\u76842026\u7518\u8083\u5165\u5883\u6E38\u56FD\u9645\u65C5\u884C\u5546\u5927\u4F1A\u3002\u4F1A\u540E\u8D74\u5F20\u6396\u3001\u5609\u5CEA\u5173\u3001\u6566\u714C\u3001\u4E34\u590F\u56DE\u65CF\u81EA\u6CBB\u5DDE\u5F00\u5C55\u6587\u65C5\u8D44\u6E90\u5B9E\u5730\u8E29\u7EBF\u8003\u5BDF\u3002\u003C/p\u003E\n\u003Cp\u003E\u672C\u6B21\u6D3B\u52A8\u5171\u6709\u9A6C\u3001\u5370\u5C3C4\u5BB6\u65C5\u6E38\u673A\u6784\u65D7\u4E0B20\u5BB6\u91CD\u70B9\u65C5\u884C\u793E\u4EE3\u8868\uFF0C\u4EE5\u53CA\u661F\u6D32\u65E5\u62A5\u5A92\u4F53\u4EE3\u8868\u7B4923\u4EBA\u53C2\u4F1A\u53C2\u8BBF\u3002\u6D3B\u52A8\u91C7\u7528\u201C\u53C2\u4F1A\u002B\u8E29\u7EBF\u201D\u6A21\u5F0F\uFF0C\u8BA9\u53C2\u4F1A\u4EBA\u5458\u5168\u65B9\u4F4D\u611F\u77E5\u7518\u8083\u5E95\u8574\u6DF1\u539A\u3001\u7279\u8272\u9C9C\u660E\u7684\u6587\u65C5\u7980\u8D4B\uFF0C\u63A8\u52A8\u4E2D\u56FD\u897F\u5317\u4E0E\u4E1C\u5357\u4E9A\u65C5\u6E38\u4E1A\u754C\u52A1\u5B9E\u4EA4\u6D41\u3001\u8D44\u6E90\u7CBE\u51C6\u5BF9\u63A5\uFF0C\u4E3A\u62D3\u5BBD\u7518\u8083\u5165\u5883\u5BA2\u6E90\u5E02\u573A\u3001\u6DF1\u5316\u8DE8\u533A\u57DF\u6587\u65C5\u5408\u4F5C\u642D\u5EFA\u5E73\u53F0\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/mmbiz_jpg/KpBbR2xoyypXh4AW0ibNMSibianaCpeSwJiaxnYHAHXhJ8wd9bC0WLC2sb2cw7Ta5YXlgsSS0QP4FW2nVJa6gu13sc6TibOg01q4FdMrLzfHowcg/640?wx_fmt=jpeg\u0026amp;from=appmsg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u672C\u5C4A\u5927\u4F1A\u4EE5\u201C\u7518\u8083\uFF0C\u4E1D\u7EF8\u4E4B\u8DEF\u4E0A\u7684\u5947\u8FF9\u201D\u4E3A\u4E3B\u9898\uFF0C\u81F4\u529B\u4E8E\u642D\u5EFA\u56FD\u9645\u6587\u65C5\u4EA4\u6D41\u5408\u4F5C\u6865\u6881\uFF0C\u63A8\u52A8\u5883\u5185\u5916\u6587\u65C5\u8D44\u6E90\u6DF1\u5EA6\u5BF9\u63A5\uFF0C\u62D3\u5BBD\u56FD\u9645\u8425\u9500\u6E20\u9053\uFF0C\u4F18\u5316\u8D44\u6E90\u914D\u7F6E\uFF0C\u52A9\u529B\u6587\u65C5\u4EA7\u54C1\u521B\u65B0\u5347\u7EA7\u3002\u5927\u4F1A\u73B0\u573A\uFF0C\u9A6C\u6765\u897F\u4E9A\u534E\u4EBA\u65C5\u6E38\u4E1A\u516C\u4F1A\u3001\u5370\u5EA6\u5C3C\u897F\u4E9A\u65C5\u884C\u793E\u534F\u4F1A\uFF08ASTINDO\uFF09\u4EE3\u8868\u4EE5\u201C\u5916\u56FD\u65C5\u884C\u5546\u770B\u7518\u8083\u201D\u4E3A\u4E3B\u9898\u4F5C\u5206\u4EAB\uFF0C\u4ECE\u4E1C\u5357\u4E9A\u6E38\u5BA2\u504F\u597D\u3001\u4EA7\u54C1\u9002\u914D\u6253\u9020\u3001\u6D77\u5916\u5E02\u573A\u63A8\u5E7F\u7B49\u7EF4\u5EA6\u5EFA\u8A00\u732E\u7B56\uFF0C\u4E3A\u7518\u8083\u5165\u5883\u65C5\u6E38\u9AD8\u8D28\u91CF\u53D1\u5C55\u63D0\u4F9B\u53C2\u8003\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://mmbiz.qpic.cn/sz_mmbiz_jpg/KpBbR2xoyyobImvruFe2fZxAert5OVibCkjx6dqia42l2Zofacm1v1O14MMBYibPbFjW2ic8H8CATJOl6EiajXPaFxF9HicvYib2O8CfzUSMllyjuM/640?wx_fmt=jpeg\u0026amp;from=appmsg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5728\u5165\u5883\u6E38\u91C7\u8D2D\u6D3D\u8C08\u73AF\u8282\uFF0C\u5883\u5916\u65C5\u884C\u5546\u4E0E\u7518\u8083\u672C\u571F\u6587\u65C5\u4F01\u4E1A\uFF0C\u56F4\u7ED5\u666F\u533A\u8054\u52A8\u3001\u9152\u5E97\u4F4F\u5BBF\u3001\u4EA4\u901A\u63A5\u9A73\u3001\u7814\u5B66\u65C5\u884C\u3001\u81EA\u9A7E\u670D\u52A1\u3001\u975E\u9057\u4F53\u9A8C\u3001\u7968\u52A1\u8054\u91C7\u3001\u8DE8\u533A\u57DF\u7EBF\u8DEF\u6574\u5408\u53CA\u6D77\u5916\u5BA3\u63A8\u7B49\u9886\u57DF\u6DF1\u5165\u6D3D\u8C08\uFF0C\u8FBE\u6210\u591A\u9879\u5408\u4F5C\u610F\u5411\uFF0C\u4E3A\u540E\u7EED\u7EBF\u8DEF\u4EA7\u54C1\u843D\u5730\u3001\u5BA2\u6E90\u4E92\u9001\u53CA\u5E02\u573A\u5E38\u6001\u5316\u5408\u4F5C\u7B51\u7262\u57FA\u7840\u3002\u003C/p\u