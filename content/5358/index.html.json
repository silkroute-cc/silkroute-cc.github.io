  "canonicalUrlKey": "%e4%b8%9c%e5%8d%97%e4%ba%9a6%e5%9b%bd%e4%b8%ad%e6%8e%92%e7%ac%ac%e5%9b%9b-%e5%a4%a7%e9%a9%ac%e6%98%8e%e5%b9%b4%e9%a2%84%e6%9c%9f%e6%b6%a8%e8%96%aa5",
  "route": "/5358/",
  "title": "\u4E1C\u5357\u4E9A6\u56FD\u4E2D\u6392\u7B2C\u56DB \u5927\u9A6C\u660E\u5E74\u9884\u671F\u6DA8\u85AA5%",
  "summary": "\uFF08\u5409\u9686\u576125\u65E5\u8BAF\uFF09\u4EBA\u624D\u4F9B\u9700\u5DEE\u5F02\u3001\u96C7\u4E3B\u589E\u8058\u66F4\u591A\u5458\u5DE5\u5E26\u52A8\uFF0C\u660E\u5E74\u4E1C\u5357\u4E9A6\u56FD\u85AA\u8D44\u9884\u6D4B\u7686\u770B\u6DA8\uFF0C\u5927\u9A6C\u4EE55%\u6DA8\u5E45\u6392\u540D\u7B2C\u56DB\uFF0C\u8D85\u8D8A\u6CF0\u56FD\u53CA\u65B0\u52A0\u5761\u3002 \u670D\u52A1\u516C\u53F8\u6021\u5B89\uFF08Aon\uFF0911\u6708\u62A5\u544A\u663E\u793A\uFF0C\u660E\u5E74\u7684\u4E1C\u5357\u4E9A\u85AA\u8D44\u4E0A\u8C03\u9884\u6D4B\uFF0C\u8D8A\u5357\u589E\u5E45\u6700\u9AD8\uFF0C\u8FBE6.7%\uFF0C\u63A5\u7740\u662F\u5370\u5C3C\uFF086.3%\uFF09 \u3001\u83F2\u5F8B\u5BBE\uFF085.8%\uFF09\u3001\u5927\u9A6C\u5219\u662F5%\uFF0C\u6CF0\u56FD\u548C\u65B0\u52A0\u5761\u5219\u4F4E\u4E8E5%\uFF0C\u5206\u522B\u5904\u4E8E4.7%\u53CA4.4%\u6C34\u5E73\u3002 \u62A5\u544A\u8BF4\uFF0C\u8BE5\u533A\u57DF\u4F01\u4E1A\u53EF\u80FD\u4F1A\u7EF4\u6301\u6216\u589E\u52A0\u5176\u52B3\u52A8\u529B\u603B\u6570\u3002 \u6839\u636E\u300ACNBC\u300B\uFF0C\u6021\u5B89\u5408\u4F19\u4EBA\u517C\u4EBA\u624D\u4E3B\u7BA1\u67E5\u74E6\u62C9\u8868\u793A\uFF0C\u9884\u8BA1\u660E\u5E74\u7684\u85AA\u8D44\u589E\u957F\u7387\u4ECD\u9AD8\u4E8E\u4ECA\u5E74\u2026",
  "body": "\u003Cp\u003E\uFF08\u5409\u9686\u576125\u65E5\u8BAF\uFF09\u4EBA\u624D\u4F9B\u9700\u5DEE\u5F02\u3001\u96C7\u4E3B\u589E\u8058\u66F4\u591A\u5458\u5DE5\u5E26\u52A8\uFF0C\u660E\u5E74\u4E1C\u5357\u4E9A6\u56FD\u85AA\u8D44\u9884\u6D4B\u7686\u770B\u6DA8\uFF0C\u5927\u9A6C\u4EE55%\u6DA8\u5E45\u6392\u540D\u7B2C\u56DB\uFF0C\u8D85\u8D8A\u6CF0\u56FD\u53CA\u65B0\u52A0\u5761\u3002\u003C/p\u003E\n\u003Cp\u003E\u670D\u52A1\u516C\u53F8\u6021\u5B89\uFF08Aon\uFF0911\u6708\u62A5\u544A\u663E\u793A\uFF0C\u660E\u5E74\u7684\u4E1C\u5357\u4E9A\u85AA\u8D44\u4E0A\u8C03\u9884\u6D4B\uFF0C\u8D8A\u5357\u589E\u5E45\u6700\u9AD8\uFF0C\u8FBE6.7%\uFF0C\u63A5\u7740\u662F\u5370\u5C3C\uFF086.3%\uFF09 \u3001\u83F2\u5F8B\u5BBE\uFF085.8%\uFF09\u3001\u5927\u9A6C\u5219\u662F5%\uFF0C\u6CF0\u56FD\u548C\u65B0\u52A0\u5761\u5219\u4F4E\u4E8E5%\uFF0C\u5206\u522B\u5904\u4E8E4.7%\u53CA4.4%\u6C34\u5E73\u3002\u003C/p\u003E\n\u003Cp\u003E\u62A5\u544A\u8BF4\uFF0C\u8BE5\u533A\u57DF\u4F01\u4E1A\u53EF\u80FD\u4F1A\u7EF4\u6301\u6216\u589E\u52A0\u5176\u52B3\u52A8\u529B\u603B\u6570\u3002\u003C/p\u003E\n\u003Cp\u003E\u6839\u636E\u300ACNBC\u300B\uFF0C\u6021\u5B89\u5408\u4F19\u4EBA\u517C\u4EBA\u624D\u4E3B\u7BA1\u67E5\u74E6\u62C9\u8868\u793A\uFF0C\u9884\u8BA1\u660E\u5E74\u7684\u85AA\u8D44\u589E\u957F\u7387\u4ECD\u9AD8\u4E8E\u4ECA\u5E74\uFF0C\u672A\u6765\u901A\u80C0\u7387\u5C06\u964D\u4F4E\u3001\u5229\u7387\u4E5F\u8F83\u4F4E\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u901A\u80C0\u964D\u4F4E\uFF0C\u4F46\u85AA\u8D44\u4E0A\u6DA8\u4ECD\u5728\u52A0\u5267\uFF0C\u8FD9\u610F\u5473\u7740\uFF0C\u4EBA\u624D\u4F9B\u9700\u5DEE\u5F02\u8D85\u51FA\u4E86\u901A\u80C0\u8303\u56F4\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u539F\u56E0\u4E4B\u4E00\u662F\u8BE5\u533A\u57DF\u5BF9\u6280\u672F\u4EBA\u624D\u9AD8\u9700\u6C42\u6240\u81F4\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u4E1C\u5357\u4E9A\u4E00\u76F4\u662F\u8BB8\u591A\u79D1\u6280\u516C\u53F8\uFF08\u4F8B\u5982\u65B0\u52A0\u5761\uFF09\u5F00\u8BBE\u5546\u5E97\u7684\u6C99\u76D2\u73AF\u5883\uFF0C\u5438\u5F15\u8D44\u672C\u5E76\u521B\u9020\u4EBA\u624D\u9700\u6C42\uFF0C\u8FDB\u800C\u63A8\u52A8\u85AA\u8D44\u589E\u957F\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u9AD8\u6280\u672F\u5236\u9020\u6DA8\u85AA\u6700\u591A\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u62A5\u544A\u79F0\uFF0C\u4E1C\u5357\u4E9A\u5404\u9886\u57DF\u7684\u85AA\u8D44\u589E\u5E45\u5404\u5F02\uFF0C\u5176\u4E2D\u6280\u672F\u548C\u5236\u9020\u9884\u7B97\u589E\u5E45\u6700\u9AD8\uFF0C\u8FBE5.8%\u3002\u96F6\u552E\u3001\u8C18\u8BE2\u3001\u5546\u4E1A\u4E0E\u793E\u533A\u670D\u52A1\u3001\u751F\u547D\u79D1\u5B66\u4EE5\u53CA\u533B\u7597\u8BBE\u5907\u9884\u8BA1\u5C06\u589E\u957F 5.4%\u3002\u003C/p\u003E\n\u003Cp\u003E\u6DA8\u5E45\u8F83\u5C11\u884C\u4E1A\u662F\u80FD\u6E90\uFF084.9%\uFF09\u3001\u91D1\u878D\u670D\u52A1\uFF084.8%\uFF09\u548C\u4EA4\u901A\u8FD0\u8F93\uFF084.1%\uFF09\u3002\u003C/p\u003E\n\u003Cp\u003E\u67E5\u74E6\u62C9\u8868\u793A\uFF0C\u65B0\u52A0\u5761\u7684\u85AA\u8D44\u589E\u957F\u901A\u5E38\u843D\u540E\u4E8E\u4E1C\u5357\u4E9A\u5176\u4ED6\u5E02\u573A\uFF0C\u4E3B\u8981\u662F\u8BE5\u56FD\u5C5E\u5DF2\u5F00\u53D1\u5E02\u573A\uFF0C\u4E0E\u5176\u4ED6\u6210\u957F\u8F83\u5FEB\u7684\u56FD\u5BB6\u76F8\u6BD4\uFF0C\u901A\u80C0\u5F80\u5F80\u8F83\u4F4E\u3002\u003C/p\u003E\n\u003Cp\u003E\u6B64\u5916\uFF0C\u65B0\u52A0\u5761\u7684\u7ECF\u6D4E\u589E\u957F\u7387\u4E5F\u4F4E\u4E8E\u672C\u533A\u57DF\u5176\u4ED6\u56FD\u5BB6\uFF0C\u5BFC\u81F4\u9884\u7B97\u5DE5\u8D44\u589E\u5E45\u8F83\u5C0F\u3002\u003C/p\u003E\n\u003Cp\u003E\u6B64\u5916\uFF0C\u8C03\u67E5\u4E5F\u8BF4\uFF0C\u672A\u80FD\u5438\u5F15\u548C\u7559\u4F4F\u9876\u5C16\u4EBA\u624D\uFF0C\u5DF2\u6210\u4E3A\u4E9A\u592A\u5730\u533A\u7EC4\u7EC7\u7684\u4E3B\u8981\u98CE\u9669\uFF0C\u4ECE2021\u5E74\u7684\u7B2C9\u5927\u98CE\u9669\u4E0A\u5347\u5230\u53BB\u5E74\u7684\u7B2C4\u5927\u98CE\u9669\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5927\u9A6C\u85AA\u8D44\u6DA8\u5E45\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E2023\u5E74\u5B9E\u9645\u6DA8\u5E45-5%\u003C/p\u003E\n\u003Cp\u003E2024\u5E74\u5B9E\u9645\u6DA8\u5E45-4.9%\u003C/p\u003E\n\u003Cp\u003E2025\u5E74\u9884\u6D4B\u6DA8\u5E45-5%\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/Yho7QK9iwcZXaKLu4L4loQ\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
