  "route": "/4144/",
  "title": "\u5927\u9A6C\u5929\u7136\u6C14\u660E\u5E74\u5EFA2\u751F\u7269\u7532\u70F7\u5382 \u672A\u6765\u8BA1\u5212\u5EFA700\u81F3800\u516C\u91CC\u5929\u7136\u6C14\u7BA1\u9053",
  "summary": "\uFF08\u5409\u9686\u57618\u65E5\u8BAF\uFF09\u5927\u9A6C\u5929\u7136\u6C14\uFF08GASMSIA\uFF0C5209\uFF0C \u4E3B\u677F\u516C\u7528\u4E8B\u4E1A\u80A1\uFF09\u8FDB\u519B\u751F\u7269\u80FD\u6E90\u9886\u57DF\uFF0C\u8BA1\u5212\u660E\u5E74\u4E0A\u534A\u5E74\u524D\uFF0C\u8425\u8FD0\u53E6\u5916\u4E24\u5EA7\u751F\u7269\u7532\u70F7\u5DE5\u5382\uFF0C\u5E76\u5C06\u5176\u6CE8\u5165\u5929\u7136\u6C14\u5206\u914D\u7CFB\u7EDF\uFF08NGDS\uFF09\u3002 \u8BE5\u516C\u53F8\u603B\u6267\u884C\u957F\u963F\u83AB\u54C8\u897F\u7C73\uFF0C\u5728\u5927\u9A6C\u5929\u7136\u6C14\u6C38\u7EED\u8BA1\u5212\u63A8\u4ECB\u793C\u4E0A\u8868\u793A\uFF0C\u6BCF\u4E00\u5EA7\u5DE5\u5382\u7684\u5EFA\u8BBE\uFF0C\u5C06\u4F1A\u5206\u914D1500\u4E07\u81F32000\u4E07\u4EE4\u5409\u7684\u8425\u8FD0\u5F00\u9500\u3002 \u201C\u6211\u4EEC\u5C06\u5728\u660E\u5E74\u4E0A\u534A\u5E74\u8425\u8FD0\u5EA7\u5DE5\u5382\uFF0C\u5F80\u540E\u6BCF\u5E74\u4E5F\u5C06\u7AD9\u70B9\u52A0\u500D\uFF0C\u901A\u8FC7\u7AD9\u70B9\uFF0C\u6211\u4EEC\u53EF\u63D0\u53D6\u751F\u7269\u7532\u70F7\uFF0C\u6E05\u6D01\u5904\u7406\u540E\u91CD\u65B0\u6CE8\u5165\u7BA1\u9053\u7CFB\u7EDF\uFF0C\u751A\u81F3\u53EF\u4EE5\u4EA4\u4ED8\u7ED9\u5C45\u4F4F\u5728\u5F53\u5730\u7684\u5BA2\u6237\u3002\u201D \u5F53\u524D\uFF0C\u8BE5\u516C\u53F8\u5DF2\u4E0E\u67D4\u2026",
  "body": "\u003Cp\u003E\uFF08\u5409\u9686\u57618\u65E5\u8BAF\uFF09\u5927\u9A6C\u5929\u7136\u6C14\uFF08GASMSIA\uFF0C5209\uFF0C \u4E3B\u677F\u516C\u7528\u4E8B\u4E1A\u80A1\uFF09\u8FDB\u519B\u751F\u7269\u80FD\u6E90\u9886\u57DF\uFF0C\u8BA1\u5212\u660E\u5E74\u4E0A\u534A\u5E74\u524D\uFF0C\u8425\u8FD0\u53E6\u5916\u4E24\u5EA7\u751F\u7269\u7532\u70F7\u5DE5\u5382\uFF0C\u5E76\u5C06\u5176\u6CE8\u5165\u5929\u7136\u6C14\u5206\u914D\u7CFB\u7EDF\uFF08NGDS\uFF09\u3002\u003C/p\u003E\n\u003Cp\u003E\u8BE5\u516C\u53F8\u603B\u6267\u884C\u957F\u963F\u83AB\u54C8\u897F\u7C73\uFF0C\u5728\u5927\u9A6C\u5929\u7136\u6C14\u6C38\u7EED\u8BA1\u5212\u63A8\u4ECB\u793C\u4E0A\u8868\u793A\uFF0C\u6BCF\u4E00\u5EA7\u5DE5\u5382\u7684\u5EFA\u8BBE\uFF0C\u5C06\u4F1A\u5206\u914D1500\u4E07\u81F32000\u4E07\u4EE4\u5409\u7684\u8425\u8FD0\u5F00\u9500\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u4EEC\u5C06\u5728\u660E\u5E74\u4E0A\u534A\u5E74\u8425\u8FD0\u5EA7\u5DE5\u5382\uFF0C\u5F80\u540E\u6BCF\u5E74\u4E5F\u5C06\u7AD9\u70B9\u52A0\u500D\uFF0C\u901A\u8FC7\u7AD9\u70B9\uFF0C\u6211\u4EEC\u53EF\u63D0\u53D6\u751F\u7269\u7532\u70F7\uFF0C\u6E05\u6D01\u5904\u7406\u540E\u91CD\u65B0\u6CE8\u5165\u7BA1\u9053\u7CFB\u7EDF\uFF0C\u751A\u81F3\u53EF\u4EE5\u4EA4\u4ED8\u7ED9\u5C45\u4F4F\u5728\u5F53\u5730\u7684\u5BA2\u6237\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u5F53\u524D\uFF0C\u8BE5\u516C\u53F8\u5DF2\u4E0E\u67D4\u4F5B\u4E24\u5BB6\u68D5\u6CB9\u5382\u7B7E\u8BA2\u8D2D\u6C14\u5408\u7EA6\uFF0C\u5411\u8FD9\u4E24\u5EA7\u5DE5\u5382\u8D2D\u4E70\u751F\u7269\u6C14\u4F53\u3002\u4ECA\u5E746\u6708\uFF0C\u67D4\u4F5B\u58EB\u4E43\u7684\u751F\u7269\u7532\u70F7\u5382\u5DF2\u6B63\u5F0F\u5546\u4E1A\u5316\u8FD0\u8425\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u4EEC\u76F8\u4FE1\u81EA\u5DF1\u662F\u751F\u7269\u7532\u70F7\u9886\u57DF\u7684\u5148\u950B\uFF0C\u4E5F\u613F\u610F\u6301\u7EED\u63A8\u5E7F\u8FD9\u79CD\u5E72\u51C0\u80FD\u6E90\u3002\u6211\u4EEC\u5C06\u4F1A\u4E0E\u653F\u5E9C\u63A5\u6D3D\uFF0C\u786E\u4FDD\u62E5\u6709\u6765\u81EA\u653F\u5E9C\u7684\u8DB3\u591F\u652F\u6301\u3002\u201C\u003C/p\u003E\n\u003Cp\u003E\u53E6\u5916\uFF0C\u4ED6\u8868\u793A\u8BE5\u516C\u53F8\u4E5F\u8BA1\u52125\u5E74\u5185\uFF0C\u65A5\u8D4412\u4EBF\u81F314\u4EBF\u4EE4\u5409\uFF0C\u518D\u5174\u5EFA\u4E00\u6761700\u81F3800\u516C\u91CC\u4E4B\u95F4\u7684\u5929\u7136\u6C14\u7BA1\u9053\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u4E5F\u5F3A\u8C03\uFF0C\u8FC7\u53BB30\u5E74\u5927\u9A6C\u5929\u7136\u6C14\u7684NGDS\u7F51\u7EDC\uFF0C\u5728\u534A\u5C9B\u5DF2\u5EFA\u957F\u8FBE2800\u516C\u91CC\u7684\u5929\u7136\u6C14\u7BA1\u9053\uFF0C\u670D\u52A1\u8D85\u8FC72\u4E074000\u4E2A\u5DE5\u4E1A\u3001\u5546\u4E1A\u3001\u4F4F\u5B85\u5BA2\u6237\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/UPodCl_Y4uCemAcnU3pN4g\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
