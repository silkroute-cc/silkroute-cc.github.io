{
  "id": "%e9%83%91%e7%ab%8b%e6%85%b7%e7%8e%87%e5%9b%a2%e8%ae%bf%e4%b8%ad%e5%9b%bd%e3%80%80%e4%b8%a4%e5%9b%bd%e7%94%b5%e5%ad%90%e7%a7%91%e6%8a%80%e7%a0%94%e7%a9%b6%e9%99%a2%e7%ad%be%e7%bd%b2mou",
  "slug": "%e9%83%91%e7%ab%8b%e6%85%b7%e7%8e%87%e5%9b%a2%e8%ae%bf%e4%b8%ad%e5%9b%bd%e3%80%80%e4%b8%a4%e5%9b%bd%e7%94%b5%e5%ad%90%e7%a7%91%e6%8a%80%e7%a0%94%e7%a9%b6%e9%99%a2%e7%ad%be%e7%bd%b2mou",
  "canonicalUrlKey": "%e9%83%91%e7%ab%8b%e6%85%b7%e7%8e%87%e5%9b%a2%e8%ae%bf%e4%b8%ad%e5%9b%bd%e3%80%80%e4%b8%a4%e5%9b%bd%e7%94%b5%e5%ad%90%e7%a7%91%e6%8a%80%e7%a0%94%e7%a9%b6%e9%99%a2%e7%ad%be%e7%bd%b2mou",
