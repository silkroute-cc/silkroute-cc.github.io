{
  "id": "%e4%b8%ad%e5%9b%bd%e5%8d%b0%e5%ba%a6%e6%b8%b8%e5%ae%a2%e6%9d%a5%e9%a9%ac-%e8%90%bd%e5%9c%b0%e7%ad%be%e8%af%81%e7%a8%8b%e5%ba%8f%e7%ae%80%e5%8c%96-%e5%bc%a0%e5%ba%86%e4%bf%a1%ef%bc%9a%e4%ba%89",
  "slug": "%e4%b8%ad%e5%9b%bd%e5%8d%b0%e5%ba%a6%e6%b8%b8%e5%ae%a2%e6%9d%a5%e9%a9%ac-%e8%90%bd%e5%9c%b0%e7%ad%be%e8%af%81%e7%a8%8b%e5%ba%8f%e7%ae%80%e5%8c%96-%e5%bc%a0%e5%ba%86%e4%bf%a1%ef%bc%9a%e4%ba%89",
  "canonicalUrlKey": "%e4%b8%ad%e5%9b%bd%e5%8d%b0%e5%ba%a6%e6%b8%b8%e5%ae%a2%e6%9d%a5%e9%a9%ac-%e8%90%bd%e5%9c%b0%e7%ad%be%e8%af%81%e7%a8%8b%e5%ba%8f%e7%ae%80%e5%8c%96-%e5%bc%a0%e5%ba%86%e4%bf%a1%ef%bc%9a%e4%ba%89",
  "route": "/4157/",
  "title": "\u4E2D\u56FD\u5370\u5EA6\u6E38\u5BA2\u6765\u9A6C \u843D\u5730\u7B7E\u8BC1\u7A0B\u5E8F\u7B80\u5316  \u5F20\u5E86\u4FE1\uFF1A\u4E89\u53D6\u514D\u5305\u673A",
  "summary": "\uFF08\u516B\u6253\u7075\u518D\u4E5F6\u65E5\u8BAF\uFF09\u65C5\u6E38\u3001\u827A\u672F\u53CA\u6587\u5316\u90E8\u957F\u62FF\u7763\u65AF\u91CC\u5F20\u5E86\u4FE1\u6307\u51FA\uFF0C\u81EA\u4ECA\u5E7410\u670815\u65E5\u5F00\u59CB\uFF0C\u6301\u666E\u901A\u62A4\u7167\u7684\u4E2D\u56FD\u4E0E\u5370\u5EA6\u6E38\u5BA2\u524D\u6765\u9A6C\u6765\u897F\u4E9A\u65F6\uFF0C\u53EF\u529E\u7406\u505C\u755915\u5929\u7684\u843D\u5730\u7B7E\u8BC1\u3002 \u4ED6\u8BF4\uFF0C\u521D\u6B65\u843D\u5B9E\u7684\u9636\u6BB5\u5148\u4ECE\u5305\u5BA2\u673A\u7684\u65B9\u5F0F\u8FDB\u884C\uFF0C\u5E76\u7B80\u5316\u4E86\u7533\u8BF7\u7A0B\u5E8F\u3002 \u201C\u6E38\u5BA2\u5728\u8FD8\u6CA1\u62B5\u9A6C\u4E4B\u524D\uFF0C\u53EF\u5148\u5448\u4E0A\u56FD\u9645\u62A4\u7167\uFF0C\u5E76\u4E8E\u79FB\u6C11\u5C40\u7CFB\u7EDF\u5185\u8F93\u5165\u4E2A\u4EBA\u8D44\u6599\u3002\u4E00\u65E6\u62B5\u8FBE\u540E\uFF0C\u5C31\u53EF\u5728\u5409\u9686\u5761\u56FD\u9645\u673A\u573A\u7684\u7279\u522B\u5173\u5361\uFF0C\u4EAB\u6709\u8FD9\u9879\u843D\u5730\u7B7E\u8BC1\u7684\u4FBF\u5229\u3002\u201D \u5F20\u5E86\u4FE1\u4ECA\u65E5\u5728\u8138\u4E66\u53D1\u6587\u8BF4\uFF0C\u65C5\u6E38\u90E8\u4F1A\u6301\u7EED\u4E0E\u5185\u653F\u90E8\u5546\u8BAE\uFF0C\u4EE5\u4FBF\u4E89\u53D6\u6269\u5927\u8FD9\u9879\u843D\u5730\u7B7E\u8BC1\u63AA\u65BD\u7684\u6DB5\u76D6\u8303\u56F4\u3002 \u201C\u5180\u671B\u5C3D\u901F\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/11/frc-38405db053f0c08c3e5dfbf717d7b15a.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\uFF08\u516B\u6253\u7075\u518D\u4E5F6\u65E5\u8BAF\uFF09\u65C5\u6E38\u3001\u827A\u672F\u53CA\u6587\u5316\u90E8\u957F\u62FF\u7763\u65AF\u91CC\u5F20\u5E86\u4FE1\u6307\u51FA\uFF0C\u81EA\u4ECA\u5E7410\u670815\u65E5\u5F00\u59CB\uFF0C\u6301\u666E\u901A\u62A4\u7167\u7684\u4E2D\u56FD\u4E0E\u5370\u5EA6\u6E38\u5BA2\u524D\u6765\u9A6C\u6765\u897F\u4E9A\u65F6\uFF0C\u53EF\u529E\u7406\u505C\u755915\u5929\u7684\u843D\u5730\u7B7E\u8BC1\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u521D\u6B65\u843D\u5B9E\u7684\u9636\u6BB5\u5148\u4ECE\u5305\u5BA2\u673A\u7684\u65B9\u5F0F\u8FDB\u884C\uFF0C\u5E76\u7B80\u5316\u4E86\u7533\u8BF7\u7A0B\u5E8F\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6E38\u5BA2\u5728\u8FD8\u6CA1\u62B5\u9A6C\u4E4B\u524D\uFF0C\u53EF\u5148\u5448\u4E0A\u56FD\u9645\u62A4\u7167\uFF0C\u5E76\u4E8E\u79FB\u6C11\u5C40\u7CFB\u7EDF\u5185\u8F93\u5165\u4E2A\u4EBA\u8D44\u6599\u3002\u4E00\u65E6\u62B5\u8FBE\u540E\uFF0C\u5C31\u53EF\u5728\u5409\u9686\u5761\u56FD\u9645\u673A\u573A\u7684\u7279\u522B\u5173\u5361\uFF0C\u4EAB\u6709\u8FD9\u9879\u843D\u5730\u7B7E\u8BC1\u7684\u4FBF\u5229\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u5F20\u5E86\u4FE1\u4ECA\u65E5\u5728\u8138\u4E66\u53D1\u6587\u8BF4\uFF0C\u65C5\u6E38\u90E8\u4F1A\u6301\u7EED\u4E0E\u5185\u653F\u90E8\u5546\u8BAE\uFF0C\u4EE5\u4FBF\u4E89\u53D6\u6269\u5927\u8FD9\u9879\u843D\u5730\u7B7E\u8BC1\u63AA\u65BD\u7684\u6DB5\u76D6\u8303\u56F4\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u5180\u671B\u5C3D\u901F\u5C06\u843D\u5B9E\u8303\u56F4\u6269\u5927\u81F3\u975E\u5305\u5BA2\u673A\u6E38\u5BA2\u4E5F\u80FD\u7533\u8BF7\u8FD9\u9879\u7B7E\u8BC1\u4FBF\u5229\uFF0C\u8BA9\u5165\u5883\u7A0B\u5E8F\u66F4\u4E3A\u901A\u7545\uFF0C\u56E0\u6B64\u5180\u671B\u660E\u5E741\u6708\u5185\u653F\u90E8\u53EF\u634E\u6765\u597D\u6D88\u606F\uFF0C\u6301\u7EED\u516C\u5E03\u66F4\u591A\u65B0\u7684\u4FBF\u5229\u63AA\u65BD\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u65C5\u6E38\u90E8\u6B64\u524D\u7D27\u5BC6\u4E0E\u5185\u653F\u90E8\u5C5E\u4E0B\u79FB\u6C11\u5C40\u534F\u5546\u6C9F\u901A\uFF0C\u81F4\u529B\u900F\u8FC7\u76F8\u5BF9\u53CB\u5584\u4E14\u4E25\u8C28\u7684\u5165\u5883\u548C\u7B7E\u8BC1\u5236\u5EA6\uFF0C\u63D0\u9AD8\u5168\u7403\u65C5\u5BA2\u9009\u62E9\u5230\u6211\u56FD\u89C2\u5149\u7684\u610F\u613F\uFF0C\u5E76\u4E14\u4FC3\u8FDB\u4E2D\u5370\u6E38\u5BA2\u548C\u6295\u8D44\u8005\u8FDB\u5165\u5927\u9A6C\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u63D0\u53CA\uFF0C\u9996\u76F8\u517C\u8D22\u653F\u90E8\u957F\u62FF\u7763\u65AF\u91CC\u5B89\u534E\u65E9\u524D\u5728\u56FD\u4F1A\u4E0B\u8BAE\u9662\u63D0\u54482024\u5E74\u8D22\u653F\u9884\u7B97\u6848\u65F6\u5BA3\u5E03\uFF0C\u653F\u5E9C\u5C06\u7B80\u5316\u843D\u5730\u7B7E\u8BC1\u3001\u793E\u4EA4\u8BBF\u95EE\u901A\u884C\u8BC1(PLS)\u53CA\u591A\u6B21\u5165\u5883\u7B7E\u8BC1\u7684\u4F18\u60E0\uFF0C\u4EE5\u9F13\u52B1\u66F4\u591A\u6E38\u5BA2\u53CA\u6295\u8D44\u6D8C\u5165\uFF0C\u7279\u522B\u662F\u6765\u81EA\u4E2D\u5370\u7684\u6E38\u5BA2\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6700\u521D\uFF0C\u843D\u5730\u7B7E\u8BC1\u4EC5\u9002\u7528\u4E8E\u7ECF\u7531\u65B0\u52A0\u5761\u3001\u6CF0\u56FD\u3001\u5370\u5C3C\u548C\u6587\u83B1\u7B49\u7B2C\u4E09\u56FD\u5165\u5883\u5927\u9A6C\u7684\u4E2D\u56FD\u548C\u5370\u5EA6\u516C\u6C11\uFF0C\u524D\u63D0\u662F\u4ED6\u4EEC\u6301\u6709\u76F8\u5173\u56FD\u5BB6\u7684\u6709\u6548\u7B7E\u8BC1\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u5728\u7ECF\u8FC7\u4E86\u7D27\u5BC6\u7684\u8BA8\u8BBA\u534F\u5546\u540E\uFF0C\u5185\u653F\u90E8\u7A0D\u65E9\u524D\u5DF2\u6B63\u5F0F\u53D1\u51FA\u6B63\u5F0F\u901A\u77E5\uFF0C\u5373\u5173\u4E8E\u4E2D\u56FD\u548C\u5370\u5EA6\u516C\u6C11\u7684\u66F4\u65B0\u7248\u843D\u5730\u7B7E\u8BC1\u6761\u4EF6\u3002\u201D\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/11/frc-8d2ae9d25cd1530ff1f82cb64cec0b0c.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Ch2\u003E\u003Cstrong\u003E\u5185\u653F\u90E8\u6700\u65B0\u516C\u5E03\u7684\u4E2D\u56FD\u548C\u5370\u5EA6\u516C\u6C11\u843D\u5730\u7B7E\u8BC1\u6761\u4EF6\u003C/strong\u003E\u003C/h2\u003E\n\u003Cp\u003E1\uFE0F.\u4E2D\u56FD\u548C\u5370\u5EA6\u516C\u6C11\u53EF\u901A\u8FC7\u6CE8\u518C\u4E8E\u5927\u9A6C\u65C5\u6E38\u3001\u827A\u672F\u53CA\u6587\u5316\u90E8\u7684\u65C5\u884C\u793E\u7533\u8BF7\u843D\u5730\u7B7E\u8BC1\uFF08VOA)\uFF0C\u4EC5\u9650\u4E8E\u642D\u4E58\u5305\u673A\u76F4\u98DE\u81F3\u5927\u9A6C\u3002\n2.\u65C5\u884C\u793E\u6709\u8D23\u4EFB\u786E\u4FDD\u4E58\u5750\u5305\u673A\u76F4\u98DE\u7684\u5165\u5883\u65C5\u5BA2\u5728\u9650\u5B9A\u7684\u671F\u9650\u5185\u79BB\u5883\u3002\n3.\u65C5\u884C\u793E\u5FC5\u987B\u786E\u4FDD\u4E58\u5750\u4ECE\u4E2D\u56FD\u548C\u5370\u5EA6\u98DE\u5F80\u5927\u9A6C\u7684\u5305\u673A\u76F4\u822A\u7684\u6E38\u5BA2\u63D0\u524D\u63D0\u4EA4\u4ED6\u4EEC\u7684\u65C5\u884C\u6587\u4EF6\u548C\u62B5\u8FBE\u540D\u5355\uFF0C\u4EE5\u4F9B\u5927\u9A6C\u79FB\u6C11\u5C40\u5BA1\u6838\u548C\u5165\u5883\u534F\u8C03\u3002\n4.\u4E3A\u786E\u4FDD\u5728\u5927\u9A6C\u505C\u7559\u4E0D\u8D85\u8FC715\u5929\uFF0C\u6E38\u5BA2\u5FC5\u987B\u63D0\u4F9B\u8FD4\u7A0B\u673A\u7968\u548C\u6574\u4E2A\u505C\u7559\u671F\u95F4\u7684\u9152\u5E97\u9884\u8BA2\u8BC1\u660E\u3002\n5.\u843D\u5730\u7B7E\u8BC1\u7533\u8BF7\u53D7\u73B0\u6709\u6761\u6B3E\u548C\u6761\u4EF6\u7EA6\u675F\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/11/frc-ee56e9a680834c99fd274b22baf72f02.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Ch2\u003E\u003Cstrong\u003E\u7535\u5B50\u843D\u5730\u7B7E\u8BC1\uFF08\u0026#119838;\u0026#119829;\u0026#119822;\u0026#119808;\uFF09\u7533\u8BF7\u548C\u5BA1\u6838\u6D41\u7A0B\u003C/strong\u003E\u003C/h2\u003E\n\u003Cp\u003E1\uFE0F. MOTAC\u6CE8\u518C\u7684\u65C5\u884C\u793E\uFF0C\u5FC5\u987B\u786E\u4FDD\u6E38\u5BA2\u5728\u5165\u5883\u5927\u9A6C\u524D\uFF0C\u81F3\u5C11\u63D0\u524D10\u5929\uFF0C\u901A\u8FC7eVOA\u94FE\u63A5\u63D0\u4EA4\u5728\u7EBF\u7533\u8BF7\u3002\n2\uFE0F. \u5728eVOA\u7CFB\u7EDF\u4E2D\u6CE8\u518C\u7684\u65C5\u884C\u793E\u5C06\u9700\u8981\u5728\u5355\u6B21\u7533\u8BF7\u4E2D\u5B8C\u6210\u548C\u66F4\u65B0\u6700\u591A10\u4EFD\u7533\u8BF7\u7684\u652F\u6301\u6587\u4EF6\u3002\n3\uFE0F. \u9A8C\u8BC1\u548C\u6279\u51C6\u5C06\u5728\u63D0\u4EA4\u7533\u8BF7\u540E\u76845\u5929\u5185\u8FDB\u884C\u5904\u7406;\n4\uFE0F. \u7533\u8BF7\u88AB\u6279\u51C6\u540E\uFF0C\u65C5\u884C\u793E\u5FC5\u987B\u5728\u5165\u5883\u65E5\u671F\u524D\u81F3\u5C113\u5929\u5B8C\u6210\u8D39\u7528\u652F\u4ED8\u3002\u6BCF\u4F4D\u6E38\u5BA2\u7684\u8D39\u7528\u4E3A200\u4EE4\u5409\u3002\n5. \u7533\u8BF7\u72B6\u6001\u53EF\u901A\u8FC7eVOA\u94FE\u63A5\u67E5\u8BE2\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/RZDJzmLJmS6wVzuf7H1TBQ\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
