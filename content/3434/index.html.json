  "route": "/3434/",
  "title": "\u67D4\u5DDE\u653F\u5E9C\u4FC3\u4E2D\u592E\u653F\u5E9C \u63A8\u884C\u67D4\u4F5B\u7B2C\u4E8C\u5BB6\u56ED\u8BA1\u5212",
  "summary": "\uFF08\u65B0\u5C7131\u65E5\u8BAF\uFF09\u67D4\u4F5B\u5DDE\u653F\u5E9C\u5E0C\u671B\u4E2D\u592E\u653F\u5E9C\u8003\u8651\u63A8\u884C\u201C\u67D4\u4F5B-\u6211\u7684\u7B2C\u4E8C\u5BB6\u56ED\u8BA1\u5212\u201D(JM2H)\u3002 \u638C\u7BA1\u67D4\u5DDE\u623F\u5C4B\u53CA\u5730\u65B9\u653F\u5E9C\u4E8B\u52A1\u7684\u884C\u653F\u8BAE\u5458\u62FF\u7763\u5609\u798F\u5C3C\u8BF4\uFF0C\u67D4\u4F5B\u5DDE\u52A1\u5927\u81E3\u62FF\u7763\u7FC1\u54C8\u83F2\u5179\u6700\u8FD1\u4E0E\u5185\u653F\u90E8\u957F\u62FF\u7763\u65AF\u91CC\u8D5B\u5F17\u4E01\u4F1A\u6664\u65F6\uFF0C\u63D0\u51FA\u4E86\u8FD9\u9879\u5EFA\u8BAE\u3002 \u4ED6\u8BF4\uFF0C\u67D4\u5DDE\u653F\u5E9C\u5E0C\u671BJM2H\u53EF\u91C7\u75282018\u5E74\u4E2D\u592E\u653F\u5E9C\u653F\u6743\u66F4\u8FED\u4E4B\u524D\uFF0C\u9488\u5BF9\u9A6C\u6765\u897F\u4E9A\u6211\u7684\u7B2C\u4E8C\u5BB6\u56ED\u8BA1\u5212\uFF08MM2H\uFF09\u6240\u5236\u5B9A\u7684\u7533\u8BF7\u6761\u4EF6\u3002 \u4ED6\u4ECA\u65E5\u51FA\u5E2D\u201C\u5927\u65B0\u5C71\u8BAE\u7A0B\u201D4\u4E2A\u5730\u65B9\u653F\u5E9C\u4E0E\u67D4\u4F5B\u4E13\u4E1A\u534F\u4F1A(Decco\u002B)\u7B7E\u7F72\u4E86\u89E3\u5907\u5FD8\u5F55\u4EEA\u5F0F\u540E\uFF0C\u5411\u8BB0\u8005\u8FD9\u4E48\u8BF4\u3002 \u4ED6\u6307\u51FA\uFF0CMM2H\u6B64\u2026",
  "body": "\u003Cp\u003E\uFF08\u65B0\u5C7131\u65E5\u8BAF\uFF09\u67D4\u4F5B\u5DDE\u653F\u5E9C\u5E0C\u671B\u4E2D\u592E\u653F\u5E9C\u8003\u8651\u63A8\u884C\u201C\u67D4\u4F5B-\u6211\u7684\u7B2C\u4E8C\u5BB6\u56ED\u8BA1\u5212\u201D(JM2H)\u3002\u003C/p\u003E\n\u003Cp\u003E\u638C\u7BA1\u67D4\u5DDE\u623F\u5C4B\u53CA\u5730\u65B9\u653F\u5E9C\u4E8B\u52A1\u7684\u884C\u653F\u8BAE\u5458\u62FF\u7763\u5609\u798F\u5C3C\u8BF4\uFF0C\u67D4\u4F5B\u5DDE\u52A1\u5927\u81E3\u62FF\u7763\u7FC1\u54C8\u83F2\u5179\u6700\u8FD1\u4E0E\u5185\u653F\u90E8\u957F\u62FF\u7763\u65AF\u91CC\u8D5B\u5F17\u4E01\u4F1A\u6664\u65F6\uFF0C\u63D0\u51FA\u4E86\u8FD9\u9879\u5EFA\u8BAE\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u67D4\u5DDE\u653F\u5E9C\u5E0C\u671BJM2H\u53EF\u91C7\u75282018\u5E74\u4E2D\u592E\u653F\u5E9C\u653F\u6743\u66F4\u8FED\u4E4B\u524D\uFF0C\u9488\u5BF9\u9A6C\u6765\u897F\u4E9A\u6211\u7684\u7B2C\u4E8C\u5BB6\u56ED\u8BA1\u5212\uFF08MM2H\uFF09\u6240\u5236\u5B9A\u7684\u7533\u8BF7\u6761\u4EF6\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u4ECA\u65E5\u51FA\u5E2D\u201C\u5927\u65B0\u5C71\u8BAE\u7A0B\u201D4\u4E2A\u5730\u65B9\u653F\u5E9C\u4E0E\u67D4\u4F5B\u4E13\u4E1A\u534F\u4F1A(Decco\u002B)\u7B7E\u7F72\u4E86\u89E3\u5907\u5FD8\u5F55\u4EEA\u5F0F\u540E\uFF0C\u5411\u8BB0\u8005\u8FD9\u4E48\u8BF4\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u6307\u51FA\uFF0CMM2H\u6B64\u524D\u63D0\u9AD8\u7684\u65B0\u7533\u8BF7\u6761\u4EF6\u5305\u62EC\u7533\u8BF7\u8005\u987B\u62E5\u6709\u81F3\u5C11100\u4E07\u4EE4\u5409\u7684\u5B9A\u671F\u5B58\u6B3E\uFF0C\u4E0D\u8FC7\u90BB\u56FD\u5982\u83F2\u5F8B\u5BBE\u3001\u8D8A\u5357\u548C\u5370\u5C3C\u5E76\u6CA1\u6709\u8FD9\u4E48\u505A\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6B64\u5916\uFF0C\u65B0\u6761\u4EF6\u8FD8\u89C4\u5B9A\u7533\u8BF7\u8005\u987B\u5728\u67D4\u4F5B\u9017\u7559\u81F3\u5C113\u4E2A\u6708\u3002\u6211\u4EEC\u8981\u63A8\u9500\u623F\u4EA7\u548C\u5F15\u8FDB\u66F4\u591A\u5546\u4E1A\u6D3B\u52A8\uFF0C\u56E0\u6B64\u5E0C\u671B\u53EF\u4EE5\u66F4\u6709\u5F39\u6027\uFF0C\u6211\u4EEC\u5DF2\u5411\u8D5B\u5F17\u4E01\u63D0\u51FA\u53EF\u5141\u8BB8\u4F7F\u75282018\u5E74\u4E4B\u524D\u7684MM2H\u7533\u8BF7\u6761\u4EF6\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u76EE\u524D\uFF0C\u67D4\u5DDE50\u4E07\u4EE4\u5409\u4EE5\u4E0A\u7684\u623F\u4EA7\u9762\u5BF9\u6EDE\u9500\uFF0C\u5176\u4E2D\u516B\u6210\u662F\u670D\u52A1\u5F0F\u516C\u5BD3\u3002\u003C/p\u003E\n\u003Cp\u003EMM2H\u65E9\u524D\u56E0\u63D0\u9AD8\u7533\u8BF7\u6761\u4EF6\uFF0C\u53D7\u5230\u5404\u65B9\u6279\u8BC4\uFF0C\u5609\u798F\u5C3C\u5BF9\u6B64\u6307\u51FA\uFF0C\u82E5\u5EFA\u8BAE\u4E2D\u592E\u653F\u5E9C\u91CD\u65B0\u63A2\u8BA8\u653E\u5BBDMM2H\u6761\u4EF6\u7684\u63D0\u8BAE\u96BE\u4EE5\u6267\u884C\uFF0C\u4F55\u4E0D\u8003\u8651\u63A8\u51FA\u67D4\u4F5BJM2H\u7684\u7533\u8BF7\u95E8\u69DB\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u90E8\u957F\uFF08\u5728\u4F1A\u8BAE\uFF09\u8868\u793A\u8FD9\u5EFA\u8BAE\u9700\u8981\u4ED4\u7EC6\u63A2\u8BA8\uFF0C\u56E0\u4E3AMM2H\u6D89\u53CA\u5168\u56FD\uFF0C\u4F46\u6211\u4EEC\u53EA\u8981\u6C42\u6D89\u53CA\u67D4\u4F5B\u800C\u5DF2\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u8D22\u653F\u90E8\u524D\u526F\u90E8\u957F\u62FF\u7763\u83AB\u54C8\u672B\u6C99\u54C8\u5728\u53BB\u5E749\u6708\u6307\u51FA\uFF0C\u53BB\u5E74\u4E0A\u534A\u5E74\u6709\u8D85\u8FC73\u4E074000\u95F4\u603B\u503C217\u4EBF\u4EE4\u5409\u7684\u4F4F\u5B85\u6EDE\u9500\uFF0C\u5176\u4E2D\u8FD1\u516D\u6210\u4E3A\u516C\u5BD3\uFF0C\u623F\u4EF7\u8D85\u8FC750\u4E07\u4EE4\u5409\u7684\u4F4F\u5B85\u5355\u4F4D\u536043%\uFF0C\u5F53\u4E2D\uFF0C\u67D4\u4F5B\u6EDE\u9500\u623F\u4EA7\u5360\u5168\u56FD\u4E4B\u9996\u3002\u003C/p\u003E\n\u003Cp\u003E\n\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/-75CGzuQJWXEtBH0BgWqCA\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
