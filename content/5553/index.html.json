  "canonicalUrlKey": "%e6%b2%99%e5%b7%b4%e9%a6%96%e9%95%bf%ef%bc%9a%e6%8e%a8%e8%a1%8c%e6%95%b0%e9%a1%b9%e5%8f%91%e7%94%b5%e8%ae%a1%e5%88%92%e3%80%80%e7%9b%b8%e4%bf%a1%e6%9c%aa%e6%9d%a5%e6%b2%99%e5%b7%b4%e4%b8%8d%e5%86%8d",
  "route": "/5553/",
  "title": "\u6C99\u5DF4\u9996\u957F\uFF1A\u63A8\u884C\u6570\u9879\u53D1\u7535\u8BA1\u5212\u3000\u76F8\u4FE1\u672A\u6765\u6C99\u5DF4\u4E0D\u518D\u7F3A\u7535",
  "summary": "\uFF08\u4E9A\u5E8712\u65E5\u8BAF\uFF09\u6C99\u5DF4\u9996\u957F\u54C8\u829D\u829D\u5BA3\u5E03\uFF0C\u6C99\u80FD\u6E90\u7406\u4E8B\u4F1A\u901A\u8FC7\u5C06\u63A8\u884C\u6570\u4E2A\u4F9B\u7535\u91CF\u4E3A1000MW\u7684\u53D1\u7535\u8BA1\u5212\uFF0C\u4EE5\u63D0\u9AD8\u672C\u5DDE\u53D1\u7535\u91CF\u3002 \u4ED6\u76F8\u4FE1\uFF0C\u8FD9\u5C06\u4F1A\u63D0\u9AD8\u6C99\u5DF4\u5DDE\u7684\u4F9B\u7535\u91CF\uFF0C\u672A\u6765\u5C06\u4E0D\u4F1A\u518D\u7F3A\u7535\u3002 \u4ED6\u8BF4\uFF0C\u81EA\u4ECE\u5DDE\u653F\u5E9C\u53BB\u5E741\u6708\u4ECE\u8054\u90A6\u624B\u4E0A\u63A5\u7BA1\u6C99\u5DF4\u7535\u4F9B\u76D1\u7BA1\u6743\u540E\uFF0C\u5C31\u91C7\u53D6\u4E0A\u8FF0\u63AA\u65BD\u3002\u8FD91000MW\u4EA7\u7535\u91CF\u6765\u81EA\u6C34\u529B\u53D1\u7535\u3001\u592A\u9633\u80FD\u53CA\u98CE\u80FD\uFF0C\u5DDE\u653F\u5E9C\u5DF2\u548C\u6570\u5BB6\u672C\u5730\u4F9B\u7535\u516C\u53F8\u7B7E\u7F72\u5408\u540C\u3002 \u54C8\u829D\u829D\u662F\u5728\u6C99\u7535\u5F00\u658B\u6D3B\u52A8\u4E0A\u81F4\u8BCD\u65F6\u5982\u6B64\u8868\u793A\u3002\u5728\u573A\u8005\u5C1A\u6709\u6C99\u7535\u4E3B\u5E2D\u62FF\u7763\u5A01\u5F17\u70C8\u4E39\u6556\u53CA\u65C5\u6E38\u3001\u6587\u5316\u53CA\u73AF\u5883\u90E8\u52A9\u7406\u90E8\u957F\u62FF\u7763\u4F50\u5C3C\u65AF\u987F\u90A6\u594E\u3002\u9996\u957F\u8BF4\u82E5\u6240\u6709\u8BA1\u5212\u4E2D\u7684\u9879\u2026",
  "body": "\u003Cp\u003E\uFF08\u4E9A\u5E8712\u65E5\u8BAF\uFF09\u6C99\u5DF4\u9996\u957F\u54C8\u829D\u829D\u5BA3\u5E03\uFF0C\u6C99\u80FD\u6E90\u7406\u4E8B\u4F1A\u901A\u8FC7\u5C06\u63A8\u884C\u6570\u4E2A\u4F9B\u7535\u91CF\u4E3A1000MW\u7684\u53D1\u7535\u8BA1\u5212\uFF0C\u4EE5\u63D0\u9AD8\u672C\u5DDE\u53D1\u7535\u91CF\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u76F8\u4FE1\uFF0C\u8FD9\u5C06\u4F1A\u63D0\u9AD8\u6C99\u5DF4\u5DDE\u7684\u4F9B\u7535\u91CF\uFF0C\u672A\u6765\u5C06\u4E0D\u4F1A\u518D\u7F3A\u7535\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u81EA\u4ECE\u5DDE\u653F\u5E9C\u53BB\u5E741\u6708\u4ECE\u8054\u90A6\u624B\u4E0A\u63A5\u7BA1\u6C99\u5DF4\u7535\u4F9B\u76D1\u7BA1\u6743\u540E\uFF0C\u5C31\u91C7\u53D6\u4E0A\u8FF0\u63AA\u65BD\u3002\u8FD91000MW\u4EA7\u7535\u91CF\u6765\u81EA\u6C34\u529B\u53D1\u7535\u3001\u592A\u9633\u80FD\u53CA\u98CE\u80FD\uFF0C\u5DDE\u653F\u5E9C\u5DF2\u548C\u6570\u5BB6\u672C\u5730\u4F9B\u7535\u516C\u53F8\u7B7E\u7F72\u5408\u540C\u3002\u003C/p\u003E\n\u003Cp\u003E\u54C8\u829D\u829D\u662F\u5728\u6C99\u7535\u5F00\u658B\u6D3B\u52A8\u4E0A\u81F4\u8BCD\u65F6\u5982\u6B64\u8868\u793A\u3002\u5728\u573A\u8005\u5C1A\u6709\u6C99\u7535\u4E3B\u5E2D\u62FF\u7763\u5A01\u5F17\u70C8\u4E39\u6556\u53CA\u65C5\u6E38\u3001\u6587\u5316\u53CA\u73AF\u5883\u90E8\u52A9\u7406\u90E8\u957F\u62FF\u7763\u4F50\u5C3C\u65AF\u987F\u90A6\u594E\u3002\u9996\u957F\u8BF4\u82E5\u6240\u6709\u8BA1\u5212\u4E2D\u7684\u9879\u76EE\u90FD\u6210\u529F\u843D\u5B9E\uFF0C\u6C99\u5DF4\u7528\u6237\u672A\u67652\u81F33\u5E74\u5185\u4E0D\u5FC5\u518D\u9762\u5BF9\u65AD\u7535\u95EE\u9898\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u5373\u4F7F\u6C99\u5DF4\u73B0\u5728\u4E5F\u6709\u65AD\u7535\u95EE\u9898\uFF0C\u4F46\u60C5\u51B5\u6CA1\u6570\u5E74\u524D\u90A3\u4E48\u7CDF\uFF0C\u8FD9\u51E0\u5E74\u6765\u7535\u4F9B\u9700\u6C42\u5F88\u9AD8\uFF0C\u56E0\u4E3A\u6295\u8D44\u8005\u9700\u8981\u5F88\u5927\u7535\u4F9B\u91CF\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u5F88\u9AD8\u5174\u73B0\u4ECA\u6C99\u7535\u9886\u5BFC\u56E2\u961F\u6709\u80FD\u529B\u89E3\u51B3\u95EE\u9898\uFF0C\u73B0\u4ECA\u65AD\u7535\u4E0D\u518D\u5982\u5F80\u5E74\u822C\u9891\u7E41\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u6C99\u7535\u6240\u5B9E\u884C\u7535\u6C60\u80FD\u6E90\u50A8\u5B58\u7CFB\u7EDF\uFF08BESS\uFF09\u6709\u6548\u63D0\u5347\u6C99\u5DF4\u7684\u7535\u4F9B\u670D\u52A1\u3002\u6C34\u4F9B\u65B9\u9762\uFF0C\u9996\u957F\u91CD\u7533\uFF0C\u5DDE\u653F\u5E9C\u6709\u4FE1\u5FC3\u4ECA\u5E74\u53EF\u89E3\u51B3\u5DDE\u5185\u65AD\u6C34\u95EE\u9898\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u8054\u90A6\u653F\u5E9C\u65E9\u524D\u62E8\u4E0B\u76843\u4EBF\u4EE4\u5409\u62E8\u6B3E\uFF0C\u5982\u4ECA\u5DF2\u7528\u4E8E\u63D0\u5347\u5168\u5DDE\u6EE4\u6C34\u5382\u4EA7\u6C34\u91CF\u7684\u7528\u9014\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u5BF9\u6597\u4E9A\u5170\u533A\u800C\u8A00\uFF0C\u5FB7\u91CC\u671B\u7684\u7B2C\u4E00\u53CA\u7B2C\u4E8C\u6EE4\u6C34\u5382\u5DF2\u7ECF\u7AE3\u5DE5\uFF0C\u65E5\u4EA7\u91CF\u53EF\u8FBE160\u516C\u5347\uFF0C\u53EF\u5E94\u4ED8\u6597\u4E9A\u5170\u53CA\u4E9A\u5E87\u533A\u7684\u6C34\u4F9B\u9700\u6C42\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u201C\u73B0\u5728\u53EA\u662F\u5728\u7B49\u5FB7\u91CC\u671B\u901A\u5F80\u4E9A\u5E87\u7684\u6C34\u7BA1\u63A5\u9A73\u5DE5\u7A0B\u5B8C\u5DE5\uFF0C\u5DE5\u52A1\u5C40\u5DF2\u7ECF\u8868\u660E\u4F1A\u5728\u4ECA\u5E746\u6708\u5B8C\u5DE5\uFF0C\u4E00\u65E6\u5B8C\u6210\uFF0C\u6597\u4E9A\u5170\u3001\u4E9A\u5E87\u5DE5\u4E1A\u56ED\u3001\u90E8\u4EFD\u4E9A\u5E87\u533A\u53CA\u6C99\u5DF4\u5927\u5B66\u7684\u65AD\u6C34\u95EE\u9898\u5C06\u4E0D\u518D\u51FA\u73B0\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u5728\u4F1A\u4E0A\u4E5F\u5C06\u56DE\u6559\u5929\u8BFE\u6B3E\u9879\u79FB\u4EA4\u7ED9878\u4F4D\u6709\u9700\u8981\u8005\uFF0C\u6C99\u5DF4\u7535\u529B\u6709\u9650\u516C\u53F8\u4E5F\u6350\u52A9500\u540D\u5F31\u52BF\u4EBA\u58EB\u53CA\u6350\u6B3E5\u5343\u4EE4\u5409\u7ED9\u6597\u4E9A\u5170\u5F53\u5730\u7684\u4E00\u95F4\u6E05\u8D1E\u5BFA\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/91RGNmjxMEEEJV1PhRVeSQ\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
