  "route": "/4335/",
  "title": "\u5185\u653F\u90E8\u4E0E\u4EBA\u8D44\u90E8\u9700\u9AD8\u7EA7\u90E8\u957F\u6216\u526F\u9996\u76F8\u5750\u9547\u3000\u5434\u6C49\u5764\uFF1A\u786E\u4FDD\u5927\u9A6C\u5916\u52B3\u653F\u7B56\u66F4\u5B8C\u5584",
  "summary": "\uFF08\u5409\u9686\u576112\u65E5\u8BAF\uFF09\u6267\u4E1A\u5F8B\u5E08\u5434\u6C49\u5764\u8BA4\u4E3A\uFF0C\u6211\u56FD\u9700\u8981\u6709\u4E00\u4E2A\u9AD8\u7EA7\u90E8\u957F\u751A\u81F3\u662F\u526F\u9996\u76F8\u7EA7\u522B\u7684\u4EBA\u7269\u6765\u5750\u9547\u4EBA\u529B\u8D44\u6E90\u90E8\u4E0E\u5185\u653F\u90E8\uFF0C\u624D\u80FD\u4F7F\u5916\u52B3\u653F\u7B56\u66F4\u52A0\u5B8C\u5584\u3002 \u4ED6\u4ECA\u65E5\u5728\u300A\u4E1C\u65B9\u65E5\u62A5\u300B\u4E0EAI FM\u5408\u4F5C\u7684\u300A\u5F00\u8BB2\u4E1C\u65B9\u8BAE\u9898\u300B\u8282\u76EE\u4E2D\u9488\u5BF9\u65E9\u524D\u4E00\u7FA4\u5916\u52B3\u56E0\u96C7\u4E3B\u672A\u63D0\u4F9B\u5DE5\u4F5C\u800C\u96C6\u4F53\u6B65\u884C\u524D\u5F80\u5CC7\u5C24\u8FBE\u8FC8\uFF08Bayu Damai\uFF09\u8B66\u5C40\u62A5\u6848\u4E00\u4E8B\u53D1\u8868\u5176\u89C2\u70B9\u3002 \u4ED6\u8BA4\u4E3A\uFF0C\u7531\u4E8E\u5404\u90E8\u95E8\u4F5C\u98CE\u4E0D\u540C\uFF0C\u56E0\u6B64\u624D\u9700\u8981\u8FD9\u4E9B\u90E8\u95E8\u4E4B\u4E0A\u7684\u4EBA\u7269\u6765\u7EDF\u4E00\u6267\u884C\u89E3\u51B3\u65B9\u6848\u3002 \u201C\u5982\u5185\u653F\u90E8\u5927\u591A\u7531\u6280\u672F\u5B98\u50DA\u7EC4\u6210\uFF0C\u90FD\u662F\u4ECE\u4F4E\u505A\u8D77\u3002\u4F8B\u5982\u8B66\u65B9\u662F\u4E00\u4E2A\u5C01\u95ED\u7684\u90E8\u95E8\uFF0C\u4E0D\u80FD\u4ECA\u5929\u5F53\u8B66\u5BDF\uFF0C\u660E\u2026",
  "body": "\u003Cp\u003E\uFF08\u5409\u9686\u576112\u65E5\u8BAF\uFF09\u6267\u4E1A\u5F8B\u5E08\u5434\u6C49\u5764\u8BA4\u4E3A\uFF0C\u6211\u56FD\u9700\u8981\u6709\u4E00\u4E2A\u9AD8\u7EA7\u90E8\u957F\u751A\u81F3\u662F\u526F\u9996\u76F8\u7EA7\u522B\u7684\u4EBA\u7269\u6765\u5750\u9547\u4EBA\u529B\u8D44\u6E90\u90E8\u4E0E\u5185\u653F\u90E8\uFF0C\u624D\u80FD\u4F7F\u5916\u52B3\u653F\u7B56\u66F4\u52A0\u5B8C\u5584\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u4ECA\u65E5\u5728\u300A\u4E1C\u65B9\u65E5\u62A5\u300B\u4E0EAI FM\u5408\u4F5C\u7684\u300A\u5F00\u8BB2\u4E1C\u65B9\u8BAE\u9898\u300B\u8282\u76EE\u4E2D\u9488\u5BF9\u65E9\u524D\u4E00\u7FA4\u5916\u52B3\u56E0\u96C7\u4E3B\u672A\u63D0\u4F9B\u5DE5\u4F5C\u800C\u96C6\u4F53\u6B65\u884C\u524D\u5F80\u5CC7\u5C24\u8FBE\u8FC8\uFF08Bayu Damai\uFF09\u8B66\u5C40\u62A5\u6848\u4E00\u4E8B\u53D1\u8868\u5176\u89C2\u70B9\u3002 \u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BA4\u4E3A\uFF0C\u7531\u4E8E\u5404\u90E8\u95E8\u4F5C\u98CE\u4E0D\u540C\uFF0C\u56E0\u6B64\u624D\u9700\u8981\u8FD9\u4E9B\u90E8\u95E8\u4E4B\u4E0A\u7684\u4EBA\u7269\u6765\u7EDF\u4E00\u6267\u884C\u89E3\u51B3\u65B9\u6848\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u5982\u5185\u653F\u90E8\u5927\u591A\u7531\u6280\u672F\u5B98\u50DA\u7EC4\u6210\uFF0C\u90FD\u662F\u4ECE\u4F4E\u505A\u8D77\u3002\u4F8B\u5982\u8B66\u65B9\u662F\u4E00\u4E2A\u5C01\u95ED\u7684\u90E8\u95E8\uFF0C\u4E0D\u80FD\u4ECA\u5929\u5F53\u8B66\u5BDF\uFF0C\u660E\u5929\u5F53\u519B\u4EBA\uFF0C\u5373\u4E0D\u53EF\u8DE8\u90E8\u95E8\u3002\u79FB\u6C11\u5C40\u4E5F\u4E00\u6837\uFF0C\u90FD\u662F\u7531\u5185\u90E8\u5B98\u5458\u664B\u5347\u4E0A\u6765\u3002\u4EBA\u529B\u8D44\u6E90\u90E8\u4F5C\u98CE\u53C8\u4E0D\u4E00\u6837\uFF0C\u4EBA\u8D44\u90E8\u5185\u7684\u5B98\u5458\u5F88\u591A\u662F\u5C5E\u4E8E\u884C\u653F\u5B98\uFF0C\u53EF\u80FD\u4F1A\u7275\u6D89\u8DE8\u90E8\u95E8\uFF0C\u6240\u4EE5\u8981\u6709\u89E3\u51B3\u65B9\u6848\uFF0C\u662F\u9700\u8981\u5185\u9601\u53BB\u5904\u7406\u7684\uFF0C\u4E14\u5FC5\u987B\u8981\u6709\u66F4\u9AD8\u7EA7\u522B\u7684\u90E8\u957F\uFF0C\u751A\u81F3\u662F\u526F\u9996\u76F8\u7EA7\u522B\u7684\u4EBA\u7269\u53BB\u534F\u8C03\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u65E9\u524D\uFF0C\u5185\u653F\u90E8\u957F\u62FF\u7763\u65AF\u91CC\u8D5B\u592B\u4E01\u7EB3\u82CF\u7533\u548C\u4EBA\u529B\u8D44\u6E90\u90E8\u957F\u6C88\u5FD7\u5F3A\u53D1\u6587\u544A\uFF0C\u5BA3\u5E03\u4E24\u4E2A\u90E8\u95E8\u5C06\u4E8E2024\u5E741\u670816\u65E5\u4E3E\u884C\u4E00\u573A\u7279\u522B\u4F1A\u8BAE\uFF0C\u4E13\u95E8\u8BA8\u8BBA\u5916\u52B3\u7BA1\u7406\u95EE\u9898\uFF0C\u5E76\u5411\u5185\u9601\u63D0\u8BAE\u51BB\u7ED3\u5916\u52B3\u96C7\u7528\u72B6\u6001\u4EE5\u53CA\u6539\u5584\u56FD\u5185\u5916\u52B3\u7BA1\u7406\u7684\u63AA\u65BD\u3002\u003C/p\u003E\n\u003Cp\u003E\u5BF9\u6B64\uFF0C\u5434\u6C49\u5764\u5206\u6790\uFF0C\u7531\u4E8E\u6D89\u53CA\u7684\u90E8\u95E8\u548C\u6CD5\u6848\u8FC7\u591A\uFF0C\u4E14\u5404\u90E8\u95E8\u5B98\u5458\u9636\u7EA7\u6709\u522B\uFF0C\u4E3B\u5BFC\u6743\u5C06\u5728\u5185\u653F\u90E8\u624B\u4E0A\uFF0C\u4EBA\u8D44\u90E8\u5219\u4E3B\u8981\u8D1F\u8D23\u534F\u8C03\u4E0E\u7167\u987E\u5E95\u4E0B\u7684\u96C7\u4E3B\u548C\u5916\u52B3\u7B49\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u8054\u5E2D\u4F1A\u8BAE\u672C\u6765\u5C31\u662F\u5E94\u8BE5\u505A\u7684\uFF0C\u4F46\u7AD9\u5728\u5B9E\u9645\u653F\u6CBB\u89D2\u5EA6\u800C\u8A00\uFF0C\u80AF\u5B9A\u662F\u7531\u5185\u653F\u90E8\u4E3B\u5BFC\uFF0C\u56E0\u4E3A\u5927\u90E8\u5206\u6267\u6CD5\u6743\u90FD\u5728\u5185\u653F\u90E8\u624B\u4E0A\uFF0C\u4EBA\u8D44\u90E8\u4E3B\u8981\u662F\u5728\u534F\u8C03\u4E0E\u7167\u987E\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u53E6\u4E00\u65B9\u9762\uFF0C\u4ED6\u8868\u793A\uFF0C\u5728\u653F\u7B56\u65B9\u9762\uFF0C\u6211\u56FD\u7684\u5916\u52B3\u5E76\u4E0D\u4F1A\u51FA\u73B0\u8FC7\u591A\u7684\u60C5\u51B5\uFF0C\u4F46\u5C31\u5B9E\u9645\u64CD\u4F5C\u800C\u8A00\uFF0C\u6709\u4E9B\u96C7\u4E3B\u4F1A\u9009\u62E9\u201C\u62A5\u5927\u6570\u201D\u5F15\u8FDB\u66F4\u591A\u5916\u52B3\uFF0C\u4ECE\u800C\u4F7F\u4E0D\u540C\u884C\u4E1A\u6240\u9700\u7684\u5916\u52B3\u5206\u914D\u4E0D\u5300\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6280\u672F\u65B9\u9762\u7406\u5E94\u4E0D\u4F1A\u8FC7\u591A\uFF0C\u4F46\u6709\u4E9B\u4EBA\u4F1A\u9009\u62E9\u62A5\u5927\u6570\uFF0C\u4ED6\u4EEC\u4F1A\u8BA4\u4E3A\u653F\u5E9C\u53CD\u6B63\u90FD\u4F1A\u51CF\u5C11\u5916\u52B3\u4EBA\u6570\u7684\u5F15\u8FDB\u3002\u653F\u5E9C\u4E5F\u65E0\u4ECE\u5224\u65AD\u8BE5\u884C\u4E1A\u5177\u4F53\u9700\u8981\u7684\u5916\u52B3\u4EBA\u6570\u662F\u591A\u5C11\uFF0C\u53EA\u80FD\u4F9D\u7167\u5185\u90E8\u6307\u5357\u76D6\u7AE0\u884C\u4E8B\u3002\u6240\u4EE5\u653F\u5E9C\u9700\u8981\u6709\u4E00\u4E2A\u4E13\u4E1A\u7684\u6BD4\u4F8B\uFF0C\u4EE5\u5B9E\u9645\u7684\u989D\u6570\u6765\u7ED9\u5404\u884C\u4E1A\u8FDB\u884C\u914D\u7ED9\uFF0C\u4F46\u5728\u5B9E\u9645\u64CD\u4F5C\u4E0A\u4E5F\u8981\u9762\u5BF9\u5916\u52B3\u4E0D\u4E00\u5B9A\u80FD100%\u62A5\u5230\u7684\u95EE\u9898\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u4E5F\u8865\u5145\uFF0C\u65E0\u8BC1\u5916\u52B3\u88AB\u9A97\u5230\u6211\u56FD\u7684\u6848\u4F8B\u4F17\u591A\uFF0C\u82E5\u8981\u89E3\u51B3\u6839\u6E90\u95EE\u9898\uFF0C\u5C31\u9700\u8981\u8BA9\u653F\u7B56\u900F\u660E\u5316\uFF0C\u5305\u62EC\u56FA\u6253\u914D\u989D\u3001\u76D1\u7763\u3001\u6267\u6CD5\u5BA3\u5BFC\u7B49\uFF0C\u5426\u5219\u4EBA\u53E3\u8D29\u5356\u7684\u95EE\u9898\u4F9D\u7136\u4F1A\u53D1\u751F\u3002\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/QV91Htx_iApJ4Z9srogxfA\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
