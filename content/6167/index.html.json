  "slug": "11\u6708\u5468\u672B\u53BB\u54EA\u6D6A\u96EA\u5170\u83AA\u6D3B\u52A8\u4E00\u6B21\u770B",
  "canonicalUrlKey": "11\u6708\u5468\u672B\u53BB\u54EA\u6D6A\u96EA\u5170\u83AA\u6D3B\u52A8\u4E00\u6B21\u770B",
  "route": "/6167/",
  "title": "11\u6708\u5468\u672B\u53BB\u54EA\u6D6A\uFF1F\u96EA\u5170\u83AA\u6D3B\u52A8\u4E00\u6B21\u770B\uFF01",
  "summary": "11\u6708\u7684\u96EA\u5170\u83AA\u6D3B\u52A8\u7CBE\u5F69\u7EB7\u5448\uFF0C\u4ECE\u56FD\u9645\u7EA7\u8D5B\u4E8B\u3001\u9A6C\u62C9\u677E\u5230\u5145\u6EE1\u5728\u5730\u98CE\u60C5\u7684\u7279\u8272\u5E02\u96C6\uFF0C\u5468\u672B\u51FA\u884C\u9009\u62E9\u4E30\u5BCC\uFF0C\u6700\u4F4E RM45 \u5373\u53EF\u73A9\u8F6C\u5468\u672B\u3002\u6587\u7AE0\u76D8\u70B9\u4E862026\u5E74\u4E16\u754C\u6469\u6258\u8F66\u9526\u6807\u8D5B\u9A6C\u6765\u897F\u4E9A\u5927\u5956\u8D5B\u3001\u96EA\u5170\u83AA\u9A6C\u62C9\u677E2026\u3001Ban Canal \u8FD0\u6CB3\u5609\u5E74\u534E2026\u3001\u5DF4\u7518\u62C9\u6D6A\u6D77\u6EE9\u534A\u7A0B\u9A6C\u62C9\u677E\uFF0C\u4EE5\u53CA\u8D70\u8FDB\u4E09\u4E2A\u5730\u70B9\u7684\u201C\u4F60\u597D\uFF0C\u65B0\u6751\u96C6\u201D\u5E02\u96C6\uFF0C\u5E76\u9644\u4E0A\u5404\u6D3B\u52A8\u7684\u65F6\u95F4\u3001\u5730\u70B9\u4E0E\u95E8\u7968\u4FE1\u606F\uFF0C\u65B9\u4FBF\u8BFB\u8005\u6309\u56FE\u7D22\u9AA5\u5B89\u6392\u884C\u7A0B\u3002",
  "body": "\u003Cimg src=\u0022/assets/uploads/115552a95dac1338aece70843ed8704959c224c6ee70f173da13193ab766f1e6.jpg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E11\u6708\uFF0C\u96EA\u5170\u83AA\u6709\u4E0D\u5C11\u6D3B\u52A8\u7B49\u4F60\u53C2\u4E0E\uFF01\u56FD\u9645\u7EA7\u8D5B\u4E8B\u3001\u9A6C\u62C9\u677E\u5230\u5145\u6EE1\u5728\u5730\u98CE\u60C5\u7684\u7279\u8272\u5E02\u96C6\uFF0C\u6700\u4F4E RM45 \u73A9\u8F6C\u5468\u672B\uFF01\n-\n1\uFE0F\u20E32026\u5E74\u4E16\u754C\u6469\u6258\u8F66\u9526\u6807\u8D5B\u9A6C\u6765\u897F\u4E9A\u5927\u5956\u8D5B\nMotoGP \u9A6C\u6765\u897F\u4E9A\u5927\u5956\u8D5B\u5373\u5C06\u91CD\u8FD4\u96EA\u90A6\u56FD\u9645\u8D5B\u9053\u0026#128293;\u6765\u81EA\u5168\u7403\u5404\u5730\u7684\u8F66\u624B\u5C06\u5C55\u5F00\u9AD8\u901F\u5BF9\u51B3\u0026#127949;\uFE0F\u73B0\u573A\u4E0D\u4EC5\u80FD\u8FD1\u8DDD\u79BB\u611F\u53D7\u5F15\u64CE\u8F70\u9E23\u4E0E\u8D5B\u9053\u6C1B\u56F4\uFF0C\u8FD8\u80FD\u4EB2\u8EAB\u4F53\u9A8C\u56FD\u9645\u7EA7\u8D5B\u8F66\u8D5B\u4E8B\u7684\u70ED\u8840\u9B45\u529B\uFF01\n\u0026#128197;\u65F6\u95F4\uFF1A10.30-11.1\u0026#160;\n\u0026#128205;\u5730\u70B9\uFF1A\u96EA\u90A6\u56FD\u9645\u8D5B\u9053\n\u0026#127903;\uFE0F\u95E8\u7968\uFF1ARM49.90~RM640\u0026#160;\n-\n2\uFE0F\u20E3\u96EA\u5170\u83AA\u9A6C\u62C9\u677E 2026\u0026#160;\n\u4ECE\u5168\u7A0B\u9A6C\u62C9\u677E\u3001\u534A\u9A6C\u5230 5KM \u4F11\u95F2\u8DD1\u53CA\u513F\u7AE5\u8DD1\uFF0C\u591A\u79CD\u8DDD\u79BB\u4EFB\u4F60\u6311\u6218\uFF01\u65E0\u8BBA\u662F\u60F3\u7A81\u7834\u4E2A\u4EBA\u7EAA\u5F55\uFF0C\u8FD8\u662F\u548C\u5BB6\u4EBA\u670B\u53CB\u4E00\u8D77\u4EAB\u53D7\u8FD0\u52A8\uFF0C\u90FD\u80FD\u611F\u53D7\u5145\u6EE1\u6D3B\u529B\u7684\u8D5B\u4E8B\u6C1B\u56F4\uFF5E\u0026#127939;\n\u0026#128197;\u65F6\u95F4\uFF1A11.1\uFF5C1AM-930AM\n\u0026#128205;\u5730\u70B9\uFF1APersiaran Flora, Cyberjaya, Selangor\n\u0026#127903;\uFE0F\u95E8\u7968\uFF1ARM50~RM140 \uFF08\u65E0\u4F18\u60E0\u4EF7\uFF09\n-\n3\uFE0F\u20E3Ban Canal \u8FD0\u6CB3\u5609\u5E74\u534E 2026\n\u96EA\u5170\u83AA\u4E61\u533A\u5609\u5E74\u534E\u6765\u5566\uFF01\u7ED3\u5408\u81EA\u7136\u98CE\u5149\u3001\u5728\u5730\u6587\u5316\u4E0E\u793E\u533A\u6D3B\u52A8\uFF0C\u5E26\u4F60\u4F53\u9A8C\u4E0D\u4E00\u6837\u7684\u4E61\u6751\u5468\u672B\u0026#127811;\u60F3\u5B89\u6392\u4E00\u8D9F\u8FDC\u79BB\u57CE\u5E02\u55A7\u56A3\u7684\u5C0F\u65C5\u884C\uFF0C\u4E0D\u59A8\u628A\u8FD9\u4E2A\u6D3B\u52A8\u8FD9\u91CC\u52A0\u5165\u884C\u7A0B\uFF01\n\u0026#128197;\u65F6\u95F4\uFF1A11.6-11.8\u0026#160;\n\u0026#128205;\u5730\u70B9\uFF1ABan Canal Parit 14, Simpang Lima, Sabak Bernam\n-\n4\uFE0F\u20E3\u5DF4\u7518\u62C9\u6D6A\u6D77\u6EE9\u534A\u7A0B\u9A6C\u62C9\u677E\n\u8FB9\u8DD1\u6B65\u8FB9\u6B23\u8D4F\u5DF4\u7518\u62C9\u6D6A\u6D77\u5CB8\u7684\u98CE\u666F\u0026#128525;\u8BBE\u6709\u534A\u9A6C\u300110KM \u548C 5KM \u7B49\u7EC4\u522B\uFF0C\u8BA9\u4F60\u5728\u6D77\u8FB9\u6C1B\u56F4\u4E2D\u4EAB\u53D7\u8FD0\u52A8\u65F6\u5149\uFF01\u0026#127939;\u200D\u2642\uFE0F\u0026#127749;\n\u0026#128197;\u65F6\u95F4\uFF1A11.26\uFF5C6AM\n\u0026#128205;\u5730\u70B9\uFF1APantai Bagan Lalang, Sepang\u0026#160;\n\u0026#127903;\uFE0F\u95E8\u7968\uFF1ARM45~RM75\n-\n5\uFE0F\u20E3\u4F60\u597D\uFF0C\u65B0\u6751\u96C6\n\u4F60\u597D\u5E02\u96C6 Hello Bazaar \u5373\u5C06\u5F00\u542F\u4E00\u8D9F\u5145\u6EE1\u4EBA\u60C5\u5473\u7684\u96EA\u5170\u83AA\u65B0\u6751\u5C0F\u65C5\u884C\uFF01\u8FD9\u6B21\u5C06\u8D70\u8FDB 3\uFE0F\u20E3\u4E2A\u4E0D\u540C\u5730\u70B9\uFF0C\u5E26\u4F60\u901B\u7279\u8272\u5E02\u96C6\u3001\u5C1D\u5BB6\u4E61\u7F8E\u98DF\u3001\u542C\u5728\u5730\u6545\u4E8B\uFF0C\u611F\u53D7\u6BCF\u4E2A\u65B0\u6751\u72EC\u6709\u7684\u98CE\u5473\u4E0E\u9B45\u529B\uFF5E\u7EA6\u4E0A\u5BB6\u4EBA\u670B\u53CB\uFF0C\u4E00\u8D77\u51FA\u53D1\u5427\uFF01\u0026#128757;\n\u23F011\u67086\u65E5\u81F38\u65E5\uFF5C11\u670813\u65E5\u81F315\u65E5\uFF5C11\u670820\u65E5\u81F322\u65E5\n\u0026#128205;Banting \u4E07\u6D25\u4E09\u5B98\u5E99\n\u0026#128205;\u5DF4\u751F\u67F4\u57CE\u5F20\u5929\u5BAB\n\u0026#128205;\u4E39\u7ED2\u58EB\u62D4 Tanjung Sepat Kompleks Muhibbah\n\u0026#127903;\uFE0F\u514D\u8D39\u5165\u573A\n\n\n#\u9B45\u529B\u96EA\u5170\u83AA\u0026#160;#\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38\u0026#160;#\u9A6C\u6765\u897F\u4E9A\u65C5\u6E38\u653B\u7565\u0026#160;#\u9A6C\u6765\u897F\u4E9A\u96EA\u5170\u83AA\u0026#160;#VisitSelangor2026\u0026#160;#\u96EA\u5170\u83AA\u60CA\u559C\u8FDE\u8FDE\u0026#160;#\u96EA\u5170\u83AA\u65C5\u6E38\u0026#160;#\u96EA\u5170\u83AA\u65C5\u6E38\u653B\u7565\u0026#160;#\u96EA\u5170\u83AA11\u6708\u6D3B\u52A8\u0026#160;#\u4F60\u597D\u5E02\u96C6 #\u4F60\u597D\u003C/strong\u003E\u003C/p\u003E\n",
