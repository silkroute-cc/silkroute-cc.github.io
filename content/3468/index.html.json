  "id": "%e6%96%b0%e9%97%bb%e5%8a%a8%e6%80%81-%e5%8c%97%e4%ba%ac%e4%ba%a4%e9%80%9a%e5%a4%a7%e5%ad%a6%e4%b8%8e%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e5%bd%ad%e4%ba%a8%e5%a4%a7%e5%ad%a6%e6%9c%ac%e7%a7%91",
  "slug": "%e6%96%b0%e9%97%bb%e5%8a%a8%e6%80%81-%e5%8c%97%e4%ba%ac%e4%ba%a4%e9%80%9a%e5%a4%a7%e5%ad%a6%e4%b8%8e%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e5%bd%ad%e4%ba%a8%e5%a4%a7%e5%ad%a6%e6%9c%ac%e7%a7%91",
  "canonicalUrlKey": "%e6%96%b0%e9%97%bb%e5%8a%a8%e6%80%81-%e5%8c%97%e4%ba%ac%e4%ba%a4%e9%80%9a%e5%a4%a7%e5%ad%a6%e4%b8%8e%e9%a9%ac%e6%9d%a5%e8%a5%bf%e4%ba%9a%e5%bd%ad%e4%ba%a8%e5%a4%a7%e5%ad%a6%e6%9c%ac%e7%a7%91",
  "route": "/3468/",
  "title": "\u65B0\u95FB\u52A8\u6001 | \u5317\u4EAC\u4EA4\u901A\u5927\u5B66\u4E0E\u9A6C\u6765\u897F\u4E9A\u5F6D\u4EA8\u5927\u5B66\u672C\u79D1\u53CC\u5B66\u4F4D\u9879\u76EE\u9996\u6279\u5B66\u751F\u6B22\u8FCE\u4EEA\u5F0F",
  "summary": "\u70B9\u51FB\u84DD\u5B57 \u5173\u6CE8\u6211\u4EEC \u5317\u4EAC\u4EA4\u901A\u5927\u5B66\u4E0E\u9A6C\u6765\u897F\u4E9A\u5F6D\u4EA8\u5927\u5B66 \u672C\u79D1\u53CC\u5B66\u4F4D\u9879\u76EE\u9996\u6279\u5B66\u751F\u6B22\u8FCE\u4EEA\u5F0F 2023\u5E742\u670815\u65E5\u4E0B\u5348\uFF0C\u5317\u4EAC\u4EA4\u901A\u5927\u5B66\u4E0E\u9A6C\u6765\u897F\u4E9A\u5F6D\u4EA8\u5927\u5B66\u672C\u79D1\u53CC\u5B66\u4F4D\u9879\u76EE\u9996\u6279\u5B66\u751F\u6B22\u8FCE\u4EEA\u5F0F\u5728\u79D1\u5B66\u4F1A\u5802\u987A\u5229\u4E3E\u884C\u3002\u9A6C\u6765\u897F\u4E9A\u9A7B\u534E\u5927\u4F7F\u62C9\u60F9\u00B7\u62FF\u7763\u00B7\u52AA\u897F\u5C14\u4E07\u3001\u5317\u4EAC\u4EA4\u901A\u5927\u5B66\u6821\u515A\u59D4\u4E66\u8BB0\u738B\u7A3C\u743C\u51FA\u5E2D\u4EEA\u5F0F\u5E76\u81F4\u8F9E\u3002\u4EEA\u5F0F\u7531\u5317\u4EAC\u4EA4\u901A\u5927\u5B66\u526F\u6821\u957F\u5173\u5FE0\u826F\u4E3B\u6301\u3002 \u62C9\u60F9\u00B7\u62FF\u7763\u00B7\u52AA\u897F\u5C14\u4E07\u5927\u4F7F\u5728\u81F4\u8F9E\u4E2D\u9AD8\u5EA6\u8D5E\u8D4F\u5317\u4EAC\u4EA4\u901A\u5927\u5B66\u53D6\u5F97\u7684\u529E\u5B66\u6210\u7EE9\uFF0C\u5E76\u5BF9\u5317\u4EAC\u4EA4\u901A\u5927\u5B66\u4E0E\u9A6C\u6765\u897F\u4E9A\u5F6D\u4EA8\u5927\u5B66\u5408\u4F5C\u5F00\u5C55\u672C\u79D1\u53CC\u5B66\u4F4D\u9879\u76EE\u8868\u793A\u611F\u8C22\u3002\u4ED6\u6307\u51FA\uFF0C\u4E24\u6821\u4ECE2017\u2026",
  "body": "\u003Cp\u003E\u003Cstrong\u003E\u70B9\u51FB\u84DD\u5B57 \u5173\u6CE8\u6211\u4EEC\u003C/strong\u003E\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/02/frc-8c3c570eeb13ccfeee1e3af3b6e906c8.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/02/frc-2bd5c76e3eca3a7a48ef7a9cd390ab0f.jpg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u5317\u4EAC\u4EA4\u901A\u5927\u5B66\u4E0E\u9A6C\u6765\u897F\u4E9A\u5F6D\u4EA8\u5927\u5B66\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u672C\u79D1\u53CC\u5B66\u4F4D\u9879\u76EE\u9996\u6279\u5B66\u751F\u6B22\u8FCE\u4EEA\u5F0F\u003C/strong\u003E\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/02/frc-8c3c570eeb13ccfeee1e3af3b6e906c8.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/02/frc-d839d3ee65bcb3f25e2f16932a4f8e72.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E2023\u5E742\u670815\u65E5\u4E0B\u5348\uFF0C\u5317\u4EAC\u4EA4\u901A\u5927\u5B66\u4E0E\u9A6C\u6765\u897F\u4E9A\u5F6D\u4EA8\u5927\u5B66\u672C\u79D1\u53CC\u5B66\u4F4D\u9879\u76EE\u9996\u6279\u5B66\u751F\u6B22\u8FCE\u4EEA\u5F0F\u5728\u79D1\u5B66\u4F1A\u5802\u987A\u5229\u4E3E\u884C\u3002\u9A6C\u6765\u897F\u4E9A\u9A7B\u534E\u5927\u4F7F\u62C9\u60F9\u0026#183;\u62FF\u7763\u0026#183;\u52AA\u897F\u5C14\u4E07\u3001\u5317\u4EAC\u4EA4\u901A\u5927\u5B66\u6821\u515A\u59D4\u4E66\u8BB0\u738B\u7A3C\u743C\u51FA\u5E2D\u4EEA\u5F0F\u5E76\u81F4\u8F9E\u3002\u4EEA\u5F0F\u7531\u5317\u4EAC\u4EA4\u901A\u5927\u5B66\u526F\u6821\u957F\u5173\u5FE0\u826F\u4E3B\u6301\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/02/frc-b7ea26f4b924cf733ceb4e22cbd32463.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u62C9\u60F9\u0026#183;\u62FF\u7763\u0026#183;\u52AA\u897F\u5C14\u4E07\u5927\u4F7F\u5728\u81F4\u8F9E\u4E2D\u9AD8\u5EA6\u8D5E\u8D4F\u5317\u4EAC\u4EA4\u901A\u5927\u5B66\u53D6\u5F97\u7684\u529E\u5B66\u6210\u7EE9\uFF0C\u5E76\u5BF9\u5317\u4EAC\u4EA4\u901A\u5927\u5B66\u4E0E\u9A6C\u6765\u897F\u4E9A\u5F6D\u4EA8\u5927\u5B66\u5408\u4F5C\u5F00\u5C55\u672C\u79D1\u53CC\u5B66\u4F4D\u9879\u76EE\u8868\u793A\u611F\u8C22\u3002\u4ED6\u6307\u51FA\uFF0C\u4E24\u6821\u4ECE2017\u5E74\u5F00\u59CB\u6D3D\u8C08\u5408\u4F5C\uFF0C\u52302021\u5E74\u6B63\u5F0F\u7B7E\u7F72\u5408\u4F5C\u5907\u5FD8\u5F55\uFF0C\u7ECF\u53D7\u5168\u7403\u75AB\u60C5\u5F71\u54CD\uFF0C\u9996\u627945\u540D\u5B66\u751F\u987A\u5229\u6765\u5230\u5317\u4EAC\u4EA4\u901A\u5927\u5B66\u5B66\u4E60\u30022023\u5E74\u662F\u9A6C\u6765\u897F\u4E9A\u4E0E\u4E2D\u56FD\u5EFA\u4EA449\u5468\u5E74\uFF0C\u540C\u65F6\u4E5F\u662F\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u5021\u8BAE\u63D0\u51FA10\u5468\u5E74\uFF0C\u4E24\u6821\u672C\u79D1\u53CC\u5B66\u4F4D\u9879\u76EE\u5C06\u6210\u4E3A\u9A6C\u4E2D\u4E24\u56FD\u5F00\u5C55\u66F4\u591A\u5408\u4F5C\u7684\u50AC\u5316\u5242\u3002\u4ED6\u5E0C\u671B\u9879\u76EE\u5B66\u751F\u4E13\u6CE8\u5B66\u4E1A\uFF0C\u79EF\u6781\u4E3B\u52A8\u53C2\u52A0\u5404\u79CD\u6D3B\u52A8\uFF0C\u5E26\u7740\u597D\u5947\u5FC3\u63A2\u7D22\u4E2D\u56FD\u6587\u5316\uFF0C\u5728\u4E2D\u56FD\u5B66\u6709\u6240\u83B7\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/02/frc-87de875f13b02c5619e4bf04d7e99f89.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u738B\u7A3C\u743C\u5728\u81F4\u8F9E\u4E2D\u8868\u793A\uFF0C\u8FD1\u5E74\u6765\uFF0C\u5317\u4EAC\u4EA4\u901A\u5927\u5B66\u4E3B\u52A8\u670D\u52A1\u56FD\u5BB6\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u5021\u8BAE\u548C\u9AD8\u94C1\u8D70\u51FA\u53BB\u6218\u7565\uFF0C\u53D1\u6325\u4F18\u52BF\u7279\u8272\uFF0C\u5F00\u5C55\u4E2D\u5916\u5408\u4F5C\u529E\u5B66\u548C\u6D89\u5916\u57F9\u8BAD\u3002\u5B66\u6821\u4E0E\u9A6C\u6765\u897F\u4E9A\u5F6D\u4EA8\u5927\u5B66\u5F00\u5C55\u94C1\u8DEF\u5DE5\u7A0B\u76F8\u5173\u4E13\u4E1A\u7684\u672C\u79D1\u53CC\u5B66\u4F4D\u9879\u76EE\uFF0C\u5C06\u4E3A\u9A6C\u6765\u897F\u4E9A\u94C1\u8DEF\u5EFA\u8BBE\u548C\u8FD0\u7EF4\u57F9\u517B\u66F4\u591A\u4EBA\u624D\u3002\u738B\u7A3C\u743C\u5BC4\u8BED\u9996\u6279\u9879\u76EE\u5B66\u751F\uFF0C\u5E0C\u671B\u540C\u5B66\u4EEC\u5C3D\u5FEB\u9002\u5E94\u5728\u4EA4\u5927\u7684\u5B66\u4E60\u751F\u6D3B\uFF0C\u8BA4\u771F\u5B66\u4E60\u4E13\u4E1A\u77E5\u8BC6\uFF0C\u63D0\u9AD8\u5B9E\u8DF5\u80FD\u529B\uFF0C\u4E86\u89E3\u535A\u5927\u7CBE\u6DF1\u7684\u4E2D\u534E\u6587\u5316\uFF0C\u4F20\u627F\u77E5\u884C\u5408\u4E00\u7684\u4EA4\u5927\u6821\u8BAD\u7CBE\u795E\uFF0C\u6210\u4E3A\u52A0\u6DF1\u4E2D\u9A6C\u4E24\u56FD\u4EBA\u6C11\u53CB\u8C0A\u7684\u9752\u5E74\u4F7F\u8005\uFF0C\u4E3A\u63A8\u8FDB\u5168\u7403\u4EA4\u901A\u5408\u4F5C\u7279\u522B\u662F\u4E2D\u9A6C\u4E24\u56FD\u7684\u94C1\u8DEF\u53D1\u5C55\u4F5C\u51FA\u65B0\u7684\u66F4\u5927\u7684\u8D21\u732E\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/02/frc-e0d66c2d20563e8ff1072bf205a07ca4.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u5F6D\u4EA8\u5927\u5B66\u6559\u5E08\u4EE3\u8868\u9B4F\u4F1F\u94A6\u5728\u53D1\u8A00\u4E2D\u8868\u793A\uFF0C\u968F\u7740\u9A6C\u6765\u897F\u4E9A\u94C1\u8DEF\u652F\u6301\u4EA7\u4E1A\u8DEF\u7EBF\u56FE2030\u7684\u53D1\u5E03\uFF0C\u94C1\u8DEF\u6280\u672F\u4EBA\u624D\u50A8\u5907\u6210\u4E3A\u9A6C\u6765\u897F\u4E9A\u76EE\u524D\u9762\u4E34\u7684\u6700\u5927\u6311\u6218\u4E4B\u4E00\u3002\u4E24\u6821\u672C\u79D1\u53CC\u5B66\u4F4D\u9879\u76EE\u7684\u5B9E\u65BD\u5C06\u4E3A\u9A6C\u6765\u897F\u4E9A\u57F9\u517B\u4E00\u6279\u4E13\u4E1A\u57FA\u7840\u624E\u5B9E\u3001\u5B9E\u8DF5\u80FD\u529B\u5F3A\u7684\u4E13\u4E1A\u4EBA\u624D\uFF0C\u9A6C\u6765\u897F\u4E9A\u548C\u4E2D\u56FD\u7684\u53CB\u597D\u53CC\u8FB9\u5173\u7CFB\u4E5F\u5C06\u5F97\u5230\u8FDB\u4E00\u6B65\u52A0\u5F3A\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/02/frc-e77d6dff4a5b799024675c6eeff26dcf.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5317\u4EAC\u4EA4\u901A\u5927\u5B66\u6559\u5E08\u4EE3\u8868\u4E01\u8389\u82AC\u5728\u53D1\u8A00\u4E2D\u70ED\u70C8\u6B22\u8FCE\u9A6C\u6765\u897F\u4E9A\u5B66\u751F\u7684\u5230\u6765\u3002\u5979\u8868\u793A\uFF0C\u4EA4\u5927\u7684\u8001\u5E08\u4EEC\u5DF2\u7ECF\u505A\u597D\u51C6\u5907\uFF0C\u5C06\u4E0D\u9057\u4F59\u529B\u5730\u5E2E\u52A9\u540C\u5B66\u4EEC\u66F4\u987A\u5229\u5730\u83B7\u53D6\u77E5\u8BC6\u3001\u5F00\u62D3\u773C\u754C\uFF0C\u4E5F\u4F1A\u4E3A\u540C\u5B66\u4EEC\u89E3\u7B54\u5B66\u4E1A\u3001\u751F\u6D3B\u4EE5\u53CA\u672A\u6765\u53D1\u5C55\u7B49\u5404\u65B9\u9762\u7684\u95EE\u9898\u548C\u7591\u60D1\uFF0C\u5E0C\u671B\u540C\u5B66\u4EEC\u628A\u63E1\u673A\u4F1A\uFF0C\u5168\u9762\u63D0\u9AD8\uFF0C\u4E0D\u65AD\u8FDB\u6B65\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/02/frc-ed5b8b97dc8e0e84b6661a3febea6c59.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u5B66\u751F\u4EE3\u8868\u7A46\u54C8\u739B\u0026#183;\u5409\u514B\u793C\u5728\u53D1\u8A00\u4E2D\u8868\u793A\uFF0C\u7ECF\u8FC7\u4E00\u4E2A\u5B66\u671F\u7684\u6C49\u8BED\u5B66\u4E60\uFF0C\u540C\u5B66\u4EEC\u5DF2\u7ECF\u6162\u6162\u4E86\u89E3\u5230\u4E2D\u56FD\u6587\u5316\u548C\u8BED\u8A00\u7684\u72EC\u7279\u9B45\u529B\uFF0C\u5BF9\u5373\u5C06\u5230\u6765\u7684\u65B0\u5B66\u671F\u66F4\u52A0\u597D\u5947\u4E0E\u5174\u594B\u3002\u5728\u5317\u4EAC\u5B66\u4E60\u671F\u95F4\uFF0C\u540C\u5B66\u4EEC\u4F1A\u5C3D\u6700\u5927\u52AA\u529B\uFF0C\u79EF\u6781\u6295\u5165\u5230\u5B66\u4E1A\u53CA\u5404\u9879\u6D3B\u52A8\u5F53\u4E2D\uFF0C\u7ED3\u4EA4\u66F4\u591A\u670B\u53CB\uFF0C\u83B7\u53D6\u66F4\u591A\u77E5\u8BC6\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/02/frc-c4ed4dc607d32b18a88ce457d3ff4f78.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u6B22\u8FCE\u4EEA\u5F0F\u524D\uFF0C\u738B\u7A3C\u743C\u4E0E\u62C9\u60F9\u0026#183;\u62FF\u7763\u0026#183;\u52AA\u897F\u5C14\u4E07\u5927\u4F7F\u8FDB\u884C\u4E86\u4EB2\u5207\u53CB\u597D\u4EA4\u6D41\u3002\u5927\u4F7F\u4E00\u884C\u8FD8\u53C2\u89C2\u4E86\u6211\u6821\u6821\u53F2\u9986\u3002\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u6765\u897F\u4E9A\u9A7B\u534E\u5927\u4F7F\u9986\u6559\u80B2\u5904\uFF0C\u6211\u6821\u56FD\u9645\u6559\u80B2\u5B66\u9662\u3001\u56FD\u9645\u5904\u3001\u79D1\u7814\u9662\u3001\u673A\u7535\u5B66\u9662\u3001\u571F\u5EFA\u5B66\u9662\u3001\u7535\u6C14\u5B66\u9662\u7B49\u76F8\u5173\u5355\u4F4D\u8D1F\u8D23\u4EBA\u966A\u540C\u53C2\u52A0\u4E0A\u8FF0\u6D3B\u52A8\u3002\u003C/p\u003E\n\u003Cp\u003E2021\u5E74\uFF0C\u6211\u6821\u4E0E\u9A6C\u6765\u897F\u4E9A\u5F6D\u4EA8\u5927\u5B66\u7B7E\u7F72\u672C\u79D1\u53CC\u5B66\u4F4D\u534F\u8BAE\u3002\u7ECF\u8FC7\u4E00\u4E2A\u5B66\u671F\u7684\u6C49\u8BED\u5B66\u4E60\uFF0C\u9879\u76EE\u7B2C\u4E00\u627945\u540D\u5B66\u751F\u4ECE2023\u5E742\u6708\u5F00\u59CB\u6765\u5230\u6211\u6821\u5B66\u4E60\uFF0C\u5B66\u4E60\u4E13\u4E1A\u5305\u62EC\u8F66\u8F86\u5DE5\u7A0B\u3001\u571F\u6728\u5DE5\u7A0B\u548C\u7535\u6C14\u5DE5\u7A0B\u53CA\u5176\u81EA\u52A8\u5316\u3002\u8BE5\u9879\u76EE\u7531\u9A6C\u6765\u897F\u4E9A\u516C\u5171\u670D\u52A1\u5C40\u8D44\u52A9\uFF0C\u662F\u9A6C\u6765\u897F\u4E9A\u653F\u5E9C\u7B2C\u4E00\u6B21\u8D44\u52A9\u9A6C\u6765\u897F\u4E9A\u5B66\u751F\u6765\u534E\u5B66\u4E60\u5DE5\u7A0B\u6280\u672F\u4E13\u4E1A\u3002\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u539F\u6587\u94FE\u63A5\u003C/strong\u003E\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/02/frc-8c3c570eeb13ccfeee1e3af3b6e906c8.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003Ehttp://news.bjtu.edu.cn/info/1044/43563.htm\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/02/frc-8864a480d3855f007570ace3e0cda11e.gif\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2023/02/frc-bfe87e896c3c1fc5c89bc57a49d439ea.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u9A6C\u6765\u897F\u4E9A\u9A7B\u534E\u5927\u4F7F\u9986\u6559\u80B2\u5904\u003C/strong\u003E\n\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u6700\u53CA\u65F6\u7684\u7559\u5B66\u54A8\u8BE2\u003C/s