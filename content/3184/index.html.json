{
  "id": "2931-2",
  "slug": "2931-2",
  "canonicalUrlKey": "2931-2",
  "route": "/3184/",
  "title": "\u5927\u9A6C\u519C\u4EA7\u54C1\u7CBE\u52A0\u5DE5\u6DF1\u53D7\u6B22\u8FCE\u3000\u6B27\u9633\u7389\u9756\uFF1A\u53CC\u8FB9\u7ECF\u8D38\u5408\u4F5C\u5C06\u91CA\u653E\u65B0\u7EA2\u5229",
  "summary": "\uFF08\u5409\u9686\u57617\u65E5\u8BAF\uFF09\u4E2D\u56FD\u9A7B\u9A6C\u5927\u4F7F\u6B27\u9633\u7389\u9756\u6307\u51FA\uFF0C\u4E2D\u56FD\u56FD\u9645\u8FDB\u53E3\u535A\u89C8\u4F1A\uFF08\u8FDB\u535A\u4F1A\uFF09\u4F5C\u4E3A\u5168\u7403\u89C4\u6A21\u6700\u5927\u7684\u7EBF\u4E0B\u56FD\u9645\u6027\u5C55\u4F1A\uFF0C\u5728\u63A8\u52A8\u4E2D\u3001\u9A6C\u6DF1\u5165\u4EA4\u6D41\u4E0E\u5408\u4F5C\u65B9\u9762\u4E5F\u53D1\u6325\u4E86\u79EF\u6781\u4F5C\u7528\uFF0C\u800C\u9A6C\u65B9\u5386\u6765\u9AD8\u5EA6\u91CD\u89C6\u8FDB\u535A\u4F1A\uFF0C\u9664\u4E86\u9886\u8896\u5411\u6765\u4EB2\u81EA\u51FA\u5E2D\u6216\u7EBF\u4E0A\u81F4\u8F9E\u4E4B\u5916\uFF0C\u9A6C\u6765\u897F\u4E9A\u4F01\u4E1A\u5411\u4E2D\u56FD\u5E02\u573A\u5C55\u793A\u4E86\u71D5\u7A9D\u3001\u5496\u5561\u3001\u519C\u4EA7\u54C1\u7CBE\u52A0\u5DE5\u7B49\u7279\u8272\u4EA7\u54C1\uFF0C\u6DF1\u53D7\u4E2D\u56FD\u6D88\u8D39\u8005\u559C\u7231\u3002 \u6B27\u9633\u7389\u9756\u8BA4\u4E3A\uFF0C\u968F\u8457\u533A\u57DF\u5168\u9762\u7ECF\u6D4E\u4F19\u4F34\u5173\u7CFB\u534F\u5B9A\uFF08RCEP\uFF09\u7684\u5168\u9762\u5B9E\u65BD\uFF0C\u4E2D\u56FD\u548C\u9A6C\u6765\u897F\u4E9A\u5747\u5728\u4E2D\u56FD\u2014\u4E1C\u76DF\u81EA\u8D38\u533A\u7684\u57FA\u7840\u4E0A\u65B0\u589E\u4E86\u5E02\u573A\u5F00\u653E\u627F\u8BFA\uFF0C\u4E2D\u9A6C\u53CC\u65B9\u7ECF\u8D38\u5408\u4F5C\u5C06\u4E0D\u65AD\u91CA\u653E\u65B0\u7684\u7EA2\u5229\uFF0C\u4E2D\u9A6C\u4F9B\u5E94\u94FE\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2022/11/frc-656bb37f6b09ef5582fe28c3020df923.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\uFF08\u5409\u9686\u57617\u65E5\u8BAF\uFF09\u4E2D\u56FD\u9A7B\u9A6C\u5927\u4F7F\u6B27\u9633\u7389\u9756\u6307\u51FA\uFF0C\u4E2D\u56FD\u56FD\u9645\u8FDB\u53E3\u535A\u89C8\u4F1A\uFF08\u8FDB\u535A\u4F1A\uFF09\u4F5C\u4E3A\u5168\u7403\u89C4\u6A21\u6700\u5927\u7684\u7EBF\u4E0B\u56FD\u9645\u6027\u5C55\u4F1A\uFF0C\u5728\u63A8\u52A8\u4E2D\u3001\u9A6C\u6DF1\u5165\u4EA4\u6D41\u4E0E\u5408\u4F5C\u65B9\u9762\u4E5F\u53D1\u6325\u4E86\u79EF\u6781\u4F5C\u7528\uFF0C\u800C\u9A6C\u65B9\u5386\u6765\u9AD8\u5EA6\u91CD\u89C6\u8FDB\u535A\u4F1A\uFF0C\u9664\u4E86\u9886\u8896\u5411\u6765\u4EB2\u81EA\u51FA\u5E2D\u6216\u7EBF\u4E0A\u81F4\u8F9E\u4E4B\u5916\uFF0C\u9A6C\u6765\u897F\u4E9A\u4F01\u4E1A\u5411\u4E2D\u56FD\u5E02\u573A\u5C55\u793A\u4E86\u71D5\u7A9D\u3001\u5496\u5561\u3001\u519C\u4EA7\u54C1\u7CBE\u52A0\u5DE5\u7B49\u7279\u8272\u4EA7\u54C1\uFF0C\u6DF1\u53D7\u4E2D\u56FD\u6D88\u8D39\u8005\u559C\u7231\u3002\u003C/p\u003E\n\u003Cp\u003E\u6B27\u9633\u7389\u9756\u8BA4\u4E3A\uFF0C\u968F\u8457\u533A\u57DF\u5168\u9762\u7ECF\u6D4E\u4F19\u4F34\u5173\u7CFB\u534F\u5B9A\uFF08RCEP\uFF09\u7684\u5168\u9762\u5B9E\u65BD\uFF0C\u4E2D\u56FD\u548C\u9A6C\u6765\u897F\u4E9A\u5747\u5728\u4E2D\u56FD\u2014\u4E1C\u76DF\u81EA\u8D38\u533A\u7684\u57FA\u7840\u4E0A\u65B0\u589E\u4E86\u5E02\u573A\u5F00\u653E\u627F\u8BFA\uFF0C\u4E2D\u9A6C\u53CC\u65B9\u7ECF\u8D38\u5408\u4F5C\u5C06\u4E0D\u65AD\u91CA\u653E\u65B0\u7684\u7EA2\u5229\uFF0C\u4E2D\u9A6C\u4F9B\u5E94\u94FE\u4EA7\u4E1A\u94FE\u5C06\u5F97\u5230\u8FDB\u4E00\u6B65\u4F18\u5316\uFF0C\u4E24\u56FD\u7ECF\u8D38\u5408\u4F5C\u7A7A\u95F4\u5C06\u8FDB\u4E00\u6B65\u63D0\u5347\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u4E2D\u56FD\u4E0E\u5927\u9A6C\u5EFA\u4EA448\u5E74\u6765\uFF0C\u4E24\u56FD\u653F\u6CBB\u4E92\u4FE1\u4E0D\u65AD\u52A0\u6DF1\uFF0C\u7ECF\u8D38\u5408\u4F5C\u6301\u7EED\u6DF1\u5316\uFF0C\u4EBA\u6587\u5F80\u6765\u65E5\u76CA\u7D27\u5BC6\uFF0C\u4EBA\u6C11\u53CB\u8C0A\u4E0D\u65AD\u5347\u534E\u3002\u636E\u4E2D\u65B9\u7EDF\u8BA1\uFF0C\u4ECA\u5E741\u81F38\u6708\uFF0C\u4E2D\u9A6C\u53CC\u8FB9\u8D38\u6613\u989D\u8FBE1312\u4EBF\u7F8E\u5143\uFF08\u7EA66224\u4EBF\u4EE4\u5409\uFF09\uFF0C\u589E\u957F21.2%\uFF0C\u4ECA\u5E74\u4E2D\u56FD\u6709\u671B\u7B2C14\u5E74\u8749\u8054\u9A6C\u6700\u5927\u8D38\u6613\u4F19\u4F34\uFF1B\u636E\u9A6C\u65B9\u7EDF\u8BA1\uFF0C\u4E2D\u56FD\u5BF9\u9A6C\u5236\u9020\u4E1A\u6295\u8D44\u4ECE2011\u5E74\u76843.8\u4EBF\u7F8E\u5143\u8DC3\u5347\u52302021\u5E74\u768439.8\u4EBF\u7F8E\u5143\uFF08\u7EA6188.81\u4EBF\u4EE4\u5409\uFF09\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8865\u5145\uFF0C\u4ECE\u8FDB\u535A\u4F1A\u3001\u5BF9\u63A5\u4F1A\u5230\u5B9E\u65BD\u300A\u533A\u57DF\u5168\u9762\u7ECF\u6D4E\u4F19\u4F34\u5173\u7CFB\u534F\u5B9A\u300B\u3001\u7F29\u51CF\u5916\u8D44\u51C6\u5165\u8D1F\u9762\u6E05\u5355\uFF0C\u4E2D\u56FD\u9AD8\u6C34\u5E73\u5BF9\u5916\u5F00\u653E\u7684\u811A\u6B65\u4E0D\u4F1A\u505C\u6B47\uFF0C\u7528\u81EA\u8EAB\u884C\u52A8\u8DF5\u884C\u8457\u652F\u6301\u7ECF\u6D4E\u5168\u7403\u5316\u7684\u8BFA\u8A00\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u6211\u4EEC\u8981\u7EE7\u7EED\u9AD8\u8D28\u91CF\u5171\u5EFA\u2018\u4E00\u5E26\u4E00\u8DEF\u2019\uFF0C\u7A33\u6B65\u63A8\u8FDB\u5927\u9879\u76EE\u5EFA\u8BBE\uFF0C\u5728\u4FE1\u606F\u6280\u672F\u3001\u6570\u5B57\u7ECF\u6D4E\u3001\u7EFF\u8272\u80FD\u6E90\u7B49\u65B0\u5174\u9886\u57DF\u5F00\u5C55\u66F4\u591A\u5408\u4F5C\uFF0C\u4E3A\u4E2D\u3001\u9A6C\u7ECF\u8D38\u5408\u4F5C\u548C\u4E24\u56FD\u5173\u7CFB\u53D1\u5C55\u6CE8\u5165\u65B0\u7684\u52A8\u529B\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u6B27\u9633\u7389\u9756\u4ECA\u65E5\u5728\u5409\u9686\u5761\u9999\u683C\u91CC\u62C9\u9152\u5E97\u4E3E\u884C\u7684\u201C2022\u5E74\u4E2D\u9A6C\u4F01\u4E1A\u8DE8\u5883\u5408\u4F5C\u5BF9\u63A5\u4F1A\u201D\uFF08\u8FDB\u535A\u4F1A\u4E2D\u884C\u4E13\u573A\uFF09\u4E0A\u81F4\u8F9E\u65F6\u4E5F\u6307\u51FA\uFF0C\u4E2D\u65B9\u5C06\u7EE7\u7EED\u6269\u5927\u9AD8\u6C34\u5E73\u5BF9\u5916\u5F00\u653E\uFF0C\u4E0E\u5305\u62EC\u9A6C\u6765\u897F\u4E9A\u5728\u5185\u7684\u4E16\u754C\u5404\u56FD\u5171\u540C\u5206\u4EAB\u4E2D\u56FD\u53D1\u5C55\u7684\u66F4\u591A\u673A\u9047\uFF0C\u4E2D\u65B9\u4EA6\u613F\u4E0E\u9A6C\u65B9\u4E00\u9053\u6784\u5EFA\u9762\u5411\u4E2D\u9A6C\u548C\u4E1C\u76DF\u5E02\u573A\u7684\u8DE8\u5883\u4EA7\u4E1A\u94FE\u4F9B\u5E94\u94FE\u4EF7\u503C\u94FE\uFF0C\u627F\u63A5\u53CC\u5411\u4EA7\u4E1A\u8F6C\u79FB\u5408\u4F5C\uFF0C\u63A8\u52A8\u8D38\u6613\u6295\u8D44\u63D0\u8D28\u5347\u7EA7\u3002\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u8BF4\uFF0C\u8FC7\u53BB\u5341\u5E74\u6765\uFF0C\u4E2D\u56FD\u7684\u5BF9\u5916\u5F00\u653E\u5E7F\u5EA6\u548C\u6DF1\u5EA6\u5F97\u5230\u4E86\u5168\u9762\u62D3\u5C55\u3002\u4E2D\u56FD\u5546\u54C1\u51FA\u53E3\u5360\u56FD\u9645\u5E02\u573A\u7684\u4EFD\u989D\u753111%\u4E0A\u5347\u523015%\uFF0C\u4E2D\u56FD\u5DF2\u662F140\u591A\u4E2A\u56FD\u5BB6\u548C\u5730\u533A\u7684\u4E3B\u8981\u8D38\u6613\u4F19\u4F34\uFF0C\u8D27\u7269\u8D38\u6613\u603B\u989D\u5C45\u4E16\u754C\u7B2C\u4E00\uFF0C\u5438\u5F15\u5916\u8D44\u548C\u5BF9\u5916\u6295\u8D44\u5C45\u4E16\u754C\u524D\u5217\uFF0C\u5171\u5EFA\u201C\u4E00\u5E26\u4E00\u8DEF\u201D\u6210\u4E3A\u6DF1\u53D7\u6B22\u8FCE\u7684\u56FD\u9645\u516C\u5171\u4EA7\u54C1\u548C\u56FD\u9645\u5408\u4F5C\u5E73\u53F0\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u622A\u81F32022\u5E748\u6708\u5E95\uFF0C\u4E2D\u56FD\u4E0E\u2018\u4E00\u5E26\u4E00\u8DEF\u2019\u6CBF\u7EBF\u56FD\u5BB6\u8D27\u7269\u8D38\u6613\u989D\u7D2F\u8BA1\u7EA612\u4E07\u4EBF\u7F8E\u5143\uFF0C\u5BF9\u6CBF\u7EBF\u56FD\u5BB6\u975E\u91D1\u878D\u7C7B\u76F4\u63A5\u6295\u8D44\u8D85\u8FC71400\u4EBF\u7F8E\u5143\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u4ED6\u5F62\u5BB9\uFF0C\u201C\u56DE\u671B\u65B9\u77E5\u884C\u8FDC\uFF0C\u767B\u9AD8\u66F4\u89C9\u5929\u5BBD\u201D\u3002\u4E2D\u56FD\u7ECF\u6D4E\u603B\u91CF\u5360\u4E16\u754C\u7ECF\u6D4E\u7684\u6BD4\u91CD\u4ECE11.3%\u4E0A\u5347\u523018.5%\uFF0C\u7A33\u5C45\u4E16\u754C\u7B2C\u4E8C\u4F4D\uFF0C\u6210\u4E3A\u4E16\u754C\u7ECF\u6D4E\u589E\u957F\u7684\u6700\u5927\u5F15\u64CE\u3002\u4EBA\u5747\u56FD\u5185\u751F\u4EA7\u603B\u503C\u4ECE6100\u7F8E\u5143\u589E\u52A0\u52301.25\u4E07\u7F8E\u5143\uFF085.93\u4E07\u4EE4\u5409\uFF09\uFF0C\u63A5\u8FD1\u9AD8\u6536\u5165\u56FD\u5BB6\u95E8\u69DB\uFF0C\u800C\u5236\u9020\u4E1A\u589E\u52A0\u503C\u4ECE2012\u5E74\u768416.98\u4E07\u4EBF\u589E\u52A0\u52302021\u5E74\u768431.4\u4E07\u4EBF\u4EBA\u6C11\u5E01\uFF0820.58\u4E07\u4EBF\u4EE4\u5409\uFF09\uFF0C\u8FDE\u7EED12\u5E74\u4FDD\u6301\u4E16\u754C\u7B2C\u4E00\u5236\u9020\u5927\u56FD\u5730\u4F4D\uFF0C\u5916\u6C47\u50A8\u5907\u9980\u989D3.25\u4E07\u4EBF\u7F8E\u5143\uFF0815.42\u4E07\u4EBF\u4EE4\u5409\uFF09\uFF0C\u591A\u5E74\u7A33\u5C45\u4E16\u754C\u7B2C\u4E00\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2022/11/frc-e4c602b1a781539fef2bd2a0055ab7c9.png\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u6B64\u5916\uFF0C\u5927\u9A6C\u56FD\u9645\u8D38\u5DE5\u90E8\u526F\u79D8\u4E66\u957F\u62FF\u7763\u5CC7\u5409\u745E\u5728\u81F4\u8F9E\u4E2D\u5219\u8868\u793A\uFF0C\u81EA2018\u5E74\u4EE5\u6765\uFF0C\u8FDB\u535A\u4F1A\u5C31\u6210\u4E3A\u4E86\u5927\u9A6C\u4E2D\u5C0F\u578B\u4F01\u4E1A\u8FDB\u519B\u4E2D\u56FD\u5E9E\u5927\u4E14\u591A\u5143\u5E02\u573A\u7684\u4E3B\u8981\u5E73\u53F0\u4E4B\u4E00\uFF0C\u800C\u53BB\u5E74\u5728\u5927\u9A6C\u5BF9\u5916\u8D38\u6613\u53D1\u5C55\u5C40\uFF08MATRADE\uFF09\u534F\u8C03\u4E0B\uFF0C\u5171\u67097\u5BB6\u5927\u9A6C\u516C\u53F8\u53C2\u5C55\u5E76\u521B\u51FA\u4E862.84\u4EBF\u4EE4\u5409\u7684\u4E1A\u7EE9\uFF0C\u8FD9\u662F\u4EE4\u4EBA\u9F13\u821E\u7684\u6210\u7EE9\u3002\u003C/p\u003E\n\u003Cp\u003E\u5979\u8865\u5145\uFF0C\u968F\u8457\u5168\u7403\u7ECF\u6D4E\u91CD\u65B0\u5F00\u653E\u4EE5\u6765\uFF0C\u9A6C\u6765\u897F\u4E9A\u7684\u7ECF\u6D4E\u4E5F\u9010\u6B65\u590D\u82CF\uFF0C\u5728\u4ECA\u5E74\u7B2C\u4E8C\u5B63\u5EA6\u7684\u589E\u957F\u662F8.9%\uFF0C\u53BB\u5E74\u540C\u671F\u4E3A5%\uFF1B\u5927\u9A6C\u5BF9\u56FD\u9645\u6295\u8D44\u800C\u8A00\u4ECD\u662F\u4E00\u4E2A\u5177\u6709\u5438\u5F15\u529B\u7684\u76EE\u7684\u5730 \uFF0C\u57282022\u5E741\u6708\u81F36\u6708\u95F4\uFF0C\u83B7\u6279\u7684\u6295\u8D44\u4E3A1233\u4EBF\u4EE4\u5409\uFF0C\u6D89\u53CA1714\u4E2A\u6D89\u53CA\u5236\u9020\u4E1A\u3001\u670D\u52A1\u7B49\u9886\u57DF\uFF0C\u9884\u6599\u5C06\u521B\u90205\u4E077000 \u4E2A\u5C31\u4E1A\u673A\u4F1A\u3002\u003C/p\u003E\n\u003Cp\u003E\u5979\u8BF4\uFF0C\u81EA2009\u5E74\u4EE5\u6765\uFF0C\u4E2D\u56FD\u4E00\u76F4\u662F\u9A6C\u6765\u897F\u4E9A\u6700\u5927\u7684\u8D38\u6613\u4F19\u4F34\uFF0C2021\u5E74\u9A6C\u4E2D\u8D38\u6613\u5360\u9A6C\u6765\u897F\u4E9A\u8D38\u6613\u603B\u989D\u768418.9%\uFF0C\u76F4\u81F32022\u5E74\u7B2C\u4E09\u5B63\u5EA6\u4ECD\u6301\u7EED\u589E\u957F\u52BF\u5934\u3002\u003C/p\u003E\n\u003Cp\u003E2022\u5E74\u76F4\u81F3\u7B2C\u4E09\u5B63\u5EA6\uFF0C\u9A6C\u4E2D\u8D38\u6613\u603B\u989D\u8FBE3605.6\u4EBF\u4EE4\u5409\uFF0C\u540C\u6BD4\u589E\u52A018.5%\uFF1B\u800C\u5927\u9A6C\u51FA\u53E3\u589E\u957F13.4%\u81F31554.5\u4EBF\u4EE4\u5409\uFF0C\u800C\u4E2D\u56FD\u8FDB\u53E3\u81F3\u5927\u9A6C\u589E\u957F22.7%\u81F3 2051.1\u4EBF\u4EE4\u5409\u3002\u003C/p\u003E\n\u003Cp\u003E\u5979\u8BF4\uFF0C\u4E2D\u4F01\u662F\u5927\u9A6C\u7684\u7B2C\u56DB\u5927\u5916\u8D44\u76F4\u63A5\u6295\u8D44\u6765\u6E90\u56FD\uFF0C\u5927\u9A6C\u57282021\u5E74\u6279\u51C643\u4E2A\u6765\u81EA\u4E2D\u56FD\u7684\u5236\u9020\u4E1A\u9879\u76EE\uFF0C\u6295\u8D44\u989D\u8FBE166\u4EBF\u4EE4\u5409\uFF0C\u9884\u8BA1\u521B\u90201\u4E074000\u4E2A\u5C31\u4E1A\u673A\u4F1A\uFF1B\u800C\u534E\u4E3A\u3001\u9686\u57FA\u3001\u6676\u79D1\u3001\u3001\u963F\u91CC\u5DF4\u5DF4\u96C6\u56E2\u3001\u5409\u5229\u6C7D\u8F66\u96C6\u56E2\u53CA\u53A6\u95E8\u5927\u5B66\u7B49\u4E2D\u4F01\u9009\u62E9\u6765\u9A6C\u6295\u8D44\uFF0C\u8FD9\u4E9B\u77E5\u540D\u4F01\u4E1A\u5728\u5728\u8BC1\u660E\u4E86\n\u9A6C\u6765\u897F\u4E9A\u7684\u53CB\u5546\u73AF\u5883\u3002\u003C/p\u003E\n\u003Cp\u003E\u5979\u4E5F\u5206\u4EAB\u4E86\u914D\u5408\u9A6C\u6765\u897F\u4E9A2050\u5E74\u6E29\u5BA4\u6C14\u4F53\u51C0\u96F6\u6392\u653E\u76EE\u6807\uFF0C\u8D38\u5DE5\u90E8\u5DF2\u8457\u624B\u62DF\u5B9A\u5236\u9020\u4E1A\u7684\u56FD\u5BB6\u73AF\u5883\u3001\u793E\u4F1A\u548C\u6CBB\u7406\uFF08ESG\uFF09\u6846\u67B6\uFF0C\u56E0\u6B64\u5979\u9F13\u52B1\u4E2D\u5C0F\u578B\u4F01\u4E1A\u6DF1\u5165\u4E86\u89E3\u6709\u5173\u6846\u67B6\u53CA\u6761\u4F8B\uFF0C\u4EE5\u628A\u63E1\u5546\u5546\u673A\u53CA\u7EFF\u8272\u878D\u8D44\u3002\u003C/p\u003E\n\u003Cp\u003E\n\u6765\u6E90\uFF1Ahttps://mp.weixin.qq.com/s/ULH-Ipi7LJJEWJoYlHBLbQ\u003C/p\u003E\n",
