{
  "id": "%e4%ba%9a%e6%b4%b2%e6%9c%80%e4%bd%b3%e5%b7%a5%e4%bd%9c%e5%9f%8e%e5%b8%82%e5%90%89%e9%9a%86%e5%9d%a1%e6%8e%92%e7%ac%ac5-%e5%85%a8%e7%90%8360%e4%ba%ba%e6%89%8d%e6%84%bf%e6%9d%a5%e9%a9%ac%e5%b0%b1",
  "slug": "%e4%ba%9a%e6%b4%b2%e6%9c%80%e4%bd%b3%e5%b7%a5%e4%bd%9c%e5%9f%8e%e5%b8%82%e5%90%89%e9%9a%86%e5%9d%a1%e6%8e%92%e7%ac%ac5-%e5%85%a8%e7%90%8360%e4%ba%ba%e6%89%8d%e6%84%bf%e6%9d%a5%e9%a9%ac%e5%b0%b1",
  "canonicalUrlKey": "%e4%ba%9a%e6%b4%b2%e6%9c%80%e4%bd%b3%e5%b7%a5%e4%bd%9c%e5%9f%8e%e5%b8%82%e5%90%89%e9%9a%86%e5%9d%a1%e6%8e%92%e7%ac%ac5-%e5%85%a8%e7%90%8360%e4%ba%ba%e6%89%8d%e6%84%bf%e6%9d%a5%e9%a9%ac%e5%b0%b1",
  "route": "/4812/",
  "title": "\u4E9A\u6D32\u6700\u4F73\u5DE5\u4F5C\u57CE\u5E02\u5409\u9686\u5761\u6392\u7B2C5 \u5168\u740360%\u4EBA\u624D\u613F\u6765\u9A6C\u5C31\u4E1A",
  "summary": "\uFF08\u5409\u9686\u57616\u65E5\u8BAF\uFF09\u6839\u636E\u62DB\u8058\u5E73\u53F0JobStreet by SEEK\u53D1\u5E03\u7684\u300A2024\u5168\u7403\u4EBA\u624D\u89E3\u7801\u62A5\u544A\u300B\uFF0C60%\u7684\u5168\u7403\u4EBA\u624D\u8BA4\u4E3A\u9A6C\u6765\u897F\u4E9A\u62E5\u6709\u5F88\u597D\u7684\u5C31\u4E1A\u673A\u4F1A\uFF0C\u5176\u4E2D\u5409\u9686\u5761\u66F4\u88AB\u9009\u4E3A\u7B2C5\u5927\u6700\u53D7\u6B22\u8FCE\u7684\u4E9A\u6D32\u5DE5\u4F5C\u57CE\u5E02\u3002 \u6839\u636E\u62A5\u544A\uFF0C\u6211\u56FD\u5728\u5168\u7403\u6700\u5438\u5F15\u6D77\u5916\u6C42\u804C\u8005\u5DE5\u4F5C\u56FD\u5BB6\u4E2D\u6392\u540D\u7B2C21\u4F4D\uFF0C\u800C\u5409\u9686\u5761\u5728\u5168\u7403\u6700\u4F73\u5DE5\u4F5C\u57CE\u5E02\u4E2D\u6392\u540D\u7B2C26\u4F4D\uFF0C\u5728\u4E9A\u6D32\u57CE\u5E02\u4E2D\u5219\u6392\u540D\u7B2C5\uFF0C\u4EC5\u6B21\u4E8E\u65B0\u52A0\u5761\u3001\u4E1C\u4EAC\u3001\u66FC\u8C37\u548C\u5317\u4EAC\u3002 \u867D\u7136\u5927\u9A6C\u6392\u540D\u4ECE\u7B2C19\u4F4D\u7565\u5FAE\u4E0B\u964D\u81F3\u7B2C 21 \u4F4D\uFF0C\u5409\u9686\u5761\u4E5F\u4ECE2020\u5E74\u7684\u7B2C18\u4F4D\u4E0B\u964D\u81F32023\u5E74\u7684\u7B2C26\u4F4D\uFF0C\u4E0D\u8FC760%\u2026",
  "body": "\u003Cp\u003E\uFF08\u5409\u9686\u57616\u65E5\u8BAF\uFF09\u6839\u636E\u62DB\u8058\u5E73\u53F0JobStreet by SEEK\u53D1\u5E03\u7684\u300A2024\u5168\u7403\u4EBA\u624D\u89E3\u7801\u62A5\u544A\u300B\uFF0C60%\u7684\u5168\u7403\u4EBA\u624D\u8BA4\u4E3A\u9A6C\u6765\u897F\u4E9A\u62E5\u6709\u5F88\u597D\u7684\u5C31\u4E1A\u673A\u4F1A\uFF0C\u5176\u4E2D\u5409\u9686\u5761\u66F4\u88AB\u9009\u4E3A\u7B2C5\u5927\u6700\u53D7\u6B22\u8FCE\u7684\u4E9A\u6D32\u5DE5\u4F5C\u57CE\u5E02\u3002\u003C/p\u003E\n\u003Cp\u003E\u6839\u636E\u62A5\u544A\uFF0C\u6211\u56FD\u5728\u5168\u7403\u6700\u5438\u5F15\u6D77\u5916\u6C42\u804C\u8005\u5DE5\u4F5C\u56FD\u5BB6\u4E2D\u6392\u540D\u7B2C21\u4F4D\uFF0C\u800C\u5409\u9686\u5761\u5728\u5168\u7403\u6700\u4F73\u5DE5\u4F5C\u57CE\u5E02\u4E2D\u6392\u540D\u7B2C26\u4F4D\uFF0C\u5728\u4E9A\u6D32\u57CE\u5E02\u4E2D\u5219\u6392\u540D\u7B2C5\uFF0C\u4EC5\u6B21\u4E8E\u65B0\u52A0\u5761\u3001\u4E1C\u4EAC\u3001\u66FC\u8C37\u548C\u5317\u4EAC\u3002\u003C/p\u003E\n\u003Cp\u003E\u867D\u7136\u5927\u9A6C\u6392\u540D\u4ECE\u7B2C19\u4F4D\u7565\u5FAE\u4E0B\u964D\u81F3\u7B2C 21 \u4F4D\uFF0C\u5409\u9686\u5761\u4E5F\u4ECE2020\u5E74\u7684\u7B2C18\u4F4D\u4E0B\u964D\u81F32023\u5E74\u7684\u7B2C26\u4F4D\uFF0C\u4E0D\u8FC760%\u7684\u5168\u7403\u4EBA\u624D\u8BA4\u4E3A\u6211\u56FD\u56E0\u4F18\u8D28\u7684\u5DE5\u4F5C\u673A\u4F1A\u800C\u5177\u6709\u5438\u5F15\u529B\u3002\u003C/p\u003E\n\u003Cp\u003E\u62A5\u544A\u8BF4\uFF0C\u968F\u7740\u6211\u56FD\u5728\u591A\u4E2A\u884C\u4E1A\u4E2D\u52AA\u529B\u63D0\u9AD8\u5176\u5168\u7403\u5F71\u54CD\u529B\uFF0C\u800C\u6B63\u9010\u6B65\u6210\u4E3A\u4E16\u754C\u7EA7\u4EBA\u624D\u548C\u4F01\u4E1A\u7684\u4E2D\u5FC3\u3002\u003C/p\u003E\n\u003Cp\u003E\u62A5\u544A\u63D0\u5230\uFF0C\u5927\u9A6C\u548C\u5409\u9686\u5761\u4E3B\u8981\u5438\u5F15\u6765\u81EA\u4E1C\u5357\u4E9A\u7684\u4EBA\u624D\u3002\u003C/p\u003E\n\u003Cp\u003E\u8FD9\u62A5\u544A\u7531\u6CE2\u58EB\u987F\u54A8\u8BE2\u516C\u53F8\u3001The Network\u548CThe Stepstone\u96C6\u56E2\u8054\u5408\u5236\u4F5C\uFF0C\u5171\u6709\u6765\u81EA180\u591A\u4E2A\u56FD\u5BB6\u53CA\u5730\u533A\u8D85\u8FC715\u4E07\u540D\u6DB5\u76D6\u4E0D\u540C\u884C\u4E1A\u80CC\u666F\u7684\u53D7\u8BBF\u8005\u63A5\u53D7\u8C03\u67E5\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u603B\u4F53\u800C\u8A00\uFF0C\u5927\u9A6C\u5728\u5168\u7403\u5DE5\u4F5C\u76EE\u7684\u5730\u4E2D\u6392\u540D\u7B2C21\u4F4D\uFF0C\u5409\u9686\u5761\u5728\u5458\u5DE5\u613F\u610F\u8FC1\u5C45\u81F3\u9876\u7EA7\u57CE\u5E02\u4E2D\u6392\u540D\u7B2C26\u4F4D\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u5728\u4E9A\u6D32\u57CE\u5E02\u4E2D\uFF0C\u5409\u9686\u5761\u6392\u540D\u7B2C5\uFF0C\u8FD9\u4E3B\u8981\u5F97\u76CA\u4E8E\u4F18\u8D28\u7684\u5DE5\u4F5C\u673A\u4F1A\uFF0860%\uFF09\u3001\u7ECF\u6D4E\u6536\u76CA\uFF0853%\uFF09\u53CA\u751F\u6D3B\u8D28\u91CF\u7684\u6539\u5584\uFF0849%\uFF09\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u62A5\u544A\u6307\u6211\u56FD\u5177\u5305\u5BB9\u6027\u548C\u5BB6\u5EAD\u53CB\u597D\u7B49\u6587\u5316\uFF0C\u4E5F\u662F\u5438\u5F15\u5168\u7403\u4EBA\u624D\u5230\u6765\u7684\u539F\u56E0\u4E4B\u4E00\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/06/frc-ab6b2feb30eb4618d5da804ffe6cf8fa.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/06/frc-9fff2be191edfea6f31437c25474aa07.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u003Cstrong\u003E\u90BB\u56FD\u4EBA\u6700\u6709\u5174\u8DA3\u79FB\u5C45\u5927\u9A6C\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u5BF9\u4E8E\u6700\u611F\u5174\u8DA3\u79FB\u5C45\u9A6C\u6765\u897F\u4E9A\u7684\u56FD\u5BB6\u53CA\u5730\u533A\uFF0C\u5927\u591A\u6765\u81EA\u4E9A\u592A\u5730\u533A\uFF0C\u4F8B\u5982\u5370\u5C3C\u548C\u65B0\u52A0\u5761\u5404\u5360 11%\uFF0C\u5176\u6B21\u662F\u83F2\u5F8B\u5BBE\u548C\u9999\u6E2F\u3002\u003C/p\u003E\n\u003Cp\u003E\u8BE5\u62A5\u544A\u4E5F\u8C08\u53CA\u5927\u9A6C\u4EBA\u7684\u5DE5\u4F5C\u6D41\u52A8\u8D8B\u52BF\u3002JobStreet by SEEK\uFF08\u5927\u9A6C\uFF09\u8463\u4E8B\u603B\u7ECF\u7406\u7EF4\u514B\u897F\u5854\u6C99\u5357\u6307\u670966%\u7684\u4EBA\u624D\u613F\u610F\u4E3A\u5916\u56FD\u96C7\u4E3B\u5DE5\u4F5C\uFF0C\u800C\u8FD9\u4E9B\u96C7\u4E3B\u5E76\u6CA1\u6709\u5728\u5927\u9A6C\u8BBE\u7ACB\u5B9E\u4F53\u7684\u673A\u6784\uFF0C\u6B64\u9879\u6BD4\u4F8B\u4ECE2020\u5E74\u768453%\u4E0A\u5347\u523066%\u3002\u003C/p\u003E\n\u003Cp\u003E\u6839\u636E\u62A5\u544A\uFF0C35%\u7684\u53D7\u8BBF\u8005\u5219\u8868\u793A\u503E\u5411\u7559\u5728\u5927\u9A6C\uFF0C\u4E3B\u8981\u539F\u56E0\u5305\u62EC\u65E0\u6CD5\u643A\u5E26\u5BB6\u4EBA\u3001\u9AD8\u6602\u7684\u642C\u8FC1\u6210\u672C\u4EE5\u53CA\u5BF9\u4E2A\u4EBA\u5B89\u5168\u548C\u4FDD\u969C\u7684\u62C5\u5FE7\u3002\u003C/p\u003E\n\u003Cp\u003E\u201C\u5927\u9A6C\u4F5C\u4E3A\u4E3B\u8981\u5DE5\u4F5C\u76EE\u7684\u5730\u7684\u6301\u4E45\u5438\u5F15\u529B\uFF0C\u8BC1\u660E\u4E86\u672C\u5730\u6709\u63D0\u4F9B\u9AD8\u8D28\u91CF\u5DE5\u4F5C\u673A\u4F1A\u548C\u70ED\u60C5\u597D\u5BA2\u7684\u73AF\u5883\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u62A5\u544A\u5F3A\u8C03\uFF0C\u5927\u9A6C\u96C7\u4E3B\u9700\u91C7\u7528\u6218\u7565\u6027\u7684\u4EBA\u624D\u89C4\u5212\u53CA\u63D0\u5347\u5176\u4EF7\u503C\uFF0C\u4EE5\u5438\u5F15\u548C\u7559\u4F4F\u9876\u5C16\u4EBA\u624D\uFF1A\u201C\u8FD9\u65B9\u5F0F\u53EF\u786E\u4FDD\u5927\u9A6C\u5728\u5168\u7403\u4EBA\u624D\u5E02\u573A\u4E0A\u4FDD\u6301\u7ADE\u4E89\u529B\uFF0C\u5E76\u4E3A\u672A\u6765\u57F9\u517B\u5145\u6EE1\u6D3B\u529B\u548C\u5305\u5BB9\u6027\u7684\u52B3\u52A8\u529B\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u5BF9\u4E8E\u5584\u7528\u5168\u7403\u4EBA\u624D\u5E93\u7684\u4F18\u52BF\uFF0C\u62A5\u544A\u4E5F\u62DF\u51FA\u6570\u9879\u5BF9\u5927\u9A6C\u96C7\u4E3B\u7684\u5EFA\u8BAE\uFF1A\u003C/p\u003E\n\u003Cp\u003E\u52B3\u52A8\u529B\u89C4\u5212\uFF1A\u9884\u6D4B\u672A\u6765\u7684\u4EBA\u624D\u9700\u6C42\uFF0C\u4E3A\u6F5C\u5728\u4EBA\u624D\u77ED\u7F3A\u4F5C\u597D\u51C6\u5907\uFF0C\u5C24\u5176\u662F\u5728\u6570\u5B57\u6280\u672F\u7B49\u9AD8\u9700\u6C42\u9886\u57DF\u3002\u003C/p\u003E\n\u003Cp\u003E\u52A0\u5F3A\u5458\u5DE5\u4EF7\u503C\uFF1A\u5438\u5F15\u4EBA\u624D\uFF0C\u91CD\u70B9\u5173\u6CE8\u5458\u5DE5\u6D41\u52A8\u95EE\u9898\uFF0C\u63D0\u4F9B\u6709\u5438\u5F15\u529B\u7684\u85AA\u8D44\u5F85\u9047\u53CA\u5305\u5BB9\u6027\u7684\u5DE5\u4F5C\u6587\u5316\u3002\u003C/p\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/06/frc-0237f72399c369762c20099d688379c7.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/06/frc-cd0e886635c6a5a93da8980b30a0e05d.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/tD041vz1ZQVRepWep9tXCw\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
