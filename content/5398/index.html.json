  "canonicalUrlKey": "%e9%a9%ac%e4%b8%ad%e7%ad%be%e7%bd%b2%e4%ba%86%e8%a7%a3%e5%a4%87%e5%bf%98%e5%bd%95-%e5%8a%a0%e5%bc%ba%e7%a7%91%e5%ad%a6%e6%8a%80%e6%9c%af%e5%88%9b%e6%96%b0%e5%90%88%e4%bd%9c",
  "route": "/5398/",
  "title": "\u9A6C\u4E2D\u7B7E\u7F72\u4E86\u89E3\u5907\u5FD8\u5F55 \u52A0\u5F3A\u79D1\u5B66\u6280\u672F\u521B\u65B0\u5408\u4F5C",
  "summary": "\u83AB\u54C8\u672B\u963F\u5179\u66FC\uFF08\u5DE6\u8D77\uFF09\u3001\u90D1\u7ACB\u6177\u4E0E\u4F55\u5B8F\u5E73\u5728\u7B7E\u7F72\u4E86\u89E3\u5907\u5FD8\u5F55\u540E\u5408\u5F71\u3002\uFF08\u9A6C\u65B0\u793E\uFF09 \u9A6C\u65B0\u793E \uFF08\u5409\u9686\u57619\u65E5\u8BAF\uFF09\u9A6C\u6765\u897F\u4E9A\u4ECA\u65E5\u901A\u8FC7\u9A6C\u6765\u897F\u4E9A\u79D1\u5B66\u9662\uFF08ASM\uFF09\u4E0E\u4E2D\u56FD\u79D1\u5B66\u9662\uFF08CAS\uFF09\u7B7E\u7F72\u4E86\u89E3\u5907\u5FD8\u5F55\uFF0C\u91CD\u7533\u5728\u79D1\u5B66\u3001\u79D1\u6280\u4E0E\u521B\u65B0\u9886\u57DF\uFF08STI\uFF09\u4E0E\u4E2D\u56FD\u6DF1\u5316\u5408\u4F5C\u7684\u627F\u8BFA\u3002 \u79D1\u5B66\u3001\u5DE5\u827A\u53CA\u9769\u65B0\u90E8\u957F\u90D1\u7ACB\u6177\u6307\u51FA\uFF0C\u4ED6\u671F\u5F85\u57282025\u5E74\u9A6C\u4E2D\u8054\u5408\u7814\u7A76\u8BA1\u5212\u7684\u7B2C\u4E8C\u6279\u7B56\u7565\u7814\u7A76\u57FA\u91D1\u5F81\u6C42\u5EFA\u8BAE\u4E66\uFF08SRF-RFP\uFF09\u4E0B\uFF0C\u4E24\u56FD\u7EE7\u7EED\u8FFD\u6C42\u5353\u8D8A\u7814\u7A76\u3002 \u201C\u901A\u8FC7\u8FD9\u4E3E\u63AA\uFF0C\u53EF\u80FD\u7531\u9A6C\u6765\u897F\u4E9A\u79D1\u5B66\u6350\u8D60\u57FA\u91D1\uFF08MSE\uFF09\u63D0\u4F9B\u914D\u5BF9\u8D44\u52A9\uFF0C\u5C06\u7814\u7A76\u4E0E\u5DE5\u4E1A\u7ED3\u5408\uFF0C\u63D0\u4F9B\u9700\u6C42\u9A71\u52A8\u2026",
  "body": "\u003Cimg src=\u0022https://silkroute.cc/wp-content/uploads/2024/12/frc-94a869a976a62177e6a95543eadde38f.jpeg\u0022 alt=\u0022\u0022 /\u003E\n\u003Cp\u003E\u83AB\u54C8\u672B\u963F\u5179\u66FC\uFF08\u5DE6\u8D77\uFF09\u3001\u90D1\u7ACB\u6177\u4E0E\u4F55\u5B8F\u5E73\u5728\u7B7E\u7F72\u4E86\u89E3\u5907\u5FD8\u5F55\u540E\u5408\u5F71\u3002\uFF08\u9A6C\u65B0\u793E\uFF09\u003C/p\u003E\n\u003Cp\u003E\u9A6C\u65B0\u793E\u003C/p\u003E\n\u003Cp\u003E\uFF08\u5409\u9686\u57619\u65E5\u8BAF\uFF09\u9A6C\u6765\u897F\u4E9A\u4ECA\u65E5\u901A\u8FC7\u9A6C\u6765\u897F\u4E9A\u79D1\u5B66\u9662\uFF08ASM\uFF09\u4E0E\u4E2D\u56FD\u79D1\u5B66\u9662\uFF08CAS\uFF09\u7B7E\u7F72\u4E86\u89E3\u5907\u5FD8\u5F55\uFF0C\u91CD\u7533\u5728\u79D1\u5B66\u3001\u79D1\u6280\u4E0E\u521B\u65B0\u9886\u57DF\uFF08STI\uFF09\u4E0E\u4E2D\u56FD\u6DF1\u5316\u5408\u4F5C\u7684\u627F\u8BFA\u3002\n\n\u79D1\u5B66\u3001\u5DE5\u827A\u53CA\u9769\u65B0\u90E8\u957F\u90D1\u7ACB\u6177\u6307\u51FA\uFF0C\u4ED6\u671F\u5F85\u57282025\u5E74\u9A6C\u4E2D\u8054\u5408\u7814\u7A76\u8BA1\u5212\u7684\u7B2C\u4E8C\u6279\u7B56\u7565\u7814\u7A76\u57FA\u91D1\u5F81\u6C42\u5EFA\u8BAE\u4E66\uFF08SRF-RFP\uFF09\u4E0B\uFF0C\u4E24\u56FD\u7EE7\u7EED\u8FFD\u6C42\u5353\u8D8A\u7814\u7A76\u3002\n\n\u201C\u901A\u8FC7\u8FD9\u4E3E\u63AA\uFF0C\u53EF\u80FD\u7531\u9A6C\u6765\u897F\u4E9A\u79D1\u5B66\u6350\u8D60\u57FA\u91D1\uFF08MSE\uFF09\u63D0\u4F9B\u914D\u5BF9\u8D44\u52A9\uFF0C\u5C06\u7814\u7A76\u4E0E\u5DE5\u4E1A\u7ED3\u5408\uFF0C\u63D0\u4F9B\u9700\u6C42\u9A71\u52A8\u53CA\u5E02\u573A\u4EA4\u4ED8\u7684\u7814\u53D1\u3002\n\n\u201C\u5728\u7B2C\u4E8C\u6279\u7B56\u7565\u7814\u7A76\u57FA\u91D1\u5F81\u6C42\u5EFA\u8BAE\u4E66\u4E0B\uFF0C\u6211\u4EEC\u53EF\u4EE5\u63A2\u7D22\u7684\u9886\u57DF\u5305\u62EC\u80FD\u6E90\u5B58\u50A8\u6280\u672F\u3001\u4EBA\u7C7B\u75AB\u82D7\u3001\u822A\u5929\u79D1\u6280\u3001\u4EBA\u5DE5\u667A\u80FD\u3001\u533A\u5757\u94FE\u548C\u5148\u8FDB\u6750\u6599\u6280\u672F\u3002\u201D\n\n\u4ED6\u4ECA\u65E5\u5728\u4E86\u89E3\u5907\u5FD8\u5F55\u7B7E\u7F72\u4EEA\u5F0F\u4E0A\uFF0C\u81F4\u8BCD\u65F6\u8FD9\u4E48\u8BF4\u3002\n\n\u79D1\u5B66\u9662\u9662\u957F\u62FF\u7763\u4E1C\u59D1\u83AB\u54C8\u672B\u963F\u5179\u66FC\u4E0E\u4E2D\u56FD\u79D1\u5B66\u9662\u526F\u9662\u957F\u4F55\u5B8F\u5E73\u7B7E\u7F72\u4E86\u89E3\u5907\u5FD8\u5F55\uFF0C\u90D1\u7ACB\u6177\u89C1\u8BC1\u3002\u8BE5\u5907\u5FD8\u5F55\u65E8\u5728\u6269\u5927\u4E24\u9662\u5408\u4F5C\u8303\u56F4\uFF0C\u6DB5\u76D6\u795E\u7ECF\u6280\u672F\u3001\u4EBA\u5DE5\u667A\u80FD\u3001\u519C\u4E1A\u548C\u53EF\u518D\u751F\u80FD\u6E90\u7B49\u65B0\u5174\u9886\u57DF\u3002\n\n\u8FD9\u5907\u5FD8\u5F55\u662F\u5EFA\u7ACB\u57281999\u5E74\u7B7E\u7F72\u7684\u534F\u8BAE\u5907\u5FD8\u5F55\u57FA\u7840\u4E0A\uFF0C\u53CD\u6620\u79D1\u5B66\u9662\u548C\u4E2D\u56FD\u79D1\u5B66\u9662\u4E4B\u95F4\u52A0\u5F3A\u548C\u66F4\u65B0\u7684\u627F\u8BFA\u3002\n\n\u90D1\u7ACB\u6177\u63D0\u5230\uFF0C\u53CC\u65B9\u672A\u6765\u9884\u8BA1\u5728SRF-RFP\u548C\u5907\u5FD8\u5F55\u5171\u540C\u5173\u6CE8\u7684\u9886\u57DF\u5982\u4EBA\u5DE5\u667A\u80FD\uFF0C\u5C55\u5F00\u4EE5\u4EFB\u52A1\u4E3A\u5BFC\u5411\u7684\u8054\u5408\u7814\u53D1\u9879\u76EE\u3002\n\n\u4E0E\u6B64\u540C\u65F6\uFF0C\u83AB\u54C8\u672B\u963F\u5179\u66FC\u8868\u793A\uFF0C\u968F\u7740\u5907\u5FD8\u5F55\u7684\u7B7E\u7F72\uFF0C\u53CC\u65B9\u91CD\u7533\u4E86\u5229\u7528\u79D1\u5B66\u8FDB\u6B65\u9020\u798F\u5168\u7403\u7684\u5171\u540C\u613F\u666F\u3002\n\n\u4ED6\u6307\u51FA\uFF0C\u8FD9\u4E00\u65B0\u7684\u5408\u4F5C\u4F19\u4F34\u5173\u7CFB\u65E8\u5728\u52A0\u5F3A\u8054\u5408\u7814\u7A76\u8BA1\u5212\u3001\u4FC3\u8FDB\u77E5\u8BC6\u4EA4\u6D41\uFF0C\u5E76\u63A8\u52A8\u56FD\u9645\u5408\u4F5C\u4EE5\u5E94\u5BF9\u5168\u7403\u6700\u7D27\u8FEB\u7684\u6311\u6218\u3002\n\n\u4F55\u5B8F\u5E73\u5219\u8868\u793A\uFF0C\u5E0C\u671B\u901A\u8FC7\u8FD9\u4EFD\u5907\u5FD8\u5F55\uFF0C\u4E24\u56FD\u80FD\u591F\u7EE7\u7EED\u6DF1\u5316\u66F4\u591A\u9886\u57DF\u7684\u5408\u4F5C\uFF0C\u5171\u540C\u5E94\u5BF9\u65B0\u7684\u79D1\u6280\u6311\u6218\u3002\n\n\u201C\u79D1\u6280\u5408\u4F5C\u5BF9\u4E2D\u9A6C\u5173\u7CFB\u81F3\u5173\u91CD\u8981\uFF0C\u4E5F\u662F\u63A8\u52A8\u5168\u7403\u79D1\u6280\u8FDB\u6B65\u7684\u91CD\u8981\u52A8\u529B\u3002\u201D\u003C/p\u003E\n\u003Cp\u003E\u6765\u6E90\uFF1A\u003Ca href=\u0022https://mp.weixin.qq.com/s/bJnS5zIH8gxJ0pfkScYFxg\u0022 rel=\u0022noopener noreferrer\u0022\u003E\u9605\u8BFB\u539F\u6587\u003C/a\u003E\u003C/p\u003E\n",
